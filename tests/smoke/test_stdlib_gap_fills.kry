// Step-230 stdlib additions (the language gaps the docs used to paper
// over): random_f64, slice_ops::{is_sorted, bsearch}, fuzzy::jaro_winkler,
// crypto::uuid_parse. Self-checking where it matters; the parity runner
// compares exit codes only.

use std::random::{new_rng, random_f64}
use std::slice_ops::{is_sorted, bsearch}
use std::fuzzy::{jaro_winkler, levenshtein}
use std::crypto::{uuid_v4, uuid_parse}

fn main() {
    // random_f64: bounded, varies, deterministic per seed
    let r = new_rng(42)
    let mut i = 0
    let mut ok = true
    let mut last = 0.0 - 1.0
    while i < 1000 {
        let f = random_f64(r)
        if f < 0.0 or f >= 1.0 { ok = false }
        last = f
        i = i + 1
    }
    if not ok {
        println("FAIL: random_f64 out of [0,1)")
        exit(1)
    }
    println("random_f64 bounded: {ok}")
    let r2 = new_rng(42)
    let first = random_f64(r2)
    println("deterministic seed: {first}")

    // bsearch / is_sorted
    let xs = [1, 3, 5, 7, 9, 11]
    let sorted = is_sorted(xs)
    let found = bsearch(xs, 7)
    let missing = bsearch(xs, 8)
    let unsorted = is_sorted([3, 1, 2])
    let empty: [i64] = []
    let e1 = is_sorted(empty)
    let e2 = bsearch(empty, 5)
    println("is_sorted={sorted} found={found} missing={missing} unsorted={unsorted} empty_sorted={e1} empty_search={e2}")

    // jaro_winkler: identical=1, disjoint=0, known pair
    let jw1 = jaro_winkler("martha", "martha")
    let jw2 = jaro_winkler("abc", "xyz")
    let jw3 = jaro_winkler("martha", "marhta")
    let lev = levenshtein("kitten", "sitting")
    println("jw_same={jw1} jw_none={jw2} jw_martha={jw3} lev={lev}")

    // uuid_parse: normalizes case, validates, round-trips uuid_v4
    let norm = uuid_parse("550E8400-E29B-41D4-A716-446655440000")
    println("normalized: {norm}")
    let fresh = uuid_v4()
    let same = uuid_parse(fresh) == fresh
    println("v4 roundtrip: {same}")
    try {
        let bad = uuid_parse("not-a-uuid")
        println("FAIL: accepted garbage")
        exit(1)
    } catch e {
        println("rejected: ok")
    }
}
