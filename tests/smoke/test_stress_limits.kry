// Stress limits: big-but-legal workloads that expose stack, allocator,
// and codegen scaling issues. Deterministic, identical on both backends.
// expect-stdout: recur=10000
// expect-stdout: bigstr-len=131072 bigstr-ends=xy
// expect-stdout: bigarr=100000 sum=4999950000
// expect-stdout: deep-expr=1024
// expect-stdout: many-vars=210

fn count_down(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    return 1 + count_down(n - 1)
}

fn main() {
    // 10k-deep recursion (non-tail: the +1 keeps the frame live)
    println("recur=" + to_string(count_down(10000)))

    // 128 KB string via repeated doubling; check length + tail bytes
    let mut s = "xy"
    let mut i = 0
    while i < 16 {
        s = s + s
        i = i + 1
    }
    println("bigstr-len=" + to_string(len(s))
        + " bigstr-ends=" + substr(s, len(s) - 2, len(s)))

    // 100k-element array, summed
    let mut arr: [i64] = []
    let mut j = 0
    while j < 100000 {
        arr = push(arr, j)
        j = j + 1
    }
    let mut sum = 0
    let mut k = 0
    while k < len(arr) {
        sum = sum + arr[k]
        k = k + 1
    }
    println("bigarr=" + to_string(len(arr)) + " sum=" + to_string(sum))

