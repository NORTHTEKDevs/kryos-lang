// Regression (audit backlog #4/#25/#32): actors and spawn-captured method
// calls. #4 (ActorName() typecheck) and #25 (bare-field actor-state assign)
// were fixed earlier; #32 (a spawn block lost captured-variable types, so a
// method call inside it linked to a bare UNMANGLED symbol -> link failure)
// is fixed by carrying capture param types into the spawn wrapper.
//
// #32 was a COMPILE/LINK bug, so correctness is asserted on the MAIN thread
// (deterministic, platform-independent) and the spawn block only has to
// compile, link the mangled method symbol, and run without crashing (joined
// at main exit). No cross-thread assertion, no channel recv, no exit() off
// the main thread -- earlier variants that did those were flaky / hung on
// macOS AOT in CI. The cross-thread runtime behavior of a spawn-captured
// STRUCT value on macOS AOT is tracked separately, not encoded here.

struct Worker { id: i64 }
impl Worker {
    fn run(self: Worker) -> i64 {
        return self.id * 10
    }
}

actor Counter {
    count: i64
    fn bump() {
        count = count + 1
    }
}

fn main() {
    // #32 correctness (method resolves + computes), on the main thread.
    let w = Worker { id: 5 }
    if w.run() != 50 {
        println("FAIL: Worker.run() wrong result")
        exit(1)
    }

    // #32 link/run path: the same captured-struct method call inside a spawn
    // must compile, link (mangled symbol), and run without crashing.
    let w2 = Worker { id: 7 }
    spawn {
        let _ = w2.run()
    }

    // #4 + #25: actor construction + bare-field state mutation compile+run.
    let c = Counter()
    c.bump()
    c.bump()

    println("actor + spawn method: all pass")
}
