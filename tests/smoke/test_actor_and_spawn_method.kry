// Regression (audit backlog #4/#25/#32): actors and spawn-captured method
// calls. #4 (ActorName() typecheck) and #25 (bare-field actor-state assign)
// were fixed earlier; #32 (spawn block loses captured-variable types, so a
// method call inside it linked to a bare unmangled symbol) is fixed by
// carrying capture param types into the spawn wrapper.
//
// The spawn result is asserted on the MAIN thread via a channel (recv blocks
// until the spawn sends), so this is deterministic on every platform and does
// NOT call exit() from a spawned thread. An earlier fixed-sleep + in-thread
// exit() version was flaky on macOS AOT.

struct Worker { id: i64 }
impl Worker {
    fn run(self: Worker) -> i64 {
        return self.id * 10
    }
}

actor Counter {
    count: i64
    fn bump() {
        count = count + 1
    }
}

fn main() {
    // #32 correctness on the main thread.
    let w = Worker { id: 5 }
    if w.run() != 50 {
        println("FAIL: Worker.run() wrong result")
        exit(1)
    }

    // #32: capture a struct into a spawn block, call its method, and send the
    // result back. main blocks on recv, then asserts (no exit() off-main).
    let w2 = Worker { id: 7 }
    let ch = chan()
    spawn {
        let r = w2.run()
        send(ch, r)
    }
    let got = recv(ch)
    if got != 70 {
        println("FAIL: spawn captured method got " + to_string(got))
        exit(1)
    }

    // #4 + #25: actor construction + bare-field state mutation compile+run.
    let c = Counter()
    c.bump()
    c.bump()

    println("actor + spawn method: all pass")
}
