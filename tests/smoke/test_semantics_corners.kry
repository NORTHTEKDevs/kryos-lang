// Semantic corners: tuples (destructure, nesting, returns), shadowing,
// closure capture mutation visibility, break/continue in loops.
// Identical on both backends.
// expect-stdout: tup=1,two
// expect-stdout: dest=3,4 nested=5 ret=9,ok
// expect-stdout: shadow=redefined-str
// expect-stdout: cap-before=10
// expect-stdout: cap-after=99
// expect-stdout: brk=0,1,2 cont=0,1,3,4
// expect-stdout: nested-brk=3
//
// nested=5 is the regression line for chained tuple access `t.0.0`: the
// lexer reads `.0.0` as a float token, and the parser now splits it into
// two tuple-index accesses (the rustc resolution of the same ambiguity).

fn pair() -> (i64, str) {
    return (9, "ok")
}

fn main() {
    // tuples: literal, field access, destructuring, nesting, fn return
    let t = (1, "two")
    println("tup=" + to_string(t.0) + "," + t.1)
    let (a, b) = (3, 4)
    let nested = ((5, 6), 7)
    let r = pair()
    println("dest=" + to_string(a) + "," + to_string(b)
        + " nested=" + to_string(nested.0.0)
        + " ret=" + to_string(r.0) + "," + r.1)

    // shadowing: a later `let` with a DIFFERENT type must fully replace
    let x = 42
    let x = "redefined-" + "str"
    println("shadow=" + x)

    // closure capture: mutations to the captured variable after closure
    // creation are visible (capture by reference when not mutated inside)
    let mut n = 10
    let show = || n
    println("cap-before=" + to_string(show()))
    n = 99
    println("cap-after=" + to_string(show()))

    // break / continue
    let mut brk = ""
    let mut i = 0
    while i < 10 {
        if i == 3 {
            break
        }
        if len(brk) > 0 {
            brk = brk + ","
        }
        brk = brk + to_string(i)
        i = i + 1
    }
    let mut cont = ""
    let mut j = 0
    while j < 5 {
        if j == 2 {
            j = j + 1
            continue
        }
        if len(cont) > 0 {
            cont = cont + ","
        }
        cont = cont + to_string(j)
        j = j + 1
    }
    println("brk=" + brk + " cont=" + cont)

    // break out of INNER loop only
    let mut hits = 0
    let mut oi = 0
    while oi < 3 {
        let mut ii = 0
        while ii < 10 {
            if ii == 1 {
                break
            }
            hits = hits + 1
            ii = ii + 1
        }
        oi = oi + 1
    }
    println("nested-brk=" + to_string(hits))
}
