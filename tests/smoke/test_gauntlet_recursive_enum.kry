// Gauntlet 1: recursive enum AST + evaluator + pretty printer.
// Expected output:
//   (3 + 4) * (10 - 8) = 14
//   ((3 + 4) * (10 - 8)) / 2 = 7
//   depth = 4
enum Expr {
    Num(i64),
    Add(Expr, Expr),
    Sub(Expr, Expr),
    Mul(Expr, Expr),
    Div(Expr, Expr),
}

fn eval(e: Expr) -> i64 {
    match e {
        Num(n) => return n,
        Add(a, b) => return eval(a) + eval(b),
        Sub(a, b) => return eval(a) - eval(b),
        Mul(a, b) => return eval(a) * eval(b),
        Div(a, b) => return eval(a) / eval(b),
    }
}

fn show(e: Expr) -> str {
    match e {
        Num(n) => return to_string(n),
        Add(a, b) => return "(" + show(a) + " + " + show(b) + ")",
        Sub(a, b) => return "(" + show(a) + " - " + show(b) + ")",
        Mul(a, b) => return "(" + show(a) + " * " + show(b) + ")",
        Div(a, b) => return "(" + show(a) + " / " + show(b) + ")",
    }
}

fn depth(e: Expr) -> i64 {
    match e {
        Num(n) => return 1,
        Add(a, b) => return 1 + max(depth(a), depth(b)),
        Sub(a, b) => return 1 + max(depth(a), depth(b)),
        Mul(a, b) => return 1 + max(depth(a), depth(b)),
        Div(a, b) => return 1 + max(depth(a), depth(b)),
    }
}

fn main() {
    let e1 = Expr::Mul(
        Expr::Add(Expr::Num(3), Expr::Num(4)),
        Expr::Sub(Expr::Num(10), Expr::Num(8)),
    )
    println(show(e1) + " = " + to_string(eval(e1)))
    let e2 = Expr::Div(
        Expr::Mul(
            Expr::Add(Expr::Num(3), Expr::Num(4)),
            Expr::Sub(Expr::Num(10), Expr::Num(8)),
        ),
        Expr::Num(2),
    )
    println(show(e2) + " = " + to_string(eval(e2)))
    println("depth = " + to_string(depth(e2)))
}
