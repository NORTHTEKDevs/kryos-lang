// Generic struct instantiation across multiple concrete types in one
// program. Identical on both backends.
//
// REGRESSION GUARD (cross-instantiation contamination): the impl method's
// return type var used to be SHARED across every call site, so calling
// `.get()` on Box<str> and then `let x: f64 = box_f64.get()` failed with
// "expected f64, found str". The checker now instantiates fresh vars per
// call and unifies the freshened `self` against the receiver, so each
// instantiation is independent.
//
// REGRESSION GUARD (erasure, formerly gotcha #17): an INLINE unannotated
// f64 method return -- `to_string(box_f64.get())` -- used to report the
// erased i64 slot and print raw bits. MIR inference now binds the impl
// generics from the self param against the monomorphized receiver and
// substitutes the return, so it resolves to the real f64.
// expect-stdout: int=42 str=hello nested=7
// expect-stdout: f64-field=2.5 f64-annot=2.5 f64-inline=2.5
// expect-stdout: str-method=world

struct Box2<T> { v: T }
impl<T> Box2<T> {
    fn get(self: Box2<T>) -> T { return self.v }
}

fn main() {
    // i64 through the method
    let bi = Box2 { v: 42 }
    // str through the method (str is pointer-shaped, so it survives erasure)
    let bs = Box2 { v: "hello" }
    // nested generic via field access
    let bb = Box2 { v: Box2 { v: 7 } }
    println("int=" + to_string(bi.get()) + " str=" + bs.get()
        + " nested=" + to_string(bb.v.v))

    // f64: field access, annotated local, AND inline unannotated method
    // return all resolve to f64 now
    let bf = Box2 { v: 2.5 }
    let annot: f64 = bf.get()
    println("f64-field=" + to_string(bf.v) + " f64-annot=" + to_string(annot)
        + " f64-inline=" + to_string(bf.get()))

    // str method return used directly (parity check for the working case)
    let bs2 = Box2 { v: "wor" + "ld" }
    println("str-method=" + bs2.get())
}
