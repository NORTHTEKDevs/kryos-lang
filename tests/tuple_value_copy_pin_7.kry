// Pin (finish item A20, verifier residuals of round 3): a tuple is a VALUE. A map literal built
// from a tuple variable, a path through an array reached via an index or a field, and a
// side-effecting index must not let a field write change another holder's tuple.
struct Item { p: (i64, str) }
struct Box { items: [Item] }
let mut calls = 0
fn idx() -> i64 {
    calls = calls + 1
    return 1
}
fn main() {
    let mk = (3, "m")
    let mut mm = {"a": mk}
    mm["a"].0 = 12
    println("literal mk={mk.0} mm={mm["a"].0}")
    let mk2 = (3, "m")
    let mut m3 = {"a": mk2}
    m3["a"].0 *= 4
    println("literal compound mk2={mk2.0} m3={m3["a"].0}")

    let mut grid = [[(1, "a"), (2, "b")], [(3, "c"), (4, "d")]]
    let g0 = grid[0][1]
    grid[0][1].0 = 77
    println("grid g0={g0.0} grid={grid[0][1].0}")

    let mut ar = [(1, "a"), (2, "b")]
    let keep = ar[1]
    ar[idx()].0 = 55
    println("impure keep={keep.0} ar={ar[1].0} calls={calls}")
    ar[idx()].0 += 1
    println("impure compound ar={ar[1].0} calls={calls}")

    let mut bx = Box { items: [Item { p: (3, "x") }] }
    let held = bx.items[0].p
    bx.items[0].p.0 = 31
    println("field path held={held.0} bx={bx.items[0].p.0}")
}
