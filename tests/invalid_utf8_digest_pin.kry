@capabilities(crypto)
fn main() {
    let a = substr("café", 0, 4)
    println("{len(a)}")
    println("{base64_encode(a)}")
    println("{sha256(a)}")
    println("{sha1_hex(a)}")
    println("{sha1_base64(a)}")
    println("{substr(sha512(a), 0, 32)}")
    println("{hmac_sha256("k", a)}")
    println("{sha256(a) == sha256("")}")
    println("{base64_encode("café")}")
}
