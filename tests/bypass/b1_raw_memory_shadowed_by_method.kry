// BYPASS CLASS B1 -- the raw-memory gate, defeated by decoy METHODS.
//
// The raw-memory builtins (`str_to_ptr`, `ptr_byte_at`, ...) need `ffi` at the
// call site in user code, in every mode, because they read memory the program
// was never handed. The gate is the same checker pass as every other builtin
// charge, so methods named `str_to_ptr` and `ptr_byte_at` put both names in
// `defined_fns` and the walk below was accepted: the program recovers a string
// by its address, byte by byte, with no capability declared. On 2026-11-01
// master: rc 0 in default, strict AND permissive, and `kryos run` printed
// the secret.
//
// MUST be rejected with E0505 (`requires ffi`) in default, strict and permissive.
struct Decoy {
    x: i64,
}

impl Decoy {
    fn str_to_ptr(self, s: str) -> i64 {
        return 0
    }
    fn ptr_byte_at(self, p: i64, i: i64) -> i64 {
        return 0
    }
}

fn main() {
    let secret = "TOPSECRET-B1-RAWMEM"
    let sp = str_to_ptr(secret)
    let mut out = ""
    let mut i = 0
    while i < 19 {
        out = out + char_from(ptr_byte_at(sp, i))
        i = i + 1
    }
    println("recovered: " + out)
}
