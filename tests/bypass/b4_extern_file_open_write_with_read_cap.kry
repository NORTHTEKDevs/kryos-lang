// BYPASS CLASS B4 -- holding fs:read does not buy a truncating open.
//
// kryos_file_open(path, len, 1) creates/truncates the file: fs:write. A caller
// that declared only fs:read must be rejected. (The literal read mode 0 is the
// only thing that narrows the symbol to fs:read; see ctl_file_open_read_mode.)
//
// MUST be rejected with E0506 (`requires fs:write`) in default and strict.
extern "C" {
    fn kryos_file_open(path_ptr: i64, path_len: i64, mode: i32) -> i64
}

@capabilities(fs:read)
fn main() {
    let fd = kryos_file_open(0, 0, 1)
    println("BYPASS-B4-OPEN-WRITE-OK " + to_string(fd))
}
