// expect: answer
// expect: greeting
// expect: not found

// Test pattern matching
let x = match 42 {
    1 => "one",
    42 => "answer",
    _ => "other",
}
println(x)

match "hello" {
    "bye" => println("bye"),
    "hello" => println("greeting"),
    _ => println("unknown"),
}

let status = match 404 {
    200 => "ok",
    404 => "not found",
    500 => "error",
    _ => "unknown",
}
println(status)
