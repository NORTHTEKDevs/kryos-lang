// expect: pure result: 25
// expect: network result: connected

// Pure compute function — no capabilities needed
fn pure_math(x: i32) -> i32 {
    return x * x
}

println("pure result: " + to_string(pure_math(5)))

// Function with network capability
@capabilities(network)
fn connect_to_server() -> str {
    // In a real implementation this would use the network
    // For now it just demonstrates the capability declaration
    return "connected"
}

println("network result: " + connect_to_server())
