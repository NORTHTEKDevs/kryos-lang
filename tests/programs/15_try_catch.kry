// expect: custom error
// expect: 42
// expect: inner: inner
// expect: outer: outer
// expect: after try/catch

// Test try/catch/throw
try {
    throw "custom error"
} catch (e) {
    println(e)
}

try {
    let x = 42
    println(x)
} catch (e) {
    println("should not print")
}

// Nested try/catch
try {
    try {
        throw "inner"
    } catch (e) {
        println("inner: " + e)
        throw "outer"
    }
} catch (e) {
    println("outer: " + e)
}

println("after try/catch")
