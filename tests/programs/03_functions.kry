fn add(a: i32, b: i32) -> i32 {
    return a + b
}

println(add(5, 10))

fn factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

println(factorial(5))

fn greet(name: str) -> str {
    return "hello " + name
}

println(greet("world"))
