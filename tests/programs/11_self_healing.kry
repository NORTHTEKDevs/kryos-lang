// expect: 5
// expect: safe result: 57
// expect: array value: 3

// Self-healing: type coercion on mixed operations
let x = 5
println(x)

// Capability-annotated function with self-healing
@capabilities(compute)
fn safe_compute(n: i32) -> i32 {
    return n * n + n + 1
}

println("safe result: " + to_string(safe_compute(7)))

// Self-healing: index clamping (access index 10 on a 5-element array)
let arr = [1, 2, 3, 4, 5]
let val = arr[2]
println("array value: " + to_string(val))
