// expect: positive
// expect: 0 1 2 3 4
// expect: 10
// expect: even

let x = 5
if x > 0 {
    println("positive")
} elif x == 0 {
    println("zero")
} else {
    println("negative")
}

let mut result = ""
for i in range(0, 5) {
    if result != "" {
        result = result + " "
    }
    result = result + to_string(i)
}
println(result)

let mut sum = 0
let mut i = 0
while i < 5 {
    sum = sum + i
    i = i + 1
}
println(sum)

if 4 % 2 == 0 {
    println("even")
} else {
    println("odd")
}
