// expect: 7
// expect: Hello, World
// expect: 10

// Test anonymous function syntax
let add = fn(a, b) {
    return a + b
}
println(add(3, 4))

let greet = fn(name) {
    return "Hello, " + name
}
println(greet("World"))

// Higher-order function
fn apply(f, x) {
    return f(x)
}
let double = fn(n) { return n * 2 }
println(apply(double, 5))
