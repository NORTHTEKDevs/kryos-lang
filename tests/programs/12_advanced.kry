// expect: 10
// expect: sum: 55
// expect: FrostByte
// expect: max: 99

// Nested function calls
fn square(x: i32) -> i32 {
    return x * x
}

fn add_one(x: i32) -> i32 {
    return x + 1
}

println(add_one(square(3)))

// Accumulator pattern
fn sum_to(n: i32) -> i32 {
    let mut total = 0
    let mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

println("sum: " + to_string(sum_to(10)))

// String building
fn build_name() -> str {
    let parts = ["Frost", "Byte"]
    return parts[0] + parts[1]
}

println(build_name())

// Find max in dynamic data
fn find_max(data: [i32]) -> i32 {
    let mut best = data[0]
    for i in range(1, len(data)) {
        if data[i] > best {
            best = data[i]
        }
    }
    return best
}

println("max: " + to_string(find_max([42, 17, 99, 3, 56])))
