// Pin (finish item A20): a tuple is a VALUE. On the JIT it is one refcounted heap array that
// every owner shared, so a field write through one name showed through the others (AOT copies).
use std::option::{Option, Some, None}
struct S { p: (i64, str), q: i64 }
struct Pt { x: i64, y: i64 }
fn modify(t: (i64, str)) -> (i64, str) {
    let mut c = t
    c.0 = c.0 + 100
    return c
}
fn main() {
    // compound assign
    let a1 = (1, "a")
    let mut b1 = a1
    b1.0 += 5
    println("1 a={a1.0} b={b1.0}")
    // map value read then write via map
    let mut mp = {"k": (5, "v")}
    let mv = mp["k"]
    mp["k"].0 = 6
    println("3 mp={mp["k"].0} mv={mv.0}")
    // tuple with struct elem
    let mut ts = (Pt { x: 1, y: 2 }, 3)
    let ts2 = ts
    ts.1 = 9
    println("5 ts={ts.1} ts2={ts2.1} {ts.0.x} {ts2.0.x}")
    // nested tuple shared outer
    let mut n = (1, (2, "n"))
    let m = n
    n.1.0 = 99
    println("6 n={n.1.0} m={m.1.0}")
    // nested via inner copy
    let mut n2 = (1, (2, "n"))
    let inner = n2.1
    n2.1.0 = 55
    println("7 n2={n2.1.0} inner={inner.0}")
    // call result mutated
    let t8 = (1, "z")
    let r8 = modify(t8)
    println("8 t8={t8.0} r8={r8.0}")
    // swap
    let mut s1 = (1, "a")
    let mut s2 = (2, "b")
    let tmp = s1
    s1 = s2
    s2 = tmp
    s1.0 = 10
    s2.0 = 20
    println("9 s1={s1.0} s2={s2.0} tmp={tmp.0}")
    // struct holding tuple, struct copy
    let mut st = S { p: (1, "p"), q: 0 }
    let st2 = st
    st.p.0 = 42
    println("10 st={st.p.0} st2={st2.p.0}")
    // option payload
    let o = Some((1, "o"))
    match o {
        Some(v) => {
            let mut w = v
            w.0 = 33
            println("11 v={v.0} w={w.0}")
        }
        None => println("none")
    }
    // loop sharing: build array of copies
    let base = (0, "base")
    let mut out = [(0, "z")]
    for i in 0..3 {
        let mut c = base
        c.0 = i + 1
        push(out, c)
    }
    println("12 base={base.0} out={out[1].0}{out[2].0}{out[3].0}")
    // same tuple pushed twice then element write
    let tt = (1, "t")
    let mut arr2 = [(0, "z")]
    push(arr2, tt)
    push(arr2, tt)
    arr2[1].0 = 8
    println("13 tt={tt.0} {arr2[1].0} {arr2[2].0}")
    // index with variable
    let mut arr3 = [(1, "a"), (2, "b")]
    let k = 1
    let held = arr3[k]
    arr3[k].0 = 22
    println("14 held={held.0} arr3={arr3[1].0}")
    // 3 owners
    let o1 = (1, "q")
    let mut o2 = o1
    let mut o3 = o1
    o2.0 = 2
    o3.0 = 3
    println("15 {o1.0} {o2.0} {o3.0}")
}
