enum E { A((i64, i64)), B }
struct S { p: (i64, i64), q: (i64, str) }
fn mk() -> (i32, i32) { let a: i32 = -3  let b: i32 = 4  return (a, b) }
fn mku() -> (u8, u32) { let a: u8 = 200  let b: u32 = 4000000000  return (a, b) }
fn mks() -> (i32, str) { return (5, "five") }
fn take(t: (i64, i64)) -> i64 { return t.0 * 1000 + t.1 }
fn takes(t: (i64, str)) -> str { return "{t.0}:{t.1}" }
fn nest() -> ((i32, i32), i64) { return ((1, 2), 3) }
fn pick(c: bool) -> (i64, i64) {
    if c { return mk() }
    return mku()
}
fn pick2(c: bool) -> (i64, i64) {
    let r: (i64, i64) = if c { mk() } else { (7, 8) }
    return r
}
fn main() {
    let u = mku()
    let w: (i64, i64) = u
    println("{w.0} {w.1}")
    println("{take(mku())} {take(mk())}")
    let s = S { p: mku(), q: mks() }
    println("{s.p.0} {s.p.1} {s.q.0} {s.q.1}")
    println(takes(mks()))
    let n: ((i64, i64), i64) = nest()
    println("{n.0.0} {n.0.1} {n.1}")
    let e = E.A(mku())
    match e {
        E.A(t) => { println("A {t.0} {t.1}") }
        E.B => { println("B") }
    }
    let mut m: map<str, (i64, i64)> = {}
    m["k"] = mku()
    println("{m["k"].0} {m["k"].1}")
    let mut xs: [(i64, i64)] = []
    xs = [mku(), mku()]
    xs[1] = mku()
    println("{xs[0].0} {xs[1].1}")
    let p1 = pick(true)
    let p2 = pick(false)
    println("{p1.0} {p1.1} {p2.0} {p2.1}")
    let q1 = pick2(true)
    let q2 = pick2(false)
    println("{q1.0} {q1.1} {q2.0} {q2.1}")
    let r = match 1 { 1 => mku(), _ => (0, 0) }
    let rr: (i64, i64) = r
    println("{rr.0} {rr.1}")
    let mut v: (i64, i64) = (0, 0)
    v = mku()
    println("{v.0} {v.1}")
    let (a, b) = mku()
    println("{a} {b}")
}
