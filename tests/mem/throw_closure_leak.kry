// Peak-RSS probe for two Cranelift-only leaks (LEDGER "leakmode" entry).
//
//   throw_locals     - a function that `throw`s directly (outside any try)
//                      left every named local live at the throw un-released:
//                      the codegen unwind check only runs after a CALL that
//                      left an exception pending, never at the throw itself.
//   throw_loop       - the same with a loop local and the for-loop iterable
//                      live at the throw, plus a callee-owned struct param.
//   clo_nested_tuple - a closure env capturing [[(str, i64)]] released the
//                      rows but not the tuples in them (array_free_chain
//                      stopped at a tuple leaf).
//   clo_nested_tuple3- the same one level deeper.
//
// Run:  LEAK_MODE=<mode> LEAK_ITERS=<n> ./throw_closure_leak
// Gate: tests/mem_throw_closure_gate.sh
struct P { name: str, n: i64 }

fn thrower(i: i64) {
    let p = P { name: "t{i}-padpadpad", n: i }
    let s = "q{i}" + "-padpadpad"
    if len(p.name) + len(s) > 0 {
        throw "boom"
    }
}

fn thrower_loop(owned: P, i: i64) {
    let head = "h{i}-padpadpad"
    let xs = [P { name: "a{i}-padpad", n: 1 }, P { name: "b{i}-padpad", n: 2 }]
    for x in xs {
        let tmp = "t-" + x.name
        if x.n == 2 && len(tmp) + len(head) > 0 {
            throw "boom"
        }
    }
}

fn mk2(i: i64) -> fn() -> str {
    let ys = [[("a{i}", i)], [("b{i}", i), ("c{i}", i)]]
    return || ys[0][0].0 + ys[1][1].0
}

fn mk3(i: i64) -> fn() -> str {
    let ys = [[[("a{i}", i)]], [[("b{i}", i), ("c{i}", i)]]]
    return || ys[0][0][0].0 + ys[1][0][1].0
}

@capabilities(process)
fn main() {
    let mode = env_get("LEAK_MODE")
    let raw = env_get("LEAK_ITERS")
    let iters = if len(raw) == 0 { 300000 } else { parse_int(raw) }
    let keep = P { name: "keep", n: 0 }
    let mut sink = 0
    let mut i = 0
    while i < iters {
        if mode == "throw_locals" {
            try { thrower(i) } catch e { sink = sink + len(e) }
        } elif mode == "throw_loop" {
            try { thrower_loop(keep, i) } catch e { sink = sink + len(e) }
        } elif mode == "clo_nested_tuple" {
            let f = mk2(i)
            sink = sink + len(f())
        } elif mode == "clo_nested_tuple3" {
            let f = mk3(i)
            sink = sink + len(f())
        } else {
            println("unknown LEAK_MODE: " + mode)
            exit(2)
        }
        i = i + 1
    }
    println("{mode} iters={iters} sink={sink} {keep.name}")
}
