// Peak-RSS probe for two Cranelift-only leaks (LEDGER "leakmode" entry).
//
//   throw_locals     - a function that `throw`s directly (outside any try)
//                      left every named local live at the throw un-released:
//                      the codegen unwind check only runs after a CALL that
//                      left an exception pending, never at the throw itself.
//   throw_loop       - the same with a loop local and the for-loop iterable
//                      live at the throw, plus a callee-owned struct param.
//   clo_nested_tuple - a closure env capturing [[(str, i64)]] released the
//                      rows but not the tuples in them (array_free_chain
//                      stopped at a tuple leaf).
//   clo_nested_tuple3- the same one level deeper.
//   try_throw / try_throw_loop / try_rethrow - a `throw` INSIDE a try body left
//                      the named locals the try body had declared (and a for
//                      loop's iterable) live: the catch path never released them.
//   clo_tuple_arr / clo_tuple_tuple / clo_struct_rows / clo_flat_arr /
//   clo_flat_tuple   - a closure env (or a struct drop helper) released a
//                      tuple's array / tuple field and a row's tuples one level
//                      deep, leaking what those held.
//   clo_chain        - a closure calling a captured closure inline (`g() + "x"`)
//                      leaked the call's string result.
//
// Run:  LEAK_MODE=<mode> LEAK_ITERS=<n> ./throw_closure_leak
// Gate: tests/mem_throw_closure_gate.sh
struct P { name: str, n: i64 }

fn thrower(i: i64) {
    let p = P { name: "t{i}-padpadpad", n: i }
    let s = "q{i}" + "-padpadpad"
    if len(p.name) + len(s) > 0 {
        throw "boom"
    }
}

fn thrower_loop(owned: P, i: i64) {
    let head = "h{i}-padpadpad"
    let xs = [P { name: "a{i}-padpad", n: 1 }, P { name: "b{i}-padpad", n: 2 }]
    for x in xs {
        let tmp = "t-" + x.name
        if x.n == 2 && len(tmp) + len(head) > 0 {
            throw "boom"
        }
    }
}

fn mk2(i: i64) -> fn() -> str {
    let ys = [[("a{i}", i)], [("b{i}", i), ("c{i}", i)]]
    return || ys[0][0].0 + ys[1][1].0
}

fn mk3(i: i64) -> fn() -> str {
    let ys = [[[("a{i}", i)]], [[("b{i}", i), ("c{i}", i)]]]
    return || ys[0][0][0].0 + ys[1][0][1].0
}

struct H { rows: [[(str, i64)]], tag: str }

fn try_throw_fn(i: i64) -> i64 {
    try {
        let in1 = "in{i}-padpadpad"
        let arr = ["a{i}-padpadpad"]
        if len(in1) + len(arr) > 0 { throw "inner" }
    } catch e { return len(e) }
    return 0
}

fn try_throw_loop_fn(i: i64) -> i64 {
    let mut n = 0
    try {
        for k in [1, 2, 3] {
            let t = "lp{i}-{k}-padpadpad"
            if k == 2 && len(t) > 0 { throw "loopthrow" }
            n = n + len(t)
        }
    } catch e { n = n + len(e) }
    let mut k = 0
    while k < 3 {
        try {
            let t = "w{i}-{k}-padpadpad"
            let u = [t, "z{k}-padpad"]
            if k == 1 { throw "wh" }
            n = n + len(u)
        } catch e { n = n + len(e) }
        k = k + 1
    }
    return n
}

fn try_rethrow_fn(i: i64) -> i64 {
    try {
        try {
            let in1 = "in{i}-padpadpad"
            let arr = ["a{i}-padpadpad"]
            if len(in1) + len(arr) > 0 { throw "inner" }
        } catch e { throw "outer" }
    } catch e2 { return len(e2) }
    return 0
}

fn mk_tuple_arr(i: i64) -> fn() -> str {
    let ys = [[("a{i}", ["x{i}"])], [("b{i}", ["y{i}"])]]
    return || ys[0][0].0 + ys[1][0].0
}

fn mk_tuple_tuple(i: i64) -> fn() -> str {
    let ys = [[(("a{i}", i), "s{i}")], [(("b{i}", i), "t{i}")]]
    return || ys[0][0].1 + ys[1][0].1
}

fn mk_struct_rows(i: i64) -> fn() -> str {
    let h = H { rows: [[("a{i}", i)], [("b{i}", i)]], tag: "tg{i}" }
    return || h.rows[0][0].0 + h.tag
}

fn mk_flat_arr(i: i64) -> fn() -> str {
    let ys = [("a{i}", ["x{i}"]), ("b{i}", ["y{i}"])]
    return || ys[0].0 + ys[1].0
}

fn mk_flat_tuple(i: i64) -> fn() -> str {
    let ys = [(("a{i}", i), "s{i}"), (("b{i}", i), "t{i}")]
    return || ys[0].1 + ys[1].1
}

fn mk_chain(i: i64) -> fn() -> str {
    let ys = [[[("a{i}", i)]], [[("b{i}", i)]]]
    let g = || ys[0][0][0].0
    return || g() + "x"
}

@capabilities(process)
fn main() {
    let mode = env_get("LEAK_MODE")
    let raw = env_get("LEAK_ITERS")
    let iters = if len(raw) == 0 { 300000 } else { parse_int(raw) }
    let keep = P { name: "keep", n: 0 }
    let mut sink = 0
    let mut i = 0
    while i < iters {
        if mode == "throw_locals" {
            try { thrower(i) } catch e { sink = sink + len(e) }
        } elif mode == "throw_loop" {
            try { thrower_loop(keep, i) } catch e { sink = sink + len(e) }
        } elif mode == "clo_nested_tuple" {
            let f = mk2(i)
            sink = sink + len(f())
        } elif mode == "clo_nested_tuple3" {
            let f = mk3(i)
            sink = sink + len(f())
        } elif mode == "try_throw" {
            sink = sink + try_throw_fn(i)
        } elif mode == "try_throw_loop" {
            sink = sink + try_throw_loop_fn(i)
        } elif mode == "try_rethrow" {
            sink = sink + try_rethrow_fn(i)
        } elif mode == "clo_tuple_arr" {
            let f = mk_tuple_arr(i)
            sink = sink + len(f())
        } elif mode == "clo_tuple_tuple" {
            let f = mk_tuple_tuple(i)
            sink = sink + len(f())
        } elif mode == "clo_struct_rows" {
            let f = mk_struct_rows(i)
            sink = sink + len(f())
        } elif mode == "clo_flat_arr" {
            let f = mk_flat_arr(i)
            sink = sink + len(f())
        } elif mode == "clo_flat_tuple" {
            let f = mk_flat_tuple(i)
            sink = sink + len(f())
        } elif mode == "clo_chain" {
            let f = mk_chain(i)
            sink = sink + len(f())
        } else {
            println("unknown LEAK_MODE: " + mode)
            exit(2)
        }
        i = i + 1
    }
    println("{mode} iters={iters} sink={sink} {keep.name}")
}
