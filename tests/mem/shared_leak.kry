// Leak / balance probe for `shared` structures and by-value struct params
// (LEDGER items 137 and 139). Each mode builds and drops a structure
// LEAK_ITERS times. Two readers:
//   tests/mem_balance_gate.sh  runs it with KRYOS_ALLOC_STATS=1 and a small
//                              LEAK_ITERS and checks the exit-time live counts.
//   a peak-RSS poller          a leak grows RSS linearly with LEAK_ITERS.
// Modes (LEAK_MODE):
//   tree_drop      r1: depth-10 Option<shared Tree> built with `make`, dropped
//   tree_let_call  r2: same tree, `let c = check(t)`
//   tree_embedded  r3: same tree, `sum = sum + check(t)` (embedded call)
//   list_drop      r7: 2000-node Option<shared L> singly linked list, dropped
//   match_field    item 139: `match h.o` on an Option<In> field of a by-value
//                  struct param, In holding a str
//   shared_scalar  control: `let a = shared <int>`
//   plain_embedded control: plain struct with a str field, `sum = sum + f(p)`
//   array_tree     control: recursive struct built from arrays
//   enum_shared    item 137: user enum whose variants hold `shared` payloads,
//                  passed by value to a matching function
//   index_read     item 137: `[shared N]` built with push, an element read
//                  through `(*arr[j]).v`
//   bind_consumers item 137: a `shared` handle moved into a struct literal, an
//                  array literal, a field assignment and a let alias
//   forin_shared   item 137: `for x in xs` over a `[shared N]`, read through `*x`
//   field_read     item 137: a struct that owns a `shared` field, read through
//                  it (`(*b.h).v`), returned (`return b.h`), pushed, wrapped in
//                  `Some`, bound with `let`, and passed by value
//   fresh_arg      item 137: a fresh `shared x` passed straight to a user
//                  function that reads it, returns it, keeps it in a struct
//                  literal, pushes it or wraps it in `Some` (the reader also
//                  `let`-aliases its param)
//   tuple_copy     item 137: `return (*a, 3)` of a `shared` struct, read after
//                  allocator churn (the tuple owns its copy, the arc frees its
//                  own contents)
// Every mode prints one deterministic line: `mode <mode> sum <n>`.
use std::option::{Option}

struct Tree { left: Option<shared Tree>, right: Option<shared Tree> }
struct L { next: Option<shared L>, v: i64 }
struct P { name: str, n: i64 }
struct Node { kids: [Node], v: i64 }
struct In { s: str }
struct Hold { o: Option<In>, n: i64 }
enum Lst { Nil, Cons(i64, shared Lst) }
struct N { v: i64, tag: str }
struct Box1 { h: shared N, k: i64 }

fn build_lst(d: i64) -> Lst {
    if d == 0 { return Lst.Nil() }
    return Lst.Cons(d, shared build_lst(d - 1))
}

fn sum_lst(e: Lst) -> i64 {
    match e {
        Lst.Nil => { return 0 },
        Lst.Cons(n, a) => { return n + sum_lst(*a) },
    }
}

fn fill(i: i64) -> [shared N] {
    let mut arr: [shared N] = []
    let mut j = 0
    while j < 5 {
        let s: shared N = shared N { v: i * 10 + j, tag: "e" + to_string(j) }
        arr = push(arr, s)
        j = j + 1
    }
    return arr
}

fn read_arr(arr: [shared N]) -> i64 {
    let mut t = 0
    let mut j = 0
    while j < 5 {
        t = t + (*arr[j]).v
        j = j + 1
    }
    return t
}

fn consumers(i: i64) -> i64 {
    let a: shared N = shared N { v: i, tag: "c" + to_string(i) }
    let b = Box1 { h: a, k: 1 }
    let c = [a, a]
    let mut d = Box1 { h: shared N { v: 0, tag: "z" }, k: 2 }
    d.h = a
    let e = a
    return b.k + d.k + 1
}

fn walk(xs: [shared N]) -> i64 {
    let mut t = 0
    for x in xs { t = t + (*x).v }
    return t
}

fn forin(i: i64) -> i64 {
    let mut xs: [shared N] = []
    xs = push(xs, shared N { v: i, tag: "f" + to_string(i) })
    xs = push(xs, shared N { v: i + 1, tag: "g" + to_string(i) })
    return walk(xs)
}

fn mk_box(i: i64) -> Box1 {
    return Box1 { h: shared N { v: i, tag: "b" + to_string(i) + "-pad-pad" }, k: 2 }
}

fn box_rd(b: Box1) -> i64 { return (*b.h).v + b.k }

fn box_ret(i: i64) -> shared N {
    let b = mk_box(i)
    return b.h
}

fn box_push(i: i64) -> [shared N] {
    let b = mk_box(i)
    let mut xs: [shared N] = []
    xs = push(xs, b.h)
    return xs
}

fn box_some(i: i64) -> Option<shared N> {
    let b = mk_box(i)
    return Some(b.h)
}

fn box_let(i: i64) -> shared N {
    let b = mk_box(i)
    let a = b.h
    return a
}

fn field_read(i: i64) -> i64 {
    let b = mk_box(i)
    let r = box_ret(i + 1)
    let p = box_push(i + 2)
    let l = box_let(i + 3)
    let mut t = (*b.h).v + box_rd(b) + (*r).v + (*p[0]).v + (*l).v
    match box_some(i + 4) {
        Option.Some(x) => { t = t + (*x).v },
        Option.None => { t = t + 0 },
    }
    return t
}

fn id_arg(h: shared N) -> shared N { return h }
fn keep_arg(h: shared N) -> Box1 { return Box1 { h: h, k: 1 } }
fn push_arg(h: shared N) -> [shared N] {
    let mut xs: [shared N] = []
    xs = push(xs, h)
    return xs
}
fn wrap_arg(h: shared N) -> Option<shared N> { return Some(h) }
fn rd_arg(h: shared N) -> i64 {
    let b = h
    return (*b).v + len((*h).tag)
}
fn fresh(i: i64) -> N { return N { v: i, tag: "a" + to_string(i) + "-pad-pad" } }

fn fresh_arg(i: i64) -> i64 {
    let a = id_arg(shared fresh(i))
    let b = keep_arg(shared fresh(i + 1))
    let c = push_arg(shared fresh(i + 2))
    let d = wrap_arg(shared fresh(i + 3))
    let z = churn(i * 100)
    let mut t = (*a).v + (*b.h).v + (*c[0]).v + rd_arg(shared fresh(i + 4)) + z * 0
    match d {
        Option.Some(x) => { t = t + (*x).v },
        Option.None => { t = t + 0 },
    }
    return t
}

fn tup(i: i64) -> (N, i64) {
    let a = shared N { v: i, tag: "t" + to_string(i) + "-pad-pad" }
    return (*a, 3)
}

fn churn(k: i64) -> i64 {
    let mut a = 0
    let mut j = 0
    while j < 20 {
        let n: shared N = shared N { v: k + j, tag: "c-" + to_string(k + j) + "-pad-pad" }
        a = a + (*n).v + len((*n).tag)
        j = j + 1
    }
    return a
}

fn tuple_copy(i: i64) -> i64 {
    let tp = tup(i)
    let c = churn(i * 100)
    return tp.0.v + len(tp.0.tag) + tp.1 + c * 0
}

fn make(depth: i64) -> Tree {
    if depth == 0 {
        return Tree { left: None(), right: None() }
    }
    return Tree {
        left: Some(shared make(depth - 1)),
        right: Some(shared make(depth - 1)),
    }
}

fn check(t: Tree) -> i64 {
    match t.left {
        Option.None => return 1,
        Option.Some(s) => {
            match t.right {
                Option.None => return 1,
                Option.Some(r) => return 1 + check(*s) + check(*r),
            }
        },
    }
}

fn chain(n: i64) -> L {
    if n == 0 {
        return L { next: None(), v: 0 }
    }
    return L { next: Some(shared chain(n - 1)), v: n }
}

fn f(p: P) -> i64 { return p.n + len(p.name) }

fn hold_len(h: Hold) -> i64 {
    match h.o {
        Option.Some(x) => return len(x.s),
        Option.None => return 0,
    }
}

fn mk_node(depth: i64) -> Node {
    if depth == 0 {
        let empty: [Node] = []
        return Node { kids: empty, v: 1 }
    }
    let mut ks: [Node] = []
    ks = push(ks, mk_node(depth - 1))
    ks = push(ks, mk_node(depth - 1))
    return Node { kids: ks, v: depth }
}

fn count(n: Node) -> i64 {
    let mut c = 1
    for k in n.kids { c = c + count(k) }
    return c
}

@capabilities(process)
fn main() {
    let n = parse_int(env_get("LEAK_ITERS"))
    let mode = env_get("LEAK_MODE")
    let mut i = 0
    let mut sum = 0
    while i < n {
        if mode == "tree_drop" {
            let t = make(10)
            sum = sum + 1
        } elif mode == "tree_let_call" {
            let t = make(10)
            let c = check(t)
            sum = sum + c
        } elif mode == "tree_embedded" {
            let t = make(10)
            sum = sum + check(t)
        } elif mode == "list_drop" {
            let c = chain(2000)
            sum = sum + 1
        } elif mode == "shared_scalar" {
            let a = shared i
            sum = sum + *a
        } elif mode == "plain_embedded" {
            let p = P { name: "name-" + to_string(i) + "-padding-padding-padding", n: i }
            sum = sum + f(p)
        } elif mode == "match_field" {
            let h = Hold { o: Some(In { s: "payload-" + to_string(i) + "-pad" }), n: i }
            sum = sum + hold_len(h)
        } elif mode == "enum_shared" {
            sum = sum + sum_lst(build_lst(20))
        } elif mode == "index_read" {
            let arr = fill(i)
            sum = sum + read_arr(arr)
        } elif mode == "bind_consumers" {
            sum = sum + consumers(i)
        } elif mode == "forin_shared" {
            sum = sum + forin(i)
        } elif mode == "field_read" {
            sum = sum + field_read(i)
        } elif mode == "fresh_arg" {
            sum = sum + fresh_arg(i)
        } elif mode == "tuple_copy" {
            sum = sum + tuple_copy(i)
        } elif mode == "array_tree" {
            let t = mk_node(10)
            sum = sum + count(t)
        }
        i = i + 1
    }
    println("mode " + mode + " sum " + to_string(sum))
}
