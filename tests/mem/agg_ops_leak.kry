use std::iter::{map}
// Peak-RSS probe for aggregate operations (tests/mem_agg_ops_gate.sh).
// Each mode runs LEAK_ITERS iterations of one shape that leaked per call:
// structural ==, to_string/interpolation and assert_eq of aggregates (the
// synthesized helpers' and-chains and replace chains), a short-circuit
// and-chain over field reads, and an element read off a fresh tuple.
struct P { name: str, xs: [i64] }
struct Gin { name: str }
struct Gig { inner: Gin, n: i64 }
let mut GG: Gig = Gig { inner: Gin { name: "a" }, n: 0 }

fn mkq(i: i64) -> P { return P { name: "q{i}", xs: [i] } }
fn mk(i: i64) -> (str, [i64]) { return ("k{i}", [i, i]) }
fn mkp(i: i64) -> (P, str) { return (P { name: "p{i}", xs: [i] }, "s{i}") }
enum E { A(P), B(str), C }
fn mke(i: i64) -> E {
    if i % 3 == 0 { return E.A(P { name: "e{i}", xs: [i] }) }
    if i % 3 == 1 { return E.B("b{i}") }
    return E.C
}
// A `continue` / `break` in one arm released the subject only on that path
// and suppressed the release on every other.
fn match_exits(n: i64) -> i64 {
    let mut i = 0
    let mut a = 0
    while i < n {
        match mke(i) {
            E.A(p) => {
                a = a + len(p.name)
                i = i + 1
                continue
            }
            E.B(s) => { if i > 3 { break } }
            E.C => { a = a + 1 }
        }
        i = i + 1
    }
    return a
}
fn first(t: (P, str)) -> P { return t.0 }
enum Ek { Ka(str), Kb }
enum Nin { Nx(str), Nz }
enum Nout { Nw(Nin), Nv(Nin, str), Nu }
struct Hf { f: fn(i64) -> i64 }
struct Ptf { name: str, t: (str, i64) }
struct Pc { inner: P, n: i64, tag: str }
trait Lg {
    fn log(self: Self, msg: str)
}
struct Lgr { n: i64 }
impl Lg for Lgr {
    fn log(self: Lgr, msg: str) { if len(msg) == 999 { println(msg) } }
}
fn dlg(d: dyn Lg, i: i64) { d.log("m{i}") }
// A struct with a heap field coerced to a `dyn` (the fat box and the data
// copy leaked per coercion: 125-186MB per 1M).
struct Lgs { n: i64, name: str }
impl Lg for Lgs {
    fn log(self: Lgs, msg: str) { if len(msg) == 999 { println(msg) } }
}
struct Dh { d: dyn Lg, k: i64 }
fn mkd(i: i64) -> dyn Lg { return Lgs { n: i, name: "r{i}" } }
fn mkd_local(i: i64) -> dyn Lg {
    let s: dyn Lg = Lgs { n: i, name: "l{i}" }
    return s
}
fn pass_d(d: dyn Lg) -> dyn Lg { return d }
fn gen_id<T>(x: T) -> T { return x }
fn gen_first<T>(a: T, b: T) -> T { return a }
fn hold_d(d: dyn Lg, k: i64) -> Dh { return Dh { d: d, k: k } }
fn dh_log(h: Dh) { h.d.log("h") }
fn dyn_clo(d: dyn Lg) -> fn(i64) -> i64 { return |k: i64| -> i64 { d.log("c") return k } }
fn show_p(p: P) {
    if len(p.name) == 99 { println(p.name) }
}
fn use_f(f: fn(i64) -> i64) -> i64 { return f(1) }

fn match_tuple(i: i64) -> i64 {
    match mk(i) {
        (s, xs) if len(xs) > 0 => { return len(s) }
        _ => { return 0 }
    }
}

struct Hfs { f: fn(i64) -> str }
struct Hat { items: [(str, i64)] }
enum Eat { Items([(str, i64)]), Nothing }
fn mk_atc(i: i64) -> fn() -> i64 {
    let xs = [("o{i}", i), ("p{i}", i)]
    return || len(xs[1].0)
}

struct Pbr { name: str, n: i64 }
fn pbr_n(i: i64) -> i64 {
    let s = Pbr { name: "r{i}", n: i }
    return s.n
}
fn mkfn(i: i64) -> fn(i64) -> str {
    let s = "c{i}"
    return |x: i64| s
}
struct Smh { m: map<str, str> }
enum Wmh { Has(map<str, str>), No }
fn mkmh(i: i64) -> map<str, str> {
    let mut m: map<str, str> = {}
    m["k"] = "m{i}"
    return m
}
fn wmh_len(w: Wmh) -> i64 {
    return match w {
        Wmh.Has(m) => len(m),
        Wmh.No => 0,
    }
}

@capabilities(all)
fn main() {
    let iters = parse_int(env_get("LEAK_ITERS"))
    let mode = env_get("LEAK_MODE")
    // cap_struct: a closure mutating a captured struct, called every iteration
    // (field stores and a whole reassignment, rewritten into field stores).
    let mut cs = Pc { inner: P { name: "c", xs: [] }, n: 0, tag: "t" }
    let step = |k: i64| {
        cs.tag = "s{k}"
        cs.inner = P { name: "i{k}", xs: [k] }
        cs = Pc { inner: P { name: "w{k}", xs: [k] }, n: cs.n + 1, tag: cs.tag + "w" }
        return cs.n
    }
    // clo_push_if: a struct local captured by a closure that pushes an
    // `if` value naming it.
    let cap = P { name: "cap", xs: [1, 2] }
    let push_if = |k: i64| -> i64 {
        let mut arr: [P] = []
        arr = push(arr, if k % 2 == 0 { cap } else { P { name: "o", xs: [] } })
        return len(arr)
    }
    // cap_escape: the captured struct pushed, stored into a field, and
    // returned as the closure's tail value, every iteration.
    let mut ce = P { name: "e", xs: [] }
    let esc = |k: i64| -> i64 {
        ce.name = "e{k}"
        let mut arr: [P] = []
        arr = push(arr, ce)
        let mut hold = Pc { inner: P { name: "h", xs: [] }, n: 0, tag: "t" }
        hold.inner = ce
        return len(arr) + hold.n
    }
    let tailv = |k: i64| -> P {
        ce.name = "t{k}"
        ce
    }
    // if_struct: a closure's captured struct as an if/match value. (A local
    // named as a match arm's value, and temporaries in a `_` arm, are still
    // known leaks -- LEDGER -- so neither appears here.)
    let mut cf = P { name: "f", xs: [] }
    let pickc = |k: i64| -> P {
        cf.name = "c{k}"
        let r = if k % 2 == 0 { cf } else { P { name: "o{k}", xs: [k] } }
        if k % 3 == 0 { cf } else { P { name: "s", xs: [] } }
        let m = match k % 3 {
            0 => cf,
            1 => P { name: "p{k}", xs: [len(r.name)] },
            _ => cf,
        }
        return m
    }
    let dl: dyn Lg = Lgr { n: 1 }
    let mut i = 0
    let mut acc = 0
    while i < iters {
        let p = P { name: "q{i}", xs: [i] }
        let q = P { name: "q{i}", xs: [i] }
        if mode == "eqstruct" {
            if p == q { acc = acc + 1 }
        } elif mode == "eqarr" {
            if [p] == [q] { acc = acc + 1 }
        } elif mode == "eqtuple" {
            if mk(i) == mk(i) { acc = acc + 1 }
        } elif mode == "andchain" {
            let b = p.name == q.name and len(p.xs) == len(q.xs)
            if b { acc = acc + 1 }
        } elif mode == "tostr" {
            acc = acc + len(to_string(p)) + len("{mk(i)}")
        } elif mode == "assert" {
            assert_eq(p, q)
            assert_eq(mk(i), mk(i))
            acc = acc + 1
        } elif mode == "tuple_elem" {
            acc = acc + len(mkp(i).1) + len(mk(i).0)
        } elif mode == "let_if" {
            let s = if i % 2 == 0 { "a{i}" } else { to_string(p) }
            acc = acc + len(s)
        } elif mode == "match_exit" {
            acc = acc + match_exits(6)
        } elif mode == "match_tuple" {
            acc = acc + match_tuple(i)
        } elif mode == "ret_elem" {
            acc = acc + len(first(mkp(i)).name)
        } elif mode == "tuple_store" {
            let mut t = mkp(i)
            t.1 = "new{i}"
            t.0.name = "nn{i}"
            acc = acc + len(t.1) + len(t.0.name)
        } elif mode == "tuple_struct_elem" {
            let kept = mkp(i).0
            if mkp(i).0 == kept { acc = acc + len(to_string(mkp(i).0)) + len(kept.name) }
        } elif mode == "map_enum" {
            let mut me: map<str, E> = {}
            me["k"] = mke(i)
            me["j"] = mke(i + 1)
            acc = acc + len(me)
        } elif mode == "tuple_alias" {
            let mut t = mk(i)
            let u = t
            t = mk(i + 1)
            let mut w = t
            w = mk(i + 2)
            let ((pp, ss), xs) = (mkp(i), [i])
            let tp = mkp(i)
            let (p2, s2) = tp
            acc = acc + len(u.0) + len(t.0) + len(w.0) + len(pp.name) + len(p2.name) + len(xs) + len(ss) + len(s2)
        } elif mode == "map_container" {
            let mut mm: map<str, map<str, i64>> = {}
            mm["k{i % 3}"]["n"] = i
            let mut inner = mm["j"]
            inner["x"] = 1
            mm["j"] = inner
            let mut ma: map<i64, [str]> = {}
            acc = acc + len(mm) + len(ma[i]) + len(mm["miss"])
        } elif mode == "tuple_containers" {
            // Tuple STRUCT fields. Arrays of tuples still leak their
            // elements (array copies share them without a retain).
            let s1 = Ptf { name: "n{i}", t: ("t{i}", i) }
            let s2 = s1
            acc = acc + len(s2.t.0)
        } elif mode == "closures" {
            let cap = "c{i}"
            let f = |k: i64| k + len(cap) + len(p.name)
            let names = map(["u{i}", "v{i}"], |x: str| x + p.name)
            let mut cnt = 0
            let bump = || { cnt = cnt + len(q.name) }
            bump()
            acc = acc + f(1) + len(names) + use_f(|k: i64| k + len(cap)) + cnt
        } elif mode == "map_tuple" {
            let mut mt: map<str, (str, i64)> = {}
            mt["k"] = ("m{i}", i)
            let nt = ("n{i}", i)
            mt["n"] = nt
            mt["k"] = ("o{i}", i)
            acc = acc + len(mt["k"].0) + len(nt.0)
        } elif mode == "if_value" {
            let ts = "s{i}"
            let u = if i % 2 == 0 { ts } else { "e{i}" }
            let tt = ("t{i}", i)
            let v = if i % 2 == 0 { tt } else { ("f{i}", i) }
            let w = if i % 2 == 0 { Ek.Ka("k{i}") } else { Ek.Kb }
            let mut xs = ["a{i}"]
            xs = ["b{i}"]
            let r = match w { _ => 1 }
            acc = acc + len(u) + len(v.0) + r + len(xs)
        } elif mode == "fn_values" {
            let fc = "f{i}"
            let fg = |k: i64| k + len(fc)
            let fvs = [fg, fg]
            let fh = Hf { f: fg }
            let fe = fvs[0]
            let fk = Hf { f: fvs[1] }
            acc = acc + fvs[1](1) + fh.f(1) + fe(1) + fk.f(1) + use_f(fvs[0])
        } elif mode == "nested_enum" {
            let no = Nout.Nw(Nin.Nx("o{i}"))
            let no2 = no
            let nm: map<str, Nout> = {}
            nm["k"] = no
            nm["k"] = Nout.Nv(Nin.Nx("v{i}"), "t{i}")
            let na = [no, no2]
            let mut na2 = na
            let sa = [P { name: "s{i}", xs: [] }]
            let mut sa2 = sa
            acc = acc + len(na2) + len(nm) + len(sa2)
        } elif mode == "void_param" {
            show_p(p)
            show_p(P { name: "v{i}", xs: [i] })
            acc = acc + 1
        } elif mode == "map_struct" {
            let mut mm: map<i64, P> = {}
            mm[i] = P { name: "m{i}", xs: [i] }
            acc = acc + len(mm[i].name)
        } elif mode == "for_read" {
            // A loop over a container READ never released the read's
            // reference (master too); a missing key's empty array leaked
            // on every loop.
            let mut fm: map<str, [i64]> = {}
            fm["k"] = [i, i]
            let g = [[i], [i, i]]
            for x in fm["k"] { acc = acc + x }
            for x in fm["no"] { acc = acc + x }
            for x in p.xs { acc = acc + x }
            for x in g[1] { acc = acc + x }
        } elif mode == "map3" {
            // Three levels: the innermost map was freed untyped.
            let mut m3: map<str, map<str, map<str, i64>>> = {}
            m3["a"]["b"]["c"] = i
            m3["a"]["d"]["e"] = i
            acc = acc + len(m3["a"])
        } elif mode == "dyn_param" {
            dlg(Lgs { n: i, name: "x{i}" }, i)
        } elif mode == "dyn_let" {
            let s: dyn Lg = Lgs { n: i, name: "x{i}" }
            s.log("a")
        } elif mode == "dyn_named" {
            let r = Lgs { n: i, name: "x{i}" }
            dlg(r, i)
            let s: dyn Lg = r
            s.log("b")
            acc = acc + len(r.name)
        } elif mode == "dyn_ret" {
            let a = mkd(i)
            let b = mkd_local(i)
            a.log("a")
            b.log("b")
            pass_d(a).log("c")
        } elif mode == "dyn_copy" {
            let s: dyn Lg = Lgs { n: i, name: "x{i}" }
            let t = s
            t.log("t")
            dlg(t, i)
        } elif mode == "dyn_field" {
            let h = hold_d(Lgs { n: i, name: "x{i}" }, i)
            dh_log(h)
        } elif mode == "dyn_reassign" {
            let mut s: dyn Lg = Lgs { n: i, name: "x{i}" }
            s = Lgs { n: i, name: "y{i}" }
            s.log("r")
        } elif mode == "dyn_fieldstore" {
            let mut h = hold_d(Lgs { n: i, name: "x{i}" }, i)
            h.d = Lgs { n: i, name: "y{i}" }
            dh_log(h)
        } elif mode == "dyn_clo" {
            let f = dyn_clo(Lgs { n: i, name: "x{i}" })
            acc = acc + f(i)
        } elif mode == "dyn_if" {
            // A dyn coerced from an if / match VALUE slot (the arms build the
            // struct, the let wraps it): the slot's struct was never dropped.
            let d: dyn Lg = if i % 2 == 0 { Lgs { n: i, name: "x{i}" } } else { Lgs { n: i, name: "y{i}" } }
            d.log("a")
        } elif mode == "dyn_match" {
            let d: dyn Lg = match i % 3 {
                0 => Lgs { n: i, name: "x{i}" },
                1 => Lgs { n: i, name: "y{i}" },
                _ => Lgs { n: i, name: "z{i}" },
            }
            d.log("a")
        } elif mode == "dyn_if_named" {
            // Named structs picked by an if / match, coerced at the let: the
            // named struct is still used afterwards.
            let na = Lgs { n: i, name: "a{i}" }
            let nb = Lgs { n: i, name: "b{i}" }
            let d: dyn Lg = if i % 2 == 0 { na } else { nb }
            let e: dyn Lg = match i % 2 {
                0 => nb,
                _ => na,
            }
            d.log("a")
            e.log("b")
            acc = acc + len(na.name) + len(nb.name)
        } elif mode == "match_named" {
            // The same without a dyn: a match whose arms are bare names of
            // owned structs moved them out of their scope-end drop, on every
            // path, so both leaked.
            let mna = Lgs { n: i, name: "a{i}" }
            let mnb = Lgs { n: i, name: "b{i}" }
            let mne: Lgs = match i % 2 {
                0 => mnb,
                _ => mna,
            }
            acc = acc + len(mne.name) + len(mna.name) + len(mnb.name)
        } elif mode == "dyn_if_plain" {
            let d: dyn Lg = if i % 2 == 0 { Lgr { n: i } } else { Lgr { n: i + 1 } }
            d.log("p")
        } elif mode == "dyn_if_dyn" {
            // The arms already produce dyn values.
            let d: dyn Lg = if i % 2 == 0 { mkd(i) } else { pass_d(mkd(i + 1)) }
            d.log("q")
        } elif mode == "dyn_gen" {
            // A generic instantiated with a dyn type borrows its param and
            // returns it: the instance must keep the dyn type to retain it.
            let g = gen_id(pass_d(Lgs { n: i, name: "x{i}" }))
            let h: dyn Lg = Lgs { n: i, name: "y{i}" }
            let h2 = gen_id(h)
            let h3 = gen_first(h, g)
            g.log("g")
            h2.log("h")
            h3.log("i")
        } elif mode == "dyn_arg" {
            // A `dyn` method call as a statement leaked its argument.
            dlg(dl, i)
            dl.log("n{i}")
        } elif mode == "cap_struct" {
            acc = acc + step(i)
        } elif mode == "cap_escape" {
            acc = acc + esc(i) + len(tailv(i).name)
        } elif mode == "if_struct" {
            // A struct-valued if/match over fresh values, bound by `let` or
            // discarded: the binding copied the hidden result slot and the
            // slot leaked; a closure's capture as one.
            let r2 = if i % 3 == 0 { P { name: "c{i}", xs: [] } } else { P { name: "d", xs: [i] } }
            let r3 = match i % 2 {
                0 => P { name: "m{i}", xs: [i] },
                1 => P { name: "n", xs: [] },
                _ => P { name: "x", xs: [] },
            }
            if i % 2 == 0 { P { name: "s{i}", xs: [i] } } else { P { name: "t", xs: [] } }
            match (i + 1) % 2 {
                0 => P { name: "u{i}", xs: [i] },
                1 => P { name: "v", xs: [] },
                _ => P { name: "x", xs: [] },
            }
            acc = acc + len(r2.xs) + len(r3.name) + len(pickc(i).name)
        } elif mode == "cap_array" {
            // A closure built per iteration over a struct with a [str]
            // field, replacing it once called (master: 96MB at 1M).
            let mut ca = P { name: "a{i}", xs: [i, i] }
            let mut cb = Ptf { name: "b{i}", t: ("t{i}", i) }
            let swap = |k: i64| {
                ca.xs = [k]
                cb.name = "n{k}"
                return len(ca.xs) + len(cb.name)
            }
            acc = acc + swap(i) + len(ca.xs)
        } elif mode == "fn_reassign" {
            // Reassigning a closure variable never released the old closure.
            let mut fr = mkfn(i)
            fr = mkfn(i + 1)
            let hr = Hfs { f: mkfn(i + 2) }
            fr = hr.f
            acc = acc + len(fr(0))
        } elif mode == "fn_field_store" {
            // Neither did overwriting a closure field.
            let mut hfs = Hfs { f: mkfn(i) }
            hfs.f = mkfn(i + 1)
            acc = acc + len(hfs.f(0))
        } elif mode == "fn_map_values" {
            // A map never released its closures, overwritten or dropped.
            let mut mfv: map<str, fn(i64) -> str> = {}
            mfv["k"] = mkfn(i)
            mfv["k"] = mkfn(i + 1)
            let gv = mfv["k"]
            acc = acc + len(gv(0))
        } elif mode == "map_holders" {
            // A map in an enum payload or a struct field leaked its entries.
            let wmh = Wmh.Has(mkmh(i))
            let smh = Smh { m: mkmh(i + 1) }
            acc = acc + wmh_len(wmh) + len(smh.m)
        } elif mode == "arr_tuple_lit" {
            // An array of tuples: the literal's element boxes were never
            // released at the array's drop.
            let atl = [("k{i}", i), ("z{i}", i)]
            acc = acc + len(atl) + len(atl[1].0)
        } elif mode == "arr_tuple_push" {
            let mut atp: [(str, i64)] = []
            atp = push(atp, ("k{i}", i))
            acc = acc + len(atp) + len(atp[0].0)
        } elif mode == "arr_tuple_copy" {
            // Every way an array of tuples is copied shares its elements.
            let atc = [("c{i}", i)]
            let mut atd = atc
            atd = push(atd, ("d{i}", i))
            let ath = Hat { items: [("a{i}", i)] }
            let ath2 = ath
            let ati = ath.items
            let ate = Eat.Items([("e{i}", i)])
            let ates = [ate, ate]
            acc = acc + len(atd) + len(atc[0].0) + len(ath2.items[0].0) + len(ati[0].0) + len(ates)
        } elif mode == "arr_tuple_overwrite" {
            // Read a tuple out, overwrite its source, read the tuple again.
            let mut ato = [("o{i}", i), ("p{i}", i)]
            let tt = ato[0]
            ato = [("q{i}", i)]
            ato[0] = ("r{i}", i)
            acc = acc + len(tt.0) + len(ato[0].0)
        } elif mode == "arr_tuple_loop" {
            // A returned closure over an array of tuples, a loop variable and
            // a destructuring read: each owns its own reference.
            let atl2 = [("o{i}", i), ("p{i}", i)]
            let atf = mk_atc(i)
            let mut atn = 0
            for att in atl2 { atn = atn + len(att.0) }
            let (ats, atk) = atl2[0]
            acc = acc + atf() + atn + len(ats) + atk
        } elif mode == "default_arm" {
            // A switch-lowered match's `_` arm never dropped its temps.
            let da = match i % 3 {
                0 => "x",
                _ => "y{i}" + "z",
            }
            acc = acc + len(da)
        } elif mode == "struct_branch" {
            // A struct named outside an if value was moved into the slot,
            // which the `let` copied without releasing.
            let sbq = Pbr { name: "q{i}", n: i }
            let sbp = if i > 0 { sbq } else { Pbr { name: "d", n: 0 } }
            acc = acc + sbp.n + sbq.n
        } elif mode == "ret_scalar_field" {
            // Returning a scalar field skipped the struct's drop.
            acc = acc + pbr_n(i)
        } elif mode == "fn_slot_overwrite" {
            // Nor overwriting a closure element.
            let mut fso = [mkfn(i)]
            fso[0] = mkfn(i + 1)
            acc = acc + len(fso[0](0))
        } elif mode == "match_bare" {
            // A match arm whose whole body is a bare name of an owned struct,
            // the other arm a fresh literal.
            let mbq = P { name: "q{i}", xs: [i] }
            let mbr = match i % 2 {
                0 => mbq,
                _ => P { name: "z", xs: [] },
            }
            acc = acc + len(mbr.name) + len(mbq.name)
        } elif mode == "match_bare_call" {
            // The bare name's sibling arm is a call: struct_value_owned
            // refused a call, so the `let` cloned the slot and kept it.
            let mcq = mkq(i)
            let mcr = match i % 2 {
                0 => mcq,
                _ => mkq(i + 1),
            }
            acc = acc + len(mcr.name) + len(mcq.name)
        } elif mode == "match_bare_assign" {
            // The bare-name match assigned to an existing struct local.
            let mba = mkq(i)
            let mut mbb = P { name: "w", xs: [] }
            mbb = match i % 2 {
                0 => mba,
                _ => P { name: "z", xs: [] },
            }
            acc = acc + len(mbb.name) + len(mba.name)
        } elif mode == "branch_call" {
            let bcr = if i % 2 == 0 { mkq(i) } else { mkq(i + 1) }
            acc = acc + len(bcr.name)
        } elif mode == "match_call_assign" {
            let mut mca = P { name: "w", xs: [] }
            mca = match i % 2 {
                0 => mkq(i),
                _ => mkq(i + 1),
            }
            acc = acc + len(mca.name)
        } elif mode == "push_branch" {
            // push of an if value naming a struct local (outside a closure).
            let pbq = mkq(i)
            let mut pba: [P] = []
            pba = push(pba, if i % 2 == 0 { pbq } else { P { name: "o", xs: [] } })
            acc = acc + len(pba) + len(pba[0].name) + len(pbq.name)
        } elif mode == "push_branch_lit" {
            let mut pbl: [P] = []
            pbl = push(pbl, match i % 2 {
                0 => P { name: "p", xs: [] },
                _ => mkq(i),
            })
            acc = acc + len(pbl) + len(pbl[0].name)
        } elif mode == "glob_field_set" {
            // A mutable global's struct field overwritten: the old value
            // was never released.
            GG.inner = Gin { name: "g{i}" }
            acc = acc + len(GG.inner.name)
        } elif mode == "glob_field_opt" {
            // A mutable global's field as an Option payload, then overwritten.
            let go = Some(GG.inner)
            GG.inner = Gin { name: "g{i}" }
            match go {
                Some(x) => { acc = acc + len(x.name) },
                _ => { acc = acc + 1 },
            }
        } elif mode == "clo_push_if" {
            acc = acc + push_if(i)
        } elif mode == "tuple_field" {
            // `let t = s.t` owns a share that was never released.
            let mut sf = Ptf { name: "f{i}", t: ("t{i}", i) }
            let tt = sf.t
            sf = Ptf { name: "g{i}", t: ("u{i}", i) }
            acc = acc + len(tt.0) + len(sf.t.0)
        }
        i = i + 1
    }
    println("{acc}")
}
