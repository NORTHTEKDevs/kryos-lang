// Peak-RSS probe for tests/mem_closure_tail_gate.sh (finish item mem_closure: n139_e, n139_f, v139_g,
// v139_tuple, x_tuple). Every mode returns the same answer (WANT in the gate) and must run flat.
//   if_field     `let v = if len(p.name) > 2 { .. } else { .. }`: an if-EXPRESSION whose condition reads a str
//                field. The read is retained and nothing released it (lower_if released it, the expression did not)
//   if_cmp       the same with `p.name == "zz"` as the condition
//   if_arm       the if/else is the tail of a match arm bound to a struct payload (n139_e)
//   ptuple_field `match h.o { Some(p) => .. }` where h is a by-value struct param and the payload is a tuple (n139_f)
//   ptuple_ret   the same with `return` from inside the arm (v139_tuple)
//   ptuple_push  the bound payload tuple is pushed into an array that outlives the arm
//   shared_tuple a tuple holding a `shared` handle: `let t = (b.h, 3)` (x_tuple)
//   shared_ret   a function returns such a tuple
//   shared_push  such a tuple is pushed into an array
//   control      no match, no tuple: flat on every binary
use std::option::{Option}
struct P { name: str, n: i64 }
struct H { o: Option<(str, i64)>, k: i64 }
struct HI { o: Option<P> }
struct Item { name: str }
struct B { h: shared Item, k: i64 }

fn iff(p: P) -> i64 {
    let v = if len(p.name) > 2 { 1 } else { 2 }
    return v
}
fn ifc(p: P) -> i64 {
    let v = if p.name == "zz" { 1 } else { 2 }
    return v
}
fn ifa(h: HI) -> i64 {
    let mut r = 0
    match h.o {
        Option.Some(x) => { if len(x.name) > 2 { r = r + 1 } else { r = r + 2 } },
        Option.None => { r = r + 0 }
    }
    return r
}
fn pt(h: H) -> i64 {
    match h.o { Option.Some(p) => { return len(p.0) + p.1 }, Option.None => { return 0 } }
}
fn ptr_(h: H) -> i64 {
    let mut r = 0
    match h.o { Option.Some(p) => { r = len(p.0) + p.1 }, Option.None => { r = 0 } }
    return r
}
fn mkb(i: i64) -> B { return B { h: shared Item { name: "a{i}" }, k: 1 } }
fn mkt(b: B) -> (shared Item, i64) { return (b.h, 3) }

@capabilities(process)
fn main() {
    let iters = parse_int(env_get("LEAK_ITERS"))
    let mode = env_get("LEAK_MODE")
    let mut sink = 0
    let mut i = 0
    while i < iters {
        if mode == "if_field" {
            sink = sink + iff(P { name: "p{i}-padpadpadpadpadpadpadpadpad", n: i })
        } elif mode == "if_cmp" {
            sink = sink + ifc(P { name: "p{i}-padpadpadpadpadpadpadpadpad", n: i })
        } elif mode == "if_arm" {
            sink = sink + ifa(HI { o: Some(P { name: "p{i}-padpadpadpadpadpadpadpadpad", n: i }) })
        } elif mode == "ptuple_field" {
            sink = sink + ptr_(H { o: Some(("t{i}-padpadpadpadpadpadpadpadpad", 3)), k: i })
        } elif mode == "ptuple_ret" {
            sink = sink + pt(H { o: Some(("t{i}-padpadpadpadpadpadpadpadpad", 3)), k: i })
        } elif mode == "ptuple_push" {
            let h = H { o: Some(("t{i}-padpadpadpadpadpadpadpadpad", 3)), k: i }
            let mut keep: [(str, i64)] = []
            match h.o { Option.Some(p) => { keep = push(keep, p) }, Option.None => { sink = sink + 0 } }
            sink = sink + len(keep[0].0) + keep[0].1
        } elif mode == "shared_tuple" {
            let b = mkb(i)
            let t = (b.h, 3)
            sink = sink + t.1 + len((*t.0).name)
        } elif mode == "shared_ret" {
            let t = mkt(mkb(i))
            sink = sink + t.1 + len((*t.0).name)
        } elif mode == "shared_push" {
            let b = mkb(i)
            let t = (b.h, 3)
            let mut keep: [(shared Item, i64)] = []
            keep = push(keep, t)
            sink = sink + keep[0].1 + len((*keep[0].0).name)
        } else {
            let s = "c{i}-padpadpadpadpadpadpadpadpad"
            sink = sink + len(s) - len(s) + 2
        }
        i = i + 1
    }
    println("{sink}")
}
