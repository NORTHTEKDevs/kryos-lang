// Reproduction for the open TCP round-trip leak.
//
// A keep-alive server leaks roughly 50 bytes per recv+send round trip. Peak
// RSS, 40 connections, --release:
//
//   40,000 round trips   ->  +1.6 MB
//   120,000 round trips  ->  +5.8 MB
//   360,000 round trips  -> +18.7 MB
//
// Linear and unbounded. It scales with ROUND TRIPS, not with connections
// (60,000 round trips over 60,000 connections and over 60 connections leak the
// same, 3.5MB vs 2.8MB), and it is independent of payload size (a 4096-byte
// receive buffer and an 8-byte one leak identically).
//
// WHAT HAS BEEN RULED OUT, so nobody repeats it:
//
//   * The Kryos-side string IS freed. The emitted IR loads the tcp_recv result
//     and calls kryos_string_free on it; verified in the LLVM output.
//   * NOT the receive buffer. Size-independent, per the 4096-vs-8 test above.
//   * NOT the string header pool. HeaderPool is an unbounded recycle list --
//     put() pushes, get() pops -- so headers are reused, bounded by peak live.
//   * NOT socket duplication. send and recv each did s.try_clone() per call;
//     replacing both with a non-owning ManuallyDrop borrow of the raw handle
//     left the leak unchanged (18.4MB vs 18.7MB at 360k), so that change was
//     reverted rather than kept as unverified unsafe code.
//   * NOT io_offload, which allocates nothing (a bool and a Drop guard).
//
// One earlier "control" was INVALID and its conclusion should not be trusted
// if seen elsewhere: a mode that accepts and sends WITHOUT reading looks
// perfectly flat, but it is not doing equivalent work -- closing without
// reading makes Windows send RST, and 3965 of 4000 requests actually FAILED.
// Any control here must serve real, successful round trips.
//
// The separately-fixed leaks that this is NOT: read-only builtin arguments
// (to_upper/trim/tcp_send/... missing from BORROWING_CALL_ARGS) and the
// hand-rolled KryosString allocation in the network receive paths. Both are
// fixed; a server doing accept/recv/route/render/send over 60k requests went
// from 20.3MB to 11.3MB peak. This file covers what remains.
//
// Run:  CONNS=40 ROUNDS=1000 ./tcp_roundtrip_leak
// Drive it with a client that does ROUNDS request/response pairs per
// connection and checks each reply is non-empty.

@capabilities(all)
fn main() {
    let rc = env_get("ROUNDS")
    let cc = env_get("CONNS")
    let rounds = if len(rc) == 0 { 1000 } else { parse_int(rc) }
    let conns = if len(cc) == 0 { 40 } else { parse_int(cc) }

    let srv = tcp_listen("127.0.0.1", 7917)
    if srv <= 0 {
        println("bind failed on 127.0.0.1:7917")
        exit(1)
    }
    let canned = "OK\n"
    println("ready")

    let mut done = 0
    while done < conns {
        let c = tcp_accept(srv)
        if c <= 0 {
            break
        }
        let mut r = 0
        while r < rounds {
            let req = tcp_recv(c, 4096)
            if len(req) == 0 {
                // peer closed: stop this connection, do not spin
                r = rounds
            } else {
                tcp_send(c, canned)
                r = r + 1
            }
        }
        tcp_close(c)
        done = done + 1
    }
    tcp_close(srv)
    println("done conns=" + to_string(done))
}
