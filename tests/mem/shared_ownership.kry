// Double-free / use-after-free tripwire for the `shared` leak fix (LEDGER item 137); run by tests/no_double_free.sh.
// Fixed-size ownership program for the `shared` leak fix (double-free direction).
use std::option::{Option}

struct Tree { left: Option<shared Tree>, right: Option<shared Tree> }
struct L { next: Option<shared L>, v: i64 }
struct P { name: str, n: i64 }
struct Node { kids: [Node], v: i64 }

fn make(depth: i64) -> Tree {
    if depth == 0 {
        return Tree { left: None(), right: None() }
    }
    return Tree {
        left: Some(shared make(depth - 1)),
        right: Some(shared make(depth - 1)),
    }
}

fn check(t: Tree) -> i64 {
    match t.left {
        Option.None => return 1,
        Option.Some(s) => {
            match t.right {
                Option.None => return 1,
                Option.Some(r) => return 1 + check(*s) + check(*r),
            }
        },
    }
}

fn chain(n: i64) -> L {
    if n == 0 {
        return L { next: None(), v: 0 }
    }
    return L { next: Some(shared chain(n - 1)), v: n }
}

fn f(p: P) -> i64 { return p.n + len(p.name) }

fn mk_node(depth: i64) -> Node {
    if depth == 0 {
        let empty: [Node] = []
        return Node { kids: empty, v: 1 }
    }
    let mut ks: [Node] = []
    ks = push(ks, mk_node(depth - 1))
    ks = push(ks, mk_node(depth - 1))
    return Node { kids: ks, v: depth }
}

fn count(n: Node) -> i64 {
    let mut c = 1
    for k in n.kids { c = c + count(k) }
    return c
}

fn leaf() -> Tree { return Tree { left: None(), right: None() } }

fn main() {
    // Double-free / use-after-free direction for the shared-structure leak fix.
    // Fixed size, no env: run by tests/no_double_free.sh (no_df_both).
    let mut i = 0
    let mut a = 0
    let mut b = 0
    let mut c = 0
    let mut d = 0
    while i < 20 {
        let t = make(6)
        a = a + 1
        let t2 = make(6)
        b = b + check(t2)
        let t3 = make(6)
        let k = check(t3)
        c = c + k
        let ch = chain(100)
        d = d + 1
        i = i + 1
    }
    // one shared leaf aliased by two parents (shared-handle copy, not a move)
    let lf = shared leaf()
    let x = Tree { left: Some(lf), right: Some(lf) }
    println("a=" + to_string(a) + " b=" + to_string(b) + " c=" + to_string(c) + " d=" + to_string(d) + " x=" + to_string(check(x)))
}
