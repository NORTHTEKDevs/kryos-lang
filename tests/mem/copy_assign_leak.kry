// LEDGER item copy-assign-leak: an @copy struct was never freed. Both backends
// skipped every Drop of an @copy struct, so each literal and each `let c = b`
// copy leaked: one box per value on Cranelift (even with scalar-only fields),
// the cloned `str` field per value on LLVM.
//
// Four shapes: literal + copy with a str field, literal + copy with scalar
// fields only, a literal that is only read, and a copy that is then mutated.
//
// Run:  LEAK_ITERS=<n> ./copy_assign_leak   (default 1000)
// Readers: tests/mem_copy_assign_gate.sh (JIT box balance, AOT peak RSS).
@copy
struct P { name: str, n: i64 }
@copy
struct Q { a: i64, n: i64 }

@capabilities(process)
fn main() {
    let raw = env_get("LEAK_ITERS")
    let iters = if len(raw) == 0 { 1000 } else { parse_int(raw) }
    let mut tot = 0
    let mut i = 0
    while i < iters {
        let b = P { name: "abcdefghijklmnop" + to_string(i), n: i }
        let c = b
        tot = tot + len(c.name)
        let lone = P { name: "lone" + to_string(i), n: i }
        tot = tot + len(lone.name)
        let q = Q { a: i, n: i }
        let mut r = q
        r.a = r.a + 1
        tot = tot + r.n + q.a + r.a
        i = i + 1
    }
    println("tot {tot}")
}
