// probe_46: enum mini-interpreter — different payload types, match + arithmetic
enum Expr {
    Num(i64),
    Add(i64, i64),
    Mul(i64, i64),
    Neg(i64),
    Max(i64, i64),
}

fn eval(e: Expr) -> i64 {
    match e {
        Expr.Num(n)    => return n,
        Expr.Add(a, b) => return a + b,
        Expr.Mul(a, b) => return a * b,
        Expr.Neg(n)    => return -n,
        Expr.Max(a, b) => {
            if a > b { return a }
            return b
        },
    }
}

fn main() {
    println(to_string(eval(Expr.Num(42))))
    println(to_string(eval(Expr.Add(3, 4))))
    println(to_string(eval(Expr.Mul(6, 7))))
    println(to_string(eval(Expr.Neg(10))))
    println(to_string(eval(Expr.Max(3, 9))))
    println(to_string(eval(Expr.Max(8, 2))))
}
