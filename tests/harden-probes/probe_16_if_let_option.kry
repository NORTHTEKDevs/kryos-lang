// probe_16: if let / while let / let else with Option and Result
use std::option::{Option, Some, None}
use std::result::{Result, Ok, Err}

fn maybe(n: i64) -> Option<i64> {
    if n > 0 { return Some(n * 2) }
    return None()
}

fn divide(a: i64, b: i64) -> Result<i64, str> {
    if b == 0 { return Err("div-zero") }
    return Ok(a / b)
}

fn main() {
    if let Some(v) = maybe(5) {
        println("got:" + to_string(v))
    } else {
        println("none")
    }
    if let Some(v) = maybe(-1) {
        println("got:" + to_string(v))
    } else {
        println("none")
    }
    match divide(10, 2) {
        Ok(v)  => println("ok:" + to_string(v)),
        Err(e) => println("err:" + e),
    }
    match divide(7, 0) {
        Ok(v)  => println("ok:" + to_string(v)),
        Err(e) => println("err:" + e),
    }
}
