// probe_09: fold over array of structs
use std::iter::{fold}

struct Item { value: i64, weight: i64 }

fn main() {
    let items: [Item] = [
        Item { value: 10, weight: 2 },
        Item { value: 20, weight: 3 },
        Item { value: 15, weight: 1 },
    ]
    let total_value = fold(items, 0, |acc, x| acc + x.value)
    let total_weight = fold(items, 0, |acc, x| acc + x.weight)
    println(to_string(total_value))
    println(to_string(total_weight))
}
