// probe_20: currying — closures returned from named functions, stored and called
fn make_adder(n: i64) -> fn(i64) -> i64 {
    return |x| x + n
}

fn make_multiplier(factor: i64) -> fn(i64) -> i64 {
    return |x| x * factor
}

fn apply(f: fn(i64) -> i64, v: i64) -> i64 {
    return f(v)
}

fn main() {
    let add5  = make_adder(5)
    let add10 = make_adder(10)
    let times3 = make_multiplier(3)
    println(to_string(apply(add5, 7)))
    println(to_string(apply(add10, 7)))
    println(to_string(apply(times3, 6)))
    // compose: apply add5 then times3
    println(to_string(times3(add5(4))))
}
