// probe_22: nested structs with impl methods, method chaining
struct Vec3 { x: f64, y: f64, z: f64 }

impl Vec3 {
    fn zero() -> Vec3 {
        return Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    }
    fn add(self: Vec3, other: Vec3) -> Vec3 {
        return Vec3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z }
    }
    fn scale(self: Vec3, s: f64) -> Vec3 {
        return Vec3 { x: self.x * s, y: self.y * s, z: self.z * s }
    }
    fn length_sq(self: Vec3) -> f64 {
        return self.x * self.x + self.y * self.y + self.z * self.z
    }
}

struct Particle { pos: Vec3, vel: Vec3, mass: f64 }

impl Particle {
    fn step(self: Particle, dt: f64) -> Particle {
        let new_pos = self.pos.add(self.vel.scale(dt))
        return Particle { pos: new_pos, vel: self.vel, mass: self.mass }
    }
}

fn main() {
    let p = Particle {
        pos: Vec3 { x: 0.0, y: 0.0, z: 0.0 },
        vel: Vec3 { x: 1.0, y: 2.0, z: 0.0 },
        mass: 1.0,
    }
    let p2 = p.step(0.5)
    println(to_string(p2.pos.x))
    println(to_string(p2.pos.y))
    let lsq = p2.vel.length_sq()
    println(to_string(lsq))
}
