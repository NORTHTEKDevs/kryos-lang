// probe_40: std::iter::map on [struct] with all-i64 struct, closure calls helper fn (probe_21 maps [i64])
use std::iter::{map}

struct Point { x: i64, y: i64 }

fn sum_coords(p: Point) -> i64 {
    return p.x + p.y
}

fn main() {
    let pts: [Point] = [
        Point { x: 1, y: 2 },
        Point { x: 3, y: 4 },
        Point { x: 5, y: 6 },
    ]
    let sums = map(pts, |p| sum_coords(p))
    let mut total: i64 = 0
    let mut i: i64 = 0
    while i < len(sums) {
        total = total + sums[i]
        i = i + 1
    }
    println(to_string(total))
    println(to_string(sums[0]))
    println(to_string(sums[1]))
    println(to_string(sums[2]))
}
