// LEDGER root R3 (the deny! verdict is taken when the module is done). item 64 relative (v14): no fn-typed parameter anywhere, the privileged closure is the field of a struct parameter.
// Master 732714ab: check rc=0 in default and strict mode (the shape layer is blinded by the outer harmless `f`
// or does not reach the shape), `kryos run` prints the secret. WANTED: rejected with E0110 in both modes.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

struct Box {
    f: fn() -> str,
}

fn outer(b: Box) {
    let go = || b.f()
    deny!(fs:read) {
        println("LEAK: " + go())
    }
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    outer(Box { f: r })
}
