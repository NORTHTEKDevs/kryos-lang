// LEDGER root R2 control for item 71: attack_actor_explicit_self_swapped_params_deny
// with a registry of pure tools. Must stay ACCEPTED in the default mode.
fn pure_tool() -> str {
    return "pure result"
}

fn other_pure_tool() -> str {
    return "other pure result"
}

fn build_registry() -> map<str, fn() -> str> {
    return {
        "pure": pure_tool,
        "other": other_pure_tool,
    }
}

actor ZeroCapDispatcher {
    fn run_it(self, name: str, reg: map<str, fn() -> str>) {
        let out = reg[name]()
        println("A-DIRECT-SWAPPED-DENY: " + out)
    }
}

@capabilities(fs:read)
fn main() {
    let reg = build_registry()
    let d = ZeroCapDispatcher()
    deny!(fs:read) {
        d.run_it("other", reg)
    }
    sleep(100)
}
