// LEDGER items 124/125 (root F, declaration order): the forward chain runs through a mutually recursive pair.
// Shape: `ping` and `pong` hand their parameter to each other until `n` runs out, then call it; `tool` is declared above `ping`, `main` calls `tool` inside deny!(fs:read).
// Measured (master dd637a90, 26 orders): E0507 in every order, E0110 only in 16 of the 26. The pin is the verdict set: every order must give the same codes, E0110 included.
// WANTED: rejected with E0110 in both modes in every declaration order, and `kryos run` must not print the secret.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn tool(r: fn() -> str) -> str {
    return ping(r, 2)
}

fn ping(r: fn() -> str, n: i64) -> str {
    if n > 0 {
        return pong(r, n - 1)
    }
    return r()
}

fn pong(r: fn() -> str, n: i64) -> str {
    return ping(r, n)
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    deny!(fs:read) {
        println("LEAK: " + tool(r))
    }
}
