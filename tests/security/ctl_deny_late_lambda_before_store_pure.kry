// LEDGER root R3 (the deny! verdict is taken when the module is done). item 120 (lambda defined before the store) twin: the helper stores a pure closure.
// Must stay ACCEPTED in the default and the strict mode (no over-rejection).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn put(a: [fn() -> str], g: fn() -> str) {
    a[0] = g
}

@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let fns = [safe]
    let run = || {
        deny!(fs:read) {
            for f in fns {
                println(f())
            }
        }
    }
    put(fns, safe)
    run()
}
