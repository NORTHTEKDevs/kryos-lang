// The privileged closure is handed to a function value together with a container the deny! block never iterates.
// Must stay ACCEPTED in the default and the strict mode (no over-rejection).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn put(reg: [fn() -> str], g: fn() -> str) {
    reg[0] = g
}
fn get_op() -> fn([fn() -> str], fn() -> str) {
    return put
}
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let op = get_op()
    let fns = [safe]
    let other = [safe]
    op(other, r)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
