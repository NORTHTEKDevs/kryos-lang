@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

// item 123: the storing helper is a lambda returned by a factory (unannotated params).
fn get_op() -> fn([fn() -> str], fn() -> str) {
    return |reg, g| { reg[0] = g }
}

@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let op = get_op()
    let fns = [safe]
    op(fns, r)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}