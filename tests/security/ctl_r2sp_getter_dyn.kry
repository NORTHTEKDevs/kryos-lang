// finish-line cap:r2-storage-paths-dd09d926/k06_getter_dyn: the array is read back through a `dyn` call outside a default body, which used to hand back a container with an erased row.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
trait Reg { fn get(self: Self) -> [fn() -> str] }
struct Holder { reg: [fn() -> str] }
impl Reg for Holder { fn get(self: Holder) -> [fn() -> str] { return self.reg } }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = safe
    let h = Holder { reg: [safe] }
    let d: dyn Reg = h
    let a = d.get()
    a[0] = r
    deny!(fs:read) { for f in h.reg { println("ok: " + f()) } }
}
