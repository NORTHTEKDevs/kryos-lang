// finish-line cap:r2-storage-paths-dd09d926/e14_alias_of_alias_result: an alias of a Result of an alias of a tuple of an alias of an array.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
use std::result::{Result, Ok, Err}
type Reg = [fn() -> str]
type Pair = (Reg, i64)
type Res = Result<Pair, str>
fn put(p: Res, g: fn() -> str) { match p { Ok(t) => { t.0[0] = g } Err(e) => { } } }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    put(Ok((fns, 1)), r)
    deny!(fs:read) { for f in fns { println("LEAK: " + f()) } }
}
