// Control for tests/security/attack_shape_closure_in_closure_captured.kry: the same program handing the PURE closure `harmless` through the same shape.
// The return flow now charges the argument, so a pure argument must still charge nothing: ACCEPTED in default and strict mode (no over-rejection).
fn harmless() -> str {
    return "not a secret"
}
@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let mut f: fn() -> str = harmless
    let outer_c = |x: i64| {
        let inner = || { harmless }
        return inner
    }
    let h = outer_c(1)
    f = h()
    let ch = chan()
    send(ch, 1)
    select {
        v ch => {
            deny!(fs:read) {
                println("OUT: " + f())
            }
        }
    }
}
