// finish-line cap:r2-storage-paths-dd09d926/k10_struct_literal_inline_two_hop: the struct literal is built in the call argument of a relay, which hands the struct to the store helper.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
struct S { t: ([fn() -> str], i64) }
fn put(s: S, g: fn() -> str) { s.t.0[0] = g }
fn relay(s: S, g: fn() -> str) { put(s, g) }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = safe
    let fns = [safe]
    relay(S { t: (fns, 1) }, r)
    deny!(fs:read) { for f in fns { println("ok: " + f()) } }
}
