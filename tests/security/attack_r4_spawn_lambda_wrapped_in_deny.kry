// LEDGER root R4 (kryos-types check.rs charges a spawned lambda's row to the enclosing frame): a spawn lambda calls a wrapped privileged closure inside deny!(fs:read).
// Master dd637a90: kryos check rc=0 in default and strict mode (a lambda literal's row was never charged to the frame holding the spawn), kryos run prints TOPSECRET-CLOSURE-9f8e7d6c5b4a.
// Must be REJECTED with E0110 in both modes; kryos run must not print the secret.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn wrap_once(inner: fn() -> str) -> fn() -> str {
    return || inner()
}

fn host(reader: fn() -> str) {
    let wrapped = wrap_once(reader)
    let go = || wrapped()
    deny!(fs:read) {
        spawn fn() {
            println("LEAK: " + go())
        }
        sleep(300)
    }
}

@capabilities(fs:read)
fn main() {
    host(secret())
}
