// LEDGER item 125 (root F, declaration order): forward store relay through a cycle of 11 or more declarations. The checker re-checked a cycle a fixed 8 times, so a longer relay was accepted in the declared order and rejected in the reversed one.
// Measured (f3f2b180): rc=0 in default and strict mode, `kryos run` prints TOPSECRET-CLOSURE-9f8e7d6c5b4a; master dd637a90 accepts it too.
// WANTED: rejected with E0110 in both modes, and `kryos run` must not print the secret.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}
fn safe() -> str {
    return "safe"
}
struct Plugin {
    run: fn() -> str,
}
fn h1(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    return h2(reg, f, n)
}
fn h2(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    return h3(reg, f, n)
}
fn h3(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    return h4(reg, f, n)
}
fn h4(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    return h5(reg, f, n)
}
fn h5(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    return h6(reg, f, n)
}
fn h6(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    return h7(reg, f, n)
}
fn h7(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    return h8(reg, f, n)
}
fn h8(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    return h9(reg, f, n)
}
fn h9(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    return h10(reg, f, n)
}
fn h10(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    return h11(reg, f, n)
}
fn h11(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    return h12(reg, f, n)
}
fn h12(reg: [Plugin], f: fn() -> str, n: i64) -> [Plugin] {
    if n == 0 {
        return push(reg, Plugin { run: f })
    }
    return h1(reg, f, n - 1)
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let mut reg: [Plugin] = []
    reg = h1(reg, r, 0)
    deny!(fs:read) {
        for q in reg {
            println("LEAK: " + q.run())
        }
    }
}
