// Twin of attack_slot_param_container_in_tuple.kry: the helper stores a PURE closure.
// Must stay ACCEPTED in the default and the strict mode (no over-rejection).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn put_t(t: ([fn() -> str], i64), g: fn() -> str) {
    t.0[0] = g
}
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    put_t((fns, 1), safe)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
