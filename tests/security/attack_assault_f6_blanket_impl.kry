// ASSAULT-F6 attack: `show` is also answered by a blanket impl (`impl<T> Describe for T`) whose body reads
// the file, so a call to `show` on ANY type may run it. A name a blanket impl answers is never resolved by
// receiver type: the call on the Quiet value is charged the blanket body and rejected (E0507) in both modes.
@capabilities(fs:read)
fn load_secret() -> str {
    return file_read("tests/security/secret_for_closure_launder.txt")
}

trait Loader {
    fn run(self: Self) -> str
}

struct SecretLoader {}
impl Loader for SecretLoader {
    @capabilities(fs:read)
    fn run(self: SecretLoader) -> str {
        return load_secret()
    }
}

trait Formatter {
    fn run(self: Self) -> str
}

struct PlainFormatter {}
impl Formatter for PlainFormatter {
    fn run(self: PlainFormatter) -> str {
        return "formatted"
    }
}

trait Describe {
    fn show(self: Self) -> str
}

impl<T> Describe for T {
    @capabilities(fs:read)
    fn show(self: T) -> str {
        return load_secret()
    }
}

struct Quiet {}
impl Quiet {
    fn show(self: Quiet) -> str {
        return "quiet"
    }
}

@capabilities(fs:read)
fn main() {
    deny!(fs:read) {
        let q = Quiet {}
        println("ASSAULT-F6-LEAK " + q.show())
    }
}
