// SECURITY -- round 3 assault, strip-the-row lens: a `dyn Trait` object whose
// underlying struct STORES a privileged closure in a field at construction
// time, and whose trait method RETURNS that field (rather than receiving the
// closure as an explicit call argument, which is what
// cap_escape_decoy_dyn_trait_method.kry probes). The caller then invokes the
// returned closure outside the dyn call, inside deny!(). This targets Gap 1
// verbatim: "a privileged closure routed through a dyn Trait ACCESSOR has its
// requirement silently vanish."
//
// ACCEPTANCE: REJECTED (E0507) under both enforcement modes.

@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

trait Holder {
    fn get_reader(self: Self) -> fn() -> str
}

struct RealHolder { reader: fn() -> str }

impl Holder for RealHolder {
    fn get_reader(self: RealHolder) -> fn() -> str {
        return self.reader
    }
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let h: dyn Holder = RealHolder { reader: reader }
    deny!(fs:read) {
        let extracted = h.get_reader()
        let leaked = extracted()
        println("DYN-TRAIT-ACCESSOR-RETURN LEAK: " + leaked)
    }
}
