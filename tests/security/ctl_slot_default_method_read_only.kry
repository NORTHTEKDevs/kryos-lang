@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}
struct Holder { reg: [fn() -> str] }
trait Reader { fn size(self: Self) -> i64
  fn twice(self: Self, g: fn() -> str) -> i64 { return self.size() * 2 } }
impl Reader for Holder {
    fn size(self: Holder) -> i64 { return len(self.reg) }
}
fn use_it<A: Reader>(a: A, g: fn() -> str) -> i64 { return a.twice(g) }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let h = Holder { reg: [safe] }
    println(use_it(h, r))
    deny!(fs:read) { for f in h.reg { println(f()) } }
}
