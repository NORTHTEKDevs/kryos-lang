// LEDGER root R4 (spawn family): coop_spawn(closure literal) inside deny!(fs:read) calls a wrapped privileged closure.
// Master dd637a90: kryos check rc=0 in default and strict mode (coop_spawn runs a closure-literal argument on a cooperative task but its row was never charged to the enclosing frame), kryos run prints TOPSECRET-CLOSURE-9f8e7d6c5b4a.
// Must be REJECTED with E0110 in both modes; kryos run must not print the secret.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn wrap_once(inner: fn() -> str) -> fn() -> str {
    return || inner()
}

fn host(reader: fn() -> str) {
    let wrapped = wrap_once(reader)
    let go = || wrapped()
    deny!(fs:read) {
        coop_spawn(|| {
            println("LEAK: " + go())
        })
        coop_run()
        sleep(300)
    }
}

@capabilities(fs:read)
fn main() {
    host(secret())
}
