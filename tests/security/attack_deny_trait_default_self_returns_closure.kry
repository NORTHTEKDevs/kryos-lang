// LEDGER item 122 neighbour: a default body iterates, inside deny!, the closures a required method (self.pass) hands back; the override returns a privileged one it made itself. WANTED: rejected, E0110, both modes.
fn safe() -> str { return "safe" }
@capabilities(fs:read)
fn mk() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }

trait Rn {
    fn pass(self: Self, fns: [fn() -> str]) -> [fn() -> str]
    fn go(self: Self, fns: [fn() -> str]) {
        let f = || "harmless"
        let ys = self.pass(fns)
        deny!(fs:read) { for f in ys { println(f()) } }
    }
}
struct E {}
impl Rn for E { fn pass(self: Self, fns: [fn() -> str]) -> [fn() -> str] { return [mk()] } }
@capabilities(fs:read)
fn main() { E {}.go([safe]) }
