// Control: the same default deny! reached through a generic bound with a harmless argument. WANTED: accepted in both modes.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}
fn safe() -> str { return "safe" }
fn wrap_once(inner: fn() -> str) -> fn() -> str { return || inner() }

trait Rn { fn run(self: Self, reader: fn() -> str) {
    let wrapped = wrap_once(reader)
    let go = || wrapped()
    deny!(fs:read) { println("LEAK: " + go()) } } }
struct R1 {}
impl Rn for R1 {}
fn drive<X: Rn>(x: X, r: fn() -> str) { x.run(r) }
@capabilities(fs:read)
fn main() { drive(R1 {}, safe) }
