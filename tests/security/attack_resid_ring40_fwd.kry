// LEDGER items 122, 124, 125 (residual wave): a ring of 40 forward helpers rotates the closure to the store.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}
fn safe() -> str {
    return "safe"
}
let mut REG: [fn() -> str] = []
@capabilities(fs:read)
fn main() {
    let r = secret()
    r1(safe, safe, r, 0)
    show()
}
fn show() {
    let f = || "harmless"
    deny!(fs:read) {
        for f in REG {
            println("LEAK: " + f())
        }
    }
}
fn r1(a: fn() -> str, b: fn() -> str, c: fn() -> str, n: i64) {
    r2(b, c, a, n)
}
