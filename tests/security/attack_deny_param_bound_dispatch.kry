// LEDGER root R3 (the deny! verdict is taken when the module is done). the same through a generic function with a trait bound.
// Master 732714ab: check rc=0 in default and strict mode (the shape layer is blinded by the outer harmless `f`
// or does not reach the shape), `kryos run` prints the secret. WANTED: rejected with E0110 in both modes.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

trait Runner {
    fn go(self: Self, fns: [fn() -> str])
}
struct R1 {}
impl Runner for R1 {
    fn go(self: R1, fns: [fn() -> str]) {
        let f = || "harmless"
        deny!(fs:read) {
            for f in fns {
                println(f())
            }
        }
    }
}
fn use_runner<T: Runner>(x: T, fns: [fn() -> str]) {
    x.go(fns)
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let fns = [safe, r]
    use_runner(R1 {}, fns)
}
