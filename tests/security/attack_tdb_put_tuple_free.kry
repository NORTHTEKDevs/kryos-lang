// finish-line trait-default-body-edaefeca/f11 (LEDGER item 119): a free function stores a closure into the array held inside a tuple parameter, the tuple built in the call argument.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
fn put_t(p: ([fn() -> str], i64), g: fn() -> str) { p.0[0] = g }
trait Rn { fn go(self: Self, fns: [fn() -> str]) { let f = || "h"
  deny!(fs:read) { for f in fns { println("LEAK: " + f()) } } } }
struct R1 {}
impl Rn for R1 {}
@capabilities(fs:read)
fn main() { let r = secret()
  let fns = [safe]
  put_t((fns, 1), r)
  R1 {}.go(fns) }
