@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("data.txt")
}
fn safe() -> str {
    return "safe"
}
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let show = |reg: [fn() -> str], g: fn() -> str| {
        println(len(reg))
    }
    let fns = [safe]
    show(fns, r)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
