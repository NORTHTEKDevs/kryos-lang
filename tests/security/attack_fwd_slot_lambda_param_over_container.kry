// LEDGER root R3 (a reference that precedes its declaration): attack_slot_lambda_param_over_container.kry with `main` moved above every other item,
// so the helper is declared AFTER the code that calls it. Master 732714ab accepts it and `kryos run` prints the secret
// (for the two attack_slot_lambda_param_over_container twins: accepted by --strict-capabilities, the default mode rejects them
// through the shape layer). WANTED: rejected with E0110 in both modes.
// LEDGER root R2, revise round of PR 38 (found by the author while closing the verifier's finding).
// A helper runs a lambda with an ANNOTATED closure parameter over the array it was handed (for_each(fns, |g: fn() -> str| g())). The lambda's parameter row was never linked to the array's element row, so the call charged nothing. Under --strict-capabilities nothing else catches this (the shape layer needs the inferred mode).
// Master dcf72e93: rejected in the default mode by the shape layer (E0507) but ACCEPTED by `check --strict-capabilities`, where `kryos run --strict-capabilities` prints the secret (executed).
// First R2 build (PR head dbfb989d): rejected in the default mode by the shape layer (E0507) but ACCEPTED by `check --strict-capabilities`, where `kryos run --strict-capabilities` prints the secret (executed).
// Must be REJECTED with E0110 ("capability `fs:read` is denied in this block") under inferred and strict,
// and `kryos run` must not print the secret.
use std::iter::{for_each, map}


@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe, r]
    deny!(fs:read) {
        run_all(fns)
    }
}


@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}


fn safe() -> str {
    return "safe"
}


fn run_all(fns: [fn() -> str]) {
    for_each(fns, |g: fn() -> str| {
        println(g())
    })
}
