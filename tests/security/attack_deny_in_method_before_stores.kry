use std::iter::{for_each, map}

@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

struct Host {
    items: [fn() -> str],
}
impl Host {
    fn run(self) {
        let f = || "harmless"
        deny!(fs:read) {
            for f in self.items {
                println(f())
            }
        }
    }
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let h = Host { items: [safe] }
    h.items = push(h.items, r)
    h.run()
}
