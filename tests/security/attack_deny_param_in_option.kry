// LEDGER root R3 (the deny! verdict is taken when the module is done). the closures reach the deny! through an Option parameter.
// Master 732714ab: check rc=0 in default and strict mode (the shape layer is blinded by the outer harmless `f`
// or does not reach the shape), `kryos run` prints the secret. WANTED: rejected with E0110 in both modes.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

use std::option::{Option, Some, None}

fn run_o(o: Option<[fn() -> str]>) {
    let f = || "harmless"
    match o {
        Some(fns) => {
            deny!(fs:read) {
                for f in fns {
                    println(f())
                }
            }
        },
        None() => {},
    }
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let fns = [safe, r]
    run_o(Some(fns))
}
