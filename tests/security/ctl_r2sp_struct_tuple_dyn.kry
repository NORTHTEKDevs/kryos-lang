// finish-line cap:r2-storage-paths-dd09d926/k09_struct_literal_inline_tuple_trait: the store is made by an impl method reached through a `dyn` value.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
struct S { t: ([fn() -> str], i64) }
trait Putter { fn put(self: Self, s: S, g: fn() -> str) }
struct D {}
impl Putter for D { fn put(self: D, s: S, g: fn() -> str) { s.t.0[0] = g } }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = safe
    let fns = [safe]
    let d: dyn Putter = D {}
    d.put(S { t: (fns, 1) }, r)
    deny!(fs:read) { for f in fns { println("ok: " + f()) } }
}
