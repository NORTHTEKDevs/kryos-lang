// LEDGER item 131, shape layer (found by the independent verifier of PR 41 as a variant present on master, NOT FIXED; same family as rows 131a and 131b).
// A nested struct: `mko(reader).inner.run()` with `let mko = |r| { Outer { inner: Holder { run: r } } }`.
// Root: a fn-typed field of the result of a call through a local closure is not followed; the shape layer holds no type for what such a call returns.
// The deny! block sits in a `select` arm, which the row layer does not judge (LEDGER item 126, root R4), so the SHAPE layer is the only judge here.
// Master 7cab5799: check rc=0 in default and strict mode, `kryos run` prints TOPSECRET-CLOSURE-9f8e7d6c5b4a (executed).
// WANTED (when closed): rejected with E0507 or E0110 in default and strict mode, and `kryos run` must not print the secret.
fn harmless() -> str {
    return "not a secret"
}
@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}
struct Holder {
    run: fn() -> str,
}
struct Outer {
    inner: Holder,
}
impl Holder {
    fn go(self: Holder) -> str {
        return self.run()
    }
}
@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let mut f: fn() -> str = harmless
    let mko = |r: fn() -> str| { Outer { inner: Holder { run: r } } }
    let ch = chan()
    send(ch, 1)
    select {
        v ch => {
            deny!(fs:read) {
                println("OUT: " + mko(reader).inner.run())
            }
        }
    }
}
