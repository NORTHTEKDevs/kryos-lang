@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("data.txt")
}
fn safe() -> str {
    return "safe"
}
trait Sink {
    fn emit(self: Self, plugins: [fn() -> str], extra: [fn() -> str], g: fn() -> str)
}
struct S1 {}
impl Sink for S1 {
    fn emit(self: S1, plugins: [fn() -> str], extra: [fn() -> str], g: fn() -> str) {
        println(plugins[0]())
        println(g())
    }
}
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let d: dyn Sink = S1 {}
    let a = [safe]
    let b = [safe]
    d.emit(a, b, r)
    deny!(fs:read) {
        for f in b {
            println(f())
        }
    }
}
