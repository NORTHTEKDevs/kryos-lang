// LEDGER item 125 (root F, declaration order): forward store relay through a cycle of 11 or more declarations. The checker re-checked a cycle a fixed 8 times, so a longer relay was accepted in the declared order and rejected in the reversed one.
// Measured (f3f2b180): rc=0 in default and strict mode, `kryos run` prints TOPSECRET-CLOSURE-9f8e7d6c5b4a; master dd637a90 accepts it too.
// WANTED: rejected with E0110 in both modes, and `kryos run` must not print the secret.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}
fn safe() -> str {
    return "safe"
}
struct Plugin {
    run: fn() -> str,
}
struct Hub {
    id: i64,
}
impl Hub {
    fn m1(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return self.m2(reg, f)
    }
    fn m2(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return self.m3(reg, f)
    }
    fn m3(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return self.m4(reg, f)
    }
    fn m4(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return self.m5(reg, f)
    }
    fn m5(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return self.m6(reg, f)
    }
    fn m6(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return self.m7(reg, f)
    }
    fn m7(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return self.m8(reg, f)
    }
    fn m8(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return self.m9(reg, f)
    }
    fn m9(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return self.m10(reg, f)
    }
    fn m10(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return self.m11(reg, f)
    }
    fn m11(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return self.m12(reg, f)
    }
    fn m12(self: Hub, reg: [Plugin], f: fn() -> str) -> [Plugin] {
        return push(reg, Plugin { run: f })
    }
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let mut reg: [Plugin] = []
    let hub = Hub { id: 1 }
    reg = hub.m1(reg, r)
    deny!(fs:read) {
        for q in reg {
            println("LEAK: " + q.run())
        }
    }
}
