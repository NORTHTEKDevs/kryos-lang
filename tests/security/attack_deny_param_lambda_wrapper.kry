// LEDGER root R3 (the deny! verdict is taken when the module is done). a lambda with an annotated container parameter calls the deny!-bearing callee.
// Master 732714ab: check rc=0 in default and strict mode (the shape layer is blinded by the outer harmless `f`
// or does not reach the shape), `kryos run` prints the secret. WANTED: rejected with E0110 in both modes.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn run_all(fns: [fn() -> str]) {
    let f = || "harmless"
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let fns = [safe, r]
    let wrap = |a: [fn() -> str]| { run_all(a) }
    wrap(fns)
}
