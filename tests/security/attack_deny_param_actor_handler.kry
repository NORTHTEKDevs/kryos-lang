// LEDGER root R3 (the deny! verdict is taken when the module is done). item 64 relative (v11): the deny! sits in an actor handler whose parameter is the privileged closure.
// Master 732714ab: check rc=0 in default and strict mode (the shape layer is blinded by the outer harmless `f`
// or does not reach the shape), `kryos run` prints the secret. WANTED: rejected with E0110 in both modes.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn wrap_once(inner: fn() -> str) -> fn() -> str {
    return || inner()
}

actor Runner {
    fn run(reader: fn() -> str) {
        let wrapped = wrap_once(reader)
        let go = || wrapped()
        deny!(fs:read) {
            println("LEAK: " + go())
        }
    }
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let a = Runner()
    a.run(r)
    sleep(200)
}
