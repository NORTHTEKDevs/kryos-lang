@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

// item 119: the handed container sits in an Option of a tuple of an array.
use std::option::{Option, Some, None}
fn put_ot(o: Option<([fn() -> str], i64)>, g: fn() -> str) {
    match o {
        Some(t) => { t.0[0] = g },
        None() => {},
    }
}

@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    put_ot(Some((fns, 1)), r)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}