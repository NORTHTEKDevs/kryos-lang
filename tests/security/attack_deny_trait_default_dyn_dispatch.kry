// LEDGER item 122 neighbour: the deny! block of a trait DEFAULT method reached through a dyn parameter. WANTED: rejected, E0110, both modes.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}
fn safe() -> str { return "safe" }

trait Rn { fn go(self: Self, fns: [fn() -> str]) {
    let f = || "h"
    deny!(fs:read) { for f in fns { println(f()) } } } }
struct R1 {}
impl Rn for R1 {}
fn drive(d: dyn Rn, fns: [fn() -> str]) { d.go(fns) }
@capabilities(fs:read)
fn main() { let r = secret()
  let d: dyn Rn = R1 {}
  drive(d, [safe, r]) }
