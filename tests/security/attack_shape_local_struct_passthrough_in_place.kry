// LEDGER item 131, shape layer (found by the independent verifier of PR 41, NOT FIXED; same family as item 77).
// A local closure returns a whole struct parameter; the struct literal argument holds the privileged closure and the field of the call result is invoked in place: `idh(Holder { run: reader }).run()`.
// Root: as in attack_shape_local_returns_struct_field_in_place, the field of a call result is not followed.
// Master 7cab5799 AND PR 41 head 364d2e44 AND the revise round's head: check rc=0 in default and strict mode, `kryos run` prints TOPSECRET-CLOSURE-9f8e7d6c5b4a (executed).
// The deny! block sits in a `select` arm, which the row layer does not judge (LEDGER item 126, root R4), so the SHAPE layer is the only judge here. With the block in ordinary position the row layer rejects it (E0110).
// WANTED (when closed): rejected with E0507 or E0110 in default and strict mode, and `kryos run` must not print the secret.
fn harmless() -> str {
    return "not a secret"
}
@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

struct Holder {
    run: fn() -> str,
}
@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let idh = |h: Holder| { h }
    let ch = chan()
    send(ch, 1)
    select {
        v ch => {
            deny!(fs:read) {
                println("OUT: " + idh(Holder { run: reader }).run())
            }
        }
    }
}
