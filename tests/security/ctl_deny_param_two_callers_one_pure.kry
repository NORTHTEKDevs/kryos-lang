// LEDGER root R3 (the deny! verdict is taken when the module is done). a deny!-bearing callee that is only ever handed pure closures, next to a privileged closure that main calls outside any deny!.
// Must stay ACCEPTED in the default and the strict mode (no over-rejection).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn run_all(fns: [fn() -> str]) {
    let f = || "harmless"
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    run_all([safe])
    println(r())
}
