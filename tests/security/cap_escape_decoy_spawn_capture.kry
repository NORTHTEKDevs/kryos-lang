// SECURITY -- decoy-companion variant #7: the vulnerable call happens
// inside a `spawn` body, capturing `decoy`/`real` from the enclosing scope.
// Confirms the companion tracing survives the spawn-capture boundary.
//
// ACCEPTANCE: REJECTED (E0507) under both enforcement modes.

@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

fn apply_to_second<T>(decoy: [T], real: [T], f: fn(T) -> str) -> str {
    return f(real[0])
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let mut real: [fn() -> str] = []
    real = push(real, reader)
    let decoy: [fn() -> str] = []
    deny!(fs:read) {
        spawn fn() {
            let out = apply_to_second(decoy, real, |c| c())
            println("DECOY-SPAWN-CAPTURE LEAK: " + out)
        }
    }
}
