// LEDGER item 123: the function value a factory returned is kept in a struct field and called from there.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
fn mk7(g: fn() -> str) -> fn([fn() -> str]) { return fn(reg: [fn() -> str]) { reg[0] = g } }
struct Op { run: fn([fn() -> str]) }
trait Rn { fn go(self: Self, fns: [fn() -> str]) { let f = || "h"
  deny!(fs:read) { for f in fns { println("ok: " + f()) } } } }
struct R1 {}
impl Rn for R1 {}
@capabilities(fs:read)
fn main() { let r = safe
  let fns = [safe]
  let o = Op { run: mk7(r) }
  o.run(fns)
  R1 {}.go(fns) }
