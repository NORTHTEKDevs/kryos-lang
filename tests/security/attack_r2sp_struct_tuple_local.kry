// the same with the struct bound to a local first (the finish-line rows only build the literal in the call argument).
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
struct S { t: ([fn() -> str], i64) }
fn put(s: S, g: fn() -> str) { s.t.0[0] = g }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    let s = S { t: (fns, 1) }
    put(s, r)
    deny!(fs:read) { for f in fns { println("LEAK: " + f()) } }
}
