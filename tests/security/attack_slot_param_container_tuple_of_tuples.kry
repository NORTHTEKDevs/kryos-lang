@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

// item 119: the handed container sits two tuples deep.
fn put_tt(t: (i64, ([fn() -> str], i64)), g: fn() -> str) {
    t.1.0[0] = g
}

@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    put_tt((1, (fns, 2)), r)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}