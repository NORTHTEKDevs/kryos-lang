// LEDGER root R3 (the deny! verdict is taken when the module is done). a privileged closure sits in a registry read by a deny! block that denies a capability the closure does not use.
// Must stay ACCEPTED in the default and the strict mode (no over-rejection).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

struct Host {
    items: [fn() -> str],
}
impl Host {
    fn run(self) {
        let f = || "harmless"
        deny!(net:http) {
            for f in self.items {
                println(f())
            }
        }
    }
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let h = Host { items: [safe] }
    h.items = push(h.items, r)
    h.run()
}
