fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

struct Box { f: fn() -> str }

@capabilities(fs:read)
fn main() {
    let reader: fn() -> str = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    deny!(fs:read) {
        // LIVE ESCAPE (if this compiles clean and prints the secret): a
        // FRESH struct literal used directly as a method-call receiver,
        // never bound to any local, defeats deny!().
        let leaked: str = Box { f: reader }.f()
        println("INLINE-STRUCT-LITERAL-RECEIVER DENY LEAK: " + leaked)
    }
}
