// LEDGER root R3 (the deny! verdict is taken when the module is done). item 64 twin: the same wrapper chain, handed a pure closure.
// Must stay ACCEPTED in the default and the strict mode (no over-rejection).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn wrap_once(inner: fn() -> str) -> fn() -> str {
    return || inner()
}

fn outer(reader: fn() -> str) {
    let wrapped = wrap_once(reader)
    let go = || wrapped()
    deny!(fs:read) {
        println("ok: " + go())
    }
}

@capabilities(fs:read)
fn main() {
    outer(safe)
}
