// finish-line cap:r2-storage-paths-dd09d926/g01_f19_noalias: a store helper takes a struct whose field is a tuple holding an array, and the struct literal is built in the call argument. The struct field is one row var for the whole program; the array the caller put in the tuple is the same array, and the store through the field never reached it.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
struct S { t: ([fn() -> str], i64) }
fn put(s: S, g: fn() -> str) { s.t.0[0] = g }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    put(S { t: (fns, 1) }, r)
    deny!(fs:read) { for f in fns { println("LEAK: " + f()) } }
}
