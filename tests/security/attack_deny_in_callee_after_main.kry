@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

// item 115 with the callee declared AFTER main (the ledger documents only "declared before main").
@capabilities(fs:read)
fn main() {
    let r = secret()
    let fns = [safe, r]
    run_guarded(fns)
}

fn run_guarded(fns: [fn() -> str]) {
    let f = || "harmless"
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
