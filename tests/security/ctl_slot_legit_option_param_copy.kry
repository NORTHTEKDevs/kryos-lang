@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("data.txt")
}
fn safe() -> str {
    return "safe"
}
use std::option::{Option, Some, None}
fn put_o(o: Option<[fn() -> str]>, g: fn() -> str) {
    match o {
        Some(a) => { a[0] = g },
        None() => {},
    }
}
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    put_o(Some(fns), r)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
