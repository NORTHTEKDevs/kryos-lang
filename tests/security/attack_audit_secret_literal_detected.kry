// Control: a secret written as a single literal. `kryos audit`'s
// SECRET_PATTERNS scan does `line.contains(pat)`, so a literal like this
// should be flagged CRITICAL. Used as the A/B baseline against
// attack_audit_secret_concat_bypass.kry, which builds the identical
// runtime string via `+` concatenation instead.
fn main() {
    let key: str = "AKIA1234567890ABCDEF"
    println(key)
}
