// ASSAULT round 2 (strip-the-row lens): a fn-typed local initialized with a
// harmless placeholder closure, then REASSIGNED to the privileged reader
// before being invoked inside deny!(fs:read). Tests whether the checker's
// tracking of a local's carried authority is keyed on the INITIAL binding
// (which would see the harmless placeholder) rather than the value actually
// live at the call site.
//
// ACCEPTANCE: REJECTED (E0507) under both enforcement modes.

@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let mut slot: fn() -> str = || "placeholder"
    slot = reader
    deny!(fs:read) {
        let leaked = slot()
        println("REASSIGNED-LOCAL LEAK: " + leaked)
    }
}
