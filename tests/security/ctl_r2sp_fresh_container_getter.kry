// a function that returns a container it built hands out a container nobody else holds: the store into it does not reach the array the caller keeps.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
fn mk() -> [fn() -> str] { return [safe] }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let a = [safe]
    let b = mk()
    b[0] = r
    deny!(fs:read) { for f in a { println("ok: " + f()) } }
}
