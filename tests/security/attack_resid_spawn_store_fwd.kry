// LEDGER items 122, 124, 125 (residual wave): the store sits in a spawned lambda and its helper is declared below.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}
fn safe() -> str {
    return "safe"
}
let mut REG: [fn() -> str] = []
@capabilities(fs:read)
fn main() {
    let r = secret()
    spawn fn() {
        t_a(r)
    }
    sleep(200)
    show()
}
fn show() {
    let f = || "harmless"
    deny!(fs:read) {
        for f in REG {
            println("LEAK: " + f())
        }
    }
}
fn t_a(f: fn() -> str) {
    t_b(f)
}
fn t_b(f: fn() -> str) {
    REG = push(REG, f)
}
