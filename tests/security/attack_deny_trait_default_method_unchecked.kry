// LEDGER item 122 (CLOSED): the type checker used to skip the BODY of a trait default method, so a deny! block in one was
// never judged (and `let x: i64 = "not an int"` in one was accepted). `check_decl_inner` now has a `Decl::Trait` arm that checks
// each default body like an impl method body. An outer harmless `f` blinds the shape layer, as in the rest of the corpus.
// Master dd637a90: check rc=0 in default and strict mode, `kryos run` prints the secret. WANTED and now true: rejected with E0110 in both modes.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

trait Runner {
    fn go(self: Self, fns: [fn() -> str]) {
        let f = || "harmless"
        deny!(fs:read) {
            for f in fns {
                println(f())
            }
        }
    }
}
struct R1 {}
impl Runner for R1 {}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let fns = [safe, r]
    let x = R1 {}
    x.go(fns)
}
