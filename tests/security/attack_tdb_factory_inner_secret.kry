// LEDGER item 123: the closure the returned lambda stores is created inside the factory, not passed to it.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
@capabilities(fs:read)
fn mk3(pick: i64) -> fn([fn() -> str]) { let h = secret()
  return fn(reg: [fn() -> str]) { reg[0] = h } }
trait Rn { fn go(self: Self, fns: [fn() -> str]) { let f = || "h"
  deny!(fs:read) { for f in fns { println("LEAK: " + f()) } } } }
struct R1 {}
impl Rn for R1 {}
@capabilities(fs:read)
fn main() { let fns = [safe]
  let st = mk3(1)
  st(fns)
  R1 {}.go(fns) }
