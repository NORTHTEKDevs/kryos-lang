// Twin of attack_slot_lambda_wrapper_calls_put.kry: the helper stores a PURE function, so nothing privileged reaches the deny! block.
// Must stay ACCEPTED in the default and the strict mode (no over-rejection).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn put(reg: [fn() -> str], g: fn() -> str) {
    reg[0] = g
}

// item 112 lambda form, but the lambda stores through a CALL to the named helper instead of storing itself.
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let wrap = |a: [fn() -> str], g: fn() -> str| { put(a, g) }
    let fns = [safe]
    wrap(fns, safe)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
