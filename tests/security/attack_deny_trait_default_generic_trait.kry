// LEDGER item 122 neighbour: the default method of a GENERIC trait (`trait Runner<T>`) holds the deny! block that runs a
// privileged closure handed in through the parameter. WANTED: rejected with E0110 in both modes.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

trait Runner<T> {
    fn go(self: Self, fns: [fn() -> str]) {
        let f = || "harmless"
        deny!(fs:read) {
            for f in fns {
                println(f())
            }
        }
    }
}
struct R1 {}
impl Runner<i64> for R1 {}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let fns = [safe, r]
    let x = R1 {}
    x.go(fns)
}
