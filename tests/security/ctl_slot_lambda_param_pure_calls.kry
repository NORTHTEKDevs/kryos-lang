// LEDGER root R2, revise round of PR 38 (control).
// A lambda called with two different pure functions, read inside deny!(fs:read).
// Must stay ACCEPTED by `kryos check` (default and strict): the lambda is only ever called with pure functions.
use std::iter::{for_each}

@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn also_safe() -> str {
    return "also-safe"
}

@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let wrap = |g: fn() -> str| -> [fn() -> str] {
        return [safe, g]
    }
    let a = wrap(safe)
    let b = wrap(also_safe)
    deny!(fs:read) {
        for f in b {
            println(f())
        }
    }
}
