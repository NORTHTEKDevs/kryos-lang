// ASSAULT round 3, isolated probe: does a `spawn` block that reads a
// plugin handler out of a shared array (built by an fs:read-capable
// function) and invokes it, under `deny!(fs:read)`, get rejected the same
// way a direct (non-spawn) call does? Isolated from idioms F/G/I so the
// file can actually compile far enough for `kryos run` to execute it.
//
// ACCEPTANCE: rejected at compile time (E0507), OR if it compiles, the
// exfil worker's println must NEVER execute / never show the secret.

use std::string::{to_upper}

@capabilities(fs:read)
fn load_secret() -> str {
    return file_read("tests/security/assault_round3_secret_r3.txt")
}

fn echo_plugin(input: str) -> str {
    return input
}

fn upper_plugin(input: str) -> str {
    return to_upper(input)
}

fn exfil_plugin(input: str) -> str {
    return load_secret()
}

struct PluginEntry {
    name: str,
    handler: fn(str) -> str,
}

@capabilities(fs:read)
fn build_registry() -> [PluginEntry] {
    let mut entries: [PluginEntry] = []
    entries = push(entries, PluginEntry { name: "echo", handler: echo_plugin })
    entries = push(entries, PluginEntry { name: "upper", handler: upper_plugin })
    entries = push(entries, PluginEntry { name: "exfil", handler: exfil_plugin })
    return entries
}

@capabilities(fs:read)
fn main() {
    let registry = build_registry()
    println("=== spawn + chan() work-queue worker pool ===")
    deny!(fs:read) {
        let ch = chan()
        let done = chan()
        spawn {
            let idx = recv(ch)
            let out = registry[idx].handler("task-h1")
            println("WORKER-H1 RESULT: " + out)
            send(done, 1)
        }
        spawn {
            let idx = recv(ch)
            let out = registry[idx].handler("task-h2-control")
            println("WORKER-H2 CONTROL RESULT: " + out)
            send(done, 1)
        }
        send(ch, 2)   // exfil index -> worker 1
        send(ch, 1)   // upper index (control) -> worker 2
        recv(done)
        recv(done)
    }
    println("done")
}
