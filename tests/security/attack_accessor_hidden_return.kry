// LEDGER item 130, shape layer (found by the revise round of PR 41 while looking for the other users of `collect_return_exprs`; present on master, NOT FIXED on 1.3.0).
// `collect_transparent_accessor_paths` registered `Holder.get` as a transparent accessor (`self.items[i]`) because the only return the walk saw decomposes to a self-rooted path;
// the `return r` in the non-final `match` statement hands back a caller-supplied closure that the accessor path says nothing about.
// Master 7cab5799 AND PR 41 head 364d2e44: check rc=0 in default and strict mode, `kryos run` prints TOPSECRET-CLOSURE-9f8e7d6c5b4a (executed).
// The deny! block sits in a `select` arm, which the row layer does not judge (LEDGER item 126, root R4), so the SHAPE layer is the only judge here.
// WANTED (when closed): rejected with E0507 or E0110 in default and strict mode, and `kryos run` must not print the secret. A candidate fix (PR 41) was deferred past 1.3.0.
fn harmless() -> str {
    return "not a secret"
}
@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

struct Holder {
    items: [fn() -> str],
}

impl Holder {
    fn get(self, i: i64, r: fn() -> str) -> fn() -> str {
        match i {
            99 => { return r }
            _ => { }
        }
        return self.items[i]
    }
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let h = Holder { items: [harmless] }
    let f = h.get(99, reader)
    let ch = chan()
    send(ch, 1)
    select {
        v ch => {
            deny!(fs:read) {
                println("OUT: " + f())
            }
        }
    }
}
