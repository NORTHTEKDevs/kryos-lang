// LEDGER item 122 / 123: a call through a trait signature references every candidate: two impls of one trait, only one hands its argument on.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
trait Mk { fn mk(self: Self, fns: [fn() -> str]) -> [fn() -> str]
  fn run(self: Self, fns: [fn() -> str]) { let f = || "h"
    let ys = self.mk(fns)
    deny!(fs:read) { for f in ys { println("ok: " + f()) } } } }
struct Good {}
struct Evil {}
impl Mk for Good { fn mk(self: Self, fns: [fn() -> str]) -> [fn() -> str] { return [safe] } }
impl Mk for Evil { fn mk(self: Self, fns: [fn() -> str]) -> [fn() -> str] { return fns } }
@capabilities(fs:read)
fn main() { let r = safe
  Evil {}.run([safe, r])
  Good {}.run([safe]) }
