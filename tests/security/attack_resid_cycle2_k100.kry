// LEDGER items 122, 124, 125 (residual wave): two functions rotate 100 function-typed parameters (the check must also finish, see the gate).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}
fn safe() -> str {
    return "safe"
}
struct Plugin {
    run: fn() -> str,
}
@capabilities(fs:read)
fn main() {
    let r = secret()
    let mut reg: [Plugin] = []
    reg = ra(reg, 1, safe, r, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe, safe)
    deny!(fs:read) {
        for q in reg {
            println("LEAK: " + q.run())
        }
    }
}
