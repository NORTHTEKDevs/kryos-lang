// LEDGER item 128, shape layer (found by the item-77 wave, NOT FIXED on 1.3.0).
// A top-level function returns a closure that returns its captured parameter, and the returned closure is applied in the same expression: `f = make_getter(reader)()` (item 128).
// Root: the chained-call arm of `resolve_closure_caps` answers the call with the value of the inner call, the flat authority of the closure `make_getter` returns (`|| c`, which needs nothing), as the value of applying it.
// The deny! block sits in a `select` arm, which the row layer does not judge (LEDGER item 126, root R4), so the SHAPE layer is the only judge here.
// Master e2fbc46c and 7cab5799: check rc=0 in default and strict mode, `kryos run` prints TOPSECRET-CLOSURE-9f8e7d6c5b4a (executed).
// WANTED (when closed): rejected with E0507 or E0110 in default and strict mode, and `kryos run` must not print the secret. A candidate fix (PR 41) was deferred past 1.3.0.
fn harmless() -> str {
    return "not a secret"
}
@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

fn make_getter(c: fn() -> str) -> fn() -> fn() -> str {
    return || c
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let mut f: fn() -> str = harmless
    f = make_getter(reader)()
    let ch = chan()
    send(ch, 1)
    select {
        v ch => {
            deny!(fs:read) {
                println("OUT: " + f())
            }
        }
    }
}
