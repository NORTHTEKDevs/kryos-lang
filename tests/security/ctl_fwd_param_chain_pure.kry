// Control for the declaration-order family (LEDGER items 124 and 125): the same forward chain as attack_fwd_param_chain_invoke_in_deny.kry, but `main` hands it a pure closure.
// `tool` is declared above `invoke`, and both above `main`. Accepted and printing "safe" in every order of the helpers (the order-independence pin re-checks it).
fn safe() -> str {
    return "safe"
}

fn tool(reader: fn() -> str) -> str {
    let g = reader
    return invoke(g)
}

fn invoke(h: fn() -> str) -> str {
    return h()
}

fn main() {
    deny!(fs:read) {
        println(tool(safe))
    }
}
