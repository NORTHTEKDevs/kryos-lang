@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

struct Host {}
impl Host {
    fn run_all(self, fns: [fn() -> str]) {
        let f = || "harmless"
        deny!(fs:read) {
            for f in fns {
                println(f())
            }
