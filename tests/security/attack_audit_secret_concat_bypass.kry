// RED TEAM round 2, toolchain-supply lens: `kryos audit`'s secret-pattern
// scan (compiler/crates/kryos-cli/src/commands/audit_cmd.rs) matches each
// SECRET_PATTERNS entry with plain `line.contains(pat)` against the raw
// SOURCE TEXT of one line. It never evaluates the program, so a secret
// whose fixed prefix (e.g. "AKIA", "ghp_") is split across a `+`
// concatenation -- or spread onto more than one line -- never appears as a
// contiguous substring on any single source line, and the scan misses it
// entirely, while `kryos check`/`run` compile and run this file (and would
// happily emit/exfiltrate the identical runtime string) with no complaint
// either. At RUNTIME this variable holds the exact same string as the
// control file's literal.
fn main() {
    let key: str = "AKIA" + "1234567890ABCDEF"
    let token: str = "ghp_" + "abcdefghijklmnopqrstuvwx"
    println(key)
    println(token)
}
