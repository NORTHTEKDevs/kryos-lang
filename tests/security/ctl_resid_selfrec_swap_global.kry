// LEDGER items 122, 124, 125 (residual wave): a recursion that swaps two parameters stores one into a global.
// root: F125 self-rec swap + global
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}
fn harmless() -> fn() -> str {
    return || "safe"
}
fn safe() -> str {
    return "safe"
}

let mut SLOT: [fn() -> str] = []
fn show() {
    let f = || "harmless"
    deny!(fs:read) {
        for f in SLOT {
            println("LEAK: " + f())
        }
    }
}
@capabilities(fs:read)
fn main() {
    let r = safe
    let s = || "x"
    swap_store(s, r, 3)
    show()
}
fn swap_store(a: fn() -> str, b: fn() -> str, n: i64) {
    if n == 0 {
        SLOT = push(SLOT, a)
        return
    }
    swap_store(b, a, n - 1)
}
