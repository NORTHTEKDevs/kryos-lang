// LEDGER item 122 control: a trait default method holds a deny! block that uses no authority. Must stay ACCEPTED in the
// default and the strict mode (the body is judged now, and nothing in it uses fs:read).
trait Runner {
    fn go(self: Self, n: i64) {
        deny!(fs:read) {
            println(n + 1)
        }
    }
}
struct R1 {}
impl Runner for R1 {}

@capabilities(fs:read)
fn main() {
    let x = R1 {}
    x.go(1)
}
