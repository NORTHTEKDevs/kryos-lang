// LEDGER item 122 / 123: a call through a trait signature references every candidate: the impl reached through self builds the privileged container itself.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
trait Rd { fn mk(self: Self) -> [fn() -> str]
  fn run(self: Self) { let f = || "h"
    let ys = self.mk()
    deny!(fs:read) { for f in ys { println("ok: " + f()) } } } }
struct S1 {}
impl Rd for S1 { fn mk(self: Self) -> [fn() -> str] { return [safe, safe] } }
@capabilities(fs:read)
