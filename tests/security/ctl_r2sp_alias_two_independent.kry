// two arrays of an alias type, a privileged closure stored into one and the other read: the alias is not one shared location.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
type Reg = [fn() -> str]
fn put(a: Reg, g: fn() -> str) { a[0] = g }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let a = [safe]
    let b = [safe]
    put(a, r)
    deny!(fs:read) { for f in b { println("ok: " + f()) } }
}
