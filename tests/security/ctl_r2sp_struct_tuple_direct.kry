// the same with no call at all: the store goes through the field of a struct in `main`, and the block reads the array the tuple was built from.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
struct S { t: ([fn() -> str], i64) }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = safe
    let fns = [safe]
    let s = S { t: (fns, 1) }
    s.t.0[0] = r
    deny!(fs:read) { for f in fns { println("ok: " + f()) } }
}
