// LEDGER items 122, 124, 125 (residual wave): an impl method stores the closure into a global through helpers declared below the reader.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}
fn safe() -> str {
    return "safe"
}

struct Reg {
    id: i64,
}
@capabilities(fs:read)
fn main() {
    let r = safe
    let g = Reg { id: 1 }
    g.add(r)
    show()
}
let mut REG: [fn() -> str] = []
fn show() {
    let f = || "harmless"
    deny!(fs:read) {
        for f in REG {
            println("LEAK: " + f())
        }
    }
}
impl Reg {
    fn add(self: Reg, f: fn() -> str) {
        add2(f)
    }
}
fn add2(f: fn() -> str) {
    REG = push(REG, f)
}
