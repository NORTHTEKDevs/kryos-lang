@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

// item 112 where the handed container sits inside a tuple parameter (storage_rows_in does not walk Tuple).
fn put_t(t: ([fn() -> str], i64), g: fn() -> str) {
    t.0[0] = g
}

@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    put_t((fns, 1), r)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
