// LEDGER root R3 (a reference that precedes its declaration): attack_array_param_alias_invoke_deny.kry with `main` moved above every other item,
// so the helper is declared AFTER the code that calls it. Master 732714ab accepts it and `kryos run` prints the secret
// (for the two attack_slot_lambda_param_over_container twins: accepted by --strict-capabilities, the default mode rejects them
// through the shape layer). WANTED: rejected with E0110 in both modes.

@capabilities(fs:read)
fn main() {
    let reg: [fn() -> str] = [|| "pure", || file_read("tests/security/secret_for_closure_launder.txt")]
    deny!(fs:read) {
        run_it(reg)
    }
}

// LEDGER item 70 minimal (array form). Must be REJECTED (E0110 and/or E0507) under inferred and strict.
fn run_it(reg: [fn() -> str]) {
    let f = reg[1]
    println("M3: " + f())
}
