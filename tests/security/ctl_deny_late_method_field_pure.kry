// LEDGER root R3 (the deny! verdict is taken when the module is done). item 116 twin: the method declared before main iterates a field that main fills with a pure closure only.
// Must stay ACCEPTED in the default and the strict mode (no over-rejection).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

struct Host {
    items: [fn() -> str],
}
impl Host {
    fn run(self) {
        let f = || "harmless"
        deny!(fs:read) {
            for f in self.items {
                println(f())
            }
        }
    }
}

@capabilities(fs:read)
fn main() {
    let h = Host { items: [safe] }
    h.items = push(h.items, safe)
    h.run()
}
