// LEDGER root R2 control for item 66: attack_realprogram_registry_list_wrapper with
// both plugins pure. Must stay ACCEPTED (default and strict).
use std::collections::{List}

struct Plugin {
    name: str,
    run: fn() -> str,
}

fn safe_plugin() -> str {
    return "safe-plugin-ran"
}

fn other_safe_plugin() -> str {
    return "other-safe-plugin-ran"
}

@capabilities(fs:read)
fn main() {
    let mut reg: List<Plugin> = List.new()
    reg = reg.push(Plugin { name: "safe", run: safe_plugin })
    reg = reg.push(Plugin { name: "safe2", run: other_safe_plugin })
    deny!(fs:read) {
        let p = reg.get(1)
        let out = p.run()
        println("LIST-WRAPPER RESULT: " + out)
    }
}
