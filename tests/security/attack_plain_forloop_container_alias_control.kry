// POSITIVE CONTROL for attack_plain_forloop_container_alias.kry: identical
// program EXCEPT the fn-bearing struct param `b` is invoked DIRECTLY
// (`b.f()`), with no for-loop indirection. This isolates that the for-loop
// binding -- not merely "a struct-typed parameter passed across a function
// boundary" -- is what defeats the checker in the sibling file.
// ACCEPTANCE: REJECTED (E0507) under `deny!(fs:read)`.

@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

struct Box { f: fn() -> str }

fn invoke_direct(b: Box) -> str {
    return b.f()
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let b = Box { f: reader }
    deny!(fs:read) {
        let leaked = invoke_direct(b)
        println("DIRECT-CALL LEAK (should not print): " + leaked)
        sleep(100)
    }
}
