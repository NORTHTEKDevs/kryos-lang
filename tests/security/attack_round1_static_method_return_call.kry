// ASSAULT round 1, historical-regression lens: "static-method offset".
// A static (no-`self`) impl method returns the privileged closure; the
// call site invokes it via `Type::factory()()` -- a StaticMethodCall
// wrapping a plain FnCall on its own result, in one expression, with no
// intervening `let`. Probes whether the checker's StaticMethodCall arm
// double-counts/ignores capability propagation when the RESULT of the
// static call is immediately invoked in the same expression (distinct from
// existing decoy_method_receiver / wrap_closure_impl_method tests, which
// bind the returned closure to a local first).
//
// ACCEPTANCE (if the checker were sound): REJECTED (E0507) under both
// `kryos run` (inferred default) and `--strict-capabilities`.

@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

struct Factory {
    tag: i64
}

impl Factory {
    fn build() -> fn() -> str {
        return make_secret_reader("tests/security/secret_for_closure_launder.txt")
    }
}

@capabilities(fs:read)
fn main() {
    deny!(fs:read) {
        let leaked = Factory::build()()
        println("STATIC-METHOD-CHAIN LEAK: " + leaked)
    }
}
