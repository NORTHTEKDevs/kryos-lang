// LEDGER root R2, revise round of PR 38 (found by the author while closing the verifier's finding).
// A LAMBDA with an annotated array parameter stores its annotated closure parameter into it (reg[0] = g). A lambda is one monomorphic value: there is no per-call copy of the parameter row to replay, so the store has to reach the slot of each argument when the parameter is bound to it.
// Master dcf72e93: not measured.
// First R2 build (PR head dbfb989d): not measured.
// Must be REJECTED with E0110 ("capability `fs:read` is denied in this block") under inferred and strict,
// and `kryos run` must not print the secret.
use std::iter::{for_each, map}

@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}


@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    let put = |reg: [fn() -> str], g: fn() -> str| {
        reg[0] = g
    }
    put(fns, r)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
