@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("data.txt")
}
fn safe() -> str {
    return "safe"
}
trait Counter {
    fn count(self: Self, a: [fn() -> str], g: fn() -> str) -> i64
}
struct C1 {}
impl Counter for C1 {
    fn count(self: C1, a: [fn() -> str], g: fn() -> str) -> i64 {
        println(g())
        return 1
    }
}
fn tally<T: Counter>(x: T, a: [fn() -> str], g: fn() -> str) -> i64 {
    return x.count(a, g)
}
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    println(tally(C1 {}, fns, r))
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
