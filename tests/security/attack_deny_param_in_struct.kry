// LEDGER root R3 (the deny! verdict is taken when the module is done). the closures reach the deny! through the field of a struct parameter.
// Master 732714ab: check rc=0 in default and strict mode (the shape layer is blinded by the outer harmless `f`
// or does not reach the shape), `kryos run` prints the secret. WANTED: rejected with E0110 in both modes.
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

struct Bag {
    items: [fn() -> str],
}

fn run_b(b: Bag) {
    let f = || "harmless"
    deny!(fs:read) {
        for f in b.items {
            println(f())
        }
    }
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let b = Bag { items: [safe, r] }
    run_b(b)
}
