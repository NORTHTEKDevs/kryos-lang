// ASSAULT round 2 (strip-the-row lens): generic-trait-bound MethodCall arm
// (checker ~4771-4816, spec gap #3). `main` declares NO capabilities at all
// and calls a generic fn `call_it<T: Runner>(t: T)` that invokes `t.run()`,
// whose concrete impl needs fs:read. If the trait-bound generic dispatch
// arm fails to charge the call into main's accumulated row (the exact gap
// named in the task brief), this compiles clean and prints the secret with
// main holding NOTHING.
//
// ACCEPTANCE: must be REJECTED (E0501/E0507) under both
// `--capabilities-mode=inferred` (default) and `--strict-capabilities`. A
// clean compile + rc=0 + secret printed is a real, bare (no deny! needed)
// capability escape.

trait Runner {
    fn run(self) -> str
}

struct RealRunner {}

impl Runner for RealRunner {
    @capabilities(fs:read)
    fn run(self) -> str {
        return file_read("tests/security/secret_for_closure_launder.txt")
    }
}

fn call_it<T: Runner>(t: T) -> str {
    return t.run()
}

fn main() {
    let r = RealRunner {}
    let out = call_it(r)
    println("TRAIT-BOUND-BARE LEAK: " + out)
}
