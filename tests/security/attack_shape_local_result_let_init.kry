// LEDGER item 134, shape layer (the shape-layer half of item 77; found by the item-77 wave, NOT FIXED on 1.3.0).
// The result of the local closure call initializes a `let` (no reassignment): `let f = setter(reader)`.
// Root: `resolve_closure_caps` answers a call through a local with the closure's own INVOCATION authority (`local_caps`), not the authority of the value it returns.
// The deny! block sits in a `select` arm, which the row layer does not judge (LEDGER item 126, root R4), so the SHAPE layer is the only judge here.
// Master e2fbc46c and 7cab5799: check rc=0 in default and strict mode, `kryos run` prints TOPSECRET-CLOSURE-9f8e7d6c5b4a (executed).
// WANTED (when closed): rejected with E0507 or E0110 in default and strict mode, and `kryos run` must not print the secret. A candidate fix (PR 41) was deferred past 1.3.0: see LEDGER item 134.
fn harmless() -> str {
    return "not a secret"
}
@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let setter = |r: fn() -> str| { r }
    let f = setter(reader)
    let ch = chan()
    send(ch, 1)
    select {
        v ch => {
            deny!(fs:read) {
                println("OUT: " + f())
            }
        }
    }
}
