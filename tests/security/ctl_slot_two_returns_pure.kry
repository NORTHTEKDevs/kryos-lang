// LEDGER root R2, revise round of PR 38 (control).
// A function with two returns of different PURE functions, called inside deny!(fs:read).
// Must stay ACCEPTED by `kryos check` (default and strict): every return is a pure function.
use std::iter::{for_each}

@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn also_safe() -> str {
    return "also-safe"
}
fn pick(c: bool) -> fn() -> str {
    if c {
        return safe
    }
    return also_safe
}

@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let ps = [pick(false)]
    deny!(fs:read) {
        for f in ps {
            println(f())
        }
    }
}
