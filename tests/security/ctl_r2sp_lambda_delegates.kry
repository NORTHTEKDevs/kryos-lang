// a lambda that a factory returns hands the container to a named helper (the second of the three shapes the factory wave left open).
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
fn put(reg: [fn() -> str], g: fn() -> str) { reg[0] = g }
fn mk(g: fn() -> str) -> fn([fn() -> str]) { return fn(reg: [fn() -> str]) { put(reg, g) } }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = safe
    let fns = [safe]
    let st = mk(r)
    st(fns)
    deny!(fs:read) { for f in fns { println("ok: " + f()) } }
}
