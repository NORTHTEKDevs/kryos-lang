// ASSAULT-F6 attack: one name is bound to a PlainFormatter and later to a SecretLoader. A name whose
// bindings disagree is not resolved by type, so both calls are charged the union over every `run` and the
// block is rejected (E0507) in both modes.
@capabilities(fs:read)
fn load_secret() -> str {
    return file_read("tests/security/secret_for_closure_launder.txt")
}

trait Loader {
    fn run(self: Self) -> str
}

struct SecretLoader {}
impl Loader for SecretLoader {
    @capabilities(fs:read)
    fn run(self: SecretLoader) -> str {
        return load_secret()
    }
}

trait Formatter {
    fn run(self: Self) -> str
}

struct PlainFormatter {}
impl Formatter for PlainFormatter {
    fn run(self: PlainFormatter) -> str {
        return "formatted"
    }
}

@capabilities(fs:read)
fn main() {
    deny!(fs:read) {
        let f = PlainFormatter {}
        println(f.run())
        let f = SecretLoader {}
        println("ASSAULT-F6-LEAK " + f.run())
    }
}
