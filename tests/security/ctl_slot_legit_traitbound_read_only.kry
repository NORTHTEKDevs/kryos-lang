@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("data.txt")
}
fn safe() -> str {
    return "safe"
}
trait Runner {
    fn go(self: Self, reg: [fn() -> str], g: fn() -> str) -> str
}
struct R1 {}
impl Runner for R1 {
    fn go(self: R1, reg: [fn() -> str], g: fn() -> str) -> str {
        return reg[0]() + g()
    }
}
fn use_runner<R: Runner>(x: R, fns: [fn() -> str], g: fn() -> str) -> str {
    return x.go(fns, g)
}
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    println(use_runner(R1 {}, fns, r))
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
