@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}
use std::iter::{for_each}
let mut REG: [fn() -> str] = []
struct Holder { n: i64 }
trait Adder { fn add(self: Self, g: fn() -> str)
  fn add2(self: Self, g: fn() -> str) { self.add(g) } }
impl Adder for Holder {
    fn add(self: Holder, g: fn() -> str) { REG = push(REG, g) }
}
fn run_all() {
    let f = || "harmless"
    deny!(fs:read) { for f in REG { println(f()) } }
}
fn use_it<A: Adder>(a: A, g: fn() -> str) { a.add2(g) }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let h = Holder { n: 1 }
    use_it(h, r)
    run_all()
}
