// THREAT-MODEL.md section 4.5, row B3 (not an escape_status.sh row).
// std::ffi (compiler/stdlib/ffi.kry) carries no @capabilities annotation, so an
// unannotated `main` can read arbitrary process memory with no `ffi`
// declaration. The same module exposes dlopen/dlsym/dlcall0-6 (arbitrary C
// library calls); this repro stays on the memory read so it is portable.
//
// kryos 1.2.0 at dbfb989d: `kryos check` rc=0 in default and
// --strict-capabilities mode, and `kryos run` prints BYPASS-B3-OK (executed
// 2026-11-01). The raw-memory builtins `str_to_ptr` and `ptr_byte_at` in the same
// `main` are rejected with E0505 (G6): only the stdlib wrapper is open.
use std::ffi::{cstr, read_i8}

fn main() {
    let p = cstr("BYPASS-B3-OK")
    let mut out = ""
    let mut i = 0
    while i < 12 {
        out = out + char_from(read_i8(p + i))
        i = i + 1
    }
    println(out)
}
