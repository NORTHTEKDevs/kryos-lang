@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn put(reg: [fn() -> str], g: fn() -> str) {
    reg[0] = g
}

// item 112, the storing helper is returned by a factory function.
fn get_op() -> fn([fn() -> str], fn() -> str) {
    return put
}

@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let op = get_op()
    let fns = [safe]
    op(fns, r)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
