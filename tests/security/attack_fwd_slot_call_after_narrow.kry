// LEDGER root R3 (a reference that precedes its declaration): attack_slot_call_after_narrow.kry with `main` moved above every other item,
// so the helper is declared AFTER the code that calls it. Master 732714ab accepts it and `kryos run` prints the secret
// (for the two attack_slot_lambda_param_over_container twins: accepted by --strict-capabilities, the default mode rejects them
// through the shape layer). WANTED: rejected with E0110 in both modes.
// LEDGER root R2, revise round of PR 38 (found by the author while closing the verifier's finding).
// A callee stores its closure parameter into an array that starts with a pure function and then CALLS the parameter. The store narrowed the parameter's row var to the empty row, so the call was charged nothing.
// Master dcf72e93: accepted in every mode (check rc=0, default and strict) and `kryos run` prints the secret (executed).
// First R2 build (PR head dbfb989d): accepted in every mode (check rc=0, default and strict) and `kryos run` prints the secret (executed).
// Must be REJECTED with E0110 ("capability `fs:read` is denied in this block") under inferred and strict,
// and `kryos run` must not print the secret.
use std::iter::{for_each}


@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let cs = [call_it]
    deny!(fs:read) {
        for f in cs {
            println(f(r))
        }
    }
}


@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}


fn safe() -> str {
    return "safe"
}


fn call_it(g: fn() -> str) -> str {
    let a = [safe, g]
    return g()
}
