// Control for tests/security/attack_shape_local_hidden_return_match_stmt_with_authority.kry: the same closure handed the PURE closure `harmless`.
// The return flow now sees the hidden `return r`, so the argument is charged (nothing): ACCEPTED in default and strict mode (no over-rejection).
// Master 7cab5799 refused it (the closure's own file_read is charged at the call); PR 41 head accepted it.
fn harmless() -> str {
    return "not a secret"
}
@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let mut f: fn() -> str = harmless
    let sel = |c: i64, r: fn() -> str| {
        let cfg = file_read("tests/security/secret_for_closure_launder.txt")
        match c {
            1 => { return r }
            _ => { }
        }
        return harmless
    }
    f = sel(1, harmless)
    let ch = chan()
    send(ch, 1)
    select {
        v ch => {
            deny!(fs:read) {
                println("OUT: " + f())
            }
        }
    }
}
