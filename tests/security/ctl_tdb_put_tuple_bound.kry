// LEDGER items 119, 123: the tuple-parameter store reached through a generic trait bound.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
fn use_pt<T: Rn>(t: T, fns: [fn() -> str], g: fn() -> str) { t.put((fns, 1), g) }
trait Rn { fn put(self: Self, p: ([fn() -> str], i64), g: fn() -> str) { p.0[0] = g }
  fn go(self: Self, fns: [fn() -> str]) { let f = || "h"
    deny!(fs:read) { for f in fns { println("ok: " + f()) } } } }
struct R1 {}
impl Rn for R1 {}
@capabilities(fs:read)
fn main() { let r = safe
  let fns = [safe]
  use_pt(R1 {}, fns, r)
  R1 {}.go(fns) }
