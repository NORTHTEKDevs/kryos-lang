// SECURITY -- decoy-companion variant #5: the vulnerable call is a METHOD
// call (`runner.apply_third(...)`), with a receiver plus THREE array
// parameters (two decoys, one real) ahead of the callback. Confirms the
// `self`-offset index translation in `accumulate_hot_extra_caps` /
// `compute_hot_param_companions` stays correct with more than one non-`self`
// container argument.
//
// ACCEPTANCE: REJECTED (E0507) under both enforcement modes.

@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

struct Runner {}

impl Runner {
    fn apply_third(
        self: Runner,
        decoy_a: [fn() -> str],
        decoy_b: [fn() -> str],
        real: [fn() -> str],
        f: fn(fn() -> str) -> str,
    ) -> str {
        return f(real[0])
    }
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let mut real: [fn() -> str] = []
    real = push(real, reader)
    let decoy_a: [fn() -> str] = []
    let decoy_b: [fn() -> str] = []
    let runner = Runner {}
    deny!(fs:read) {
        let out = runner.apply_third(decoy_a, decoy_b, real, |c| c())
        println("DECOY-METHOD-RECEIVER LEAK: " + out)
    }
}
