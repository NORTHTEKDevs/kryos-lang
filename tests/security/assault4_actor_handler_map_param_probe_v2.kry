// Probe: an ACTOR HANDLER (always declaration-enforced per invariant 17,
// unlike an ordinary inferred function) receiving a map<str, fn()->str>
// PARAMETER built from a non-literal source elsewhere, then invoking an
// entry from it -- no deny!, actor declares NOTHING.
//
// RE-BASELINED 2026-11-01 (LEDGER items 69 and 70). The expectation this
// header used to state (REJECTED) was stale: AS WRITTEN this program is
// DELEGATION, not an escape. The sender, `main`, holds fs:read and is charged
// exactly [fs:read] for the message it sends, so running the privileged closure
// is within its authority. It is correctly ACCEPTED in the default mode (strict
// mode rejects it only because the unannotated `build_registry` must declare
// its own fs:read). The ESCAPING form is the same shape inside a deny!:
// tests/security/attack_map_param_alias_invoke_deny.kry, which the row layer now
// rejects (E0110) once a closure stored second widens the slot's row.

@capabilities(fs:read)
fn make_secret_reader() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn pure_tool() -> str {
    return "pure result"
}

fn build_registry() -> map<str, fn() -> str> {
    return {
        "pure": pure_tool,
        "secret": make_secret_reader(),
    }
}

actor ZeroCapDispatcher {
    fn run_it(self, reg: map<str, fn() -> str>, name: str) {
        let f = reg[name]
        let out = f()
        println("ACTOR-HANDLER-MAP-PARAM: " + out)
    }
}

@capabilities(fs:read)
fn main() {
    let reg = build_registry()
    let d = ZeroCapDispatcher()
    d.run_it(reg, "secret")
    sleep(100)
}
