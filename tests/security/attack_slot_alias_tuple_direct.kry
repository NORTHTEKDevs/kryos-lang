@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}
use std::iter::{for_each}
type Reg = [fn() -> str]
type Slot = (Reg, i64)
fn put(s: Slot, g: fn() -> str) { s.0[0] = g }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    put((fns, 1), r)
    deny!(fs:read) { for f in fns { println(f()) } }
}
