// LEDGER item 122 / 123: a call through a trait signature references every candidate: a dyn call reaches a default whose deny! iterates its parameter.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
trait Rn { fn go(self: Self, fns: [fn() -> str]) { let f = || "h"
  deny!(fs:read) { for f in fns { println("ok: " + f()) } } } }
struct R1 {}
impl Rn for R1 {}
@capabilities(fs:read)
fn main() { let r = safe
  let d: dyn Rn = R1 {}
  d.go([safe, r]) }
