// LEDGER item 122 / 123: a call through a trait signature references every candidate: the impl reached through self stores its argument in a global registry.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
let mut REG: [fn() -> str] = []
trait Mk { fn put(self: Self, f: fn() -> str)
  fn run(self: Self, f: fn() -> str) { let h = || "h"
    self.put(f)
    deny!(fs:read) { for h in REG { println("ok: " + h()) } } } }
struct Evil {}
impl Mk for Evil { fn put(self: Self, f: fn() -> str) { REG = push(REG, f) } }
@capabilities(fs:read)
fn main() { let r = safe
  Evil {}.run(r) }
