// LEDGER item 127 (shape layer; found by the item-77 wave while hunting the siblings of item 77, NOT FIXED).
// A top-level function returns a closure literal that uses TWO captured parameters, one called directly and one forwarded to a helper: `fn compose2(a, b) { return || { a() + run(b) } }`, `f = compose2(harmless, reader)`.
// The captured-parameter case of `resolve_closure_caps`'s `Lambda` arm picks ONE parameter (`own_params.iter().find`, a `HashSet`) and returns `DependsOnParam` for it, so the authority of the other one is dropped; here the direct call `a()` is the only one it sees.
// The deny! block sits in a `select` arm, which the row layer does not judge (LEDGER item 126, root R4), so the SHAPE layer is the only judge here.
// Master e2fbc46c: check rc=0 in default and strict mode, `kryos run` prints TOPSECRET-CLOSURE-9f8e7d6c5b4a (executed, three runs of three). With the arguments swapped (`compose2(reader, harmless)`) the program is rejected with E0507.
// A variant with both parameters called directly (`|| { b() + a() }`) is accepted or rejected from one run to the next on the same binary, because the choice depends on the iteration order of the set (measured).
// WANTED (when closed): rejected with E0507 in default and strict mode, and `kryos run` must not print the secret.
fn harmless() -> str {
    return "not a secret"
}
@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

fn run(h: fn() -> str) -> str {
    return h()
}
fn compose2(a: fn() -> str, b: fn() -> str) -> fn() -> str {
    return || { a() + run(b) }
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let f = compose2(harmless, reader)
    let ch = chan()
    send(ch, 1)
    select {
        v ch => {
            deny!(fs:read) {
                println("OUT: " + f())
            }
        }
    }
}
