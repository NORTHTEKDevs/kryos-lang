// Control for assault_round3_generic_accessor_field_call.kry: identical
// program, direct field access (no generic-accessor indirection). Should be
// REJECTED (E0507) to prove the indirection, not the scenario, is what
// (if anything) defeats the guard.
@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

struct Box {
    f: fn() -> str,
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let b = Box { f: reader }
    deny!(fs:read) {
        let leaked = b.f()
        println("CONTROL DIRECT LEAK (should not compile): " + leaked)
    }
}
