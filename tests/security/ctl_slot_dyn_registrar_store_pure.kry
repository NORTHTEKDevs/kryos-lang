// Twin of attack_slot_dyn_registrar_store.kry: the dyn method is handed only a PURE closure.
// Must stay ACCEPTED in the default and the strict mode (no over-rejection).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

trait Registrar {
    fn add(self: Self, reg: [fn() -> str], g: fn() -> str)
}
struct Impl1 {}
impl Registrar for Impl1 {
    fn add(self: Impl1, reg: [fn() -> str], g: fn() -> str) {
        reg[0] = g
    }
}
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let d: dyn Registrar = Impl1 {}
    let fns = [safe]
    d.add(fns, safe)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
