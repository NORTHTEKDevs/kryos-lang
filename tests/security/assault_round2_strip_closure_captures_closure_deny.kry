// ASSAULT round 2 (strip-the-row lens): a privileged closure captured by a
// second closure, which is itself captured by a THIRD closure (two layers
// of closure-capturing-closure), invoked inside deny!(fs:read).
//
// ACCEPTANCE: REJECTED (E0507) under both enforcement modes.

@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let wrapper = || reader()
    let outer_wrapper = || wrapper()
    deny!(fs:read) {
        let leaked = outer_wrapper()
        println("CLOSURE-CAPTURES-CLOSURE LEAK: " + leaked)
    }
}
