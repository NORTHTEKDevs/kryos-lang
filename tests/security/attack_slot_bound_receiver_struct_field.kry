@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}
use std::iter::{for_each}
trait Adder { fn add(self: Self, g: fn() -> str) }
struct Holder { reg: [fn() -> str] }
impl Adder for Holder {
    fn add(self: Holder, g: fn() -> str) { self.reg[0] = g }
}
fn use_it<A: Adder>(a: A, g: fn() -> str) { a.add(g) }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let h = Holder { reg: [safe] }
    use_it(h, r)
    let hs = [h]
    deny!(fs:read) {
        for_each(hs, |q: Holder| {
            for f in q.reg {
                println(f())
            }
        })
    }
}
