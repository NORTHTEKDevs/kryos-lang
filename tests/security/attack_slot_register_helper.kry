// LEDGER root R2 (stores: through a registration helper).
// `register(reg, name, handler)` builds `Plugin { run: f }` from its parameter. The helper's body stores its OWN parameter var in the field, so the caller's closure only reaches the field if the call replays that store.
// Master dcf72e93 accepts this in every mode (both capability layers miss it) and
// `kryos run` prints the secret. Must be REJECTED with E0110 ("capability `fs:read`
// is denied in this block") under inferred and strict, and `kryos run` must not
// print the secret.
use std::iter::{for_each}

@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

struct Plugin {
    name: str,
    run: fn() -> str,
}
fn register(reg: [Plugin], name: str, f: fn() -> str) -> [Plugin] {
    return push(reg, Plugin { name: name, run: f })
}

@capabilities(fs:read)
fn main() {
    let r = secret()
    let mut reg: [Plugin] = []
    reg = register(reg, "a", safe)
    reg = register(reg, "evil", r)
    deny!(fs:read) {
        for_each(reg, |q: Plugin| {
            println(q.run())
        })
    }
}
