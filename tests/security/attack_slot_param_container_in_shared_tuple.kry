@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

// item 119: the handed container sits in a tuple of arrays, the arrays nested.
fn put_n(t: ([[fn() -> str]], i64), g: fn() -> str) {
    t.0[0][0] = g
}

@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let fns = [safe]
    put_n(([fns], 1), r)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}