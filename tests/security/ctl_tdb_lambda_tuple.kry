// LEDGER item 119: a lambda with an annotated tuple parameter stores into the array inside it.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
trait Rn { fn go(self: Self, fns: [fn() -> str]) { let f = || "h"
  deny!(fs:read) { for f in fns { println("ok: " + f()) } } } }
struct R1 {}
impl Rn for R1 {}
@capabilities(fs:read)
fn main() { let r = safe
  let fns = [safe]
  let st = fn(p: ([fn() -> str], i64), g: fn() -> str) { p.0[0] = g }
  st((fns, 1), r)
  R1 {}.go(fns) }
