@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("data.txt")
}
fn safe() -> str {
    return "safe"
}
fn name_of(m: Map<str, fn() -> str>, g: fn() -> str) {
    println(len(m))
}
fn get_op() -> fn(Map<str, fn() -> str>, fn() -> str) {
    return name_of
}
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let op = get_op()
    let m: Map<str, fn() -> str> = {"a": safe}
    op(m, r)
    deny!(fs:read) {
        let h = m["a"]
        println(h())
    }
}
