@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("data.txt")
}
fn safe() -> str {
    return "safe"
}
fn run_all(reg: [fn() -> str], g: fn() -> str) {
    println(len(reg))
}
fn get_op() -> fn([fn() -> str], fn() -> str) {
    return run_all
}
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let op = get_op()
    let fns = [safe]
    op(fns, r)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
