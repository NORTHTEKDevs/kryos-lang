// finish-line trait-default-body-edaefeca/g07 (LEDGER item 123): the lambda a factory returns stores the closure the factory captured into the container it is called with.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
fn mk(g: fn() -> str) -> fn([fn() -> str]) { return fn(reg: [fn() -> str]) { reg[0] = g } }
trait Rn { fn go(self: Self, fns: [fn() -> str]) { let f = || "h"
  deny!(fs:read) { for f in fns { println("ok: " + f()) } } } }
struct R1 {}
impl Rn for R1 {}
@capabilities(fs:read)
fn main() { let r = safe
  let reg = [safe]
  let st = mk(r)
  st(reg)
  R1 {}.go(reg) }
