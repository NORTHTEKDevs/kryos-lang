// Twin of attack_slot_param_fn_value_map_of_ops.kry: the helper stores a PURE function, so nothing privileged reaches the deny! block.
// Must stay ACCEPTED in the default and the strict mode (no over-rejection).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn put(reg: [fn() -> str], g: fn() -> str) {
    reg[0] = g
}

// item 112, the storing helper is looked up in a map of operations.
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let ops: map<str, fn([fn() -> str], fn() -> str)> = {"put": put}
    let fns = [safe]
    let op = ops["put"]
    op(fns, safe)
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
