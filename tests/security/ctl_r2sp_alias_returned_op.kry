// finish-line cap:r2-storage-paths-9a451e31/c09_type_alias: the store helper is handed out by a factory as a function value and its parameter type is an alias of a tuple holding an alias of an array.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
type Reg = [fn() -> str]
type Slot = (Reg, i64)
fn put(s: Slot, g: fn() -> str) { s.0[0] = g }
fn get_op() -> fn(Slot, fn() -> str) { return put }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = safe
    let fns = [safe]
    let op = get_op()
    op((fns, 1), r)
    deny!(fs:read) { for f in fns { println("ok: " + f()) } }
}
