@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}
type Cb = fn() -> str
type Reg = [fn() -> str]
fn pick(c: Cb) -> Cb { return c }
fn count(s: Reg) -> i64 { return len(s) }
@capabilities(fs:read)
fn main() {
    let r = secret()
    let fns = [safe]
    let again = pick(r)
    println("picked")
    deny!(fs:read) { println(count(fns)) }
}
