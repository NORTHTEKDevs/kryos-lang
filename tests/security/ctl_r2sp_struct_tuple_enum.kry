// finish-line cap:r2-storage-paths-dd09d926/k11_struct_literal_inline_enum: the struct is the payload of an enum the helper matches on.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
struct S { t: ([fn() -> str], i64) }
enum E { A(S), B }
fn put(e: E, g: fn() -> str) { match e { A(s) => { s.t.0[0] = g } B() => { } } }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = safe
    let fns = [safe]
    put(E.A(S { t: (fns, 1) }), r)
    deny!(fs:read) { for f in fns { println("ok: " + f()) } }
}
