// CONTROL for `attack_dict_min1.kry`: identical shape, V=i64 instead of
// f64. Clean on BOTH backends (rc=0, correct output "ok" / "42"), 3/3
// AOT runs, 1/1 JIT run -- proves the crash is specific to Dict's generic
// V being a non-i64 type, not a general Dict/AOT defect.
use std::collections::{Dict}

fn main() {
    let mut d1: Dict<str, i64> = Dict.new()
    d1 = d1.set("pi", 42)
    println("ok")
    println(to_string(d1.get("pi")))
}
