// Control for the declaration-order family (LEDGER items 124 and 125): the two-hop store relay of attack_fwd_store_relay_two_hop.kry, but every closure pushed is pure.
// `h1` is declared above `h2`, both above `main`. Accepted and printing "safe" in every order (the order-independence pin re-checks it).
struct Plugin {
    name: str,
    run: fn() -> str,
}

fn safe() -> str {
    return "safe"
}

fn h1(reg: [Plugin], name: str, f: fn() -> str) -> [Plugin] {
    return h2(reg, name, f)
}

fn h2(reg: [Plugin], name: str, f: fn() -> str) -> [Plugin] {
    return push(reg, Plugin { name: name, run: f })
}

fn main() {
    let mut reg: [Plugin] = []
    reg = h1(reg, "a", safe)
    reg = h1(reg, "b", safe)
    deny!(fs:read) {
        for q in reg {
            println(q.run())
        }
    }
}
