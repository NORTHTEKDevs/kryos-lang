// LEDGER root R2, revise round of PR 38 (found by the author while closing the verifier's finding).
// A callee returns a LAMBDA that builds the container from the captured parameter.
// Master dcf72e93: accepted in every mode (check rc=0, default and strict) and `kryos run` prints the secret (executed).
// First R2 build (PR head dbfb989d): accepted in every mode (check rc=0, default and strict) and `kryos run` prints the secret (executed).
// Must be REJECTED with E0110 ("capability `fs:read` is denied in this block") under inferred and strict,
// and `kryos run` must not print the secret.
use std::iter::{for_each}

@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

fn make(g: fn() -> str) -> fn() -> [fn() -> str] {
    return || [safe, g]
}

@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let mk = make(r)
    let fns = mk()
    deny!(fs:read) {
        for f in fns {
            println(f())
        }
    }
}
