// one getter called for two arrays: the result of each call is the array that call was given.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
fn id(a: [fn() -> str]) -> [fn() -> str] { return a }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = secret()
    let a1 = [safe]
    let a2 = [safe]
    let b1 = id(a1)
    let b2 = id(a2)
    b1[0] = r
    deny!(fs:read) { for f in b2 { println("ok: " + f()) } }
}
