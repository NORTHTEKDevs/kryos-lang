// Same shape as assault4_actor_handler_map_param_probe_v2.kry, but with
// build_registry ALSO properly annotated (fs:read), so under
// --strict-capabilities the only remaining question is whether the
// ACTOR HANDLER's own container-parameter invocation is gated -- isolated
// from the (correct, unrelated) "build_registry must self-declare"
// rejection the previous strict-mode run actually tripped on.
//
// RE-BASELINED 2026-11-01 (LEDGER items 69 and 70): AS WRITTEN this program is
// DELEGATION and is correctly ACCEPTED in every mode. The sender, `main`, holds
// fs:read and is charged exactly [fs:read] for the message it sends. The
// ESCAPING form is the same alias read inside a deny!:
// tests/security/attack_array_param_alias_invoke_deny.kry (array) and
// tests/security/attack_map_param_alias_invoke_deny.kry (map), both rejected by
// the row layer (E0110) now that a closure stored second widens the slot's row.

@capabilities(fs:read)
fn make_secret_reader() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn pure_tool() -> str {
    return "pure result"
}

@capabilities(fs:read)
fn build_registry() -> map<str, fn() -> str> {
    return {
        "pure": pure_tool,
        "secret": make_secret_reader(),
    }
}

actor ZeroCapDispatcher {
    fn run_it(self, reg: map<str, fn() -> str>, name: str) {
        let f = reg[name]
        let out = f()
        println("STRICT-ACTOR-HANDLER-MAP-PARAM: " + out)
    }
}

@capabilities(fs:read)
fn main() {
    let reg = build_registry()
    let d = ZeroCapDispatcher()
    d.run_it(reg, "secret")
    sleep(100)
}
