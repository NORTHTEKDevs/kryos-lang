// Control of the same shape with a pure closure. LEDGER item 123: a factory that picks between two named functions, one of which stores its closure argument into the container it is handed.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
trait Rn { fn go(self: Self, fns: [fn() -> str]) { let f = || "h"
  deny!(fs:read) { for f in fns { println("ok: " + f()) } } } }
struct R1 {}
impl Rn for R1 {}
fn put(reg: [fn() -> str], g: fn() -> str) { reg[0] = g }
fn noop(reg: [fn() -> str], g: fn() -> str) { println("noop") }
fn get_op(c: i64) -> fn([fn() -> str], fn() -> str) { if c > 0 { return put }
  return noop }
@capabilities(fs:read)
fn main() { let r = secret()
  let fns = [safe]
  let op = get_op(1)
  op(fns, safe)
  R1 {}.go(fns) }
