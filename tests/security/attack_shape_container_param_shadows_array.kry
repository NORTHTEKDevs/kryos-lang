// LEDGER item 132, shape layer (found by the revise round of PR 41 while writing the precision fix; a sibling of item 77; NOT FIXED on 1.3.0).
// The pristine array `items` is shadowed inside the closure `run` by its own parameter of the same name, which holds the privileged closure: `run([reader, harmless])`.
// Master 7cab5799: check rc=0 in default and strict mode, `kryos run` prints TOPSECRET-CLOSURE-9f8e7d6c5b4a (executed); PR 41 head 364d2e44 rejects it (E0507, the read was Unknown).
// The deny! block sits in a `select` arm, which the row layer does not judge (LEDGER item 126, root R4), so the SHAPE layer is the only judge here.
// WANTED (when closed): rejected with E0507 or E0110 in default and strict mode, and `kryos run` must not print the secret. A candidate fix (PR 41) was deferred past 1.3.0.
fn harmless() -> str {
    return "not a secret"
}
@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

fn other() -> str {
    return "other"
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let mut f: fn() -> str = harmless
    let items = [harmless, other]
    let id = |g: fn() -> str| { g }
    let run = |items: [fn() -> str]| { id(items[0]) }
    f = run([reader, harmless])
    let ch = chan()
    send(ch, 1)
    select {
        v ch => {
            deny!(fs:read) {
                println("OUT: " + f())
            }
        }
    }
}
