// finish-line cap:r2-storage-paths-9a451e31/d02_alias_plain_array: a `type` alias over an array of closures is the parameter type of a store helper; the alias carried one row var shared by every use, so no call freshened it and the helper's store was never recorded.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
type Reg = [fn() -> str]
fn put(s: Reg, g: fn() -> str) { s[0] = g }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = safe
    let fns = [safe]
    put(fns, r)
    deny!(fs:read) { for f in fns { println("ok: " + f()) } }
}
