// a getter that returns the array inside a tuple.
@capabilities(fs:read)
fn secret() -> fn() -> str { return || file_read("tests/security/secret_for_closure_launder.txt") }
fn safe() -> str { return "safe" }
fn pair(a: [fn() -> str]) -> ([fn() -> str], i64) { return (a, 1) }
fn add(a: [fn() -> str], g: fn() -> str) { let p = pair(a)
    p.0[0] = g }
@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let r = safe
    let fns = [safe]
    add(fns, r)
    deny!(fs:read) { for f in fns { println("ok: " + f()) } }
}
