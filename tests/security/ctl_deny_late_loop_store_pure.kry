// LEDGER root R3 (the deny! verdict is taken when the module is done). item 120 (store after the block in a loop) twin: the loop pushes a pure closure.
// Must stay ACCEPTED in the default and the strict mode (no over-rejection).
@capabilities(fs:read)
fn secret() -> fn() -> str {
    return || file_read("tests/security/secret_for_closure_launder.txt")
}

fn safe() -> str {
    return "safe"
}

@capabilities(fs:read)
fn main() {
    let f = || "harmless"
    let mut fns = [safe]
    let mut i = 0
    while i < 2 {
        deny!(fs:read) {
            for f in fns {
                println(f())
            }
        }
        fns = push(fns, safe)
        i = i + 1
    }
}
