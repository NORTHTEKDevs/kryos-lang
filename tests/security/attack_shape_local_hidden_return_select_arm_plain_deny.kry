// LEDGER item 130, shape layer (found by the independent verifier of PR 41; introduced by that PR's own return flow, closed in its revise round).
// A local closure that does its own privileged work and returns its parameter from a `select` ARM inside its own body: `f = sel(reader)`.
// Root: `collect_return_exprs` listed the returns of if / for / while / try bodies only, so a `return` in this position was invisible and the return flow charged the call nothing.
// Master 7cab5799: REJECTED (E0507), by accident: the call through the closure was charged what INVOKING it needs (fs:read, from its own file_read), not what it returns.
// PR 41 head 364d2e44: check rc=0 in default and strict mode, `kryos run` prints TOPSECRET-CLOSURE-9f8e7d6c5b4a (executed).
// The deny! block is in ORDINARY position (no select around it): no item-126 placement is needed for the leak. The row layer does not follow a return out of a select arm either (item 126).
// Must be REJECTED with E0507 in default and strict mode, and `kryos run` must not print the secret.
fn harmless() -> str {
    return "not a secret"
}
@capabilities(fs:read)
fn make_secret_reader(path: str) -> fn() -> str {
    return || file_read(path)
}

@capabilities(fs:read)
fn main() {
    let reader = make_secret_reader("tests/security/secret_for_closure_launder.txt")
    let mut f: fn() -> str = harmless
    let sel = |r: fn() -> str| {
        let cfg = file_read("tests/security/secret_for_closure_launder.txt")
        let c2 = chan()
        send(c2, 1)
        select {
            v c2 => { return r }
        }
        return harmless
    }
    f = sel(reader)
    deny!(fs:read) {
        println("OUT: " + f())
    }
}
