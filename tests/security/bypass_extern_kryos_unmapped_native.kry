// THREAT-MODEL.md section 4.5, row B4 (not an escape_status.sh row).
// An `extern` block that names a `kryos_*` runtime native the capability table
// does not map (required_capability_for_native_symbol, default arm) needs no
// `ffi`. kryos_ffi_cstr and kryos_ffi_read_i8 exist in the shipped runtime and
// read arbitrary memory; kryos_ffi_dlopen / dlsym / dlcall* and kryos_db_* are
// reachable the same way (not committed here: they are not portable or leave
// files behind). `extern "C" { fn getpid() }` is still rejected (E0506/E0508, G7).
//
// kryos 1.2.0 at dbfb989d: `kryos check` rc=0 in default and
// --strict-capabilities mode, and `kryos run` prints BYPASS-B4-OK (executed
// 2026-11-01).
extern "C" {
    fn kryos_ffi_cstr(s: str) -> i64
    fn kryos_ffi_read_i8(p: i64) -> i64
}

fn main() {
    let p = kryos_ffi_cstr("BYPASS-B4-OK")
    let mut out = ""
    let mut i = 0
    while i < 12 {
        out = out + char_from(kryos_ffi_read_i8(p + i))
        i = i + 1
    }
    println(out)
}
