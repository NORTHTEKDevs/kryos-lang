// A tuple of narrow integers flowing into a tuple slot of wider integers must
// read back the same values on both backends.
fn f() -> (i64, i64) { let a: i32 = 1  let b: i32 = 2  return (a, b) }
fn g() -> [(i64, i64)] { let a: i32 = 3  let b: i32 = 4  return [(a, b)] }
fn mk() -> (i32, i32) { return (5, 6) }
fn mk2() -> (i64, i8) { let a: i64 = 300  let b: i8 = -5  return (a, b) }
fn neg() -> (i64, i64) { let a: i32 = -7  let b: u8 = 200  return (a, b) }
fn pick(c: bool) -> (i64, i64) {
    let a: i32 = 8
    let b: i32 = 9
    if c { return (a, b) }
    return (b, a)
}
fn main() {
    let t = f()
    println("{t.0} {t.1}")
    let u = g()
    println("{u[0].0} {u[0].1}")
    let v: (i64, i64) = mk()
    println("{v.0} {v.1}")
    let w: [(i64, i64)] = [mk(), mk()]
    println("{w[0].0} {w[0].1} {w[1].0} {w[1].1} {len(w)}")
    let x = mk2()
    println("{x.0} {x.1}")
    let y = neg()
    println("{y.0} {y.1}")
    let p = pick(true)
    let q = pick(false)
    println("{p.0} {p.1} {q.0} {q.1}")
    let (m, n) = f()
    println("{m + n}")
}
