// Pin (finish item A20): the index of the written element is an expression (`i % 2`,
// `len(arr) - 1`), and a tuple is copied in a loop, many times, with heap elements.
fn main() {
    let base = (1, "base-string-0123456789")
    let mut arr = [(0, "z-0123456789"), (1, "y-0123456789")]
    let mut seen = 0
    for i in 0..6 {
        let e = arr[i % 2]
        arr[i % 2].0 = i + 10
        seen = seen + e.0
    }
    println("seen {seen} arr {arr[0].0} {arr[1].0}")
    let u = base
    push(arr, u)
    arr[len(arr) - 1].0 = 9
    println("base {base.0} u {u.0} last {arr[len(arr) - 1].0}")
    let mut total = 0
    for i in 0..2000 {
        let mut c = base
        c.0 = i
        c.1 = "c{i}-0123456789"
        let mut d = c
        d.0 = d.0 + 1
        total = total + base.0 + c.0 + d.0
    }
    println("total {total} base {base.0} {base.1}")
}
