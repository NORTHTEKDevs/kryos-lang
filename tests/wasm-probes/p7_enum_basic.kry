enum Shape {
    Circle(i64),
    Rect(i64, i64),
    Empty,
}
fn area(s: Shape) -> i64 {
    match s {
        Circle(r) => 3 * r * r,
        Rect(w, h) => w * h,
        Empty => 0,
    }
}
fn main() {
    println(to_string(area(Circle(2))))
    println(to_string(area(Rect(3, 4))))
    println(to_string(area(Shape.Empty)))
}
