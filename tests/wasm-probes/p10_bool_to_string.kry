// Regression (cert Pass 42): to_string(bool) / println(bool) / bool
// interpolation on wasm rendered the raw i64 encoding (1/0) instead of
// true/false for bools produced by ordinary (non-closure) function logic.
fn is_even(n: i64) -> bool {
    if n == 0 { return true }
    return is_odd(n - 1)
}

fn is_odd(n: i64) -> bool {
    if n == 0 { return false }
    return is_even(n - 1)
}

fn main() {
    println(to_string(is_even(10)))
    println(to_string(is_even(7)))
    println(to_string(is_odd(4)))
    let flag = is_even(2)
    println(flag)
    println("interp {flag} {is_odd(3)}")
}
