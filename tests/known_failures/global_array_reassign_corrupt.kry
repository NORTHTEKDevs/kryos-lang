// Minimal repro for ledger item 2b: a top-level `let mut [T]` global works
// fine when only ever WRITTEN via push() from one call chain rooted at its
// own initializer, but corrupts when one function REASSIGNS it to a fresh
// value and a DIFFERENT function later reads/pushes it.
//
// Expected: "len=3"
// Actual (release AOT): panics --
//   kryos panic: kryos_array_push: corrupt array header @ ...
//   (len=0, cap=0, elem_size=8, ref_count=1, data=0x0)
//
// kryos build --release tests/known_failures/global_array_reassign_corrupt.kry -o /tmp/x && /tmp/x

struct Item {
    v: i64
}

let mut G: [Item] = []

fn reset() {
    let empty: [Item] = []
    G = empty
}

fn add_one(n: i64) {
    let it = Item { v: n }
    G = push(G, it)
}

fn main() {
    reset()
    add_one(1)
    add_one(2)
    add_one(3)
    println("len=" + to_string(len(G)))
}
