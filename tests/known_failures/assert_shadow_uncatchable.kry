// Minimal repro for ledger item 2c: `std::test::assert`'s 2-arg form
// (`assert(condition: bool, msg: str) -> void`, documented "Throws with the
// message if false") is PERMANENTLY SHADOWED by the compiler's own hardcoded
// 2-arg `assert` INTRINSIC. Both codegen backends dispatch any call literally
// named `assert` with a nonzero arg count straight to
// `kryos_builtin_assert` (which prints and calls `process::abort()` --
// never returns) BEFORE the generic "does the user define a function with
// this exact name" shadow-check that every other builtin already goes
// through. So the stdlib body never runs, and a `throw` inside a `try` never
// gets a chance to unwind to its `catch` -- the process just aborts.
//
// Expected (if `std::test::assert` actually ran, matching its doc comment):
//   before
//   caught: assertion failed: boom
//   after try/catch (should print -- assert should have been CAUGHT)
//
// Actual:
//   before
//   assertion failed: boom          (stderr, NO "kryos: uncaught exception:"
//                                     prefix -- proves it's process::abort(),
//                                     not throw)
//   process aborts; catch (e) never runs; "after ..." never prints.
//
// kryos run tests/known_failures/assert_shadow_uncatchable.kry

use std::test::{assert}

fn main() {
    println("before")
    try {
        assert(false, "boom")
        println("unreachable")
    } catch (e) {
        println("caught: " + e)
    }
    println("after try/catch (should print -- assert should have been CAUGHT)")
}
