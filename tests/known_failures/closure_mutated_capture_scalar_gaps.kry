// KNOWN FAILURE: mutated-SCALAR-capture persistence only covers the single
// narrowest case (exactly one mutated capture whose closure body's tail
// value IS that identifier). CLAUDE.md gotcha #11 documents the STRUCT case
// as fully generalized to N>=2 captures (`mutated_capture_ptr_slots`); the
// scalar (i64/f64/bool) case never got the same treatment. Three distinct
// shapes below, all silently WRONG (no diagnostic), all identical on both
// backends (kryos run and kryos build --release).
//
// Root cause (kryos-mir/src/lower.rs, lambda lowering): a mutated capture
// only gets a persistent env-slot write-back when
// `mutated_captures.len() == 1 && tail_value_is_identifier(body, name)` --
// the mechanism smuggles the new state back through the CALL'S RETURN VALUE,
// which only works when there is exactly one mutated capture and it IS the
// return value. The struct fix instead passes the capture BY POINTER (no
// such restriction needed), but that mechanism was never extended to
// scalars, which are plain SSA values with no address to hand out today.
//
//     kryos run tests/known_failures/closure_mutated_capture_scalar_gaps.kry
//     kryos build --release tests/known_failures/closure_mutated_capture_scalar_gaps.kry -o /tmp/x && /tmp/x

struct Ctr { base: i64 }

fn main() {
    // Shape 1: two mutated SCALAR captures in one closure. Expected (if each
    // persisted independently across calls): 1010, 2020, 3030. Actual: 1010,
    // 1010, 1010 -- both freeze at their first-call value forever.
    let mut a: i64 = 0
    let mut b: i64 = 0
    let bump2 = || {
        a = a + 1
        b = b + 10
        return a * 1000 + b
    }
    println("shape1 (want 1010,2020,3030): {to_string(bump2())},{to_string(bump2())},{to_string(bump2())}")

    // Shape 2: one mutated scalar + one mutated struct field in the SAME
    // closure. The struct persists correctly (101,102,103); the scalar
    // freezes at 1 forever instead of climbing 1,2,3. Expected combined sum
    // per call: 102, 104, 106. Actual: 102, 103, 104 (scalar contributes 1
    // every time instead of climbing).
    let mut scalar_cap: i64 = 0
    let mut struct_cap = Ctr { base: 100 }
    let bump_mixed = || {
        scalar_cap = scalar_cap + 1
        struct_cap.base = struct_cap.base + 1
        return scalar_cap + struct_cap.base
    }
    println("shape2 (want 102,104,106): {to_string(bump_mixed())},{to_string(bump_mixed())},{to_string(bump_mixed())}")

    // Shape 3: a SOLITARY mutated scalar capture, but the closure's tail
    // value is NOT literally that identifier (it returns a DIFFERENT
    // closure built from it) -- a common "stateful factory" idiom. Expected:
    // successive calls to `make` see count=1, then count=2. Actual: both
    // calls see count=1 -- `make`'s own mutation of `count` never persists
    // across calls to `make` because `make`'s tail is `return inner`, not
    // `count`.
    let mut count: i64 = 0
    let make = |tag: str| {
        count = count + 1
        let n: i64 = count
        let inner = || n
        return inner
    }
    let c1 = make("a")
    let c2 = make("b")
    println("shape3 (want 1,2): {to_string(c1())},{to_string(c2())}")
}
