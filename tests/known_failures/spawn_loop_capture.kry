enum Msg { Val(i64), Nothing, }
fn main() {
    let ch7 = chan()
    let mut k = 0
    while k < 4 {
        let mk = Msg.Val(k * 10)
        spawn {
            match mk {
                Msg.Val(v) => send(ch7, v),
                Msg.Nothing => send(ch7, -1),
            }
        }
        k = k + 1
    }
    let mut got = 0
    while got < 4 {
        println("got {recv(ch7)}")
        got = got + 1
    }
}
