fn main() {
    let mut r = 0
    while r < 8 {
        let mut i = 0
        let mut acc = 0
        while i < 100000 {
            let mut xs: [i64] = [i, i + 1]
            xs = push(xs, i * 2)
            acc = acc + xs[2]
            i = i + 1
        }
        println("r{r} {acc}")
        r = r + 1
    }
}
