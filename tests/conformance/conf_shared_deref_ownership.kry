// Conformance (LEDGER item 137): `*s` of a `shared` struct is an ALIAS of the
// arc's contents, so a consumer that keeps it must take its own owner, and a
// list walked with `cur = (*n).next` must hold its own reference to what it
// steps onto. Each probe binds, returns or walks the value, churns the
// allocator so freed blocks are REUSED, then reads it. Before the arc freed
// its contents these read stale or double-freed memory only once the arc was
// freed; the probes pin the owner taken at each read.
// Run under KRYOS_FREE_DIAG on both backends, and on AOT with real frees, by
// tests/no_double_free.sh.
use std::option::{Option}

struct P { name: str, n: i64 }
struct L { next: Option<shared L>, v: i64, name: str }

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn mk_p(i: i64) -> P { return P { name: "name-" + to_string(i) + "-padpadpad", n: i } }
fn mk(v: i64) -> L { return L { next: None(), v: v, name: "node-" + to_string(v) + "-padpad" } }

fn build(n: i64) -> Option<shared L> {
    let mut head: Option<shared L> = None()
    let mut i = 0
    while i < n {
        let nd = L { next: head, v: i, name: "node-" + to_string(i) + "-padpad" }
        head = Some(shared nd)
        i = i + 1
    }
    return head
}

fn churn(k: i64) -> i64 {
    let mut a = 0
    let mut j = 0
    while j < 20 {
        let t = "c-" + to_string(k + j) + "-pad-pad-pad-pad"
        let n: shared L = shared mk(k + j)
        a = a + len(t) + (*n).v
        j = j + 1
    }
    return a
}

fn sum(o: Option<shared L>) -> i64 {
    let mut cur = o
    let mut s = 0
    let mut guard = 0
    while guard < 1000 {
        match cur {
            Option.Some(n) => {
                s = s + (*n).v + len((*n).name)
                cur = (*n).next
            },
            Option.None => { return s },
        }
        guard = guard + 1
    }
    return s
}

fn copy_out(o: Option<shared L>) -> L {
    match o {
        Option.Some(n) => {
            let x = *n
            return x
        },
        Option.None => { return mk(-1) },
    }
}

fn deref_ret(o: Option<shared L>) -> L {
    match o {
        Option.Some(n) => { return *n },
        Option.None => { return mk(-1) },
    }
}

struct W { inner: P, k: i64 }

fn show(p: P) -> i64 { return len(p.name) + p.n }

// every consumer that keeps `*a`: push, a struct literal field, a variant
// payload, a reassignment; the arc is dropped before the copies are read
fn keep_all(i: i64) -> i64 {
    let mut arr: [P] = []
    let mut y = mk_p(1000)
    let w: W = W { inner: mk_p(0), k: 0 }
    let mut o: Option<P> = None()
    let mut w2 = w
    if i >= 0 {
        let a: shared P = shared mk_p(i)
        arr = push(arr, *a)
        arr = push(arr, *a)
        w2 = W { inner: *a, k: i }
        o = Some(*a)
        y = *a
    }
    let k = churn(i)
    let want = "name-" + to_string(i) + "-padpadpad"
    expect(arr[0].name == want, "push 0 " + arr[0].name)
    expect(arr[1].name == want, "push 1 " + arr[1].name)
    expect(w2.inner.name == want, "literal " + w2.inner.name)
    expect(y.name == want, "assign " + y.name)
    let mut got = 0
    match o {
        Option.Some(q) => {
            expect(q.name == want, "variant " + q.name)
            got = len(q.name)
        },
        Option.None => { expect(false, "variant lost") },
    }
    return k + got + y.n + w2.k
}

fn main() {
    let mut i = 0
    let mut total = 0
    while i < 40 {
        // a local copy of the arc's struct, the arc dropped later
        let a: shared P = shared mk_p(i)
        let x = *a
        let k1 = churn(i)
        expect(x.name == "name-" + to_string(i) + "-padpadpad", "let copy " + x.name)
        expect(x.n == i, "let copy n")
        expect((*a).name == x.name, "arc still intact")

        // the walk steps onto each node through `(*n).next`
        let w = sum(build(20))
        let k2 = churn(i + 1)
        expect(w == 460, "walk " + to_string(w))

        // copies returned out of the arc, the list dropped before the read
        let c = copy_out(build(5))
        let k3 = churn(i + 2)
        expect(c.v == 4, "copy_out v " + to_string(c.v))
        expect(c.name == "node-4-padpad", "copy_out name " + c.name)
        let d = deref_ret(build(6))
        let k4 = churn(i + 3)
        expect(d.v == 5, "deref_ret v " + to_string(d.v))
        expect(d.name == "node-5-padpad", "deref_ret name " + d.name)
        let kept = keep_all(i)
        let ap: shared P = shared mk_p(i + 500)
        expect(show(*ap) == len("name-" + to_string(i + 500) + "-padpadpad") + i + 500, "borrowed arg")
        total = total + k1 + k2 + k3 + k4 + w + kept
        i = i + 1
    }
    println("shared deref ownership ok " + to_string(total))
}
