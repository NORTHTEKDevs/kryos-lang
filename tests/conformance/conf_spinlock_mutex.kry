// Conformance: SpinLock provides real mutual exclusion under concurrent
// threads. The old AtomicBool load-then-store test-and-set raced (two threads
// entered the critical section), losing counter updates; AtomicInt CAS fixes
// it. 8 threads x 2000 protected increments must total exactly 16000.
use std::sync::{spin_lock, atomic_int, wait_group, once}
fn main() {
    let lock = spin_lock()
    let counter = atomic_int(0)
    let wg = wait_group()
    wg.add(8)
    let mut t = 0
    while t < 8 {
        spawn {
            let mut i = 0
            while i < 2000 {
                let l = lock.lock()
                let old = counter.load()
                counter.store(old + 1)
                l.unlock()
                i = i + 1
            }
            wg.done()
        }
        t = t + 1
    }
    wg.wait()
    if counter.load() != 16000 {
        println("FAIL: spinlock lost updates, got " + to_string(counter.load()))
        exit(1)
    }

    // Once.call_once under contention must run the callback EXACTLY once. The
    // old load()-then-toggle() was a non-atomic check-then-act: k threads that
    // all read the flag unset before any toggled each flipped it, and toggle()
    // flips unconditionally, so a racer flipped it back and another re-ran the
    // callback (fired 2-4x). A barrier lines the threads up on the load/toggle
    // window; AtomicInt compare_and_swap(0,1) makes exactly one thread win.
    let o = once()
    let runs = atomic_int(0)
    let gate = atomic_int(0)
    let owg = wait_group()
    owg.add(64)
    let mut k = 0
    while k < 64 {
        spawn {
            while gate.load() == 0 { }
            o.call_once(|| { runs.fetch_add(1)  return "" })
            owg.done()
        }
        k = k + 1
    }
    sleep(100)
    gate.store(1)
    owg.wait()
    if runs.load() != 1 {
        println("FAIL: Once ran callback " + to_string(runs.load()) + " times, expected 1")
        exit(1)
    }
    if o.is_done() == false {
        println("FAIL: Once.is_done() false after call_once")
        exit(1)
    }

    println("conformance spinlock mutex: PASS")
}
