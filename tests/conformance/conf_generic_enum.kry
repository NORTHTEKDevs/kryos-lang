// Conformance: a NULLARY variant of a user-defined GENERIC enum used against an
// explicit concrete type. `Box.Empty` (dot-namespace form) always produced an
// empty generics list, so it typed as bare `Box` (0 generics) and could not
// unify with `Box<i64>` (1 generic) -> false E0100. Option/Result::None are a
// distinct special-cased Type variant, so they never hit this. The enum-
// namespace branch now instantiates fresh generic vars matching the enum's
// arity, like every other variant-reference path. (Self-referential recursive
// generic enums like List<T> additionally work on AOT; the Cranelift-JIT
// runtime for them is a separate follow-up, so this file uses a non-recursive
// generic enum to stay clean on both backends.)

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

enum Box<T> {
    Empty,
    Full(T),
}

fn describe(b: Box<i64>) -> str {
    match b {
        Empty => return "empty",
        Full(v) => return "full:" + to_string(v),
    }
}

fn make_empty() -> Box<i64> {
    return Box.Empty
}

enum List<T> {
    Nil,
    Cons(T, List<T>),
}

enum Tree<T> {
    Leaf,
    Node(T, Tree<T>, Tree<T>),
}

fn lsum(l: List<i64>) -> i64 {
    match l {
        Nil => return 0,
        Cons(h, t) => return h + lsum(t),
    }
}

fn ljoin(l: List<str>) -> str {
    match l {
        Nil => return "",
        Cons(h, t) => return h + ljoin(t),
    }
}

fn tsum(t: Tree<i64>) -> i64 {
    match t {
        Leaf => return 0,
        Node(v, l, r) => return v + tsum(l) + tsum(r),
    }
}

fn main() {
    // Nullary variant against a let annotation, both spellings.
    let e: Box<i64> = Box.Empty
    let e2: Box<i64> = Box::Empty
    let f: Box<i64> = Box.Full(42)
    expect(describe(e) == "empty", "nullary generic-enum variant Box.Empty (dot)")
    expect(describe(e2) == "empty", "nullary generic-enum variant Box::Empty (colon)")
    expect(describe(f) == "full:42", "generic-enum payload variant")

    // Nullary variant from a fn return type.
    expect(describe(make_empty()) == "empty", "nullary generic-enum variant from fn return")

    // Different instantiation (Box<str>) in the same program -- no contamination.
    let s: Box<str> = Box.Empty
    match s {
        Empty => expect(true, "Box<str>.Empty"),
        Full(v) => expect(false, "Box<str> unexpected Full"),
    }
    let sf: Box<str> = Box.Full("hi")
    match sf {
        Empty => expect(false, "Box<str> unexpected Empty"),
        Full(v) => expect(v == "hi", "Box<str>.Full payload"),
    }

    // Self-referential generic enums (the fundamental recursive-data pattern).
    // The enum drop-glue GENERATOR on both backends recursed on itself at
    // codegen time for a monomorphized enum whose variant holds its own type
    // (List___i64's Cons holding List___i64) -> Cranelift stack-overflowed at
    // `kryos run` and the bare-constructor shape crashed `kryos build` itself.
    // Nested Struct/Enum field drops now route through the memoized named
    // __kryos_drop_<Name> helpers (bounded by real runtime depth).
    let l: List<i64> = Cons(1, Cons(2, Cons(3, Cons(4, Nil))))
    expect(lsum(l) == 10, "recursive generic enum List<i64> traversal")
    let ls: List<str> = Cons("a", Cons("b", Cons("c", Nil)))
    expect(ljoin(ls) == "abc", "recursive generic enum List<str> traversal")
    let t: Tree<i64> = Node(1, Node(2, Leaf, Leaf), Node(3, Leaf, Node(4, Leaf, Leaf)))
    expect(tsum(t) == 10, "recursive generic enum Tree<i64> traversal")
    // Bare constructor with no match on the type (crashed the COMPILER).
    let bare: List<i64> = Cons(9, List.Nil)
    expect(true, "bare recursive-generic-enum constructor compiles + runs")

    println("conformance generic-enum: PASS")
}
