// Conformance: generic ASSOCIATED (no-self) functions -- constructors like
// `Box.new(v)` on a generic struct/enum -- must instantiate their type
// parameter FRESH per call site (bound from the argument types), and must
// monomorphize a distinct specialized body per concrete instantiation on AOT
// (the LLVM struct type Box___i64 = {i64} differs from Box___str = {ptr}).
// Previously: the type checker locked T to the first call site (E0100 on the
// second at a different type), and even once accepted, AOT built a single copy
// -> `%_1 defined with type %Box___i64 but expected %Box___str`. Fixed by a
// per-call instantiate_sig in the checker + a GenericImplFnTemplate /
// monomorphize_impl_fn path in MIR lowering, mirroring generic free functions.

use std::option::{Option, Some, None}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

struct Box<T> {
    value: T,
}

impl<T> Box<T> {
    fn new(v: T) -> Box<T> {
        return Box { value: v }
    }
}

struct Pair<A, B> {
    first: A,
    second: B,
}

impl<A, B> Pair<A, B> {
    fn make(a: A, b: B) -> Pair<A, B> {
        return Pair { first: a, second: b }
    }
}

enum Maybe<T> {
    Just(T),
    Nothing,
}

impl<T> Maybe<T> {
    fn wrap(v: T) -> Maybe<T> {
        return Just(v)
    }
}

fn main() {
    // Same associated fn at three concrete types in one program.
    let bi: Box<i64> = Box.new(42)
    let bs: Box<str> = Box.new("hello")
    let bf: Box<f64> = Box::new(2.5)
    expect(bi.value == 42, "Box.new<i64>")
    expect(bs.value == "hello", "Box.new<str> (fresh instantiation, not locked to i64)")
    expect(bf.value > 2.4 and bf.value < 2.6, "Box::new<f64> (colon spelling)")

    // Multi-param associated fn at two different (A,B) pairs.
    let p1: Pair<i64, str> = Pair.make(7, "seven")
    let p2: Pair<str, i64> = Pair::make("eight", 8)
    expect(p1.first == 7 and p1.second == "seven", "Pair.make<i64,str>")
    expect(p2.first == "eight" and p2.second == 8, "Pair::make<str,i64>")

    // Enum-constructing associated fn (Just(v) inside the method body must
    // monomorphize per instantiation), matched at TWO instantiations in one
    // scope with concrete payload constraints. This also regresses a checker
    // bug where the enum's declaration-time generic Type::Var was shared across
    // matches: the first match (Maybe<i64>, v==99) permanently bound it to i64,
    // so the second (Maybe<str>, v=="z") failed E0100. The pattern payload now
    // instantiates fresh per match from the scrutinee's concrete type args.
    let mi: Maybe<i64> = Maybe.wrap(99)
    let ms: Maybe<str> = Maybe.wrap("z")
    match mi {
        Just(v) => expect(v == 99, "Maybe.wrap<i64> match"),
        Nothing => expect(false, "Maybe.wrap<i64> took Nothing"),
    }
    match ms {
        Just(v) => expect(v == "z", "Maybe.wrap<str> match (payload not locked to i64)"),
        Nothing => expect(false, "Maybe.wrap<str> took Nothing"),
    }

    println("conformance generic-ctor: PASS")
}
