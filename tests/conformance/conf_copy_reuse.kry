// Conformance: a Copy-typed local inferred from an UNANNOTATED generic builtin
// return (`let a = pop(arr)`) must be classified Copy so reusing it does NOT
// spuriously trip error[E0300]. Previously the ownership analysis' Copy check
// had no case for pop's generic `-> T` return and defaulted to non-Copy, so
// `a` was move-tracked and a second use was wrongly rejected -- only an
// explicit `let a: i64` worked. Now the element-copy-ness of the array is
// tracked and pop(arr) inherits it. (Kryos is ARC-based: reuse-after-pass is
// always allowed; this is about not BLOCKING a valid Copy-scalar reuse.)

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn sum_dup(arr: [i64]) -> i64 {
    let mut a = arr
    let top = pop(a)
    // reuse `top` (a Copy i64) multiple times without annotation
    return top + top + top
}

struct Rec {
    name: str,
    tags: i64,
}

fn main() {
    let mut si: [i64] = [10, 42]
    let a = pop(si)
    push(si, a)
    push(si, a)
    expect(a == 42, "unannotated pop(i64) result is Copy, reusable")
    expect(len(si) == 3, "pushes with reused Copy value")

    let mut sf: [f64] = [3.5]
    let b = pop(sf)
    expect(b + b > 6.9 and b + b < 7.1, "unannotated pop(f64) result reusable")

    expect(sum_dup([1, 2, 9]) == 27, "pop-Copy reuse inside a fn param body (9*3)")

    // pop() of a NARROW scalar element (bool/u8/i32) must width-coerce the
    // i64-slot result to the element type on AOT -- the pop path skipped the
    // coercion the array-index path already did, so a bool pop stored 8 bytes
    // into a 1-byte alloca (stack corruption, AOT exit 3) and u8/i32 pop failed
    // to build. Now pop coerces like indexing.
    let mut sbool: [bool] = [true, false, true]
    let pb = pop(sbool)
    expect(pb and pb, "pop([bool]) narrow-scalar coercion (was AOT crash)")
    let mut su8: [u8] = [200, 5]
    let pu = pop(su8)
    expect(pu == 5, "pop([u8]) narrow-scalar coercion (was AOT build-fail)")

    // Reusing a STRUCT value after push(arr, struct) is allowed under ARC (the
    // array becomes the owner; the source local stays valid). push was the one
    // path that hard-move-blocked a struct element (E0300), unlike str/map
    // elements and ordinary fn args. Read-only reuse must compile + run.
    let mut recs: [Rec] = []
    let r1: Rec = Rec { name: "keep", tags: 3 }
    recs = push(recs, r1)
    expect(r1.name == "keep" and r1.tags == 3, "struct reuse after push (ARC, not E0300)")
    expect(recs[0].tags == 3, "pushed struct genuinely entered the array")

    println("conformance copy-reuse: PASS")
}
