// Conformance: a Copy-typed local inferred from an UNANNOTATED generic builtin
// return (`let a = pop(arr)`) must be classified Copy so reusing it does NOT
// spuriously trip error[E0300]. Previously the ownership analysis' Copy check
// had no case for pop's generic `-> T` return and defaulted to non-Copy, so
// `a` was move-tracked and a second use was wrongly rejected -- only an
// explicit `let a: i64` worked. Now the element-copy-ness of the array is
// tracked and pop(arr) inherits it. (Kryos is ARC-based: reuse-after-pass is
// always allowed; this is about not BLOCKING a valid Copy-scalar reuse.)

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn sum_dup(arr: [i64]) -> i64 {
    let mut a = arr
    let top = pop(a)
    // reuse `top` (a Copy i64) multiple times without annotation
    return top + top + top
}

struct Rec {
    name: str,
    tags: i64,
}

struct Alloc {
    heap: [i64],
}

// A COPY element of a tuple whose sibling is a heap-bearing struct, reused
// multiple times -- both as a tuple PARAMETER and a tuple LOCAL. The ownership
// checker marked any tuple-field access as a partial move without checking the
// FIELD's own type, so a Copy element (i64) got move-tracked and reuse raised a
// false E0303. Now a Copy tuple/struct field access is a `use`, never a move.
fn reuse_tuple_param(t: (Alloc, str, i64)) -> i64 {
    let mut n: i64 = t.2
    n = n + t.2
    n = n + t.2
    return n + len(t.1)
}

fn main() {
    let mut si: [i64] = [10, 42]
    let a = pop(si)
    push(si, a)
    push(si, a)
    expect(a == 42, "unannotated pop(i64) result is Copy, reusable")
    expect(len(si) == 3, "pushes with reused Copy value")

    let mut sf: [f64] = [3.5]
    let b = pop(sf)
    expect(b + b > 6.9 and b + b < 7.1, "unannotated pop(f64) result reusable")

    expect(sum_dup([1, 2, 9]) == 27, "pop-Copy reuse inside a fn param body (9*3)")

    // pop() of a NARROW scalar element (bool/u8/i32) must width-coerce the
    // i64-slot result to the element type on AOT -- the pop path skipped the
    // coercion the array-index path already did, so a bool pop stored 8 bytes
    // into a 1-byte alloca (stack corruption, AOT exit 3) and u8/i32 pop failed
    // to build. Now pop coerces like indexing.
    let mut sbool: [bool] = [true, false, true]
    let pb = pop(sbool)
    expect(pb and pb, "pop([bool]) narrow-scalar coercion (was AOT crash)")
    let mut su8: [u8] = [200, 5]
    let pu = pop(su8)
    expect(pu == 5, "pop([u8]) narrow-scalar coercion (was AOT build-fail)")

    // Reusing a STRUCT value after push(arr, struct) is allowed under ARC (the
    // array becomes the owner; the source local stays valid). push was the one
    // path that hard-move-blocked a struct element (E0300), unlike str/map
    // elements and ordinary fn args. Read-only reuse must compile + run.
    let mut recs: [Rec] = []
    let r1: Rec = Rec { name: "keep", tags: 3 }
    recs = push(recs, r1)
    expect(r1.name == "keep" and r1.tags == 3, "struct reuse after push (ARC, not E0300)")
    expect(recs[0].tags == 3, "pushed struct genuinely entered the array")

    // Variable-to-variable assignment reuse (`let b2 = b1; use b1`) for
    // struct/enum/map. str and [T] already allowed this; struct/enum/map hard-
    // blocked it with E0300 despite the ARC model. Now advisory; the source
    // stays valid, and the aliasing is memory-safe (shared drop, no double-free).
    let sb1: Rec = Rec { name: "share", tags: 7 }
    let sb2: Rec = sb1
    expect(sb1.tags == 7 and sb2.tags == 7, "struct assignment reuse (both valid)")
    let mut mm1: map<str, i64> = {}
    mm1["k"] = 42
    let mm2: map<str, i64> = mm1
    expect(mm1["k"] == 42 and mm2["k"] == 42, "map assignment reuse (both valid)")

    // Copy tuple-field reuse: as a param, and as a local (sibling is heap struct).
    expect(reuse_tuple_param((Alloc { heap: [1] }, "hi", 10)) == 32, "Copy tuple-field reuse via param (10*3 + 2)")
    let pr: (Alloc, i64) = (Alloc { heap: [9] }, 5)
    let mut s: i64 = pr.1
    s = s + pr.1
    expect(s == 10, "Copy tuple-field reuse via local (not partial-moved)")

    // Maps with heap VALUE types (array/nested-map) built in a loop then read
    // back. The map free path is now type-aware for array/map values
    // (kryos_map_free_typed + kryos_array_free_typed), and the map/array loop-
    // locals reach that free -- so a `map<str,[i64]>` loop is bounded, not a
    // ~260 MB leak. Correctness asserted here (RSS measured externally).
    let mut avm: [map<str, [i64]>] = []
    let mut mi: i64 = 0
    while mi < 20 {
        let mut mm: map<str, [i64]> = {}
        mm["nums"] = [mi, mi + 1, mi + 2]
        avm = push(avm, mm)
        mi = mi + 1
    }
    expect(avm[0]["nums"][2] == 2 and avm[19]["nums"][0] == 19, "map<str,[i64]> array values built in a loop persist")
    let mut nested: map<str, map<str, i64>> = {}
    let mut inner: map<str, i64> = {}
    inner["x"] = 7
    nested["a"] = inner
    expect(nested["a"]["x"] == 7, "map<str,map<str,i64>> nested value")

    println("conformance copy-reuse: PASS")
}
