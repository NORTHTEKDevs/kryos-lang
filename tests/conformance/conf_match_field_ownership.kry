// Conformance (LEDGER item 139): `match h.o { .. }` on an Option field of a
// by-value struct param/local no longer leaks the struct, and no longer lets
// a payload that escaped the arm dangle once the struct is dropped. Each
// probe returns or stores the payload bind, lets the struct die, churns the
// allocator so freed blocks are REUSED, then reads the escaped value.
// Run under KRYOS_FREE_DIAG on both backends, and on AOT with real frees, by
// tests/no_double_free.sh.
use std::option::{Option}

struct In { s: str, n: i64 }
struct Hold { o: Option<In>, tag: str }
enum Shape { Circle(str), Square(i64), Blob(In) }
struct Box2 { sh: Shape, name: str }

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn mk_in(i: i64) -> In { return In { s: "payload-" + to_string(i) + "-padding", n: i } }

fn take(h: Hold) -> In {
    match h.o {
        Option.Some(x) => { return x },
        Option.None => { return mk_in(-1) },
    }
}

fn text_of(h: Hold) -> str {
    match h.o {
        Option.Some(x) => { return x.s },
        Option.None => { return "none" },
    }
}

fn weigh(h: Hold) -> i64 {
    match h.o {
        Option.Some(x) => { return len(x.s) + x.n },
        Option.None => { return 0 },
    }
}

fn shape_text(b: Box2) -> str {
    match b.sh {
        Shape.Circle(c) => { return c },
        Shape.Square(n) => { return to_string(n) },
        Shape.Blob(i) => { return i.s },
    }
}

fn churn(k: i64) -> i64 {
    let mut a = 0
    let mut j = 0
    while j < 12 {
        let t = "churn-" + to_string(k) + "-" + to_string(j) + "-xxxxxxxxxxxx"
        let h = Hold { o: Some(mk_in(k + j)), tag: t }
        a = a + len(h.tag)
        j = j + 1
    }
    return a
}

fn main() {
    let mut i = 0
    let mut sum = 0
    while i < 80 {
        let h1 = Hold { o: Some(mk_in(i)), tag: "t" + to_string(i) }
        let got = take(h1)
        let c1 = churn(i)
        expect(got.s == "payload-" + to_string(i) + "-padding", "take s " + got.s)
        expect(got.n == i, "take n " + to_string(got.n))

        let txt = text_of(Hold { o: Some(mk_in(i + 100)), tag: "u" })
        let c2 = churn(i + 1)
        expect(txt == "payload-" + to_string(i + 100) + "-padding", "text " + txt)

        let none_h = Hold { o: None(), tag: "z" }
        expect(weigh(none_h) == 0, "weigh none")
        expect(text_of(none_h) == "none", "text none")
        let w = weigh(Hold { o: Some(mk_in(i + 200)), tag: "w" })
        expect(w == len("payload-" + to_string(i + 200) + "-padding") + i + 200, "weigh " + to_string(w))

        let s1 = shape_text(Box2 { sh: Shape.Circle("circle-" + to_string(i)), name: "a" })
        let c3 = churn(i + 2)
        expect(s1 == "circle-" + to_string(i), "circle " + s1)
        let s2 = shape_text(Box2 { sh: Shape.Blob(mk_in(i + 300)), name: "b" })
        let c4 = churn(i + 3)
        expect(s2 == "payload-" + to_string(i + 300) + "-padding", "blob " + s2)
        expect(shape_text(Box2 { sh: Shape.Square(i), name: "c" }) == to_string(i), "square")
        sum = sum + c1 + c2 + c3 + c4 + w
        i = i + 1
    }
    println("match field ownership ok " + to_string(sum))
}
