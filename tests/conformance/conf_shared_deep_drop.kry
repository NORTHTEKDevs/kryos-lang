// Conformance (LEDGER item 137): dropping a long `shared` linked list frees it
// node by node without recursing the native stack (the release of a node
// whose count reaches zero releases the next, so a 300000-node list used to
// overflow the stack once frees became real).
use std::option::{Option}

struct L { next: Option<shared L>, v: i64 }

fn build(n: i64) -> Option<shared L> {
    let mut head: Option<shared L> = None()
    let mut i = 0
    while i < n {
        head = Some(shared L { next: head, v: i })
        i = i + 1
    }
    return head
}

fn drop_list(n: i64) -> i64 {
    let h = build(n)
    match h {
        Option.Some(s) => { return (*s).v },
        Option.None => { return -1 },
    }
}

fn main() {
    let mut total = 0
    let mut r = 0
    while r < 3 {
        total = total + drop_list(300000)
        r = r + 1
    }
    if total != 3 * 299999 {
        println("CONF FAIL: total {total}")
        exit(1)
    }
    println("deep drop ok {total}")
}
