// Conformance: a NAMED heap-typed local (array/map/str/struct-with-heap-field)
// pushed into an OUTER collection, then falling out of scope, must not free the
// data the outer collection still owns. MIR retains the pushed local (rc 1->2)
// then emits its scope-end drop; but emit_array_drop freed all element data
// UNCONDITIONALLY regardless of the array header's ref_count, so the first drop
// of a shared array freed elements a second owner (rows) still referenced ->
// silent AOT corruption (the freed strings reused by a later concat buffer).
// Fixed by gating the element-free loop on ref_count <= 1 (only the last owner
// frees elements). JIT was correct (aliases, no destructive free).

use std::string::{split_lines}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn split_char(s: str, sep: str) -> [str] {
    let mut parts: [str] = []
    let mut cur: str = ""
    let mut i: i64 = 0
    while i < len(s) {
        let c: str = substr(s, i, i + 1)
        if c == sep {
            parts = push(parts, cur)
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    parts = push(parts, cur)
    return parts
}

struct Row { cells: [str] }

struct Name { first: str }

struct Contact { name: Name, id: i64 }

fn main() {
    // Array-of-arrays via a NAMED local, with an intervening allocation
    // (the "parsed:" concat) that would reuse freed string memory if broken.
    let lines: [str] = ["name,age,city", "alice,30,nyc", "bob,25,la"]
    let mut rows: [[str]] = []
    let mut i: i64 = 0
    while i < len(lines) {
        let fields: [str] = split_char(lines[i], ",")
        rows = push(rows, fields)
        i = i + 1
    }
    let parsed = "parsed: " + to_string(len(rows))  // intervening heap alloc
    expect(parsed == "parsed: 3", "intervening concat")
    expect(rows[0][0] == "name" and rows[0][2] == "city", "row 0 nested strings intact")
    expect(rows[1][0] == "alice" and rows[1][1] == "30", "row 1 nested strings intact")
    expect(rows[2][0] == "bob", "row 2 nested strings intact")

    // Named map local pushed into [map].
    let mut maps: [map<str, i64>] = []
    let mut k: i64 = 0
    while k < 3 {
        let mut m: map<str, i64> = {}
        m["v"] = k * 10
        maps = push(maps, m)
        k = k + 1
    }
    let filler = "x" + to_string(len(maps))  // intervening alloc
    expect(filler == "x3", "map filler")
    expect(maps[0]["v"] == 0 and maps[2]["v"] == 20, "named map local pushed survives")

    // Named struct-with-array-field local pushed into [Row].
    let mut table: [Row] = []
    let mut r: i64 = 0
    while r < 3 {
        let cells: [str] = split_char("p,q", ",")
        let row: Row = Row { cells: cells }
        table = push(table, row)
        r = r + 1
    }
    let f2 = "n=" + to_string(len(table))  // intervening alloc
    expect(f2 == "n=3", "struct filler")
    expect(table[0].cells[0] == "p" and table[2].cells[1] == "q", "struct-with-array field intact")

    // Filter/partition: a struct read via array index and pushed into a SECOND
    // array. On Cranelift structs are raw shared pointers (no ref_count), so
    // both arrays aliased the same element and double-freed it at teardown
    // (exit 127). Fixed by cloning a struct index/field read that flows into a
    // push. Both source and destination arrays must stay valid.
    let mut passing: [Row] = []
    let mut fi: i64 = 0
    while fi < len(table) {
        if len(table[fi].cells) == 2 {
            passing = push(passing, table[fi])
        }
        fi = fi + 1
    }
    expect(len(passing) == 3, "filter struct-array into 2nd array")
    expect(passing[0].cells[0] == "p" and table[0].cells[0] == "p", "both source and copy valid after filter")

    // Indirect filter via a `let` intermediate, for BOTH an enum and a struct
    // element: `let s = arr[i]; push(dest, s)`. Cranelift aliases the element
    // (raw shared pointer), so without a clone both arrays double-free it at
    // teardown -> exit 127 (correct stdout). The clone gate now covers the
    // let-indirect shape and enum elements, not just a direct `push(dest,arr[i])`.
    let mut evens: [Row] = []
    let mut ei: i64 = 0
    while ei < len(table) {
        let r = table[ei]
        evens = push(evens, r)
        ei = ei + 1
    }
    expect(len(evens) == 3 and evens[0].cells[0] == "p" and table[2].cells[1] == "q", "indirect let filter (struct), both valid, no teardown crash")

    // A struct with a NESTED struct field that owns a heap field, filtered via
    // index-read-push. The deep-copy of the outer struct must deep-copy the
    // nested struct too (it's a separate allocation with its own heap str) --
    // else the original and the copy share it and both free it at teardown
    // (LLVM shallow-copied the pointer; Cranelift shared any nested struct
    // unless @copy). Both source and filtered copy must stay valid.
    let mut people: [Contact] = []
    let mut ci: i64 = 0
    while ci < 3 {
        let nm: Name = Name { first: "f" + to_string(ci) }
        let ct: Contact = Contact { name: nm, id: ci }
        people = push(people, ct)
        ci = ci + 1
    }
    let mut adults: [Contact] = []
    let mut ai: i64 = 0
    while ai < len(people) {
        if people[ai].id >= 1 {
            adults = push(adults, people[ai])
        }
        ai = ai + 1
    }
    expect(len(adults) == 2, "filter struct-with-nested-struct-heap-field")
    expect(adults[0].name.first == "f1" and people[0].name.first == "f0", "nested-struct heap field intact in both source and copy")

    println("conformance nested-arrays: PASS")
}
