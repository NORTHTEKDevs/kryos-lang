// Conformance: std::iter::sort_by / sort_by_key must infer the array element
// type into their comparator/key closures. They were declared `[any]` + bare
// `fn` (no generic linking array element to closure params), so a struct-field
// access in the comparator (`|a, b| b.salary - a.salary`) left the params as
// unresolved type vars -> E0110. Now `sort_by<T>(arr:[T], cmp: fn(T,T)->i64)`
// and `sort_by_key<T,K>(arr:[T], key_fn: fn(T)->K)`, matching filter/map/fold.

use std::iter::{sort_by, sort_by_key, filter, map, fold, sort, rev, dedup, unique, take, skip, chain, group_by}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

struct Emp {
    name: str,
    salary: i64,
}

fn main() {
    let es: [Emp] = [
        Emp { name: "a", salary: 30 },
        Emp { name: "bb", salary: 50 },
        Emp { name: "ccc", salary: 40 },
    ]
    // Comparator closure accessing a struct field (the E0110 case).
    let desc = sort_by(es, |a, b| b.salary - a.salary)
    expect(desc[0].salary == 50 and desc[2].salary == 30, "sort_by struct field descending")
    let asc = sort_by(es, |a, b| a.salary - b.salary)
    expect(asc[0].salary == 30 and asc[2].salary == 50, "sort_by struct field ascending")
    // Comparator using a str field.
    let byname = sort_by(es, |a, b| len(a.name) - len(b.name))
    expect(byname[0].name == "a" and byname[2].name == "ccc", "sort_by str-field length")
    // sort_by_key (built atop sort_by) at a struct field.
    let bykey = sort_by_key(es, |e| e.salary)
    expect(bykey[0].salary == 30, "sort_by_key struct field")
    // Plain [i64] sort still works.
    let nums: [i64] = [9, 1, 5, 3]
    let sn = sort_by(nums, |a, b| a - b)
    expect(sn[0] == 1 and sn[3] == 9, "sort_by [i64]")
    // filter/map/fold on the same struct array (regression).
    let hi = filter(es, |e| e.salary > 35)
    let names = map(es, |e| e.name)
    let total = fold(es, 0, |acc, e| acc + e.salary)
    expect(len(hi) == 2 and names[1] == "bb" and total == 120, "filter/map/fold on struct array")

    // Element-preserving pass-throughs (sort/rev/dedup/unique/take/skip/chain)
    // were declared `[any]`, so a non-i64 element erased to an i64 slot and was
    // returned still-erased -- the caller read raw pointers, and sort/dedup/
    // unique compared handles (wrong order / no dedup). Now generic `<T>`, so
    // the element type survives and `<=`/`==` dispatch to real string ordering.
    let words: [str] = ["banana", "apple", "cherry", "apple"]
    let sorted = sort(words)
    expect(sorted[0] == "apple" and sorted[1] == "apple" and sorted[2] == "banana" and sorted[3] == "cherry", "sort [str] lexicographic (not by pointer)")
    let reversed = rev(words)
    expect(reversed[0] == "apple" and reversed[3] == "banana", "rev [str] preserves elements")
    let dups: [str] = ["a", "a", "b", "b", "c"]
    let dd = dedup(dups)
    expect(len(dd) == 3 and dd[0] == "a" and dd[2] == "c", "dedup [str] by value")
    let uq = unique(dups)
    expect(len(uq) == 3 and uq[0] == "a" and uq[1] == "b" and uq[2] == "c", "unique [str] by value")
    let tk = take(words, 2)
    let sk = skip(words, 3)
    expect(tk[0] == "banana" and tk[1] == "apple" and sk[0] == "apple", "take/skip [str] preserve elements")
    let ch = chain(tk, sk)
    expect(len(ch) == 3 and ch[0] == "banana" and ch[2] == "apple", "chain [str] preserves elements")
    // Numeric sort still correct (incl. negative floats -> real f64 compare).
    let fs: [f64] = [1.5, 0.0 - 2.0, 3.0]
    let sf = sort(fs)
    expect(sf[0] < 0.0 - 1.9 and sf[2] > 2.9, "sort [f64] with negatives (numeric, not bit-pattern)")

    // group_by is fully generic (was `[any] -> any`: an unannotated result
    // crashed on map subscript, and even annotated only the FIRST element per
    // group survived the erased pushes).
    let gb_xs: [i64] = [1, 2, 3, 4, 5, 6, 7, 8, 9]
    let gb = group_by(gb_xs, |x| x % 3)
    expect(len(gb["0"]) == 3, "group_by keeps every element per group (was 1)")
    expect(len(gb["1"]) == 3, "group_by second group complete")
    expect(gb["1"][2] == 7, "group_by preserves element values and order")
    let gb_ws: [str] = ["apple", "ant", "bee"]
    let gbw = group_by(gb_ws, |w| substr(w, 0, 1))
    expect(len(gbw["a"]) == 2, "group_by over [str] elements")

    println("conformance iter-sort: PASS")
}
