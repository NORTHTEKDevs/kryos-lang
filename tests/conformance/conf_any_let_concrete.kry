// Conformance (num lane, LEDGER item 6 narrow shape): an IMMUTABLE
// `let x: any = <str>` keeps its concrete type. On master the binding was
// erased to a bare i64: to_string(x) printed the raw POINTER on the JIT and
// the AOT build failed in clang ("'%_0' defined with type 'ptr' but expected
// 'i64'"). `any` has no runtime tag, so only the statically known type of
// the one-and-only initializer can render it.
fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn main() {
    let x: any = "hi"
    let s = to_string(x)
    expect(s == "hi", "to_string of an any-annotated str literal")
    println(to_string(x))

    let d: any = "a" + "bc"
    expect(to_string(d) == "abc", "to_string of an any-annotated computed str")
    expect(len(to_string(d)) == 3, "length of the rendered str")

    let n: any = 42
    expect(to_string(n) == "42", "an any-annotated int is unchanged")
}
