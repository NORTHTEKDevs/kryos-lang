// Conformance: generic structs and enums through every instantiation path —
// direct annotation, generic-fn returns, generic-fn params, compound args.
// (Reference chapter 8; regression for the step-240 field-typing fix.)

use std::iter::{map}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn call_on(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x)
}

// Stateful (mutating) closure -- the captured var is mutated and the mutation
// must PERSIST across calls (counter/accumulator idiom). Previously the JIT
// re-read the outer value each call (1,1,1) and AOT failed to build (invalid SSA
// redefinition of the moved-capture param).
fn make_counter() -> fn() -> i64 {
    let mut c = 0
    return || {
        c = c + 1
        c
    }
}

struct Holder {
    hf: fn(i64) -> i64,
}

// Multi-param generic whose method returns a PERMUTED instantiation (Pair<B,A>).
// A generic method's erased return kept the i64 placeholder, so
// `pair.get_first() == 2.5` hinted the call i64 while the literal was f64 -- the
// Cranelift verifier rejected the mismatched-class icmp.
struct Pair<A, B> {
    first: A,
    second: B,
}

impl<A, B> Pair<A, B> {
    fn get_first(self: Pair<A, B>) -> A {
        return self.first
    }
    fn swap(self: Pair<A, B>) -> Pair<B, A> {
        return Pair { first: self.second, second: self.first }
    }
    // Reads a TRAILING field. When the FIRST field is itself an aggregate
    // (`Pair<Pair<i64,i64>, i64>`), AOT used to read `second` at the wrong
    // byte offset -- the erased single-compiled `self: Pair<i64,i64>` template
    // assumed every field was one 8-byte slot, so a wide inlined `first`
    // pushed `second` to the wrong offset (silently returned the inner pair's
    // `second`). Fixed by repacking the real arg into the erased shape,
    // boxing the wide field. (JIT was always correct: Cranelift boxes every
    // aggregate field.)
    fn second_of(self: Pair<A, B>) -> B {
        return self.second
    }
    // RETURNS the FIRST field. When A resolves to a wide (>8-byte) aggregate,
    // the callee is compiled once with the return erased to scalar i64 and
    // actually returns a boxed pointer; the call site must use the scalar
    // return ABI then unbox (inttoptr + load), not `call %WideAgg` (which
    // mismatched the callee's real signature -> AOT garbage).
    fn first_of(self: Pair<A, B>) -> A {
        return self.first
    }
}

// Generic struct with a NESTED-generic field (map<str, Option<V>>) built inside a
// generic function. This (a) failed to build on AOT (a phantom Option___V
// monomorphization -> undefined __kryos_drop_V) and (b) segfaulted when two
// concrete instantiations coexisted (field-type inference fell back to i64 for
// every V, colliding the layouts).
struct Reg<V> {
    entries: map<str, Option<V>>,
}

fn mk_reg<V>(k: str, v: Option<V>) -> Reg<V> {
    let mut m: map<str, Option<V>> = {}
    m[k] = v
    return Reg { entries: m }
}

fn reg_geti(r: Reg<i64>, k: str) -> i64 {
    match r.entries[k] {
        Some(v) => return v,
        None() => return -1,
    }
}

fn reg_gets(r: Reg<str>, k: str) -> str {
    match r.entries[k] {
        Some(v) => return v,
        None() => return "?",
    }
}

// Bare (no-Option) map<str, V> generic-struct field. The generic-fn body's local
// `map<str, V>` resolved to a placeholder Struct("V"), which extract_param_binding
// blindly trusted -> a spurious Reg2___V struct distinct from the call-site
// Reg2___i64, so the sret store was `undef` and the value read back as 0 on AOT.
struct Reg2<V> {
    entries: map<str, V>,
}

fn mk_reg2<V>(k: str, v: V) -> Reg2<V> {
    let mut m: map<str, V> = {}
    m[k] = v
    return Reg2 { entries: m }
}

struct Boxed<T> {
    value: T,
    label: str,
}

fn wrap<T>(v: T, label: str) -> Boxed<T> {
    return Boxed { value: v, label: label }
}

fn unwrap_label<T>(b: Boxed<T>) -> str {
    return b.label
}

// Chained generic-method call ON the result of a generic method, with NO
// intermediate annotation. A generic method whose return is a bare `-> T`
// resolving to a Struct/Enum concrete type used to keep the erased i64 slot,
// so the follow-on `.get()`/field access fell back to an unmangled lookup
// (JIT: unresolved external `get`; AOT: `extractvalue operand must be
// aggregate` / void store). The call result must now carry its real
// monomorphized type so the chain infers + codegens on both backends.
struct Nest<T> {
    inner: T,
}

impl<T> Nest<T> {
    fn get(self: Nest<T>) -> T {
        return self.inner
    }
}

fn main() {
    // Through generic-fn returns (the path that mistyped fields as i64:
    // Boxed<str>.value printed its handle before the fix).
    let a = wrap(42, "int")
    let b = wrap("hello", "str")
    let c = wrap(2.5, "float")
    expect(a.value == 42, "Boxed<i64> via generic fn")
    expect(b.value == "hello", "Boxed<str> via generic fn")
    expect(c.value == 2.5, "Boxed<f64> via generic fn")
    expect("{b.value}" == "hello", "interpolation of generic str field")

    // Direct annotated instantiation.
    let d: Boxed<str> = Boxed { value: "direct", label: "d" }
    expect(d.value == "direct", "direct Boxed<str>")

    // Generic struct in generic-fn param position.
    expect(unwrap_label(b) == "str", "generic struct as generic-fn param")

    // Compound type args, including direct indexing of the generic field.
    let arr = wrap([1, 2, 3], "array")
    expect(len(arr.value) == 3 and arr.value[2] == 3, "Boxed<[i64]> direct index")
    let items = arr.value
    expect(items[0] == 1, "copied-out generic array field")

    // Higher-order over an ARRAY OF FUNCTIONS: the un-annotated closure param
    // `f` is itself a function (element type `fn(i64)->i64`). Its type is erased
    // to i64 through the generic HOF, but calling it must still lower to an
    // indirect closure call -- a direct call emitted an undefined external
    // symbol named after the param (LNK2001 unresolved external `f`).
    let inc = |x| x + 1
    let dbl = |x| x * 2
    let fns: [fn(i64) -> i64] = [inc, dbl]
    let applied = map(fns, |f| f(10))
    expect(applied[0] == 11 and applied[1] == 20, "map over array of functions")
    expect(call_on(inc, 7) == 8, "named-fn function param call")

    // Generic method returning a permuted instantiation, then an f64 compare.
    let pr = Pair { first: true, second: 2.5 }
    let sw = pr.swap()
    expect(sw.get_first() == 2.5, "swapped generic method f64 return compare")
    expect(sw.get_first() > 2.4, "swapped generic method f64 ordering")

    // Un-annotated chained generic-method calls (gotcha #17).
    let n2: Nest<Nest<i64>> = Nest { inner: Nest { inner: 99 } }
    let cv = n2.get().get()
    expect(cv == 99, "un-annotated chained generic method (2 levels)")
    let n3: Nest<Nest<Nest<i64>>> = Nest { inner: Nest { inner: Nest { inner: 7 } } }
    expect(n3.get().get().get() == 7, "un-annotated chained generic method (3 levels)")
    // Chained generic method result of str type keeps its pointer type.
    let ns: Nest<Nest<str>> = Nest { inner: Nest { inner: "deep" } }
    expect(ns.get().get() == "deep", "un-annotated chained generic method (str leaf)")
    // Chained generic method with an f64 leaf: the erased method returns an i64
    // slot; the call site must reinterpret it as double (bitcast) instead of
    // emitting `call double` against the i64-returning callee (ABI mismatch ->
    // RAX vs XMM0 -> silently 0 on AOT). i64/str leaves already worked.
    let nf: Nest<Nest<f64>> = Nest { inner: Nest { inner: 3.5 } }
    expect(nf.get().get() == 3.5, "chained generic method (f64 leaf, ABI reinterpret)")
    expect(nf.get().get() + 1.0 == 4.5, "chained generic f64 leaf in arithmetic")

    // A generic bare `-> T` method whose T resolves to a POINTER-shaped type
    // (str / [T] / map) must return the real type, not the erased i64 slot --
    // else println/concat/len/index dispatch the integer path on a heap
    // pointer and print/index garbage (was broken for str/array/map; F64 and
    // Struct/Enum already worked).
    let bxs: Nest<str> = Nest { inner: "leaf" }
    expect(bxs.get() == "leaf", "generic method bare -> T returns str (not erased i64)")
    let bxa: Nest<[i64]> = Nest { inner: [10, 20, 30] }
    expect(bxa.get()[1] == 20, "generic method bare -> T returns array")
    let bxm: Nest<map<str, i64>> = Nest { inner: {"k": 5} }
    let gm = bxm.get()
    expect(gm["k"] == 5, "generic method bare -> T returns map")

    // Nested multi-param generic struct whose FIRST field is an aggregate:
    // reading a trailing field must use the real offset (AOT byte-offset fix).
    let np: Pair<Pair<i64, i64>, i64> = Pair { first: Pair { first: 1, second: 2 }, second: 3 }
    expect(np.second_of() == 3, "nested generic aggregate-first: trailing field offset")
    let mut nm: Pair<Pair<i64, i64>, i64> = Pair { first: Pair { first: 10, second: 20 }, second: 30 }
    nm.second = 99
    expect(nm.second_of() == 99, "nested generic aggregate-first: trailing field mutation")
    let ninner: Pair<i64, i64> = nm.first
    expect(ninner.second_of() == 20, "nested generic aggregate-first: inner untouched by outer mutation")

    // Generic method RETURNING a wide aggregate field (return-side unbox),
    // exercised via a chain whose intermediate `first_of()` results are
    // consumed temporaries (single owner, dropped immediately). The value-form
    // that BINDS a wide `first_of()` result to a scope-lived local
    // (`let wr = p.first_of()`) is correct on AOT (verified) but currently
    // trips a pre-existing Cranelift boxed-aggregate teardown double-free that
    // accumulates to a silent exit-127; that case lives in its own tiny
    // regression (tests/smoke/test_wide_generic_return.kry) sized to stay
    // below the corruption threshold, and the bug is logged for a real fix.
    let deep: Pair<Pair<Pair<i64, i64>, i64>, i64> = Pair { first: Pair { first: Pair { first: 7, second: 8 }, second: 9 }, second: 10 }
    expect(deep.first_of().first_of().second_of() == 8, "recursive wide-return chain (temporary-consumed)")

    // Generic struct with a nested-generic map<str,Option<V>> field, two
    // concrete instantiations coexisting (must not collide/segfault).
    let ri = mk_reg("a", Some(42))
    let rs = mk_reg("b", Some("hello"))
    expect(reg_geti(ri, "a") == 42, "Reg<i64> nested-generic field")
    expect(reg_gets(rs, "b") == "hello", "Reg<str> nested-generic field (no layout collision)")

    // Bare map<str,V> generic-struct field at two value types (incl f64, which
    // additionally needs the RAX-not-XMM0 map-get return coercion).
    let r2i = mk_reg2("a", 42)
    let r2f = mk_reg2("b", 7.25)
    expect(r2i.entries["a"] == 42, "Reg2<i64> map<str,V> field")
    let fv: f64 = r2f.entries["b"]
    expect(fv > 7.2 and fv < 7.3, "Reg2<f64> map<str,V> field f64 value")
    let mut mf: map<str, f64> = {}
    mf["x"] = 3.5
    let x: f64 = mf["x"]
    expect(x > 3.4 and x < 3.6, "map<str,f64> value read (RAX coercion)")

    // Stateful closures: mutation persists across calls.
    let mut sum = 0
    let acc = |v| {
        sum = sum + v
        sum
    }
    expect(acc(5) == 5, "accumulator call 1")
    expect(acc(3) == 8, "accumulator persists across calls")
    expect(acc(2) == 10, "accumulator call 3")
    let cnt = make_counter()
    expect(cnt() == 1, "factory counter 1")
    expect(cnt() == 2, "factory counter persists")

    // A closure stored in a STRUCT FIELD must capture by reference like a
    // let-bound closure (gotcha #11): a later mutation of the captured var is
    // visible through the field. Previously the field-stored closure froze the
    // capture at construction (stale value, silent wrong).
    let mut kf = 4
    let gg = |x| x * kf
    let mach = Holder { hf: |x| x * kf }
    kf = 50
    expect(gg(2) == 100, "let-bound closure sees mutation")
    expect(mach.hf(2) == 100, "struct-field closure sees mutation")

    println("conformance generics: PASS")
}
