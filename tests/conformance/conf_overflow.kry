// Conformance: the integer overflow-builtin family (wrapping/saturating/checked
// _add/_sub/_mul). All nine were missing from the LLVM backend's name->runtime-
// symbol map, so JIT worked but AOT failed to link (`use of undefined value
// @wrapping_add`). They share one runtime (kryos_*_i64) -- the LLVM dispatch
// just needed the cases. Semantics: wrapping = two's complement wrap,
// saturating = clamp to i64::MIN/MAX, checked = plain i64 on success (panics on
// overflow). This file exercises the non-panicking paths on BOTH backends.

use std::hash::{crc32}

use std::crypto::{hmac_sha256}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

// crypto for hmac_sha256; the conformance runner uses inferred (not permissive)
// capability mode, so `main` must declare what it transitively needs.
@capabilities(crypto)
fn main() {
    let imax: i64 = 9223372036854775807
    let imin: i64 = -9223372036854775808

    // wrapping: two's complement
    expect(wrapping_add(imax, 1) == imin, "wrapping_add MAX+1 -> MIN")
    expect(wrapping_sub(imin, 1) == imax, "wrapping_sub MIN-1 -> MAX")
    expect(wrapping_mul(imax, 2) == -2, "wrapping_mul MAX*2 -> -2")
    expect(wrapping_add(3, 4) == 7, "wrapping_add normal")

    // saturating: clamp
    expect(saturating_add(imax, 1) == imax, "saturating_add clamps to MAX")
    expect(saturating_sub(imin, 1) == imin, "saturating_sub clamps to MIN")
    expect(saturating_mul(imin, 2) == imin, "saturating_mul clamps to MIN")
    expect(saturating_add(10, 20) == 30, "saturating_add normal")

    // checked: plain i64 on the non-overflow path
    expect(checked_add(5, 3) == 8, "checked_add non-overflow")
    expect(checked_sub(10, 4) == 6, "checked_sub non-overflow")
    expect(checked_mul(6, 7) == 42, "checked_mul non-overflow")

    // mixed with normal arithmetic
    let r = 100 + wrapping_add(1, 2) + saturating_mul(3, 4)
    expect(r == 115, "overflow builtins compose with normal arithmetic")

    // std::hash::crc32 must produce the STANDARD IEEE 802.3 CRC-32 (matches
    // zlib/binascii). The old impl used a signed -1 init + `crc / 2` (signed
    // division) so a negative accumulator gave non-standard values; now the
    // accumulator stays a positive 32-bit-masked value with a logical shift.
    // Exercises hex literals, `>>`, `^`, `&` end-to-end on both backends.
    expect(crc32("hello") == 907060870, "crc32(hello) matches reference IEEE CRC-32")
    expect(crc32("") == 0, "crc32(empty) is 0")
    expect(crc32("The quick brown fox jumps over the lazy dog") == 1095738169, "crc32(fox) matches reference")

    // HMAC-SHA256 must match RFC 2104 / any reference. The old impl (a) padded
    // the key with the literal `"\x00"` (4 chars -- an unrecognized escape), and
    // (b) fed the inner hash's HEX string to the outer hash instead of its raw
    // 32 bytes -- so signatures never matched (and were import-set-dependent).
    expect(hmac_sha256("key", "The quick brown fox jumps over the lazy dog") == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8", "hmac_sha256 matches the reference vector")
    expect(hmac_sha256("", "") == "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad", "hmac_sha256 of empty key+msg matches reference")

    println("conformance overflow: PASS")
}
