// Conformance (2026-10-08): tuples holding heap values. Run under
// KRYOS_FREE_DIAG on both backends by tests/no_double_free.sh -- master
// prints the right string here and double-frees anyway: a tuple element read
// handed out the tuple's own handle (`println(q.0)` twice freed it twice),
// and `return (x, x)` of a param took no references.
use std::option::{Option, Some, None}
struct P { name: str, tags: [str] }
struct H { pair: (str, i64), n: i64 }
enum E { A(str), B(i64) }

fn mk(i: i64) -> (str, i64) { return ("v{i}", i) }
fn mkp(i: i64) -> (P, str) { return (P { name: "p{i}", tags: ["t{i}"] }, "s{i}") }
fn ident(t: (str, i64)) -> (str, i64) { return t }
fn first(t: (str, i64)) -> str { return t.0 }
fn swap(t: (str, str)) -> (str, str) { return (t.1, t.0) }
fn nested(i: i64) -> ((str, i64), [str]) { return (("n{i}", i), ["a{i}"]) }
fn with_opt(i: i64) -> (Option<str>, i64) { return (Some("o{i}"), i) }
fn with_enum(i: i64) -> (E, str) { return (E.A("e{i}"), "x{i}") }
fn ename(e: E) -> str { match e { E.A(s) => { return s } E.B(n) => { return to_string(n) } } }

struct TH { pair: (str, i64), n: i64 }
enum TE { T((str, i64)), N(i64) }
fn tkeep_in(t: (str, i64), arr: [(str, i64)]) -> [(str, i64)] { return push(arr, t) }
fn tbox(t: (str, i64)) -> TH { return TH { pair: t, n: 1 } }
fn tenum(t: (str, i64)) -> TE { return TE.T(t) }
fn tcap(t: (str, i64)) -> fn() -> str { return || t.0 }
fn tlit(t: (str, i64)) -> [(str, i64)] { return [t, t] }
fn tmap(t: (str, i64)) -> map<str, (str, i64)> { let m: map<str, (str, i64)> = {}  m["k"] = t  return m }
fn tname(e: TE) -> str { match e { TE.T(t) => { return t.0 } TE.N(n) => { return "n" } } }
fn tswap(t: (str, str)) -> (str, str) { return (t.1, t.0) }
fn tident(t: (str, i64)) -> (str, i64) { t }
fn tident2(t: (str, i64)) -> (str, i64) { return t }
fn tfirst(xs: [(str, i64)]) -> (str, i64) { return xs[0] }
fn tkeep(t: (str, i64)) -> (str, i64) { let u = t  return u }

fn main() {
    let mut acc = ""
    let mut i = 0
    while i < 3 {
        let (a, b) = mk(i)
        acc = acc + a + to_string(b)
        let t = mk(i + 10)
        let u = ident(t)
        acc = acc + first(t) + u.0
        let (p, s) = mkp(i)
        acc = acc + p.name + p.tags[0] + s
        let pp = mkp(i + 20)
        acc = acc + pp.0.name + pp.1
        let sw = swap(("l{i}", "r{i}"))
        acc = acc + sw.0 + sw.1
        let ns = nested(i)
        acc = acc + ns.0.0 + ns.1[0]
        let arr = [mk(1), mk(2)]
        acc = acc + arr[1].0
        let h = H { pair: mk(7), n: 1 }
        acc = acc + h.pair.0
        match mk(5) {
            (x, 5) => { acc = acc + x }
            _ => { acc = acc + "?" }
        }
        let wo = with_opt(i)
        match wo.0 { Some(q) => { acc = acc + q } None => { acc = acc + "-" } }
        let we = with_enum(i)
        acc = acc + ename(we.0) + we.1
        let mut m = mk(0)
        m = mk(1)
        m = mk(2)
        acc = acc + m.0
        let cap = mk(9)
        let f = |k: i64| k + len(cap.0)
        acc = acc + to_string(f(1))
        acc = acc + "|"
        i = i + 1
    }
    let want = "v00v10v10p0t0s0p20s20r0l0n0a0v2v7v5o0e0x0v23|v11v11v11p1t1s1p21s21r1l1n1a1v2v7v5o1e1x1v23|v22v12v12p2t2s2p22s22r2l2n2a2v2v7v5o2e2x2v23|"
    if acc != want {
        println("CONF FAIL: tuple ownership: " + acc)
        exit(1)
    }
    let q = ("n{1}", 1)
    println(q.0)
    println(q.0)
    // Returning a tuple that is not freshly built (a param, a capture, an
    // element read) hands back a copy; master handed back the alias and the
    // caller freed it (7 double frees here).
    let t = ("a{1}", 1)
    let xs = [("x{1}", 2)]
    let cl = || t
    let got = tident(t).0 + tident2(t).0 + tfirst(xs).0 + tfirst(xs).0 + tkeep(t).0 + cl().0 + cl().0
    if got + t.0 + xs[0].0 != "a1a1x1x1a1a1a1a1x1" {
        println("CONF FAIL: tuple returns: " + got)
        exit(1)
    }
    // A tuple parameter a callee keeps (pushed, stored in a struct, an enum,
    // a map, an array literal, captured by a returned closure) is shared or
    // copied: the caller frees its own tuple after the call. Master: 20
    // double frees on this block.
    let mut kept: [(str, i64)] = []
    let mut hs: [TH] = []
    let mut es: [TE] = []
    let mut fs: [fn() -> str] = []
    let mut ls: [[(str, i64)]] = []
    let mut ms: [map<str, (str, i64)>] = []
    let mut k = 0
    while k < 4 {
        let tk = ("v{k}", k)
        kept = tkeep_in(tk, kept)
        hs = push(hs, tbox(tk))
        es = push(es, tenum(tk))
        fs = push(fs, tcap(tk))
        ls = push(ls, tlit(tk))
        ms = push(ms, tmap(tk))
        k = k + 1
    }
    let mut acc3 = ""
    k = 0
    while k < 4 {
        let fk = fs[k]
        acc3 = acc3 + kept[k].0 + hs[k].pair.0 + tname(es[k]) + fk() + ls[k][1].0 + ms[k]["k"].0 + "|"
        k = k + 1
    }
    if acc3 != "v0v0v0v0v0v0|v1v1v1v1v1v1|v2v2v2v2v2v2|v3v3v3v3v3v3|" {
        println("CONF FAIL: kept tuple params: " + acc3)
        exit(1)
    }
    let sw = tswap(("l{k}", "r{k}"))
    if sw.0 + sw.1 != "r4l4" {
        println("CONF FAIL: tuple literal argument")
        exit(1)
    }
    println("conformance tuple ownership: PASS")
}
