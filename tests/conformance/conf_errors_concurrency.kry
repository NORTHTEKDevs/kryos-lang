// Conformance: try/catch/throw semantics + spawn/channels. (Reference
use std::option::{Option, Some, None}
// chapters 7 (errors), 9 (concurrency).)

use std::result::{Result, Ok, Err}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

// Actor handlers are dispatched asynchronously: each actor runs on its own OS
// thread and `send` just enqueues a message into its mailbox -- there is no
// reply channel, so a handler's return value can never reach the call site.
// `add` is therefore declared VOID (fire-and-forget), which is the only kind
// of handler that can be called correctly today. (A handler whose BODY
// declares a non-void return, e.g. `fn add(x: f64) -> f64 { return memory }`,
// still type-checks on its own -- see tests/type_soundness.sh -- but CALLING
// it is a compile error: request-response needs runtime support that doesn't
// exist yet, so the checker rejects the call loudly instead of silently
// returning 0.)
actor Calc {
    memory: f64

    fn add(x: f64) {
        memory = memory + x
    }

    fn clear(self) {
        memory = 0.0
    }
}

// Actor with COLLECTION-typed state ([str] + map). These fields must be
// initialized to real empty handles at construction (not a null 0-handle), or
// push/index no-ops on the JIT (len stays 0) and panics `array is null` on AOT.
// The handler replies its current length over a channel so main can assert
// deterministically (no sleep race): after 3 pushes the lengths are 1,2,3.
actor Collector {
    items: [str]
    seen: map<str, i64>

    fn record(self, k: str, reply: i64) {
        self.items = push(self.items, k)
        self.seen[k] = len(self.items)
        send(reply, len(self.items))
    }
}

// An uncaught `throw` inside an actor handler must NOT silently kill the actor:
// it is logged ([actor error] ...) and the actor RECOVERS to process later
// messages. A negative amount throws (no reply); good amounts accumulate and
// reply their running total. Sending good/bad/good must yield 2 replies whose
// second reflects BOTH good messages -- proving the actor survived the throw.
actor Adder {
    sum: i64

    fn add(self, x: i64, reply: i64) {
        if x < 0 {
            throw "negative"
        }
        sum = sum + x
        send(reply, sum)
    }
}

// Actor-to-actor delegation: a method call on an actor stored in ANOTHER
// actor's FIELD (`self.target.tick(..)`). The field's actor type was erased to
// i64 at registration, so the receiver's type read back as i64, the actor-
// dispatch (mailbox enqueue) branch never fired, and the call emitted a bare
// unmangled `tick` symbol -> link failure on both backends. Now the field's
// logical actor type is recovered for dispatch. Delegation must deliver.
actor Worker2 {
    total: i64
    fn tick(self, n: i64, reply: i64) {
        total = total + n
        send(reply, total)
    }
}

actor Dispatcher {
    worker: Worker2
    fn wire(self, w: Worker2) {
        self.worker = w
    }
    fn relay(self, n: i64, reply: i64) {
        self.worker.tick(n, reply)
    }
}

// An actor collection field REASSIGNED from a LOCAL variable must PERSIST across
// messages. `self.data = someLocal` did a raw ARC-unaware store: it never
// released the old value AND aliased the still-live local, whose scope-end drop
// then freed the actor's persistent state (silent use-after-free / lost write).
// The push-chain form persisted only by luck (fresh RHS, no other owner).
// An actor method called from INSIDE a `spawn { }` block: the spawn body
// re-materializes captured vars as params, whose actor type was erased to i64,
// so `sink.absorb(..)` emitted a bare unmangled symbol -> link failure both
// backends. Now a captured actor's logical type is recovered for dispatch.
actor Sink {
    acc: i64
    fn absorb(self, v: i64, reply: i64) {
        self.acc = self.acc + v
        send(reply, self.acc)
    }
}

fn pass_through(s: Sink) -> Sink {
    return s
}

actor Bag {
    data: [i64]
    fn fill(self, n: i64) {
        let mut fresh: [i64] = []
        let mut i: i64 = 0
        while i < n {
            fresh = push(fresh, i)
            i = i + 1
        }
        self.data = fresh
    }
    fn size(self, reply: i64) {
        send(reply, len(self.data))
    }
}

// A match INSIDE a try block, and a nested-enum-in-tuple match with early-return
// arms from fn params -- both created void-but-mutable placeholder locals whose
// entry alloca was skipped, so AOT failed to build (`undefined value %_N.addr`).
fn match_in_try(n: i64) -> i64 {
    try {
        match n {
            0 => return 100,
            _ => return n * 2,
        }
    } catch e {
        return -1
    }
    return 0
}

fn nested_enum_tuple(o: Option<i64>, b: i64) -> i64 {
    match (1, (o, b), 9) {
        (n, (Some(v), bb), t) => return n + v + bb + t,
        (n, (None(), bb), t) => return 0 - (n + bb + t),
    }
}

fn to_result(n: i64) -> Result<i64, str> {
    try {
        if n < 0 {
            throw "negative: {n}"
        }
        Ok(n * 2)
    } catch e {
        Err(e)
    }
}

fn boom(n: i64) -> i64 {
    if n > 0 {
        throw "level {n}"
    }
    return 0
}

fn worker(ch: i64, n: i64) {
    let mut total = 0
    let mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    send(ch, total)
}

fn main() {
    // Catch binds the stringified thrown value.
    try {
        throw 42
    } catch e {
        expect(e == "42", "int throw stringifies")
    }

    // Cross-function throw with interpolation.
    try {
        boom(7)
        expect(false, "throw must unwind")
    } catch e {
        expect(e == "level 7", "cross-fn throw message")
    }

    // Execution continues after try/catch; rethrow reaches outer.
    let mut path = ""
    try {
        try {
            throw "inner"
        } catch e {
            path = path + "i(" + e + ")"
            throw "outer"
        }
    } catch e2 {
        path = path + "o(" + e2 + ")"
    }
    path = path + "done"
    expect(path == "i(inner)o(outer)done", "nested rethrow order")

    // No throw -> catch skipped.
    let mut ran = false
    try {
        ran = true
    } catch e {
        expect(false, "catch must not run")
    }
    expect(ran, "try body runs")

    // spawn + channels: three workers, deterministic totals.
    let ch = chan()
    spawn { worker(ch, 10) }
    spawn { worker(ch, 100) }
    spawn { worker(ch, 1000) }
    let mut grand = 0
    let mut got = 0
    while got < 3 {
        grand = grand + recv(ch)
        got = got + 1
    }
    expect(grand == 55 + 5050 + 500500, "spawn + channel totals")

    // match-in-try + nested-enum-in-tuple with early returns (void-but-mutable
    // placeholder locals previously got no entry alloca -> AOT `undefined %_N.addr`).
    expect(match_in_try(0) == 100, "match inside try builds (AOT)")
    expect(match_in_try(5) == 10, "match inside try wildcard arm")
    expect(nested_enum_tuple(Some(9), 2) == 21, "nested-enum-in-tuple early-return some")
    expect(nested_enum_tuple(None(), 2) == 0 - 12, "nested-enum-in-tuple early-return none")

    // catch -> Err(e) tail expression: the caught message must survive.
    match to_result(5) {
        Ok(v) => expect(v == 10, "to_result ok"),
        Err(e) => expect(false, "to_result unexpected err: {e}"),
    }
    match to_result(-3) {
        Ok(v) => expect(false, "to_result unexpected ok: {v}"),
        Err(e) => expect(e == "negative: -3", "catch->Err(e) tail message survives"),
    }

    // Actor with a void (fire-and-forget) handler must construct and run,
    // updating state correctly via message sends.
    let calc = Calc()
    calc.add(5.0)
    calc.clear()

    // Actor with collection state: push into a [str] field across 3 messages;
    // each handler replies its length over a channel. Lengths must be 1,2,3
    // (sum 6) -- a null-initialized collection field would keep len at 0 (JIT)
    // or panic (AOT). Deterministic via blocking recv, no sleep.
    let rch = chan()
    let col = Collector()
    col.record("x", rch)
    col.record("y", rch)
    col.record("z", rch)
    let mut lensum = 0
    let mut rgot = 0
    while rgot < 3 {
        lensum = lensum + recv(rch)
        rgot = rgot + 1
    }
    expect(lensum == 6, "actor [str]/map state persists (1+2+3), not null-init")

    // Actor recovers from an uncaught throw in a handler: send good(5),
    // bad(-1 throws, no reply), good(10). We must get exactly 2 replies; the
    // second is 15 (5+10), proving the actor survived the throw and its state
    // is intact. A regression (actor dies on throw) would never send the 2nd
    // reply. The throw is logged to stderr as `[actor error] ...` (not asserted
    // here since it's stderr), but it is NOT silent and NOT fatal.
    let ach = chan()
    let adder = Adder()
    adder.add(5, ach)
    adder.add(-1, ach)
    adder.add(10, ach)
    let r1 = recv(ach)
    let r2 = recv(ach)
    expect(r1 + r2 == 5 + 15, "actor recovers from uncaught throw, processes later messages")

    // Actor-to-actor delegation via an actor-typed field: Dispatcher.relay
    // delegates to its Worker2 field, which replies its running total.
    let dch = chan()
    let w = Worker2()
    let disp = Dispatcher()
    disp.wire(w)
    disp.relay(7, dch)
    disp.relay(3, dch)
    let d1 = recv(dch)
    let d2 = recv(dch)
    expect(d1 + d2 == 7 + 10, "actor delegates to an actor-typed field (7, then 10)")

    // Actor collection field reassigned from a local persists across messages.
    let bch = chan()
    let bag = Bag()
    bag.fill(5)
    bag.size(bch)
    let bsz = recv(bch)
    bag.fill(2)
    bag.size(bch)
    let bsz2 = recv(bch)
    expect(bsz == 5 and bsz2 == 2, "actor field reassigned from local persists (5, then 2)")

    // Actor method invoked from inside a spawn { } block (worker -> collector).
    let sjobs = chan()
    let sdone = chan()
    let sink = Sink()
    spawn { let sv = recv(sjobs)  sink.absorb(sv, sdone) }
    send(sjobs, 42)
    expect(recv(sdone) == 42, "actor method called from inside a spawn block delivers")

    // Actor RETURNED from a function: the fn's return-type actor annotation was
    // erased to i64 at signature registration, so a call-expression receiver
    // (`pass_through(sink2).absorb(..)`) emitted a bare unmangled symbol -> link
    // failure. fn_return_actor_types now recovers it, for chained, annotated-let,
    // and un-annotated-let receivers alike.
    let s2done = chan()
    let sink2 = Sink()
    pass_through(sink2).absorb(11, s2done)
    expect(recv(s2done) == 11, "actor returned from a fn: chained call dispatches")
    let held = pass_through(sink2)
    held.absorb(4, s2done)
    expect(recv(s2done) == 15, "actor returned from a fn: un-annotated let dispatches")

    println("conformance errors+concurrency: PASS")
}
