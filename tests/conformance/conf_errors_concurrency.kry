// Conformance: try/catch/throw semantics + spawn/channels. (Reference
use std::option::{Option, Some, None}
// chapters 7 (errors), 9 (concurrency).)

use std::result::{Result, Ok, Err, and_then, or_else, unwrap_or}

// Result.and_then/or_else return f's Result value DIRECTLY (unlike `map`, which
// re-wraps). With the old bare `Result` return + untyped `f: fn`, the payload
// erased to i64 and AOT silently returned `Err("")` instead of the correct
// `Ok(..)` (JIT was fine). The combinators are now generic; a CLOSURE arg
// (untyped fn) leaves the result generic param unbound, so the monomorphized
// drop glue referenced an undefined `__kryos_drop_<U>` -- now skipped for
// unresolved-generic placeholder types.
fn inc_ok(x: i64) -> Result<i64, str> {
    return Ok(x + 1)
}

fn recover_ok(e: str) -> Result<i64, str> {
    return Ok(0)
}

use std::chan::{new_channel, close, fan_out, send_val, receive, try_receive}

fn double_it(x: i64) -> i64 {
    return x * 2
}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

// Actor handlers are dispatched asynchronously: each actor runs on its own OS
// thread and `send` just enqueues a message into its mailbox -- there is no
// reply channel, so a handler's return value can never reach the call site.
// `add` is therefore declared VOID (fire-and-forget), which is the only kind
// of handler that can be called correctly today. (A handler whose BODY
// declares a non-void return, e.g. `fn add(x: f64) -> f64 { return memory }`,
// still type-checks on its own -- see tests/type_soundness.sh -- but CALLING
// it is a compile error: request-response needs runtime support that doesn't
// exist yet, so the checker rejects the call loudly instead of silently
// returning 0.)
actor Calc {
    memory: f64

    fn add(x: f64) {
        memory = memory + x
    }

    fn clear(self) {
        memory = 0.0
    }
}

// Actor with COLLECTION-typed state ([str] + map). These fields must be
// initialized to real empty handles at construction (not a null 0-handle), or
// push/index no-ops on the JIT (len stays 0) and panics `array is null` on AOT.
// The handler replies its current length over a channel so main can assert
// deterministically (no sleep race): after 3 pushes the lengths are 1,2,3.
actor Collector {
    items: [str]
    seen: map<str, i64>

    fn record(self, k: str, reply: i64) {
        self.items = push(self.items, k)
        self.seen[k] = len(self.items)
        send(reply, len(self.items))
    }
}

// An uncaught `throw` inside an actor handler must NOT silently kill the actor:
// it is logged ([actor error] ...) and the actor RECOVERS to process later
// messages. A negative amount throws (no reply); good amounts accumulate and
// reply their running total. Sending good/bad/good must yield 2 replies whose
// second reflects BOTH good messages -- proving the actor survived the throw.
actor Adder {
    sum: i64

    fn add(self, x: i64, reply: i64) {
        if x < 0 {
            throw "negative"
        }
        sum = sum + x
        send(reply, sum)
    }
}

// Actor-to-actor delegation: a method call on an actor stored in ANOTHER
// actor's FIELD (`self.target.tick(..)`). The field's actor type was erased to
// i64 at registration, so the receiver's type read back as i64, the actor-
// dispatch (mailbox enqueue) branch never fired, and the call emitted a bare
// unmangled `tick` symbol -> link failure on both backends. Now the field's
// logical actor type is recovered for dispatch. Delegation must deliver.
actor Worker2 {
    total: i64
    fn tick(self, n: i64, reply: i64) {
        total = total + n
        send(reply, total)
    }
}

actor Dispatcher {
    worker: Worker2
    fn wire(self, w: Worker2) {
        self.worker = w
    }
    fn relay(self, n: i64, reply: i64) {
        self.worker.tick(n, reply)
    }
}

// An actor collection field REASSIGNED from a LOCAL variable must PERSIST across
// messages. `self.data = someLocal` did a raw ARC-unaware store: it never
// released the old value AND aliased the still-live local, whose scope-end drop
// then freed the actor's persistent state (silent use-after-free / lost write).
// The push-chain form persisted only by luck (fresh RHS, no other owner).
// An actor method called from INSIDE a `spawn { }` block: the spawn body
// re-materializes captured vars as params, whose actor type was erased to i64,
// so `sink.absorb(..)` emitted a bare unmangled symbol -> link failure both
// backends. Now a captured actor's logical type is recovered for dispatch.
actor Sink {
    acc: i64
    fn absorb(self, v: i64, reply: i64) {
        self.acc = self.acc + v
        send(reply, self.acc)
    }
}

fn pass_through(s: Sink) -> Sink {
    return s
}

// An actor handler taking an aggregate (multi-field STRUCT) message argument.
// The mailbox carries i64 slots, so the struct must be BOXED on send (it was
// passed as a first-class `%Struct` where an i64 was expected -> AOT build
// fail) and reconstructed byval in the handler; the void handler bound to a
// dispatch temp also must not name its void call. JIT always boxed aggregates
// (Cranelift), so this was an AOT-only build failure -- now a parity fix.
struct Vec2 { a: i64, b: i64 }
actor Summer2 {
    total: i64
    fn addv(self, v: Vec2, reply: i64) {
        self.total = self.total + v.a + v.b
        send(reply, self.total)
    }
}

actor Bag {
    data: [i64]
    fn fill(self, n: i64) {
        let mut fresh: [i64] = []
        let mut i: i64 = 0
        while i < n {
            fresh = push(fresh, i)
            i = i + 1
        }
        self.data = fresh
    }
    fn size(self, reply: i64) {
        send(reply, len(self.data))
    }
}

// A match INSIDE a try block, and a nested-enum-in-tuple match with early-return
// arms from fn params -- both created void-but-mutable placeholder locals whose
// entry alloca was skipped, so AOT failed to build (`undefined value %_N.addr`).
fn match_in_try(n: i64) -> i64 {
    try {
        match n {
            0 => return 100,
            _ => return n * 2,
        }
    } catch e {
        return -1
    }
    return 0
}

fn nested_enum_tuple(o: Option<i64>, b: i64) -> i64 {
    match (1, (o, b), 9) {
        (n, (Some(v), bb), t) => return n + v + bb + t,
        (n, (None(), bb), t) => return 0 - (n + bb + t),
    }
}

fn to_result(n: i64) -> Result<i64, str> {
    try {
        if n < 0 {
            throw "negative: {n}"
        }
        Ok(n * 2)
    } catch e {
        Err(e)
    }
}

fn boom(n: i64) -> i64 {
    if n > 0 {
        throw "level {n}"
    }
    return 0
}

// A `throw` as a match-ARM BODY must unwind to an enclosing try/catch, not
// abort the process. It used to desugar to `assert(false, msg)` -- a hard
// process abort (exit 127) that no catch could intercept, predating working
// exceptions. Now it lowers to a real `Stmt::Throw`. Separately: BINDING a
// match-with-a-throw-arm to a local must infer the LIVE arm's type (str/i64),
// not void -- the throw arm is a Block whose value position is void, and
// picking it as the whole match's result type made AOT store into a void slot
// (`store void 42` / `undefined %_N.addr`). infer_match_result_type now skips
// divergent arms.
fn pick_or_throw(items: [i64], i: i64) -> i64 {
    match i {
        0 => throw "zero index",
        _ => return items[i],
    }
}

fn classify_sign(x: i64) -> str {
    let r = match x {
        0 => throw "no zero",
        _ => "nonzero",
    }
    return r
}

fn worker(ch: i64, n: i64) {
    let mut total = 0
    let mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    send(ch, total)
}

fn main() {
    // Catch binds the stringified thrown value.
    try {
        throw 42
    } catch e {
        expect(e == "42", "int throw stringifies")
    }

    // Cross-function throw with interpolation.
    try {
        boom(7)
        expect(false, "throw must unwind")
    } catch e {
        expect(e == "level 7", "cross-fn throw message")
    }

    // Execution continues after try/catch; rethrow reaches outer.
    let mut path = ""
    try {
        try {
            throw "inner"
        } catch e {
            path = path + "i(" + e + ")"
            throw "outer"
        }
    } catch e2 {
        path = path + "o(" + e2 + ")"
    }
    path = path + "done"
    expect(path == "i(inner)o(outer)done", "nested rethrow order")

    // throw as a match-arm body unwinds to try/catch (was an uncatchable abort).
    try {
        let v = pick_or_throw([10, 20], 0)
        expect(false, "match-arm throw should unwind, not abort")
    } catch e {
        expect(e == "zero index", "match-arm throw caught by enclosing try")
    }
    expect(pick_or_throw([10, 20], 1) == 20, "match-arm non-throw arm returns value")
    // A let-bound match with a throw arm infers the live arm's type (str), and
    // the throw arm still unwinds when taken.
    expect(classify_sign(5) == "nonzero", "let-bound match with throw arm infers str (not void)")
    try {
        let z = classify_sign(0)
        expect(false, "classify_sign(0) should throw")
    } catch e {
        expect(e == "no zero", "let-bound match throw arm unwinds when taken")
    }

    // No throw -> catch skipped.
    let mut ran = false
    try {
        ran = true
    } catch e {
        expect(false, "catch must not run")
    }
    expect(ran, "try body runs")

    // spawn + channels: three workers, deterministic totals.
    let ch = chan()
    spawn { worker(ch, 10) }
    spawn { worker(ch, 100) }
    spawn { worker(ch, 1000) }
    let mut grand = 0
    let mut got = 0
    while got < 3 {
        grand = grand + recv(ch)
        got = got + 1
    }
    expect(grand == 55 + 5050 + 500500, "spawn + channel totals")

    // A `spawn { }` body capturing a CLOSURE, a str, and an array marshals each
    // into the uniform i64 spawn-env slot array. Pointer-shaped captures
    // (closure/str/array) were stored with a `store i64 <ptr>` type mismatch
    // ("defined with type 'ptr' but expected 'i64'" -> AOT build-fail; JIT is
    // untyped so it slipped through). Each is now ptrtoint'd before the store.
    let cap_ch = chan()
    let mult = |x: i64| x * 3
    let label = "cap"
    let vals = [4, 5, 6]
    spawn {
        let m = mult(len(vals))          // 3 * 3 = 9
        send(cap_ch, m + len(label))     // 9 + 3 = 12
    }
    expect(recv(cap_ch) == 12, "spawn captures closure+str+array (uniform i64 marshalling)")

    // Channel close works on BOTH backends. `close_chan` was mapped only in the
    // LLVM backend, so `std::chan::close` failed to LINK on `kryos run`/Cranelift
    // ("unresolved external symbol close_chan") while working on AOT. A
    // closed+drained channel's try_receive reports not-ok.
    let cch = new_channel()
    send_val(cch, 99)
    let g1 = try_receive(cch)
    expect(g1.ok and g1.value == 99, "try_receive gets the sent value")
    let cch2 = close(cch)
    let g2 = try_receive(cch2)
    expect(not g2.ok, "try_receive on closed+drained channel is not-ok (close works on both backends)")

    // fan_out distributes work to N workers and TERMINATES when the source is
    // closed, so the exit-time join does not hang. The workers previously looped
    // on an infinite blocking recv, so kryos_spawn_wait_all (which joins every
    // spawned thread at exit -- spawned threads are NOT daemons) hung forever.
    // They now poll with chan_try_recv and exit on source-close+drain.
    let fsrc = new_channel()
    let fout = fan_out(fsrc, 2, double_it)
    send_val(fsrc, 3)
    send_val(fsrc, 4)
    send_val(fsrc, 5)
    let mut ftotal = 0
    let mut fgot = 0
    while fgot < 3 {
        ftotal = ftotal + receive(fout)
        fgot = fgot + 1
    }
    let fsrc_closed = close(fsrc)
    expect(ftotal == 24, "fan_out 2 workers double all inputs 2*(3+4+5); terminates on source close (no exit hang)")

    // `select` over std::chan::Channel STRUCTS (not just raw chan() handles):
    // select polls raw i64 handles, so a Channel-struct branch operand must have
    // its `.raw` extracted. Previously the aggregate was reinterpreted as a
    // pointer and the runtime dereferenced garbage -- JIT segfault, AOT hang.
    let sa: Channel = new_channel()
    let sb: Channel = new_channel()
    send_val(sb, 222)
    let mut selected = 0
    select {
        v sa => { selected = 1000 + v }
        v sb => { selected = 2000 + v }
    }
    expect(selected == 2222, "select over std::chan::Channel structs picks the ready channel (.raw extracted)")

    // match-in-try + nested-enum-in-tuple with early returns (void-but-mutable
    // placeholder locals previously got no entry alloca -> AOT `undefined %_N.addr`).
    expect(match_in_try(0) == 100, "match inside try builds (AOT)")
    expect(match_in_try(5) == 10, "match inside try wildcard arm")
    expect(nested_enum_tuple(Some(9), 2) == 21, "nested-enum-in-tuple early-return some")
    expect(nested_enum_tuple(None(), 2) == 0 - 12, "nested-enum-in-tuple early-return none")

    // catch -> Err(e) tail expression: the caught message must survive.
    match to_result(5) {
        Ok(v) => expect(v == 10, "to_result ok"),
        Err(e) => expect(false, "to_result unexpected err: {e}"),
    }
    match to_result(-3) {
        Ok(v) => expect(false, "to_result unexpected ok: {v}"),
        Err(e) => expect(e == "negative: -3", "catch->Err(e) tail message survives"),
    }

    // Actor with a void (fire-and-forget) handler must construct and run,
    // updating state correctly via message sends.
    let calc = Calc()
    calc.add(5.0)
    calc.clear()

    // Actor with collection state: push into a [str] field across 3 messages;
    // each handler replies its length over a channel. Lengths must be 1,2,3
    // (sum 6) -- a null-initialized collection field would keep len at 0 (JIT)
    // or panic (AOT). Deterministic via blocking recv, no sleep.
    let rch = chan()
    let col = Collector()
    col.record("x", rch)
    col.record("y", rch)
    col.record("z", rch)
    let mut lensum = 0
    let mut rgot = 0
    while rgot < 3 {
        lensum = lensum + recv(rch)
        rgot = rgot + 1
    }
    expect(lensum == 6, "actor [str]/map state persists (1+2+3), not null-init")

    // Actor recovers from an uncaught throw in a handler: send good(5),
    // bad(-1 throws, no reply), good(10). We must get exactly 2 replies; the
    // second is 15 (5+10), proving the actor survived the throw and its state
    // is intact. A regression (actor dies on throw) would never send the 2nd
    // reply. The throw is logged to stderr as `[actor error] ...` (not asserted
    // here since it's stderr), but it is NOT silent and NOT fatal.
    let ach = chan()
    let adder = Adder()
    adder.add(5, ach)
    adder.add(-1, ach)
    adder.add(10, ach)
    let r1 = recv(ach)
    let r2 = recv(ach)
    expect(r1 + r2 == 5 + 15, "actor recovers from uncaught throw, processes later messages")

    // Actor-to-actor delegation via an actor-typed field: Dispatcher.relay
    // delegates to its Worker2 field, which replies its running total.
    let dch = chan()
    let w = Worker2()
    let disp = Dispatcher()
    disp.wire(w)
    disp.relay(7, dch)
    disp.relay(3, dch)
    let d1 = recv(dch)
    let d2 = recv(dch)
    expect(d1 + d2 == 7 + 10, "actor delegates to an actor-typed field (7, then 10)")

    // Actor collection field reassigned from a local persists across messages.
    let bch = chan()
    let bag = Bag()
    bag.fill(5)
    bag.size(bch)
    let bsz = recv(bch)
    bag.fill(2)
    bag.size(bch)
    let bsz2 = recv(bch)
    expect(bsz == 5 and bsz2 == 2, "actor field reassigned from local persists (5, then 2)")

    // Actor method invoked from inside a spawn { } block (worker -> collector).
    let sjobs = chan()
    let sdone = chan()
    let sink = Sink()
    spawn { let sv = recv(sjobs)  sink.absorb(sv, sdone) }
    send(sjobs, 42)
    expect(recv(sdone) == 42, "actor method called from inside a spawn block delivers")

    // Actor RETURNED from a function: the fn's return-type actor annotation was
    // erased to i64 at signature registration, so a call-expression receiver
    // (`pass_through(sink2).absorb(..)`) emitted a bare unmangled symbol -> link
    // failure. fn_return_actor_types now recovers it, for chained, annotated-let,
    // and un-annotated-let receivers alike.
    let s2done = chan()
    let sink2 = Sink()
    pass_through(sink2).absorb(11, s2done)
    expect(recv(s2done) == 11, "actor returned from a fn: chained call dispatches")
    let held = pass_through(sink2)
    held.absorb(4, s2done)
    expect(recv(s2done) == 15, "actor returned from a fn: un-annotated let dispatches")

    // Actor handler with a multi-field struct message argument (boxed on send,
    // reconstructed byval in the handler) across two messages, replying totals.
    let vch = chan()
    let summer = Summer2()
    summer.addv(Vec2 { a: 10, b: 32 }, vch)
    summer.addv(Vec2 { a: 1, b: 2 }, vch)
    let sv1 = recv(vch)
    let sv2 = recv(vch)
    expect(sv1 == 42 and sv2 == 45, "actor handler with a struct message arg persists state (42, then 45)")

    // Result.and_then/or_else combinators (was an AOT silent Err miscompile for
    // named fns, and an AOT drop-glue build-fail for closures).
    let ck1: Result<i64, str> = Ok(21)
    let at1: Result<i64, str> = and_then(ck1, inc_ok)
    expect(unwrap_or(at1, -1) == 22, "Result.and_then named fn returns Ok(22), not Err (AOT)")
    let ck2: Result<i64, str> = Ok(5)
    let at2: Result<i64, str> = and_then(ck2, |x| Ok(x * 10))
    expect(unwrap_or(at2, -1) == 50, "Result.and_then closure returns Ok(50) (no drop-glue build-fail)")
    let ck3: Result<i64, str> = Err("keep")
    let at3: Result<i64, str> = and_then(ck3, inc_ok)
    expect(unwrap_or(at3, -9) == -9, "Result.and_then passes Err through unchanged")
    let ck4: Result<i64, str> = Err("boom")
    let oe1: Result<i64, str> = or_else(ck4, recover_ok)
    expect(unwrap_or(oe1, -1) == 0, "Result.or_else recovers Err to Ok(0)")
    // A try/catch used as the TAIL VALUE of a nested block expression must yield

    // the executed arm's value (there is no Expr::TryCatch; try is statement-only,

    // so the block-wrapper form is the ONLY way to bind a try/catch result). It

    // silently produced 0 on both backends -- the block-rvalue lowering didn't

    // route the try/catch tail through the value path, AND the type-checker typed

    // the block as void (which the LLVM void-coercion turned into a literal 0).

    let tc_ok = { try { 11 } catch e { 22 } }

    expect(tc_ok == 11, "try/catch block-tail value: no-throw yields the try value")

    let tc_err = { try { throw "boom"  11 } catch e { 22 } }

    expect(tc_err == 22, "try/catch block-tail value: throw yields the catch value")

    let tc_str = { try { "okv" } catch e { "cv" } }

    expect(tc_str == "okv", "try/catch block-tail value: str payload round-trips")

    let tc_cond = if true { try { 7 } catch e { -1 } } else { 0 }

    expect(tc_cond == 7, "try/catch as an if-branch block-tail value type-checks and runs")

    // The try body's OWN tail can itself be a value `if` (parsed as Stmt::If,
    // not Stmt::Expr): `try { if c { 1 } else { 2 } } catch ..` must yield the
    // if's value, not Ok(0). (match-as-try-tail already worked; only if did not.)
    let tc_if_then = { try { if true { 5 } else { 6 } } catch e { 99 } }
    expect(tc_if_then == 5, "try body tail is a value-if (then branch)")
    let tc_if_else = { try { if false { 5 } else { 6 } } catch e { 99 } }
    expect(tc_if_else == 6, "try body tail is a value-if (else branch)")


    println("conformance errors+concurrency: PASS")
}
