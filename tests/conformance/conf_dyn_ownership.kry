// Conformance (2026-10-29): a `dyn Trait` value is an ARC fat box that owns its
// own reference to the struct it was built from. A struct passed to a dyn
// param and a let-bound dyn used to leak the fat box, the struct and its heap
// fields on every evaluation (~125-186MB per 1M); now the fat box is retained
// by every holder that outlives a call (copy, field, return, closure capture)
// and released by its last one, and its ARC drop hook releases the struct.
// This program pins the use-after-free / double-free direction: a dyn built
// from a struct that is still used afterwards, a dyn passed twice, a dyn copied
// and outliving its source, a dyn returned through several frames, a dyn field
// of a struct that is copied, passed and returned from, a reassigned dyn, a
// dyn captured by a returned closure, early return / break / throw while a
// dyn is live. Every read is checked after junk allocations reuse freed
// memory, so a dangling fat box or struct shows up with real frees. Run under
// KRYOS_FREE_DIAG on both backends, and on AOT with real frees, by
// tests/no_double_free.sh.
//
// Also pinned here (2026-10-29, review of the first fix): a generic function
// instantiated with a dyn type (its instance must keep the dyn type, or the
// callee returns its borrowed param without a retain while the caller
// releases the result), and a dyn coerced from an if / match VALUE (struct
// literal arms, named struct arms that stay usable afterwards, dyn-valued
// arms inside a loop).

trait Sh {
    fn area(self: Self) -> i64
    fn tag(self: Self) -> str
}

struct Sq { side: i64, label: str }
struct Rc { w: i64, h: i64, label: str }
struct Pt { x: i64, y: i64 }

impl Sh for Sq {
    fn area(self: Sq) -> i64 { return self.side * self.side }
    fn tag(self: Sq) -> str { return "sq-" + self.label }
}
impl Sh for Rc {
    fn area(self: Rc) -> i64 { return self.w * self.h }
    fn tag(self: Rc) -> str { return "rc-" + self.label }
}
impl Sh for Pt {
    fn area(self: Pt) -> i64 { return self.x * self.y }
    fn tag(self: Pt) -> str { return "pt" }
}

struct Holder { d: dyn Sh, n: i64 }

struct Bg { n: i64, label: str, xs: [i64] }
impl Sh for Bg {
    fn area(self: Bg) -> i64 { return self.n * 2 + len(self.xs) }
    fn tag(self: Bg) -> str { return "bg-" + self.label }
}
fn mkbg(i: i64) -> Bg {
    return Bg { n: i, label: "b{i}", xs: [i, i + 1] }
}
fn gen_id<T>(x: T) -> T { return x }
fn gen_first<T>(a: T, b: T) -> T { return a }
struct Wrap<T> { v: T, k: i64 }
fn gen_wrap<T>(x: T) -> Wrap<T> { return Wrap { v: x, k: 1 } }

fn pick_dyn(i: i64) -> dyn Sh {
    let na = Sq { side: i, label: "pa{i}" }
    let nb = Sq { side: i + 1, label: "pb{i}" }
    let d: dyn Sh = match i % 2 {
        0 => nb,
        _ => na,
    }
    return d
}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn churn(i: i64) -> i64 {
    let mut junk: [str] = []
    let mut j = 0
    while j < 80 {
        junk = push(junk, "JUNK-{i}-{j}-xxxxxxxx")
        j = j + 1
    }
    let a = Sq { side: 7, label: "junk{i}" }
    let b = Rc { w: 3, h: 4, label: "junk{i}" }
    return len(junk) + a.side + b.w
}

fn area_of(d: dyn Sh) -> i64 {
    return d.area()
}

fn tag_of(d: dyn Sh) -> str {
    return d.tag()
}

fn twice(d: dyn Sh) -> i64 {
    let a = area_of(d)
    let b = area_of(d)
    return a + b
}

fn pass(d: dyn Sh) -> dyn Sh {
    return d
}

fn pass_via_local(d: dyn Sh) -> dyn Sh {
    let e: dyn Sh = d
    return e
}

fn mk_sq(i: i64) -> dyn Sh {
    return Sq { side: i, label: "m{i}" }
}

fn mk_local(i: i64) -> dyn Sh {
    let s: dyn Sh = Rc { w: i, h: 2, label: "l{i}" }
    return s
}

fn mk_named_struct(i: i64) -> dyn Sh {
    let r = Rc { w: i, h: 3, label: "n{i}" }
    let d: dyn Sh = r
    return d
}

fn mk_pick(c: bool, i: i64) -> dyn Sh {
    if c {
        return Sq { side: i, label: "pa{i}" }
    }
    return Rc { w: i, h: 5, label: "pb{i}" }
}

fn from_param(p: Sq) -> i64 {
    let a = area_of(p)
    let d: dyn Sh = p
    return a + d.area()
}

fn hold(d: dyn Sh, n: i64) -> Holder {
    return Holder { d: d, n: n }
}

fn unhold(h: Holder) -> dyn Sh {
    return h.d
}

fn hold_area(h: Holder) -> i64 {
    return h.d.area() + h.n
}

fn early(c: bool, i: i64) -> i64 {
    let d: dyn Sh = Sq { side: i, label: "e{i}" }
    if c {
        return d.area()
    }
    let e: dyn Sh = Rc { w: i, h: 2, label: "f{i}" }
    return d.area() + e.area()
}

fn closure_over(d: dyn Sh) -> fn() -> i64 {
    return || d.area()
}

fn closure_over_local(i: i64) -> fn() -> i64 {
    let d: dyn Sh = Sq { side: i, label: "c{i}" }
    return || d.area() + 1
}

fn thrower(d: dyn Sh) -> i64 {
    if d.area() > 0 {
        throw "boom"
    }
    return 0
}

fn main() {
    // 1. struct still used after being lent to a dyn param (literal and named).
    let q = Sq { side: 5, label: "q" }
    expect(area_of(q) == 25, "named struct to dyn param")
    expect(churn(1) > 0, "churn")
    expect(q.side == 5 and q.label == "q", "struct intact after dyn param")
    expect(area_of(Sq { side: 6, label: "tmp" }) == 36, "literal to dyn param")
    expect(tag_of(Rc { w: 2, h: 3, label: "r" }) == "rc-r", "rc literal tag")
    expect(area_of(Pt { x: 3, y: 4 }) == 12, "all-scalar struct to dyn param")

    // 2. a dyn passed twice, and a let-bound dyn passed repeatedly.
    expect(twice(q) == 50, "dyn twice from named struct")
    let d: dyn Sh = q
    expect(twice(d) == 50, "let-bound dyn twice")
    expect(area_of(d) == 25, "let-bound dyn again")
    expect(d.tag() == "sq-q", "dyn tag")
    expect(churn(2) > 0, "churn")
    expect(d.area() == 25, "dyn after churn")
    expect(q.side == 5, "source struct after dyn use")

    // 3. a copy of a dyn outlives its source binding.
    let mut keep: dyn Sh = Pt { x: 1, y: 1 }
    {
        let inner: dyn Sh = Sq { side: 9, label: "inner" }
        keep = inner
        expect(inner.area() == 81, "inner")
    }
    expect(churn(3) > 0, "churn")
    expect(keep.area() == 81 and keep.tag() == "sq-inner", "copy outlives source")
    let alias = keep
    keep = Rc { w: 2, h: 2, label: "k2" }
    expect(churn(4) > 0, "churn")
    expect(alias.area() == 81 and alias.tag() == "sq-inner", "alias survives reassignment")
    expect(keep.area() == 4, "reassigned")

    // 4. dyn returned through frames.
    let r1 = mk_sq(4)
    let r2 = mk_local(5)
    let r3 = mk_named_struct(6)
    let r4 = mk_pick(true, 7)
    let r5 = mk_pick(false, 8)
    expect(churn(5) > 0, "churn")
    expect(r1.area() == 16 and r1.tag() == "sq-m4", "returned literal")
    expect(r2.area() == 10 and r2.tag() == "rc-l5", "returned local")
    expect(r3.area() == 18 and r3.tag() == "rc-n6", "returned from named struct")
    expect(r4.area() == 49 and r5.area() == 40, "returned by branch")
    let p1 = pass(mk_sq(3))
    let p2 = pass_via_local(r1)
    let p3 = pass(pass(p2))
    expect(churn(6) > 0, "churn")
    expect(p1.area() == 9 and p2.area() == 16 and p3.area() == 16, "passed through")
    expect(r1.area() == 16, "source of pass still valid")
    expect(from_param(Sq { side: 3, label: "fp" }) == 18, "struct param to dyn")

    // 5. dyn as a struct field: construct, copy, pass, read back after drops.
    let h = hold(mk_sq(2), 10)
    let h2 = h
    let h3 = Holder { d: Rc { w: 4, h: 4, label: "hf" }, n: 1 }
    expect(churn(7) > 0, "churn")
    expect(hold_area(h) == 14 and hold_area(h2) == 14, "holder copy")
    expect(hold_area(h3) == 17, "holder literal")
    let back = unhold(h3)
    expect(churn(8) > 0, "churn")
    expect(back.area() == 16 and back.tag() == "rc-hf", "field read out")
    let h4 = hold(d, 2)
    expect(hold_area(h4) == 27 and d.area() == 25, "named dyn into field")

    // 6. reassignment in a loop, and loops that create dyn values.
    let mut cur: dyn Sh = Pt { x: 2, y: 2 }
    let mut total = 0
    let mut i = 0
    while i < 200 {
        if i % 2 == 0 {
            cur = Sq { side: i, label: "w{i}" }
        } else {
            cur = Rc { w: i, h: 2, label: "w{i}" }
        }
        total = total + cur.area() % 7
        let local: dyn Sh = mk_sq(i)
        total = total + local.area() % 5
        total = total + area_of(Sq { side: i, label: "z{i}" }) % 3
        if i == 150 {
            i = i + 1
            continue
        }
        i = i + 1
    }
    expect(total > 0, "loop total")
    expect(cur.area() == 398, "loop final dyn")

    // 7. early returns with live dyn locals.
    expect(early(true, 3) == 9, "early return")
    expect(early(false, 3) == 15, "fallthrough")

    // 8. closures over a dyn outlive the dyn's scope.
    let c1 = closure_over(Sq { side: 4, label: "cl" })
    let c2 = closure_over_local(5)
    expect(churn(9) > 0, "churn")
    expect(c1() == 16 and c1() == 16, "closure over param")
    expect(c2() == 26, "closure over local")

    // 9. throw while a dyn is live.
    let mut caught = 0
    let mut t = 0
    while t < 50 {
        try {
            let live: dyn Sh = Sq { side: 2, label: "t{t}" }
            let x = thrower(live)
            caught = caught + x
        } catch e {
            caught = caught + 1
        }
        t = t + 1
    }
    expect(caught == 50, "throw with live dyn")

    // 10. a dyn built from an array element survives the element's overwrite.
    let mut arr: [Sq] = [Sq { side: 1, label: "a0" }, Sq { side: 2, label: "a1" }]
    let from_elem: dyn Sh = arr[0]
    arr[0] = Sq { side: 10, label: "a0b" }
    expect(churn(10) > 0, "churn")
    expect(from_elem.area() == 1 and from_elem.tag() == "sq-a0", "dyn from element")
    expect(arr[0].side == 10, "element overwritten")
    expect(area_of(arr[1]) == 4, "element to dyn param")

    // 11. structs holding a dyn, inside containers and overwritten fields.
    let mut hs: [Holder] = []
    hs = push(hs, hold(mk_sq(3), 1))
    hs = push(hs, h3)
    hs = push(hs, Holder { d: Sq { side: 5, label: "arr" }, n: 2 })
    let from_arr = hs[0]
    let kept = hs[2]
    hs[0] = Holder { d: Rc { w: 1, h: 1, label: "over" }, n: 3 }
    expect(churn(11) > 0, "churn")
    expect(hold_area(from_arr) == 10 and hold_area(kept) == 27, "holder read from array")
    expect(hold_area(hs[0]) == 4 and hold_area(hs[1]) == 17, "holder in array")
    expect(from_arr.d.tag() == "sq-m3", "dyn of array holder")
    let mut hm: map<str, Holder> = {}
    hm["a"] = hold(mk_sq(4), 5)
    hm["b"] = Holder { d: Rc { w: 2, h: 5, label: "map" }, n: 0 }
    let from_map = hm["a"]
    hm["a"] = Holder { d: Sq { side: 1, label: "mapb" }, n: 0 }
    expect(churn(12) > 0, "churn")
    expect(hold_area(from_map) == 21 and hold_area(hm["a"]) == 1 and hold_area(hm["b"]) == 10, "holder in map")
    let mut hw = hold(mk_sq(6), 1)
    let before = hw.d
    hw.d = Rc { w: 3, h: 3, label: "fs" }
    expect(churn(13) > 0, "churn")
    expect(before.area() == 36 and hw.d.area() == 9, "field overwrite")
    hw.d = hw.d
    hw.d = before
    expect(hw.d.area() == 36 and before.area() == 36, "field assigned from alias")

    // 12. a generic instantiated with a dyn type: the instance borrows its
    // param and hands it back, so the result needs its own reference.
    let mut gacc = 0
    let mut gexp = 0
    let mut gi = 0
    while gi < 300 {
        let g1 = gen_id(pass(mkbg(gi)))
        let gd: dyn Sh = mkbg(gi)
        let g2 = gen_id(gd)
        let g3 = gen_first(gd, g1)
        let gw = gen_wrap(gd)
        if gi % 50 == 0 {
            expect(churn(gi) > 0, "churn")
        }
        gacc = gacc + g1.area() + g2.area() + g3.area() + gw.v.area() + len(g2.tag()) + gw.k
        gexp = gexp + 4 * (gi * 2 + 2) + len("bg-b{gi}") + 1
        gi = gi + 1
    }
    expect(gacc == gexp, "generic with dyn: {gacc} vs {gexp}")
    expect(gen_id(q).side == 5, "generic over the struct itself")

    // 13. a dyn coerced from an if / match value.
    let mut ii = 0
    while ii < 300 {
        let na = Sq { side: ii, label: "na{ii}" }
        let nb = Sq { side: ii + 1, label: "nb{ii}" }
        let even = ii % 2 == 0
        let d1: dyn Sh = if even { Sq { side: ii, label: "x{ii}" } } else { Sq { side: ii + 1, label: "y{ii}" } }
        let d2: dyn Sh = match ii % 3 {
            0 => Sq { side: ii, label: "m0{ii}" },
            1 => Sq { side: ii + 2, label: "m1{ii}" },
            _ => Sq { side: ii + 3, label: "m2{ii}" },
        }
        let d3: dyn Sh = if even { na } else { nb }
        let d4: dyn Sh = match ii % 2 {
            0 => nb,
            _ => na,
        }
        let mut s5: Sq = match ii % 2 {
            0 => nb,
            _ => na,
        }
        let d6: dyn Sh = if even { mk_sq(ii) } else { pass(mk_sq(ii + 1)) }
        let d7 = pick_dyn(ii)
        s5.side = 999
        if ii % 40 == 0 {
            expect(churn(ii) > 0, "churn")
        }
        let lo = if even { ii } else { ii + 1 }
        let hi = if even { ii + 1 } else { ii }
        let side2 = if ii % 3 == 0 { ii } else { if ii % 3 == 1 { ii + 2 } else { ii + 3 } }
        expect(d1.area() == lo * lo, "if literal arms")
        expect(d2.area() == side2 * side2, "match literal arms")
        expect(d3.area() == lo * lo and d3.tag() == (if even { "sq-na{ii}" } else { "sq-nb{ii}" }), "if named arms")
        expect(d4.area() == hi * hi, "match named arms")
        expect(s5.side == 999 and na.side == ii and nb.side == ii + 1, "match named arms copy")
        expect(na.label == "na{ii}" and nb.label == "nb{ii}", "named structs intact")
        expect(d6.area() == lo * lo, "if dyn arms")
        expect(d7.area() == hi * hi, "dyn returned from a match of named structs")
        ii = ii + 1
    }

    println("dyn ownership ok")
}
