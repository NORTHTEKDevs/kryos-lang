// Conformance: ownership, moves, Copy primitives, @copy struct semantics.
// (Reference chapters 6 + gotcha #23 guarantees.)

use std::result::{Result, Ok, Err}
use std::option::{Option, Some, None}

// F1 regression (gotcha #23 "BROAD crash hazard"): a non-@copy struct with a
// HEAP field, reassigned INSIDE A LOOP from a NESTED-match enum payload, used
// to CRASH both backends (AOT segfault / JIT corrupt, order-dependent). Root
// cause: a `let` declared in one match arm (a value-position block) was not
// dropped at that arm's own scope end, so its drop hoisted to the loop body's
// shared post-match block and fired __kryos_drop_S on a stale/null slot on
// EVERY iteration -- including iterations that took the OTHER arm. This is the
// standard "validate-then-commit via Result" state-machine idiom.
enum F1Tok { Push(i64), Commit }
struct F1Calc { stack: [i64] }

fn f1_run() -> i64 {
    let mut c = F1Calc { stack: [] }
    let toks: [F1Tok] = [F1Tok.Push(3), F1Tok.Commit, F1Tok.Push(4), F1Tok.Commit]
    for t in toks {
        match t {
            F1Tok.Push(n) => {
                let mut s = c.stack
                s = push(s, n)
                c = F1Calc { stack: s }
            },
            F1Tok.Commit => {
                let r: Result<F1Calc, str> = Ok(F1Calc { stack: c.stack })
                match r {
                    Ok(nc) => { c = nc },
                    Err(e) => {},
                }
            },
        }
    }
    return len(c.stack)
}

fn tag_len(s: str) -> i64 { return len(s) }

// Regression for the F1-fix follow-up: a match-arm body whose LAST statement is
// a CALL consuming a heap local `let`-bound earlier in the SAME arm must run the
// call BEFORE the arm-scope drop frees that local. The F1 fix (emit_named_scope_
// drops from the block-rvalue path) at first dropped the local before the caller
// emitted the tail call's un-emitted rvalue, so `tag_len(tag)` / `println(tag)`
// saw a freed (empty) string. Fixed by materializing the non-identifier tail
// into a temp before the drops.
fn f1_tail_call(n: i64) -> i64 {
    let mut total = 0
    let mut i = 0
    while i < n {
        let contrib = match 1 {
            1 => {
                let tag = "ab" + to_string(i)
                tag_len(tag)
            }
            _ => { 0 }
        }
        total = total + contrib
        i = i + 1
    }
    return total
}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

@copy
struct Pair {
    a: i64,
    b: i64,
}

@copy
struct Bag {
    name: str,
    items: [i64],
}

fn mutate_pair(p: Pair) {
    p.a = 999
}

fn consume(s: str) -> i64 {
    return len(s)
}

enum Tag { X, Y, Z }

// An if-EXPRESSION bound to a `let`, whose two MUTUALLY-EXCLUSIVE branches each
// match the SAME enum param, must not falsely report `t` used-after-move in the
// second branch. The ownership analysis walked if-expression branches
// SEQUENTIALLY (a move in the then branch leaked into the else branch) -> a
// false E0300 that HARD-BLOCKED valid code. Now if-expr branches fork/merge the
// move-state like match arms and Stmt::If already did.
fn branch_classify(n: i64, t: Tag) -> str {
    let r = if n > 0 {
        match t { Tag.X => "x1", _ => "o1" }
    } else {
        match t { Tag.X => "x2", _ => "o2" }
    }
    return r
}

// A BARE enum-variant pattern (`Data(p)`, not `Msg.Data(p)`) binding a STRUCT
// payload, then copying one of its heap (ARC-shared) fields into a local and
// reusing the original field, must compile. The bare pattern left the enum name
// empty, so the ownership pass couldn't resolve the payload's field types,
// registered no struct type for `p`, and move-tracked `p.tags` -> a FALSE E0303
// on `p.tags[0]`. (Qualified `Msg.Data(p)` already worked -- it carries the enum
// name.) ARC semantics: copying an array handle SHARES it; the source stays live.
struct OwnPayload { tags: [str] }
enum OwnMsg { Data(OwnPayload) }

fn bare_pattern_field_reuse() -> str {
    let m: OwnMsg = OwnMsg.Data(OwnPayload { tags: ["a", "b"] })
    match m {
        Data(p) => {
            let mut copy = p.tags
            copy[0] = "z"
            return p.tags[0]
        },
    }
}

fn main() {
    // Primitives are Copy: usable after passing.
    let n = 5
    let n2 = n
    expect(n + n2 == 10, "i64 copy on assignment")
    let got = consume("hello")
    expect(got == 5, "str moves into consume")

    // All-scalar @copy struct: assignment copies, mutation does not alias.
    let p = Pair { a: 1, b: 2 }
    let mut q = p
    q.a = 100
    expect(p.a == 1 and q.a == 100, "@copy scalar assignment decouples")

    // All-scalar @copy param: pass-by-value on both backends (gotcha #23).
    mutate_pair(p)
    expect(p.a == 1, "@copy scalar param does not alias caller")

    // Heap-bearing @copy assignment: deep copy on both backends (step 224).
    let start: [i64] = []
    let mut b1 = Bag { name: "orig", items: start }
    b1.items = push(b1.items, 7)
    let mut b2 = b1
    b2.items = push(b2.items, 8)
    b2.name = "copy"
    expect(len(b1.items) == 1, "@copy deep: source array unaffected")
    expect(len(b2.items) == 2, "@copy deep: copy keeps its push")
    expect(b1.name == "orig" and b2.name == "copy", "@copy deep: str slots decouple")

    // if-expression whose branches each match the same param (was a false
    // E0300 use-after-move that blocked compilation).
    expect(branch_classify(5, Tag.X) == "x1", "if-expr then-branch match on param")
    expect(branch_classify(-1, Tag.Y) == "o2", "if-expr else-branch match on same param (no false use-after-move)")

    // Bare enum-variant pattern binding a struct payload, heap field copied out
    // and the original reused: must compile (was a false E0303) and share the
    // handle (the local copy's mutation aliases the shared array).
    expect(bare_pattern_field_reuse() == "z", "bare enum pattern struct-payload field reuse (no false E0303)")

    // Heap-field struct reassigned in a loop from a nested-match Result payload:
    // must not crash (F1). A match-arm-local `let` is now dropped at its own
    // arm's scope end, not hoisted to the loop-body's shared post-match drop.
    expect(f1_run() == 2, "loop + nested-match struct-payload reassign (F1: no crash, correct value)")
    // A match-arm tail CALL consuming an arm-local heap value must run before
    // the arm-scope drop frees it (F1-fix follow-up: was freed-first -> empty).
    expect(f1_tail_call(3) == 9, "match-arm tail call consumes arm-local before scope drop")

    // Matching an ARC-backed value READS it, it does not CONSUME it: the same
    // Option/Result may be matched again (or used afterwards). Recording a hard
    // move on the match subject made a second `match o {..}` a BLOCKING E0300,
    // contradicting the documented advisory-E0300 contract and breaking the
    // ubiquitous check-then-use idiom. Must compile AND run on both backends.
    let opt: Option<i64> = Some(5)
    let mut osum = 0
    match opt { Some(x) => { osum = osum + x } None() => {} }
    match opt { Some(x) => { osum = osum + x } None() => {} }
    expect(osum == 10, "an Option can be matched twice (match reads, does not consume)")
    let res: Result<i64, str> = Ok(7)
    match res { Ok(x) => { osum = osum + x } Err(e) => {} }
    match res { Ok(x) => { osum = osum + x } Err(e) => {} }
    expect(osum == 24, "a Result can be matched twice, then reused")

    // ARC drop-path criticals (Pass-37): a payload pulled out of a
    // still-owned container (Result/enum/[Struct] array) must be
    // retained/deep-copied, or the container's own scope-end drop frees it
    // while a local still aliases it -> double-free (JIT 127 / AOT segfault /
    // SIGILL). Three sites: struct-nested-enum match payload, enum match
    // payload reassigned in a loop, and [Struct]-array element returned.
    let arc_toks: [i64] = [2, 3, 4]
    let arc_r0 = arc_parse(arc_toks, 0)
    let arc_out = match arc_r0 {
        Ok(f) => {
            let mut node = f.expr
            let mut cur = f.pos
            while cur < len(arc_toks) {
                let rn = arc_parse(arc_toks, cur)
                let stepped = match rn {
                    Ok(nx) => { node = ArcExpr.Mul(node, nx.expr)  cur = nx.pos  1 }
                    Err(e) => { cur = len(arc_toks)  0 }
                }
                let _keep = stepped
            }
            arc_eval(node)
        }
        Err(e) => 0 - 1
    }
    expect(arc_out == 24, "struct-wrapping-recursive-enum via Result reassigned in a loop (no double-free)")
    let arc_rows = [ArcW { tag: 7 }, ArcW { tag: 9 }]
    let arc_a = arc_firstw(arc_rows)
    let arc_b = arc_firstw(arc_rows)
    expect(arc_a.tag + arc_b.tag == 14, "[Struct] array element returned from a fn called twice (no double-release)")

    println("conformance ownership: PASS")
}

enum ArcExpr {
    Num(i64),
    Mul(ArcExpr, ArcExpr),
}

struct ArcPR {
    expr: ArcExpr,
    pos: i64,
}

struct ArcW {
    tag: i64,
}

fn arc_parse(toks: [i64], pos: i64) -> Result<ArcPR, str> {
    if pos >= len(toks) {
        return Err("eof")
    }
    return Ok(ArcPR { expr: ArcExpr.Num(toks[pos]), pos: pos + 1 })
}

fn arc_eval(e: ArcExpr) -> i64 {
    match e {
        Num(v) => return v,
        Mul(a, b) => return arc_eval(a) * arc_eval(b),
    }
}

fn arc_firstw(rows: [ArcW]) -> ArcW {
    return rows[0]
}
