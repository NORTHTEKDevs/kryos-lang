// Conformance (LEDGER item 137): a `shared` handle that a consumer KEEPS gets
// its own arc reference. Each probe hands a handle to a struct literal field,
// an array literal, a field assignment, a let alias or a match-arm payload
// bind, lets the source go away, churns the allocator so freed arc blocks
// are REUSED, and only then reads the value back. A consumer that took the
// handle without a reference of its own reads recycled memory (wrong v or an
// empty tag). Run on both backends, with real frees, by tests/no_double_free.sh.
use std::option::{Option}

struct L { next: Option<shared L>, v: i64, name: str }
struct Box1 { h: shared L, n: i64 }

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn mk(v: i64) -> L {
    return L { next: None(), v: v, name: "node-" + to_string(v) + "-padpadpad" }
}

fn churn(k: i64) -> i64 {
    let mut t = 0
    let mut i = 0
    while i < 40 {
        let z = "zz-" + to_string(k + i) + "-qqqqqqqqqqqqqqqq"
        let n: shared L = shared mk(k + i)
        t = t + len(z) + (*n).v
        i = i + 1
    }
    return t
}

fn lit_field(v: i64) -> Box1 {
    let a = shared mk(v)
    return Box1 { h: a, n: 1 }
}

fn let_alias(v: i64) -> shared L {
    let a = shared mk(v)
    let t = a
    return t
}

fn field_assign(v: i64) -> Box1 {
    let a = shared mk(v)
    let mut r = Box1 { h: shared mk(0), n: 1 }
    r.h = a
    return r
}

fn arr_lit(v: i64) -> [shared L] {
    let a = shared mk(v)
    return [a, a]
}

// match-arm payload binds, the option dying at the function's return
fn bind_to_field(o: Option<shared L>) -> Box1 {
    match o {
        Option.Some(s) => { return Box1 { h: s, n: 1 } },
        Option.None => { return Box1 { h: shared mk(0), n: 0 } },
    }
}

fn bind_assign(o: Option<shared L>) -> Box1 {
    let mut r = Box1 { h: shared mk(0), n: 0 }
    match o {
        Option.Some(s) => { r.h = s },
        Option.None => { r.n = 9 },
    }
    return r
}

fn bind_arr(o: Option<shared L>) -> [shared L] {
    match o {
        Option.Some(s) => { return [s, s] },
        Option.None => { return [] },
    }
}

fn bind_alias(o: Option<shared L>) -> shared L {
    match o {
        Option.Some(s) => {
            let t = s
            let u = t
            return u
        },
        Option.None => { return shared mk(0) },
    }
}

fn check(h: shared L, v: i64, what: str) {
    expect((*h).v == v, what + " v " + to_string((*h).v) + " want " + to_string(v))
    expect((*h).name == "node-" + to_string(v) + "-padpadpad", what + " name " + (*h).name)
}

fn main() {
    let mut i = 0
    let mut c = 0
    while i < 30 {
        let v = 100 + i
        let b1 = lit_field(v)
        let a2 = let_alias(v + 1)
        let b3 = field_assign(v + 2)
        let a4 = arr_lit(v + 3)
        let b5 = bind_to_field(Some(shared mk(v + 4)))
        let b6 = bind_assign(Some(shared mk(v + 5)))
        let a7 = bind_arr(Some(shared mk(v + 6)))
        let a8 = bind_alias(Some(shared mk(v + 7)))
        c = c + churn(i * 7)
        check(b1.h, v, "lit_field")
        check(a2, v + 1, "let_alias")
        check(b3.h, v + 2, "field_assign")
        check(a4[0], v + 3, "arr_lit 0")
        check(a4[1], v + 3, "arr_lit 1")
        check(b5.h, v + 4, "bind_to_field")
        check(b6.h, v + 5, "bind_assign")
        check(a7[0], v + 6, "bind_arr 0")
        check(a7[1], v + 6, "bind_arr 1")
        check(a8, v + 7, "bind_alias")
        i = i + 1
    }
    expect(c > 0, "churn ran")
    println("shared consumers ok {c}")
}
