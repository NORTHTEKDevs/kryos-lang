// Conformance (LEDGER item 137): a `shared` payload bind owns its own arc
// reference. Each probe lets the container that held the payload die (a
// local `Option<shared Node>` dropped at the function's return, a struct
// field of a dropped struct), churns the allocator so freed arc blocks are
// REUSED, and only then reads the value the bind escaped with. A bind that
// borrowed the container's reference reads recycled memory (wrong v / tag).
// Run under KRYOS_FREE_DIAG on both backends, and on AOT with real frees, by
// tests/no_double_free.sh.
use std::option::{Option}

struct Node { next: Option<shared Node>, v: i64, tag: str }
struct Holder { slot: Option<shared Node>, n: i64 }

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn mk(v: i64) -> Node {
    return Node { next: None(), v: v, tag: "n" + to_string(v) }
}

fn pick(o: Option<shared Node>) -> shared Node {
    match o {
        Option.Some(s) => { return s },
        Option.None => { return shared mk(-1) },
    }
}

// the option dies at this function's return; only the escaped bind keeps the node
fn survivor(i: i64) -> shared Node {
    let o = Some(shared mk(i))
    return pick(o)
}

// escape through a field read of a by-value struct param
fn from_holder(h: Holder) -> shared Node {
    match h.slot {
        Option.Some(s) => { return s },
        Option.None => { return shared mk(-2) },
    }
}

fn survivor_holder(i: i64) -> shared Node {
    let h = Holder { slot: Some(shared mk(i)), n: i }
    return from_holder(h)
}

// the bind is also stored into a new struct (a second owner)
fn relink(o: Option<shared Node>, v: i64) -> Node {
    match o {
        Option.Some(s) => { return Node { next: Some(s), v: v, tag: "r" + to_string(v) } },
        Option.None => { return mk(-3) },
    }
}

// `shared x` of a by-value param: the arc takes its own owner of x's heap
// leaves, so dropping the param at return leaves the arc valid (this shape
// corrupted the heap on release builds before the arc took its owner)
fn wrap(x: Node) -> shared Node { return shared x }

fn chain(n: i64) -> Node {
    if n == 0 { return mk(0) }
    return Node { next: Some(wrap(chain(n - 1))), v: n, tag: "c" + to_string(n) }
}

fn walk_len(n: Node) -> i64 {
    let mut total = n.v + len(n.tag)
    match n.next {
        Option.Some(inner) => { total = total + walk_len(*inner) },
        Option.None => { total = total + 0 },
    }
    return total
}

// the arm only dereferences the bind, but releases the subject under it: the
// bind must hold its own reference
fn reassign_read(o: Option<shared Node>) -> i64 {
    let mut cur = o
    match cur {
        Option.Some(n) => {
            cur = None()
            let c = churn(77)
            return (*n).v + len((*n).tag) + c
        },
        Option.None => { return -1 },
    }
}

fn field_reassign(i: i64) -> i64 {
    let mut h = Holder { slot: Some(shared mk(i)), n: i }
    match h.slot {
        Option.Some(n) => {
            h.slot = None()
            let c = churn(88)
            return (*n).v + len((*n).tag) + c
        },
        Option.None => { return -1 },
    }
}

fn churn(k: i64) -> i64 {
    let mut acc = 0
    let mut j = 0
    while j < 8 {
        let a: shared Node = shared mk(k * 100 + j)
        let t = "churn-" + to_string(k) + "-" + to_string(j)
        acc = acc + (*a).v + len(t)
        j = j + 1
    }
    return acc
}

fn main() {
    let mut i = 0
    let mut sum = 0
    while i < 60 {
        let kept = survivor(i)
        let c1 = churn(i)
        expect((*kept).v == i, "survivor v " + to_string((*kept).v) + " want " + to_string(i))
        expect((*kept).tag == "n" + to_string(i), "survivor tag " + (*kept).tag)

        let kept2 = survivor_holder(i + 1000)
        let c2 = churn(i + 1)
        expect((*kept2).v == i + 1000, "holder v " + to_string((*kept2).v))
        expect((*kept2).tag == "n" + to_string(i + 1000), "holder tag " + (*kept2).tag)

        let r = relink(Some(shared mk(i + 5000)), i)
        let c3 = churn(i + 2)
        match r.next {
            Option.Some(inner) => {
                expect((*inner).v == i + 5000, "relink v " + to_string((*inner).v))
                expect((*inner).tag == "n" + to_string(i + 5000), "relink tag " + (*inner).tag)
            },
            Option.None => { expect(false, "relink lost its payload") },
        }
        let ra = reassign_read(Some(shared mk(i + 7000)))
        expect(ra == i + 7000 + len("n" + to_string(i + 7000)) + churn(77), "reassign_read " + to_string(ra))
        let fa = field_reassign(i + 9000)
        expect(fa == i + 9000 + len("n" + to_string(i + 9000)) + churn(88), "field_reassign " + to_string(fa))
        let ch = chain(12)
        let c4 = churn(i + 4)
        expect(ch.v == 12, "chain head " + to_string(ch.v))
        expect(walk_len(ch) == 107, "chain walk " + to_string(walk_len(ch)))
        sum = sum + c4 + (*kept).v + (*kept2).v + c1 + c2 + c3 + ra + fa
        i = i + 1
    }
    println("shared ownership ok " + to_string(sum))
}
