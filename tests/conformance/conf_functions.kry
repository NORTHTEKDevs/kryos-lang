// Conformance: functions, recursion, closures, fn-typed params, generics,
// traits. (Reference chapters 3, 8.)

fn early_ret(c: bool) -> i64 {
    let v = if c { 5 } else { return 0 }
    return v + 1
}

fn classify_pos(x: i64) -> str {
    let r = if x > 0 { "pos" } else { throw "neg" }
    return r
}

// The THEN branch diverges (throw/return) and the ELSE is the live value. The
// if-result type must come from the else branch, not the divergent then arm --
// else `let r = if c { throw } else { "s" }` typed `r` as i64 and the str read
// back as its raw pointer bits (str printed a big number). Complements
// classify_pos (which diverges in the else branch).
fn classify_nonneg(x: i64) -> str {
    let r = if x < 0 { throw "was negative" } else { "nonneg" }
    return r
}

fn pick_or_return(x: i64) -> f64 {
    let v = if x > 100 { return 0.0 } else { 2.5 }
    return v
}

fn all_block_match(tag: i64) -> i64 {
    return match tag {
        0 => { let a = 10  a + 1 },
        1 => { let b = 20  b + 2 },
        _ => { 99 },
    }
}

// A LET-bound match expression whose block arms end in a bare-identifier tail
// bound by an intra-arm `let` must infer the tail's REAL type (str), not the
// I64 default -- else the heap value's raw pointer was printed as an integer
// (Pass-18 both-backend miscompile). Also exercises the moved-tail drop-
// suppression: without it the str is freed twice once correctly typed.
fn str_block_match(n: i64) -> str {
    let label = match n {
        0 => { let a = "zero"  a }
        1 => { let b = "one"  b }
        x => { let c = "many"  c }
    }
    return label
}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn apply_twice(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(f(x))
}

fn add<T>(a: T, b: T) -> T {
    return a + b
}

trait Describable {
    fn describe(self) -> str
}

struct Dog {
    name: str,
}

impl Describable for Dog {
    fn describe(self: Dog) -> str {
        return "dog:" + self.name
    }
}

fn main() {
    // Recursion.
    expect(fib(10) == 55, "recursion")

    // Lambdas and closures over locals.
    let double = fn (x: i64) -> i64 { return x * 2 }
    expect(double(21) == 42, "lambda")
    let base = 100
    let offset = fn (x: i64) -> i64 { return base + x }
    expect(offset(5) == 105, "closure capture")

    // Functions as parameters.
    expect(apply_twice(double, 3) == 12, "fn-typed param")
    expect(apply_twice(fn (x: i64) -> i64 { return x + 1 }, 0) == 2, "inline lambda arg")

    // Generic function monomorphized per call site.
    expect(add(2, 3) == 5, "generic i64")
    expect(add(2.5, 0.5) == 3.0, "generic f64")
    expect(add("ab", "cd") == "abcd", "generic str")

    // Trait method through impl.
    let d = Dog { name: "rex" }
    expect(d.describe() == "dog:rex", "trait impl method")

    // Multiple returns and early return.
    let pick = fn (flag: bool) -> i64 {
        if flag {
            return 1
        }
        return 2
    }
    expect(pick(true) == 1 and pick(false) == 2, "early return")

    // A nested (local) fn that calls ITSELF recursively. A nested fn desugars to
    // `let name = |..|`, and a Let's value is checked/lowered before its name is
    // bound, so a self-call raised E0102 (undefined). The name is now pre-bound
    // before its own body. (Non-capturing self-recursion; mutual recursion and
    // capturing recursion between nested fns remain unsupported by design.)
    fn nfact(n: i64) -> i64 {
        if n <= 1 { return 1 }
        return n * nfact(n - 1)
    }
    expect(nfact(5) == 120, "nested fn self-recursion")
    fn nsum(a: [i64], i: i64) -> i64 {
        if i >= len(a) { return 0 }
        return a[i] + nsum(a, i + 1)
    }
    expect(nsum([1, 2, 3, 4], 0) == 10, "nested fn recursion over an array")

    // A match whose arms are ALL `{ block }` bodies must infer the tail-
    // expression's type, not void (a block arm was misclassified as divergent).
    expect(all_block_match(1) == 22, "all-block match arms infer tail value (not void)")
    expect(all_block_match(0) == 11 and all_block_match(9) == 99, "all-block match arms across variants")
    // A LET-bound str match whose block arms end in an intra-arm let-bound
    // identifier must infer str (not i64) so the value isn't a raw pointer.
    expect(str_block_match(0) == "zero", "let-bound str block-match arm infers str tail (arm 0)")
    expect(str_block_match(1) == "one", "let-bound str block-match arm infers str tail (arm 1)")
    expect(str_block_match(7) == "many", "let-bound str block-match arm infers str tail (default arm)")
    // An if/else whose OTHER branch diverges (throw/return) types as the live
    // branch, not void. A divergent branch contributes no type to unification.
    expect(classify_pos(5) == "pos", "if with a throw branch types as the value branch")
    try {
        let bad = classify_pos(-1)
        expect(false, "classify_pos(-1) should throw")
    } catch e {
        expect(e == "neg", "if-throw branch actually throws when taken")
    }
    expect(early_ret(true) == 6, "if with a return branch types as the value branch")
    expect(early_ret(false) == 0, "if-return branch returns early when taken")
    // The DIVERGENT branch is the THEN branch (not the else): the result type
    // must still come from the live else branch, for str and f64 alike.
    expect(classify_nonneg(5) == "nonneg", "if with a throw THEN-branch types as the else value (str, not a raw pointer)")
    try {
        let bad = classify_nonneg(-1)
        expect(false, "classify_nonneg(-1) should throw")
    } catch e {
        expect(e == "was negative", "throw then-branch actually throws when taken")
    }
    expect(pick_or_return(5) > 2.4 and pick_or_return(5) < 2.6, "if with a return THEN-branch types as the else value (f64)")

    println("conformance functions: PASS")
}
