// Conformance: functions, recursion, closures, fn-typed params, generics,
// traits. (Reference chapters 3, 8.)

fn early_ret(c: bool) -> i64 {
    let v = if c { 5 } else { return 0 }
    return v + 1
}

fn classify_pos(x: i64) -> str {
    let r = if x > 0 { "pos" } else { throw "neg" }
    return r
}

// The THEN branch diverges (throw/return) and the ELSE is the live value. The
// if-result type must come from the else branch, not the divergent then arm --
// else `let r = if c { throw } else { "s" }` typed `r` as i64 and the str read
// back as its raw pointer bits (str printed a big number). Complements
// classify_pos (which diverges in the else branch).
fn classify_nonneg(x: i64) -> str {
    let r = if x < 0 { throw "was negative" } else { "nonneg" }
    return r
}

fn pick_or_return(x: i64) -> f64 {
    let v = if x > 100 { return 0.0 } else { 2.5 }
    return v
}

fn all_block_match(tag: i64) -> i64 {
    return match tag {
        0 => { let a = 10  a + 1 },
        1 => { let b = 20  b + 2 },
        _ => { 99 },
    }
}

// A LET-bound match expression whose block arms end in a bare-identifier tail
// bound by an intra-arm `let` must infer the tail's REAL type (str), not the
// I64 default -- else the heap value's raw pointer was printed as an integer
// (Pass-18 both-backend miscompile). Also exercises the moved-tail drop-
// suppression: without it the str is freed twice once correctly typed.
fn str_block_match(n: i64) -> str {
    let label = match n {
        0 => { let a = "zero"  a }
        1 => { let b = "one"  b }
        x => { let c = "many"  c }
    }
    return label
}

// A value-position `if`/`match` whose branch has a `let`-bound local followed by
// a NON-identifier, HEAP-producing tail (`outer + suffix`) must infer the result
// type as str, not i64. The branch's local isn't in scope during the pre-lower
// result-type inference, so `outer + "-done"` defaulted to i64 -> the if/match
// result slot was i64 while the branch stored a str pointer -> garbage on both
// backends (and an AOT `'ptr' but expected 'i64'` codegen failure on further
// use). Generalized block-tail inference (overlay the block's lets) fixes it.
fn if_binop_tail(c: bool) -> str {
    let r = if c {
        let outer = "zero-in"
        outer + "-done"
    } else {
        "skip"
    }
    return r
}

fn match_binop_tail(n: i64) -> str {
    let r = match n {
        1 => { let a = "aa"  a + "-x" }
        _ => "skip"
    }
    return r
}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn apply_twice(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(f(x))
}

fn add<T>(a: T, b: T) -> T {
    return a + b
}

trait Describable {
    fn describe(self) -> str
}

struct Dog {
    name: str,
}

impl Describable for Dog {
    fn describe(self: Dog) -> str {
        return "dog:" + self.name
    }
}

struct CapPt { x: i64, y: i64 }

// Closure struct-capture double-free (gotcha #11, JIT-only, now RESOLVED): a
// struct captured by two closure envs that both reach teardown (a NESTED
// closure whose inner lambda also captures the outer scope's struct, or a
// closure stored as a map value) double-freed the struct on Cranelift/JIT
// (exit 127). The Cranelift capture-store now deep-copies struct/enum captures
// like AOT already did.
fn nested_struct_capture() -> i64 {
    let p = CapPt { x: 10, y: 20 }
    let outer = || {
        let inner = || { p.x + p.y }
        inner()
    }
    return outer()
}

fn map_closure_struct_capture() -> i64 {
    let s = CapPt { x: 6, y: 0 }
    let m: map<str, fn() -> i64> = {"k": || { s.x }}
    let f = m["k"]
    return f()
}

// A closure that MUTATES a captured struct field captures BY MOVE: it owns one
// persistent independent copy across calls, and the outer var is unaffected --
// matching the scalar mutating-capture semantics. Was a JIT/AOT DIVERGENCE (JIT
// 2,3,3 aliased the outer; AOT 2,2,1 lost per-call persistence): find_mutated_
// captures only saw bare-identifier mutation targets, not `c.field = ..`, so the
// closure wrongly used the read-only fast path.
struct MutCtx { base: i64 }
fn mutating_struct_closure() -> [i64] {
    let mut c = MutCtx { base: 1 }
    let bump = || { c.base = c.base + 1  c.base }
    let first = bump()
    let second = bump()
    return [first, second, c.base]
}

// A closure that mutates TWO OR MORE captured struct fields persists EACH
// independently by move, outer vars unaffected -- a single co-occurring mutated
// capture used to revert every struct capture to the AOT byval copy-on-entry
// path and silently drop per-call persistence (JIT 111,122,133 vs AOT
// 111,111,111). Each mutated struct capture now gets its own pointer slot.
struct MC2 { base: i64 }
fn two_mutated_struct_captures() -> [i64] {
    let mut c1 = MC2 { base: 0 }
    let mut c2 = MC2 { base: 100 }
    let bump = || { c1.base = c1.base + 1  c2.base = c2.base + 10  c1.base + c2.base }
    let a = bump()
    let b = bump()
    let d = bump()
    return [a, b, d, c1.base, c2.base]
}

// A `dyn Trait` param whose METHOD is called inside a GENERIC function must
// still be passed as a trait object (fat pointer): the generic-call lowering
// path bypassed the dyn-Trait coercion the normal call path does, so a concrete
// struct arg reached the monomorphized body's vtable_call RAW -> segfault both
// backends. (Single dyn-Trait dispatch and generics each worked alone; only the
// co-occurrence crashed.)
trait Areued { fn area(self) -> i64 }
struct GRect { w: i64, h: i64 }
struct GSq { s: i64 }
impl Areued for GRect { fn area(self: GRect) -> i64 { return self.w * self.h } }
impl Areued for GSq { fn area(self: GSq) -> i64 { return self.s * self.s } }
fn dyn_in_generic<T>(tag: T, shape: dyn Areued) -> i64 {
    return shape.area()
}

// dyn Trait coercion must fire at EVERY position a concrete struct flows into a
// `dyn Trait` slot, not just call arguments: a let-with-annotation, a return, a
// struct-literal field, and a method-call argument. Each missing site passed the
// raw struct to vtable_call -> SIGSEGV both backends.
fn make_areued() -> dyn Areued { return GRect { w: 3, h: 4 } }
struct AHolder { shape: dyn Areued }
struct ATagger { tag: i64 }
impl ATagger { fn tagged_area(self: ATagger, s: dyn Areued) -> i64 { return s.area() + self.tag } }

// A generic struct field typed as the bare param `T`, instantiated at a FUNCTION
// type, must be CALLABLE (`b.f()`): the field-call resolution looked up the RAW
// declared type `T` (a type var), never substituting the concrete fn type, so it
// failed the Function-field check -> false E0107. Now the struct's generic params
// are substituted into the field type first (freshen->unify vs the instance).
struct FBox<T> { f: T }

fn main() {
    // Recursion.
    expect(fib(10) == 55, "recursion")

    // Lambdas and closures over locals.
    let double = fn (x: i64) -> i64 { return x * 2 }
    expect(double(21) == 42, "lambda")
    let base = 100
    let offset = fn (x: i64) -> i64 { return base + x }
    expect(offset(5) == 105, "closure capture")

    // Functions as parameters.
    expect(apply_twice(double, 3) == 12, "fn-typed param")
    expect(apply_twice(fn (x: i64) -> i64 { return x + 1 }, 0) == 2, "inline lambda arg")

    // Generic function monomorphized per call site.
    expect(add(2, 3) == 5, "generic i64")
    expect(add(2.5, 0.5) == 3.0, "generic f64")
    expect(add("ab", "cd") == "abcd", "generic str")

    // Trait method through impl.
    let d = Dog { name: "rex" }
    expect(d.describe() == "dog:rex", "trait impl method")

    // Multiple returns and early return.
    let pick = fn (flag: bool) -> i64 {
        if flag {
            return 1
        }
        return 2
    }
    expect(pick(true) == 1 and pick(false) == 2, "early return")

    // A nested (local) fn that calls ITSELF recursively. A nested fn desugars to
    // `let name = |..|`, and a Let's value is checked/lowered before its name is
    // bound, so a self-call raised E0102 (undefined). The name is now pre-bound
    // before its own body. (Non-capturing self-recursion; mutual recursion and
    // capturing recursion between nested fns remain unsupported by design.)
    fn nfact(n: i64) -> i64 {
        if n <= 1 { return 1 }
        return n * nfact(n - 1)
    }
    expect(nfact(5) == 120, "nested fn self-recursion")
    fn nsum(a: [i64], i: i64) -> i64 {
        if i >= len(a) { return 0 }
        return a[i] + nsum(a, i + 1)
    }
    expect(nsum([1, 2, 3, 4], 0) == 10, "nested fn recursion over an array")

    // A match whose arms are ALL `{ block }` bodies must infer the tail-
    // expression's type, not void (a block arm was misclassified as divergent).
    expect(all_block_match(1) == 22, "all-block match arms infer tail value (not void)")
    expect(all_block_match(0) == 11 and all_block_match(9) == 99, "all-block match arms across variants")
    // A LET-bound str match whose block arms end in an intra-arm let-bound
    // identifier must infer str (not i64) so the value isn't a raw pointer.
    expect(str_block_match(0) == "zero", "let-bound str block-match arm infers str tail (arm 0)")
    expect(str_block_match(1) == "one", "let-bound str block-match arm infers str tail (arm 1)")
    expect(str_block_match(7) == "many", "let-bound str block-match arm infers str tail (default arm)")
    // Value-position if/match with a heap-producing binop tail over a block-local
    // must infer str (was i64 -> garbage pointer / AOT ptr-vs-i64 codegen fail).
    expect(if_binop_tail(true) == "zero-in-done", "if-as-value: local + heap binop tail infers str (then)")
    expect(if_binop_tail(false) == "skip", "if-as-value: local + heap binop tail infers str (else)")
    expect(match_binop_tail(1) == "aa-x", "match-as-value: local + heap binop tail infers str")
    expect(match_binop_tail(0) == "skip", "match-as-value: heap binop tail, default arm")
    // An if/else whose OTHER branch diverges (throw/return) types as the live
    // branch, not void. A divergent branch contributes no type to unification.
    expect(classify_pos(5) == "pos", "if with a throw branch types as the value branch")
    try {
        let bad = classify_pos(-1)
        expect(false, "classify_pos(-1) should throw")
    } catch e {
        expect(e == "neg", "if-throw branch actually throws when taken")
    }
    expect(early_ret(true) == 6, "if with a return branch types as the value branch")
    expect(early_ret(false) == 0, "if-return branch returns early when taken")
    // The DIVERGENT branch is the THEN branch (not the else): the result type
    // must still come from the live else branch, for str and f64 alike.
    expect(classify_nonneg(5) == "nonneg", "if with a throw THEN-branch types as the else value (str, not a raw pointer)")
    try {
        let bad = classify_nonneg(-1)
        expect(false, "classify_nonneg(-1) should throw")
    } catch e {
        expect(e == "was negative", "throw then-branch actually throws when taken")
    }
    expect(pick_or_return(5) > 2.4 and pick_or_return(5) < 2.6, "if with a return THEN-branch types as the else value (f64)")

    // `not` precedence (reference table level 4): looser than comparison,
    // tighter than `and` -- was mis-parsed as tight `!` (level 12), so
    // `not a == b` errored/mis-parsed. Now `not a == b` == `not (a == b)`.
    expect((not 1 < 2) == false, "not binds looser than comparison: not 1 < 2 == not(1<2)")
    expect((not true and false) == false, "not binds tighter than and: not true and false == (not true) and false")
    expect((not (true and false)) == true, "parenthesized not(and) still works")

    // Closure captures of a struct reached by two env teardowns must not
    // double-free (gotcha #11, was JIT exit 127).
    expect(nested_struct_capture() == 30, "nested closure capturing outer-scope struct (no JIT double-free)")
    expect(map_closure_struct_capture() == 6, "closure capturing struct, stored as a map value (no JIT double-free)")

    // Mutating closure over a captured struct field: persistent-by-move,
    // outer unaffected (2,3,1), like the scalar case -- was a JIT/AOT divergence.
    let msc = mutating_struct_closure()
    expect(msc[0] == 2 and msc[1] == 3 and msc[2] == 1, "closure mutating a captured struct field: persist across calls, outer unaffected")

    // Two mutated struct captures persist independently (111,122,133), outer
    // c1/c2 unaffected (0,100) -- was an AOT silent miscompile (111,111,111).
    let tmc = two_mutated_struct_captures()
    expect(tmc[0] == 111 and tmc[1] == 122 and tmc[2] == 133, "closure mutating two struct captures persists each across calls")
    expect(tmc[3] == 0 and tmc[4] == 100, "two mutated struct captures leave both outer vars unaffected")

    // dyn-Trait method call inside a generic fn: struct arg must be wrapped as
    // a trait object, not passed raw (was a segfault on both backends).
    expect(dyn_in_generic(1, GRect { w: 3, h: 4 }) == 12, "dyn-Trait method call inside a generic fn (i64 tag)")
    expect(dyn_in_generic("x", GSq { s: 5 }) == 25, "dyn-Trait method call inside a generic fn (str tag, 2nd impl)")

    // dyn-Trait coercion at let-annotation, return, struct-field, method-arg.
    let dyn_let: dyn Areued = GRect { w: 3, h: 4 }
    expect(dyn_let.area() == 12, "dyn-Trait coercion at a let annotation")
    expect(dyn_let.area() == 12, "dyn-Trait let binding is reusable (not consumed)")
    expect(make_areued().area() == 12, "dyn-Trait coercion at a return position")
    let dyn_holder = AHolder { shape: GRect { w: 3, h: 4 } }
    expect(dyn_holder.shape.area() == 12, "dyn-Trait coercion at a struct-literal field")
    let dyn_tagger = ATagger { tag: 100 }
    expect(dyn_tagger.tagged_area(GRect { w: 3, h: 4 }) == 112, "dyn-Trait coercion at a method-call argument")

    // Generic struct field typed `T` instantiated at a fn type is callable.
    let fb0: FBox<fn() -> i64> = FBox { f: || 100 + 1 }
    expect(fb0.f() == 101, "generic struct fn-typed field (T=fn()->i64) is callable")
    let fb1: FBox<fn(i64) -> i64> = FBox { f: |x: i64| x * 2 }
    expect(fb1.f(5) == 10, "generic struct fn-typed field with an argument (T=fn(i64)->i64)")

    println("conformance functions: PASS")
}
