// Conformance: structs, impl methods, enums with payloads, pattern
// matching, Option/Result, arrays, maps, tuples. (Reference chapters 5, 7.)

use std::option::{Option, Some, None}
use std::result::{Result, Ok, Err}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

struct Point {
    x: f64,
    y: f64,
}

impl Point {
    fn manhattan(self: Point) -> f64 {
        let mut ax = self.x
        if ax < 0.0 { ax = 0.0 - ax }
        let mut ay = self.y
        if ay < 0.0 { ay = 0.0 - ay }
        return ax + ay
    }
}

enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Empty,
}

fn area(s: Shape) -> f64 {
    match s {
        Circle(r) => return 3.0 * r * r,
        Rect(w, h) => return w * h,
        Empty => return 0.0,
    }
}

fn safe_div(a: i64, b: i64) -> Result<i64, str> {
    if b == 0 {
        return Err("division by zero")
    }
    return Ok(a / b)
}

fn find_even(xs: [i64]) -> Option<i64> {
    for x in xs {
        if x % 2 == 0 {
            return Some(x)
        }
    }
    return None()
}

struct Rec {
    name: str,
    n: i64,
    f: f64,
}

// A struct with a NON-COPY nested-struct field. The struct-drop helper mis-read
// the inline nested-struct field as a boxed pointer and freed garbage -> segfault
// at [Nest]-array teardown. (Runner's exit-code check catches a regression.)
struct Leafy {
    s: str,
}

struct Nest {
    leaf: Leafy,
    n: i64,
}

// Or-pattern arm FOLLOWED by a guard arm: the guard forces the sequential
// lowering path, where the or-pattern `1 | 2 | 3` previously fell through to
// "always matches" and matched every value.
fn classify(n: i64) -> str {
    match n {
        1 | 2 | 3 => return "low",
        x if x < 0 => return "neg",
        _ => return "high",
    }
}

enum Cmd {
    Inc,
    Dec,
    Nop,
}

// Nested match on the SAME value `c` across mutually-exclusive outer arms.
// The move checker previously leaked `c`'s moved state from arm 0 into arm 1
// and reported a false E0300 use-after-move.
fn apply(mode: i64, c: Cmd) -> i64 {
    match mode {
        0 => {
            match c {
                Inc => return 1,
                Dec => return -1,
                Nop => return 0,
            }
        }
        _ => {
            match c {
                Inc => return 10,
                Dec => return -10,
                Nop => return 0,
            }
        }
    }
}

// A user enum that deliberately reuses the `Some` variant name to exercise
// deterministic bare-variant resolution against std Option.
enum Shelf {
    Some(str),
    Bare,
}

fn shelf_label(s: Shelf) -> str {
    match s {
        Shelf.Some(t) => return "has:" + t,
        Shelf.Bare => return "bare",
    }
}

fn find_name(id: i64) -> Option<str> {
    if id == 1 {
        return Some("alice")
    }
    return None()
}

// match-as-VALUE whose first arm is a bare str-payload binding, feeding a CHAINED
// concat. The match result local was mis-sized as i64 (bare-variant enum name is
// empty; the field-type special-case missed), so the chained concat poisoned the
// SSA type and the AOT build failed with `ptr but expected i64`.
fn describe_user(id: i64) -> str {
    let name = match find_name(id) {
        Some(n) => n,
        None() => {
            return "unknown"
        }
    }
    return name + " is " + "here"
}

enum Sig {
    On(i64),
    Off,
}

// Recursive enum (auto-boxed) + recursive fn. Dotted `Enum.Variant(args)`
// construction with heap-local args (`Btree.Node(a, b)`) didn't drop-suppress
// those args (only the bare `Variant(args)` path did), double-freeing the child
// cells at scope exit -> Windows __fastfail -> JIT exit 127. The conformance
// runner's exit-code check catches a regression here.
enum Btree {
    Leaf(i64),
    Node(Btree, Btree),
}

fn tree_sum(t: Btree) -> i64 {
    match t {
        Btree.Leaf(v) => return v,
        Btree.Node(l, r) => return tree_sum(l) + tree_sum(r),
    }
}

// Tuple pattern with a NESTED ENUM element `(On(v), q)`. The switch path tested
// neither the nested tag (Off took the On arm) nor extracted the payload (v
// bound 0); the ordered path now handles both, incl. guards.
fn drive(s: Sig, q: i64) -> str {
    match (s, q) {
        (On(v), 0) => return "on-zero {v}",
        (On(v), n) if v > 10 => return "big {v} {n}",
        (On(v), n) => return "on {v} {n}",
        (Off, n) => return "off {n}",
    }
}

// Tuple pattern with a NESTED-TUPLE element. The inner tuple's bindings were
// never assigned (read as 0) -- the switch path binds only top-level idents.
fn nested_tuple_cls(x: i64, y: i64, z: i64) -> str {
    match (x, (y, z), 0) {
        (a, (0, c), _) => return "yzero {a} {c}",
        (a, (b, c), _) if b > c => return "gt {a} {b} {c}",
        (a, (b, c), _) => return "def {a} {b} {c}",
    }
}

fn quadrant(x: i64, y: i64) -> str {
    match (x, y) {
        (0, 0) => return "origin",
        (0, _) => return "y-axis",
        (_, 0) => return "x-axis",
        (a, b) if a > 0 and b > 0 => return "Q1",
        (a, b) if a < 0 and b > 0 => return "Q2",
        (a, b) if a < 0 and b < 0 => return "Q3",
        _ => return "Q4",
    }
}

struct Pixel { r: i64, g: i64, b: i64 }

// Struct patterns in `match`: literal-field discrimination, field binding, and
// a single irrefutable arm. Struct patterns were previously routed to the
// tagless enum switch path (a struct has no variant tag), so the switch
// degenerated -- field bindings read 0 and literal-field arms never matched
// (silent miscompile on BOTH backends). Now lowered via the sequential path
// (bind_struct_pattern): each named field is extracted, idents bind, literals
// AND an equality test.
fn pixel_kind(p: Pixel) -> str {
    return match p {
        Pixel { r: 0, g: 0, b: 0 } => "black",
        Pixel { r: 255, g: 255, b: 255 } => "white",
        Pixel { r: r, g: 0, b: 0 } => "red:" + to_string(r),
        Pixel { r: r, g: g, b: b } => "mix:" + to_string(r + g + b),
    }
}

fn main() {
    // Structs + methods + field mutation.
    let mut p = Point { x: 3.0, y: 0.0 - 4.0 }
    expect(p.manhattan() == 7.0, "impl method")
    p.x = 10.0
    expect(p.x == 10.0, "field mutation")

    // Enums + match payloads.
    expect(area(Shape.Circle(2.0)) == 12.0, "enum payload circle")
    expect(area(Shape.Rect(3.0, 4.0)) == 12.0, "enum two-field payload")
    expect(area(Shape.Empty) == 0.0, "unit variant")

    // Result.
    match safe_div(10, 2) {
        Ok(v) => expect(v == 5, "Ok payload"),
        Err(e) => expect(false, "unexpected Err: " + e),
    }
    match safe_div(1, 0) {
        Ok(v) => expect(false, "expected Err, got {v}"),
        Err(e) => expect(e == "division by zero", "Err payload"),
    }

    // Option.
    match find_even([1, 3, 6, 7]) {
        Some(v) => expect(v == 6, "Some payload"),
        None() => expect(false, "expected Some"),
    }
    match find_even([1, 3, 5]) {
        Some(v) => expect(false, "expected None, got {v}"),
        None() => expect(true, "none ok"),
    }

    // Arrays: push/pop/index/len/iterate.
    let mut xs: [i64] = []
    xs = push(xs, 1)
    xs = push(xs, 2)
    xs = push(xs, 3)
    expect(len(xs) == 3 and xs[0] == 1 and xs[2] == 3, "array push/index")
    let last = pop(xs)
    expect(last == 3 and len(xs) == 2, "array pop")
    xs[0] = 99
    expect(xs[0] == 99, "array element assign")

    // Maps.
    let mut ages: map<str, i64> = {}
    ages["ada"] = 36
    ages["alan"] = 41
    expect(ages["ada"] == 36, "map insert/get")
    expect(contains(ages, "alan"), "map contains")
    expect(not contains(ages, "grace"), "map missing")
    ages["ada"] = 37
    expect(ages["ada"] == 37, "map overwrite")

    // Tuples.
    let pair = (1, "one")
    let (n, w) = pair
    expect(n == 1 and w == "one", "tuple destructure")

    // Tuple field ASSIGNMENT (`t.0 = v`): tuples are a KryosArray at runtime;
    // the JIT StoreField path didn't recognize Tuple and silently discarded the
    // write (offset-0 fallback) while AOT was correct -- a JIT/AOT divergence.
    let mut tup = (1, "a", 2.5)
    tup.0 = 99
    tup.1 = "z"
    tup.2 = 9.75
    let (ta, tb, tc) = tup
    expect(ta == 99 and tb == "z" and tc == 9.75, "tuple field assignment persists (JIT+AOT)")

    // Compound assignment (`+=`/`-=`/`*=`) to a NON-identifier lvalue -- struct
    // field, array index, map value. The compound-assign arm only matched bare
    // Identifier targets, so these were a silent no-op on BOTH backends.
    let mut ca_arr: [i64] = [1, 2, 3]
    ca_arr[0] += 10
    ca_arr[1] *= 4
    ca_arr[2] -= 1
    expect(ca_arr[0] == 11 and ca_arr[1] == 8 and ca_arr[2] == 2, "compound-assign on array index")
    let mut ca_map: map<str, i64> = {"k": 5}
    ca_map["k"] += 95
    expect(ca_map["k"] == 100, "compound-assign on map value")
    let mut ca_px = Pixel { r: 10, g: 20, b: 30 }
    ca_px.r += 5
    ca_px.g *= 2
    ca_px.b -= 10
    expect(ca_px.r == 15 and ca_px.g == 40 and ca_px.b == 20, "compound-assign on struct field")

    // type_of resolves from the STATIC type at compile time. On AOT it was
    // routed to a runtime helper that only saw the erased i64 slot, so a
    // concretely-typed array/struct/str/tuple/map reported "i64" (JIT was
    // correct) -- a silent backend divergence. Now both resolve identically.
    let tof_arr: [i64] = [1, 2]
    let tof_str: str = "x"
    let tof_px = Pixel { r: 1, g: 2, b: 3 }
    let tof_tup = (1, 2)
    let tof_map: map<str, i64> = {"k": 1}
    expect(type_of(tof_arr) == "array", "type_of array (not i64) on AOT")
    expect(type_of(tof_str) == "str", "type_of str")
    expect(type_of(tof_px) == "struct", "type_of struct (not i64) on AOT")
    expect(type_of(tof_tup) == "tuple", "type_of tuple (not i64) on AOT")
    expect(type_of(tof_map) == "map", "type_of map (not i64) on AOT")
    expect(type_of(42) == "i64" and type_of(1.5) == "f64" and type_of(true) == "bool", "type_of scalars")

    // STRUCTURAL equality on structs and enums (`==`/`!=`). Was broken: the
    // type-checker allowed it but codegen did not compare content -- JIT
    // silently returned `false`, AOT failed to build (`icmp requires integer
    // operands`). Now a synthesized `__kryos_eq_<Type>` helper compares
    // field-by-field (struct) / tag+payload (enum), recursively, on both
    // backends. (A struct/enum with an array/map field is rejected at
    // type-check -- not tested here since that's a compile error.)
    let eqpx1 = Pixel { r: 1, g: 2, b: 3 }
    let eqpx2 = Pixel { r: 1, g: 2, b: 3 }
    let eqpx3 = Pixel { r: 9, g: 2, b: 3 }
    expect(eqpx1 == eqpx2, "struct == equal (all fields match)")
    expect(not (eqpx1 == eqpx3), "struct == unequal (one field differs)")
    expect(eqpx1 != eqpx3, "struct != is the negation")
    let eqo1: Option<i64> = Some(5)
    let eqo2: Option<i64> = Some(5)
    let eqo3: Option<i64> = Some(6)
    let eqn1: Option<i64> = None()
    let eqn2: Option<i64> = None()
    expect(eqo1 == eqo2, "enum == equal payload (Some)")
    expect(not (eqo1 == eqo3), "enum == different payload")
    expect(eqn1 == eqn2, "enum == equal nullary variant (None)")
    expect(not (eqo1 == eqn1), "enum == different variant (Some vs None)")
    let eqt1 = (1, "a")
    let eqt2 = (1, "a")
    let eqt3 = (1, "b")
    expect(eqt1 == eqt2, "tuple == equal (mixed i64/str elements)")
    expect(not (eqt1 == eqt3), "tuple == unequal (one element differs)")

    // Match guards and wildcard.
    let v = 15
    let mut kind = ""
    match v {
        0 => { kind = "zero" }
        x if x % 5 == 0 => { kind = "five" }
        _ => { kind = "other" }
    }
    expect(kind == "five", "match guard")

    // `[any]`-erased array-of-arrays indexing (the shape zip/enumerate produce).
    // Regression: on AOT the erased `any` handle was indexed as an inline
    // aggregate (direct GEP on the header), so `p[0]` returned the array's
    // `len` field instead of element 0 -- a silent wrong-output miscompile on
    // release builds only. Both backends must now agree via array_get.
    let anyrows: [any] = [[10, 20], [30, 40]]
    let r0: any = anyrows[0]
    let r1: any = anyrows[1]
    expect(r0[0] == 10 and r0[1] == 20, "any-array index row0")
    expect(r1[0] == 30 and r1[1] == 40, "any-array index row1")
    // Float element read through an f64 target must bitcast, not read raw bits.
    let anyf: [any] = [1.5, 2.5]
    let fx: f64 = anyf[1]
    expect(fx > 2.4 and fx < 2.6, "any-array float element")

    // Or-pattern followed by a guard arm.
    expect(classify(2) == "low", "or-pattern+guard low")
    expect(classify(5) == "high", "or-pattern+guard high")
    expect(classify(-5) == "neg", "or-pattern+guard guard")

    // Nested match on the same value across mutually-exclusive outer arms.
    expect(apply(0, Cmd.Inc) == 1, "nested match arm0")
    expect(apply(1, Cmd.Dec) == -10, "nested match arm1")
    expect(apply(0, Cmd.Nop) == 0, "nested match nop")

    // Overwriting a struct element of an array (index-assign) then dropping the
    // array must not crash: the element must be heap-owned, not a stack alloca.
    let mut recs: [Rec] = [
        Rec { name: "a", n: 1, f: 1.0 },
        Rec { name: "b", n: 2, f: 2.0 },
    ]
    recs[0] = Rec { name: "z", n: 9, f: 9.0 }
    expect(recs[0].name == "z" and recs[1].name == "b", "struct-array overwrite")
    let tmp = recs[0]
    recs[0] = recs[1]
    recs[1] = tmp
    expect(recs[0].name == "b" and recs[1].name == "z", "struct-array swap")

    // Tuple match with MULTIPLE binding+guard arms of the same shape. These were
    // stuck on the switch path, which routed every `(a,b)` to the first arm's
    // block -- a failed guard fell to the default instead of the next guarded
    // arm, silently returning the wrong (empty) result.
    expect(quadrant(3, 4) == "Q1", "tuple guard Q1")
    expect(quadrant(-3, 4) == "Q2", "tuple guard Q2")
    expect(quadrant(-3, -4) == "Q3", "tuple guard Q3")
    expect(quadrant(3, -4) == "Q4", "tuple guard Q4")
    expect(quadrant(0, 0) == "origin", "tuple literal arm")
    expect(quadrant(0, 9) == "y-axis", "tuple wildcard arm")

    // Enum-with-payload VALUES stored in a map, then matched DIRECTLY on the
    // map-index expression. The map-index subject type did not surface as an
    // enum, so the match emitted a switch with zero cases and every value fell
    // to the None/default arm (a stored Some read back as None).
    let mut mopt: map<str, Option<i64>> = {}
    mopt["a"] = Some(90)
    mopt["b"] = None()
    match mopt["a"] {
        Some(v) => expect(v == 90, "map<str,Option> Some payload survives"),
        None() => expect(false, "map Some read back as None"),
    }
    match mopt["b"] {
        Some(v) => expect(false, "map None read back as Some {v}"),
        None() => expect(true, "map None ok"),
    }
    if let Some(v) = mopt["a"] {
        expect(v == 90, "if-let on map-index enum")
    } else {
        expect(false, "if-let map-index took else")
    }

    // Ambiguous bare variant: a user enum (Shelf) also defines `Some`. A bare
    // `Some(..)` in an Option context must DETERMINISTICALLY resolve to Option,
    // not to whichever enum a randomized HashMap happens to visit first (the
    // same source used to compile differently across runs).
    let so: Option<i64> = Some(11)
    match so {
        Some(v) => expect(v == 11, "bare Some resolves to Option under collision"),
        None() => expect(false, "bare Some misresolved"),
    }
    expect(shelf_label(Shelf.Some("book")) == "has:book", "qualified user variant still resolves")

    // Tuple-of-nested-enum matching (tag tested + payload extracted).
    expect(drive(Sig.On(5), 0) == "on-zero 5", "tuple nested-enum literal arm")
    expect(drive(Sig.On(99), 2) == "big 99 2", "tuple nested-enum guard arm")
    expect(drive(Sig.On(4), 3) == "on 4 3", "tuple nested-enum payload extracted")
    expect(drive(Sig.Off, 7) == "off 7", "tuple nested-enum other variant not stolen")

    // match-as-value str payload feeding a chained concat.
    expect(describe_user(1) == "alice is here", "match-value str payload chained concat")
    expect(describe_user(2) == "unknown", "match-value diverging arm")

    // Build [Struct] with a str field via push() in a loop. A bare-identifier
    // struct-literal field (`Rec{tag: tag}`) wasn't retained, so the loop's
    // scope-drop of `tag` freed the string the array element still held -- a
    // double-free / silent data corruption on AOT at scale. Read every element
    // back to catch corruption.
    let mut recs2: [Rec] = []
    let mut ri2 = 0
    while ri2 < 12 {
        let tag = "row-" + to_string(ri2)
        recs2 = push(recs2, Rec { name: tag, n: ri2, f: 0.0 })
        ri2 = ri2 + 1
    }
    let mut all_ok = true
    let mut rj = 0
    while rj < 12 {
        if recs2[rj].name != "row-" + to_string(rj) {
            all_ok = false
        }
        rj = rj + 1
    }
    expect(all_ok, "push-built [Struct] str fields intact (no double-free corruption)")

    // Nested-tuple pattern element: inner bindings + literal test + guard.
    let ntp = (7, (2, 3), 9)
    match ntp {
        (n, (a, b), tag) => expect(n == 7 and a == 2 and b == 3 and tag == 9, "nested-tuple inner bindings"),
    }
    expect(nested_tuple_cls(1, 0, 9) == "yzero 1 9", "nested-tuple literal element")
    expect(nested_tuple_cls(2, 8, 3) == "gt 2 8 3", "nested-tuple guard on inner binding")
    expect(nested_tuple_cls(3, 4, 5) == "def 3 4 5", "nested-tuple default arm")

    // 3-level tuple nesting: bindings below depth 1 were silently zeroed.
    let deep3 = (1, (2, (3, 4)), 5)
    match deep3 {
        (dn, (da, (dc, dd)), dt) => {
            expect(dn == 1 and da == 2 and dc == 3 and dd == 4 and dt == 5, "3-level tuple bindings")
        }
    }

    // Recursive enum built with dotted construction from heap-locals, recursed.
    let la = Btree.Leaf(3)
    let lb = Btree.Leaf(4)
    let branch = Btree.Node(la, lb)
    let lc = Btree.Leaf(10)
    let root = Btree.Node(branch, lc)
    expect(tree_sum(root) == 17, "recursive enum tree_sum (no double-free)")

    // Array of structs with a non-copy nested-struct field: build, read, teardown
    // (must not segfault when the array drops at scope exit).
    let mut nests: [Nest] = []
    let mut ni = 0
    while ni < 6 {
        nests = push(nests, Nest { leaf: Leafy { s: "leaf-" + to_string(ni) }, n: ni })
        ni = ni + 1
    }
    expect(nests[0].leaf.s == "leaf-0" and nests[5].leaf.s == "leaf-5", "nested-struct-field array read")
    expect(nests[3].n == 3, "nested-struct outer field")

    // Struct patterns in match (was a silent 0-binding / fallthrough miscompile).
    expect(pixel_kind(Pixel { r: 0, g: 0, b: 0 }) == "black", "struct pattern all-zero literal fields")
    expect(pixel_kind(Pixel { r: 255, g: 255, b: 255 }) == "white", "struct pattern all-max literal fields")
    expect(pixel_kind(Pixel { r: 9, g: 0, b: 0 }) == "red:9", "struct pattern mixed literal + binding")
    expect(pixel_kind(Pixel { r: 1, g: 2, b: 3 }) == "mix:6", "struct pattern all-binding arm reads real fields")
    // A single irrefutable struct pattern is exhaustive (no wildcard needed).
    let bp = Pixel { r: 4, g: 5, b: 6 }
    let bsum = match bp { Pixel { r: r, g: g, b: b } => r + g + b }
    expect(bsum == 15, "single irrefutable struct pattern binds every field")

    // Struct FIELD interpolation works (whole-struct interpolation is a compile
    // error -- it used to print a raw pointer / segfault on AOT).
    let ip = Pixel { r: 7, g: 8, b: 9 }
    expect("r={ip.r} g={ip.g} b={ip.b}" == "r=7 g=8 b=9", "struct field interpolation renders the field values")

    // A char stringifies/interpolates as the CHARACTER, not its numeric code
    // point (`to_string('x')` was "120"). i64 to_string is unaffected.
    let ch = 'x'
    expect(to_string(ch) == "x", "to_string(char) renders the character, not its code")
    expect("[{ch}{'Z'}]" == "[xZ]", "char interpolation renders characters")
    expect(to_string(120) == "120", "to_string(i64) still renders the number")

    // f32 to_string / println / interpolation / assert_eq: the Cranelift JIT
    // must fpromote a statically-f32 value to f64 before the f64-sig runtime
    // formatter, or it crashed the JIT verifier ("arg 0 has type f32, expected
    // f64") on code AOT compiled fine. Both backends must print "1.5"/"3.75".
    let f32a: f32 = 1.5 as f32
    let f32b: f32 = 2.25 as f32
    expect(to_string(f32a) == "1.5", "to_string(f32) does not crash the JIT and formats correctly")
    expect(to_string(f32a + f32b) == "3.75", "f32 arithmetic result stringifies on both backends")
    expect("{f32b}" == "2.25", "f32 string interpolation works on both backends")

    // BARE payload-less enum variants in TUPLE patterns must DISCRIMINATE.
    // `(Red, Red)` used to bind both elements as fresh locals named `Red`, so
    // every tuple-of-bare-variant arm matched unconditionally and the FIRST
    // arm always won (decide(Green, Green) returned "both stop"). The same
    // held nested (a variant payload `(Light, i64)` matched with a bare
    // variant elem) and for a bare variant as a DIRECT payload (`Has(Red)`).
    // AOT additionally crashed extracting a payload-less enum from a tuple
    // slot (the raw tag was inttoptr'd and dereferenced) and rejected a
    // `(Enum, i64)` payload tuple as an unsized `%Name` type.
    expect(bare_tuple(TLight.TRed, TLight.TRed) == "rr", "bare-variant tuple arm 1 taken only for (Red,Red)")
    expect(bare_tuple(TLight.TGreen, TLight.TGreen) == "gg", "bare-variant tuple arm 2 discriminates (was: first arm always won)")
    expect(bare_tuple(TLight.TRed, TLight.TGreen) == "mix", "bare-variant tuple wildcard arm reached")
    expect(bare_tuple_guard(TLight.TRed, 9) == "r-big", "guarded bare-variant tuple arm (sequential path) tests the tag")
    expect(bare_tuple_guard(TLight.TRed, 1) == "r-small", "guard falls through within the same bare-variant tag")
    expect(bare_tuple_guard(TLight.TGreen, 9) == "g", "bare-variant tag test composes with guards")
    expect(nested_bare(TWrap.TPair((TLight.TRed, 3))) == "p-red 3", "bare variant nested in a payload tuple discriminates (red)")
    expect(nested_bare(TWrap.TPair((TLight.TGreen, 4))) == "p-green 4", "bare variant nested in a payload tuple discriminates (green)")
    expect(nested_bare(TWrap.TNo) == "no", "payload-less arm after nested-tuple arms")
    expect(direct_bare(TOpt2.THas(TLight.TRed)) == "h-red", "bare variant as a DIRECT payload field discriminates (red)")
    expect(direct_bare(TOpt2.THas(TLight.TGreen)) == "h-green", "bare variant as a DIRECT payload field discriminates (green)")
    expect(direct_bare(TOpt2.TNo2) == "n", "non-payload arm after direct-bare arms")
    let tl_tup = (TLight.TGreen, 5)
    let tl0 = tl_tup.0
    let tl_kind = match tl0 { TRed => "ex-red", TGreen => "ex-green" }
    expect(tl_kind == "ex-green", "payload-less enum extracted from a tuple slot carries its tag (AOT crashed here)")

    // Map values are ALWAYS boxed, including a SINGLE-field struct: the
    // generic single-field-by-value coercion collapsed `P { v }` to its raw
    // field on insert, so `m[k].field = x` (which mutates in place through
    // the handle map_get returns) inttoptr'd the raw value -> AOT segfault.
    // Multi-field structs and int-keyed maps must keep working.
    let mut sfm: map<str, TOne> = {}
    sfm["a"] = TOne { v: 1 }
    sfm["a"].v = 5
    expect(sfm["a"].v == 5, "in-place field mutation through a str-keyed map of single-field structs")
    let sfm_got = sfm["a"]
    expect(sfm_got.v == 5, "single-field struct map value reads back after in-place mutation")
    let mut sfi: map<i64, TOne> = {}
    sfi[7] = TOne { v: 70 }
    sfi[7].v = 71
    expect(sfi[7].v == 71, "in-place field mutation through an int-keyed map of single-field structs")

    // DEEP nested enum patterns (Pass-36): a bare-variant LEAF at nesting
    // depth >= 3 (`L3a(L2a(L1a))`) was bound as a local instead of tag-tested,
    // so it swallowed the sibling payload arm sharing the 2-level prefix; and
    // an enum pattern with its OWN nested sub-pattern used as a TUPLE element
    // (`(L2a(L1b(m)), n)`) routed to the switch tuple chain which emits NO
    // enum-element tests -- first arm won for EVERY input. The refinement is
    // also SHORT-CIRCUITED: an inner tag read derefs the payload and must
    // only run when the outer tag matched (eager evaluation segfaulted on a
    // different outer variant).
    expect(t36_deep(T36c.Cp(T36b.Bw(T36a.Ax))) == "p-w-x", "depth-3 bare leaf arm taken only for its own variant")
    expect(t36_deep(T36c.Cp(T36b.Bw(T36a.Ay(7)))) == "p-w-y:7", "depth-3 payload arm not swallowed by the bare-leaf arm")
    expect(t36_deep(T36c.Cp(T36b.Bv)) == "p-v", "depth-2 bare arm after deep arms")
    expect(t36_deep(T36c.Cq) == "q", "top-level bare arm after deep arms")
    expect(t36_tup((T36b.Bw(T36a.Ax), 1)) == "w-x:1", "nested-enum tuple element discriminates (bare leaf)")
    expect(t36_tup((T36b.Bw(T36a.Ay(7)), 2)) == "w-y:7,2", "nested-enum tuple element binds the deep payload")
    expect(t36_tup((T36b.Bv, 3)) == "v:3", "different OUTER variant does not take the first tuple arm (and no segfault)")

    // A doubly-nested generic enum stored as a MAP VALUE must keep its inner
    // tag+payload when read back. Previously `map<str, Option<Result<i64,str>>>`
    // lost the inner Result (outer Some matched, inner Ok(n) read 0) because
    // the map value type fell to a ctx-less lowering that named the nested
    // enum with a stub not matching the constructed value.
    let mut nm: map<str, Option<Result<i64, str>>> = {}
    nm["a"] = Some(Ok(9))
    nm["b"] = Some(Err("bad"))
    match nm["a"] {
        Some(Ok(n)) => expect(n == 9, "nested-enum map value: inner Ok payload survives"),
        Some(Err(e)) => expect(false, "nm[a] wrong inner tag (expected Ok)"),
        None() => expect(false, "nm[a] wrong outer tag"),
    }
    match nm["b"] {
        Some(Ok(n)) => expect(false, "nm[b] wrong inner tag (expected Err)"),
        Some(Err(e)) => expect(e == "bad", "nested-enum map value: inner Err payload survives"),
        None() => expect(false, "nm[b] wrong outer tag"),
    }

    println("conformance data: PASS")
}

enum T36a { Ax, Ay(i64) }
enum T36b { Bw(T36a), Bv }
enum T36c { Cp(T36b), Cq }

fn t36_deep(x: T36c) -> str {
    match x {
        Cp(Bw(Ax)) => return "p-w-x",
        Cp(Bw(Ay(n))) => return "p-w-y:" + to_string(n),
        Cp(Bv) => return "p-v",
        Cq => return "q",
    }
}

fn t36_tup(t: (T36b, i64)) -> str {
    match t {
        (Bw(Ax), n) => return "w-x:" + to_string(n),
        (Bw(Ay(m)), n) => return "w-y:" + to_string(m) + "," + to_string(n),
        (Bv, n) => return "v:" + to_string(n),
    }
}

struct TOne {
    v: i64,
}

enum TLight {
    TRed,
    TGreen,
}

enum TWrap {
    TPair((TLight, i64)),
    TNo,
}

enum TOpt2 {
    THas(TLight),
    TNo2,
}

fn bare_tuple(a: TLight, b: TLight) -> str {
    match (a, b) {
        (TRed, TRed) => return "rr",
        (TGreen, TGreen) => return "gg",
        _ => return "mix",
    }
}

fn bare_tuple_guard(a: TLight, n: i64) -> str {
    match (a, n) {
        (TRed, m) if m > 5 => return "r-big",
        (TRed, _) => return "r-small",
        (TGreen, _) => return "g",
    }
}

fn nested_bare(w: TWrap) -> str {
    match w {
        TWrap.TPair((TRed, k)) => return "p-red {k}",
        TWrap.TPair((TGreen, k)) => return "p-green {k}",
        TNo => return "no",
    }
}

fn direct_bare(o: TOpt2) -> str {
    match o {
        TOpt2.THas(TRed) => return "h-red",
        TOpt2.THas(TGreen) => return "h-green",
        TNo2 => return "n",
    }
}
