// Conformance: reading a container (array / map) out of a STRUCT field or a
// TUPLE element must leave the source intact on both backends (LEDGER items
// 3 + 51, 2026-10-06).
//
// The struct case: both backends retain a container field read, and MIR now
// drops the read temp to balance it (previously it leaked the whole container).
// The tuple case is the trap that fix first fell into: `t.0` lowers to the same
// field read but is NOT retained, so dropping it freed the tuple's array --
// `len(t.0)` in a loop zeroed `a` and a later `a[2]` panicked, on both
// backends. Found by review, not by the corpus census (no corpus program read
// a container out of a tuple). Self-checking: exits 1 on any wrong value.

struct Bag { items: [i64], tags: map<str, i64> }

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn count_items(b: Bag) -> i64 {
    return len(b.items) + len(b.tags)
}

fn main() {
    // tuple element: array
    let a = [1, 2, 3]
    let t = (a, 7)
    let mut i = 0
    let mut s = 0
    while i < 5 {
        s = s + len(t.0)
        i = i + 1
    }
    expect(s == 15, "len(t.0) summed over 5 reads")
    expect(len(a) == 3, "tuple's array intact after reads")
    expect(a[2] == 3, "tuple's array contents intact after reads")

    // tuple element: map
    let mut m: map<str, i64> = {}
    m["x"] = 1
    m["y"] = 2
    let tm = (m, 0)
    let mut j = 0
    let mut sm = 0
    while j < 5 {
        sm = sm + len(tm.0)
        j = j + 1
    }
    expect(sm == 10, "len(tm.0) summed over 5 reads")
    expect(m["y"] == 2, "tuple's map intact after reads")

    // struct fields: repeated reads, direct and through a call
    let mut tags: map<str, i64> = {}
    tags["k"] = 9
    let b = Bag { items: [4, 5, 6, 7], tags: tags }
    let mut k = 0
    let mut sb = 0
    while k < 5 {
        sb = sb + len(b.items) + len(b.tags) + count_items(b)
        k = k + 1
    }
    expect(sb == 50, "struct field reads summed")
    expect(b.items[3] == 7, "struct array field intact after reads")
    expect(b.tags["k"] == 9, "struct map field intact after reads")
    println("conf_container_field_read_ownership: ok")
}
