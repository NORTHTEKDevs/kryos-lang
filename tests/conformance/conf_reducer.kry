// Conformance: a Result<Struct-with-a-heap-field> produced by a fn, bound to a
// named local, matched, and its Ok payload reassigned to a loop-carried var --
// the reducer / event-sourcing pattern. The named match SUBJECT's scope-end
// drop freed the struct payload's array/map field that the bound `next` (and
// the loop-carried `current`) still referenced -> use-after-free: JIT exit-127
// after correct output, AOT `corrupt array header data=0x0` exit-98. Fixed by
// retaining the bound struct payload's heap fields and releasing the previous
// value on reassignment. Kept to a few iterations (the fix currently deep-
// copies, so this is intentionally small).

use std::result::{Result, Ok, Err}

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

struct Acc {
    sum: i64,
    log: [i64],
}

fn step(a: Acc, n: i64) -> Result<Acc, str> {
    if n < 0 {
        return Err("negative")
    }
    let mut l: [i64] = a.log
    l = push(l, n)
    return Ok(Acc { sum: a.sum + n, log: l })
}

fn reduce(a: Acc, ns: [i64]) -> Result<Acc, str> {
    let mut cur: Acc = a
    for n in ns {
        let r = step(cur, n)
        match r {
            Ok(next) => { cur = next },
            Err(e) => return Err(e),
        }
    }
    return Ok(cur)
}

fn main() {
    let start: Acc = Acc { sum: 0, log: [] }
    let res = reduce(start, [10, 20, 30, 40])
    match res {
        Ok(fin) => {
            expect(fin.sum == 100, "reducer sum")
            expect(len(fin.log) == 4, "reducer accumulated all history (no UAF)")
            expect(fin.log[0] == 10 and fin.log[3] == 40, "reducer history contents correct")
        },
        Err(e) => expect(false, "reducer unexpected err: {e}"),
    }
    // Err path mid-loop.
    let start2: Acc = Acc { sum: 0, log: [] }
    let res2 = reduce(start2, [1, 2, -1, 3])
    match res2 {
        Ok(fin) => expect(false, "reducer should have errored"),
        Err(e) => expect(e == "negative", "reducer Err path propagates"),
    }

    println("conformance reducer: PASS")
}
