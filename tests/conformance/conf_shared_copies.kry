// Conformance (LEDGER item 137): copies and field reads of `shared` values.
//   * `(*a, 3)` and `[*a, *a]` of a `shared` struct: the tuple / array slot owns
//     its copy, because the arc frees its own contents when it is released.
//   * a struct that owns a `shared` field: reading through it, returning,
//     pushing, wrapping in `Some` and `let`-binding the field each give the
//     new owner its own arc reference, so dropping the struct frees nothing
//     the new owner still reads.
//   * `for x in xs` over a `[shared T]` releases its per-element reference.
// Every probe lets the source go away, churns the allocator so freed blocks
// are REUSED, and only then reads the value back.
use std::option::{Option}

struct L { next: Option<shared L>, v: i64, name: str }
struct Box1 { h: shared L, k: i64 }

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

fn mk(v: i64) -> L {
    return L { next: None(), v: v, name: "node-" + to_string(v) + "-padpadpad" }
}

fn mk_box(v: i64) -> Box1 {
    return Box1 { h: shared mk(v), k: 2 }
}

fn churn(k: i64) -> i64 {
    let mut t = 0
    let mut i = 0
    while i < 40 {
        let z = "zz-" + to_string(k + i) + "-qqqqqqqqqqqqqqqq"
        let n: shared L = shared mk(k + i)
        t = t + len(z) + (*n).v
        i = i + 1
    }
    return t
}

fn tup_copy(v: i64) -> (L, i64) {
    let a = shared mk(v)
    return (*a, 3)
}

fn arr_copy(v: i64) -> [L] {
    let a = shared mk(v)
    return [*a, *a]
}

fn ret_field(v: i64) -> shared L {
    let b = mk_box(v)
    return b.h
}

fn push_field(v: i64) -> [shared L] {
    let b = mk_box(v)
    let mut xs: [shared L] = []
    xs = push(xs, b.h)
    return xs
}

fn some_field(v: i64) -> Option<shared L> {
    let b = mk_box(v)
    return Some(b.h)
}

fn let_field(v: i64) -> shared L {
    let b = mk_box(v)
    let a = b.h
    return a
}

fn read_field(b: Box1) -> i64 {
    return (*b.h).v + b.k
}

fn walk(xs: [shared L]) -> i64 {
    let mut t = 0
    for x in xs { t = t + (*x).v + len((*x).name) }
    return t
}

fn check(h: shared L, v: i64, what: str) {
    expect((*h).v == v, what + " v " + to_string((*h).v) + " want " + to_string(v))
    expect((*h).name == "node-" + to_string(v) + "-padpadpad", what + " name " + (*h).name)
}

fn main() {
    let mut i = 0
    let mut c = 0
    while i < 30 {
        let v = 100 + i
        let tp = tup_copy(v)
        let ar = arr_copy(v + 1)
        let rf = ret_field(v + 2)
        let pf = push_field(v + 3)
        let sf = some_field(v + 4)
        let lf = let_field(v + 5)
        let bx = mk_box(v + 6)
        c = c + churn(i * 7)
        expect(tp.0.v == v, "tuple v " + to_string(tp.0.v))
        expect(tp.0.name == "node-" + to_string(v) + "-padpadpad", "tuple name " + tp.0.name)
        expect(tp.1 == 3, "tuple tail")
        expect(ar[0].v == v + 1 and ar[1].v == v + 1, "array v")
        expect(ar[1].name == "node-" + to_string(v + 1) + "-padpadpad", "array name " + ar[1].name)
        check(rf, v + 2, "ret_field")
        check(pf[0], v + 3, "push_field")
        match sf {
            Option.Some(x) => { check(x, v + 4, "some_field") },
            Option.None => { expect(false, "some_field none") },
        }
        check(lf, v + 5, "let_field")
        expect(read_field(bx) == v + 8, "read_field")
        let ws = push_field(v + 7)
        expect(walk(ws) == (v + 7) + len("node-" + to_string(v + 7) + "-padpadpad"), "walk")
        i = i + 1
    }
    expect(c > 0, "churn ran")
    println("shared copies ok {c}")
}
