// Conformance (2026-10-11): the double frees, use-after-frees and wrong
// answers the seventh adversarial review (~/scratch/kryos-cb/review7) found
// in the ownership batch before merge. Run under KRYOS_FREE_DIAG on both
// backends, and on AOT with real frees, by tests/no_double_free.sh.

struct P { name: str, n: i64 }
struct Q { inner: P, n: i64, tag: str }
struct S { t: (str, i64), n: i64 }
struct W { inner: S, k: i64 }
struct Ax { xs: [str], n: i64 }

fn expect(cond: bool, what: str) {
    if not cond {
        println("CONF FAIL: {what}")
        exit(1)
    }
}

// Reuses freed memory, so a dangling read shows up with real frees.
fn churn(i: i64) -> i64 {
    let mut junk: [str] = []
    let mut j = 0
    while j < 50 {
        junk = push(junk, "junk{i}-{j}")
        j = j + 1
    }
    return len(junk)
}

fn main() {
    // A closure that mutates a captured struct: the closure env owns it.
    // Pushing it, returning it, or reassigning it whole must give the
    // receiver its own copy and leave the env's value intact.
    let mut p = P { name: "p{0}", n: 0 }
    let pushes = || {
        p.n = p.n + 1
        let mut arr: [P] = []
        arr = push(arr, p)
        return len(arr) + p.n
    }
    let a1 = pushes()
    let a2 = pushes()
    expect(a1 == 2 and a2 == 3 and p.name == "p0", "captured struct pushed")

    let mut r = P { name: "r{0}", n: 0 }
    let bump = || {
        r.n = r.n + 1
        return r
    }
    let r1 = bump()
    let r2 = bump()
    churn(1)
    expect(r1.n == 1 and r2.n == 2 and r1.name == "r0", "captured struct returned")

    let mut s = P { name: "a{0}", n: 0 }
    let grow = || {
        s = P { name: s.name + "!", n: s.n + 1 }
        return s
    }
    let g1 = grow()
    let g2 = grow()
    churn(2)
    expect(g1.name == "a0!" and g1.n == 1 and g2.name == "a0!!" and g2.n == 2, "captured struct reassigned and returned")

    // A whole reassignment inside a match arm persists like any other.
    let mut m = P { name: "x{0}", n: 0 }
    let arm = |k: i64| {
        match k % 2 {
            0 => { m = P { name: "x{m.n + 1}", n: m.n + 1 } }
            _ => { m = P { name: "x{m.n + 1}", n: m.n + 1 } }
        }
        return "{m.n} {m.name}"
    }
    let m1 = arm(0)
    let m2 = arm(1)
    churn(3)
    expect(m1 == "1 x1" and m2 == "2 x2" and m.name == "x0", "match-arm reassignment of a capture")

    // Field stores (str, struct) and a whole reassignment with a struct
    // field, many times over.
    let mut q = Q { inner: P { name: "c", n: 0 }, n: 0, tag: "t" }
    let step = |k: i64| {
        q.tag = "s{k}"
        q.inner = P { name: "i{k}", n: k }
        q = Q { inner: P { name: "w{k}", n: k }, n: q.n + 1, tag: q.tag + "w" }
        return len(q.tag) + q.n
    }
    let mut total = 0
    let mut k = 0
    while k < 5 {
        total = total + step(k)
        k = k + 1
    }
    churn(4)
    expect(total == 30 and q.n == 0 and q.tag == "t", "captured struct field stores")

    // The closure's copy of a captured struct owns its array's elements:
    // replacing the array inside the closure released strings the outer
    // struct's array still held (AOT, real frees).
    let mut ax = Ax { xs: ["x{0}", "y{0}"], n: 0 }
    let swap = |k: i64| {
        ax.xs = ["z{k}"]
        return len(ax.xs)
    }
    let s1 = swap(1)
    let s2 = swap(2)
    churn(7)
    expect(s1 == 1 and s2 == 1 and ax.xs[0] == "x0" and ax.xs[1] == "y0", "captured struct array field replaced")

    // A tuple read out of a struct field owns its elements: overwriting or
    // dropping the struct must not free them under the read.
    let mut arr = [S { t: ("ar{1}", 1), n: 1 }]
    let ta = arr[0].t
    arr[0] = S { t: ("ar{2}", 2), n: 2 }
    let mut st = S { t: ("st{1}", 1), n: 1 }
    let tf = st.t
    st = S { t: ("st{2}", 2), n: 2 }
    let mut w = W { inner: S { t: ("n{1}", 1), n: 1 }, k: 1 }
    let tn = w.inner.t
    w = W { inner: S { t: ("n{2}", 2), n: 2 }, k: 2 }
    let sm: map<str, S> = {}
    sm["k"] = S { t: ("mp{1}", 1), n: 1 }
    let tm = sm["k"].t
    sm["k"] = S { t: ("mp{2}", 2), n: 2 }
    churn(5)
    expect(ta.0 == "ar1" and tf.0 == "st1" and tn.0 == "n1" and tm.0 == "mp1", "tuple field reads")

    // A tuple stored into a field from another place shares it.
    let mut o = S { t: ("d{1}", 1), n: 1 }
    let mut s3 = S { t: ("z{0}", 0), n: 0 }
    s3.t = o.t
    o = S { t: ("d{2}", 2), n: 2 }
    let tmv: map<str, (str, i64)> = {}
    tmv["r"] = ("r{1}", 1)
    let mut s4 = S { t: ("z{0}", 0), n: 0 }
    s4.t = tmv["r"]
    tmv["r"] = ("r{2}", 2)
    churn(6)
    expect(s3.t.0 == "d1" and s4.t.0 == "r1" and o.t.0 == "d2", "tuple field stores from a place")

    println("conformance review7 fixes: PASS")
}
