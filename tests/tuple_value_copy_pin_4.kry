// Pin (finish item A20): a tuple is a VALUE. On the JIT it is one refcounted heap array that
// every owner shared, so a field write through one name showed through the others (AOT copies).
// Pin (finish item A20, verifier residuals): a tuple read out of an array element, a struct
// field, a map value or reassigned from another tuple is a value copy, not a shared handle.
struct S { p: (i64, i64), q: i64 }
fn part_b() {
    let arr = [(1, 2), (3, 4)]
    let mut e = arr[0]
    e.0 = 77
    println("arr {arr[0].0} e={e.0}")

    let s = S { p: (1, 2), q: 0 }
    let mut c = s.p
    c.0 = 55
    println("field s.p={s.p.0} c={c.0}")

    let t = (2, "b")
    let mut u = (1, "a")
    u = t
    u.0 = 9
    println("reassign t={t.0} u={u.0}")

    let mut arr2 = [(1, 2), (3, 4)]
    let e2 = arr2[0]
    arr2[0].0 = 50
    println("late arr2={arr2[0].0} e2={e2.0}")

    let mut s2 = S { p: (1, 2), q: 0 }
    let c2 = s2.p
    s2.p.0 = 60
    println("late field s2.p={s2.p.0} c2={c2.0}")

    let mut a = (1, 2)
    let b = a
    a.0 = 5
    println("late local a={a.0} b={b.0}")
}

struct S2 { p: (i64, str), q: i64 }
fn mk(i: i64) -> S2 { S2 { p: (i, "m{i}"), q: i } }
fn part_c() {
    let mut arr = [(1, "a"), (2, "b")]
    let mut u = (0, "z")
    u = arr[1]
    u.0 = 9
    println("asg-idx arr={arr[1].0} u={u.0} {u.1}")
    let mut s = S2 { p: (1, "x"), q: 0 }
    u = s.p
    u.0 = 8
    println("asg-field s={s.p.0} u={u.0} {u.1}")
    let mut a = (1, (2, "n"))
    let n = a.1
    a.1.0 = 99
    println("nested a={a.1.0} n={n.0} {n.1}")
    let mut m = {"k": (5, "v")}
    let mut mv = m["k"]
    mv.0 = 6
    println("map m={m["k"].0} mv={mv.0}")
    let mut total = 0
    for i in 0..300 {
        let mut e = arr[i % 2]
        e.0 = e.0 + i
        let c = mk(i).p
        let mut d = s.p
        d.0 = d.0 + 1
        total = total + e.0 + c.0 + d.0
        arr[i % 2] = (i, "r{i}")
    }
    println("total {total}")
    for x in arr {
        let mut y = x
        y.0 = 1000
        println("for {x.0} {y.0}")
    }
    let w = mk(3)
    let mut v = w.p
    v.0 = 4
    println("w {w.p.0} {w.p.1} v {v.0} {v.1}")
}

fn main() {
    part_b()
    part_c()
}
