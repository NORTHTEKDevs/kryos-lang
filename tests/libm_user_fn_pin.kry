fn sin(x: f64) -> f64 {
    return 42.0
}
fn cos(x: f64) -> f64 {
    return 43.0
}
fn sqrt(x: f64) -> f64 {
    return 44.0
}
fn floor(x: f64) -> f64 {
    return 45.0
}
fn exp(x: f64) -> f64 {
    return 46.0
}
