// Pin (finish item A20): a tuple is a VALUE. On the JIT it is one refcounted heap array that
// every owner shared, so a field write through one name showed through the others (AOT copies).
use std::option::{Option, Some, None}
struct S { p: (i64, str), q: i64 }
struct W { items: [S], t: (f64, bool) }
enum E { A((i64, str)), B(i64) }
fn viaParam(s: S) -> i64 {
    let mut c = s.p
    c.0 = 1000
    return c.0 + s.p.0
}
impl S {
    fn bump(self) -> i64 {
        let mut t = self.p
        t.0 = t.0 + 7
        return t.0 + self.p.0
    }
}
fn mk() -> (i64, str) { return (4, "mk") }
fn main() {
    // param/method
    let s = S { p: (5, "s"), q: 1 }
    println("2 {viaParam(s)} s={s.p.0} {s.bump()} s={s.p.0}")
    // array of structs, struct with tuple, chained
    let mut arr = [S { p: (1, "a"), q: 0 }, S { p: (2, "b"), q: 0 }]
    let held = arr[0].p
    arr[0].p.0 = 99
    println("3 held={held.0} arr={arr[0].p.0}")
    // three-level nest tuple
    let mut deep = (1, (2, (3, "d")))
    let deep2 = deep
    deep.1.1.0 = 33
    println("4 deep={deep.1.1.0} deep2={deep2.1.1.0}")
    // float/bool tuples
    let ft = (1.5, true)
    let mut ft2 = ft
    ft2.0 = 2.5
    ft2.1 = false
    println("5 {ft.0} {ft.1} {ft2.0} {ft2.1}")
    // fresh from fn
    let mut m = mk()
    let m2 = m
    m.0 = 9
    println("6 m={m.0} m2={m2.0}")
    // array swap
    let mut sw = [(1, "x"), (2, "y")]
    let tmp = sw[0]
    sw[0] = sw[1]
    sw[1] = tmp
    sw[0].0 = 90
    println("7 sw0={sw[0].0} sw1={sw[1].0} tmp={tmp.0}")
    // enum payload
    let e = E.A((1, "e"))
    match e {
        E.A(t) => {
            let mut c = t
            c.0 = 55
            println("8 t={t.0} c={c.0}")
        }
        E.B(n) => println("b")
    }
    // while loop repeated writes
    let mut acc = (0, "acc")
    let snap = acc
    let mut i = 0
    while i < 5 {
        acc.0 = acc.0 + i
        i = i + 1
    }
    println("9 acc={acc.0} snap={snap.0}")
    // struct containing array of tuples
    let mut w = W { items: [S { p: (1, "w"), q: 0 }], t: (1.0, true) }
    let wt = w.t
    w.t.0 = 8.0
    println("10 w.t={w.t.0} wt={wt.0}")
    // tuple copied into struct field then source mutated
    let mut src = (1, "src")
    let mut holder = S { p: src, q: 0 }
    src.0 = 2
    holder.p.0 = 3
    println("11 src={src.0} holder={holder.p.0}")
    // assign tuple into existing struct field
    let mut s3 = S { p: (0, "z"), q: 0 }
    let mut o = (1, "o")
    s3.p = o
    o.0 = 11
    s3.p.0 = s3.p.0 + 100
    println("12 o={o.0} s3={s3.p.0}")
    // option
    let mut op = Some((1, "p"))
    let cp = op
    match op {
        Some(v) => {
            let mut z = v
            z.0 = 6
            println("13 v={v.0} z={z.0}")
        }
        None => println("n")
    }
}
