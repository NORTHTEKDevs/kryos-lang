// Pin (finish item A20): a tuple is a VALUE. On the JIT it is one refcounted heap array that
// every owner shared, so a field write through one name showed through the others (AOT copies).
use std::option::{Option, Some, None}
struct S { p: (i64, str), q: i64 }
fn bump(p: (i64, str)) -> i64 {
    let mut q = p
    q.0 = 99
    return q.0
}
fn ident(t: (i64, str)) -> (i64, str) { return t }
fn main() {
    // 1 let mut u = t
    let t = (1, "a")
    let mut u = t
    u.0 = 7
    println("1 t={t.0} u={u.0}")
    // 2 mut src, immutable dst, later write to src
    let mut a = (1, "a")
    let b = a
    a.0 = 5
    println("2 a={a.0} b={b.0}")
    // 3 push then mutate source
    let mut m3 = (1, "x")
    let mut arr3 = [(0, "z")]
    push(arr3, m3)
    m3.0 = 9
    println("3 m={m3.0} arr={arr3[1].0}")
    // 4 push then mutate element
    let m4 = (1, "x")
    let mut arr4 = [(0, "z")]
    push(arr4, m4)
    arr4[1].0 = 9
    println("4 m={m4.0} arr={arr4[1].0}")
    // 5 index assign
    let mut m5 = (1, "x")
    let mut arr5 = [(0, "z")]
    arr5[0] = m5
    m5.0 = 9
    println("5 m={m5.0} arr={arr5[0].0}")
    // 6 index assign then mutate element
    let m6 = (1, "x")
    let mut arr6 = [(0, "z")]
    arr6[0] = m6
    arr6[0].0 = 9
    println("6 m={m6.0} arr={arr6[0].0}")
    // 7 struct literal field
    let mut m7 = (1, "x")
    let s7 = S { p: m7, q: 0 }
    m7.0 = 9
    println("7 m={m7.0} s={s7.p.0}")
    // 8 struct literal then mutate field
    let m8 = (1, "x")
    let mut s8 = S { p: m8, q: 0 }
    s8.p.0 = 9
    println("8 m={m8.0} s={s8.p.0}")
    // 9 param
    let m9 = (1, "x")
    let r9 = bump(m9)
    println("9 m={m9.0} r={r9}")
    // 11 returned from ident
    let m11 = (1, "x")
    let mut r11 = ident(m11)
    r11.0 = 9
    println("11 m={m11.0} r={r11.0}")
    // 12 destructure nested
    let m12 = ((1, "a"), 2)
    let (x12, y12) = m12
    let mut z12 = x12
    z12.0 = 9
    println("12 m={m12.0.0} x={x12.0} z={z12.0} y={y12}")
    // 13 for loop var
    let arr13 = [(1, "a"), (2, "b")]
    for e in arr13 {
        let mut f = e
        f.0 = 50
    }
    println("13 {arr13[0].0} {arr13[1].0}")
    // 14 map insert
    let mut m14 = (1, "x")
    let mut mm = {"k": (0, "z")}
    mm["k"] = m14
    m14.0 = 9
    println("14 m={m14.0} mm={mm["k"].0}")
    // 15 option
    let mut m15 = (1, "x")
    let o15 = Some(m15)
    m15.0 = 9
    match o15 { Some(v) => println("15 m={m15.0} o={v.0}"), None => println("none") }
    // 16 tuple literal containing tuple var
    let mut m16 = (1, "x")
    let w16 = (m16, 5)
    m16.0 = 9
    println("16 m={m16.0} w={w16.0.0}")
    // 17 tuple literal then mutate nested
    let m17 = (1, "x")
    let mut w17 = (m17, 5)
    w17.0.0 = 9
    println("17 m={m17.0} w={w17.0.0}")
}
