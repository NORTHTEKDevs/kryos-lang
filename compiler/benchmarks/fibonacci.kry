// fibonacci.kry -- Recursive fibonacci(35), timed benchmark
//
// Expected result: 9227465
// Tests: recursive function call overhead, stack frame performance

fn fibonacci(n: i64) -> i64 {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn main() {
    let start = time_now()
    let result = fibonacci(35)
    let elapsed = time_now() - start
    println("=== Fibonacci Benchmark ===")
    println("fibonacci(35) = " + to_string(result))
    println("Time: " + to_string(elapsed) + "s")
}
