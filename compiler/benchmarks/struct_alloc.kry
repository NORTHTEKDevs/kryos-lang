// struct_alloc.kry -- Create 100,000 structs with string fields, timed
//
// Expected result: count 100000
// Tests: struct allocation, string field ownership, and drop performance

struct Item {
    name: str,
    value: i64,
}

fn main() {
    let start = time_now()
    let mut count = 0
    let mut i = 0
    while i < 100000 {
        let item = Item { name: "item_" + to_string(i), value: i }
        count = count + 1
        i = i + 1
    }
    let elapsed = time_now() - start
    println("=== Struct Alloc Benchmark ===")
    println("count = " + to_string(count))
    println("Time: " + to_string(elapsed) + "s")
}
