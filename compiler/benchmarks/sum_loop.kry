// sum_loop.kry -- Sum integers 1 to 100,000,000 in a while loop, timed
//
// Expected result: 5000000050000000
// Tests: tight loop performance, integer arithmetic throughput

fn main() {
    let start = time_now()
    let mut sum = 0
    let mut i = 1
    while i <= 100000000 {
        sum = sum + i
        i = i + 1
    }
    let elapsed = time_now() - start
    println("=== Sum Loop Benchmark ===")
    println("sum(1..100000000) = " + to_string(sum))
    println("Time: " + to_string(elapsed) + "s")
}
