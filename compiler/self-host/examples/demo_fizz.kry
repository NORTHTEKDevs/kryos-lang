fn fizzbuzz(n: i64) {
    let mut i: i64 = 1
    while i <= n {
        if i % 15 == 0 {
            println("FizzBuzz")
        } elif i % 3 == 0 {
            println("Fizz")
        } elif i % 5 == 0 {
            println("Buzz")
        } else {
            println(to_string(i))
        }
        i = i + 1
    }
}

fn main() {
    fizzbuzz(15)
}
