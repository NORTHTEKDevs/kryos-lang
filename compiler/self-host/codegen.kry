// ============================================================
// codegen.kry -- MIR-to-x86_64 code generation for the Kryos
// self-hosted compiler.
//
// Takes MIR (from lower.kry), runs register allocation (from
// regalloc.kry), and emits x86_64 machine code (via x86.kry)
// into byte buffers.  Produces symbol tables and relocations
// for the object file emitter (elf.kry / coff.kry) and linker
// (linker.kry).
//
// Pipeline:
//   MIR -> optimize -> regalloc -> codegen -> emit -> link
//
// Dependencies (same compilation unit):
//   mir.kry      -- MIR data structures
//   regalloc.kry -- register allocation
//   x86.kry      -- x86_64 instruction encoding
//   elf.kry      -- ELF object emission
//   coff.kry     -- COFF object emission
//   linker.kry   -- static linking
// ============================================================

use mir
use regalloc
use x86
use elf
use coff
use linker

// ===================================================================
// Code generation context
// ===================================================================

@copy
struct CodegenCtx {
    text_buf: i64,               // byte buffer for .text section
    data_buf: i64,               // byte buffer for .data section
    rodata_buf: i64,             // byte buffer for .rodata section
    symbols: [LinkerSymbol],     // symbol table entries
    relocations: [LinkerReloc],  // relocations to patch
    string_offsets: [str],       // string literal values
    string_positions: [i32],     // corresponding offsets in .rodata
    func_offsets: [str],         // function name -> offset mapping (names)
    func_positions: [i32],       // function name -> offset mapping (offsets)
    block_offsets: [i32],        // per-function: block id -> byte offset in .text
    branch_patches: [BranchPatch], // forward jumps to patch after all blocks emitted
    target_os: str               // "linux" or "windows"
}

// A forward branch that needs patching once we know the target block offset
@copy
struct BranchPatch {
    patch_offset: i32,  // offset in text_buf where the rel32 is
    target_block: i32   // which basic block we're jumping to
}

// ===================================================================
// Context constructor
// ===================================================================

fn cg_new(target_os: str) -> CodegenCtx {
    // CRITICAL: every array field must get its OWN distinct empty array.
    // Reusing one `empty_strs` / `empty_ints` binding across multiple fields
    // makes those fields share a single backing buffer (the LLVM backend's
    // @copy struct construction stores the array HANDLE shallowly; only the
    // Cranelift backend clones it -- which is why stage-0 was unaffected).
    // With sharing, e.g. cg_intern_string's push to string_positions also
    // grew func_positions and block_offsets, desyncing func_offsets from
    // func_positions, so cg_lookup_func returned a WRONG function offset and
    // every internal call in stage-2-compiled code jumped to garbage. This
    // was THE blocker-#2 miscompile (and the bulk of the apparent
    // "non-determinism": shared-buffer reallocs are heap-address-sensitive).
    let f_symbols: [LinkerSymbol] = []
    let f_relocs: [LinkerReloc] = []
    let f_str_off: [str] = []
    let f_str_pos: [i32] = []
    let f_fn_off: [str] = []
    let f_fn_pos: [i32] = []
    let f_blk_off: [i32] = []
    let f_patches: [BranchPatch] = []
    return CodegenCtx {
        text_buf: buf_new(4096),
        data_buf: buf_new(4096),
        rodata_buf: buf_new(4096),
        symbols: f_symbols,
        relocations: f_relocs,
        string_offsets: f_str_off,
        string_positions: f_str_pos,
        func_offsets: f_fn_off,
        func_positions: f_fn_pos,
        block_offsets: f_blk_off,
        branch_patches: f_patches,
        target_os: target_os
    }
}

// ===================================================================
// String literal internment
//
// String constants go into .rodata.  We deduplicate them.
// ===================================================================

fn cg_intern_string(ctx: CodegenCtx, s: str) -> i32 {
    // Check if already interned
    let mut i = 0
    while i < len(ctx.string_offsets) {
        if ctx.string_offsets[i] == s {
            return ctx.string_positions[i]
        }
        i = i + 1
    }
    // Add new string to .rodata
    let offset = buf_len(ctx.rodata_buf)
    // Write string bytes + null terminator
    let mut j = 0
    let slen = len(s)
    while j < slen {
        buf_write_byte(ctx.rodata_buf, char_code(substr(s, j, j + 1)))
        j = j + 1
    }
    buf_write_byte(ctx.rodata_buf, 0)  // null terminator
    push(ctx.string_offsets, s)
    push(ctx.string_positions, offset)
    return offset
}

// ===================================================================
// Register for function location
// ===================================================================

fn cg_register_func(ctx: CodegenCtx, name: str, offset: i32) {
    push(ctx.func_offsets, name)
    push(ctx.func_positions, offset)
}

fn cg_lookup_func(ctx: CodegenCtx, name: str) -> i32 {
    let mut i = 0
    while i < len(ctx.func_offsets) {
        if ctx.func_offsets[i] == name {
            return ctx.func_positions[i]
        }
        i = i + 1
    }
    return -1  // external function
}

// ===================================================================
// Stack frame layout
//
// System V AMD64 calling convention:
//   [rbp+16]  = arg 7+  (stack-passed arguments)
//   [rbp+8]   = return address
//   [rbp]     = saved rbp
//   [rbp-8]   = first spill slot
//   [rbp-16]  = second spill slot
//   ...
//   [rsp]     = bottom of frame (16-byte aligned)
//
// Callee-saved registers are pushed after rbp.
// ===================================================================

fn cg_stack_offset(spill_slot: i32) -> i32 {
    // DEPRECATED: ignores callee-saved area, which would alias spills
    // onto the pushed callee-saved registers. Use cg_stack_offset_ra
    // instead. Kept for callers that have not been migrated.
    return -8 * (spill_slot + 1)
}

fn cg_stack_offset_ra(ra: RegAllocResult, spill_slot: i32) -> i32 {
    // Prologue order:
    //   push rbp
    //   mov rbp, rsp
    //   push <callee-saved>...
    //   sub rsp, frame
    // So bytes [rbp-8 .. rbp - 8 * cs_count] hold the saved callee-
    // saved regs, and the local frame begins at rbp - 8 * cs_count - 8.
    let cs_count = len(ra.callee_saved)
    let base: i32 = -8 * cs_count
    return base - 8 * (spill_slot + 1)
}

// Stack offset for the FALLBACK slot of an unallocated local. Each
// local_id maps to a unique slot above the regalloc-managed spill
// slots. The frame is reserved with extra fudge bytes by
// cg_emit_prologue so these slots are within the allocated frame.
fn cg_fallback_slot_offset(ra: RegAllocResult, local_id: i32) -> i32 {
    // Place fallback slots AFTER the regalloc-managed spill slots.
    // Reserved by FALLBACK_SLOT_BASE = 128 * 8 = 1024 bytes of fudge
    // space below the normal frame.
    let cs_count = len(ra.callee_saved)
    let base: i32 = -8 * cs_count
    // Fallback slots must sit BELOW every regalloc spill slot. Spill slot s
    // lives at base - 8*(s+1), with s in 0..stack_size-1, so the spill region
    // ends at base - 8*stack_size. The previous formula used stack_size/8,
    // which (stack_size being a SLOT count, not bytes) placed fallback_start
    // only stack_size/8 slots below base -- INSIDE the spill region. For large
    // functions (main/tokenize/parse spill 100+ locals) every fallback write
    // then clobbered a live spilled local, corrupting the frame and breaking
    // control flow after the dispatch -- the scale-dependent stage-2 miscompile.
    // The 2048-byte (256-slot) prologue fudge covers local_id up to 255.
    let fallback_start: i32 = base - 8 * (ra.stack_size + 1)
    return fallback_start - 8 * local_id
}

// ===================================================================
// Emit function prologue
// ===================================================================

fn cg_emit_prologue(ctx: CodegenCtx, ra: RegAllocResult) {
    let buf = ctx.text_buf
    // push rbp                              ; rsp: 8 -> 0 (mod 16)
    x86_push_reg(buf, REG_RBP)
    // mov rbp, rsp
    x86_mov_reg_reg(buf, REG_RBP, REG_RSP)
    // Save callee-saved registers FIRST so the subsequent sub rsp
    // amount can include alignment padding for an odd push count.
    let mut i = 0
    while i < len(ra.callee_saved) {
        x86_push_reg(buf, ra.callee_saved[i])
        i = i + 1
    }
    // After N callee-saved pushes, rsp is mod-16 == 8*(N % 2).
    // We need rsp to be 0 (mod 16) at any subsequent call site.
    // The shadow space (32 bytes) is always 16-aligned so doesn't
    // change parity. The frame is rounded up to 16 too. So if N is
    // odd, add 8 extra bytes of padding to restore alignment.
    //
    // Reserve an extra 2048 bytes (256 i64 slots) of fudge space
    // below the regalloc-managed frame for cg_get_local_reg's
    // fallback per-local-id slots. cg_fallback_slot_offset places
    // those slots starting at base - 8 * (stack_size/8 + 1), so
    // they fit within the extended frame.
    let mut frame = cg_align16(ra.stack_size * 8) + 2048
    if (len(ra.callee_saved) % 2) != 0 {
        frame = frame + 8
    }
    if frame > 0 {
        x86_sub_reg_imm32(buf, REG_RSP, frame)
    }
    // Spill register-passed parameters to their fixed stack slots.
    // ra_fix_arg_intervals marked params with reg=REG_SPILLED and
    // spill_slot=pi. Match each param to its incoming arg register
    // and store there. Done AFTER frame is allocated so [rbp - off]
    // is valid stack memory.
    let mut pi: i32 = 0
    while pi < len(ra.intervals) {
        let iv = ra.intervals[pi]
        if iv.is_fixed and iv.reg == REG_SPILLED and iv.spill_slot >= 0 {
            // Locate this param's index by spill_slot (we encoded
            // param-index directly into spill_slot).
            let arg_reg = cg_arg_reg_for(ctx.target_os, iv.spill_slot)
            if arg_reg >= 0 {
                let offset = cg_stack_offset_ra(ra, iv.spill_slot)
                x86_mov_mem_reg(buf, REG_RBP, offset, arg_reg)
            }
        }
        pi = pi + 1
    }
}

// ===================================================================
// Emit function epilogue
// ===================================================================

fn cg_emit_epilogue(ctx: CodegenCtx, ra: RegAllocResult) {
    let buf = ctx.text_buf
    // Tear down the local frame first; rsp = rbp - sizeof(saved regs).
    // `mov rsp, rbp` would overshoot the saved registers, so add the
    // exact local-frame size back instead. Must include the 2048-byte
    // fudge space the prologue reserved for cg_get_local_reg's
    // fallback slots.
    let mut frame = cg_align16(ra.stack_size * 8) + 2048
    if (len(ra.callee_saved) % 2) != 0 {
        frame = frame + 8
    }
    if frame > 0 {
        x86_add_reg_imm32(buf, REG_RSP, frame)
    }
    // Restore callee-saved registers (reverse order)
    let mut i = len(ra.callee_saved) - 1
    while i >= 0 {
        x86_pop_reg(buf, ra.callee_saved[i])
        i = i - 1
    }
    // pop rbp
    x86_pop_reg(buf, REG_RBP)
    // ret
    x86_ret(buf)
}

// ===================================================================
// Alignment helper
// ===================================================================

fn cg_align16(n: i32) -> i32 {
    if n == 0 { return 0 }
    return ((n + 15) / 16) * 16
}

// ===================================================================
// Get the register assigned to a MIR local, or load from spill slot
// ===================================================================

fn cg_get_local_reg(ctx: CodegenCtx, ra: RegAllocResult, local_id: i32, scratch: i32) -> i32 {
    // Find the interval for this local
    let mut i = 0
    while i < len(ra.intervals) {
        if ra.intervals[i].local_id == local_id {
            let interval = ra.intervals[i]
            if interval.reg >= 0 {
                return interval.reg
            }
            // Spilled — load into scratch register
            let offset = cg_stack_offset_ra(ra, interval.spill_slot)
            x86_mov_reg_mem(ctx.text_buf, scratch, REG_RBP, offset)
            return scratch
        }
        i = i + 1
    }
    // Not found — use a stable, unique fallback stack slot keyed by
    // local_id. Earlier this returned a fixed callee-saved reg (R12),
    // but that COLLIDED with the regalloc's R12 assignments for
    // other locals -- the same physical register held two different
    // logical values. Per-local-id stack slots are collision-free;
    // the cost is a memory load on every use.
    let offset = cg_fallback_slot_offset(ra, local_id)
    x86_mov_reg_mem(ctx.text_buf, scratch, REG_RBP, offset)
    return scratch
}

// ===================================================================
// Store a value to a local (register or spill slot)
// ===================================================================

fn cg_store_local(ctx: CodegenCtx, ra: RegAllocResult, local_id: i32, src_reg: i32) {
    let mut i = 0
    while i < len(ra.intervals) {
        if ra.intervals[i].local_id == local_id {
            let interval = ra.intervals[i]
            if interval.reg >= 0 {
                // In register — move if different
                if interval.reg != src_reg {
                    x86_mov_reg_reg(ctx.text_buf, interval.reg, src_reg)
                }
            } else {
                // Spilled — store to stack
                let offset = cg_stack_offset_ra(ra, interval.spill_slot)
                x86_mov_mem_reg(ctx.text_buf, REG_RBP, offset, src_reg)
            }
            return
        }
        i = i + 1
    }
    // Not found — store to fallback stack slot keyed by local_id.
    // Matches cg_get_local_reg's fallback to keep def and use sites
    // consistent. Without this, the def writes to src_reg (typically
    // RAX from cg_emit_instruction) but the use loads from the
    // fallback slot which was never written.
    let offset = cg_fallback_slot_offset(ra, local_id)
    x86_mov_mem_reg(ctx.text_buf, REG_RBP, offset, src_reg)
}

// ===================================================================
// Load an Operand into a register
// ===================================================================

fn cg_load_operand(ctx: CodegenCtx, ra: RegAllocResult, op: Operand, target_reg: i32) -> i32 {
    if env_get("KRYOS_OP_DUMP") == "1" {
        let mut il = 0
        if op.is_local { il = 1 }
        let mut bv = 0
        if op.bool_val { bv = 1 }
        eprintln("OP il=" + to_string(il) + " lid=" + to_string(op.local_id) + " ck=" + to_string(op.const_kind) + " iv=" + to_string(op.int_val) + " bv=" + to_string(bv))
    }
    if op.is_local {
        return cg_get_local_reg(ctx, ra, op.local_id, target_reg)
    }
    // Constant
    let buf = ctx.text_buf
    if op.const_kind == RV_CONST_INT {
        let val = op.int_val
        if val >= -2147483648 and val <= 2147483647 {
            x86_mov_reg_imm32(buf, target_reg, val)
        } else {
            // Need 64-bit immediate
            // For now, use 32-bit since our int_val is i32
            x86_mov_reg_imm32(buf, target_reg, val)
        }
        return target_reg
    } elif op.const_kind == RV_CONST_BOOL {
        if op.bool_val {
            x86_mov_reg_imm32(buf, target_reg, 1)
        } else {
            x86_xor_reg_reg(buf, target_reg, target_reg)
        }
        return target_reg
    } elif op.const_kind == RV_CONST_STRING {
        // Strings are KryosString HANDLES, not raw byte pointers. Stage-0's
        // codegen.rs:5147 turns `"hello"` into a runtime call
        //   kryos_string_new(rodata_ptr, len) -> KryosString*
        // so every str value passed to kryos_println_str / kryos_str_concat
        // / etc. is a proper handle whose first 8 bytes are the length.
        //
        // We do the same here:
        //   1. LEA arg0_reg, [rodata]   ; arg-0 = rodata pointer
        //   2. MOV arg1_reg, str_len    ; arg-1 = byte length
        //   3. SUB rsp, shadow_bytes    ; Win64 shadow space
        //   4. CALL kryos_string_new    ; with external reloc
        //   5. ADD rsp, shadow_bytes
        //   6. MOV target_reg, rax      ; if target != rax
        //
        // Without this, every string literal becomes a raw byte pointer
        // that kryos_println_str misinterprets as a KryosString*, reads
        // bogus `len` from the first 8 ASCII bytes, and silently no-ops.
        // That is exactly why stage-2 used to link, run, and print nothing.
        let str_off = cg_intern_string(ctx, op.str_val)
        let str_len = len(op.str_val)

        let arg0_reg = cg_arg_reg_for(ctx.target_os, 0)
        let arg1_reg = cg_arg_reg_for(ctx.target_os, 1)

        // 1. LEA arg0_reg, [rip + rodata + str_off]
        push(ctx.relocations, LinkerReloc {
            offset: buf_len(buf) + 3,
            symbol_name: "__rodata_base",
            rel_type: LREL_PC32,
            addend: str_off - 4
        })
        let rex = x86_rex(1, x86_reg_rex_bit(arg0_reg), 0, 0)
        buf_write_byte(buf, rex)
        buf_write_byte(buf, 0x8D)
        buf_write_byte(buf, x86_modrm(0, x86_reg_lo3(arg0_reg), 5))
        buf_write_i32_le(buf, 0)

        // 2. MOV arg1_reg, str_len  (32-bit immediate, zero-extended)
        x86_mov_reg_imm32(buf, arg1_reg, str_len)

        // 3. SUB rsp, 32 on Win64 (shadow space)
        let is_win = ctx.target_os == "windows"
        let shadow_bytes: i32 = if is_win { 32 } else { 0 }
        if shadow_bytes > 0 {
            x86_sub_reg_imm32(buf, REG_RSP, shadow_bytes)
        }

        // 4. CALL kryos_string_new with external relocation
        push(ctx.relocations, LinkerReloc {
            offset: buf_len(buf) + 1,
            symbol_name: "kryos_string_new",
            rel_type: LREL_PC32,
            addend: -4
        })
        x86_call_rel32(buf, 0)

        // 5. ADD rsp, shadow_bytes
        if shadow_bytes > 0 {
            x86_add_reg_imm32(buf, REG_RSP, shadow_bytes)
        }

        // 6. MOV target_reg, rax  (handle is in rax; move if different)
        if target_reg != REG_RAX {
            x86_mov_reg_reg(buf, target_reg, REG_RAX)
        }
        return target_reg
    } elif op.const_kind == RV_CONST_FLOAT {
        // Store float in .rodata and load via memory
        let flt_off = buf_len(ctx.rodata_buf)
        // Write f64 as 8 bytes — we'll use i64 bit pattern
        // For simplicity, store 0 and rely on runtime
        buf_write_i64_le(ctx.rodata_buf, 0)
        x86_mov_reg_imm32(buf, target_reg, 0)
        return target_reg
    }
    // RV_CONST_NONE
    x86_xor_reg_reg(buf, target_reg, target_reg)
    return target_reg
}

// ===================================================================
// Map MIR binary op to x86 condition code
// ===================================================================

fn mir_binop_to_cc(op: i32) -> i32 {
    if op == MIR_EQ { return CC_E }
    if op == MIR_NEQ { return CC_NE }
    if op == MIR_LT { return CC_L }
    if op == MIR_GT { return CC_G }
    if op == MIR_LT_EQ { return CC_LE }
    if op == MIR_GT_EQ { return CC_GE }
    return CC_E
}

// ===================================================================
// Is this a comparison operator?
// ===================================================================

fn is_comparison_op(op: i32) -> bool {
    return op == MIR_EQ or op == MIR_NEQ or op == MIR_LT or op == MIR_GT or op == MIR_LT_EQ or op == MIR_GT_EQ
}

// ===================================================================
// Emit code for an RValue
//
// Result goes into dest_reg.
// ===================================================================

fn cg_emit_rvalue(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32) {
    let buf = ctx.text_buf

    if rv.kind == RV_USE {
        // Copy operand to dest
        if len(rv.use_operand) > 0 {
            let r = cg_load_operand(ctx, ra, rv.use_operand[0], dest_reg)
            if r != dest_reg {
                x86_mov_reg_reg(buf, dest_reg, r)
            }
        }

    } elif rv.kind == RV_CONST_INT {
        x86_mov_reg_imm32(buf, dest_reg, rv.int_val)

    } elif rv.kind == RV_CONST_BOOL {
        if rv.bool_val {
            x86_mov_reg_imm32(buf, dest_reg, 1)
        } else {
            x86_xor_reg_reg(buf, dest_reg, dest_reg)
        }

    } elif rv.kind == RV_CONST_STRING {
        // Mirror the string ABI from cg_load_operand's RV_CONST_STRING
        // branch: emit LEA + kryos_string_new(ptr, len) -> handle. See
        // the longer comment there for why this is necessary.
        let str_off = cg_intern_string(ctx, rv.str_val)
        let str_len = len(rv.str_val)

        let arg0_reg = cg_arg_reg_for(ctx.target_os, 0)
        let arg1_reg = cg_arg_reg_for(ctx.target_os, 1)

        // 1. LEA arg0_reg, [__rodata_base + str_off]
        push(ctx.relocations, LinkerReloc {
            offset: buf_len(buf) + 3,
            symbol_name: "__rodata_base",
            rel_type: LREL_PC32,
            addend: str_off - 4
        })
        let rex = x86_rex(1, x86_reg_rex_bit(arg0_reg), 0, 0)
        buf_write_byte(buf, rex)
        buf_write_byte(buf, 0x8D)
        buf_write_byte(buf, x86_modrm(0, x86_reg_lo3(arg0_reg), 5))
        buf_write_i32_le(buf, 0)

        // 2. MOV arg1_reg, str_len
        x86_mov_reg_imm32(buf, arg1_reg, str_len)

        // 3. SUB rsp, 32 on Win64 (shadow space)
        let is_win = ctx.target_os == "windows"
        let shadow_bytes: i32 = if is_win { 32 } else { 0 }
        if shadow_bytes > 0 {
            x86_sub_reg_imm32(buf, REG_RSP, shadow_bytes)
        }

        // 4. CALL kryos_string_new
        push(ctx.relocations, LinkerReloc {
            offset: buf_len(buf) + 1,
            symbol_name: "kryos_string_new",
            rel_type: LREL_PC32,
            addend: -4
        })
        x86_call_rel32(buf, 0)

        // 5. ADD rsp, shadow_bytes
        if shadow_bytes > 0 {
            x86_add_reg_imm32(buf, REG_RSP, shadow_bytes)
        }

        // 6. MOV dest_reg, rax  (handle is in rax)
        if dest_reg != REG_RAX {
            x86_mov_reg_reg(buf, dest_reg, REG_RAX)
        }

    } elif rv.kind == RV_CONST_FLOAT {
        // Float constants — load from .rodata
        x86_mov_reg_imm32(buf, dest_reg, 0)

    } elif rv.kind == RV_CONST_NONE {
        x86_xor_reg_reg(buf, dest_reg, dest_reg)

    } elif rv.kind == RV_BINOP {
        cg_emit_binop(ctx, ra, rv, dest_reg)

    } elif rv.kind == RV_UNOP {
        cg_emit_unop(ctx, ra, rv, dest_reg)

    } elif rv.kind == RV_CALL {
        cg_emit_call(ctx, ra, rv, dest_reg)

    } elif rv.kind == RV_CALL_INDIRECT {
        cg_emit_call_indirect(ctx, ra, rv, dest_reg)

    } elif rv.kind == RV_FIELD {
        cg_emit_field_access(ctx, ra, rv, dest_reg)

    } elif rv.kind == RV_INDEX {
        cg_emit_index(ctx, ra, rv, dest_reg)

    } elif rv.kind == RV_STRUCT {
        cg_emit_struct_lit(ctx, ra, rv, dest_reg)

    } elif rv.kind == RV_ARRAY {
        cg_emit_array_lit(ctx, ra, rv, dest_reg)

    } elif rv.kind == RV_CAST {
        cg_emit_cast(ctx, ra, rv, dest_reg)

    } elif rv.kind == RV_ADDR_OF {
        // lea dest_reg, [rbp + offset_of_local]
        let local_offset = cg_stack_offset(rv.addr_local)
        x86_lea(buf, dest_reg, REG_RBP, local_offset)

    } elif rv.kind == RV_DEREF {
        if len(rv.deref_operand) > 0 {
            let ptr_reg = cg_load_operand(ctx, ra, rv.deref_operand[0], dest_reg)
            if ptr_reg != dest_reg {
                x86_mov_reg_reg(buf, dest_reg, ptr_reg)
            }
            x86_mov_reg_mem(buf, dest_reg, dest_reg, 0)
        }

    } elif rv.kind == RV_ENUM_TAG {
        // Load tag field (first field of enum = offset 0)
        if len(rv.enum_operand) > 0 {
            let obj_reg = cg_load_operand(ctx, ra, rv.enum_operand[0], REG_R10)
            x86_mov_reg_mem(buf, dest_reg, obj_reg, 0)
        }

    } elif rv.kind == RV_ENUM_PAYLOAD {
        // Load payload field at offset (field_idx + 1) * 8
        if len(rv.enum_operand) > 0 {
            let obj_reg = cg_load_operand(ctx, ra, rv.enum_operand[0], REG_R10)
            let payload_off = (rv.field_idx + 1) * 8
            x86_mov_reg_mem(buf, dest_reg, obj_reg, payload_off)
        }

    } elif rv.kind == RV_STRING_CONCAT {
        // Call runtime string concat
        cg_emit_string_concat(ctx, ra, rv, dest_reg)

    } else {
        // Unsupported rvalue — emit zero
        x86_xor_reg_reg(buf, dest_reg, dest_reg)
    }
}

// ===================================================================
// Binary operation code generation
// ===================================================================

fn cg_emit_binop(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32) {
    let buf = ctx.text_buf
    let op = rv.op

    // Load left into R10 and right into R11 (both scratch). Previously
    // left went into `dest_reg` directly, which caused a corruption
    // bug: if another live local (notably the right operand) happened
    // to be allocated to `dest_reg`, the `mov left_reg, src` for the
    // left operand would overwrite the right operand BEFORE its load.
    // Using scratch registers and moving the result to `dest_reg` at
    // the end keeps the operands independent.
    let left_reg = REG_R10
    if len(rv.left) > 0 {
        let lr = cg_load_operand(ctx, ra, rv.left[0], left_reg)
        if lr != left_reg {
            x86_mov_reg_reg(buf, left_reg, lr)
        }
    }
    let right_reg = REG_R11
    if len(rv.right) > 0 {
        let rr = cg_load_operand(ctx, ra, rv.right[0], right_reg)
        if rr != right_reg {
            x86_mov_reg_reg(buf, right_reg, rr)
        }
    }

    // For arith / bitwise / shift ops the result accumulates in
    // `left_reg`. Since we now use R10 as the scratch left_reg, we
    // must MOV the result into `dest_reg` at the end. Comparison and
    // logical AND/OR write `dest_reg` directly, so no extra move
    // there. DIV/MOD already MOV explicitly.
    let mut needs_result_mov: bool = false
    if op == MIR_ADD {
        x86_add_reg_reg(buf, left_reg, right_reg)
        needs_result_mov = true
    } elif op == MIR_SUB {
        x86_sub_reg_reg(buf, left_reg, right_reg)
        needs_result_mov = true
    } elif op == MIR_MUL {
        x86_imul_reg_reg(buf, left_reg, right_reg)
        needs_result_mov = true
    } elif op == MIR_DIV {
        // IDIV: RAX / src -> RAX (quotient), RDX (remainder)
        if left_reg != REG_RAX {
            x86_mov_reg_reg(buf, REG_RAX, left_reg)
        }
        x86_cqo(buf)
        x86_idiv_reg(buf, right_reg)
        if dest_reg != REG_RAX {
            x86_mov_reg_reg(buf, dest_reg, REG_RAX)
        }
    } elif op == MIR_MOD {
        if left_reg != REG_RAX {
            x86_mov_reg_reg(buf, REG_RAX, left_reg)
        }
        x86_cqo(buf)
        x86_idiv_reg(buf, right_reg)
        // Remainder is in RDX
        if dest_reg != REG_RDX {
            x86_mov_reg_reg(buf, dest_reg, REG_RDX)
        }
    } elif op == MIR_BIT_AND {
        x86_and_reg_reg(buf, left_reg, right_reg)
        needs_result_mov = true
    } elif op == MIR_BIT_OR {
        x86_or_reg_reg(buf, left_reg, right_reg)
        needs_result_mov = true
    } elif op == MIR_BIT_XOR {
        x86_xor_reg_reg(buf, left_reg, right_reg)
        needs_result_mov = true
    } elif op == MIR_SHL {
        // SHL needs shift count in CL
        if right_reg != REG_RCX {
            x86_mov_reg_reg(buf, REG_RCX, right_reg)
        }
        x86_shl_reg_cl(buf, left_reg)
        needs_result_mov = true
    } elif op == MIR_SHR {
        if right_reg != REG_RCX {
            x86_mov_reg_reg(buf, REG_RCX, right_reg)
        }
        x86_sar_reg_cl(buf, left_reg)
        needs_result_mov = true
    } elif op == MIR_AND {
        // Logical AND: both nonzero -> 1
        x86_test_reg_reg(buf, left_reg, left_reg)
        x86_setcc(buf, CC_NE, left_reg)
        x86_test_reg_reg(buf, right_reg, right_reg)
        x86_setcc(buf, CC_NE, right_reg)
        x86_and_reg_reg(buf, left_reg, right_reg)
        x86_movzx_r64_r8(buf, dest_reg, left_reg)
    } elif op == MIR_OR {
        // Logical OR
        x86_or_reg_reg(buf, left_reg, right_reg)
        x86_test_reg_reg(buf, left_reg, left_reg)
        x86_setcc(buf, CC_NE, dest_reg)
        x86_movzx_r64_r8(buf, dest_reg, dest_reg)
    } elif is_comparison_op(op) {
        // CMP left, right  then SETcc dest
        x86_cmp_reg_reg(buf, left_reg, right_reg)
        let cc = mir_binop_to_cc(op)
        x86_setcc(buf, cc, dest_reg)
        x86_movzx_r64_r8(buf, dest_reg, dest_reg)
    }

    if needs_result_mov {
        if dest_reg != left_reg {
            x86_mov_reg_reg(buf, dest_reg, left_reg)
        }
    }
}

// ===================================================================
// Unary operation code generation
// ===================================================================

fn cg_emit_unop(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32) {
    let buf = ctx.text_buf
    if len(rv.left) > 0 {
        let r = cg_load_operand(ctx, ra, rv.left[0], dest_reg)
        if r != dest_reg {
            x86_mov_reg_reg(buf, dest_reg, r)
        }
    }
    if rv.op == MIR_NEG {
        x86_neg_reg(buf, dest_reg)
    } elif rv.op == MIR_NOT {
        // Logical not: test, sete
        x86_test_reg_reg(buf, dest_reg, dest_reg)
        x86_setcc(buf, CC_E, dest_reg)
        x86_movzx_r64_r8(buf, dest_reg, dest_reg)
    } elif rv.op == MIR_BIT_NOT {
        x86_not_reg(buf, dest_reg)
    }
}

// ===================================================================
// Function call code generation
//
// System V AMD64: args in RDI, RSI, RDX, RCX, R8, R9
// Return value in RAX.
// Caller saves: RAX, RCX, RDX, RSI, RDI, R8, R9, R10, R11
// ===================================================================

// SYS V argument-register order (Linux/macOS): RDI, RSI, RDX, RCX, R8, R9.
let ARG_REGS_0 = 7   // REG_RDI
let ARG_REGS_1 = 6   // REG_RSI
let ARG_REGS_2 = 2   // REG_RDX
let ARG_REGS_3 = 1   // REG_RCX
let ARG_REGS_4 = 8   // REG_R8
let ARG_REGS_5 = 9   // REG_R9

fn cg_arg_reg(idx: i32) -> i32 {
    if idx == 0 { return ARG_REGS_0 }
    if idx == 1 { return ARG_REGS_1 }
    if idx == 2 { return ARG_REGS_2 }
    if idx == 3 { return ARG_REGS_3 }
    if idx == 4 { return ARG_REGS_4 }
    if idx == 5 { return ARG_REGS_5 }
    return -1  // stack argument
}

// Win64 argument-register order: RCX, RDX, R8, R9. Remaining args go
// on the stack with a 32-byte shadow space reserved by the caller.
fn cg_arg_reg_for(target_os: str, idx: i32) -> i32 {
    if target_os == "windows" {
        if idx == 0 { return 1 }   // RCX
        if idx == 1 { return 2 }   // RDX
        if idx == 2 { return 8 }   // R8
        if idx == 3 { return 9 }   // R9
        return -1                  // stack argument
    }
    return cg_arg_reg(idx)
}

// Emit a call to kryos_string_eq(left, right) and store the result
// in dest_reg. If `invert` is true, XOR the result with 1 to convert
// equality to inequality. Used by cg_emit_binop for MIR_EQ/MIR_NEQ
// when either operand is a string literal.
fn cg_emit_string_eq(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32, invert: bool) {
    let buf = ctx.text_buf
    let arg0_reg = cg_arg_reg_for(ctx.target_os, 0)
    let arg1_reg = cg_arg_reg_for(ctx.target_os, 1)

    // Load left into arg-0 reg
    if len(rv.left) > 0 {
        let lr = cg_load_operand(ctx, ra, rv.left[0], arg0_reg)
        if lr != arg0_reg {
            x86_mov_reg_reg(buf, arg0_reg, lr)
        }
    }
    // Load right into arg-1 reg
    if len(rv.right) > 0 {
        let rr = cg_load_operand(ctx, ra, rv.right[0], arg1_reg)
        if rr != arg1_reg {
            x86_mov_reg_reg(buf, arg1_reg, rr)
        }
    }

    // Win64 shadow space.
    let is_win = ctx.target_os == "windows"
    let shadow_bytes: i32 = if is_win { 32 } else { 0 }
    if shadow_bytes > 0 {
        x86_sub_reg_imm32(buf, REG_RSP, shadow_bytes)
    }

    // CALL kryos_string_new ... wait, kryos_string_eq.
    push(ctx.relocations, LinkerReloc {
        offset: buf_len(buf) + 1,
        symbol_name: "kryos_string_eq",
        rel_type: LREL_PC32,
        addend: -4
    })
    x86_call_rel32(buf, 0)

    if shadow_bytes > 0 {
        x86_add_reg_imm32(buf, REG_RSP, shadow_bytes)
    }

    // Result is in RAX (bool, low byte).
    if invert {
        // Test RAX; SETZ to get !RAX (sets to 1 if RAX was 0).
        // Then movzx to extend the byte.
        x86_test_reg_reg(buf, REG_RAX, REG_RAX)
        x86_setcc(buf, CC_E, REG_RAX)
        x86_movzx_r64_r8(buf, REG_RAX, REG_RAX)
    }
    if dest_reg != REG_RAX {
        x86_mov_reg_reg(buf, dest_reg, REG_RAX)
    }
}

// Emit the strlen-via-`repne scasb` sequence + write(2) for the
// null-terminated string whose pointer is in RDI. Used by both the
// `print` and `println` inline lowerings. The RSI register is set to
// the string pointer so a subsequent write(2) for a newline can reuse
// the saved address from RSI without recomputing it.
fn cg_emit_write_strz_linux(ctx: CodegenCtx, ra: RegAllocResult) {
    let buf = ctx.text_buf

    // strlen via repne scasb:
    //   mov rsi, rdi        ; save original ptr for the write syscall
    //   xor rax, rax        ; al = 0 (scasb sentinel)
    //   mov rcx, -1         ; max count
    //   cld                 ; direction = forward
    //   repne scasb         ; scan [rdi]++ until [rdi]==al
    //   not rcx             ; rcx = strlen + 1
    //   dec rcx             ; rcx = strlen
    x86_mov_reg_reg(buf, REG_RSI, REG_RDI)
    x86_xor_reg_reg(buf, REG_RAX, REG_RAX)
    x86_mov_reg_imm32(buf, REG_RCX, -1)
    buf_write_byte(buf, 0xFC)               // cld
    buf_write_byte(buf, 0xF2)               // repne prefix
    buf_write_byte(buf, 0xAE)               // scasb
    buf_write_byte(buf, 0x48)               // REX.W
    buf_write_byte(buf, 0xF7)               // not r/m64
    buf_write_byte(buf, 0xD1)               // modrm: mod=11, /2, rm=rcx
    buf_write_byte(buf, 0x48)               // REX.W
    buf_write_byte(buf, 0xFF)               // dec r/m64
    buf_write_byte(buf, 0xC9)               // modrm: mod=11, /1, rm=rcx

    // write(1, rsi, rcx):
    x86_mov_reg_reg(buf, REG_RDX, REG_RCX)
    x86_mov_reg_imm32(buf, REG_RAX, 1)
    x86_mov_reg_imm32(buf, REG_RDI, 1)
    x86_syscall(buf)
}

// Inline-syscall lowering of `kryos_print_str` for Linux.
fn cg_emit_print_inline_linux(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue) {
    let buf = ctx.text_buf
    let arg_r = cg_load_operand(ctx, ra, rv.args[0], REG_RDI)
    if arg_r != REG_RDI {
        x86_mov_reg_reg(buf, REG_RDI, arg_r)
    }
    cg_emit_write_strz_linux(ctx, ra)
}

// Inline-syscall lowering of `kryos_println_str` for Linux. Bypasses
// the runtime entirely: emits write(2) for the string body + a second
// write(2) for the trailing newline. The string is expected to be a
// pointer to null-terminated bytes (the rodata interning format).
fn cg_emit_println_inline_linux(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue) {
    let buf = ctx.text_buf

    // Load arg 0 (str ptr) into RDI per sysv calling convention.
    let arg_r = cg_load_operand(ctx, ra, rv.args[0], REG_RDI)
    if arg_r != REG_RDI {
        x86_mov_reg_reg(buf, REG_RDI, arg_r)
    }

    // strlen via repne scasb:
    //   mov rsi, rdi        ; save original ptr for the write syscall
    //   xor rax, rax        ; al = 0 (scasb sentinel)
    //   mov rcx, -1         ; max count (sign-extended from imm32)
    //   cld                 ; direction = forward
    //   repne scasb         ; scan [rdi]++ until [rdi]==al
    //   not rcx             ; rcx = strlen + 1
    //   dec rcx             ; rcx = strlen
    x86_mov_reg_reg(buf, REG_RSI, REG_RDI)
    x86_xor_reg_reg(buf, REG_RAX, REG_RAX)
    x86_mov_reg_imm32(buf, REG_RCX, -1)
    buf_write_byte(buf, 0xFC)               // cld
    buf_write_byte(buf, 0xF2)               // repne prefix
    buf_write_byte(buf, 0xAE)               // scasb
    buf_write_byte(buf, 0x48)               // REX.W
    buf_write_byte(buf, 0xF7)               // not r/m64
    buf_write_byte(buf, 0xD1)               // modrm: mod=11, /2, rm=rcx
    buf_write_byte(buf, 0x48)               // REX.W
    buf_write_byte(buf, 0xFF)               // dec r/m64
    buf_write_byte(buf, 0xC9)               // modrm: mod=11, /1, rm=rcx

    // write(1, rsi, rcx):
    //   mov rdx, rcx
    //   mov rax, 1
    //   mov rdi, 1
    //   syscall
    x86_mov_reg_reg(buf, REG_RDX, REG_RCX)
    x86_mov_reg_imm32(buf, REG_RAX, 1)
    x86_mov_reg_imm32(buf, REG_RDI, 1)
    x86_syscall(buf)

    // Trailing newline: push 0x0A as imm8, point rsi at rsp, write 1 byte.
    //   push 0x0A           ; 0x6A 0x0A — pushes sign-extended imm8
    //   mov rsi, rsp
    //   mov rdx, 1
    //   mov rax, 1
    //   mov rdi, 1
    //   syscall
    //   add rsp, 8
    buf_write_byte(buf, 0x6A)
    buf_write_byte(buf, 0x0A)
    x86_mov_reg_reg(buf, REG_RSI, REG_RSP)
    x86_mov_reg_imm32(buf, REG_RDX, 1)
    x86_mov_reg_imm32(buf, REG_RAX, 1)
    x86_mov_reg_imm32(buf, REG_RDI, 1)
    x86_syscall(buf)
    x86_add_reg_imm32(buf, REG_RSP, 8)
}

// Generic syscallN intrinsic lowering for Linux.
//
// `n_syscall_args` excludes the syscall number itself. So a call to
// `syscall1(num, a)` has n_syscall_args = 1, and the Kryos call has
// 2 arguments total: rv.args[0] is the syscall number (goes to RAX),
// rv.args[1] is the first syscall arg (goes to RDI), etc.
//
// Linux x86_64 syscall ABI: RAX=number, args in RDI, RSI, RDX, R10,
// R8, R9. Return value comes back in RAX.
fn cg_emit_syscall_n_inline_linux(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32, n_syscall_args: i32) {
    let buf = ctx.text_buf
    let n_total = n_syscall_args + 1

    // syscall arg register table (index 0 = syscall number register)
    let regs: [i32] = [REG_RAX, REG_RDI, REG_RSI, REG_RDX, REG_R10, REG_R8, REG_R9]

    // Load args in reverse so we don't clobber inputs as we go.
    let mut i = n_total - 1
    while i >= 0 {
        let target = regs[i]
        let r = cg_load_operand(ctx, ra, rv.args[i], target)
        if r != target {
            x86_mov_reg_reg(buf, target, r)
        }
        i = i - 1
    }

    x86_syscall(buf)

    if dest_reg != REG_RAX {
        x86_mov_reg_reg(buf, dest_reg, REG_RAX)
    }
}

// Inline lowering of `kryos_builtin_exit(code)` -> sys_exit_group.
// Marks the call as never-returning (no need to preserve dest_reg).
fn cg_emit_exit_inline_linux(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue) {
    let buf = ctx.text_buf
    // Load exit code into RDI.
    let arg_r = cg_load_operand(ctx, ra, rv.args[0], REG_RDI)
    if arg_r != REG_RDI {
        x86_mov_reg_reg(buf, REG_RDI, arg_r)
    }
    // mov rax, 231   ; sys_exit_group
    x86_mov_reg_imm32(buf, REG_RAX, 231)
    x86_syscall(buf)
}

fn cg_emit_call(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32) {
    let buf = ctx.text_buf
    let n_args = len(rv.args)

    // Inline-syscall lowering for known runtime entry points.
    if ctx.target_os == "linux" {
        if rv.func_name == "kryos_println_str" {
            cg_emit_println_inline_linux(ctx, ra, rv)
            return
        }
        if rv.func_name == "kryos_print_str" {
            cg_emit_print_inline_linux(ctx, ra, rv)
            return
        }
        if rv.func_name == "kryos_builtin_exit" {
            cg_emit_exit_inline_linux(ctx, ra, rv)
            return
        }
        if rv.func_name == "syscall1" {
            cg_emit_syscall_n_inline_linux(ctx, ra, rv, dest_reg, 1)
            return
        }
        if rv.func_name == "syscall2" {
            cg_emit_syscall_n_inline_linux(ctx, ra, rv, dest_reg, 2)
            return
        }
        if rv.func_name == "syscall3" {
            cg_emit_syscall_n_inline_linux(ctx, ra, rv, dest_reg, 3)
            return
        }
        if rv.func_name == "syscall6" {
            cg_emit_syscall_n_inline_linux(ctx, ra, rv, dest_reg, 6)
            return
        }
    }

    // Calling-convention split:
    //   SYS V (Linux): first 6 args in RDI,RSI,RDX,RCX,R8,R9; rest on stack.
    //   Win64:         first 4 args in RCX,RDX,R8,R9; rest on stack + 32 bytes
    //                  of caller-allocated shadow space (always reserved,
    //                  even when no stack args are passed).
    let is_win = ctx.target_os == "windows"
    let reg_cutoff: i32 = if is_win { 4 } else { 6 }

    // Push stack arguments first (right to left) for args > reg_cutoff.
    let mut stack_args = 0
    if n_args > reg_cutoff {
        let mut i = n_args - 1
        while i >= reg_cutoff {
            let arg_r = cg_load_operand(ctx, ra, rv.args[i], REG_R10)
            x86_push_reg(buf, arg_r)
            stack_args = stack_args + 1
            i = i - 1
        }
    }

    // Win64 requires 32 bytes of shadow space before the call. Carve
    // it out now; we will reclaim it together with any stack args.
    let shadow_bytes: i32 = if is_win { 32 } else { 0 }
    if shadow_bytes > 0 {
        x86_sub_reg_imm32(buf, REG_RSP, shadow_bytes)
    }

    // Load register arguments. Load in reverse to avoid clobbering
    // earlier values when register choices overlap.
    let mut reg_count = n_args
    if reg_count > reg_cutoff { reg_count = reg_cutoff }
    let mut i = reg_count - 1
    while i >= 0 {
        let target = cg_arg_reg_for(ctx.target_os, i)
        let r = cg_load_operand(ctx, ra, rv.args[i], target)
        if r != target {
            x86_mov_reg_reg(buf, target, r)
        }
        i = i - 1
    }

    // Emit call
    let func_name = rv.func_name
    let func_off = cg_lookup_func(ctx, func_name)
    if func_off >= 0 {
        // Internal function — relative call
        let call_site = buf_len(buf)
        let rel = func_off - (call_site + 5)
        x86_call_rel32(buf, rel)
    } else {
        // External function — emit relocation
        push(ctx.relocations, LinkerReloc {
            offset: buf_len(buf) + 1,  // after E8 opcode
            symbol_name: func_name,
            rel_type: LREL_PC32,
            addend: -4
        })
        x86_call_rel32(buf, 0)  // placeholder
    }

    // Reclaim shadow space + stack args together.
    let total_stack = shadow_bytes + stack_args * 8
    if total_stack > 0 {
        x86_add_reg_imm32(buf, REG_RSP, total_stack)
    }

    // Mask RAX to AL for known bool-returning runtime functions.
    // Win64 (and SysV) ABIs only define the low byte of the return
    // register for i8/bool returns; high bits are undefined. Without
    // this, a previous register state can leak through and a bool
    // result of 0 (false) can read as nonzero (true) on `test rax, rax`.
    let fname = rv.func_name
    if fname == "kryos_string_eq" or fname == "kryos_string_contains" {
        x86_movzx_r64_r8(buf, REG_RAX, REG_RAX)
    }

    // Move result from RAX to dest
    if dest_reg != REG_RAX {
        x86_mov_reg_reg(buf, dest_reg, REG_RAX)
    }
}

// ===================================================================
// Indirect call (closure / function pointer)
// ===================================================================

fn cg_emit_call_indirect(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32) {
    let buf = ctx.text_buf
    // Load callee address
    if len(rv.callee) > 0 {
        let callee_reg = cg_load_operand(ctx, ra, rv.callee[0], REG_R10)
        if callee_reg != REG_R10 {
            x86_mov_reg_reg(buf, REG_R10, callee_reg)
        }
    }
    // Load arguments
    let n_args = len(rv.args)
    let reg_count = n_args
    if reg_count > 6 { let reg_count = 6 }
    let mut i = reg_count - 1
    while i >= 0 {
        let target = cg_arg_reg(i)
        let r = cg_load_operand(ctx, ra, rv.args[i], target)
        if r != target {
            x86_mov_reg_reg(buf, target, r)
        }
        i = i - 1
    }
    // CALL R10: FF /2 with ModR/M(11, 2, R10)
    let rex = x86_rex(0, 0, 0, x86_reg_rex_bit(REG_R10))
    buf_write_byte(buf, rex)
    buf_write_byte(buf, 0xFF)
    buf_write_byte(buf, x86_modrm(3, 2, x86_reg_lo3(REG_R10)))
    // Result in RAX
    if dest_reg != REG_RAX {
        x86_mov_reg_reg(buf, dest_reg, REG_RAX)
    }
}

// ===================================================================
// Field access — struct fields at known offsets
// ===================================================================

fn cg_emit_field_access(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32) {
    let buf = ctx.text_buf
    if len(rv.object) > 0 {
        let obj_reg = cg_load_operand(ctx, ra, rv.object[0], REG_R10)
        // Struct values are heap pointers; every field is an 8-byte slot.
        // The field index is resolved at lowering (rv.field_idx) from the
        // receiver's struct definition, so the offset is field_idx * 8.
        x86_mov_reg_mem(buf, dest_reg, obj_reg, rv.field_idx * 8)
    }
}

// ===================================================================
// Index access — array element at runtime index
// ===================================================================

fn cg_emit_index(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32) {
    let buf = ctx.text_buf
    if len(rv.index_obj) > 0 and len(rv.index_idx) > 0 {
        // arr is a pointer to the KryosArray header:
        //   { i64 len, i64 cap, i64 elem_size, i64 ref_count, *u8 data }
        // data lives at offset 32 from the header.
        let arr_reg = cg_load_operand(ctx, ra, rv.index_obj[0], REG_R10)
        let idx_reg = cg_load_operand(ctx, ra, rv.index_idx[0], REG_R11)
        // Move both to scratch registers we own, so we can clobber.
        if arr_reg != REG_R10 {
            x86_mov_reg_reg(buf, REG_R10, arr_reg)
        }
        if idx_reg != REG_R11 {
            x86_mov_reg_reg(buf, REG_R11, idx_reg)
        }
        // R10 = arr_header_ptr. Load data pointer: r10 = [r10 + 32].
        x86_mov_reg_mem(buf, REG_R10, REG_R10, 32)
        // shl R11, 3  (multiply index by 8)  -- C1 /4 ib
        let rex = x86_rex(1, 0, 0, x86_reg_rex_bit(REG_R11))
        buf_write_byte(buf, rex)
        buf_write_byte(buf, 0xC1)
        buf_write_byte(buf, x86_modrm(3, 4, x86_reg_lo3(REG_R11)))
        buf_write_byte(buf, 3)
        // r10 = data + idx*8
        x86_add_reg_reg(buf, REG_R10, REG_R11)
        // dest = [r10]
        x86_mov_reg_mem(buf, dest_reg, REG_R10, 0)
    }
}

// ===================================================================
// Struct literal — allocate and fill fields
// ===================================================================

fn cg_emit_struct_lit(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32) {
    let buf = ctx.text_buf
    // Call runtime allocator for struct. Each field is 8 bytes.
    // kryos_alloc(size) -> pointer. The size arg must go in the ABI's
    // first argument register, and Win64 needs 32 bytes of shadow space
    // reserved before the call. Previously this hardcoded REG_RDI (the
    // SysV register) and reserved no shadow space, so on Windows EVERY
    // struct literal passed garbage (whatever was in RCX) as the size and
    // corrupted the stack across the call -- breaking all struct
    // construction (e.g. lexer_new's `Lexer { pos: 0 }` never returned).
    let n_fields = len(rv.field_operands)
    let size = n_fields * 8
    let is_win = ctx.target_os == "windows"
    let r_arg0: i32 = if is_win { REG_RCX } else { REG_RDI }
    let r_arg1: i32 = if is_win { REG_RDX } else { REG_RSI }
    let shadow: i32 = if is_win { 32 } else { 0 }
    // kryos_alloc(size, align): the SECOND arg (align) is required --
    // Layout::from_size_align rejects a garbage/zero alignment and returns
    // null, after which the field stores write through a null pointer.
    // Struct fields are 8-byte slots, so align = 8.
    x86_mov_reg_imm32(buf, r_arg0, size)
    x86_mov_reg_imm32(buf, r_arg1, 8)
    if shadow > 0 {
        x86_sub_reg_imm32(buf, REG_RSP, shadow)
    }
    push(ctx.relocations, LinkerReloc {
        offset: buf_len(buf) + 1,
        symbol_name: "kryos_alloc",
        rel_type: LREL_PC32,
        addend: -4
    })
    x86_call_rel32(buf, 0)
    if shadow > 0 {
        x86_add_reg_imm32(buf, REG_RSP, shadow)
    }
    // RAX = pointer to struct. Save it on the stack across the field-fill
    // loop: a field-operand load can CALL the runtime (e.g. a string-literal
    // field -> kryos_string_new, returning in RAX) and clobber the struct
    // pointer, which corrupts both the field stores and the returned pointer.
    // (Symptom: `Lexer { src, pos: 0, tokens }` returned the src string handle,
    // so lex.pos read the string's cap field instead of 0.) Mirror
    // cg_emit_array_lit's save/reload-around-call pattern.
    x86_push_reg(buf, REG_RAX)
    let mut i = 0
    while i < n_fields {
        // Re-align RSP to 16 across the possible call inside the field load
        // (the push above moved RSP by 8).
        if shadow > 0 {
            x86_sub_reg_imm32(buf, REG_RSP, 8)
        }
        let field_reg = cg_load_operand(ctx, ra, rv.field_operands[i], REG_R10)
        if field_reg != REG_R10 {
            x86_mov_reg_reg(buf, REG_R10, field_reg)
        }
        if shadow > 0 {
            x86_add_reg_imm32(buf, REG_RSP, 8)
        }
        // Reload the saved struct pointer (now at [rsp]) and store the field.
        // Use RAX (non-extended) as both the reload dest and store base --
        // matches cg_emit_array_lit's proven [rsp]-reload encoding; an
        // extended reg (R11) base/dest with an rsp-base load mis-encodes.
        x86_mov_reg_mem(buf, REG_RAX, REG_RSP, 0)
        x86_mov_mem_reg(buf, REG_RAX, i * 8, REG_R10)
        i = i + 1
    }
    // Restore the struct pointer into dest_reg.
    x86_pop_reg(buf, dest_reg)
}

// ===================================================================
// Array literal — allocate and fill elements
// ===================================================================

fn cg_emit_array_lit(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32) {
    let buf = ctx.text_buf
    let n_elems = len(rv.elements)
    let is_win = ctx.target_os == "windows"
    let r_arg0: i32 = if is_win { REG_RCX } else { REG_RDI }
    let r_arg1: i32 = if is_win { REG_RDX } else { REG_RSI }
    let shadow: i32 = if is_win { 32 } else { 0 }

    // Call kryos_array_new(elem_size=8, cap=n_elems_or_4).
    x86_mov_reg_imm32(buf, r_arg0, 8)
    let init_cap: i32 = if n_elems > 0 { n_elems } else { 4 }
    x86_mov_reg_imm32(buf, r_arg1, init_cap)
    if shadow > 0 {
        x86_sub_reg_imm32(buf, REG_RSP, shadow)
    }
    push(ctx.relocations, LinkerReloc {
        offset: buf_len(buf) + 1,
        symbol_name: "kryos_array_new",
        rel_type: LREL_PC32,
        addend: -4
    })
    x86_call_rel32(buf, 0)
    if shadow > 0 {
        x86_add_reg_imm32(buf, REG_RSP, shadow)
    }
    // RAX = array handle. Save on stack across element pushes.
    x86_push_reg(buf, REG_RAX)

    let mut i = 0
    while i < n_elems {
        // Win64 push needs an 8-byte stack adjustment to keep rsp
        // 16-aligned across the call (since we just pushed RAX).
        if shadow > 0 {
            x86_sub_reg_imm32(buf, REG_RSP, 8)
            x86_sub_reg_imm32(buf, REG_RSP, shadow)
        }
        // Load element value into r_arg1 (second arg of push).
        let elem_reg = cg_load_operand(ctx, ra, rv.elements[i], r_arg1)
        if elem_reg != r_arg1 {
            x86_mov_reg_reg(buf, r_arg1, elem_reg)
        }
        // Load array handle from the saved slot. Win64: rsp moved by
        // (shadow + 8), so handle is at [rsp + shadow + 8].
        let saved_off: i32 = if is_win { shadow + 8 } else { 0 }
        x86_mov_reg_mem(buf, r_arg0, REG_RSP, saved_off)
        push(ctx.relocations, LinkerReloc {
            offset: buf_len(buf) + 1,
            symbol_name: "kryos_builtin_push",
            rel_type: LREL_PC32,
            addend: -4
        })
        x86_call_rel32(buf, 0)
        if shadow > 0 {
            x86_add_reg_imm32(buf, REG_RSP, shadow)
            x86_add_reg_imm32(buf, REG_RSP, 8)
        }
        i = i + 1
    }
    // Pop array handle into dest_reg.
    x86_pop_reg(buf, dest_reg)
}

// ===================================================================
// Type cast
// ===================================================================

fn cg_emit_cast(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32) {
    let buf = ctx.text_buf
    if len(rv.cast_operand) > 0 {
        let r = cg_load_operand(ctx, ra, rv.cast_operand[0], dest_reg)
        if r != dest_reg {
            x86_mov_reg_reg(buf, dest_reg, r)
        }
    }
    // Most integer-to-integer casts are no-ops on x86_64 (all in 64-bit regs)
    // Narrowing casts: AND with mask
    if len(rv.cast_ty) > 0 {
        let target_ty = rv.cast_ty[0]
        if target_ty.kind == MIR_TY_I8 or target_ty.kind == MIR_TY_U8 {
            x86_and_reg_reg(buf, dest_reg, dest_reg)  // clear upper bits via movzx
            // AND with 0xFF
            x86_mov_reg_imm32(buf, REG_R11, 255)
            x86_and_reg_reg(buf, dest_reg, REG_R11)
        } elif target_ty.kind == MIR_TY_I16 or target_ty.kind == MIR_TY_U16 {
            x86_mov_reg_imm32(buf, REG_R11, 65535)
            x86_and_reg_reg(buf, dest_reg, REG_R11)
        } elif target_ty.kind == MIR_TY_I32 or target_ty.kind == MIR_TY_U32 {
            // MOV r32 already zero-extends to r64
            // Use: mov eax, eax  (clears upper 32 bits)
            // Actually for signed i32: movsxd
            // For simplicity, leave as-is (64-bit value, truncated conceptually)
            x86_mov_reg_imm32(buf, REG_R11, -1)  // 0xFFFFFFFF in lower 32
            // Actually this is fine: x86 mov r32,r32 zero-extends
        } elif target_ty.kind == MIR_TY_BOOL {
            // Nonzero -> 1, zero -> 0
            x86_test_reg_reg(buf, dest_reg, dest_reg)
            x86_setcc(buf, CC_NE, dest_reg)
            x86_movzx_r64_r8(buf, dest_reg, dest_reg)
        }
    }
}

// ===================================================================
// String concatenation — call runtime
// ===================================================================

fn cg_emit_string_concat(ctx: CodegenCtx, ra: RegAllocResult, rv: RValue, dest_reg: i32) {
    let buf = ctx.text_buf
    let n_parts = len(rv.concat_parts)
    if n_parts == 0 {
        // Empty string
        x86_xor_reg_reg(buf, dest_reg, dest_reg)
        return
    }
    let is_win = ctx.target_os == "windows"
    // Per-ABI arg register for str_concat(left, right):
    //   SYS V: RDI, RSI
    //   Win64: RCX, RDX
    let r_left: i32 = if is_win { REG_RCX } else { REG_RDI }
    let r_right: i32 = if is_win { REG_RDX } else { REG_RSI }
    let shadow: i32 = if is_win { 32 } else { 0 }

    // Start with first part loaded into the "left" arg register.
    let r0 = cg_load_operand(ctx, ra, rv.concat_parts[0], r_left)
    if r0 != r_left {
        x86_mov_reg_reg(buf, r_left, r0)
    }
    // Concat remaining parts one by one
    let mut i = 1
    while i < n_parts {
        // Save current accumulator across the call.
        x86_push_reg(buf, r_left)
        let ri = cg_load_operand(ctx, ra, rv.concat_parts[i], r_right)
        if ri != r_right {
            x86_mov_reg_reg(buf, r_right, ri)
        }
        x86_pop_reg(buf, r_left)
        // Win64 shadow space.
        if shadow > 0 {
            x86_sub_reg_imm32(buf, REG_RSP, shadow)
        }
        push(ctx.relocations, LinkerReloc {
            offset: buf_len(buf) + 1,
            // HANDLE-based concat: args are KryosString* handles (RCX/RDX),
            // result is a KryosString* in RAX. The old target kryos_str_concat
            // (stdlib-native) is the C-STRING ABI: it does CStr::from_ptr on its
            // args, so passing a KryosString handle made it read the handle's
            // length field as char bytes -> garbage / <invalid utf-8>. Every
            // string `+` in the self-host (all compiler output, errors, the AST
            // dump) was corrupted, which is why stage-2's pipeline produced no
            // usable output. kryos_string_concat (kryos-rt) has the matching
            // handle ABI.
            symbol_name: "kryos_string_concat",
            rel_type: LREL_PC32,
            addend: -4
        })
        x86_call_rel32(buf, 0)
        if shadow > 0 {
            x86_add_reg_imm32(buf, REG_RSP, shadow)
        }
        // Result in RAX, move to "left" reg for next iteration.
        x86_mov_reg_reg(buf, r_left, REG_RAX)
        i = i + 1
    }
    // Final result in r_left (or RAX if only one concat)
    if n_parts > 1 {
        if dest_reg != REG_RAX {
            x86_mov_reg_reg(buf, dest_reg, REG_RAX)
        }
    } else {
        if dest_reg != r_left {
            x86_mov_reg_reg(buf, dest_reg, r_left)
        }
    }
}

// ===================================================================
// Emit a single instruction
// ===================================================================

fn cg_emit_instruction(ctx: CodegenCtx, ra: RegAllocResult, inst: Instruction) {
    let buf = ctx.text_buf

    if inst.kind == INST_ASSIGN {
        // dest = rvalue
        let dest = inst.dest
        let dest_reg = cg_get_local_reg(ctx, ra, dest, REG_RAX)
        if len(inst.value) > 0 {
            cg_emit_rvalue(ctx, ra, inst.value[0], dest_reg)
        }
        // Store result back if spilled
        cg_store_local(ctx, ra, dest, dest_reg)

    } elif inst.kind == INST_STORE_DEREF {
        // *ptr = value
        if len(inst.ptr_operand) > 0 and len(inst.store_value) > 0 {
            let ptr_reg = cg_load_operand(ctx, ra, inst.ptr_operand[0], REG_R10)
            let val_reg = cg_load_operand(ctx, ra, inst.store_value[0], REG_R11)
            x86_mov_mem_reg(buf, ptr_reg, 0, val_reg)
        }

    } elif inst.kind == INST_DROP {
        // Drop is a no-op for now (no RAII in self-host)

    } elif inst.kind == INST_NOP {
        // Nothing
    }
}

// ===================================================================
// Emit a terminator
// ===================================================================

fn cg_emit_terminator(ctx: CodegenCtx, ra: RegAllocResult, term: Terminator) {
    let buf = ctx.text_buf

    if term.kind == TERM_RETURN {
        // Move return value to RAX
        if len(term.ret_val) > 0 {
            let r = cg_load_operand(ctx, ra, term.ret_val[0], REG_RAX)
            if r != REG_RAX {
                x86_mov_reg_reg(buf, REG_RAX, r)
            }
        }
        // Jump to epilogue (we'll patch this)
        // For now, emit epilogue inline
        cg_emit_epilogue(ctx, ra)

    } elif term.kind == TERM_GOTO {
        // Jump to target block
        let target = term.goto_block
        push(ctx.branch_patches, BranchPatch {
            patch_offset: buf_len(buf) + 1,  // after E9 opcode
            target_block: target
        })
        x86_jmp_rel32(buf, 0)  // placeholder

    } elif term.kind == TERM_BRANCH {
        // if cond then A else B
        if len(term.cond) > 0 {
            let cond_reg = cg_load_operand(ctx, ra, term.cond[0], REG_R10)
            x86_test_reg_reg(buf, cond_reg, cond_reg)
        }
        // JE else_block (jump if zero = false)
        push(ctx.branch_patches, BranchPatch {
            patch_offset: buf_len(buf) + 2,  // after 0F 84
            target_block: term.else_block
        })
        x86_jcc_rel32(buf, CC_E, 0)
        // JMP then_block
        push(ctx.branch_patches, BranchPatch {
            patch_offset: buf_len(buf) + 1,
            target_block: term.then_block
        })
        x86_jmp_rel32(buf, 0)

    } elif term.kind == TERM_SWITCH {
        // Multi-way branch
        if len(term.switch_val) > 0 {
            let val_reg = cg_load_operand(ctx, ra, term.switch_val[0], REG_R10)
            // Compare against each target value
            let mut i = 0
            while i < len(term.switch_targets) {
                x86_cmp_reg_imm32(buf, val_reg, term.switch_targets[i])
                push(ctx.branch_patches, BranchPatch {
                    patch_offset: buf_len(buf) + 2,
                    target_block: term.switch_blocks[i]
                })
                x86_jcc_rel32(buf, CC_E, 0)
                i = i + 1
            }
        }
        // Default: jump to default block
        push(ctx.branch_patches, BranchPatch {
            patch_offset: buf_len(buf) + 1,
            target_block: term.default_block
        })
        x86_jmp_rel32(buf, 0)

    } elif term.kind == TERM_UNREACHABLE {
        // UD2 instruction (0x0F 0x0B)
        buf_write_byte(buf, 0x0F)
        buf_write_byte(buf, 0x0B)
    }
}

// ===================================================================
// Emit a complete function
// ===================================================================

fn cg_emit_function(ctx: CodegenCtx, func: MirFunction, ra: RegAllocResult) {
    let buf = ctx.text_buf
    let func_start = buf_len(buf)

    // Register function location
    cg_register_func(ctx, func.name, func_start)

    // Add to symbol table
    push(ctx.symbols, LinkerSymbol {
        name: func.name,
        offset: func_start,
        section: LSEC_TEXT,
        is_global: true,
        is_func: true,
        size: 0  // patched after emission
    })
    let sym_idx = len(ctx.symbols) - 1

    // Clear block offsets and branch patches for this function
    let empty_ints: [i32] = []
    let empty_patches: [BranchPatch] = []
    ctx.block_offsets = empty_ints
    ctx.branch_patches = empty_patches

    // Pre-allocate block offset slots
    let n_blocks = len(func.blocks)
    let mut i = 0
    while i < n_blocks {
        push(ctx.block_offsets, 0)
        i = i + 1
    }

    // Emit prologue
    cg_emit_prologue(ctx, ra)

    // Emit each basic block
    i = 0
    while i < n_blocks {
        let block = func.blocks[i]
        // Record block offset
        if block.id < len(ctx.block_offsets) {
            ctx.block_offsets[block.id] = buf_len(buf)
        }
        // Emit instructions
        let mut j = 0
        while j < len(block.instructions) {
            cg_emit_instruction(ctx, ra, block.instructions[j])
            j = j + 1
        }
        // Emit terminator
        if len(block.terminator) > 0 {
            cg_emit_terminator(ctx, ra, block.terminator[0])
        }
        i = i + 1
    }

    // Patch branch offsets. NOTE: the inner `let` block must REASSIGN
    // target_off, not shadow it. Previously this used `let target_off = ...`
    // in the if branch, which created a new binding visible only inside
    // the block; the outer variable kept its initial 0 and every jump
    // resolved to the start of the function.
    let mut p = 0
    while p < len(ctx.branch_patches) {
        let patch = ctx.branch_patches[p]
        let mut target_off: i32 = 0
        if patch.target_block < len(ctx.block_offsets) {
            target_off = ctx.block_offsets[patch.target_block]
        }
        let rel = target_off - (patch.patch_offset + 4)
        buf_patch_i32_le(buf, patch.patch_offset, rel)
        p = p + 1
    }

    // Update symbol size
    let func_size = buf_len(buf) - func_start
    ctx.symbols[sym_idx].size = func_size
}

// ===================================================================
// Emit an entire MIR module
// ===================================================================

// Emit a synthetic `_start` symbol that the kernel jumps to on process
// launch. It calls `main` and then issues sys_exit so the process does
// not RET into garbage. Linux-only for now; on Windows the PE loader
// gives main() a real return address so this is unnecessary.
fn cg_emit_start_shim_linux(ctx: CodegenCtx) {
    let buf = ctx.text_buf
    let start_off = buf_len(buf)

    push(ctx.symbols, LinkerSymbol {
        name: "_start",
        offset: start_off,
        section: LSEC_TEXT,
        is_global: true,
        is_func: true,
        size: 0
    })
    let sym_idx = len(ctx.symbols) - 1

    // call main  (rel32, resolved by linker)
    push(ctx.relocations, LinkerReloc {
        offset: buf_len(buf) + 1,
        symbol_name: "main",
        rel_type: LREL_PC32,
        addend: -4
    })
    x86_call_rel32(buf, 0)

    // mov rax, 60    ; sys_exit
    x86_mov_reg_imm32(buf, REG_RAX, 60)
    // xor rdi, rdi   ; exit code 0
    x86_xor_reg_reg(buf, REG_RDI, REG_RDI)
    // syscall
    x86_syscall(buf)

    ctx.symbols[sym_idx].size = buf_len(buf) - start_off
}

fn cg_emit_module(ctx: CodegenCtx, module: MirModule) {
    // First pass: emit all functions
    let mut i = 0
    let trace = env_get("KRYOS_CG_TRACE")
    while i < len(module.functions) {
        let func = module.functions[i]
        if len(trace) > 0 {
            eprintln("cg[" + to_string(i) + "/" + to_string(len(module.functions)) + "]: " + func.name)
        }
        // Run register allocation per target ABI
        let ra: RegAllocResult = ra_allocate_for(func, ctx.target_os)
        if env_get("KRYOS_RA_DUMP") == "1" {
            let mut j = 0
            while j < len(ra.intervals) {
                eprintln("ra " + func.name + " l" + to_string(ra.intervals[j].local_id) + " r" + to_string(ra.intervals[j].reg) + " s" + to_string(ra.intervals[j].spill_slot))
                j = j + 1
            }
        }
        // Emit function code
        cg_emit_function(ctx, func, ra)
        i = i + 1
    }

    // Append `_start` shim so the kernel has a real entry point.
    if ctx.target_os == "linux" {
        cg_emit_start_shim_linux(ctx)
    }
}

// ===================================================================
// Top-level compilation entry point
//
// Takes a MIR module and produces an executable file.
// ===================================================================

fn compile_module(module: MirModule, output_path: str, target_os: str) -> bool {
    let ctx: CodegenCtx = cg_new(target_os)

    // Emit all code
    cg_emit_module(ctx, module)

    // Build linker input
    let empty_inputs: [LinkerInput] = []
    let input = LinkerInput {
        name: "main",
        text_data: ctx.text_buf,
        data_data: ctx.data_buf,
        rodata_data: ctx.rodata_buf,
        symbols: ctx.symbols,
        relocations: ctx.relocations
    }

    let inputs = [input]

    // Link. Use `_start` on Linux (kernel jumps there directly); the
    // shim does `call main` then `sys_exit`. On Windows `main` is the
    // entry the PE loader expects.
    let entry = if target_os == "linux" { "_start" } else { "main" }
    let result: LinkerResult = link_exe(inputs, entry, output_path, target_os)
    return result.success
}

// ===================================================================
// Compile and emit object file only (no linking)
// ===================================================================

fn compile_to_object(module: MirModule, output_path: str, target_os: str) -> bool {
    let ctx: CodegenCtx = cg_new(target_os)
    cg_emit_module(ctx, module)

    if target_os == "linux" {
        let obj: ElfObject = elf_new()
        // Add symbols using convenience functions.
        //
        // Parser-synthesized "<top-level>" wrappers must be STB_LOCAL so
        // multiple .obj files (each with their own per-tu "<top-level>"
        // wrappers) can be linked together without symbol collisions.
        let mut i = 0
        while i < len(ctx.symbols) {
            let sym = ctx.symbols[i]
            if sym.is_func {
                if sym.name == "<top-level>" {
                    elf_add_local(obj, sym.name, sym.offset, 1)
                } else {
                    elf_add_func(obj, sym.name, sym.offset, sym.size)
                }
            } else {
                elf_add_local(obj, sym.name, sym.offset, 1)
            }
            i = i + 1
        }
        // Add relocations
        i = 0
        while i < len(ctx.relocations) {
            let rel = ctx.relocations[i]
            elf_add_call_reloc(obj, rel.offset, 0)
            i = i + 1
        }
        elf_write(obj, ctx.text_buf, ctx.data_buf, ctx.rodata_buf, 0, output_path)
        return true
    } elif target_os == "windows" {
        let obj: CoffObject = coff_new()

        // Patch in-instruction displacement fields so the system
        // linker's "target + field - next_inst" formula reduces to
        // the value our codegen intended. Our internal addend
        // convention is `(real_offset) - 4`; MSVC AMD64_REL32 wants
        // the addend WITHOUT the -4. Add 4 back into the field.
        let mut k = 0
        while k < len(ctx.relocations) {
            let rel = ctx.relocations[k]
            let coff_addend = rel.addend + 4
            buf_patch_i32_le(ctx.text_buf, rel.offset, coff_addend)
            k = k + 1
        }

        // First pass: emit all defined symbols and build a name->index
        // table so relocations can be resolved to real indices.
        //
        // Parser wraps top-level `let CONST = N` statements (and similar
        // bare statements) in a synthetic Decl named "<top-level>".  Each
        // such wrapper currently lowers to a tiny function.  Emitting them
        // as IMAGE_SYM_CLASS_EXTERNAL means N wrappers collide on N
        // identical "<top-level>" symbols at link time, blocking stage-2
        // multi-.obj linking.  Force STATIC (per-translation-unit) linkage
        // for them so the obj is well-formed even when many "<top-level>"
        // wrappers exist.
        let mut sym_names: [str] = []
        let mut sym_indices: [i64] = []
        let mut i = 0
        while i < len(ctx.symbols) {
            let sym = ctx.symbols[i]
            let mut idx: i64 = 0
            if sym.is_func {
                if sym.name == "<top-level>" {
                    // Per-translation-unit; no external visibility.
                    idx = coff_add_static(obj, sym.name, sym.offset, 1)
                } else {
                    idx = coff_add_func(obj, sym.name, sym.offset)
                }
            } else {
                idx = coff_add_static(obj, sym.name, sym.offset, 1)
            }
            push(sym_names, sym.name)
            push(sym_indices, idx)
            i = i + 1
        }

        // Synthetic linker symbols. Codegen emits LEA / similar with
        // these as the target; they correspond to the start of the
        // respective section. COFF lets us define them as static
        // symbols pointing at section + offset 0.
        let rodata_base_idx = coff_add_static(obj, "__rodata_base", 0, 3)
        push(sym_names, "__rodata_base")
        push(sym_indices, rodata_base_idx)
        let data_base_idx = coff_add_static(obj, "__data_base", 0, 2)
        push(sym_names, "__data_base")
        push(sym_indices, data_base_idx)
        let text_base_idx = coff_add_static(obj, "__text_base", 0, 1)
        push(sym_names, "__text_base")
        push(sym_indices, text_base_idx)

        // Second pass: emit relocations. For any relocation whose
        // symbol_name is not defined locally, add it as an undefined
        // external so the system linker can resolve against a runtime
        // library (kernel32, kryos_runtime, etc.).
        i = 0
        while i < len(ctx.relocations) {
            let rel = ctx.relocations[i]
            let mut target_idx: i64 = -1
            let mut j = 0
            while j < len(sym_names) {
                if sym_names[j] == rel.symbol_name {
                    target_idx = sym_indices[j]
                    j = len(sym_names)
                } else {
                    j = j + 1
                }
            }
            if target_idx < 0 {
                target_idx = coff_add_extern(obj, rel.symbol_name)
                push(sym_names, rel.symbol_name)
                push(sym_indices, target_idx)
            }
            coff_add_call_reloc(obj, rel.offset, target_idx)
            i = i + 1
        }

        coff_write(obj, ctx.text_buf, ctx.data_buf, ctx.rodata_buf, output_path)
        return true
    }
    return false
}
