// Same as minimal but only 3 statements (drop rv.right).

@copy
struct Operand {
    is_local: bool,
    local_id: i32,
    int_val: i32,
    str_val: str
}

@copy
struct RValue {
    kind: i32,
    op: i32,
    left: [Operand],
    right: [Operand]
}

fn rv_empty(k: i32) -> RValue {
    let e: [Operand] = []
    return RValue { kind: k, op: 0, left: e, right: e }
}

fn rv_binop(binop: i32, l: Operand) -> RValue {
    let mut rv = rv_empty(2)
    rv.op = binop
    rv.left = [l]
    return rv
}

fn op_empty() -> Operand {
    return Operand { is_local: false, local_id: 0, int_val: 0, str_val: "" }
}

fn main() {
    let l = op_empty()
    let rv = rv_binop(1, l)
    println("done")
}
