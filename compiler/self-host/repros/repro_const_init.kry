// Tighter repro that exercises Constant::Int -> I64 -> narrow-field path
// directly (no function call). If RValue::Struct still has the coercion
// gap this will overrun even more reliably than the 3-call repro.

struct Pair {
    a: i32,
    b: i32,
}

fn main() {
    let p1 = Pair { a: 1, b: 2 }
    let p2 = Pair { a: 3, b: 4 }
    let p3 = Pair { a: 5, b: 6 }
    let p4 = Pair { a: 7, b: 8 }
    let p5 = Pair { a: 9, b: 10 }
    println("done")
}
