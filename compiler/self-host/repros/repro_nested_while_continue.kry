fn first_marker() { println("a") }

fn outer() {
    let mut i = 0
    while i < 5 {
        if i == 2 {
            let mut j = 0
            while j < 3 {
                j = j + 1
            }
            i = i + 1
            continue
        }
        if i == 4 {
            i = i + 1
            continue
        }
        i = i + 1
    }
}

fn last_marker() { println("b") }

fn main() {
    first_marker()
    outer()
    last_marker()
}
