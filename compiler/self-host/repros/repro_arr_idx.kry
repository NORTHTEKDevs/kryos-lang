// Bisect: arr[i] without continue

fn count_non_zero(arr: [i32]) -> i32 {
    let mut n = 0
    let mut i = 0
    while i < len(arr) {
        if arr[i] == 0 {
            i = i + 1
        } else {
            n = n + 1
            i = i + 1
        }
    }
    return n
}

fn main() {
    let a: [i32] = [1, 0, 2, 0, 3]
    println(to_string(count_non_zero(a)))
}
