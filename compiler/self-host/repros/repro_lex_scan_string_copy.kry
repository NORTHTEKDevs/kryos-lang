// Exact copy of lex_scan_string from lexer.kry.

struct Lexer {
    src: str,
    pos: i32
}

fn lex_peek(lex: Lexer) -> str { return "x" }
fn lex_advance(lex: Lexer) -> Lexer { return lex }
fn lex_at_end(lex: Lexer) -> bool { return false }
fn lex_emit(lex: Lexer, kind: i32, start: i32, end: i32, text: str) -> Lexer { return lex }
fn lex_skip_ws(lex: Lexer) -> Lexer { return lex }
fn lex_scan_token(lex: Lexer) -> Lexer { return lex }

let CHR_LBRACE = "{"
let CHR_RBRACE = "}"
let TK_STRING_PART = 1
let TK_INTERP_START = 2
let TK_INTERP_END = 3
let TK_STRING = 4

fn first_marker() { println("first") }

fn lex_scan_string(lex: Lexer, start: i32) -> Lexer {
    // Called after the opening " has already been consumed.
    let mut l = lex
    let mut text = ""
    let mut has_interp = false

    while not lex_at_end(l) and lex_peek(l) != "\"" {
        // String interpolation: {expr}
        if lex_peek(l) == CHR_LBRACE {
            // Emit what we have so far as StringPart
            if len(text) > 0 or not has_interp {
                l = lex_emit(l, TK_STRING_PART, start, l.pos, text)
                text = ""
            }
            has_interp = true
            let brace_start = l.pos
            l = lex_advance(l) // skip {
            l = lex_emit(l, TK_INTERP_START, brace_start, l.pos, CHR_LBRACE)

            // Tokenize the interpolated expression until we hit }
            while not lex_at_end(l) and lex_peek(l) != CHR_RBRACE {
                l = lex_skip_ws(l)
                if not lex_at_end(l) and lex_peek(l) != CHR_RBRACE {
                    l = lex_scan_token(l)
                }
            }
            if not lex_at_end(l) {
                let end_start = l.pos
                l = lex_advance(l) // skip }
                l = lex_emit(l, TK_INTERP_END, end_start, l.pos, CHR_RBRACE)
            }
            continue
        }

        // Escape sequences
        if lex_peek(l) == "\\" {
            l = lex_advance(l) // skip backslash
            if not lex_at_end(l) {
                let esc = lex_peek(l)
                l = lex_advance(l)
                if esc == "n" {
                    text = text + "\n"
                } elif esc == "t" {
                    text = text + "\t"
                } elif esc == "r" {
                    text = text + "\r"
                } elif esc == "\\" {
                    text = text + "\\"
                } elif esc == "\"" {
                    text = text + "\""
                } elif esc == "0" {
                    text = text + "\0"
                } else {
                    text = text + "\\" + esc
                }
            }
            continue
        }

        // Normal character
        text = text + lex_peek(l)
        l = lex_advance(l)
    }

    // Consume closing "
    if not lex_at_end(l) {
        l = lex_advance(l)
    }

    if has_interp {
        l = lex_emit(l, TK_STRING_PART, start, l.pos, text)
    } else {
        l = lex_emit(l, TK_STRING, start, l.pos, text)
    }
    return l
}

fn lex_scan_char(lex: Lexer, start: i32) -> Lexer {
    return lex
}

fn last_marker() { println("last") }

fn main() {
    first_marker()
    last_marker()
}
