// ============================================================
// main.kry -- Entry point for the Kryos self-hosted compiler.
//
// Usage:  kryos self-host/main.kry <input.kry>
//
// Reads a .kry source file, tokenizes it, parses it into an AST,
// and prints a summary of the result.  This is the first step
// toward full self-hosting: once the compiler can parse itself,
// we add type-checking and codegen phases to complete the loop.
//
// Dependencies (loaded via the Kryos module system):
//   token.kry  -- Token struct, kind constants, keyword_lookup
//   lexer.kry  -- tokenize(src) -> [Token]
//   ast.kry    -- AST node structs and constructors
//   parser.kry -- parse_module(parser) -> Module
// ============================================================

use token
use lexer
use ast
use parser
use types
use lower
use optimize
use codegen

// -------------------------------------------------------------------
// AST printing helpers
// -------------------------------------------------------------------

fn indent(depth: i32) -> str {
    let mut s = ""
    for i in range(0, depth) {
        s = s + "  "
    }
    return s
}

fn print_type_expr(ty: TypeExpr, depth: i32) -> str {
    if ty.kind == TYPE_SIMPLE {
        return ty.name
    }
    if ty.kind == TYPE_GENERIC {
        let mut s = ty.name + "<"
        for i in range(0, len(ty.type_args)) {
            if i > 0 {
                s = s + ", "
            }
            s = s + print_type_expr(ty.type_args[i], depth)
        }
        return s + ">"
    }
    if ty.kind == TYPE_ARRAY {
        if len(ty.element_type) > 0 {
            let inner = print_type_expr(ty.element_type[0], depth)
            if ty.array_size >= 0 {
                return char_from(91) + inner + "; " + to_string(ty.array_size) + char_from(93)
            }
            return char_from(91) + inner + char_from(93)
        }
        return "[]"
    }
    if ty.kind == TYPE_FUNCTION {
        let mut s = "fn("
        for i in range(0, len(ty.param_types)) {
            if i > 0 {
                s = s + ", "
            }
            s = s + print_type_expr(ty.param_types[i], depth)
        }
        s = s + ")"
        if len(ty.ret_type) > 0 {
            s = s + " -> " + print_type_expr(ty.ret_type[0], depth)
        }
        return s
    }
    if ty.kind == TYPE_OPTIONAL {
        if len(ty.inner_type) > 0 {
            return "?" + print_type_expr(ty.inner_type[0], depth)
        }
        return "?"
    }
    if ty.kind == TYPE_REFERENCE {
        let mut prefix = "&"
        if ty.mutable {
            prefix = "&mut "
        }
        if len(ty.inner_type) > 0 {
            return prefix + print_type_expr(ty.inner_type[0], depth)
        }
        return prefix
    }
    if ty.kind == TYPE_SHARED {
        if len(ty.inner_type) > 0 {
            return "shared " + print_type_expr(ty.inner_type[0], depth)
        }
        return "shared"
    }
    return "<type>"
}

fn print_expr(e: Expr, depth: i32) {
    let pad = indent(depth)
    if e.kind == EXPR_INT_LIT {
        println(pad + "IntLit(" + to_string(e.int_val) + ")")
        return
    }
    if e.kind == EXPR_FLOAT_LIT {
        println(pad + "FloatLit(" + to_string(e.float_val) + ")")
        return
    }
    if e.kind == EXPR_STRING_LIT {
        println(pad + "StringLit(\"" + e.str_val + "\")")
        return
    }
    if e.kind == EXPR_BOOL_LIT {
        println(pad + "BoolLit(" + to_string(e.bool_val) + ")")
        return
    }
    if e.kind == EXPR_NONE_LIT {
        println(pad + "NoneLit")
        return
    }
    if e.kind == EXPR_IDENT {
        println(pad + "Ident(" + e.name + ")")
        return
    }
    if e.kind == EXPR_BINARY_OP {
        println(pad + "BinaryOp(" + binop_name(e.op) + ")")
        if len(e.left) > 0 {
            print_expr(e.left[0], depth + 1)
        }
        if len(e.right) > 0 {
            print_expr(e.right[0], depth + 1)
        }
        return
    }
    if e.kind == EXPR_UNARY_OP {
        let mut op_name = "-"
        if e.op == UNOP_NOT { op_name = "not" }
        if e.op == UNOP_BIT_NOT { op_name = "~" }
        println(pad + "UnaryOp(" + op_name + ")")
        if len(e.left) > 0 {
            print_expr(e.left[0], depth + 1)
        }
        return
    }
    if e.kind == EXPR_FN_CALL {
        println(pad + "FnCall")
        if len(e.left) > 0 {
            print_expr(e.left[0], depth + 1)
        }
        for i in range(0, len(e.args)) {
            print_expr(e.args[i], depth + 1)
        }
        return
    }
    if e.kind == EXPR_METHOD_CALL {
        println(pad + "MethodCall(." + e.name + ")")
        if len(e.left) > 0 {
            print_expr(e.left[0], depth + 1)
        }
        for i in range(0, len(e.args)) {
            print_expr(e.args[i], depth + 1)
        }
        return
    }
    if e.kind == EXPR_FIELD_ACCESS {
        println(pad + "FieldAccess(." + e.name + ")")
        if len(e.left) > 0 {
            print_expr(e.left[0], depth + 1)
        }
        return
    }
    if e.kind == EXPR_INDEX_ACCESS {
        println(pad + "IndexAccess")
        if len(e.left) > 0 {
            print_expr(e.left[0], depth + 1)
        }
        if len(e.right) > 0 {
            print_expr(e.right[0], depth + 1)
        }
        return
    }
    if e.kind == EXPR_ARRAY_LIT {
        println(pad + "ArrayLit(" + to_string(len(e.elements)) + " elements)")
        return
    }
    if e.kind == EXPR_STRUCT_LIT {
        println(pad + "StructLit(" + e.name + ")")
        return
    }
    if e.kind == EXPR_MAP_LIT {
        println(pad + "MapLit(" + to_string(len(e.left)) + " entries)")
        return
    }
    if e.kind == EXPR_LAMBDA {
        println(pad + "Lambda(" + to_string(len(e.params)) + " params)")
        return
    }
    if e.kind == EXPR_IF {
        println(pad + "IfExpr")
        return
    }
    if e.kind == EXPR_MATCH {
        println(pad + "MatchExpr(" + to_string(len(e.match_arms)) + " arms)")
        return
    }
    if e.kind == EXPR_BLOCK {
        println(pad + "BlockExpr(" + to_string(len(e.block_stmts)) + " stmts)")
        return
    }
    println(pad + "Expr(kind=" + to_string(e.kind) + ")")
}

fn print_decl(d: Decl, depth: i32) {
    let pad = indent(depth)
    if d.kind == DECL_FUNCTION {
        let mut sig = "fn " + d.name + "("
        for i in range(0, len(d.params)) {
            if i > 0 {
                sig = sig + ", "
            }
            sig = sig + d.params[i].name
            if len(d.params[i].ty) > 0 {
                sig = sig + ": " + print_type_expr(d.params[i].ty[0], 0)
            }
        }
        sig = sig + ")"
        if len(d.ret_type) > 0 {
            sig = sig + " -> " + print_type_expr(d.ret_type[0], 0)
        }
        if d.public {
            sig = "pub " + sig
        }
        println(pad + sig + " " + char_from(123) + to_string(len(d.fn_body)) + " stmts" + char_from(125))
        return
    }
    if d.kind == DECL_STRUCT {
        let mut s = "struct " + d.name + " " + char_from(123)
        for i in range(0, len(d.fields)) {
            if i > 0 {
                s = s + ", "
            }
            s = s + d.fields[i].name
        }
        s = s + char_from(125)
        println(pad + s)
        return
    }
    if d.kind == DECL_ENUM {
        let mut s = "enum " + d.name + " " + char_from(123)
        for i in range(0, len(d.variants)) {
            if i > 0 {
                s = s + ", "
            }
            s = s + d.variants[i].name
        }
        s = s + char_from(125)
        println(pad + s)
        return
    }
    if d.kind == DECL_IMPL {
        let mut s = "impl " + d.target
        if len(d.trait_name) > 0 {
            s = "impl " + d.trait_name + " for " + d.target
        }
        s = s + " " + char_from(123) + to_string(len(d.methods)) + " methods" + char_from(125)
        println(pad + s)
        return
    }
    if d.kind == DECL_TRAIT {
        println(pad + "trait " + d.name + " " + char_from(123) + to_string(len(d.methods)) + " methods" + char_from(125))
        return
    }
    if d.kind == DECL_ACTOR {
        println(pad + "actor " + d.name + " " + char_from(123) + to_string(len(d.handlers)) + " handlers" + char_from(125))
        return
    }
    if d.kind == DECL_TYPE_ALIAS {
        let mut s = "type " + d.name + " = "
        if len(d.alias_type) > 0 {
            s = s + print_type_expr(d.alias_type[0], 0)
        }
        println(pad + s)
        return
    }
    if d.kind == DECL_IMPORT {
        if len(d.import_path) > 0 {
            let ip = d.import_path[0]
            let mut s = "use "
            for i in range(0, len(ip.segments)) {
                if i > 0 {
                    s = s + "::"
                }
                s = s + ip.segments[i]
            }
            println(pad + s)
        }
        return
    }
    if d.kind == DECL_EXTERN {
        println(pad + "extern \"" + d.abi + "\" " + char_from(123) + to_string(len(d.extern_items)) + " items" + char_from(125))
        return
    }
    // Top-level statement wrapper
    println(pad + "<top-level statement>")
}

// -------------------------------------------------------------------
// Main
// -------------------------------------------------------------------

// -------------------------------------------------------------------
// detect_target_os -- determine OS from the platform
// -------------------------------------------------------------------

fn detect_target_os() -> str {
    // env_get returns "" when the variable is unset. WINDIR is set on
    // every Windows install ("C:\\Windows" or similar) and on nothing
    // else. Fall back to "linux" elsewhere.
    let w = env_get("WINDIR")
    if len(w) > 0 { return "windows" }
    return "linux"
}

// -------------------------------------------------------------------
// compile_file -- full compilation pipeline
// -------------------------------------------------------------------

fn compile_file(filename: str, output: str) {
    let source = file_read(filename)
    if len(source) == 0 {
        println("error: could not read file: " + filename)
        exit(1)
        return
    }

    println("=== Kryos Self-Hosted Compiler ===")
    println("File: " + filename)

    // Phase 1: Lex
    let tokens = tokenize(source)
    let mut token_count = 0
    for i in range(0, len(tokens)) {
        if tokens[i].kind != TK_EOF {
            token_count = token_count + 1
        }
    }
    println("Tokens: " + to_string(token_count))

    // Phase 2: Parse
    let p = parser_new(tokens)
    let module = parse_module(p)
    println("Declarations: " + to_string(len(module.declarations)))

    if len(p.errors) > 0 {
        println("Parse errors: " + to_string(len(p.errors)))
        for i in range(0, len(p.errors)) {
            println("  " + p.errors[i])
        }
        exit(1)
        return
    }

    // Phase 3: Type check
    let mut tc = tc_new()
    tc = tc_register_builtins(tc)
    tc = tc_check_module(tc, module)
    // Honor KRYOS_SKIP_TYPES=1 (same rationale as the obj path): stage-1's
    // type checker is incomplete relative to stage-0, and bootstrap input
    // is pre-validated, so type errors here are usually missing-feature
    // false positives. Continue to codegen using whatever the checker
    // managed to populate.
    let skip_types = env_get("KRYOS_SKIP_TYPES")
    if len(tc.errors) > 0 {
        if len(skip_types) > 0 {
            println("Type errors: " + to_string(len(tc.errors)) + " (KRYOS_SKIP_TYPES=1; continuing)")
        } else {
            println("Type errors: " + to_string(len(tc.errors)))
            for i in range(0, len(tc.errors)) {
                println("  " + tc.errors[i])
            }
            exit(1)
            return
        }
    } else {
        println("Type check: OK")
    }

    // Phase 4: Lower to MIR
    let mir_mod = lower_module(module, tc)
    println("MIR functions: " + to_string(len(mir_mod.functions)))

    // Phase 5: Optimize. Skipped under SKIP_TYPES to match the obj path --
    // the optimizer mutates MIR in ways the current regalloc/codegen
    // pipeline can't follow on large (bootstrap-sized) inputs.
    if len(skip_types) > 0 {
        println("Optimization: skipped (skip-types/bootstrap path)")
    } else {
        optimize(mir_mod)
        println("Optimization: done")
    }

    // Phase 6: Compile to executable
    let target = detect_target_os()
    let success = compile_module(mir_mod, output, target)
    if success {
        println("Output: " + output)
        println("=== Compilation successful ===")
    } else {
        println("error: code generation failed")
        exit(1)
    }
}

// -------------------------------------------------------------------
// check_file -- parse and type-check only
// -------------------------------------------------------------------

fn check_file(filename: str) {
    let source = file_read(filename)
    if len(source) == 0 {
        println("error: could not read file: " + filename)
        exit(1)
        return
    }

    let tokens = tokenize(source)
    let p = parser_new(tokens)
    let module = parse_module(p)

    if len(p.errors) > 0 {
        println("Parse errors: " + to_string(len(p.errors)))
        for i in range(0, len(p.errors)) {
            println("  " + p.errors[i])
        }
        exit(1)
        return
    }

    let mut tc = tc_new()
    tc = tc_register_builtins(tc)
    tc = tc_check_module(tc, module)
    if len(tc.errors) > 0 {
        println("Type errors: " + to_string(len(tc.errors)))
        for i in range(0, len(tc.errors)) {
            println("  " + tc.errors[i])
        }
        exit(1)
        return
    }

    println("check: " + filename + " OK")
}

// -------------------------------------------------------------------
// emit_object -- run the front + middle + codegen passes and write
// a COFF/ELF object file (no linking). Used on Windows to let an
// external linker (link.exe) resolve kernel32 + a runtime lib.
// -------------------------------------------------------------------

fn emit_object(filename: str, output: str) {
    let source = file_read(filename)
    if len(source) == 0 {
        println("error: could not read file: " + filename)
        exit(1)
        return
    }

    println("=== Kryos Self-Hosted Compiler (obj) ===")
    println("File: " + filename)

    let tokens = tokenize(source)
    println("Tokens: " + to_string(len(tokens)))

    let p = parser_new(tokens)
    let module = parse_module(p)
    println("Declarations: " + to_string(len(module.declarations)))
    if len(p.errors) > 0 {
        println("Parse errors: " + to_string(len(p.errors)))
        exit(1)
        return
    }

    let mut tc = tc_new()
    tc = tc_register_builtins(tc)
    tc = tc_check_module(tc, module)
    // Stage-1's type checker is incomplete relative to stage-0's; bootstrap
    // input is pre-validated by stage-0 so type errors here are usually
    // missing-feature false positives. Honor a KRYOS_SKIP_TYPES=1 env var
    // so the obj path can proceed to lower/codegen using whatever
    // tc.struct_defs / tc.fn_sigs the checker did manage to populate.
    let skip_types = env_get("KRYOS_SKIP_TYPES")
    if len(tc.errors) > 0 {
        if len(skip_types) > 0 {
            println("Type errors: " + to_string(len(tc.errors)) + " (KRYOS_SKIP_TYPES=1; continuing)")
        } else {
            println("Type errors: " + to_string(len(tc.errors)))
            for i in range(0, len(tc.errors)) {
                println("  " + tc.errors[i])
            }
            exit(1)
            return
        }
    } else {
        println("Type check: OK")
    }

    let mir_mod = lower_module(module, tc)
    println("MIR functions: " + to_string(len(mir_mod.functions)))

    // Optimizer is currently a no-op for stage-1 obj-path. Enabling
    // even constant_fold causes lower_module to subsequently crash
    // on token.kry-sized inputs -- the optimizer mutates MIR in
    // ways the current regalloc/codegen pipeline can't follow.
    println("Optimization: skipped (obj path)")

    let target = detect_target_os()
    let success = compile_to_object(mir_mod, output, target)
    if success {
        println("Output: " + output)
        println("=== Object file written ===")
    } else {
        println("error: object emission failed")
        exit(1)
    }
}

// -------------------------------------------------------------------
// dump_ast -- parse and print AST (original behavior)
// -------------------------------------------------------------------

fn dump_ast(filename: str) {
    let source = file_read(filename)
    if len(source) == 0 {
        println("error: could not read file: " + filename)
        return
    }

    println("=== Kryos Self-Hosted Compiler ===")
    println("File: " + filename)
    println("Size: " + to_string(len(source)) + " bytes")
    println("")

    let tokens = tokenize(source)
    let mut real_count = 0
    for i in range(0, len(tokens)) {
        if tokens[i].kind != TK_EOF {
            real_count = real_count + 1
        }
    }
    println("Tokens: " + to_string(real_count))
    println("")

    let p = parser_new(tokens)
    let module = parse_module(p)
    println("Declarations: " + to_string(len(module.declarations)))
    println("")

    println("--- AST ---")
    for i in range(0, len(module.declarations)) {
        print_decl(module.declarations[i], 0)
    }
    println("")

    if len(p.errors) > 0 {
        println("--- Errors (" + to_string(len(p.errors)) + ") ---")
        for i in range(0, len(p.errors)) {
            println("  " + p.errors[i])
        }
    } else {
        println("--- No errors ---")
    }
    println("")
    println("=== Done ===")
}

// -------------------------------------------------------------------
// Main entry point
// -------------------------------------------------------------------

fn main() {
    let cli_args = args()

    if len(cli_args) < 2 {
        println("Kryos Self-Hosted Compiler")
        println("")
        println("Usage:")
        println("  kryos-sh compile <input.kry> [-o output]")
        println("  kryos-sh check <input.kry>")
        println("  kryos-sh ast <input.kry>")
        return
    }

    let command = cli_args[1]

    if command == "compile" {
        if len(cli_args) < 3 {
            println("error: compile requires an input file")
            exit(1)
            return
        }
        let input = cli_args[2]
        let mut output = "a.out"
        if len(cli_args) >= 5 and cli_args[3] == "-o" {
            output = cli_args[4]
        }
        compile_file(input, output)
    } elif command == "mir" {
        if len(cli_args) < 3 {
            println("error: mir requires an input file")
            exit(1)
            return
        }
        let input = cli_args[2]
        let source = file_read(input)
        let tokens = tokenize(source)
        let p = parser_new(tokens)
        let module = parse_module(p)
        let mut tc = tc_new()
        tc = tc_register_builtins(tc)
        tc = tc_check_module(tc, module)
        let mir_mod = lower_module(module, tc)
        mir_print_module(mir_mod)
    } elif command == "obj" {
        if len(cli_args) < 3 {
            println("error: obj requires an input file")
            exit(1)
            return
        }
        let input = cli_args[2]
        let mut output = "a.obj"
        if len(cli_args) >= 5 and cli_args[3] == "-o" {
            output = cli_args[4]
        }
        emit_object(input, output)
    } elif command == "check" {
        if len(cli_args) < 3 {
            println("error: check requires an input file")
            exit(1)
            return
        }
        check_file(cli_args[2])
    } elif command == "ast" {
        if len(cli_args) < 3 {
            println("error: ast requires an input file")
            exit(1)
            return
        }
        dump_ast(cli_args[2])
    } else {
        // Default: treat first arg as filename for backward compat
        dump_ast(command)
    }
}

// The entry point is fn main() -- called automatically by the runtime.
// For self-compiled binaries, the _start function calls main().
