// ============================================================
// token.kry -- Token kinds and keyword lookup for the Kryos
// self-hosted compiler.
//
// Every token kind is an integer constant.  We use plain `let`
// bindings because Kryos enums cannot yet serve as match-arm
// discriminants in the bootstrap runtime.  The numbering matches
// the Rust `TokenKind` enum field order exactly, so the two
// compilers produce identical token streams.
//
// This file also contains:
//   - The `Token` struct
//   - `keyword_lookup(word) -> i32`  (returns TK_IDENT when not a keyword)
//   - `is_builtin_type(name) -> bool`
//   - `token_kind_name(kind) -> str` (for debug printing)
// ============================================================

// -------------------------------------------------------------------
// Token kind constants
// -------------------------------------------------------------------

// -- Literals --
let TK_INTEGER      = 1
let TK_FLOAT        = 2
let TK_STRING       = 3
let TK_STRING_PART  = 4
let TK_INTERP_START = 5
let TK_INTERP_END   = 6
let TK_CHAR         = 7
let TK_TRUE         = 8
let TK_FALSE        = 9
let TK_NONE         = 10

// -- Identifiers --
let TK_IDENT        = 11
let TK_TYPE_IDENT   = 12

// -- Keywords --
let TK_LET          = 13
let TK_MUT          = 14
let TK_FN           = 15
let TK_RETURN       = 16
let TK_IF           = 17
let TK_ELSE         = 18
let TK_ELIF         = 19
let TK_FOR          = 20
let TK_WHILE        = 21
let TK_IN           = 22
let TK_BREAK        = 23
let TK_CONTINUE     = 24
let TK_STRUCT       = 25
let TK_ENUM         = 26
let TK_IMPL         = 27
let TK_TRAIT        = 28
let TK_PUB          = 29
let TK_USE          = 30
let TK_EXTERN       = 31
let TK_AS           = 32
let TK_MOD          = 33
let TK_TYPE         = 34
let TK_ACTOR        = 35
let TK_SPAWN        = 36
let TK_SELECT       = 37
let TK_SEND         = 38
let TK_RECV         = 39
let TK_ASK          = 40
let TK_CHAN         = 41
let TK_PARALLEL     = 42
let TK_QUANTUM      = 43
let TK_COMPTIME     = 44
let TK_MATCH        = 45
let TK_AND          = 46
let TK_OR           = 47
let TK_NOT          = 48
let TK_TRY          = 49
let TK_CATCH        = 50
let TK_THROW        = 51
let TK_SHARED       = 52
let TK_WEAK         = 53
let TK_MOVE         = 54

// -- Operators --
let TK_PLUS         = 55
let TK_MINUS        = 56
let TK_STAR         = 57
let TK_SLASH        = 58
let TK_PERCENT      = 59
let TK_POWER        = 60
let TK_AT           = 61
let TK_EQ_EQ        = 62
let TK_BANG_EQ      = 63
let TK_LT           = 64
let TK_GT           = 65
let TK_LT_EQ        = 66
let TK_GT_EQ        = 67
let TK_EQ           = 68
let TK_PLUS_EQ      = 69
let TK_MINUS_EQ     = 70
let TK_STAR_EQ      = 71
let TK_SLASH_EQ     = 72
let TK_AMP          = 73
let TK_PIPE         = 74
let TK_CARET        = 75
let TK_TILDE        = 76
let TK_SHL          = 77
let TK_SHR          = 78

// -- Punctuation --
let TK_ARROW        = 79
let TK_FAT_ARROW    = 80
let TK_COLON_COLON  = 81
let TK_DOT_DOT      = 82
let TK_DOT_DOT_EQ   = 83
let TK_DOT          = 84
let TK_COLON        = 85
let TK_SEMICOLON    = 86
let TK_COMMA        = 87

// -- Grouping --
let TK_LPAREN       = 88
let TK_RPAREN       = 89
let TK_LBRACE       = 90
let TK_RBRACE       = 91
let TK_LBRACKET     = 92
let TK_RBRACKET     = 93

// -- Special --
let TK_NEWLINE      = 94
let TK_EOF          = 95
let TK_ERROR        = 96

// -------------------------------------------------------------------
// Token struct
// -------------------------------------------------------------------

@copy
struct Token {
    kind: i32,
    text: str,
    start: i32,
    end: i32
}

// -------------------------------------------------------------------
// keyword_lookup -- returns the keyword token kind for `word`,
// or TK_IDENT if it is not a keyword.
// -------------------------------------------------------------------

fn keyword_lookup(word: str) -> i32 {
    if word == "let"      { return TK_LET }
    if word == "mut"      { return TK_MUT }
    if word == "fn"       { return TK_FN }
    if word == "return"   { return TK_RETURN }
    if word == "if"       { return TK_IF }
    if word == "else"     { return TK_ELSE }
    if word == "elif"     { return TK_ELIF }
    if word == "for"      { return TK_FOR }
    if word == "while"    { return TK_WHILE }
    if word == "in"       { return TK_IN }
    if word == "break"    { return TK_BREAK }
    if word == "continue" { return TK_CONTINUE }
    if word == "struct"   { return TK_STRUCT }
    if word == "enum"     { return TK_ENUM }
    if word == "impl"     { return TK_IMPL }
    if word == "trait"    { return TK_TRAIT }
    if word == "pub"      { return TK_PUB }
    if word == "use"      { return TK_USE }
    if word == "extern"   { return TK_EXTERN }
    if word == "as"       { return TK_AS }
    if word == "mod"      { return TK_MOD }
    if word == "type"     { return TK_TYPE }
    if word == "true"     { return TK_TRUE }
    if word == "false"    { return TK_FALSE }
    if word == "none"     { return TK_NONE }
    if word == "actor"    { return TK_ACTOR }
    if word == "spawn"    { return TK_SPAWN }
    if word == "select"   { return TK_SELECT }
    if word == "send"     { return TK_SEND }
    if word == "recv"     { return TK_RECV }
    if word == "ask"      { return TK_ASK }
    if word == "chan"      { return TK_CHAN }
    if word == "parallel" { return TK_PARALLEL }
    if word == "quantum"  { return TK_QUANTUM }
    if word == "comptime" { return TK_COMPTIME }
    if word == "match"    { return TK_MATCH }
    if word == "and"      { return TK_AND }
    if word == "or"       { return TK_OR }
    if word == "not"      { return TK_NOT }
    if word == "try"      { return TK_TRY }
    if word == "catch"    { return TK_CATCH }
    if word == "throw"    { return TK_THROW }
    if word == "shared"   { return TK_SHARED }
    if word == "weak"     { return TK_WEAK }
    if word == "move"     { return TK_MOVE }
    return TK_IDENT
}

// -------------------------------------------------------------------
// is_builtin_type -- returns true if `name` is a built-in type
// identifier (i32, str, Vec, etc.)
// -------------------------------------------------------------------

fn is_builtin_type(name: str) -> bool {
    if name == "i8"     { return true }
    if name == "i16"    { return true }
    if name == "i32"    { return true }
    if name == "i64"    { return true }
    if name == "i128"   { return true }
    if name == "u8"     { return true }
    if name == "u16"    { return true }
    if name == "u32"    { return true }
    if name == "u64"    { return true }
    if name == "u128"   { return true }
    if name == "f32"    { return true }
    if name == "f64"    { return true }
    if name == "bool"   { return true }
    if name == "str"    { return true }
    if name == "char"   { return true }
    if name == "usize"  { return true }
    if name == "isize"  { return true }
    if name == "Tensor" { return true }
    if name == "Vec"    { return true }
    if name == "Map"    { return true }
    if name == "Set"    { return true }
    if name == "Option" { return true }
    if name == "Result" { return true }
    if name == "Secret" { return true }
    if name == "Qubit"  { return true }
    if name == "Qureg"  { return true }
    return false
}

// -------------------------------------------------------------------
// Character helpers -- avoid bare { } [ ] in string literals
// (the lexer treats { } as interpolation boundaries)
// -------------------------------------------------------------------

fn tk_chr_lbrace() -> str { return char_from(123) }
fn tk_chr_rbrace() -> str { return char_from(125) }
fn tk_chr_lbracket() -> str { return char_from(91) }
fn tk_chr_rbracket() -> str { return char_from(93) }

// -------------------------------------------------------------------
// token_kind_name -- returns a human-readable name for a token kind.
// Used for diagnostics and AST printing.
// -------------------------------------------------------------------

fn token_kind_name(kind: i32) -> str {
    if kind == TK_INTEGER      { return "Integer" }
    if kind == TK_FLOAT        { return "Float" }
    if kind == TK_STRING       { return "String" }
    if kind == TK_STRING_PART  { return "StringPart" }
    if kind == TK_INTERP_START { return "InterpStart" }
    if kind == TK_INTERP_END   { return "InterpEnd" }
    if kind == TK_CHAR         { return "Char" }
    if kind == TK_TRUE         { return "true" }
    if kind == TK_FALSE        { return "false" }
    if kind == TK_NONE         { return "none" }
    if kind == TK_IDENT        { return "Ident" }
    if kind == TK_TYPE_IDENT   { return "TypeIdent" }
    if kind == TK_LET          { return "let" }
    if kind == TK_MUT          { return "mut" }
    if kind == TK_FN           { return "fn" }
    if kind == TK_RETURN       { return "return" }
    if kind == TK_IF           { return "if" }
    if kind == TK_ELSE         { return "else" }
    if kind == TK_ELIF         { return "elif" }
    if kind == TK_FOR          { return "for" }
    if kind == TK_WHILE        { return "while" }
    if kind == TK_IN           { return "in" }
    if kind == TK_BREAK        { return "break" }
    if kind == TK_CONTINUE     { return "continue" }
    if kind == TK_STRUCT       { return "struct" }
    if kind == TK_ENUM         { return "enum" }
    if kind == TK_IMPL         { return "impl" }
    if kind == TK_TRAIT        { return "trait" }
    if kind == TK_PUB          { return "pub" }
    if kind == TK_USE          { return "use" }
    if kind == TK_EXTERN       { return "extern" }
    if kind == TK_AS           { return "as" }
    if kind == TK_MOD          { return "mod" }
    if kind == TK_TYPE         { return "type" }
    if kind == TK_ACTOR        { return "actor" }
    if kind == TK_SPAWN        { return "spawn" }
    if kind == TK_SELECT       { return "select" }
    if kind == TK_SEND         { return "send" }
    if kind == TK_RECV         { return "recv" }
    if kind == TK_ASK          { return "ask" }
    if kind == TK_CHAN         { return "chan" }
    if kind == TK_PARALLEL     { return "parallel" }
    if kind == TK_QUANTUM      { return "quantum" }
    if kind == TK_COMPTIME     { return "comptime" }
    if kind == TK_MATCH        { return "match" }
    if kind == TK_AND          { return "and" }
    if kind == TK_OR           { return "or" }
    if kind == TK_NOT          { return "not" }
    if kind == TK_TRY          { return "try" }
    if kind == TK_CATCH        { return "catch" }
    if kind == TK_THROW        { return "throw" }
    if kind == TK_SHARED       { return "shared" }
    if kind == TK_WEAK         { return "weak" }
    if kind == TK_MOVE         { return "move" }
    if kind == TK_PLUS         { return "+" }
    if kind == TK_MINUS        { return "-" }
    if kind == TK_STAR         { return "*" }
    if kind == TK_SLASH        { return "/" }
    if kind == TK_PERCENT      { return "%" }
    if kind == TK_POWER        { return "**" }
    if kind == TK_AT           { return "@" }
    if kind == TK_EQ_EQ        { return "==" }
    if kind == TK_BANG_EQ      { return "!=" }
    if kind == TK_LT           { return "<" }
    if kind == TK_GT           { return ">" }
    if kind == TK_LT_EQ        { return "<=" }
    if kind == TK_GT_EQ        { return ">=" }
    if kind == TK_EQ           { return "=" }
    if kind == TK_PLUS_EQ      { return "+=" }
    if kind == TK_MINUS_EQ     { return "-=" }
    if kind == TK_STAR_EQ      { return "*=" }
    if kind == TK_SLASH_EQ     { return "/=" }
    if kind == TK_AMP          { return "&" }
    if kind == TK_PIPE         { return "|" }
    if kind == TK_CARET        { return "^" }
    if kind == TK_TILDE        { return "~" }
    if kind == TK_SHL          { return "<<" }
    if kind == TK_SHR          { return ">>" }
    if kind == TK_ARROW        { return "->" }
    if kind == TK_FAT_ARROW    { return "=>" }
    if kind == TK_COLON_COLON  { return "::" }
    if kind == TK_DOT_DOT      { return ".." }
    if kind == TK_DOT_DOT_EQ   { return "..=" }
    if kind == TK_DOT          { return "." }
    if kind == TK_COLON        { return ":" }
    if kind == TK_SEMICOLON    { return ";" }
    if kind == TK_COMMA        { return "," }
    if kind == TK_LPAREN       { return "(" }
    if kind == TK_RPAREN       { return ")" }
    if kind == TK_LBRACE       { return tk_chr_lbrace() }
    if kind == TK_RBRACE       { return tk_chr_rbrace() }
    if kind == TK_LBRACKET     { return tk_chr_lbracket() }
    if kind == TK_RBRACKET     { return tk_chr_rbracket() }
    if kind == TK_NEWLINE      { return "Newline" }
    if kind == TK_EOF          { return "Eof" }
    return "Error"
}

// -------------------------------------------------------------------
// is_keyword -- returns true if the token kind is a keyword
// -------------------------------------------------------------------

fn is_keyword(kind: i32) -> bool {
    return kind >= TK_LET and kind <= TK_MOVE
}
