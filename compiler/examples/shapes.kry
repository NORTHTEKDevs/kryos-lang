// shapes.kry — Shape enum with area, perimeter, and size classification

enum Shape {
    Circle(f64),
    Rectangle(f64, f64),
    Triangle(f64, f64, f64),
}

fn triangle_area(a: f64, b: f64, c: f64) -> f64 {
    let sp = (a + b + c) / 2.0
    return sqrt(sp * (sp - a) * (sp - b) * (sp - c))
}

fn area(sh: Shape) -> f64 {
    match sh {
        Shape::Circle(r) => 3.14159265 * r * r,
        Shape::Rectangle(w, h) => w * h,
        Shape::Triangle(a, b, c) => triangle_area(a, b, c),
    }
}

fn perimeter(sh: Shape) -> f64 {
    match sh {
        Shape::Circle(r) => 2.0 * 3.14159265 * r,
        Shape::Rectangle(w, h) => 2.0 * (w + h),
        Shape::Triangle(a, b, c) => a + b + c,
    }
}

fn classify(a: f64) -> str {
    if a > 500.0 {
        return "large"
    } elif a > 50.0 {
        return "medium"
    } else {
        return "small"
    }
}

fn shape_name(sh: Shape) -> str {
    match sh {
        Shape::Circle(r) => "Circle(r=" + to_string(r) + ")",
        Shape::Rectangle(w, h) => "Rectangle(" + to_string(w) + "x" + to_string(h) + ")",
        Shape::Triangle(a, b, c) => "Triangle(" + to_string(a) + ", " + to_string(b) + ", " + to_string(c) + ")",
    }
}

fn main() {
    println("=== Shapes ===")
    println("")

    let shapes = [
        Shape.Circle(5.0),
        Shape.Circle(15.0),
        Shape.Rectangle(10.0, 20.0),
        Shape.Rectangle(3.0, 4.0),
        Shape.Triangle(3.0, 4.0, 5.0),
        Shape.Triangle(10.0, 10.0, 10.0),
    ]

    for sh in shapes {
        let name = shape_name(sh)
        let a = area(sh)
        let p = perimeter(sh)
        let size = classify(a)
        println(name)
        println("  area      = " + to_string(a))
        println("  perimeter = " + to_string(p))
        println("  size      = " + size)
        println("")
    }
}
