fn main() {
    let name = "Kryos"
    let version = "0.2"
    let greeting = "Hello, " + name + " v" + version + "!"
    println(greeting)
    println("")
    let lang = "Kryos"
    let desc = "a systems language"
    let designed = "for clarity and speed"
    let sentence = lang + " is " + desc + " " + designed + "."
    println(sentence)
    let first = "Jane"
    let last = "Doe"
    let full = first + " " + last
    println("Welcome, " + full + "!")
    println("Your name has " + to_string(len(full)) + " characters.")
}
