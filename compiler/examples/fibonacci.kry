// fibonacci.kry — Recursive and iterative Fibonacci, verify they match

fn fib_recursive(n: i64) -> i64 {
    if n <= 1 {
        return n
    }
    return fib_recursive(n - 1) + fib_recursive(n - 2)
}

fn fib_iterative(n: i64) -> i64 {
    if n <= 1 {
        return n
    }
    let mut a = 0
    let mut b = 1
    let mut i = 2
    while i <= n {
        let temp = a + b
        a = b
        b = temp
        i = i + 1
    }
    return b
}

fn main() {
    println("=== Fibonacci ===")
    println("")

    // Print first 10 values using recursive method
    let mut i = 0
    while i <= 10 {
        println("fib(" + to_string(i) + ") = " + to_string(fib_recursive(i)))
        i = i + 1
    }

    println("")

    // Compute fib(25) both ways
    let target = 25
    let rec_result = fib_recursive(target)
    let iter_result = fib_iterative(target)

    println("Recursive  fib(" + to_string(target) + ") = " + to_string(rec_result))
    println("Iterative  fib(" + to_string(target) + ") = " + to_string(iter_result))

    // Verify they match
    if rec_result == iter_result {
        println("PASS: Both methods agree.")
    } else {
        println("FAIL: Results differ!")
    }
}
