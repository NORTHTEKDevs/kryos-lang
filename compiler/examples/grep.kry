// grep.kry — Search for a pattern in lines of text

fn contains_word(haystack: str, needle: str) -> bool {
    let hay_len = len(haystack)
    let needle_len = len(needle)

    if needle_len > hay_len {
        return false
    }

    let mut i = 0
    let limit = hay_len - needle_len
    while i <= limit {
        let segment = substr(haystack, i, i + needle_len)
        if segment == needle {
            return true
        }
        i = i + 1
    }
    return false
}

fn main() {
    println("=== Grep ===")
    println("")

    let lines = [
        "the quick brown fox jumps over the lazy dog",
        "an error occurred while processing the request",
        "all systems operational and running smoothly",
        "warning: disk usage is above 90 percent",
        "error: connection timed out after 30 seconds",
        "server restarted successfully at midnight",
        "critical error detected in memory subsystem",
        "backup completed without any issues today",
        "network latency is within acceptable range",
        "error handling improved in latest release",
    ]

    // Search for "error"
    let pattern = "error"
    println("Searching for: " + pattern)
    println("---")

    let mut match_count = 0
    let mut line_num = 1
    for line in lines {
        if contains_word(line, pattern) {
            println(to_string(line_num) + ": " + line)
            match_count = match_count + 1
        }
        line_num = line_num + 1
    }

    println("---")
    println(to_string(match_count) + " matching lines found.")

    println("")

    // Second search for "the"
    let pattern2 = "the"
    println("Searching for: " + pattern2)
    println("---")

    let mut match_count2 = 0
    let mut line_num2 = 1
    for line in lines {
        if contains_word(line, pattern2) {
            println(to_string(line_num2) + ": " + line)
            match_count2 = match_count2 + 1
        }
        line_num2 = line_num2 + 1
    }

    println("---")
    println(to_string(match_count2) + " matching lines found.")
}
