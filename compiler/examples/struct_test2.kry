// struct_test2.kry — Demonstrates structs with methods and composition.

struct Point {
    x: f64,
    y: f64
}

struct Rectangle {
    origin: Point,
    width: f64,
    height: f64
}

fn point_distance(a: Point, b: Point) -> f64 {
    let dx = a.x - b.x
    let dy = a.y - b.y
    return sqrt(dx * dx + dy * dy)
}

fn rect_area(r: Rectangle) -> f64 {
    return r.width * r.height
}

fn rect_perimeter(r: Rectangle) -> f64 {
    return 2.0 * (r.width + r.height)
}

fn rect_contains(r: Rectangle, p: Point) -> bool {
    return p.x >= r.origin.x
        and p.x <= r.origin.x + r.width
        and p.y >= r.origin.y
        and p.y <= r.origin.y + r.height
}

fn main() {
    let a = Point { x: 0.0, y: 0.0 }
    let b = Point { x: 3.0, y: 4.0 }
    let dist = point_distance(a, b)
    println("distance(0,0 -> 3,4) = " + to_string(dist))

    let rect = Rectangle {
        origin: Point { x: 1.0, y: 1.0 },
        width: 10.0,
        height: 5.0
    }
    println("area      = " + to_string(rect_area(rect)))
    println("perimeter = " + to_string(rect_perimeter(rect)))

    let inside = Point { x: 5.0, y: 3.0 }
    let outside = Point { x: 15.0, y: 3.0 }
    println("(5,3) inside?  " + to_string(rect_contains(rect, inside)))
    println("(15,3) inside? " + to_string(rect_contains(rect, outside)))
}
