// calculator.kry — Enum-based calculator with pattern matching

enum Op {
    Add,
    Sub,
    Mul,
    Div,
}

fn calculate(op: Op, a: f64, b: f64) -> f64 {
    match op {
        Op::Add => a + b,
        Op::Sub => a - b,
        Op::Mul => a * b,
        Op::Div => a / b,
    }
}

fn op_symbol(op: Op) -> str {
    match op {
        Op::Add => "+",
        Op::Sub => "-",
        Op::Mul => "*",
        Op::Div => "/",
    }
}

fn main() {
    println("=== Calculator ===")
    println("")

    // Demonstrate each operation
    let ops = [Op.Add, Op.Sub, Op.Mul, Op.Div]
    let a_vals = [10.0, 100.0, 6.0, 355.0]
    let b_vals = [25.0, 37.5, 7.0, 113.0]

    let mut i = 0
    while i < len(ops) {
        let op = ops[i]
        let a = a_vals[i]
        let b = b_vals[i]
        let result = calculate(op, a, b)
        println(to_string(a) + " " + op_symbol(op) + " " + to_string(b) + " = " + to_string(result))
        i = i + 1
    }

    println("")

    // Chained calculation: ((10 + 5) * 3) - 7
    let step1 = calculate(Op.Add, 10.0, 5.0)
    let step2 = calculate(Op.Mul, step1, 3.0)
    let step3 = calculate(Op.Sub, step2, 7.0)
    println("((10 + 5) * 3) - 7 = " + to_string(step3))

    // Division precision
    let pi_approx = calculate(Op.Div, 355.0, 113.0)
    println("355 / 113 = " + to_string(pi_approx) + " (approx pi)")
}
