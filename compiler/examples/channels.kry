// channels.kry — Spawn 3 workers, collect results via channel, print sum

fn sum_range(start: i64, end: i64) -> i64 {
    let mut sum = 0
    let mut i = start
    while i <= end {
        sum = sum + i
        i = i + 1
    }
    return sum
}

fn main() {
    println("=== Channels ===")
    println("")

    let ch = chan()

    // Spawn 3 workers that compute partial sums
    spawn {
        println("Worker 1: computing sum(1..10)")
        send(ch, sum_range(1, 10))
    }

    spawn {
        println("Worker 2: computing sum(11..20)")
        send(ch, sum_range(11, 20))
    }

    spawn {
        println("Worker 3: computing sum(21..30)")
        send(ch, sum_range(21, 30))
    }

    // Collect all 3 results
    let r1 = recv(ch)
    let r2 = recv(ch)
    let r3 = recv(ch)
    let total = r1 + r2 + r3

    println("")
    println("Results: " + to_string(r1) + " + " + to_string(r2) + " + " + to_string(r3))
    println("Total:   " + to_string(total))

    // Verify: sum(1..30) = 465
    if total == 465 {
        println("PASS: Sum of 1..30 is correct.")
    } else {
        println("FAIL: Expected 465, got " + to_string(total))
    }
}
