// Test 82: Match on string values
fn main() {
    let cmd = "start"
    let result = match cmd {
        "start" => "starting",
        "stop" => "stopping",
        "restart" => "restarting",
        _ => "unknown",
    }
    println(result)

    let cmd2 = "unknown_cmd"
    let result2 = match cmd2 {
        "start" => "starting",
        "stop" => "stopping",
        _ => "unknown: " + cmd2,
    }
    println(result2)
}
