enum Result {
    Ok(i64),
    Err(str)
}

fn divide(a: i64, b: i64) -> Result {
    if b == 0 {
        return Result.Err("division by zero")
    }
    return Result.Ok(a / b)
}

fn main() {
    let r1 = divide(10, 3)
    match r1 {
        Result::Ok(v) => println("ok: " + to_string(v)),
        Result::Err(msg) => println("err: " + msg),
    }
    
    let r2 = divide(10, 0)
    match r2 {
        Result::Ok(v) => println("ok: " + to_string(v)),
        Result::Err(msg) => println("err: " + msg),
    }
}
