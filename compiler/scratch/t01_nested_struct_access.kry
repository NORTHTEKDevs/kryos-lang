// Test 01: Nested struct field access (a.b.c)
struct Inner {
    value: i64,
}

struct Middle {
    inner: Inner,
    name: str,
}

struct Outer {
    middle: Middle,
    id: i64,
}

fn main() {
    let inner = Inner { value: 42 }
    let mid = Middle { inner: inner, name: "test" }
    let outer = Outer { middle: mid, id: 1 }

    // Direct nested access
    println(outer.id)
    println(outer.middle.name)
    println(outer.middle.inner.value)
}
