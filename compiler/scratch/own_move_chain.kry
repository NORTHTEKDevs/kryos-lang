// Test complex move chains
struct Box {
    value: i64
}

fn take(b: Box) -> Box {
    return Box { value: b.value + 1 }
}

fn main() {
    let a = Box { value: 0 }
    let b = take(a)
    let c = take(b)
    let d = take(c)
    println("final value: " + to_string(d.value))
    // a, b, c should all be moved
}
