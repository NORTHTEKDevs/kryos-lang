// Test 39: Mutating a struct field
struct Counter {
    count: i64,
    name: str,
}

fn main() {
    let mut c = Counter { count: 0, name: "test" }
    c.count = c.count + 1
    c.count = c.count + 1
    c.count = c.count + 1
    println(c.count)   // should be 3
    println(c.name)    // should be "test"
}
