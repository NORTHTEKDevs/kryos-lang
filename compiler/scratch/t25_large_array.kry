// Test 25: Large array (1000 elements)
fn main() {
    let mut arr: [i64] = []
    let mut i = 0
    while i < 1000 {
        push(arr, i * i)
        i = i + 1
    }
    println(len(arr))        // should be 1000
    println(arr[0])          // should be 0
    println(arr[999])        // should be 998001
    println(arr[500])        // should be 250000

    // Sum the array
    let mut sum = 0
    let mut j = 0
    while j < len(arr) {
        sum = sum + arr[j]
        j = j + 1
    }
    println(sum)
}
