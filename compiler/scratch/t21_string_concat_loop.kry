// Test 21: String concatenation in a loop (100 iterations)
fn main() {
    let mut result = ""
    let mut i = 0
    while i < 100 {
        result = result + "x"
        i = i + 1
    }
    println(len(result))  // should be 100

    // Verify first and last chars
    println(substr(result, 0, 1))   // should be "x"
    println(substr(result, 99, 100))  // should be "x"
}
