// Test very long strings
fn main() {
    let mut s = ""
    let mut i = 0
    while i < 10000 {
        s = s + "a"
        i = i + 1
    }
    println("long string len: " + to_string(len(s)))
    println("contains 'aaa': " + to_string(contains(s, "aaa")))
    let sub = substr(s, 9990, 10000)
    println("last 10 chars len: " + to_string(len(sub)))
}
