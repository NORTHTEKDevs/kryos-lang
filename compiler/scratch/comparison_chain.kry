// Test comparison operators
fn main() {
    println("1 < 2: " + to_string(1 < 2))
    println("2 < 1: " + to_string(2 < 1))
    println("1 <= 1: " + to_string(1 <= 1))
    println("1 >= 2: " + to_string(1 >= 2))
    println("1 == 1: " + to_string(1 == 1))
    println("1 != 2: " + to_string(1 != 2))
    println("1 != 1: " + to_string(1 != 1))
    // String comparison
    println("abc == abc: " + to_string("abc" == "abc"))
    println("abc == def: " + to_string("abc" == "def"))
    println("abc != def: " + to_string("abc" != "def"))
}
