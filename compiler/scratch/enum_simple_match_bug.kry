// Test: does match on simple enum without payload also crash?
enum Color {
    Red,
    Green,
    Blue,
}

fn main() {
    let colors = [Color.Red, Color.Green, Color.Blue]
    for c in colors {
        match c {
            Color::Red => println("red"),
            Color::Green => println("green"),
            Color::Blue => println("blue"),
        }
    }
}
