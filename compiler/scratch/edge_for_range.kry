fn main() {
    let mut sum = 0
    for i in range(1, 11) {
        sum = sum + i
    }
    println(to_string(sum))
    
    // Empty range
    let mut count = 0
    for i in range(5, 5) {
        count = count + 1
    }
    println(to_string(count))
    
    // Reverse range (should be empty)
    let mut rev_count = 0
    for i in range(10, 5) {
        rev_count = rev_count + 1
    }
    println(to_string(rev_count))
}
