// Test deeply nested if/elif/else
fn main() {
    let x = 42
    if x > 100 {
        println("a")
    } elif x > 90 {
        println("b")
    } elif x > 80 {
        println("c")
    } elif x > 70 {
        println("d")
    } elif x > 60 {
        println("e")
    } elif x > 50 {
        println("f")
    } elif x > 40 {
        println("g")
    } elif x > 30 {
        println("h")
    } elif x > 20 {
        println("i")
    } elif x > 10 {
        println("j")
    } else {
        println("k")
    }
    println("done")
}
