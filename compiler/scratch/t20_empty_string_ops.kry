// Test 20: Empty string operations
fn main() {
    let empty = ""

    // len of empty string
    println(len(empty))  // should be 0

    // substr of empty string
    let sub = substr(empty, 0, 0)
    println(sub)  // should be ""
    println(len(sub))  // should be 0

    // Concatenation with empty
    let result = "" + "hello" + ""
    println(result)  // should be "hello"
    println(len(result))  // should be 5
}
