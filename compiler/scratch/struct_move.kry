// Test struct move semantics - use after move should error
struct Data {
    value: i64
}

fn consume(d: Data) -> i64 {
    return d.value
}

fn main() {
    let d = Data { value: 42 }
    let v = consume(d)
    println("consumed: " + to_string(v))
    // This should error - d was moved
    println("after move: " + to_string(d.value))
}
