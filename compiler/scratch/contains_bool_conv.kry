// Test that contains/starts_with/ends_with return proper booleans
fn main() {
    let result = contains("hello", "ell")
    if result {
        println("contains works as bool in if")
    }
    // But to_string shows 1/0 instead of true/false
    println("contains to_string: " + to_string(result))
    println("type_of contains: " + type_of(result))
}
