// Test nested match expressions
enum Op {
    Add,
    Sub,
}

enum Expr {
    Num(i64),
    BinOp(Op, i64, i64),
}

fn eval(e: Expr) -> i64 {
    match e {
        Expr::Num(n) => n,
        Expr::BinOp(op, a, b) => {
            match op {
                Op::Add => a + b,
                Op::Sub => a - b,
            }
        },
    }
}

fn main() {
    println("Num(5): " + to_string(eval(Expr.Num(5))))
    println("Add(3, 4): " + to_string(eval(Expr.BinOp(Op.Add, 3, 4))))
    println("Sub(10, 3): " + to_string(eval(Expr.BinOp(Op.Sub, 10, 3))))
}
