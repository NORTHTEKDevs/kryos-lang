// Test 28: Multiple channels
fn main() {
    let ch1 = chan()
    let ch2 = chan()
    let ch3 = chan()

    spawn {
        send(ch1, 10)
    }
    spawn {
        send(ch2, 20)
    }
    spawn {
        send(ch3, 30)
    }

    let v1 = recv(ch1)
    let v2 = recv(ch2)
    let v3 = recv(ch3)

    println(v1)
    println(v2)
    println(v3)
    println(v1 + v2 + v3)  // should be 60
}
