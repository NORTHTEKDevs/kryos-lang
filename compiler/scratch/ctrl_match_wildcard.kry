// Test match with wildcard
fn main() {
    let x = 42
    match x {
        0 => println("zero"),
        1 => println("one"),
        _ => println("other: " + to_string(x)),
    }

    // Match with no wildcard on an int that doesn't match
    let y = 99
    match y {
        0 => println("zero"),
        1 => println("one"),
        2 => println("two"),
    }
    println("after match without wildcard")
}
