// Test range with various args
fn main() {
    // Normal range
    let mut sum = 0
    for i in range(0, 5) {
        sum = sum + i
    }
    println("range(0,5) sum: " + to_string(sum))

    // range(5, 5) - empty
    let mut count = 0
    for i in range(5, 5) {
        count = count + 1
    }
    println("range(5,5) count: " + to_string(count))

    // range(5, 0) - reversed
    let mut count2 = 0
    for i in range(5, 0) {
        count2 = count2 + 1
    }
    println("range(5,0) count: " + to_string(count2))

    // range with negative
    let mut neg_items: [i64] = []
    for i in range(-3, 3) {
        push(neg_items, i)
    }
    println("range(-3,3) len: " + to_string(len(neg_items)))
    println("range(-3,3) first: " + to_string(neg_items[0]))
    println("range(-3,3) last: " + to_string(neg_items[len(neg_items) - 1]))
}
