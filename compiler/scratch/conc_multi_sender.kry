// Test multiple senders on same channel
fn main() {
    let ch = chan()
    let mut i = 0
    while i < 10 {
        spawn {
            send(ch, i)
        }
        i = i + 1
    }

    let mut total = 0
    let mut count = 0
    while count < 10 {
        total = total + recv(ch)
        count = count + 1
    }
    println("received " + to_string(count) + " values, total = " + to_string(total))
}
