// Test nested arrays
fn main() {
    let matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    println("matrix len: " + to_string(len(matrix)))
    let row0 = matrix[0]
    println("row0 len: " + to_string(len(row0)))
    println("matrix[0][0]: " + to_string(row0[0]))
    println("matrix[1][2]: " + to_string(matrix[1][2]))
}
