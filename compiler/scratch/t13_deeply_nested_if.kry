// Test 13: Deeply nested if/else (10+ levels)
fn classify(x: i64) -> str {
    if x > 100 {
        if x > 200 {
            if x > 300 {
                if x > 400 {
                    if x > 500 {
                        if x > 600 {
                            if x > 700 {
                                if x > 800 {
                                    if x > 900 {
                                        if x > 1000 {
                                            return "over1000"
                                        } else {
                                            return "901-1000"
                                        }
                                    } else {
                                        return "801-900"
                                    }
                                } else {
                                    return "701-800"
                                }
                            } else {
                                return "601-700"
                            }
                        } else {
                            return "501-600"
                        }
                    } else {
                        return "401-500"
                    }
                } else {
                    return "301-400"
                }
            } else {
                return "201-300"
            }
        } else {
            return "101-200"
        }
    } else {
        return "0-100"
    }
}

fn main() {
    println(classify(50))
    println(classify(150))
    println(classify(550))
    println(classify(950))
    println(classify(1500))
}
