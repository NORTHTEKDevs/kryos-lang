// Test bitwise operators
fn main() {
    println("5 & 3 = " + to_string(5 & 3))
    println("5 | 3 = " + to_string(5 | 3))
    println("5 ^ 3 = " + to_string(5 ^ 3))
    println("~0 = " + to_string(~0))
    println("1 << 10 = " + to_string(1 << 10))
    println("1024 >> 5 = " + to_string(1024 >> 5))
    println("~(-1) = " + to_string(~(-1)))
}
