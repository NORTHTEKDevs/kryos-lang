// Test 100: Fibonacci with concurrent workers
fn fib(n: i64) -> i64 {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    let ch = chan()

    // Spawn 5 workers computing different fibonacci values
    spawn { send(ch, fib(10)) }
    spawn { send(ch, fib(15)) }
    spawn { send(ch, fib(20)) }
    spawn { send(ch, fib(12)) }
    spawn { send(ch, fib(8)) }

    let mut sum = 0
    let mut i = 0
    while i < 5 {
        sum = sum + recv(ch)
        i = i + 1
    }
    println(sum)
}
