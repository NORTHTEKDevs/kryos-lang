// Test 56: Mutual recursion
fn is_even(n: i64) -> bool {
    if n == 0 {
        return true
    }
    return is_odd(n - 1)
}

fn is_odd(n: i64) -> bool {
    if n == 0 {
        return false
    }
    return is_even(n - 1)
}

fn main() {
    println(is_even(10))   // should be true
    println(is_odd(10))    // should be false
    println(is_even(7))    // should be false
    println(is_odd(7))     // should be true
}
