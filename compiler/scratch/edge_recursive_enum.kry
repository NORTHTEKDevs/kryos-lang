// Test recursive data structures - linked list
enum List {
    Nil,
    Cons(i64, i64)
}

fn list_sum(l: List) -> i64 {
    match l {
        List::Nil => 0,
        List::Cons(head, _tail) => head,
    }
}

fn main() {
    let n = List.Nil
    let c = List.Cons(42, 0)
    println(to_string(list_sum(n)))
    println(to_string(list_sum(c)))
}
