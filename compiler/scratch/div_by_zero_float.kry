// Test float division by zero
fn main() {
    let a = 42.0
    let b = 0.0
    let result = a / b
    println("42.0 / 0.0 = " + to_string(result))
    let neg_result = -42.0 / 0.0
    println("-42.0 / 0.0 = " + to_string(neg_result))
    let zero_zero = 0.0 / 0.0
    println("0.0 / 0.0 = " + to_string(zero_zero))
}
