// Test 16: Return from inside a for loop
fn find_first_over(arr: [i64], threshold: i64) -> i64 {
    for item in arr {
        if item > threshold {
            return item
        }
    }
    return -1
}

fn main() {
    let data = [1, 5, 3, 8, 2, 9, 4]
    let result = find_first_over(data, 6)
    println(result)  // should be 8

    let result2 = find_first_over(data, 100)
    println(result2)  // should be -1
}
