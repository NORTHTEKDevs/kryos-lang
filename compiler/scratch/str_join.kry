// Test join edge cases
fn main() {
    let empty_arr: [str] = []
    println("join empty: '" + join(empty_arr, ",") + "'")
    let single = ["only"]
    println("join single: '" + join(single, ",") + "'")
    let multi = ["a", "b", "c"]
    println("join multi: '" + join(multi, "") + "'")
    println("join with long sep: '" + join(multi, "---") + "'")
}
