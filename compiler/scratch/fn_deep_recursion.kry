// Test deep recursion
fn countdown(n: i64) -> i64 {
    if n <= 0 {
        return 0
    }
    return countdown(n - 1) + 1
}

fn main() {
    println("countdown(100): " + to_string(countdown(100)))
    println("countdown(1000): " + to_string(countdown(1000)))
    println("countdown(10000): " + to_string(countdown(10000)))
}
