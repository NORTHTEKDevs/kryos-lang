// Test 19: Very long strings (1000+ chars)
fn main() {
    let mut s = ""
    let mut i = 0
    while i < 100 {
        s = s + "0123456789"
        i = i + 1
    }
    println(len(s))  // should be 1000
    println(substr(s, 0, 10))  // should be "0123456789"
    println(substr(s, 990, 1000))  // should be "0123456789"
}
