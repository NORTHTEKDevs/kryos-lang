// Test basic trait implementation
trait Describable {
    fn describe(self) -> str
}

struct Dog {
    name: str,
    age: i64
}

impl Describable for Dog {
    fn describe(self) -> str {
        return self.name + " (age " + to_string(self.age) + ")"
    }
}

fn main() {
    let d = Dog { name: "Rex", age: 5 }
    println(d.describe())
}
