// Test float NaN and Infinity propagation
fn main() {
    let inf = 1.0 / 0.0
    let neg_inf = -1.0 / 0.0
    let nan = 0.0 / 0.0
    println("inf: " + to_string(inf))
    println("-inf: " + to_string(neg_inf))
    println("nan: " + to_string(nan))
    println("inf + 1: " + to_string(inf + 1.0))
    println("inf - inf: " + to_string(inf - inf))
    println("nan + 1: " + to_string(nan + 1.0))
    println("nan == nan: " + to_string(nan == nan))
    println("inf > 0: " + to_string(inf > 0.0))
    println("inf * 0: " + to_string(inf * 0.0))
}
