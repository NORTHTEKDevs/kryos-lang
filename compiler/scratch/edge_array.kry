fn main() {
    let empty: [i64] = []
    println(to_string(len(empty)))
    
    for item in empty {
        println("should not print")
    }
    
    let mut arr: [i64] = []
    push(arr, 10)
    push(arr, 20)
    push(arr, 30)
    println(to_string(len(arr)))
    println(to_string(arr[0]))
    println(to_string(arr[2]))
    
    let last = pop(arr)
    println(to_string(last))
    println(to_string(len(arr)))
    
    println("done")
}
