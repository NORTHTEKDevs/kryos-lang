// Test special characters in strings
fn main() {
    let nl = "line1\nline2"
    println("newline string: " + nl)
    println("newline len: " + to_string(len(nl)))
    let tab = "col1\tcol2"
    println("tab string: " + tab)
    let quote = "he said \"hello\""
    println("quote string: " + quote)
    let backslash = "path\\to\\file"
    println("backslash: " + backslash)
}
