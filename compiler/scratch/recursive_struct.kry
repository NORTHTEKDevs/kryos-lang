// Test recursive struct (should this be allowed?)
enum List {
    Cons(i64, List),
    Nil,
}

fn sum_list(l: List) -> i64 {
    match l {
        List::Cons(val, rest) => val + sum_list(rest),
        List::Nil => 0,
    }
}

fn main() {
    let list = List.Cons(1, List.Cons(2, List.Cons(3, List.Nil)))
    println("sum: " + to_string(sum_list(list)))
}
