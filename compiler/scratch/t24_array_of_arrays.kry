// Test 24: Array of arrays (2D array)
fn main() {
    let matrix = [
        [1, 2, 3],
        [4, 5, 6],
        [7, 8, 9],
    ]
    println(len(matrix))       // should be 3
    println(matrix[0][0])      // should be 1
    println(matrix[1][1])      // should be 5
    println(matrix[2][2])      // should be 9
}
