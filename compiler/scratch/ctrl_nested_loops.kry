// Test nested loops with break
fn main() {
    let mut outer_count = 0
    let mut i = 0
    while i < 10 {
        let mut j = 0
        while j < 10 {
            if j == 5 {
                break
            }
            j = j + 1
        }
        outer_count = outer_count + j
        i = i + 1
    }
    println("nested break: outer_count = " + to_string(outer_count))
    // Should be 10 * 5 = 50
}
