// Test 81: 100 spawns with channel
fn main() {
    let ch = chan()

    let mut i = 0
    while i < 100 {
        let val = i
        spawn {
            send(ch, val)
        }
        i = i + 1
    }

    let mut sum = 0
    let mut j = 0
    while j < 100 {
        sum = sum + recv(ch)
        j = j + 1
    }

    println(sum)  // should be 4950
}
