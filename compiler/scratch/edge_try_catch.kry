fn risky(x: i64) -> i64 {
    if x == 0 {
        throw "cannot be zero"
    }
    return 100 / x
}

fn main() {
    let result = try {
        risky(5)
    } catch e {
        println("caught: " + e)
        -1
    }
    println(to_string(result))
    
    let result2 = try {
        risky(0)
    } catch e {
        println("caught: " + e)
        -1
    }
    println(to_string(result2))
}
