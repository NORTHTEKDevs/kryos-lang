// Test push/pop stress
fn main() {
    let mut arr: [i64] = []
    let mut i = 0
    while i < 100 {
        push(arr, i)
        i = i + 1
    }
    println("after push 100: len=" + to_string(len(arr)))
    let mut count = 0
    while len(arr) > 0 {
        let val = pop(arr)
        count = count + 1
    }
    println("popped " + to_string(count) + " items")
    println("final len: " + to_string(len(arr)))
}
