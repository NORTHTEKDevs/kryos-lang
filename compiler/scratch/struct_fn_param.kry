// Test struct as function parameter and return
struct Point {
    x: f64,
    y: f64
}

fn make_point(x: f64, y: f64) -> Point {
    return Point { x: x, y: y }
}

fn add_points(a: Point, b: Point) -> Point {
    return Point { x: a.x + b.x, y: a.y + b.y }
}

fn describe_point(p: Point) -> str {
    return "(" + to_string(p.x) + ", " + to_string(p.y) + ")"
}

fn main() {
    let p1 = make_point(1.0, 2.0)
    let p2 = make_point(3.0, 4.0)
    let p3 = add_points(p1, p2)
    println("p1: " + describe_point(p1))
    println("p2: " + describe_point(p2))
    println("p3: " + describe_point(p3))
}
