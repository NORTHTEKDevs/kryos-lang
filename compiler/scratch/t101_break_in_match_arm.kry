// Test 101: Using break as a match arm expression (known parse failure)
// This is the minimal repro for the "break not an expression" error in match arms
fn main() {
    let mut i = 0
    while i < 5 {
        match i {
            3 => break,
            _ => println(i),
        }
        i = i + 1
    }
    println("done")
}
