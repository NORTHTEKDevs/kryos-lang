// Test 11: Nested function calls with the same variable
fn add_one(x: i64) -> i64 {
    return x + 1
}

fn double(x: i64) -> i64 {
    return x * 2
}

fn main() {
    let x = 5
    // Nested calls using return values
    let result = add_one(double(add_one(x)))
    println(result)  // should be (5+1)*2+1 = 13
}
