// Test 35: Throw various types and catch
fn main() {
    // Throw string
    try {
        throw "something went wrong"
    } catch e {
        println("caught: " + to_string(e))
    }

    // Throw integer
    try {
        throw 404
    } catch e {
        println("caught: " + to_string(e))
    }

    // Rethrow from catch
    try {
        try {
            throw "inner error"
        } catch e {
            throw "wrapped: " + to_string(e)
        }
    } catch e {
        println("outer caught: " + to_string(e))
    }
}
