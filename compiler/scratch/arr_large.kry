// Test large arrays
fn main() {
    let mut arr: [i64] = []
    let mut i = 0
    while i < 1000 {
        push(arr, i)
        i = i + 1
    }
    println("large arr len: " + to_string(len(arr)))
    println("arr[0]: " + to_string(arr[0]))
    println("arr[999]: " + to_string(arr[999]))
    // Sum all elements
    let mut sum = 0
    for item in arr {
        sum = sum + item
    }
    println("sum 0..999: " + to_string(sum))
}
