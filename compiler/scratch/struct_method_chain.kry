// Test struct method calling another method
@copy
struct Counter {
    value: i64
}

impl Counter {
    fn get(self) -> i64 {
        return self.value
    }

    fn describe(self) -> str {
        return "Counter(" + to_string(self.get()) + ")"
    }
}

fn main() {
    let c = Counter { value: 42 }
    println(c.describe())
    println("value: " + to_string(c.get()))
}
