// Test: enum with string payload - drop
enum Message {
    Text(str),
    Code(i64),
}

fn main() {
    let m1 = Message.Text("hello world")
    let m2 = Message.Code(42)
    match m1 {
        Message::Text(s) => println("text: " + s),
        Message::Code(c) => println("code: " + to_string(c)),
    }
    match m2 {
        Message::Text(s) => println("text: " + s),
        Message::Code(c) => println("code: " + to_string(c)),
    }
    println("done - no crash?")
}
