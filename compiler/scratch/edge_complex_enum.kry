enum Tree {
    Leaf(i64),
    Node(i64, i64)
}

fn sum_tree(t: Tree) -> i64 {
    match t {
        Tree::Leaf(v) => v,
        Tree::Node(l, r) => l + r,
    }
}

fn main() {
    let leaf = Tree.Leaf(42)
    let node = Tree.Node(10, 20)
    println(to_string(sum_tree(leaf)))
    println(to_string(sum_tree(node)))
}
