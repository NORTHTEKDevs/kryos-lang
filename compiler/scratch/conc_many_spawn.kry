// Test spawning many tasks
fn main() {
    let ch = chan()
    let mut i = 0
    while i < 100 {
        spawn {
            send(ch, 1)
        }
        i = i + 1
    }
    let mut total = 0
    let mut count = 0
    while count < 100 {
        total = total + recv(ch)
        count = count + 1
    }
    println("spawned 100 tasks, total = " + to_string(total))
}
