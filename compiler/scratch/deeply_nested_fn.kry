// Test deeply nested function calls
fn a(x: i64) -> i64 { return b(x + 1) }
fn b(x: i64) -> i64 { return c(x + 1) }
fn c(x: i64) -> i64 { return d(x + 1) }
fn d(x: i64) -> i64 { return e(x + 1) }
fn e(x: i64) -> i64 { return f(x + 1) }
fn f(x: i64) -> i64 { return g(x + 1) }
fn g(x: i64) -> i64 { return h(x + 1) }
fn h(x: i64) -> i64 { return x + 1 }

fn main() {
    let result = a(0)
    println("a(0) through 8 levels: " + to_string(result))
    // Should be 8
}
