// Test struct with many fields
struct BigStruct {
    a: i64,
    b: i64,
    c: i64,
    d: i64,
    e: i64,
    f: i64,
    g: i64,
    h: i64,
    i: i64,
    j: i64
}

fn main() {
    let s = BigStruct { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10 }
    let sum = s.a + s.b + s.c + s.d + s.e + s.f + s.g + s.h + s.i + s.j
    println("sum of 10 fields: " + to_string(sum))
}
