fn main() {
    println(to_string(sqrt(16.0)))
    println(to_string(floor(3.7)))
    println(to_string(ceil(3.2)))
    println(to_string(abs(-5.0)))
    println(to_string(min(3.0, 7.0)))
    println(to_string(max(3.0, 7.0)))
    
    // Float precision
    let pi = 3.14159265358979
    println(to_string(pi))
}
