// Test 31: Many spawns (50+)
fn main() {
    let ch = chan()

    let mut i = 0
    while i < 50 {
        let val = i
        spawn {
            send(ch, val)
        }
        i = i + 1
    }

    // Collect all 50 results
    let mut sum = 0
    let mut j = 0
    while j < 50 {
        let r = recv(ch)
        sum = sum + r
        j = j + 1
    }

    println(sum)  // should be 0+1+2+...+49 = 1225
}
