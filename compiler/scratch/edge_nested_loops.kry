fn main() {
    let mut sum = 0
    let mut i = 0
    while i < 3 {
        let mut j = 0
        while j < 3 {
            if i == 1 and j == 1 {
                j = j + 1
                continue
            }
            sum = sum + i * 10 + j
            j = j + 1
        }
        i = i + 1
    }
    println(to_string(sum))
    
    // Test break from nested loop
    let mut found = 0
    let mut a = 0
    while a < 10 {
        let mut b = 0
        while b < 10 {
            if a * b == 42 {
                found = a * 100 + b
                break
            }
            b = b + 1
        }
        if found > 0 {
            break
        }
        a = a + 1
    }
    println(to_string(found))
}
