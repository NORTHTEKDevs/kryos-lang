// Test 40: Match on same enum value multiple times
// This tests whether the borrow checker blocks enum reuse in match
enum Color {
    Red,
    Green,
    Blue,
}

fn main() {
    let c = Color.Red

    let name = match c {
        Red => "red",
        Green => "green",
        Blue => "blue",
    }
    println(name)

    // Using c again after match
    let code = match c {
        Red => 1,
        Green => 2,
        Blue => 3,
    }
    println(code)
}
