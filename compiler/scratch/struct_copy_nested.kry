// Test @copy struct with nested non-copy struct
struct NonCopy {
    data: [i64]
}

@copy
struct CopyOuter {
    value: i64,
    name: str
}

fn main() {
    let a = CopyOuter { value: 42, name: "hello" }
    let b = a
    println("a.value: " + to_string(a.value))
    println("b.value: " + to_string(b.value))
    println("a.name: " + a.name)
    println("b.name: " + b.name)
}
