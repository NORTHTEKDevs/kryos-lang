// Test functions returning functions
fn get_op(name: str) -> fn(i64, i64) -> i64 {
    if name == "add" {
        return add
    }
    return sub
}

fn add(a: i64, b: i64) -> i64 {
    return a + b
}

fn sub(a: i64, b: i64) -> i64 {
    return a - b
}

fn main() {
    let f = get_op("add")
    println("add(3, 4): " + to_string(f(3, 4)))
    let g = get_op("sub")
    println("sub(10, 3): " + to_string(g(10, 3)))
}
