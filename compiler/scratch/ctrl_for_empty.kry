// Test for loop over empty array
fn main() {
    let empty: [i64] = []
    let mut count = 0
    for item in empty {
        count = count + 1
    }
    println("count after empty for: " + to_string(count))

    // For over range(0, 0)
    let mut count2 = 0
    for i in range(0, 0) {
        count2 = count2 + 1
    }
    println("range(0,0) count: " + to_string(count2))

    // For over range(5, 3) -- reversed range
    let mut count3 = 0
    for i in range(5, 3) {
        count3 = count3 + 1
    }
    println("range(5,3) count: " + to_string(count3))
}
