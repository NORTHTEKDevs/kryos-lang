@copy
struct Person {
    name: str,
    age: i64,
    active: bool
}

fn describe(p: Person) -> str {
    let status = "inactive"
    if p.active {
        status = "active"
    }
    return p.name + " (age " + to_string(p.age) + ", " + status + ")"
}

fn main() {
    let p1 = Person { name: "Alice", age: 30, active: true }
    let p2 = Person { name: "Bob", age: 25, active: false }
    println(describe(p1))
    println(describe(p2))
    
    // Test copy
    let p3 = p1
    println(describe(p3))
    println(describe(p1))
}
