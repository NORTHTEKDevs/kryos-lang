// Test 42: Deep recursion (stack overflow test)
fn recurse(n: i64) -> i64 {
    if n <= 0 {
        return 0
    }
    return recurse(n - 1) + 1
}

fn main() {
    // Try moderate depth first
    println(recurse(1000))

    // Try deeper
    println(recurse(10000))

    // Try very deep (may stack overflow)
    println(recurse(100000))
}
