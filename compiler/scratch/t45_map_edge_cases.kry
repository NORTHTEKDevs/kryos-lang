// Test 45: Map edge cases
fn main() {
    // Empty map
    let empty = {}
    println(len(empty))

    // Map with various operations
    let mut m = {"a": 1, "b": 2, "c": 3}
    println(len(m))     // should be 3
    println(m["a"])     // should be 1
    println(m["c"])     // should be 3

    // Access non-existent key
    // println(m["z"])  // what happens?

    // Overwrite a key
    m["a"] = 99
    println(m["a"])     // should be 99
}
