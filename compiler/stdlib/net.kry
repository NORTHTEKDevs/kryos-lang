// ============================================================
// std.net -- TCP networking and simple HTTP client
//
// Wraps the kryos-stdlib-native FFI layer for TCP streams and
// listeners.  Provides a minimal HTTP/1.1 client built on raw
// TCP sockets.
// ============================================================

// --- Native FFI declarations ------------------------------------------------

// All raw pointers are passed as i64 (handles/addresses) across the FFI.
extern {
    fn kryos_tcp_connect(host_ptr: i64, host_len: i64, port: i32) -> i64
    fn kryos_tcp_bind(host_ptr: i64, host_len: i64, port: i32) -> i64
    fn kryos_tcp_accept(listener_fd: i64) -> i64
    fn kryos_tcp_send(fd: i64, data: i64, len: i64) -> i64
    fn kryos_tcp_recv(fd: i64, buf: i64, buf_len: i64) -> i64
    fn kryos_socket_close(fd: i64) -> i32
    // TLS (HTTPS)
    fn kryos_tls_connect(host_ptr: i64, host_len: i64, port: i32) -> i64
    fn kryos_tls_send(fd: i64, data: i64, len: i64) -> i64
    fn kryos_tls_recv(fd: i64, buf: i64, buf_len: i64) -> i64
    fn kryos_tls_close(fd: i64) -> i32
}

// --- TCP Stream -------------------------------------------------------------

struct TcpStream {
    fd: i64,
    host: str,
    port: i32,
    closed: bool
}

impl TcpStream {
    // Send data over the stream.  Returns the number of bytes sent.
    // (Method name `write` avoids the reserved channel keyword `send`.)
    @capabilities(net)
    fn write(self: TcpStream, data: str) -> i64 {
        if self.closed {
            throw "net error: write on closed stream"
        }
        let ptr = str_to_ptr(data)
        let n = kryos_tcp_send(self.fd, ptr, len(data))
        if n < 0 {
            throw "net error: write failed on " + self.host + ":" + to_string(self.port)
        }
        return n
    }

    // Send all data, retrying until everything is written.
    @capabilities(net)
    fn write_all(self: TcpStream, data: str) -> i64 {
        if self.closed {
            throw "net error: write_all on closed stream"
        }
        let total_len = len(data)
        let mut offset = 0
        while offset < total_len {
            let remaining = substr(data, offset, total_len)
            let ptr = str_to_ptr(remaining)
            let n = kryos_tcp_send(self.fd, ptr, len(remaining))
            if n < 0 {
                throw "net error: write_all failed on " + self.host + ":" + to_string(self.port)
            }
            offset = offset + n
        }
        return total_len
    }

    // Receive up to `max_bytes` from the stream.
    // (Method name `read` avoids the reserved channel keyword `recv`.)
    @capabilities(net)
    fn read(self: TcpStream, max_bytes: i64) -> str {
        if self.closed {
            throw "net error: read on closed stream"
        }
        let buf = alloc(max_bytes)
        let n = kryos_tcp_recv(self.fd, buf, max_bytes)
        if n < 0 {
            throw "net error: read failed on " + self.host + ":" + to_string(self.port)
        }
        return buf_to_str(buf, n)
    }

    // Receive all data until the connection closes (EOF).
    @capabilities(net)
    fn read_all(self: TcpStream) -> str {
        if self.closed {
            throw "net error: recv_all on closed stream"
        }
        let mut result = ""
        let chunk_size = 8192
        let buf = alloc(chunk_size)
        let mut done = false
        while not done {
            let n = kryos_tcp_recv(self.fd, buf, chunk_size)
            if n < 0 {
                throw "net error: recv_all failed"
            }
            if n == 0 {
                done = true
            } else {
                result = result + buf_to_str(buf, n)
            }
        }
        return result
    }

    // Close the stream.
    @capabilities(net)
    fn close(self: TcpStream) -> TcpStream {
        if not self.closed {
            kryos_socket_close(self.fd)
        }
        return TcpStream { fd: self.fd, host: self.host, port: self.port, closed: true }
    }

    // Check if the stream is open.
    fn is_open(self: TcpStream) -> bool {
        return not self.closed
    }
}

// Connect to a TCP server at host:port.
@capabilities(net)
fn connect(host: str, port: i32) -> TcpStream {
    let fd = kryos_tcp_connect(str_to_ptr(host), len(host), port)
    if fd < 0 {
        throw "net error: could not connect to " + host + ":" + to_string(port)
    }
    return TcpStream { fd: fd, host: host, port: port, closed: false }
}

// --- TCP Listener -----------------------------------------------------------

struct TcpListener {
    fd: i64,
    host: str,
    port: i32,
    closed: bool
}

impl TcpListener {
    // Accept a single incoming connection.  Blocks until a client connects.
    @capabilities(net)
    fn accept(self: TcpListener) -> TcpStream {
        if self.closed {
            throw "net error: accept on closed listener"
        }
        let client_fd = kryos_tcp_accept(self.fd)
        if client_fd < 0 {
            throw "net error: accept failed on " + self.host + ":" + to_string(self.port)
        }
        return TcpStream {
            fd: client_fd,
            host: self.host,
            port: self.port,
            closed: false
        }
    }

    // Close the listener.
    @capabilities(net)
    fn close(self: TcpListener) -> TcpListener {
        if not self.closed {
            kryos_socket_close(self.fd)
        }
        return TcpListener { fd: self.fd, host: self.host, port: self.port, closed: true }
    }

    // Check if the listener is open.
    fn is_open(self: TcpListener) -> bool {
        return not self.closed
    }
}

// Bind a TCP listener to host:port.
@capabilities(net)
fn bind(host: str, port: i32) -> TcpListener {
    let fd = kryos_tcp_bind(str_to_ptr(host), len(host), port)
    if fd < 0 {
        throw "net error: could not bind to " + host + ":" + to_string(port)
    }
    return TcpListener { fd: fd, host: host, port: port, closed: false }
}

// Convenience: bind and return a listener (alias).
@capabilities(net)
fn net_listen(host: str, port: i32) -> TcpListener {
    return bind(host, port)
}

// --- TLS Stream -------------------------------------------------------------

struct TlsStream {
    fd: i64,
    host: str,
    port: i32,
    closed: bool
}

impl TlsStream {
    @capabilities(net)
    fn write_all(self: TlsStream, data: str) -> i64 {
        if self.closed {
            throw "net error: write_all on closed TLS stream"
        }
        let total_len = len(data)
        let mut offset = 0
        while offset < total_len {
            let remaining = substr(data, offset, total_len)
            let n = kryos_tls_send(self.fd, str_to_ptr(remaining), len(remaining))
            if n < 0 {
                throw "net error: TLS write failed on " + self.host + ":" + to_string(self.port)
            }
            offset = offset + n
        }
        return total_len
    }

    @capabilities(net)
    fn read_all(self: TlsStream) -> str {
        if self.closed {
            throw "net error: recv_all on closed TLS stream"
        }
        let mut result = ""
        let chunk_size = 8192
        let buf = alloc(chunk_size)
        let mut done = false
        while not done {
            let n = kryos_tls_recv(self.fd, buf, chunk_size)
            if n < 0 {
                throw "net error: TLS recv failed"
            }
            if n == 0 {
                done = true
            } else {
                result = result + buf_to_str(buf, n)
            }
        }
        return result
    }

    // Read up to `max_bytes` once and return what arrived (does NOT loop to
    // EOF). Needed for request/response line protocols (SMTP, IMAP, POP3)
    // where the peer keeps the connection open between exchanges.
    @capabilities(net)
    fn read_chunk(self: TlsStream, max_bytes: i64) -> str {
        if self.closed {
            throw "net error: read_chunk on closed TLS stream"
        }
        let buf = alloc(max_bytes)
        let n = kryos_tls_recv(self.fd, buf, max_bytes)
        if n <= 0 {
            return ""
        }
        return buf_to_str(buf, n)
    }

    @capabilities(net)
    fn close(self: TlsStream) -> TlsStream {
        if not self.closed {
            kryos_tls_close(self.fd)
        }
        return TlsStream { fd: self.fd, host: self.host, port: self.port, closed: true }
    }
}

// Connect to a TLS (HTTPS) server at host:port.
@capabilities(net)
fn connect_tls(host: str, port: i32) -> TlsStream {
    let fd = kryos_tls_connect(str_to_ptr(host), len(host), port)
    if fd < 0 {
        throw "net error: could not establish TLS connection to " + host + ":" + to_string(port)
    }
    return TlsStream { fd: fd, host: host, port: port, closed: false }
}

// --- HTTP types -------------------------------------------------------------

struct HttpResponse {
    status_code: i32,
    status_text: str,
    headers: str,
    body: str,
    raw: str
}

// --- HTTP response parsing --------------------------------------------------

// Parse a raw HTTP/1.x response string into an HttpResponse struct.
/// Parse leading digits of `s` as an i64, 0 if the code is empty/non-numeric.
/// A raw `int(code_str)` on a non-canonical status code from the network
/// panics uncatchably and hard-crashes the whole process.
fn _safe_status_code(s: str) -> i64 {
    let n = len(s)
    let mut i = 0
    let mut val = 0
    while i < n {
        let ch = substr(s, i, i + 1)
        if not contains("0123456789", ch) {
            return val
        }
        val = val * 10 + int(ch)
        i = i + 1
    }
    return val
}

fn parse_http_response(raw: str) -> HttpResponse {
    let raw_len = len(raw)

    // Find end of status line (\r\n)
    let mut status_end = 0
    let mut i = 0
    while i < raw_len - 1 {
        if raw[i] == "\r" and raw[i + 1] == "\n" {
            status_end = i
            i = raw_len  // break
        } else {
            i = i + 1
        }
    }

    let status_line = substr(raw, 0, status_end)

    // Parse status code from "HTTP/1.x NNN reason"
    // Find first space
    let mut space1 = 0
    i = 0
    while i < len(status_line) {
        if status_line[i] == " " {
            space1 = i
            i = len(status_line)
        } else {
            i = i + 1
        }
    }

    // Find second space
    let mut space2 = len(status_line)
    i = space1 + 1
    while i < len(status_line) {
        if status_line[i] == " " {
            space2 = i
            i = len(status_line)
        } else {
            i = i + 1
        }
    }

    let code_str = substr(status_line, space1 + 1, space2)
    let status_code = _safe_status_code(code_str)
    // No second space (a garbled/reason-less status line) leaves space2 at
    // len(status_line); substr(space2 + 1, len) would slice out of bounds.
    let mut status_text = ""
    if space2 + 1 <= len(status_line) {
        status_text = substr(status_line, space2 + 1, len(status_line))
    }

    // Find header/body separator (\r\n\r\n)
    let mut body_start = raw_len
    let mut headers_end = status_end + 2
    i = status_end + 2
    while i < raw_len - 3 {
        if raw[i] == "\r" and raw[i + 1] == "\n" and raw[i + 2] == "\r" and raw[i + 3] == "\n" {
            headers_end = i
            body_start = i + 4
            i = raw_len
        } else {
            i = i + 1
        }
    }

    let headers = substr(raw, status_end + 2, headers_end)
    let body = substr(raw, body_start, raw_len)

    return HttpResponse {
        status_code: status_code,
        status_text: status_text,
        headers: headers,
        body: body,
        raw: raw
    }
}

// --- HTTP client helpers ----------------------------------------------------

// Parse a URL into host, port, path, and scheme.
// Returns [host, port, path, scheme] where scheme is "http" or "https".
fn parse_url(url: str) -> [str] {
    let url_len = len(url)

    // Strip scheme; record it for TLS routing
    let mut start = 0
    let mut scheme = "http"
    let mut default_port = "80"
    if url_len > 8 and substr(url, 0, 8) == "https://" {
        start = 8
        scheme = "https"
        default_port = "443"
    } else if url_len > 7 and substr(url, 0, 7) == "http://" {
        start = 7
    }

    // Find path separator
    let mut path_start = url_len
    let mut i = start
    while i < url_len {
        if url[i] == "/" {
            path_start = i
            i = url_len
        } else {
            i = i + 1
        }
    }

    let host_port = substr(url, start, path_start)
    let path = if path_start < url_len {
        substr(url, path_start, url_len)
    } else {
        "/"
    }

    // Check for explicit port in host
    let hp_len = len(host_port)
    let mut colon_pos = -1
    i = 0
    while i < hp_len {
        if host_port[i] == ":" {
            colon_pos = i
            i = hp_len
        } else {
            i = i + 1
        }
    }

    if colon_pos >= 0 {
        let host = substr(host_port, 0, colon_pos)
        let port = substr(host_port, colon_pos + 1, hp_len)
        return [host, port, path, scheme]
    }

    return [host_port, default_port, path, scheme]
}

// Perform an HTTP GET request.  Supports both http:// and https://.
@capabilities(net)
fn http_get(url: str) -> HttpResponse {
    let parts = parse_url(url)
    let host = parts[0]
    let port = int(parts[1])
    let path = parts[2]
    let scheme = parts[3]

    let request = "GET " + path + " HTTP/1.1\r\n" +
                  "Host: " + host + "\r\n" +
                  "Connection: close\r\n" +
                  "User-Agent: Kryos/0.1\r\n" +
                  "\r\n"

    if scheme == "https" {
        let tls = connect_tls(host, port)
        tls.write_all(request)
        let raw = tls.read_all()
        tls.close()
        return parse_http_response(raw)
    }

    let stream = connect(host, port)
    stream.write_all(request)
    let raw = stream.read_all()
    stream.close()

    return parse_http_response(raw)
}

// Perform an HTTP POST request with a body.  Supports both http:// and https://.
@capabilities(net)
fn http_post(url: str, body: str, content_type: str) -> HttpResponse {
    let parts = parse_url(url)
    let host = parts[0]
    let port = int(parts[1])
    let path = parts[2]
    let scheme = parts[3]

    let body_len = to_string(len(body))
    let request = "POST " + path + " HTTP/1.1\r\n" +
                  "Host: " + host + "\r\n" +
                  "Connection: close\r\n" +
                  "Content-Type: " + content_type + "\r\n" +
                  "Content-Length: " + body_len + "\r\n" +
                  "User-Agent: Kryos/0.1\r\n" +
                  "\r\n" +
                  body

    if scheme == "https" {
        let tls = connect_tls(host, port)
        tls.write_all(request)
        let raw = tls.read_all()
        tls.close()
        return parse_http_response(raw)
    }

    let stream = connect(host, port)
    stream.write_all(request)
    let raw = stream.read_all()
    stream.close()

    return parse_http_response(raw)
}

// Convenience: HTTP POST with JSON body.
@capabilities(net)
fn http_post_json(url: str, json_body: str) -> HttpResponse {
    return http_post(url, json_body, "application/json")
}
