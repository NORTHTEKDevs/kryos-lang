// ============================================================
// std.collections -- Generic data structures
//
// List<T>, Set<T>, Dict<K, V>, Stack<T>, Queue<T>, Deque<T>,
// implemented in pure Kryos with arrays and maps as backing
// storage. These use REAL Kryos generics (generic structs +
// parametric `impl<T>`), not the old fake `any` element type.
//
//   use std::collections::{List}
//   let mut xs: List<i64> = List.new()
//   xs = xs.push(1)
//   xs = xs.push(2)
//   println(to_string(xs.len()))   // 2
//
// ------------------------------------------------------------
// What works cleanly, and the i64-erasure limits (be honest):
//
// Generic payload slots are i64-sized and impl-method bodies are
// lowered ONCE with the type parameter erased to i64 (see the
// language reference / CLAUDE.md gotcha #17). Consequences:
//
//   * List<i64>, Stack<i64>, Queue<i64>, Deque<i64>, Set<i64>,
//     and Dict<str, i64> work fully on BOTH backends (kryos run
//     and kryos build --release). These are verified.
//
//   * The element/value type that works cleanly is i64. Because
//     the parametric impl erases the type parameter to i64, the
//     type checker treats every `T`-typed method parameter as i64,
//     so a non-i64 ELEMENT instantiation does NOT type-check:
//     `let xs: List<str> = List.new(); xs.push("a")` is rejected
//     with "expected i64, found str". Supporting str/f64/struct
//     elements would require a concrete per-type impl (the gotcha
//     #17 path, e.g. `impl List<str> { .. }`), which this module
//     does not ship. Membership/equality (`contains`, `index_of`)
//     likewise compares the i64 slot.
//
//   * Set<T> dedups by `to_string(value)`; with i64 elements this
//     is content-based and correct. (Same non-i64 element caveat
//     as List.)
//
//   * Dict is STRING-KEYED, value-generic. The methods take `str`
//     keys so the runtime uses content-based string hashing, which
//     is why Dict<str, i64> works. The first parameter `K` is
//     nominal -- always instantiate as Dict<str, V>; a non-str key
//     would select the integer-keyed map ABI and hash the pointer.
//     The value type V works for V = i64; a non-i64 V is subject to
//     the i64-erasure caveat above.
//
// Mutation model: the "remove" family (pop/dequeue/pop_front/
// pop_back) returns the removed VALUE and mutates the backing
// store in place. In-place mutation of a by-value struct param is
// visible to the caller on the Cranelift JIT (aliasing) but not on
// the LLVM AOT byval copy -- this is the language-wide value-
// semantics caveat. For a guaranteed new, shorter collection use
// the functional builders that return a new value (push/insert/
// remove/slice/from). The collections are designed to be threaded
// functionally: `xs = xs.push(v)`.
// ============================================================

// =========================================================================
// List<T> -- dynamic array
// =========================================================================

struct List<T> {
    data: [T],
    length: i64
}

impl<T> List<T> {
    /// Create an empty list.
    fn new() -> List<T> {
        let d: [T] = []
        return List { data: d, length: 0 }
    }

    /// Create a list from an existing array (copied).
    fn from(arr: [T]) -> List<T> {
        let mut d: [T] = []
        let alen = len(arr)
        let mut i = 0
        while i < alen {
            d = push(d, arr[i])
            i = i + 1
        }
        return List { data: d, length: alen }
    }

    /// Append a value to the end, returning the new list.
    fn push(self: List<T>, val: T) -> List<T> {
        let nd = push(self.data, val)
        return List { data: nd, length: self.length + 1 }
    }

    /// Remove and return the last element. Throws if empty.
    /// (See module note on the in-place mutation model.)
    fn pop(self: List<T>) -> T {
        if self.length == 0 {
            throw "List.pop: empty list"
        }
        let mut d = self.data
        return pop(d)
    }

    /// Get the element at index. Throws if out of bounds.
    fn get(self: List<T>, index: i64) -> T {
        if index < 0 or index >= self.length {
            throw "List.get: index out of bounds"
        }
        return self.data[index]
    }

    /// Set the element at index, returning the new list. Throws if OOB.
    fn set(self: List<T>, index: i64, val: T) -> List<T> {
        if index < 0 or index >= self.length {
            throw "List.set: index out of bounds"
        }
        self.data[index] = val
        return List { data: self.data, length: self.length }
    }

    /// Number of elements.
    fn len(self: List<T>) -> i64 {
        return self.length
    }

    /// True if the list has no elements.
    fn is_empty(self: List<T>) -> bool {
        return self.length == 0
    }

    /// True if the list contains the given value (i64-slot equality;
    /// pointer identity for non-i64 element types).
    fn contains(self: List<T>, val: T) -> bool {
        let mut i = 0
        while i < self.length {
            if self.data[i] == val {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// First index of a value, or -1.
    fn index_of(self: List<T>, val: T) -> i64 {
        let mut i = 0
        while i < self.length {
            if self.data[i] == val {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// Insert a value at index, shifting elements right. Returns a new list.
    fn insert(self: List<T>, index: i64, val: T) -> List<T> {
        if index < 0 or index > self.length {
            throw "List.insert: index out of bounds"
        }
        let mut nd: [T] = []
        let mut i = 0
        while i < index {
            nd = push(nd, self.data[i])
            i = i + 1
        }
        nd = push(nd, val)
        while i < self.length {
            nd = push(nd, self.data[i])
            i = i + 1
        }
        return List { data: nd, length: self.length + 1 }
    }

    /// Remove the element at index, shifting elements left. Returns a new list.
    fn remove(self: List<T>, index: i64) -> List<T> {
        if index < 0 or index >= self.length {
            throw "List.remove: index out of bounds"
        }
        let mut nd: [T] = []
        let mut i = 0
        while i < self.length {
            if i != index {
                nd = push(nd, self.data[i])
            }
            i = i + 1
        }
        return List { data: nd, length: self.length - 1 }
    }

    /// Sub-list from start (inclusive) to end (exclusive). Returns a new list.
    fn slice(self: List<T>, start: i64, end: i64) -> List<T> {
        let mut a = start
        let mut b = end
        if a < 0 { a = 0 }
        if b > self.length { b = self.length }
        if a >= b {
            return List.new()
        }
        let mut nd: [T] = []
        let mut i = a
        while i < b {
            nd = push(nd, self.data[i])
            i = i + 1
        }
        return List { data: nd, length: b - a }
    }

    /// Reverse the list. Returns a new list.
    fn reverse(self: List<T>) -> List<T> {
        let mut nd: [T] = []
        let mut i = self.length - 1
        while i >= 0 {
            nd = push(nd, self.data[i])
            i = i - 1
        }
        return List { data: nd, length: self.length }
    }

    /// Remove all elements. Returns a new empty list.
    fn clear(self: List<T>) -> List<T> {
        return List.new()
    }

    /// The underlying array (for `for x in list.iter()`).
    fn iter(self: List<T>) -> [T] {
        return self.data
    }

    /// Display string, e.g. `[1, 2, 3]`.
    fn to_string(self: List<T>) -> str {
        let mut result = "["
        let mut i = 0
        while i < self.length {
            if i > 0 {
                result = result + ", "
            }
            result = result + to_string(self.data[i])
            i = i + 1
        }
        return result + "]"
    }
}

// =========================================================================
// Set<T> -- unique value collection (dedup by to_string(value))
// =========================================================================

struct Set<T> {
    seen: map<str, bool>,
    items: [T],
    length: i64
}

impl<T> Set<T> {
    /// Create an empty set.
    fn new() -> Set<T> {
        let it: [T] = []
        return Set { seen: {}, items: it, length: 0 }
    }

    /// Create a set from an array (duplicates dropped).
    fn from(arr: [T]) -> Set<T> {
        let mut s: Set<T> = Set.new()
        let alen = len(arr)
        let mut i = 0
        while i < alen {
            s = s.add(arr[i])
            i = i + 1
        }
        return s
    }

    /// Add a value, returning the new set. No-op if already present.
    fn add(self: Set<T>, val: T) -> Set<T> {
        let k = to_string(val)
        if map_has(self.seen, k) {
            return Set { seen: self.seen, items: self.items, length: self.length }
        }
        self.seen[k] = true
        let ni = push(self.items, val)
        return Set { seen: self.seen, items: ni, length: self.length + 1 }
    }

    /// True if the value is in the set.
    fn contains(self: Set<T>, val: T) -> bool {
        return map_has(self.seen, to_string(val))
    }

    /// Alias for `contains`.
    fn has(self: Set<T>, val: T) -> bool {
        return map_has(self.seen, to_string(val))
    }

    /// Number of elements.
    fn len(self: Set<T>) -> i64 {
        return self.length
    }

    /// True if the set has no elements.
    fn is_empty(self: Set<T>) -> bool {
        return self.length == 0
    }

    /// The set's values as an array (insertion order).
    fn to_list(self: Set<T>) -> [T] {
        return self.items
    }

    /// Remove all elements. Returns a new empty set.
    fn clear(self: Set<T>) -> Set<T> {
        return Set.new()
    }

    /// Display string, e.g. `Set{1, 2, 3}`.
    fn to_string(self: Set<T>) -> str {
        let mut result = "Set\{"
        let mut i = 0
        while i < self.length {
            if i > 0 {
                result = result + ", "
            }
            result = result + to_string(self.items[i])
            i = i + 1
        }
        return result + "\}"
    }
}

// =========================================================================
// Dict<K, V> -- string-keyed map with generic value (see module note:
// K is nominal; instantiate as Dict<str, V>).
// =========================================================================

struct Dict<K, V> {
    store: map<str, V>,
    keylist: [str],
    length: i64
}

impl<K, V> Dict<K, V> {
    /// Create an empty dict.
    fn new() -> Dict<K, V> {
        let ks: [str] = []
        return Dict { store: {}, keylist: ks, length: 0 }
    }

    /// Set a key-value pair, returning the new dict.
    fn set(self: Dict<K, V>, key: str, val: V) -> Dict<K, V> {
        let existed = map_has(self.store, key)
        self.store[key] = val
        if not existed {
            let nk = push(self.keylist, key)
            return Dict { store: self.store, keylist: nk, length: self.length + 1 }
        }
        return Dict { store: self.store, keylist: self.keylist, length: self.length }
    }

    /// Get the value for a key. Throws if not present.
    fn get(self: Dict<K, V>, key: str) -> V {
        if not map_has(self.store, key) {
            throw "Dict.get: key not found: " + key
        }
        return self.store[key]
    }

    /// Get the value for a key, or a default.
    fn get_or(self: Dict<K, V>, key: str, default: V) -> V {
        if map_has(self.store, key) {
            return self.store[key]
        }
        return default
    }

    /// True if the key exists.
    fn contains(self: Dict<K, V>, key: str) -> bool {
        return map_has(self.store, key)
    }

    /// Alias for `contains`.
    fn has(self: Dict<K, V>, key: str) -> bool {
        return map_has(self.store, key)
    }

    /// Number of entries.
    fn len(self: Dict<K, V>) -> i64 {
        return self.length
    }

    /// True if the dict has no entries.
    fn is_empty(self: Dict<K, V>) -> bool {
        return self.length == 0
    }

    /// All keys (insertion order).
    fn keys(self: Dict<K, V>) -> [str] {
        return self.keylist
    }

    /// All values, in key-insertion order.
    fn values(self: Dict<K, V>) -> [V] {
        let mut vals: [V] = []
        let klen = len(self.keylist)
        let mut i = 0
        while i < klen {
            vals = push(vals, self.store[self.keylist[i]])
            i = i + 1
        }
        return vals
    }

    /// Remove all entries. Returns a new empty dict.
    fn clear(self: Dict<K, V>) -> Dict<K, V> {
        return Dict.new()
    }

    /// Display string, e.g. `{a: 1, b: 2}`.
    fn to_string(self: Dict<K, V>) -> str {
        let klen = len(self.keylist)
        let mut result = "\{"
        let mut i = 0
        while i < klen {
            if i > 0 {
                result = result + ", "
            }
            let k = self.keylist[i]
            result = result + k + ": " + to_string(self.store[k])
            i = i + 1
        }
        return result + "\}"
    }
}

// =========================================================================
// Stack<T> -- LIFO
// =========================================================================

struct Stack<T> {
    data: [T],
    length: i64
}

impl<T> Stack<T> {
    /// Create an empty stack.
    fn new() -> Stack<T> {
        let d: [T] = []
        return Stack { data: d, length: 0 }
    }

    /// Push a value onto the top, returning the new stack.
    fn push(self: Stack<T>, val: T) -> Stack<T> {
        let nd = push(self.data, val)
        return Stack { data: nd, length: self.length + 1 }
    }

    /// Pop the top value. Throws if empty. (See module note on mutation.)
    fn pop(self: Stack<T>) -> T {
        if self.length == 0 {
            throw "Stack.pop: empty stack"
        }
        let mut d = self.data
        return pop(d)
    }

    /// View the top value without removing it.
    fn peek(self: Stack<T>) -> T {
        if self.length == 0 {
            throw "Stack.peek: empty stack"
        }
        return self.data[self.length - 1]
    }

    /// Number of elements.
    fn len(self: Stack<T>) -> i64 {
        return self.length
    }

    /// True if the stack is empty.
    fn is_empty(self: Stack<T>) -> bool {
        return self.length == 0
    }

    /// Remove all elements. Returns a new empty stack.
    fn clear(self: Stack<T>) -> Stack<T> {
        return Stack.new()
    }
}

// =========================================================================
// Queue<T> -- FIFO
// =========================================================================

struct Queue<T> {
    data: [T],
    length: i64
}

impl<T> Queue<T> {
    /// Create an empty queue.
    fn new() -> Queue<T> {
        let d: [T] = []
        return Queue { data: d, length: 0 }
    }

    /// Add a value to the back, returning the new queue.
    fn enqueue(self: Queue<T>, val: T) -> Queue<T> {
        let nd = push(self.data, val)
        return Queue { data: nd, length: self.length + 1 }
    }

    /// Remove and return the front value. Throws if empty. Returns the
    /// value; for the shortened queue use `drop_front`.
    fn dequeue(self: Queue<T>) -> T {
        if self.length == 0 {
            throw "Queue.dequeue: empty queue"
        }
        return self.data[0]
    }

    /// Return a new queue without its front element. Throws if empty.
    fn drop_front(self: Queue<T>) -> Queue<T> {
        if self.length == 0 {
            throw "Queue.drop_front: empty queue"
        }
        let mut nd: [T] = []
        let mut i = 1
        while i < self.length {
            nd = push(nd, self.data[i])
            i = i + 1
        }
        return Queue { data: nd, length: self.length - 1 }
    }

    /// View the front value without removing it.
    fn peek(self: Queue<T>) -> T {
        if self.length == 0 {
            throw "Queue.peek: empty queue"
        }
        return self.data[0]
    }

    /// Number of elements.
    fn len(self: Queue<T>) -> i64 {
        return self.length
    }

    /// True if the queue is empty.
    fn is_empty(self: Queue<T>) -> bool {
        return self.length == 0
    }

    /// Remove all elements. Returns a new empty queue.
    fn clear(self: Queue<T>) -> Queue<T> {
        return Queue.new()
    }
}

// =========================================================================
// Deque<T> -- double-ended queue
// =========================================================================

struct Deque<T> {
    data: [T],
    length: i64
}

impl<T> Deque<T> {
    /// Create an empty deque.
    fn new() -> Deque<T> {
        let d: [T] = []
        return Deque { data: d, length: 0 }
    }

    /// Add a value to the front, returning the new deque.
    fn push_front(self: Deque<T>, val: T) -> Deque<T> {
        let mut nd: [T] = []
        nd = push(nd, val)
        let mut i = 0
        while i < self.length {
            nd = push(nd, self.data[i])
            i = i + 1
        }
        return Deque { data: nd, length: self.length + 1 }
    }

    /// Add a value to the back, returning the new deque.
    fn push_back(self: Deque<T>, val: T) -> Deque<T> {
        let nd = push(self.data, val)
        return Deque { data: nd, length: self.length + 1 }
    }

    /// Return a new deque without its front element. Throws if empty.
    fn drop_front(self: Deque<T>) -> Deque<T> {
        if self.length == 0 {
            throw "Deque.drop_front: empty deque"
        }
        let mut nd: [T] = []
        let mut i = 1
        while i < self.length {
            nd = push(nd, self.data[i])
            i = i + 1
        }
        return Deque { data: nd, length: self.length - 1 }
    }

    /// Return a new deque without its back element. Throws if empty.
    fn drop_back(self: Deque<T>) -> Deque<T> {
        if self.length == 0 {
            throw "Deque.drop_back: empty deque"
        }
        let mut nd: [T] = []
        let mut i = 0
        while i < self.length - 1 {
            nd = push(nd, self.data[i])
            i = i + 1
        }
        return Deque { data: nd, length: self.length - 1 }
    }

    /// View the front value.
    fn front(self: Deque<T>) -> T {
        if self.length == 0 {
            throw "Deque.front: empty deque"
        }
        return self.data[0]
    }

    /// View the back value.
    fn back(self: Deque<T>) -> T {
        if self.length == 0 {
            throw "Deque.back: empty deque"
        }
        return self.data[self.length - 1]
    }

    /// Number of elements.
    fn len(self: Deque<T>) -> i64 {
        return self.length
    }

    /// True if the deque is empty.
    fn is_empty(self: Deque<T>) -> bool {
        return self.length == 0
    }

    /// Remove all elements. Returns a new empty deque.
    fn clear(self: Deque<T>) -> Deque<T> {
        return Deque.new()
    }
}
