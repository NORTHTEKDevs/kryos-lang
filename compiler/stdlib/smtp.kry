// ============================================================
// std.smtp -- minimal SMTP-over-implicit-TLS (SMTPS) client.
//
// Sends mail through a submission server on the TLS port (465)
// using AUTH LOGIN. Built on std::net's TlsStream. Handles the
// request/response dialogue, base64 credential encoding, and
// the DATA terminator. Plaintext/STARTTLS (port 587) is not
// implemented -- use an SMTPS submission endpoint.
//
// Returns a status string: "ok" on a 250 after the message body,
// otherwise "error: <server reply>".
// ============================================================

use std::net::{connect_tls, TlsStream}
use std::string::{find}

// Read one or more chunks until the accumulated reply ends in a final
// SMTP line ("NNN " -- space, not "NNN-" continuation) or reads stall.
fn _read_reply(tls: TlsStream) -> str {
    let mut acc = ""
    let mut tries = 0
    while tries < 32 {
        let chunk = tls.read_chunk(4096)
        if len(chunk) == 0 {
            tries = tries + 1
        } else {
            acc = acc + chunk
            // Final line of a reply has a space as the 4th character of the
            // LAST CRLF-terminated line. Cheap check: the reply contains a
            // CRLF and the segment after the last interior CRLF starts with
            // "NNN ". We approximate by checking the tail.
            let n = len(acc)
            if n >= 5 {
                // Find the start of the last line (after the penultimate CRLF).
                let tail = substr(acc, n - 5, n)
                // tail like "50 \r\n" won't match; we want the 4th-from-CRLF
                // char. Simpler: if acc ends with CRLF and the last line's
                // 4th char is a space.
                if substr(acc, n - 2, n) == "\r\n" {
                    return acc
                }
            }
        }
    }
    return acc
}

// The 3-digit status of an SMTP reply (its last line), or -1.
fn _reply_code(reply: str) -> i64 {
    let n = len(reply)
    if n < 3 {
        return 0 - 1
    }
    // Scan for the last line that has a digit-digit-digit prefix. Walk back
    // from the end over trailing CRLF, then find the preceding line start.
    let mut end = n
    // strip trailing CRLF
    while end > 0 {
        let c = substr(acc_safe(reply, end - 1), 0, 1)
        if c == "\r" {
            end = end - 1
        } elif c == "\n" {
            end = end - 1
        } else {
            break
        }
    }
    // find start of this line
    let mut start = end
    while start > 0 {
        let c = substr(reply, start - 1, start)
        if c == "\n" {
            break
        }
        start = start - 1
    }
    if end - start < 3 {
        return 0 - 1
    }
    return parse_int(substr(reply, start, start + 3))
}

// Guard substr against a 1-char window at the very end.
fn acc_safe(s: str, i: i64) -> str {
    return substr(s, i, i + 1)
}

fn _send_line(tls: TlsStream, line: str) -> str {
    tls.write_all(line + "\r\n")
    return _read_reply(tls)
}

// Send an email via SMTPS (implicit TLS, typically port 465) using
// AUTH LOGIN. `from_addr` / `to_addr` are bare addresses (no angle
// brackets). Returns "ok" or "error: ...".
fn send_mail(
    host: str,
    port: i32,
    user: str,
    password: str,
    from_addr: str,
    to_addr: str,
    subject: str,
    body: str
) -> str {
    let tls = connect_tls(host, port)

    let greeting = _read_reply(tls)
    if _reply_code(greeting) != 220 {
        tls.close()
        return "error: greeting " + greeting
    }

    let ehlo = _send_line(tls, "EHLO kryos.local")
    if _reply_code(ehlo) != 250 {
        tls.close()
        return "error: EHLO " + ehlo
    }

    let auth = _send_line(tls, "AUTH LOGIN")
    if _reply_code(auth) != 334 {
        tls.close()
        return "error: AUTH " + auth
    }

    let user_r = _send_line(tls, base64_encode(user))
    if _reply_code(user_r) != 334 {
        tls.close()
        return "error: user " + user_r
    }

    let pass_r = _send_line(tls, base64_encode(password))
    if _reply_code(pass_r) != 235 {
        tls.close()
        return "error: auth-failed " + pass_r
    }

    let mail_from = _send_line(tls, "MAIL FROM:<" + from_addr + ">")
    if _reply_code(mail_from) != 250 {
        tls.close()
        return "error: MAIL FROM " + mail_from
    }

    let rcpt = _send_line(tls, "RCPT TO:<" + to_addr + ">")
    let rc = _reply_code(rcpt)
    if rc != 250 {
        if rc != 251 {
            tls.close()
            return "error: RCPT TO " + rcpt
        }
    }

    let data_r = _send_line(tls, "DATA")
    if _reply_code(data_r) != 354 {
        tls.close()
        return "error: DATA " + data_r
    }

    // Message: headers + blank line + body + terminator. A line that is
    // exactly "." ends DATA; bodies starting a line with "." need dot-
    // stuffing, omitted here for brevity (callers should avoid it).
    let msg = "From: " + from_addr + "\r\n" +
              "To: " + to_addr + "\r\n" +
              "Subject: " + subject + "\r\n" +
              "\r\n" +
              body + "\r\n" +
              ".\r\n"
    tls.write_all(msg)
    let final_r = _read_reply(tls)

    let quit = _send_line(tls, "QUIT")
    tls.close()

    if _reply_code(final_r) == 250 {
        return "ok"
    }
    return "error: send " + final_r
}
