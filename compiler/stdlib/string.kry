// ============================================================
// std.string -- String manipulation functions
//
// All functions operate on immutable Kryos strings.
// Strings are UTF-8 sequences; indexing is byte-based.
//
// Usage: std.string.trim(s), std.string.split(s, ","), etc.
// ============================================================

// --- Query -------------------------------------------------------------------

// NOTE: String length is provided by the builtin len() function.
// This module re-exports it for API completeness. The compiler
// resolves bare len() calls to the builtin, so no wrapper is needed.

/// True if the string has zero length.
fn is_empty(s: str) -> bool {
    return len(s) == 0
}

/// True if haystack contains needle.
fn contains(haystack: str, needle: str) -> bool {
    let result = find(haystack, needle)
    return result >= 0
}

/// True if s begins with prefix.
fn starts_with(s: str, prefix: str) -> bool {
    let plen = len(prefix)
    if plen > len(s) {
        return false
    }
    let mut i = 0
    while i < plen {
        if s[i] != prefix[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/// True if s ends with suffix.
fn ends_with(s: str, suffix: str) -> bool {
    let slen = len(s)
    let xlen = len(suffix)
    if xlen > slen {
        return false
    }
    let offset = slen - xlen
    let mut i = 0
    while i < xlen {
        if s[offset + i] != suffix[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/// Find the first occurrence of needle in haystack.
/// Returns the index, or -1 if not found.
fn find(haystack: str, needle: str) -> i64 {
    let hlen = len(haystack)
    let nlen = len(needle)
    if nlen == 0 {
        return 0
    }
    if nlen > hlen {
        return -1
    }
    let mut i = 0
    let limit = hlen - nlen
    while i <= limit {
        let mut matched = true
        let mut j = 0
        while j < nlen {
            if haystack[i + j] != needle[j] {
                matched = false
                j = nlen
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

/// Find the last occurrence of needle in haystack.
/// Returns the index, or -1 if not found.
fn rfind(haystack: str, needle: str) -> i64 {
    let hlen = len(haystack)
    let nlen = len(needle)
    if nlen == 0 {
        return hlen
    }
    if nlen > hlen {
        return -1
    }
    let mut i = hlen - nlen
    while i >= 0 {
        let mut matched = true
        let mut j = 0
        while j < nlen {
            if haystack[i + j] != needle[j] {
                matched = false
                j = nlen
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i - 1
    }
    return -1
}

// --- Case conversion ---------------------------------------------------------

// Delegate case conversion to the Unicode-aware runtime builtins. The module
// fns shadow the same-named global builtins for importers, so an earlier
// ASCII-only byte-loop here silently DOWNGRADED casing for anyone who wrote
// `use std::string::{to_upper}` ("café" -> "CAFé"). The raw extern reaches
// the builtin under a name the shadow can't capture.
extern {
    fn kryos_builtin_to_upper(s: str) -> str
    fn kryos_builtin_to_lower(s: str) -> str
}

/// Convert every character to uppercase (Unicode-aware, same as the global
/// `to_upper` builtin).
fn to_upper(s: str) -> str {
    return kryos_builtin_to_upper(s)
}

/// Convert every character to lowercase (Unicode-aware, same as the global
/// `to_lower` builtin).
fn to_lower(s: str) -> str {
    return kryos_builtin_to_lower(s)
}

// --- Whitespace helpers ------------------------------------------------------

fn _is_whitespace(ch: str) -> bool {
    return ch == " " or ch == "\t" or ch == "\n" or ch == "\r"
}

/// Remove leading and trailing whitespace.
fn trim(s: str) -> str {
    let slen = len(s)
    if slen == 0 {
        return s
    }
    let mut start = 0
    while start < slen and _is_whitespace(s[start]) {
        start = start + 1
    }
    let mut end = slen - 1
    while end >= start and _is_whitespace(s[end]) {
        end = end - 1
    }
    if start > end {
        return ""
    }
    return substring(s, start, end + 1)
}

/// Remove leading whitespace.
fn trim_start(s: str) -> str {
    let slen = len(s)
    let mut start = 0
    while start < slen and _is_whitespace(s[start]) {
        start = start + 1
    }
    return substring(s, start, slen)
}

/// Remove trailing whitespace.
fn trim_end(s: str) -> str {
    let slen = len(s)
    if slen == 0 {
        return s
    }
    let mut end = slen - 1
    while end >= 0 and _is_whitespace(s[end]) {
        end = end - 1
    }
    return substring(s, 0, end + 1)
}

// --- Splitting and joining ---------------------------------------------------

/// Split s by a delimiter string. Returns an array of substrings.
fn split(s: str, delimiter: str) -> [str] {
    let mut result = []
    let slen = len(s)
    let dlen = len(delimiter)

    if dlen == 0 {
        // Split into individual characters (whole UTF-8 codepoints). Byte-wise
        // `s[i]` split multibyte characters into invalid single-byte fragments,
        // so replace(s, "", x) / split(s, "") corrupted any non-ASCII input.
        let mut i = 0
        while i < slen {
            let b = char_code(substr(s, i, i + 1))
            let mut step = 1
            if b >= 240 {
                step = 4
            } elif b >= 224 {
                step = 3
            } elif b >= 192 {
                step = 2
            }
            result = push(result, substr(s, i, i + step))
            i = i + step
        }
        return result
    }

    let mut start = 0
    let mut i = 0
    while i <= slen - dlen {
        let mut matched = true
        let mut j = 0
        while j < dlen {
            if s[i + j] != delimiter[j] {
                matched = false
                j = dlen
            }
            j = j + 1
        }
        if matched {
            push(result, substring(s, start, i))
            start = i + dlen
            i = start
        } else {
            i = i + 1
        }
    }
    push(result, substring(s, start, slen))
    return result
}

/// Split s into lines on "\n", dropping a trailing "\r" so "\r\n" endings
/// produce clean lines. A trailing newline does not yield an extra empty line.
fn split_lines(s: str) -> [str] {
    let raw = split(s, "\n")
    let mut result = []
    let n = len(raw)
    let mut i = 0
    while i < n {
        let line = raw[i]
        let ll = len(line)
        if ll > 0 && char_code(substr(line, ll - 1, ll)) == 13 {
            push(result, substring(line, 0, ll - 1))
        } else {
            // Drop a final empty segment produced by a trailing "\n".
            if i + 1 < n {
                push(result, line)
            } elif ll > 0 {
                push(result, line)
            }
        }
        i = i + 1
    }
    return result
}

/// Join an array of strings with a separator.
fn join(parts: [str], separator: str) -> str {
    let plen = len(parts)
    if plen == 0 {
        return ""
    }
    let mut result = parts[0]
    let mut i = 1
    while i < plen {
        result = result + separator + parts[i]
        i = i + 1
    }
    return result
}

// --- Replacement -------------------------------------------------------------

/// Replace all occurrences of old_str with new_str.
fn replace(s: str, old_str: str, new_str: str) -> str {
    let parts = split(s, old_str)
    return join(parts, new_str)
}

// --- Repetition --------------------------------------------------------------

/// Repeat a string n times.
fn repeat(s: str, n: i64) -> str {
    if n <= 0 {
        return ""
    }
    let mut result = ""
    let mut i = 0
    while i < n {
        result = result + s
        i = i + 1
    }
    return result
}

// --- Reversal ----------------------------------------------------------------

/// Reverse a string character by character (by Unicode codepoint).
fn reverse(s: str) -> str {
    // Walk UTF-8 codepoint boundaries and prepend each whole codepoint, so
    // multibyte sequences stay intact. The old byte-wise reversal split
    // multibyte characters apart and produced invalid UTF-8 (the runtime
    // then returned the sentinel "<invalid utf-8>") for any non-ASCII input.
    let slen = len(s)
    if slen == 0 {
        return ""
    }
    let mut result = ""
    let mut i = 0
    while i < slen {
        let b = char_code(substr(s, i, i + 1))
        let mut step = 1
        if b >= 240 {
            step = 4
        } elif b >= 224 {
            step = 3
        } elif b >= 192 {
            step = 2
        } elif b >= 128 {
            // Stray continuation byte -> not valid UTF-8; treat as one byte
            // so we never slice mid-sequence into an invalid substring.
            step = 1
        }
        let cp = substr(s, i, i + step)
        result = cp + result
        i = i + step
    }
    return result
}

// --- Character access --------------------------------------------------------

/// Split a string into an array of single characters (whole UTF-8 codepoints).
fn chars(s: str) -> [str] {
    let mut result = []
    let slen = len(s)
    let mut i = 0
    while i < slen {
        let b = char_code(substr(s, i, i + 1))
        let mut step = 1
        if b >= 240 {
            step = 4
        } elif b >= 224 {
            step = 3
        } elif b >= 192 {
            step = 2
        }
        // Byte-wise `s[i]` split multibyte characters into invalid single-byte
        // fragments (café -> 5 elements, é broken in half). Push whole codepoints.
        result = push(result, substr(s, i, i + step))
        i = i + step
    }
    return result
}

/// Get the character (whole UTF-8 codepoint) at codepoint index i, or empty
/// string if out of bounds. Byte-wise `s[i]` returned an invalid fragment for
/// any index landing inside a multibyte character.
fn char_at(s: str, i: i64) -> str {
    if i < 0 {
        return ""
    }
    let slen = len(s)
    let mut bytepos = 0
    let mut cp = 0
    while bytepos < slen {
        let b = char_code(substr(s, bytepos, bytepos + 1))
        let mut step = 1
        if b >= 240 {
            step = 4
        } elif b >= 224 {
            step = 3
        } elif b >= 192 {
            step = 2
        }
        if cp == i {
            return substr(s, bytepos, bytepos + step)
        }
        cp = cp + 1
        bytepos = bytepos + step
    }
    return ""
}

/// Extract a substring from start (inclusive) to end (exclusive).
fn substring(s: str, start: i64, end: i64) -> str {
    let slen = len(s)
    let mut a = start
    let mut b = end
    if a < 0 {
        a = 0
    }
    if b > slen {
        b = slen
    }
    if a >= b {
        return ""
    }
    return substr(s, a, b)
}

// --- Padding -----------------------------------------------------------------

/// Pad a string on the left to reach the target width.
fn pad_left(s: str, width: i64, fill: str) -> str {
    let slen = len(s)
    if slen >= width {
        return s
    }
    return _str_pad_build(width - slen, fill) + s
}

/// Pad a string on the right to reach the target width.
fn pad_right(s: str, width: i64, fill: str) -> str {
    let slen = len(s)
    if slen >= width {
        return s
    }
    return s + _str_pad_build(width - slen, fill)
}

/// Build a pad of at least `target_bytes` from the fill string, repeating the
/// WHOLE fill char. The old pad functions used only `char_code(fill[0])` (the
/// first BYTE), so a multi-byte UTF-8 fill wrote invalid bytes -> the runtime
/// substituted "<invalid utf-8>". Single-byte fill -> exact width; multi-byte
/// fill -> whole chars (may overshoot by < len(fill), never a sliced char).
fn _str_pad_build(target_bytes: i64, fill: str) -> str {
    let ff = if len(fill) > 0 { fill } else { " " }
    let mut pad = ""
    while len(pad) < target_bytes {
        pad = pad + ff
    }
    if len(ff) == 1 {
        return substr(pad, 0, target_bytes)
    }
    return pad
}

// --- Formatting --------------------------------------------------------------

/// Simple template formatting. Replaces {0}, {1}, ... with positional args.
fn format(template: str, args: [str]) -> str {
    // Single-pass scan of the template: each {N} placeholder is replaced with
    // args[N] emitted DIRECTLY into the output, so substituted text is never
    // re-scanned. The old approach ran replace() sequentially over the SAME
    // growing accumulator, so an argument whose text happened to contain a
    // later placeholder (e.g. arg[0] == "{1}") got re-substituted on the next
    // iteration -- format("{0}{1}", ["{1}", "X"]) wrongly produced "XX".
    let argc = len(args)
    let n = len(template)
    let mut out = ""
    let mut i = 0
    while i < n {
        let ch = substr(template, i, i + 1)
        if ch == "{" {
            let mut j = i + 1
            let mut idx = 0
            let mut had_digit = false
            while j < n and char_code(substr(template, j, j + 1)) >= 48 and char_code(substr(template, j, j + 1)) <= 57 {
                idx = idx * 10 + (char_code(substr(template, j, j + 1)) - 48)
                had_digit = true
                j = j + 1
            }
            if had_digit and j < n and substr(template, j, j + 1) == "}" {
                if idx < argc {
                    out = out + args[idx]
                } else {
                    // Placeholder index out of range: keep it literal.
                    out = out + substr(template, i, j + 1)
                }
                i = j + 1
            } else {
                out = out + ch
                i = i + 1
            }
        } else {
            out = out + ch
            i = i + 1
        }
    }
    return out
}

// --- StringBuilder -----------------------------------------------------------
// Amortized-O(1) string building. Repeated `s = s + chunk` in a loop is
// O(n^2) (each concat reallocates and copies the whole accumulator), so
// building a multi-MB string that way is quadratic. A StringBuilder appends
// into a growable byte buffer (amortized-O(1)) and materializes the string
// once at the end -- ~hundreds of times faster for large builds.
//
//     let sb = string_builder()
//     let mut i = 0
//     while i < n {
//         sb.append("chunk")
//         i = i + 1
//     }
//     let result = sb.build()   // consumes the builder (frees the buffer)
//
// `append` mutates the shared buffer and returns self, so calls chain:
// `sb.append("a").append("b")`. Call `build()` exactly once; the builder is
// invalid afterward (its buffer is freed).

struct StringBuilder {
    // A heap CELL (8 bytes) holding the actual KryosBuf handle -- one level of
    // indirection so `build()` can null the SHARED handle. Struct methods take
    // `self` by value, so writing `self.buf = 0` would not reach the caller's
    // builder; writing THROUGH the shared cell pointer does. This makes a
    // second `build()` a safe no-op (it sees the nulled handle and returns "")
    // instead of a use-after-free of the already-freed buffer (which
    // segfaulted). The buffer itself is still freed on the first build; only
    // the 8-byte cell is not reclaimed (Kryos has no auto-drop for structs) --
    // a small, bounded leak per builder, traded for eliminating the segfault.
    cell: i64
}

fn string_builder() -> StringBuilder {
    let c = alloc(8)
    ptr_write_i64(c, 0, buf_new(0))
    return StringBuilder { cell: c }
}

impl StringBuilder {
    /// Append a string chunk. Returns self for chaining.
    fn append(self: StringBuilder, s: str) -> StringBuilder {
        let b = ptr_read_i64(self.cell, 0)
        if b != 0 {
            buf_write_str(b, s)
        }
        return self
    }

    /// Append a chunk followed by a newline. Returns self for chaining.
    fn append_line(self: StringBuilder, s: str) -> StringBuilder {
        let b = ptr_read_i64(self.cell, 0)
        if b != 0 {
            buf_write_str(b, s)
            buf_write_str(b, "\n")
        }
        return self
    }

    /// Current byte length of the accumulated content.
    fn len(self: StringBuilder) -> i64 {
        let b = ptr_read_i64(self.cell, 0)
        if b == 0 {
            return 0
        }
        return buf_len(b)
    }

    /// Materialize the accumulated string and free the builder's buffer.
    /// Idempotent: a second call safely returns "" (the builder is empty
    /// after the first build), rather than a use-after-free.
    fn build(self: StringBuilder) -> str {
        let b = ptr_read_i64(self.cell, 0)
        if b == 0 {
            return ""
        }
        let out = buf_str(b)
        buf_free(b)
        ptr_write_i64(self.cell, 0, 0)
        return out
    }
}
