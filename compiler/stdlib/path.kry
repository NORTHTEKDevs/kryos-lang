// ============================================================
// std.path -- Path manipulation utilities
//
// Pure Kryos implementation for working with filesystem paths.
// Handles both Unix (/) and Windows (\) path separators.
// Does not perform any I/O -- all functions operate on strings.
//
// Usage:
//   let p = std.path.join(["usr", "local", "bin"])
//   let dir = std.path.dirname("/home/user/file.txt")
//   let ext = std.path.extname("archive.tar.gz")
// ============================================================

// --- Constants ---------------------------------------------------------------

/// The platform path separator.  Kryos normalizes to "/" internally,
/// but this constant reflects the OS convention for display purposes.
let PATH_SEP = "/"

/// Windows-style separator, recognized during parsing.
let WIN_SEP = "\\"

// --- Core operations ---------------------------------------------------------

/// Join an array of path segments with the path separator.
/// Empty segments are ignored.  Normalizes the result.
fn join(parts: [str]) -> str {
    let count = len(parts)
    if count == 0 {
        return "."
    }

    let mut result = ""
    let mut i = 0
    while i < count {
        let part = parts[i]
        if len(part) > 0 {
            if len(result) == 0 {
                result = part
            } else {
                // Only add separator if result doesn't end with one
                // and part doesn't start with one
                let last = result[len(result) - 1]
                let first = part[0]
                if last == "/" or last == "\\" or first == "/" or first == "\\" {
                    result = result + part
                } else {
                    result = result + PATH_SEP + part
                }
            }
        }
        i = i + 1
    }

    if len(result) == 0 {
        return "."
    }

    return normalize(result)
}

/// Get the directory portion of a path.
/// dirname("/home/user/file.txt") -> "/home/user"
/// dirname("file.txt") -> "."
fn dirname(p: str) -> str {
    let normalized = _to_forward_slashes(p)
    let plen = len(normalized)
    if plen == 0 {
        return "."
    }

    // Find the last separator
    let mut last_sep = -1
    let mut i = plen - 1

    // Skip trailing separators (unless the path is just "/")
    while i > 0 and normalized[i] == "/" {
        i = i - 1
    }

    // Find the separator before the last component
    while i >= 0 {
        if normalized[i] == "/" {
            last_sep = i
            i = -1
        }
        i = i - 1
    }

    if last_sep < 0 {
        return "."
    }
    if last_sep == 0 {
        return "/"
    }

    // Strip trailing slashes from result
    let mut end = last_sep
    while end > 0 and normalized[end - 1] == "/" {
        end = end - 1
    }
    if end == 0 {
        return "/"
    }
    return substr(normalized, 0, end)
}

/// Get the last component of a path (file or directory name).
/// basename("/home/user/file.txt") -> "file.txt"
/// basename("/home/user/") -> "user"
fn basename(p: str) -> str {
    let normalized = _to_forward_slashes(p)
    let plen = len(normalized)
    if plen == 0 {
        return ""
    }

    // Skip trailing separators
    let mut end = plen
    while end > 0 and normalized[end - 1] == "/" {
        end = end - 1
    }
    if end == 0 {
        return "/"
    }

    // Find the start of the last component
    let mut start = end - 1
    while start > 0 and normalized[start - 1] != "/" {
        start = start - 1
    }

    return substr(normalized, start, end)
}

/// Get the file extension including the dot.
/// extname("file.txt") -> ".txt"
/// extname("archive.tar.gz") -> ".gz"
/// extname("Makefile") -> ""
fn extname(p: str) -> str {
    let base = basename(p)
    let blen = len(base)
    if blen == 0 {
        return ""
    }

    // Find the last dot, but not a leading dot
    let mut last_dot = -1
    let mut i = blen - 1
    while i > 0 {
        if base[i] == "." {
            last_dot = i
            i = 0
        }
        i = i - 1
    }

    if last_dot <= 0 {
        return ""
    }

    return substr(base, last_dot, blen)
}

/// Get the file name without its extension.
/// stem("file.txt") -> "file"
/// stem("archive.tar.gz") -> "archive.tar"
/// stem("Makefile") -> "Makefile"
fn stem(p: str) -> str {
    let base = basename(p)
    let ext = extname(p)
    let ext_len = len(ext)
    if ext_len == 0 {
        return base
    }
    let base_len = len(base)
    return substr(base, 0, base_len - ext_len)
}

/// Normalize a path by resolving `.`, `..`, and redundant separators.
fn normalize(p: str) -> str {
    let normalized = _to_forward_slashes(p)
    let plen = len(normalized)
    if plen == 0 {
        return "."
    }

    let is_abs = normalized[0] == "/"
    let segments = _split_path(normalized)
    let count = len(segments)

    let mut result = []
    let mut i = 0
    while i < count {
        let seg = segments[i]
        if seg == "." or len(seg) == 0 {
            // Skip current-directory references and empty segments
        } else if seg == ".." {
            let rlen = len(result)
            if rlen > 0 and result[rlen - 1] != ".." {
                // Pop the last segment
                let mut new_result = []
                let mut j = 0
                while j < rlen - 1 {
                    push(new_result, result[j])
                    j = j + 1
                }
                result = new_result
            } else if not is_abs {
                push(result, "..")
            }
        } else {
            push(result, seg)
        }
        i = i + 1
    }

    let rlen = len(result)
    if rlen == 0 {
        if is_abs {
            return "/"
        }
        return "."
    }

    let mut output = ""
    if is_abs {
        output = "/"
    }
    let mut k = 0
    while k < rlen {
        if k > 0 {
            output = output + "/"
        }
        output = output + result[k]
        k = k + 1
    }

    return output
}

/// Check if a path is absolute (starts with / or a drive letter on Windows).
fn is_absolute(p: str) -> bool {
    let plen = len(p)
    if plen == 0 {
        return false
    }
    // Unix absolute
    if p[0] == "/" or p[0] == "\\" {
        return true
    }
    // Windows drive letter: C:\ or C:/
    if plen >= 3 {
        let first_code = char_code(p[0])
        let is_alpha = (first_code >= 65 and first_code <= 90) or (first_code >= 97 and first_code <= 122)
        if is_alpha and p[1] == ":" and (p[2] == "/" or p[2] == "\\") {
            return true
        }
    }
    return false
}

/// Check if a path is relative (not absolute).
fn is_relative(p: str) -> bool {
    return not is_absolute(p)
}

/// Split a path into an array of its components.
/// split("/home/user/file.txt") -> ["/", "home", "user", "file.txt"]
fn split(p: str) -> [str] {
    let normalized = _to_forward_slashes(p)
    let plen = len(normalized)
    if plen == 0 {
        return ["."]
    }

    let mut result = []
    if normalized[0] == "/" {
        push(result, "/")
    }

    let segments = _split_path(normalized)
    let count = len(segments)
    let mut i = 0
    while i < count {
        let seg = segments[i]
        if len(seg) > 0 {
            push(result, seg)
        }
        i = i + 1
    }

    if len(result) == 0 {
        return ["."]
    }
    return result
}

/// Replace the extension of a path.
/// with_extension("file.txt", ".md") -> "file.md"
/// with_extension("file.txt", "") -> "file"
/// with_extension("file", ".md") -> "file.md"
fn with_extension(p: str, ext: str) -> str {
    let dir = dirname(p)
    let base = stem(p)

    let mut new_name = base
    if len(ext) > 0 {
        // Ensure ext starts with a dot
        if ext[0] != "." {
            new_name = new_name + "." + ext
        } else {
            new_name = new_name + ext
        }
    }

    if dir == "." {
        return new_name
    }
    return dir + PATH_SEP + new_name
}

/// Compute a relative path from one location to another.
/// relative("/home/user", "/home/user/docs/file.txt") -> "docs/file.txt"
/// relative("/home/user", "/home/other") -> "../other"
fn relative(from: str, to: str) -> str {
    let from_parts = split(normalize(from))
    let to_parts = split(normalize(to))
    let from_len = len(from_parts)
    let to_len = len(to_parts)

    // Find the common prefix length
    let mut common = 0
    let min_len = if from_len < to_len { from_len } else { to_len }
    while common < min_len and from_parts[common] == to_parts[common] {
        common = common + 1
    }

    // Build the relative path
    let mut result = []

    // Go up from 'from' to the common ancestor
    let mut i = common
    while i < from_len {
        // Don't add ".." for the root "/" segment
        if from_parts[i] != "/" {
            push(result, "..")
        }
        i = i + 1
    }

    // Go down from common ancestor to 'to'
    let mut j = common
    while j < to_len {
        if to_parts[j] != "/" {
            push(result, to_parts[j])
        }
        j = j + 1
    }

    if len(result) == 0 {
        return "."
    }

    return _join_segments(result, PATH_SEP)
}

// --- Convenience queries -----------------------------------------------------

/// Check if a path has an extension.
fn has_extension(p: str) -> bool {
    return len(extname(p)) > 0
}

/// Check if two paths are equal after normalization.
fn equals(a: str, b: str) -> bool {
    return normalize(a) == normalize(b)
}

/// Check if a path starts with a given prefix (after normalization).
fn starts_with(p: str, prefix: str) -> bool {
    let np = normalize(p)
    let npfx = normalize(prefix)
    let plen = len(np)
    let pfxlen = len(npfx)
    if pfxlen > plen {
        return false
    }
    let candidate = substr(np, 0, pfxlen)
    if candidate != npfx {
        return false
    }
    // Ensure the prefix ends at a segment boundary
    if pfxlen == plen {
        return true
    }
    if npfx == "/" {
        return true
    }
    return np[pfxlen] == "/"
}

/// Get the parent path (alias for dirname).
fn parent(p: str) -> str {
    return dirname(p)
}

/// Append a child segment to a path.
fn child(p: str, name: str) -> str {
    return join([p, name])
}

// --- Internal helpers --------------------------------------------------------

/// Convert all backslashes to forward slashes.
fn _to_forward_slashes(p: str) -> str {
    let plen = len(p)
    let mut result = ""
    let mut i = 0
    while i < plen {
        if p[i] == "\\" {
            result = result + "/"
        } else {
            result = result + p[i]
        }
        i = i + 1
    }
    return result
}

/// Split a path by the separator.
fn _split_path(p: str) -> [str] {
    let mut result = []
    let plen = len(p)
    let mut start = 0
    let mut i = 0
    while i < plen {
        if p[i] == "/" {
            if i > start {
                push(result, substr(p, start, i))
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < plen {
        push(result, substr(p, start, plen))
    }
    return result
}

/// Join string segments with a separator.
fn _join_segments(parts: [str], sep: str) -> str {
    let count = len(parts)
    if count == 0 {
        return ""
    }
    let mut result = parts[0]
    let mut i = 1
    while i < count {
        result = result + sep + parts[i]
        i = i + 1
    }
    return result
}
