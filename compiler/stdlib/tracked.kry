// ============================================================
// std.tracked -- Data lineage for AI safety and compliance
//
// Every piece of data carries its provenance: where it came
// from, what transformed it, and why. Critical for audits,
// debugging, and explainability.
// ============================================================

struct LineageEntry {
    operation: str,
    description: str,
    timestamp: i64,
    metadata: str
}

struct Tracked {
    value: str,
    lineage: [LineageEntry],
    source: str,
    source_description: str
}

// Create a tracked value from an original source.
fn tracked_source(value: str, source: str, description: str) -> Tracked {
    let entry = LineageEntry {
        operation: "source",
        description: description,
        timestamp: time_now(),
        metadata: "source=" + source
    }
    return Tracked {
        value: value,
        lineage: [entry],
        source: source,
        source_description: description
    }
}

impl Tracked {
    // Record a transformation step in the lineage.
    fn transform(self: Tracked, new_value: str, operation: str, description: str) -> Tracked {
        let entry = LineageEntry {
            operation: operation,
            description: description,
            timestamp: time_now(),
            metadata: ""
        }
        let mut new_lineage = self.lineage
        new_lineage = push(new_lineage, entry)
        return Tracked {
            value: new_value,
            lineage: new_lineage,
            source: self.source,
            source_description: self.source_description
        }
    }

    // Record an AI inference step.
    fn inference(self: Tracked, model: str, result: str, confidence: f64) -> Tracked {
        let entry = LineageEntry {
            operation: "inference",
            description: "Model: " + model,
            timestamp: time_now(),
            metadata: "confidence=" + to_string(confidence)
        }
        let mut new_lineage = self.lineage
        new_lineage = push(new_lineage, entry)
        return Tracked {
            value: result,
            lineage: new_lineage,
            source: self.source,
            source_description: self.source_description
        }
    }

    // Add an annotation (human review, note, etc.).
    fn annotate(self: Tracked, operation: str, description: str) -> Tracked {
        let entry = LineageEntry {
            operation: operation,
            description: description,
            timestamp: time_now(),
            metadata: ""
        }
        let mut new_lineage = self.lineage
        new_lineage = push(new_lineage, entry)
        return Tracked {
            value: self.value,
            lineage: new_lineage,
            source: self.source,
            source_description: self.source_description
        }
    }

    // Human-readable lineage explanation.
    fn explain(self: Tracked) -> str {
        let mut result = "Value: " + self.value + "\n\nLineage:"
        let mut i = 0
        while i < len(self.lineage) {
            let entry = self.lineage[i]
            result = result + "\n  " + to_string(i + 1) + ". [" + entry.operation + "] " + entry.description
            if len(entry.metadata) > 0 {
                result = result + "\n     " + entry.metadata
            }
            i = i + 1
        }
        return result
    }

    // Export lineage as a JSON-like string for compliance.
    fn to_json(self: Tracked) -> str {
        let mut result = "\{\"value\":" + "\"" + self.value + "\","
        result = result + "\"source\":\"" + self.source + "\","
        result = result + "\"lineage\":["
        let mut i = 0
        while i < len(self.lineage) {
            if i > 0 {
                result = result + ","
            }
            let entry = self.lineage[i]
            result = result + "\{\"op\":\"" + entry.operation + "\","
            result = result + "\"desc\":\"" + entry.description + "\","
            result = result + "\"ts\":" + to_string(entry.timestamp) + "\}"
            i = i + 1
        }
        result = result + "]\}"
        return result
    }
}
