// ============================================================
// std.tracked -- Data lineage for AI safety and compliance.
//
// Every piece of data carries its provenance: where it came from, what
// transformed it, and why. Tracked<T> is generic since v4.47 (was
// str-only); operations are free generic functions -- generic `impl`
// blocks are not yet supported. `explain`/`to_json` stringify the value
// with "{...}" interpolation, and to_json escapes via the native json
// builtins (the old hand-built JSON did not escape -- unsafe for
// untrusted payloads).
// ============================================================

struct LineageEntry {
    operation: str,
    description: str,
    timestamp: i64,
    metadata: str
}

struct Tracked<T> {
    value: T,
    lineage: [LineageEntry],
    source: str,
    source_description: str
}

/// Create a tracked value from an original source.
fn tracked_source<T>(value: T, source: str, description: str) -> Tracked<T> {
    let entry = LineageEntry {
        operation: "source",
        description: description,
        timestamp: time_now(),
        metadata: "source=" + source
    }
    return Tracked {
        value: value,
        lineage: [entry],
        source: source,
        source_description: description
    }
}

fn _append<T>(t: Tracked<T>, new_value: T, entry: LineageEntry) -> Tracked<T> {
    let mut new_lineage = t.lineage
    new_lineage = push(new_lineage, entry)
    return Tracked {
        value: new_value,
        lineage: new_lineage,
        source: t.source,
        source_description: t.source_description
    }
}

/// Record a transformation step in the lineage.
fn transform<T>(t: Tracked<T>, new_value: T, operation: str, description: str) -> Tracked<T> {
    let entry = LineageEntry {
        operation: operation,
        description: description,
        timestamp: time_now(),
        metadata: ""
    }
    return _append(t, new_value, entry)
}

/// Record an AI inference step.
fn inference<T>(t: Tracked<T>, model: str, result: T, confidence: f64) -> Tracked<T> {
    let entry = LineageEntry {
        operation: "inference",
        description: "Model: " + model,
        timestamp: time_now(),
        metadata: "confidence=" + to_string(confidence)
    }
    return _append(t, result, entry)
}

/// Add an annotation (human review, note, ...) without changing the value.
fn annotate<T>(t: Tracked<T>, operation: str, description: str) -> Tracked<T> {
    let entry = LineageEntry {
        operation: operation,
        description: description,
        timestamp: time_now(),
        metadata: ""
    }
    return _append(t, t.value, entry)
}

/// Human-readable lineage explanation.
fn explain<T>(t: Tracked<T>) -> str {
    let mut result = "Value: {t.value}

Lineage:"
    let mut i = 0
    while i < len(t.lineage) {
        let entry = t.lineage[i]
        result = result + "
  " + to_string(i + 1) + ". [" + entry.operation + "] " + entry.description
        if len(entry.metadata) > 0 {
            result = result + "
     " + entry.metadata
        }
        i = i + 1
    }
    return result
}

/// Explicitly discard a tracked value, returning its inner value and recording
/// (for the reader) why the provenance chain was intentionally broken. This is
/// the opt-out for the must-use lint (W0400): the compiler warns when a
/// `Tracked<T>` value is dropped as a statement, since that silently loses the
/// lineage; route deliberate drops through this function instead.
fn tracked_discard<T>(t: Tracked<T>, reason: str) -> T {
    return t.value
}

/// Export the lineage as JSON (properly escaped via the json builtins).
fn to_json<T>(t: Tracked<T>) -> str {
    let mut entries: [i64] = []
    for entry in t.lineage {
        let keys = ["op", "desc", "ts"]
        let vals = [json_string(entry.operation), json_string(entry.description), json_number(entry.timestamp as f64)]
        entries = push(entries, json_object(keys, vals))
    }
    let root_keys = ["value", "source", "lineage"]
    let root_vals = [json_string("{t.value}"), json_string(t.source), json_array(entries)]
    return json_stringify(json_object(root_keys, root_vals))
}
