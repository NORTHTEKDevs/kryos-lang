// ============================================================
// std.option -- Optional values
//
// The Option type represents a value that may or may not exist.
// Use it instead of null/nil to make absence explicit and safe.
//
// All combinators are GENERIC over the payload type, so str/f64
// payloads round-trip with their real types on both backends (a
// bare `Option`/`any` signature erases the payload to an i64 slot;
// see the and_then note below for the failure mode that motivated
// full parameterization).
//
// Usage:
//   let x = std.option.some(42)
//   let y = std.option.none_value()
//   if std.option.is_some(x) { ... }
// ============================================================

// --- Type definition ---------------------------------------------------------

// Result is used by `ok_or` (a real Option -> Result conversion).
use std::result::{Result, Ok, Err}

enum Option {
    Some(any),
    None
}

// --- Constructors ------------------------------------------------------------

/// Wrap a value in Some.
fn some<T>(val: T) -> Option<T> {
    return Option.Some(val)
}

/// Create a None value. (Named `none_value` because `none` is a reserved
/// literal in the language.)
fn none_value() -> Option {
    return Option.None
}

// --- Querying ----------------------------------------------------------------

/// True if the option contains a value.
fn is_some<T>(opt: Option<T>) -> bool {
    return match opt {
        Option.Some(_) => true,
        Option.None => false,
    }
}

/// True if the option is empty.
fn is_none<T>(opt: Option<T>) -> bool {
    return match opt {
        Option.Some(_) => false,
        Option.None => true,
    }
}

// --- Extracting --------------------------------------------------------------

/// Extract the contained value. Throws if None.
fn unwrap<T>(opt: Option<T>) -> T {
    return match opt {
        Option.Some(v) => v,
        Option.None => throw "unwrap called on None",
    }
}

/// Extract the contained value, or return the default.
fn unwrap_or<T>(opt: Option<T>, default: T) -> T {
    return match opt {
        Option.Some(v) => v,
        Option.None => default,
    }
}

/// Extract the value, or compute a default with a function.
fn unwrap_or_else<T>(opt: Option<T>, f: fn() -> T) -> T {
    return match opt {
        Option.Some(v) => v,
        Option.None => f(),
    }
}

// --- Transforming ------------------------------------------------------------

/// Apply a function to the contained value, if present.
/// Returns Some(f(val)) or None.
fn map<T, U>(opt: Option<T>, f: fn(T) -> U) -> Option<U> {
    return match opt {
        Option.Some(v) => Option.Some(f(v)),
        Option.None => Option.None,
    }
}

/// Apply a function that returns an Option to the contained value.
/// Flattens the result (avoids Option(Option(...))).
/// GENERIC: a bare `Option` return with an untyped `f: fn` erases the payload
/// to i64 (gotcha #13); returning f's Option DIRECTLY then corrupted the tag/
/// payload on AOT (`and_then(Some(21), ..)` returned `None`). Full
/// parameterization keeps the aggregate typed so it round-trips both backends.
fn and_then<T, U>(opt: Option<T>, f: fn(T) -> Option<U>) -> Option<U> {
    return match opt {
        Option.Some(v) => f(v),
        Option.None => Option.None,
    }
}

/// If the option is None, call f to produce a fallback Option.
fn or_else<T>(opt: Option<T>, f: fn() -> Option<T>) -> Option<T> {
    return match opt {
        Option.Some(v) => Option.Some(v),
        Option.None => f(),
    }
}

/// Keep the value only if the predicate returns true.
fn filter<T>(opt: Option<T>, pred: fn(T) -> bool) -> Option<T> {
    return match opt {
        Option.Some(v) => {
            if pred(v) {
                return Option.Some(v)
            }
            return Option.None
        },
        Option.None => Option.None,
    }
}

// --- Combining ---------------------------------------------------------------

/// Flatten Option(Option(T)) to Option(T): the inner option if Some,
/// otherwise None.
fn flatten<T>(opt: Option<Option<T>>) -> Option<T> {
    return match opt {
        Option.Some(inner) => inner,
        Option.None => Option.None,
    }
}

/// Zip two Options together. Returns Some((a, b)) if both are Some.
/// The pair is a TUPLE -- read with `.0` / `.1` or destructure.
fn zip<A, B>(a: Option<A>, b: Option<B>) -> Option<(A, B)> {
    return match a {
        Option.Some(av) => match b {
            Option.Some(bv) => Option.Some((av, bv)),
            Option.None => Option.None,
        },
        Option.None => Option.None,
    }
}

/// Replace the value inside Some, preserving Some/None status.
fn replace<T>(opt: Option<T>, val: T) -> Option<T> {
    return match opt {
        Option.Some(_) => Option.Some(val),
        Option.None => Option.None,
    }
}

// --- Conversion --------------------------------------------------------------

/// Convert an Option to a single-element or empty array.
fn to_array<T>(opt: Option<T>) -> [T] {
    return match opt {
        Option.Some(v) => [v],
        Option.None => [],
    }
}

/// Convert an Option to a Result. None becomes Err(err_msg).
fn ok_or<T>(opt: Option<T>, err_msg: str) -> Result<T, str> {
    return match opt {
        Option.Some(v) => Result.Ok(v),
        Option.None => Result.Err(err_msg),
    }
}

// --- Inspection --------------------------------------------------------------

/// Apply a function to the value for side effects, then return the option unchanged.
fn inspect<T, U>(opt: Option<T>, f: fn(T) -> U) -> Option<T> {
    return match opt {
        Option.Some(v) => {
            f(v)
            return Option.Some(v)
        },
        Option.None => Option.None,
    }
}

/// Convert to a human-readable string.
fn display<T>(opt: Option<T>) -> str {
    return match opt {
        Option.Some(v) => "Some(" + to_string(v) + ")",
        Option.None => "None",
    }
}

/// True if the option contains the given value.
fn contains<T>(opt: Option<T>, val: T) -> bool {
    return match opt {
        Option.Some(v) => v == val,
        Option.None => false,
    }
}

/// Apply f to the value if Some, otherwise return the provided default.
fn map_or<T, U>(opt: Option<T>, default: U, f: fn(T) -> U) -> U {
    return match opt {
        Option.Some(v) => f(v),
        Option.None => default,
    }
}

/// Apply f to the value if Some, otherwise call default_fn.
fn map_or_else<T, U>(opt: Option<T>, default_fn: fn() -> U, f: fn(T) -> U) -> U {
    return match opt {
        Option.Some(v) => f(v),
        Option.None => default_fn(),
    }
}

/// Logical AND: return other if self is Some, else None.
fn and_opt<T, U>(a: Option<T>, b: Option<U>) -> Option<U> {
    return match a {
        Option.Some(_) => b,
        Option.None => Option.None,
    }
}

/// Logical OR: return self if Some, else other.
fn or_opt<T>(a: Option<T>, b: Option<T>) -> Option<T> {
    return match a {
        Option.Some(v) => Option.Some(v),
        Option.None => b,
    }
}

/// Exclusive OR: return Some if exactly one is Some.
fn xor<T>(a: Option<T>, b: Option<T>) -> Option<T> {
    let a_some = is_some(a)
    let b_some = is_some(b)
    if a_some and not b_some {
        return a
    }
    if not a_some and b_some {
        return b
    }
    return Option.None
}
