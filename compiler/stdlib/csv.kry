// ============================================================
// std.csv -- RFC-4180-style CSV parsing and serialization.
//
// Pure Kryos. Handles quoted fields, embedded commas, embedded
// newlines inside quoted fields, and doubled-quote escapes ("").
//
// Usage:
//   use std::csv::{parse, parse_line, to_line}
//
//   let rows = parse("name,age\n\"Doe, Jane\",44\n")
//   for row in rows { println(row.fields[0]) }
//
//   let line = to_line(["a", "with,comma", "with \"quote\""])
//   // a,"with,comma","with ""quote"""
// ============================================================

@copy
use std::string::{string_builder}

struct CsvRow {
    fields: [str]
}

/// Parse one CSV line (no trailing newline) into fields.
/// For data containing quoted embedded newlines, use `parse` on the whole
/// document instead -- a single "line" of text is not a full record then.
fn parse_line(line: str) -> [str] {
    let rows = parse(line)
    if len(rows) == 0 {
        let empty: [str] = []
        return empty
    }
    return rows[0].fields
}

/// Parse a CSV document into rows. Recognizes \n and \r\n record
/// separators; a quoted field may contain commas, newlines, and doubled
/// quotes (""). A trailing newline does not produce an empty final row.
fn parse(input: str) -> [CsvRow] {
    let mut rows: [CsvRow] = []
    let mut fields: [str] = []
    // Field accumulator as a string_builder (O(n)). The wave-17 run-flush made
    // the common large-field case O(n), but a field DENSE with escaped quotes
    // ("") still hit `cur = cur + ...` per pair -> O(n^2). string_builder is O(n)
    // regardless. cur_has replaces the old len(cur) checks (a builder has no
    // cheap length).
    let mut cur_sb = string_builder()
    let mut cur_has = false
    // run_start marks the first not-yet-flushed input index of the current run.
    let mut run_start = 0
    let mut in_quotes = false
    let n = len(input)
    let mut i = 0
    let mut row_has_content = false

    while i < n {
        let c = substr(input, i, i + 1)
        if in_quotes {
            if c == "\"" {
                if i > run_start { cur_sb.append(substr(input, run_start, i))  cur_has = true }
                if i + 1 < n and substr(input, i + 1, i + 2) == "\"" {
                    cur_sb.append("\"")
                    cur_has = true
                    i = i + 2
                } else {
                    in_quotes = false
                    i = i + 1
                }
                run_start = i
            } else {
                i = i + 1
            }
        } else {
            if c == "\"" and not cur_has and run_start == i {
                // RFC 4180: a quote only opens a quoted field when it is the
                // FIRST character of the field. A quote appearing mid-field
                // (an inch mark, an unescaped quotation) is literal data --
                // toggling quote mode on it silently absorbed every comma and
                // newline in the rest of the document into one field (a
                // single stray quote made a 4-row file parse as 2 rows with
                // no error).
                in_quotes = true
                row_has_content = true
                i = i + 1
                run_start = i
            } elif c == "\"" {
                if i > run_start { cur_sb.append(substr(input, run_start, i))  cur_has = true }
                cur_sb.append("\"")
                cur_has = true
                row_has_content = true
                i = i + 1
                run_start = i
            } elif c == "," {
                if i > run_start { cur_sb.append(substr(input, run_start, i))  cur_has = true }
                fields = push(fields, cur_sb.build())
                cur_sb = string_builder()
                cur_has = false
                row_has_content = true
                i = i + 1
                run_start = i
            } elif c == "\n" or c == "\r" {
                if i > run_start { cur_sb.append(substr(input, run_start, i))  cur_has = true }
                if c == "\r" and i + 1 < n and substr(input, i + 1, i + 2) == "\n" {
                    i = i + 2
                } else {
                    i = i + 1
                }
                // A newline ALWAYS ends a row -- including an interior blank
                // line, which yields an empty (0-FIELD) row (matching Python's
                // csv.reader, which yields [] for a blank line). Do NOT suppress
                // the row itself here (that dropped interior blank lines and
                // mis-shifted subsequent indices). But only push the pending
                // field when the row has actual content/fields -- a truly blank
                // line (no chars, no commas) must be 0 fields, not one empty
                // field. `a,` (trailing comma) still yields ["a",""] because
                // len(fields) > 0; `,` yields ["",""]; `\n` alone yields [].
                // build() always (frees the buffer); push only if the row has
                // real content -- a truly blank line stays 0 fields.
                let field_val = cur_sb.build()
                if row_has_content or cur_has or len(fields) > 0 {
                    fields = push(fields, field_val)
                }
                rows = push(rows, CsvRow { fields: fields })
                let fresh: [str] = []
                fields = fresh
                cur_sb = string_builder()
                cur_has = false
                row_has_content = false
                run_start = i
            } else {
                // Ordinary char: stays in the current run, flushed on the next
                // delimiter / quote / end-of-input.
                row_has_content = true
                i = i + 1
            }
        }
    }
    if i > run_start { cur_sb.append(substr(input, run_start, i))  cur_has = true }
    let last_val = cur_sb.build()
    if row_has_content or cur_has or len(fields) > 0 {
        fields = push(fields, last_val)
        rows = push(rows, CsvRow { fields: fields })
    }
    return rows
}

/// True when the field needs quoting (contains comma, quote, or newline).
fn _needs_quoting(field: str) -> bool {
    let n = len(field)
    let mut i = 0
    while i < n {
        let c = substr(field, i, i + 1)
        if c == "," or c == "\"" or c == "\n" or c == "\r" {
            return true
        }
        i = i + 1
    }
    return false
}

/// Serialize fields into one CSV line (no trailing newline). Quotes are
/// added only where required; embedded quotes are doubled.
fn to_line(fields: [str]) -> str {
    // string_builder (O(n)) instead of per-char `quoted = quoted + c` for a
    // quoted field, which re-copied the accumulator each char (O(n^2) DoS on a
    // large field).
    let out = string_builder()
    let count = len(fields)
    let mut idx = 0
    while idx < count {
        let f = fields[idx]
        if idx > 0 {
            out.append(",")
        }
        if _needs_quoting(f) {
            out.append("\"")
            let n = len(f)
            let mut i = 0
            while i < n {
                let c = substr(f, i, i + 1)
                if c == "\"" {
                    out.append("\"\"")
                } else {
                    out.append(c)
                }
                i = i + 1
            }
            out.append("\"")
        } else {
            out.append(f)
        }
        idx = idx + 1
    }
    return out.build()
}

/// Serialize rows into a CSV document with \n separators and a trailing
/// newline.
fn serialize(rows: [CsvRow]) -> str {
    let mut out = ""
    for row in rows {
        out = out + to_line(row.fields) + "\n"
    }
    return out
}
