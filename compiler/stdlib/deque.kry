// ============================================================
// std.deque -- Double-ended queue over [i64].
// Push/pop at either end. O(N) for front-side ops (the pure cost).
// ============================================================

fn push_back(d: [i64], v: i64) -> [i64] {
    return push(d, v)
}

fn push_front(d: [i64], v: i64) -> [i64] {
    let mut out: [i64] = []
    out = push(out, v)
    let n = len(d)
    let mut i: i64 = 0
    while i < n {
        out = push(out, d[i])
        i = i + 1
    }
    return out
}

fn pop_back(d: [i64]) -> [i64] {
    let n = len(d)
    if n == 0 { return d }
    let mut out: [i64] = []
    let mut i: i64 = 0
    while i < n - 1 {
        out = push(out, d[i])
        i = i + 1
    }
    return out
}

fn pop_front(d: [i64]) -> [i64] {
    let n = len(d)
    if n == 0 { return d }
    let mut out: [i64] = []
    let mut i: i64 = 1
    while i < n {
        out = push(out, d[i])
        i = i + 1
    }
    return out
}

fn back(d: [i64]) -> i64 {
    let n = len(d)
    if n == 0 { return -1 }
    return d[n - 1]
}

fn front(d: [i64]) -> i64 {
    if len(d) == 0 { return -1 }
    return d[0]
}
