// ============================================================
// std.semver -- Semantic version parsing + comparison.
// MAJOR.MINOR.PATCH[-prerelease][+build] per semver.org.
// ============================================================

struct Version {
    major: i64,
    minor: i64,
    patch: i64,
    has_pre: bool,
    pre: str,
}

/// Parse a version string. Returns Version with major=-1 on malformed input.
fn parse(s: str) -> Version {
    let mut text = s
    // Strip optional `v` prefix.
    if len(text) > 0 {
        if substr(text, 0, 1) == "v" {
            text = substr(text, 1, len(text))
        }
    }
    // Drop +build metadata.
    let plus = find_char(text, "+")
    if plus >= 0 {
        text = substr(text, 0, plus)
    }
    // Detect -prerelease.
    let dash = find_char(text, "-")
    let has_pre = dash >= 0
    let core = if has_pre { substr(text, 0, dash) } else { text }
    let pre = if has_pre { substr(text, dash + 1, len(text)) } else { "" }

    let dot1 = find_char(core, ".")
    if dot1 < 0 {
        return Version { major: -1, minor: 0, patch: 0, has_pre: false, pre: "" }
    }
    let rest = substr(core, dot1 + 1, len(core))
    let dot2 = find_char(rest, ".")
    if dot2 < 0 {
        return Version { major: -1, minor: 0, patch: 0, has_pre: false, pre: "" }
    }
    let maj_s = substr(core, 0, dot1)
    let min_s = substr(rest, 0, dot2)
    let pat_s = substr(rest, dot2 + 1, len(rest))
    // Reject any non-numeric segment (e.g. an extra ".4": pat_s would be
    // "3.4", which parse_int silently truncated to 0). A valid core has
    // exactly three numeric segments.
    // Also reject a numeric segment too long to fit i64 (>= 19 digits can
    // exceed i64::MAX; parse_int PANICS on overflow, breaking the documented
    // "malformed input returns major=-1, never throws" contract). 18 digits
    // (<= 1e18) always fits; that is a far larger version number than real.
    if not is_all_digits(maj_s) or len(maj_s) > 18 or not is_all_digits(min_s) or len(min_s) > 18 or not is_all_digits(pat_s) or len(pat_s) > 18 {
        return Version { major: -1, minor: 0, patch: 0, has_pre: false, pre: "" }
    }
    return Version {
        major: parse_int(maj_s),
        minor: parse_int(min_s),
        patch: parse_int(pat_s),
        has_pre: has_pre,
        pre: pre,
    }
}

/// True if `s` is non-empty and every byte is an ASCII digit.
fn is_all_digits(s: str) -> bool {
    let n = len(s)
    if n == 0 {
        return false
    }
    let mut i = 0
    while i < n {
        let b = char_code(substr(s, i, i + 1))
        if b < 48 or b > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

/// Compare two versions. Returns -1, 0, or 1.
fn compare(a: Version, b: Version) -> i64 {
    if a.major != b.major { return cmp_i64(a.major, b.major) }
    if a.minor != b.minor { return cmp_i64(a.minor, b.minor) }
    if a.patch != b.patch { return cmp_i64(a.patch, b.patch) }
    // Equal triple. A release (no prerelease) has HIGHER precedence than a
    // prerelease of the same triple (semver.org rule 11.3).
    if a.has_pre && !b.has_pre { return -1 }
    if !a.has_pre && b.has_pre { return 1 }
    // Both prereleases: compare identifier-by-identifier. Previously only the
    // has_pre flag was checked, so ALL distinct prereleases of the same triple
    // compared EQUAL (1.0.0-alpha == 1.0.0-beta), violating semver precedence.
    if a.has_pre && b.has_pre {
        return compare_prerelease(a.pre, b.pre)
    }
    return 0
}

/// Compare two dot-separated prerelease strings per semver.org rule 11.4:
/// identifiers left-to-right; numeric compared numerically and ranked BELOW
/// alphanumeric; alphanumeric compared by ASCII; a larger set of identifiers
/// outranks a smaller one when all preceding identifiers are equal.
fn compare_prerelease(a: str, b: str) -> i64 {
    let alen = len(a)
    let blen = len(b)
    let mut i: i64 = 0
    let mut j: i64 = 0
    while i < alen or j < blen {
        // One prerelease ran out of identifiers -> it has lower precedence.
        if i >= alen { return -1 }
        if j >= blen { return 1 }
        let a_end = _next_dot(a, i)
        let b_end = _next_dot(b, j)
        let c = _cmp_identifier(substr(a, i, a_end), substr(b, j, b_end))
        if c != 0 { return c }
        i = a_end + 1
        j = b_end + 1
    }
    return 0
}

/// Index of the next '.' at or after `from`, or len(s) if none.
fn _next_dot(s: str, from: i64) -> i64 {
    let n = len(s)
    let mut k = from
    while k < n {
        if substr(s, k, k + 1) == "." { return k }
        k = k + 1
    }
    return n
}

fn _cmp_identifier(a: str, b: str) -> i64 {
    let a_num = is_all_digits(a)
    let b_num = is_all_digits(b)
    if a_num && b_num {
        // parse_int PANICS on an all-digit identifier >= 19 digits (i64
        // overflow). Numeric identifiers compare numerically; for overflow-long
        // ones a longer digit string is numerically larger, and equal lengths
        // compare lexicographically (both are pure digits).
        if len(a) <= 18 && len(b) <= 18 {
            return cmp_i64(parse_int(a), parse_int(b))
        }
        if len(a) != len(b) { return cmp_i64(len(a), len(b)) }
        return _cmp_ascii(a, b)
    }
    // A numeric identifier ranks below an alphanumeric one.
    if a_num && !b_num { return -1 }
    if !a_num && b_num { return 1 }
    return _cmp_ascii(a, b)
}

fn _cmp_ascii(a: str, b: str) -> i64 {
    let alen = len(a)
    let blen = len(b)
    let mut i: i64 = 0
    while i < alen && i < blen {
        let ca = char_code(substr(a, i, i + 1))
        let cb = char_code(substr(b, i, i + 1))
        if ca != cb { return cmp_i64(ca, cb) }
        i = i + 1
    }
    return cmp_i64(alen, blen)
}

fn cmp_i64(a: i64, b: i64) -> i64 {
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

/// Index of first occurrence of single-char needle, or -1.
fn find_char(s: str, c: str) -> i64 {
    let n = len(s)
    let mut i: i64 = 0
    while i < n {
        if substr(s, i, i + 1) == c {
            return i
        }
        i = i + 1
    }
    return -1
}
