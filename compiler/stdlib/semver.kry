// ============================================================
// std.semver -- Semantic version parsing + comparison.
// MAJOR.MINOR.PATCH[-prerelease][+build] per semver.org.
// ============================================================

struct Version {
    major: i64,
    minor: i64,
    patch: i64,
    has_pre: bool,
}

/// Parse a version string. Returns Version with major=-1 on malformed input.
fn parse(s: str) -> Version {
    let mut text = s
    // Strip optional `v` prefix.
    if len(text) > 0 {
        if substr(text, 0, 1) == "v" {
            text = substr(text, 1, len(text))
        }
    }
    // Drop +build metadata.
    let plus = find_char(text, "+")
    if plus >= 0 {
        text = substr(text, 0, plus)
    }
    // Detect -prerelease.
    let dash = find_char(text, "-")
    let has_pre = dash >= 0
    let core = if has_pre { substr(text, 0, dash) } else { text }

    let dot1 = find_char(core, ".")
    if dot1 < 0 {
        return Version { major: -1, minor: 0, patch: 0, has_pre: false }
    }
    let rest = substr(core, dot1 + 1, len(core))
    let dot2 = find_char(rest, ".")
    if dot2 < 0 {
        return Version { major: -1, minor: 0, patch: 0, has_pre: false }
    }
    let maj_s = substr(core, 0, dot1)
    let min_s = substr(rest, 0, dot2)
    let pat_s = substr(rest, dot2 + 1, len(rest))
    return Version {
        major: parse_int(maj_s),
        minor: parse_int(min_s),
        patch: parse_int(pat_s),
        has_pre: has_pre,
    }
}

/// Compare two versions. Returns -1, 0, or 1.
fn compare(a: Version, b: Version) -> i64 {
    if a.major != b.major { return cmp_i64(a.major, b.major) }
    if a.minor != b.minor { return cmp_i64(a.minor, b.minor) }
    if a.patch != b.patch { return cmp_i64(a.patch, b.patch) }
    // Equal triple. Prerelease sorts before release.
    if a.has_pre && !b.has_pre { return -1 }
    if !a.has_pre && b.has_pre { return 1 }
    return 0
}

fn cmp_i64(a: i64, b: i64) -> i64 {
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

/// Index of first occurrence of single-char needle, or -1.
fn find_char(s: str, c: str) -> i64 {
    let n = len(s)
    let mut i: i64 = 0
    while i < n {
        if substr(s, i, i + 1) == c {
            return i
        }
        i = i + 1
    }
    return -1
}
