// ============================================================
// std.stat -- Running statistics over [i64] arrays.
//
// All inputs are [i64]; no Welford state-vector tracking needed
// because pure-functional summarize-once is fast enough at the
// scale where you'd want std::stat anyway.
// ============================================================

fn count(xs: [i64]) -> i64 {
    return len(xs)
}

fn sum(xs: [i64]) -> i64 {
    let n = len(xs)
    let mut s: i64 = 0
    let mut i: i64 = 0
    while i < n {
        s = s + xs[i]
        i = i + 1
    }
    return s
}

fn mean_x1000(xs: [i64]) -> i64 {
    let n = len(xs)
    if n == 0 { return 0 }
    // Divide BEFORE scaling by 1000, then add the scaled remainder for the
    // fractional part. `sum(xs) * 1000` overflowed i64 for a large aggregate
    // sum (> ~9.2e15) and wrapped negative even when the true mean*1000 fits.
    let s = sum(xs)
    let q = s / n
    let r = s % n
    return q * 1000 + (r * 1000) / n
}

fn min(xs: [i64]) -> i64 {
    let n = len(xs)
    if n == 0 { return 0 }
    let mut m = xs[0]
    let mut i: i64 = 1
    while i < n {
        if xs[i] < m { m = xs[i] }
        i = i + 1
    }
    return m
}

fn max(xs: [i64]) -> i64 {
    let n = len(xs)
    if n == 0 { return 0 }
    let mut m = xs[0]
    let mut i: i64 = 1
    while i < n {
        if xs[i] > m { m = xs[i] }
        i = i + 1
    }
    return m
}

/// Sample variance (Welford-equivalent reduction). Returns 0 for n < 2.
/// Reports variance × 1000 to stay in integer math.
fn variance_x1000(xs: [i64]) -> i64 {
    let n = len(xs)
    if n < 2 { return 0 }
    // Compute in f64. The old integer form squared the milli-scaled deviation
    // (xs[i]*1000 - mu), so d*d overflowed i64 for a raw deviation of only
    // ~3 million and wrapped NEGATIVE, silently corrupting ordinary-magnitude
    // datasets. f64 avoids the overflow while preserving the fractional mean;
    // the final variance*1000 is well within i64 range.
    let mut s: f64 = 0.0
    let mut i: i64 = 0
    while i < n {
        s = s + (xs[i] as f64)
        i = i + 1
    }
    let mean = s / (n as f64)
    let mut acc: f64 = 0.0
    i = 0
    while i < n {
        let d = (xs[i] as f64) - mean
        acc = acc + d * d
        i = i + 1
    }
    let variance = acc / ((n - 1) as f64)
    return (variance * 1000.0) as i64
}
