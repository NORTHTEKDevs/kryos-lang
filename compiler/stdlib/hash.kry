// ============================================================
// std.hash -- Non-cryptographic hash functions.
//
// FNV-1a 64-bit, DJB2, and CRC32 (IEEE polynomial). All take a
// string and return a 64-bit hash as i64. For cryptographic
// hashes (SHA-256, blake3) use std::crypto.
// ============================================================

/// FNV-1a 64-bit. Fast + reasonable distribution. Default choice.
fn fnv1a64(s: str) -> i64 {
    let mut h: i64 = -3750763034362895579   // 0xcbf29ce484222325 as signed
    let n = len(s)
    let mut i: i64 = 0
    while i < n {
        let c = char_code(substr(s, i, i + 1))
        h = h ^ c
        // Multiply by FNV prime 0x100000001b3 = 1099511628211
        h = h * 1099511628211
        i = i + 1
    }
    return h
}

/// DJB2 hash. Slower than FNV-1a but well-known.
fn djb2(s: str) -> i64 {
    let mut h: i64 = 5381
    let n = len(s)
    let mut i: i64 = 0
    while i < n {
        let c = char_code(substr(s, i, i + 1))
        h = h * 33 + c
        i = i + 1
    }
    return h
}

/// CRC32 IEEE polynomial. Used by zip/png/ethernet.
fn crc32(s: str) -> i64 {
    // Standard IEEE 802.3 CRC-32 (zlib/binascii/png/zip). The accumulator MUST
    // stay a POSITIVE, 32-bit-masked value: init 0xffffffff (not signed -1), and
    // shift with a LOGICAL right shift. The old code used `crc: i64 = -1` and
    // `crc / 2` (SIGNED division, truncates toward zero on a negative value), so
    // once the accumulator went negative it diverged from the reference CRC32
    // (`crc32("hello")` returned 472206115, not 907060870) -- backend-consistent
    // but non-standard, breaking any real checksum interop.
    let mut crc: i64 = 0xffffffff
    let n = len(s)
    let mut i: i64 = 0
    while i < n {
        let c = char_code(substr(s, i, i + 1))
        crc = crc ^ c
        let mut j: i64 = 0
        while j < 8 {
            let bit = crc & 1
            crc = crc >> 1
            if bit == 1 {
                crc = crc ^ 0xedb88320
            }
            j = j + 1
        }
        i = i + 1
    }
    return (crc ^ 0xffffffff) & 0xffffffff
}
