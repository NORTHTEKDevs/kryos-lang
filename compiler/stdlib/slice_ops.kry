// ============================================================
// std.slice_ops -- take/drop/partition over [i64].
// Pure Kryos.
// ============================================================

/// First N elements (or all if N > len).
fn take(xs: [i64], n: i64) -> [i64] {
    let m = len(xs)
    let upto = if n < m { n } else { m }
    let mut out: [i64] = []
    let mut i: i64 = 0
    while i < upto {
        out = push(out, xs[i])
        i = i + 1
    }
    return out
}

/// Skip first N; return the rest.
fn drop(xs: [i64], n: i64) -> [i64] {
    let m = len(xs)
    let mut out: [i64] = []
    // Clamp the start index to [0, m]: a negative n produced a negative
    // start index and an out-of-bounds panic (take() already tolerates it).
    let clamped = if n < m { n } else { m }
    let mut i: i64 = if clamped < 0 { 0 } else { clamped }
    while i < m {
        out = push(out, xs[i])
        i = i + 1
    }
    return out
}

/// Partition by sign. Returns array of length 2: [positives, negatives]
/// — actually we return two separate arrays via a struct.
struct Partition {
    yes: [i64],
    no: [i64],
}

fn partition_positive(xs: [i64]) -> Partition {
    let mut y: [i64] = []
    let mut n: [i64] = []
    let mut i: i64 = 0
    let m = len(xs)
    while i < m {
        if xs[i] > 0 {
            y = push(y, xs[i])
        } else {
            n = push(n, xs[i])
        }
        i = i + 1
    }
    return Partition { yes: y, no: n }
}

fn partition_ge(xs: [i64], threshold: i64) -> Partition {
    let mut y: [i64] = []
    let mut n: [i64] = []
    let mut i: i64 = 0
    let m = len(xs)
    while i < m {
        if xs[i] >= threshold {
            y = push(y, xs[i])
        } else {
            n = push(n, xs[i])
        }
        i = i + 1
    }
    return Partition { yes: y, no: n }
}

/// True when `xs` is in non-decreasing order. Empty and single-element
/// arrays are sorted.
fn is_sorted(xs: [i64]) -> bool {
    let n = len(xs)
    let mut i = 1
    while i < n {
        if xs[i - 1] > xs[i] {
            return false
        }
        i = i + 1
    }
    return true
}

/// Binary search in a sorted (non-decreasing) array. Returns the index of
/// `target`, or -1 if absent. If `target` occurs multiple times, the index
/// of one occurrence is returned (not necessarily the first).
fn bsearch(xs: [i64], target: i64) -> i64 {
    let mut lo = 0
    let mut hi = len(xs) - 1
    while lo <= hi {
        let mid = lo + (hi - lo) / 2
        let v = xs[mid]
        if v == target {
            return mid
        }
        if v < target {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return 0 - 1
}
