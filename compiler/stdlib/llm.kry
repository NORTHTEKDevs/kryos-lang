// ============================================================
// std.llm -- Chat-completion clients for LLM APIs.
//
// Pure Kryos on the native `http_request` builtin (HTTPS + timeouts)
// and the native json_* builtins. Two wire formats:
//
//   - "openai"    : POST {base_url}/chat/completions  (OpenAI, OpenRouter,
//                   Ollama, vLLM, LM Studio -- anything OpenAI-compatible;
//                   point base_url at the server)
//   - "anthropic" : POST {base_url}/v1/messages       (Claude)
//
// Usage:
//   use std::llm::{openai_config, anthropic_config, with_base_url, user, system, chat, complete}
//
//   let cfg = anthropic_config(env_get("ANTHROPIC_API_KEY"), "claude-sonnet-4-6")
//   let reply = complete(cfg, "Say hello in five words.")
//
//   let cfg2 = with_base_url(openai_config("", "llama3"), "http://127.0.0.1:11434/v1")
//   let r = chat(cfg2, [system("Be terse."), user("2+2?")])
//   println("{r.text} ({r.input_tokens} in / {r.output_tokens} out)")
//
// Errors throw with a "llm error: ..." message (catchable; uncaught
// exits 101 with the message). Budget enforcement: see chat_within.
// ============================================================

use std::cost::{Budget, ComputeCost, cost_add}

// Runtime hooks for the `@budget(tokens = N, calls = M)` function
// attribute. When any budget frame is active on this thread, every chat()
// pre-charges one call and post-charges actual token usage; exceeding the
// frame throws, which is what halts a runaway agent loop.
extern {
    fn kryos_budget_active() -> i64
    fn kryos_budget_try_call() -> i64
    fn kryos_budget_charge_tokens(tokens: i64) -> i64
    fn kryos_budget_remaining_tokens() -> i64
    fn kryos_budget_remaining_calls() -> i64
    fn kryos_budget_charge_usd_micros(amount_micros: i64) -> i64
    fn kryos_budget_remaining_usd_micros() -> i64
}

// Charge a USD spend against the active `@budget(usd=...)` ceiling.
// Refuse-before-spend: returns false (and charges nothing) when `amount` would
// exceed the budget, true when the charge was applied. `amount` is in dollars
// (e.g. 0.03). Compute it from real usage, e.g. tokens / 1000.0 * price_per_1k.
fn budget_charge_usd(amount: f64) -> bool {
    let micros: i64 = (amount * 1000000.0) as i64
    return kryos_budget_charge_usd_micros(micros) == 0
}

// Remaining USD on the tightest active `@budget(usd=...)` frame, in dollars.
// Returns -1.0 when no usd-bearing budget frame is active.
fn budget_remaining_usd() -> f64 {
    let micros: i64 = kryos_budget_remaining_usd_micros()
    if micros < 0 {
        return -1.0
    }
    return (micros as f64) / 1000000.0
}

// Estimate the USD cost of a model call from token counts using a built-in
// per-model price table (USD per 1,000,000 tokens, input and output rates).
// Matched by substring so versioned model ids (gpt-4o-2024-..) still resolve.
// Unknown models fall back to a conservative mid-range rate so a USD budget
// still bites rather than silently charging $0. This is what makes the
// `@budget(usd=...)` axis real for chat(): see chat() / chat_within below.
fn estimate_cost_usd(model: str, in_tok: i64, out_tok: i64) -> f64 {
    let mut in_rate: f64 = 5.0
    let mut out_rate: f64 = 15.0
    if contains(model, "gpt-4o-mini") {
        in_rate = 0.15
        out_rate = 0.60
    } elif contains(model, "gpt-4o") {
        in_rate = 2.50
        out_rate = 10.0
    } elif contains(model, "gpt-4") {
        in_rate = 30.0
        out_rate = 60.0
    } elif contains(model, "o1") {
        in_rate = 15.0
        out_rate = 60.0
    } elif contains(model, "haiku") {
        in_rate = 0.80
        out_rate = 4.0
    } elif contains(model, "sonnet") {
        in_rate = 3.0
        out_rate = 15.0
    } elif contains(model, "opus") {
        in_rate = 15.0
        out_rate = 75.0
    } elif contains(model, "gpt-3.5") {
        in_rate = 0.50
        out_rate = 1.50
    }
    return ((in_tok as f64) * in_rate + (out_tok as f64) * out_rate) / 1000000.0
}

@copy
struct LlmConfig {
    provider: str,
    base_url: str,
    api_key: str,
    model: str,
    max_tokens: i64,
    temperature: f64,
    timeout_ms: i64
}

@copy
struct Message {
    role: str,
    content: str
}

@copy
struct LlmResponse {
    text: str,
    input_tokens: i64,
    output_tokens: i64,
    model: str,
    status: i64,
    raw: str
}

// --- Config builders ---------------------------------------------------------

/// Config for the OpenAI API (or any OpenAI-compatible server -- override
/// the endpoint with `with_base_url` for Ollama, OpenRouter, vLLM, ...).
fn openai_config(api_key: str, model: str) -> LlmConfig {
    return LlmConfig {
        provider: "openai",
        base_url: "https://api.openai.com/v1",
        api_key: api_key,
        model: model,
        max_tokens: 1024,
        temperature: 1.0,
        timeout_ms: 60000
    }
}

/// Config for the Anthropic Messages API.
fn anthropic_config(api_key: str, model: str) -> LlmConfig {
    return LlmConfig {
        provider: "anthropic",
        base_url: "https://api.anthropic.com",
        api_key: api_key,
        model: model,
        max_tokens: 1024,
        temperature: 1.0,
        timeout_ms: 60000
    }
}

fn with_base_url(cfg: LlmConfig, url: str) -> LlmConfig {
    return LlmConfig { provider: cfg.provider, base_url: url, api_key: cfg.api_key, model: cfg.model, max_tokens: cfg.max_tokens, temperature: cfg.temperature, timeout_ms: cfg.timeout_ms }
}

fn with_max_tokens(cfg: LlmConfig, n: i64) -> LlmConfig {
    return LlmConfig { provider: cfg.provider, base_url: cfg.base_url, api_key: cfg.api_key, model: cfg.model, max_tokens: n, temperature: cfg.temperature, timeout_ms: cfg.timeout_ms }
}

fn with_temperature(cfg: LlmConfig, t: f64) -> LlmConfig {
    return LlmConfig { provider: cfg.provider, base_url: cfg.base_url, api_key: cfg.api_key, model: cfg.model, max_tokens: cfg.max_tokens, temperature: t, timeout_ms: cfg.timeout_ms }
}

fn with_timeout_ms(cfg: LlmConfig, ms: i64) -> LlmConfig {
    return LlmConfig { provider: cfg.provider, base_url: cfg.base_url, api_key: cfg.api_key, model: cfg.model, max_tokens: cfg.max_tokens, temperature: cfg.temperature, timeout_ms: ms }
}

// --- Message helpers ---------------------------------------------------------

fn system(content: str) -> Message {
    return Message { role: "system", content: content }
}

fn user(content: str) -> Message {
    return Message { role: "user", content: content }
}

fn assistant(content: str) -> Message {
    return Message { role: "assistant", content: content }
}

// --- Request building (native json_* builtins handle escaping) ---------------

fn _openai_body(cfg: LlmConfig, messages: [Message]) -> str {
    let mut msg_nodes: [i64] = []
    for m in messages {
        let keys = ["role", "content"]
        let vals = [json_string(m.role), json_string(m.content)]
        msg_nodes = push(msg_nodes, json_object(keys, vals))
    }
    let root_keys = ["model", "max_tokens", "temperature", "messages"]
    let root_vals = [
        json_string(cfg.model),
        json_number(cfg.max_tokens as f64),
        json_number(cfg.temperature),
        json_array(msg_nodes)
    ]
    return json_stringify(json_object(root_keys, root_vals))
}

fn _anthropic_body(cfg: LlmConfig, messages: [Message]) -> str {
    // Anthropic carries the system prompt in a top-level field, not the
    // messages array.
    let mut sys = ""
    let mut msg_nodes: [i64] = []
    for m in messages {
        if m.role == "system" {
            if sys == "" {
                sys = m.content
            } else {
                sys = sys + "\n" + m.content
            }
        } else {
            let keys = ["role", "content"]
            let vals = [json_string(m.role), json_string(m.content)]
            msg_nodes = push(msg_nodes, json_object(keys, vals))
        }
    }
    let mut root_keys = ["model", "max_tokens", "temperature", "messages"]
    let mut root_vals = [
        json_string(cfg.model),
        json_number(cfg.max_tokens as f64),
        json_number(cfg.temperature),
        json_array(msg_nodes)
    ]
    if sys != "" {
        root_keys = push(root_keys, "system")
        root_vals = push(root_vals, json_string(sys))
    }
    return json_stringify(json_object(root_keys, root_vals))
}

// --- Response parsing --------------------------------------------------------

fn _require(node: i64, what: str) -> i64 {
    if json_is_null(node) {
        throw "llm error: malformed response: missing " + what
    }
    return node
}

fn _parse_openai(body: str, status: i64) -> LlmResponse {
    let raw = body
    let root = json_parse(raw)
    let choices = _require(json_get(root, "choices"), "choices")
    let first = _require(json_get_index(choices, 0), "choices[0]")
    let message = _require(json_get(first, "message"), "choices[0].message")
    let text = json_to_str(_require(json_get(message, "content"), "message.content"))
    let mut in_tok = 0
    let mut out_tok = 0
    let usage = json_get(root, "usage")
    if not json_is_null(usage) {
        in_tok = json_to_int(json_get(usage, "prompt_tokens"))
        out_tok = json_to_int(json_get(usage, "completion_tokens"))
    }
    let mut model = ""
    let model_node = json_get(root, "model")
    if not json_is_null(model_node) {
        model = json_to_str(model_node)
    }
    return LlmResponse { text: text, input_tokens: in_tok, output_tokens: out_tok, model: model, status: status, raw: raw }
}

fn _parse_anthropic(body: str, status: i64) -> LlmResponse {
    let raw = body
    let root = json_parse(raw)
    let content = _require(json_get(root, "content"), "content")
    let first = _require(json_get_index(content, 0), "content[0]")
    let text = json_to_str(_require(json_get(first, "text"), "content[0].text"))
    let mut in_tok = 0
    let mut out_tok = 0
    let usage = json_get(root, "usage")
    if not json_is_null(usage) {
        in_tok = json_to_int(json_get(usage, "input_tokens"))
        out_tok = json_to_int(json_get(usage, "output_tokens"))
    }
    let mut model = ""
    let model_node = json_get(root, "model")
    if not json_is_null(model_node) {
        model = json_to_str(model_node)
    }
    return LlmResponse { text: text, input_tokens: in_tok, output_tokens: out_tok, model: model, status: status, raw: raw }
}

// --- Core call ---------------------------------------------------------------

/// Send a chat-completion request and return the parsed response.
/// Throws "llm error: ..." on transport failure, non-200 status, or a
/// response missing the expected fields.
@capabilities(net)
fn chat(cfg: LlmConfig, messages: [Message]) -> LlmResponse {
    let mut url = ""
    let mut headers = "Content-Type: application/json"
    let mut body = ""
    if cfg.provider == "anthropic" {
        url = cfg.base_url + "/v1/messages"
        headers = headers + "\nx-api-key: " + cfg.api_key + "\nanthropic-version: 2023-06-01"
        body = _anthropic_body(cfg, messages)
    } else {
        url = cfg.base_url + "/chat/completions"
        if cfg.api_key != "" {
            headers = headers + "\nAuthorization: Bearer " + cfg.api_key
        }
        body = _openai_body(cfg, messages)
    }

    if kryos_budget_active() == 1 {
        if kryos_budget_try_call() == 1 {
            throw "llm error: @budget exhausted: no model calls left (remaining tokens: " + to_string(kryos_budget_remaining_tokens()) + ")"
        }
    }

    let resp = http_request("POST", url, headers, body, cfg.timeout_ms)
    if json_is_null(resp) {
        throw "llm error: transport failure reaching " + url + " (network down, TLS failure, or timeout after " + to_string(cfg.timeout_ms) + "ms)"
    }
    let status = json_to_int(json_get(resp, "status"))
    let resp_body = json_to_str(json_get(resp, "body"))
    if status != 200 {
        let mut excerpt = resp_body
        if len(excerpt) > 300 {
            excerpt = substr(excerpt, 0, 300)
        }
        throw "llm error: HTTP " + to_string(status) + " from " + url + ": " + excerpt
    }
    let mut parsed = LlmResponse { text: "", input_tokens: 0, output_tokens: 0, model: "", status: 0, raw: "" }
    if cfg.provider == "anthropic" {
        parsed = _parse_anthropic(resp_body, status)
    } else {
        parsed = _parse_openai(resp_body, status)
    }
    if kryos_budget_active() == 1 {
        let exceeded = kryos_budget_charge_tokens(parsed.input_tokens + parsed.output_tokens)
        if exceeded == 1 {
            throw "llm error: @budget exceeded: token limit crossed by this call (used " + to_string(parsed.input_tokens + parsed.output_tokens) + " tokens)"
        }
        // Charge the estimated USD cost against any active @budget(usd=...) frame
        // (priced from cfg.model). budget_charge_usd returns false (charging
        // nothing) when there is no usd frame OR when the charge would exceed it.
        let usd = estimate_cost_usd(cfg.model, parsed.input_tokens, parsed.output_tokens)
        if kryos_budget_remaining_usd_micros() >= 0 {
            if budget_charge_usd(usd) == false {
                let cents = (usd * 100.0) as i64
                throw "llm error: @budget exceeded: USD limit crossed by this call (estimated ~" + to_string(cents) + " cents at model " + cfg.model + ")"
            }
        }
    }
    return parsed
}

/// One-shot convenience: single user prompt in, reply text out.
/// (Named `complete` because `ask` is a reserved keyword.)
@capabilities(net)
fn complete(cfg: LlmConfig, prompt: str) -> str {
    let r = chat(cfg, [user(prompt)])
    return r.text
}

// --- Budget enforcement (std::cost) -------------------------------------------

@copy
struct BudgetedChat {
    response: LlmResponse,
    budget: Budget
}

/// chat() guarded by a std::cost Budget. Throws BEFORE the call when the
/// budget is already exhausted; charges actual usage (input+output tokens,
/// 1 API call, and estimated USD via the built-in per-model price table -
/// see estimate_cost_usd) afterward and returns the updated budget.
@capabilities(net)
fn chat_within(cfg: LlmConfig, messages: [Message], budget: Budget) -> BudgetedChat {
    if budget.is_exhausted() {
        throw "llm error: budget exhausted before call (remaining tokens: " + to_string(budget.remaining_tokens()) + ", api calls: " + to_string(budget.remaining_api_calls()) + ")"
    }
    let r = chat(cfg, messages)
    let used = ComputeCost {
        wall_time_ms: 0.0,
        tokens_used: r.input_tokens + r.output_tokens,
        api_calls: 1,
        money_usd: estimate_cost_usd(cfg.model, r.input_tokens, r.output_tokens),
        energy_kwh: 0.0
    }
    let charged = budget.charge(used)
    return BudgetedChat { response: r, budget: charged }
}

// --- Tool calling --------------------------------------------------------------
//
// Declare tools, detect tool calls in the model's reply, execute them in
// Kryos, and continue the conversation with the results. Both wire formats
// are supported; the assistant's tool-use turn is carried between rounds as
// raw provider JSON (ToolTurn.assistant_raw).

@copy
struct ToolDef {
    name: str,
    description: str,
    schema_json: str
}

@copy
struct ToolCall {
    id: str,
    name: str,
    arguments_json: str
}

@copy
struct ToolResult {
    id: str,
    content: str
}

@copy
struct ToolTurn {
    text: str,
    tool_calls: [ToolCall],
    done: bool,
    assistant_raw: str,
    input_tokens: i64,
    output_tokens: i64
}

/// Declare a tool. `schema_json` is a JSON-Schema object describing the
/// arguments (build it with the json_* builtins + json_stringify, or write
/// it as a literal with brace escapes).
fn tool(name: str, description: str, schema_json: str) -> ToolDef {
    return ToolDef { name: name, description: description, schema_json: schema_json }
}

fn tool_result(id: str, content: str) -> ToolResult {
    return ToolResult { id: id, content: content }
}

fn _openai_tools_node(tools: [ToolDef]) -> i64 {
    let mut nodes: [i64] = []
    for t in tools {
        let fn_keys = ["name", "description", "parameters"]
        let fn_vals = [json_string(t.name), json_string(t.description), json_parse(t.schema_json)]
        let outer_keys = ["type", "function"]
        let outer_vals = [json_string("function"), json_object(fn_keys, fn_vals)]
        nodes = push(nodes, json_object(outer_keys, outer_vals))
    }
    return json_array(nodes)
}

fn _anthropic_tools_node(tools: [ToolDef]) -> i64 {
    let mut nodes: [i64] = []
    for t in tools {
        let keys = ["name", "description", "input_schema"]
        let vals = [json_string(t.name), json_string(t.description), json_parse(t.schema_json)]
        nodes = push(nodes, json_object(keys, vals))
    }
    return json_array(nodes)
}

/// Internal: POST a raw request body, return the response body. Shares the
/// budget hooks with chat().
@capabilities(net)
fn _post(cfg: LlmConfig, body: str) -> str {
    let mut url = ""
    let mut headers = "Content-Type: application/json"
    if cfg.provider == "anthropic" {
        url = cfg.base_url + "/v1/messages"
        headers = headers + "\nx-api-key: " + cfg.api_key + "\nanthropic-version: 2023-06-01"
    } else {
        url = cfg.base_url + "/chat/completions"
        if cfg.api_key != "" {
            headers = headers + "\nAuthorization: Bearer " + cfg.api_key
        }
    }
    if kryos_budget_active() == 1 {
        if kryos_budget_try_call() == 1 {
            throw "llm error: @budget exhausted: no model calls left"
        }
    }
    let resp = http_request("POST", url, headers, body, cfg.timeout_ms)
    if json_is_null(resp) {
        throw "llm error: transport failure reaching " + url
    }
    let status = json_to_int(json_get(resp, "status"))
    let resp_body = json_to_str(json_get(resp, "body"))
    if status != 200 {
        let mut excerpt = resp_body
        if len(excerpt) > 300 {
            excerpt = substr(excerpt, 0, 300)
        }
        throw "llm error: HTTP " + to_string(status) + " from " + url + ": " + excerpt
    }
    return resp_body
}

fn _charge_turn(turn_in: i64, turn_out: i64) {
    if kryos_budget_active() == 1 {
        let exceeded = kryos_budget_charge_tokens(turn_in + turn_out)
        if exceeded == 1 {
            throw "llm error: @budget exceeded: token limit crossed by this call"
        }
    }
}

fn _parse_openai_turn(body: str) -> ToolTurn {
    let root = json_parse(body)
    let choices = _require(json_get(root, "choices"), "choices")
    let first = _require(json_get_index(choices, 0), "choices[0]")
    let message = _require(json_get(first, "message"), "choices[0].message")
    let mut text = ""
    let content_node = json_get(message, "content")
    if not json_is_null(content_node) {
        text = json_to_str(content_node)
    }
    let mut calls: [ToolCall] = []
    let tc = json_get(message, "tool_calls")
    if not json_is_null(tc) {
        let n = json_length(tc)
        let mut i = 0
        while i < n {
            let item = json_get_index(tc, i)
            let f = _require(json_get(item, "function"), "tool_calls[].function")
            calls = push(calls, ToolCall {
                id: json_to_str(_require(json_get(item, "id"), "tool_calls[].id")),
                name: json_to_str(_require(json_get(f, "name"), "function.name")),
                arguments_json: json_to_str(_require(json_get(f, "arguments"), "function.arguments"))
            })
            i = i + 1
        }
    }
    let mut in_tok = 0
    let mut out_tok = 0
    let usage = json_get(root, "usage")
    if not json_is_null(usage) {
        in_tok = json_to_int(json_get(usage, "prompt_tokens"))
        out_tok = json_to_int(json_get(usage, "completion_tokens"))
    }
    _charge_turn(in_tok, out_tok)
    return ToolTurn {
        text: text,
        tool_calls: calls,
        done: len(calls) == 0,
        assistant_raw: json_stringify(message),
        input_tokens: in_tok,
        output_tokens: out_tok
    }
}

fn _parse_anthropic_turn(body: str) -> ToolTurn {
    let root = json_parse(body)
    let content = _require(json_get(root, "content"), "content")
    let n = json_length(content)
    let mut text = ""
    let mut calls: [ToolCall] = []
    let mut i = 0
    while i < n {
        let block = json_get_index(content, i)
        let ty = json_to_str(_require(json_get(block, "type"), "content[].type"))
        if ty == "text" {
            text = text + json_to_str(_require(json_get(block, "text"), "text block"))
        }
        if ty == "tool_use" {
            calls = push(calls, ToolCall {
                id: json_to_str(_require(json_get(block, "id"), "tool_use.id")),
                name: json_to_str(_require(json_get(block, "name"), "tool_use.name")),
                arguments_json: json_stringify(_require(json_get(block, "input"), "tool_use.input"))
            })
        }
        i = i + 1
    }
    let mut in_tok = 0
    let mut out_tok = 0
    let usage = json_get(root, "usage")
    if not json_is_null(usage) {
        in_tok = json_to_int(json_get(usage, "input_tokens"))
        out_tok = json_to_int(json_get(usage, "output_tokens"))
    }
    _charge_turn(in_tok, out_tok)
    let asst_keys = ["role", "content"]
    let asst_vals = [json_string("assistant"), content]
    return ToolTurn {
        text: text,
        tool_calls: calls,
        done: len(calls) == 0,
        assistant_raw: json_stringify(json_object(asst_keys, asst_vals)),
        input_tokens: in_tok,
        output_tokens: out_tok
    }
}

fn _message_nodes(cfg: LlmConfig, messages: [Message]) -> [i64] {
    let mut nodes: [i64] = []
    for m in messages {
        if cfg.provider == "anthropic" and m.role == "system" {
            // carried in the top-level "system" field instead
        } else {
            let keys = ["role", "content"]
            let vals = [json_string(m.role), json_string(m.content)]
            nodes = push(nodes, json_object(keys, vals))
        }
    }
    return nodes
}

fn _anthropic_system_of(messages: [Message]) -> str {
    let mut sys = ""
    for m in messages {
        if m.role == "system" {
            if sys == "" {
                sys = m.content
            } else {
                sys = sys + "\n" + m.content
            }
        }
    }
    return sys
}

fn _tools_body(cfg: LlmConfig, msg_nodes: [i64], tools: [ToolDef], sys: str) -> str {
    let mut keys = ["model", "max_tokens", "temperature", "messages"]
    let mut vals = [
        json_string(cfg.model),
        json_number(cfg.max_tokens as f64),
        json_number(cfg.temperature),
        json_array(msg_nodes)
    ]
    if len(tools) > 0 {
        keys = push(keys, "tools")
        if cfg.provider == "anthropic" {
            vals = push(vals, _anthropic_tools_node(tools))
        } else {
            vals = push(vals, _openai_tools_node(tools))
        }
    }
    if cfg.provider == "anthropic" and sys != "" {
        keys = push(keys, "system")
        vals = push(vals, json_string(sys))
    }
    return json_stringify(json_object(keys, vals))
}

/// Chat with tool definitions. When the model wants tools, `done` is false
/// and `tool_calls` lists what to run; answer with
/// `continue_with_tool_results`.
@capabilities(net)
fn chat_tools(cfg: LlmConfig, messages: [Message], tools: [ToolDef]) -> ToolTurn {
    let sys = _anthropic_system_of(messages)
    let body = _tools_body(cfg, _message_nodes(cfg, messages), tools, sys)
    let resp = _post(cfg, body)
    if cfg.provider == "anthropic" {
        return _parse_anthropic_turn(resp)
    }
    return _parse_openai_turn(resp)
}

/// Send tool results back and get the model's next turn. `assistant_raw`
/// is ToolTurn.assistant_raw from the turn that requested the tools.
@capabilities(net)
fn continue_with_tool_results(cfg: LlmConfig, messages: [Message], tools: [ToolDef], assistant_raw: str, results: [ToolResult]) -> ToolTurn {
    let sys = _anthropic_system_of(messages)
    let mut nodes = _message_nodes(cfg, messages)
    nodes = push(nodes, json_parse(assistant_raw))
    if cfg.provider == "anthropic" {
        let mut blocks: [i64] = []
        for r in results {
            let keys = ["type", "tool_use_id", "content"]
            let vals = [json_string("tool_result"), json_string(r.id), json_string(r.content)]
            blocks = push(blocks, json_object(keys, vals))
        }
        let keys = ["role", "content"]
        let vals = [json_string("user"), json_array(blocks)]
        nodes = push(nodes, json_object(keys, vals))
    } else {
        for r in results {
            let keys = ["role", "tool_call_id", "content"]
            let vals = [json_string("tool"), json_string(r.id), json_string(r.content)]
            nodes = push(nodes, json_object(keys, vals))
        }
    }
    let body = _tools_body(cfg, nodes, tools, sys)
    let resp = _post(cfg, body)
    if cfg.provider == "anthropic" {
        return _parse_anthropic_turn(resp)
    }
    return _parse_openai_turn(resp)
}
