// ============================================================
// std.math -- Mathematical constants and functions
//
// Provides fundamental numeric operations, trigonometry,
// logarithms, and number-theoretic utilities.
//
// Usage: std.math.sin(x), std.math.PI, etc.
// ============================================================

// --- Constants ---------------------------------------------------------------

let PI      = 3.141592653589793
let E       = 2.718281828459045
let TAU     = 6.283185307179586
let INF     = 1.0 / 0.0
let NEG_INF = -1.0 / 0.0
let NAN     = 0.0 / 0.0

// --- Basic arithmetic --------------------------------------------------------

/// Absolute value of a number.
fn abs(x: f64) -> f64 {
    if x < 0.0 {
        return -x
    }
    return x
}

/// Return the smaller of two values.
fn min(a: f64, b: f64) -> f64 {
    if a <= b {
        return a
    }
    return b
}

/// Return the larger of two values.
fn max(a: f64, b: f64) -> f64 {
    if a >= b {
        return a
    }
    return b
}

/// Clamp a value to the range [lo, hi].
fn clamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

/// Sign of a number: -1, 0, or 1.
fn sign(x: f64) -> f64 {
    if x > 0.0 {
        return 1.0
    }
    if x < 0.0 {
        return -1.0
    }
    return 0.0
}

// --- Rounding ----------------------------------------------------------------

/// Floor: largest integer <= x.
fn floor(x: f64) -> f64 {
    let truncated = int(x)
    let f = float(truncated)
    if x < 0.0 and f != x {
        return f - 1.0
    }
    return f
}

/// Ceiling: smallest integer >= x.
fn ceil(x: f64) -> f64 {
    let f = floor(x)
    if f == x {
        return x
    }
    return f + 1.0
}

/// Round to nearest integer (half rounds away from zero).
fn round(x: f64) -> f64 {
    if x >= 0.0 {
        return floor(x + 0.5)
    }
    return ceil(x - 0.5)
}

// --- Powers and roots --------------------------------------------------------

/// Square root via Newton's method.
fn sqrt(x: f64) -> f64 {
    if x < 0.0 {
        return NAN
    }
    if x == 0.0 {
        return 0.0
    }
    // Seed Newton with a magnitude-correct guess. A plain x/2 seed is many
    // orders of magnitude above sqrt(x) for large x, so early Newton steps
    // behave like bisection (halving) and the old 64-iteration cap ran out
    // before converging -- sqrt(1e50) silently returned ~2.7e30, not 1e25.
    // Normalize x into [1,4) by factoring out 4^k (sqrt(4)=2); the seed is
    // then within ~1.4x of the true root and Newton converges in a few steps
    // across the full f64 range. Convergence uses a RELATIVE tolerance.
    let mut m = x
    let mut scale = 1.0
    while m >= 4.0 {
        m = m / 4.0
        scale = scale * 2.0
    }
    while m < 1.0 {
        m = m * 4.0
        scale = scale / 2.0
    }
    let mut guess = scale * 1.5
    let mut i = 0
    while i < 64 {
        let next = (guess + x / guess) / 2.0
        if abs(next - guess) <= abs(next) * 1.0e-15 {
            return next
        }
        guess = next
        i = i + 1
    }
    return guess
}

/// Cube root.
fn cbrt(x: f64) -> f64 {
    if x == 0.0 {
        return 0.0
    }
    let negative = x < 0.0
    let mut val = abs(x)
    // Magnitude-correct seed (same fix as sqrt): a plain val/3 seed is far
    // above cbrt(val) for large val, so Newton ran out of iterations and
    // returned an unconverged value (cbrt(1e30) gave ~1.8e18, not 1e10).
    // Normalize val into [1,8) by factoring out 8^k (cbrt(8)=2).
    let mut m = val
    let mut scale = 1.0
    while m >= 8.0 {
        m = m / 8.0
        scale = scale * 2.0
    }
    while m < 1.0 {
        m = m * 8.0
        scale = scale / 2.0
    }
    let mut guess = scale * 1.5
    let mut i = 0
    while i < 64 {
        let next = (2.0 * guess + val / (guess * guess)) / 3.0
        if abs(next - guess) <= abs(next) * 1.0e-15 {
            if negative {
                return -next
            }
            return next
        }
        guess = next
        i = i + 1
    }
    if negative {
        return -guess
    }
    return guess
}

/// Raise base to an integer or floating-point power.
fn pow(base: f64, exponent: f64) -> f64 {
    // Integer exponent fast path
    if exponent == floor(exponent) and abs(exponent) < 1000.0 {
        let mut result = 1.0
        let mut exp = int(abs(exponent))
        let mut b = base
        while exp > 0 {
            if exp % 2 == 1 {
                result = result * b
            }
            b = b * b
            exp = exp / 2
        }
        if exponent < 0.0 {
            return 1.0 / result
        }
        return result
    }
    // General case: base^exp = e^(exp * ln(base))
    return exp(exponent * ln(base))
}

/// Euler's number raised to x: e^x via Taylor series.
fn exp(x: f64) -> f64 {
    // Range reduction: e^x = e^k * e^r where k = round(x), r = x - k
    let k = round(x)
    let r = x - k

    // Compute e^r via Taylor series (converges fast for |r| <= 0.5)
    let mut term = 1.0
    let mut sum = 1.0
    let mut i = 1
    while i <= 30 {
        term = term * r / float(i)
        sum = sum + term
        if abs(term) < 1.0e-16 {
            i = 31
        }
        i = i + 1
    }

    // Multiply by e^k using repeated squaring
    let mut e_k = 1.0
    let mut base = E
    let mut exp_k = int(abs(k))
    while exp_k > 0 {
        if exp_k % 2 == 1 {
            e_k = e_k * base
        }
        base = base * base
        exp_k = exp_k / 2
    }
    if k < 0.0 {
        e_k = 1.0 / e_k
    }

    return sum * e_k
}

/// Natural logarithm via the AGM (arithmetic-geometric mean) method.
fn ln(x: f64) -> f64 {
    if x <= 0.0 {
        if x == 0.0 {
            return NEG_INF
        }
        return NAN
    }
    if x == 1.0 {
        return 0.0
    }

    // Reduce to [0.5, 2.0) range: ln(x) = ln(m * 2^e) = ln(m) + e*ln(2)
    let mut m = x
    let mut e = 0.0
    while m >= 2.0 {
        m = m / 2.0
        e = e + 1.0
    }
    while m < 0.5 {
        m = m * 2.0
        e = e - 1.0
    }

    // Series expansion: ln(m) using ln((1+t)/(1-t)) = 2*(t + t^3/3 + t^5/5 + ...)
    // where t = (m-1)/(m+1)
    let t = (m - 1.0) / (m + 1.0)
    let t2 = t * t
    let mut term = t
    let mut sum = t
    let mut k = 1
    while k <= 40 {
        term = term * t2
        let denom = float(2 * k + 1)
        sum = sum + term / denom
        k = k + 1
    }

    let LN2 = 0.6931471805599453
    return 2.0 * sum + e * LN2
}

/// Base-2 logarithm.
fn log2(x: f64) -> f64 {
    let LN2 = 0.6931471805599453
    return ln(x) / LN2
}

/// Base-10 logarithm.
fn log10(x: f64) -> f64 {
    let LN10 = 2.302585092994046
    return ln(x) / LN10
}

// --- Trigonometry ------------------------------------------------------------

/// Normalize angle to [-PI, PI] for better series convergence.
fn _normalize_angle(x: f64) -> f64 {
    // Reduce modulo TAU in O(1). The old loop subtracted TAU one step at a time,
    // so it HUNG for a large magnitude (sin(1e12) ran ~1.6e11 iterations). This
    // brings a into [0, TAU) then into (-PI, PI]. (Precision for a huge angle is
    // limited by f64 -- true libm uses Payne-Hanek -- but the result is bounded
    // and correct for ordinary angles; the point is to never hang.)
    let mut a = x - TAU * floor(x / TAU)
    if a > PI {
        a = a - TAU
    }
    return a
}

/// Sine via Taylor series.
fn sin(x: f64) -> f64 {
    let a = _normalize_angle(x)
    let mut term = a
    let mut sum = a
    let a2 = a * a
    let mut n = 1
    while n <= 20 {
        term = -term * a2 / float((2 * n) * (2 * n + 1))
        sum = sum + term
        if abs(term) < 1.0e-16 {
            return sum
        }
        n = n + 1
    }
    return sum
}

/// Cosine via Taylor series.
fn cos(x: f64) -> f64 {
    let a = _normalize_angle(x)
    let mut term = 1.0
    let mut sum = 1.0
    let a2 = a * a
    let mut n = 1
    while n <= 20 {
        term = -term * a2 / float((2 * n - 1) * (2 * n))
        sum = sum + term
        if abs(term) < 1.0e-16 {
            return sum
        }
        n = n + 1
    }
    return sum
}

/// Tangent: sin(x) / cos(x).
fn tan(x: f64) -> f64 {
    let c = cos(x)
    if abs(c) < 1.0e-15 {
        if sin(x) > 0.0 {
            return INF
        }
        return NEG_INF
    }
    return sin(x) / c
}

/// Arcsine via Taylor series (valid for |x| <= 1).
fn asin(x: f64) -> f64 {
    if x < -1.0 or x > 1.0 {
        return NAN
    }
    if abs(x) > 0.7 {
        // Use identity: asin(x) = PI/2 - asin(sqrt(1 - x^2)) for |x| > 0.7
        let s = sign(x)
        return s * (PI / 2.0 - asin(sqrt(1.0 - x * x)))
    }
    // Taylor: x + x^3/6 + 3x^5/40 + ...
    let x2 = x * x
    let mut term = x
    let mut sum = x
    let mut n = 1
    while n <= 40 {
        term = term * x2 * float(2 * n - 1) * float(2 * n - 1) / (float(2 * n) * float(2 * n + 1))
        sum = sum + term
        if abs(term) < 1.0e-16 {
            return sum
        }
        n = n + 1
    }
    return sum
}

/// Arccosine: PI/2 - asin(x).
fn acos(x: f64) -> f64 {
    return PI / 2.0 - asin(x)
}

/// Arctangent via a Maclaurin series with TWO-stage range reduction.
fn atan(x: f64) -> f64 {
    // atan is odd: reduce to x >= 0 so the reductions below are symmetric.
    if x < 0.0 {
        return -atan(-x)
    }
    // Reciprocal identity: atan(x) = PI/2 - atan(1/x) for x > 1 -> |arg| <= 1.
    if x > 1.0 {
        return PI / 2.0 - atan(1.0 / x)
    }
    // The plain series `x - x^3/3 + x^5/5 - ...` converges FAR too slowly near
    // |x| = 1: `term = -term*x^2` with x^2 ~= 1 never shrinks, so the 50-term
    // cap returned a badly unconverged sum (atan(1.0) gave 0.79030 not 0.78540,
    // 0.63% error). Second reduction with atan(x) = PI/6 + atan((x - t)/(1 +
    // x*t)), t = tan(PI/6) = 1/sqrt(3): for x in (tan(PI/12), 1] this maps the
    // argument down to <= tan(PI/12) ~= 0.2679, where x^2 < 0.072 and the series
    // reaches 1e-16 in ~10 terms.
    if x > 0.26794919243112270 {
        let inv_sqrt3 = 0.5773502691896257
        let reduced = (x - inv_sqrt3) / (1.0 + x * inv_sqrt3)
        return 0.5235987755982988 + atan(reduced)
    }
    // Maclaurin series for x <= tan(PI/12).
    let x2 = x * x
    let mut term = x
    let mut sum = x
    let mut n = 1
    while n <= 50 {
        term = -term * x2
        sum = sum + term / float(2 * n + 1)
        if abs(term) < 1.0e-16 {
            return sum
        }
        n = n + 1
    }
    return sum
}

/// Two-argument arctangent: angle of the vector (x, y).
fn atan2(y: f64, x: f64) -> f64 {
    if x > 0.0 {
        return atan(y / x)
    }
    if x < 0.0 {
        if y >= 0.0 {
            return atan(y / x) + PI
        }
        return atan(y / x) - PI
    }
    // x == 0
    if y > 0.0 {
        return PI / 2.0
    }
    if y < 0.0 {
        return -PI / 2.0
    }
    return 0.0
}

// --- Hyperbolic functions ----------------------------------------------------

/// Hyperbolic sine: (e^x - e^-x) / 2.
fn sinh(x: f64) -> f64 {
    let ex = exp(x)
    return (ex - 1.0 / ex) / 2.0
}

/// Hyperbolic cosine: (e^x + e^-x) / 2.
fn cosh(x: f64) -> f64 {
    let ex = exp(x)
    return (ex + 1.0 / ex) / 2.0
}

/// Hyperbolic tangent: sinh(x) / cosh(x).
fn tanh(x: f64) -> f64 {
    if x > 20.0 {
        return 1.0
    }
    if x < -20.0 {
        return -1.0
    }
    let ex = exp(2.0 * x)
    return (ex - 1.0) / (ex + 1.0)
}

// --- Angle conversion --------------------------------------------------------

/// Convert radians to degrees.
fn degrees(radians: f64) -> f64 {
    return radians * 180.0 / PI
}

/// Convert degrees to radians.
fn radians(degrees: f64) -> f64 {
    return degrees * PI / 180.0
}

// --- Interpolation -----------------------------------------------------------

/// Linear interpolation between a and b by factor t in [0, 1].
fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

// --- Classification ----------------------------------------------------------

/// Check if a value is NaN (NaN != NaN is always true).
fn is_nan(x: f64) -> bool {
    return x != x
}

/// Check if a value is positive or negative infinity.
fn is_inf(x: f64) -> bool {
    return x == INF or x == NEG_INF
}

// --- Number theory -----------------------------------------------------------

/// Greatest common divisor (Euclidean algorithm).
fn gcd(a: i64, b: i64) -> i64 {
    // Integer Euclid. The previous implementation went through f64
    // (floor(x/y)*y), which loses precision above 2^53 -- gcd of two large
    // consecutive i64 values (coprime, answer 1) returned garbage because both
    // operands rounded to the same f64. Pure i64 modulo is exact.
    let mut x = if a < 0 { -a } else { a }
    let mut y = if b < 0 { -b } else { b }
    while y != 0 {
        let temp = y
        y = x % y
        x = temp
    }
    return x
}

/// Least common multiple.
fn lcm(a: i64, b: i64) -> i64 {
    if a == 0 or b == 0 {
        return 0
    }
    let g = gcd(a, b)
    // Pure-integer (absa/g)*absb -- the old `int(float(a)*float(b)/float(g))`
    // went through f64 (only 53 bits), so lcm(1000000007, 1000000009) lost the
    // low digits (...000 instead of ...063). Same fix already applied to
    // std::mathx::lcm and std::math::gcd. Divide before multiply to avoid an
    // intermediate i64 overflow.
    let absa = if a < 0 { 0 - a } else { a }
    let absb = if b < 0 { 0 - b } else { b }
    return (absa / g) * absb
}

/// Factorial of n (n must be >= 0).
fn factorial(n: i64) -> i64 {
    if n < 0 {
        throw "factorial: negative argument"
    }
    // 21! exceeds i64::MAX and would wrap to a negative/garbage value with no
    // error; reject it. 20! = 2432902008176640000 is the largest that fits.
    if n > 20 {
        throw "factorial: n > 20 overflows i64"
    }
    let mut result = 1
    let mut i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}
