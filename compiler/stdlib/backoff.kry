// ============================================================
// std.backoff -- Exponential backoff for retry loops.
// Pure: returns the next delay; the caller sleeps.
// ============================================================

/// Next exponential-backoff delay.
///   prev_ms = previous delay (0 for first call)
///   base_ms = base delay when prev_ms = 0
///   max_ms  = cap
fn next_delay(prev_ms: i64, base_ms: i64, max_ms: i64) -> i64 {
    if prev_ms <= 0 {
        let mut d = base_ms
        if d > max_ms {
            d = max_ms
        }
        return d
    }
    // Clamp BEFORE doubling: `prev_ms * 2` overflows i64 for a large prev_ms
    // and wraps to a NEGATIVE value, which the `> max_ms` cap then fails to
    // catch (it's already below max_ms), silently returning a negative delay.
    if prev_ms >= max_ms {
        return max_ms
    }
    let mut d = prev_ms * 2
    if d > max_ms {
        d = max_ms
    }
    return d
}

/// Total cumulative delay over `attempts` retries (no jitter).
fn total_delay(base_ms: i64, max_ms: i64, attempts: i64) -> i64 {
    let mut total: i64 = 0
    let mut d = base_ms
    let mut i: i64 = 0
    while i < attempts {
        total = total + d
        d = d * 2
        if d > max_ms { d = max_ms }
        i = i + 1
    }
    return total
}
