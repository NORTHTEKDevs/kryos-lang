// ============================================================
// std.fuzzy -- Fuzzy string matching.
// Levenshtein edit distance.
// Pure Kryos.
// ============================================================

use std::utf8::{codepoint_count}

/// Levenshtein edit distance between two strings.
/// Cost: insert/delete/substitute = 1.
///
/// Operates on Unicode CODEPOINTS, not raw UTF-8 bytes: `byte_at` is
/// char-indexed (returns the i-th codepoint) and `codepoint_count` gives the
/// character length, so a multibyte character (accent, CJK, emoji) counts as a
/// single edit. (The old byte-indexed version returned 2 for
/// levenshtein("café","cafe") instead of the correct 1.)
fn levenshtein(a: str, b: str) -> i64 {
    let m = codepoint_count(a)
    let n = codepoint_count(b)
    // codepoint_count returns -1 for invalid UTF-8; fall back to a
    // non-panicking byte-length delta so we never index past the string.
    if m < 0 or n < 0 {
        let la = len(a)
        let lb = len(b)
        if la > lb { return la - lb }
        return lb - la
    }
    if m == 0 { return n }
    if n == 0 { return m }

    // Two-row rolling table.
    let mut prev: [i64] = []
    let mut cur:  [i64] = []
    let mut j: i64 = 0
    while j <= n {
        prev = push(prev, j)
        cur = push(cur, 0)
        j = j + 1
    }

    let mut i: i64 = 1
    while i <= m {
        cur[0] = i
        let mut j2: i64 = 1
        while j2 <= n {
            let ac = byte_at(a, i - 1)
            let bc = byte_at(b, j2 - 1)
            let cost = if ac == bc { 0 } else { 1 }
            let del = prev[j2] + 1
            let ins = cur[j2 - 1] + 1
            let sub = prev[j2 - 1] + cost
            let mut m = del
            if ins < m { m = ins }
            if sub < m { m = sub }
            cur[j2] = m
            j2 = j2 + 1
        }
        // Swap (Kryos has no std::mem::swap; assign element-wise).
        let mut k: i64 = 0
        while k <= n {
            prev[k] = cur[k]
            k = k + 1
        }
        i = i + 1
    }
    return prev[n]
}

/// Return the closest match in `candidates` to `query`. Returns -1 if
/// no candidate is within `max_dist`.
fn closest(query: str, candidates: [str], max_dist: i64) -> i64 {
    let n = len(candidates)
    let mut best: i64 = -1
    let mut best_d: i64 = max_dist + 1
    let mut i: i64 = 0
    while i < n {
        let d = levenshtein(query, candidates[i])
        if d < best_d {
            best_d = d
            best = i
        }
        i = i + 1
    }
    if best_d > max_dist { return -1 }
    return best
}

/// Jaro similarity in [0.0, 1.0]: 1.0 = identical, 0.0 = no match.
fn jaro(a: str, b: str) -> f64 {
    // Codepoint lengths (see levenshtein): byte lengths mis-scored non-ASCII.
    // Invalid UTF-8 yields a negative length, which harmlessly short-circuits
    // every loop below to 0 matches -> returns 0.0 (no out-of-bounds).
    let la = codepoint_count(a)
    let lb = codepoint_count(b)
    if la == 0 and lb == 0 { return 1.0 }
    if la == 0 or lb == 0 { return 0.0 }

    let mut window = la
    if lb > la { window = lb }
    window = window / 2 - 1
    if window < 0 { window = 0 }

    let mut a_match: [i64] = []
    let mut i = 0
    while i < la {
        a_match = push(a_match, 0)
        i = i + 1
    }
    let mut b_match: [i64] = []
    i = 0
    while i < lb {
        b_match = push(b_match, 0)
        i = i + 1
    }

    let mut matches = 0
    i = 0
    while i < la {
        let mut lo = i - window
        if lo < 0 { lo = 0 }
        let mut hi = i + window + 1
        if hi > lb { hi = lb }
        let mut j = lo
        while j < hi {
            if b_match[j] == 0 and byte_at(a, i) == byte_at(b, j) {
                a_match[i] = 1
                b_match[j] = 1
                matches = matches + 1
                j = hi
            } else {
                j = j + 1
            }
        }
        i = i + 1
    }
    if matches == 0 { return 0.0 }

    // Count transpositions between matched characters.
    let mut transpositions = 0
    let mut k = 0
    i = 0
    while i < la {
        if a_match[i] == 1 {
            while b_match[k] == 0 {
                k = k + 1
            }
            if byte_at(a, i) != byte_at(b, k) {
                transpositions = transpositions + 1
            }
            k = k + 1
        }
        i = i + 1
    }

    let m = matches as f64
    let t = (transpositions / 2) as f64
    return ((m / (la as f64)) + (m / (lb as f64)) + ((m - t) / m)) / 3.0
}

/// Jaro-Winkler similarity in [0.0, 1.0]. Boosts the Jaro score for
/// strings sharing a common prefix (up to 4 chars), scaling factor 0.1.
fn jaro_winkler(a: str, b: str) -> f64 {
    let j = jaro(a, b)
    let mut prefix = 0
    let la = codepoint_count(a)
    let lb = codepoint_count(b)
    let mut max_prefix = 4
    if la < max_prefix { max_prefix = la }
    if lb < max_prefix { max_prefix = lb }
    let mut i = 0
    while i < max_prefix {
        if byte_at(a, i) == byte_at(b, i) {
            prefix = prefix + 1
            i = i + 1
        } else {
            i = max_prefix
        }
    }
    return j + (prefix as f64) * 0.1 * (1.0 - j)
}
