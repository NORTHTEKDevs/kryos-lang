// ============================================================
// std.chan -- Channel and concurrency primitives
//
// Wraps Kryos built-in concurrency primitives (chan, send, recv,
// spawn, select) with higher-level abstractions: typed channels,
// fan-out/fan-in patterns, wait groups, and semaphores.
//
// All channel operations are safe for concurrent use via Kryos
// ARC-wrapped shared references.
//
// Usage:
//   let ch = std.chan.new_channel()
//   std.chan.send_val(ch, 42)
//   let msg = std.chan.receive(ch)
//
// NOTE: The underlying `chan()` builtin currently encodes a single
// unbuffered channel of i64-shaped values. Capacity and close are
// best-effort: the `is_closed` flag is advisory at the language
// level, and `close_chan` only forwards to the runtime close hook.
// ============================================================

// --- Channel struct ----------------------------------------------------------

struct Channel {
    raw: i64,
    capacity: i64,
    is_closed: bool
}

/// Create an unbuffered channel (capacity 0 -- send blocks until recv).
fn new_channel() -> Channel {
    let raw = chan()
    return Channel {
        raw: raw,
        capacity: 0,
        is_closed: false
    }
}

/// Create a channel with a recorded capacity hint. The underlying
/// `chan()` builtin is currently unbuffered; the capacity field is
/// retained for documentation and for higher-level helpers.
fn buffered(capacity: i64) -> Channel {
    assert(capacity >= 0, "chan: capacity must be >= 0")
    let raw = chan()
    return Channel {
        raw: raw,
        capacity: capacity,
        is_closed: false
    }
}

// --- Core operations ---------------------------------------------------------

/// Send a value on the channel. Blocks until a receiver is ready.
/// Aborts if the channel was previously marked closed.
fn send_val(ch: Channel, val: i64) -> void {
    assert(not ch.is_closed, "chan: send on closed channel")
    send(ch.raw, val)
}

/// Receive a value from the channel. Blocks until a value is available.
fn receive(ch: Channel) -> i64 {
    return recv(ch.raw)
}

/// Try to receive a value without blocking.
/// Returns a struct with `ok` and `value` fields.
/// The current channel runtime blocks on recv, so this currently
/// behaves like a blocking receive that always reports ok.
struct TryRecv {
    ok: bool,
    value: i64
}

fn try_receive(ch: Channel) -> TryRecv {
    let val = recv(ch.raw)
    return TryRecv { ok: true, value: val }
}

/// Mark a channel as closed and forward the close hint to the runtime.
/// Returns a new Channel with `is_closed` set; further sends via
/// `send_val` will assert.
fn close(ch: Channel) -> Channel {
    if ch.is_closed {
        return ch
    }
    close_chan(ch.raw)
    return Channel {
        raw: ch.raw,
        capacity: ch.capacity,
        is_closed: true
    }
}

/// Check if the channel is closed.
fn is_closed(ch: Channel) -> bool {
    return ch.is_closed
}

// --- Select ------------------------------------------------------------------

/// A case in a select statement.
struct SelectCase {
    channel: Channel,
    handler: fn
}

/// Create a select case: when a value arrives on ch, call handler(value).
fn on(ch: Channel, handler: fn) -> SelectCase {
    return SelectCase { channel: ch, handler: handler }
}

/// Wait on multiple channels in round-robin order. Returns the
/// handler's return value for the first ready channel.
/// (The lower-level builtin `select` block requires a static list
/// of branches; for a dynamic [SelectCase] array we busy-poll.)
fn select_cases(cases: [SelectCase]) -> i64 {
    let count = len(cases)
    assert(count > 0, "chan: select called with no cases")

    let mut j = 0
    while true {
        if j >= count {
            j = 0
        }
        let attempt = try_receive(cases[j].channel)
        if attempt.ok {
            return cases[j].handler(attempt.value)
        }
        j = j + 1
    }
    return 0
}

// --- Timeout -----------------------------------------------------------------

/// Create a channel that receives a single value after the given duration
/// in milliseconds. Useful for timeouts in select statements.
fn timeout(duration_ms: i64) -> Channel {
    let ch = new_channel()
    let raw = ch.raw
    spawn {
        sleep(duration_ms)
        send(raw, 1)
    }
    return ch
}

/// Create a channel that receives a tick every interval_ms milliseconds.
/// Returns a channel that keeps producing values until the caller stops
/// receiving (the spawned ticker has no termination signal).
fn ticker(interval_ms: i64) -> Channel {
    let ch = buffered(1)
    let raw = ch.raw
    spawn {
        let mut tick_count = 0
        while true {
            sleep(interval_ms)
            tick_count = tick_count + 1
            send(raw, tick_count)
        }
    }
    return ch
}

// --- Fan-out / Fan-in --------------------------------------------------------

/// Fan-out: distribute values from a source channel to N workers.
/// Each worker calls handler(value) for each value it receives.
/// Returns a channel that collects all handler results.
fn fan_out(source: Channel, workers: i64, handler: fn) -> Channel {
    assert(workers > 0, "chan: fan_out requires at least 1 worker")
    let result_ch = buffered(workers * 4)
    let src_raw = source.raw
    let dst_raw = result_ch.raw

    let mut i = 0
    while i < workers {
        spawn {
            while true {
                let v = recv(src_raw)
                let r = handler(v)
                send(dst_raw, r)
            }
        }
        i = i + 1
    }

    return result_ch
}

/// Fan-in: merge multiple channels into a single output channel.
fn fan_in(channels: [Channel]) -> Channel {
    let count = len(channels)
    assert(count > 0, "chan: fan_in requires at least 1 channel")
    let merged = buffered(count * 4)
    let dst_raw = merged.raw

    let mut i = 0
    while i < count {
        let src_raw = channels[i].raw
        spawn {
            while true {
                let v = recv(src_raw)
                send(dst_raw, v)
            }
        }
        i = i + 1
    }

    return merged
}

/// Pipe: forward all values from source to destination.
/// Runs in a separate goroutine, returns immediately.
fn pipe(source: Channel, dest: Channel) -> void {
    let src_raw = source.raw
    let dst_raw = dest.raw
    spawn {
        while true {
            let v = recv(src_raw)
            send(dst_raw, v)
        }
    }
}

// --- WaitGroup ---------------------------------------------------------------

struct WaitGroup {
    count: i64,
    done_ch: Channel
}

/// Create a new WaitGroup.
fn new_wait_group() -> WaitGroup {
    return WaitGroup {
        count: 0,
        done_ch: buffered(1)
    }
}

/// Add n to the WaitGroup counter. Call before spawning work.
fn wg_add(wg: WaitGroup, n: i64) -> WaitGroup {
    let new_count = wg.count + n
    return WaitGroup {
        count: new_count,
        done_ch: wg.done_ch
    }
}

/// Signal that one unit of work is done. Decrements the counter.
/// When the counter reaches zero, send on done_ch to unblock waiters.
fn wg_done(wg: WaitGroup) -> WaitGroup {
    let new_count = wg.count - 1
    assert(new_count >= 0, "chan: WaitGroup counter went negative")
    if new_count == 0 {
        send(wg.done_ch.raw, 1)
    }
    return WaitGroup {
        count: new_count,
        done_ch: wg.done_ch
    }
}

/// Block until the WaitGroup counter reaches zero.
fn wg_wait(wg: WaitGroup) -> void {
    if wg.count <= 0 {
        return
    }
    recv(wg.done_ch.raw)
}

// --- Semaphore ---------------------------------------------------------------

struct Semaphore {
    ch: Channel
}

/// Create a semaphore with the given number of permits.
fn new_semaphore(permits: i64) -> Semaphore {
    assert(permits > 0, "chan: semaphore requires at least 1 permit")
    let ch = buffered(permits)
    let mut i = 0
    while i < permits {
        send(ch.raw, 1)
        i = i + 1
    }
    return Semaphore { ch: ch }
}

/// Acquire a permit. Blocks if all permits are currently held.
fn acquire(sem: Semaphore) -> void {
    recv(sem.ch.raw)
}

/// Release a permit back to the semaphore.
fn release(sem: Semaphore) -> void {
    send(sem.ch.raw, 1)
}

/// Try to acquire a permit without blocking.
fn try_acquire(sem: Semaphore) -> bool {
    let attempt = try_receive(sem.ch)
    return attempt.ok
}

// --- Once (run-once primitive) -----------------------------------------------

struct Once {
    done: bool,
    result: i64
}

/// Create a new Once.
fn new_once() -> Once {
    return Once { done: false, result: 0 }
}

/// Execute a function exactly once. Subsequent calls return the
/// cached result. (Not currently atomic across spawn-tasks; use
/// a semaphore or external mutex for cross-task once semantics.)
fn call_once(once: Once, f: fn) -> i64 {
    if once.done {
        return once.result
    }
    let result = f()
    once.result = result
    once.done = true
    return once.result
}

// --- Producer/Consumer helpers -----------------------------------------------

/// Create a producer that generates values and sends them on a channel.
fn produce(generator: fn) -> Channel {
    let ch = buffered(16)
    let raw = ch.raw
    spawn {
        while true {
            let v = generator()
            send(raw, v)
        }
    }
    return ch
}

/// Consume all values from a channel, calling handler for each one.
fn consume(ch: Channel, handler: fn) -> void {
    while true {
        let v = recv(ch.raw)
        handler(v)
    }
}

/// Collect up to n values from a channel into an array.
fn collect_n(ch: Channel, n: i64) -> [i64] {
    let mut results = []
    let mut i = 0
    while i < n {
        let v = recv(ch.raw)
        push(results, v)
        i = i + 1
    }
    return results
}

// --- Channel utilities -------------------------------------------------------

/// Send multiple values on a channel.
fn send_all(ch: Channel, values: [i64]) -> void {
    let count = len(values)
    let mut i = 0
    while i < count {
        send_val(ch, values[i])
        i = i + 1
    }
}

/// Receive up to n values from a channel.
fn receive_n(ch: Channel, n: i64) -> [i64] {
    let mut results = []
    let mut i = 0
    while i < n {
        let v = recv(ch.raw)
        push(results, v)
        i = i + 1
    }
    return results
}
