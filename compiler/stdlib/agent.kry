let ALIGNMENT_STRICT = 0

let ALIGNMENT_STANDARD = 1

let ALIGNMENT_MINIMAL = 2

let ALIGNMENT_UNRESTRICTED = 3

// Alignment enforcement (B2): an ALIGNMENT_STRICT agent refuses to invoke tools
// whose name matches a conservative risky-verb deny-list (mutating or outbound
// side effects). This makes the `alignment` field BEHAVIORAL rather than
// advisory. Only STRICT is gated; STANDARD/MINIMAL/UNRESTRICTED allow all tools,
// so default (STANDARD) agents are unaffected. It is a name-heuristic guardrail,
// not a sandbox - pair with @capabilities for hard enforcement.
fn _tool_lower(s: str) -> str {
    let mut out = ""
    let mut i = 0
    let n = len(s)
    while i < n {
        let c = char_code(substr(s, i, i + 1))
        if c >= 65 and c <= 90 {
            out = out + char_from(c + 32)
        } else {
            out = out + substr(s, i, i + 1)
        }
        i = i + 1
    }
    return out
}

fn _tool_is_risky(tool_name: str) -> bool {
    // Case-fold first: the deny-list verbs are lowercase and `contains` is a
    // case-sensitive byte match, so a PascalCase/UPPER tool name (DeleteFile,
    // SendEmail, EXEC) slipped past a STRICT-alignment agent's refusal.
    let name = _tool_lower(tool_name)
    if contains(name, "delete") { return true }
    if contains(name, "remove") { return true }
    if contains(name, "write") { return true }
    if contains(name, "exec") { return true }
    if contains(name, "spawn") { return true }
    if contains(name, "pay") { return true }
    if contains(name, "transfer") { return true }
    if contains(name, "send") { return true }
    if contains(name, "email") { return true }
    return false
}

let STATE_CREATED = 0

let STATE_RUNNING = 1

let STATE_PAUSED = 2

let STATE_COMPLETED = 3

let STATE_FAILED = 4

let STATE_TERMINATED = 5

struct MemoryEntry {
    key: str
    value: str
    memory_type: str
    timestamp: i64
}

struct AgentMemory {
    working: [MemoryEntry]
    semantic: [MemoryEntry]
    episodic: [MemoryEntry]
}

fn agent_memory_new() -> AgentMemory {
    return AgentMemory { working: [], semantic: [], episodic: [] }
}

impl AgentMemory {
    fn remember(
        self: AgentMemory,
        key: str,
        value: str,
        memory_type: str
    ) -> AgentMemory {
        let entry = MemoryEntry { key: key, value: value, memory_type: memory_type, timestamp: time_now() }
        // Extract fields to locals so each is moved exactly once per branch.
        let w = self.working
        let s = self.semantic
        let e = self.episodic
        if memory_type == "working" {
            return AgentMemory { working: push(w, entry), semantic: s, episodic: e }
        } else {
            if memory_type == "semantic" {
                return AgentMemory { working: w, semantic: push(s, entry), episodic: e }
            } else {
                return AgentMemory { working: w, semantic: s, episodic: push(e, entry) }
            }
        }
    }

    fn recall(self: AgentMemory, key: str) -> str {
        let mut i = len(self.working) - 1
        while i >= 0 {
            if self.working[i].key == key {
                return self.working[i].value
            }
            i = i - 1
        }
        i = len(self.semantic) - 1
        while i >= 0 {
            if self.semantic[i].key == key {
                return self.semantic[i].value
            }
            i = i - 1
        }
        return ""
    }

    fn clear_working(self: AgentMemory) -> AgentMemory {
        return AgentMemory { working: [], semantic: self.semantic, episodic: self.episodic }
    }
}

struct AuditEntry {
    id: i64
    entry_type: str
    description: str
    success: bool
    timestamp: i64
    cost_usd: f64
    latency_ms: f64
}

struct AgentTool {
    name: str
    description: str
    handler: fn(str) -> str
}

struct Agent {
    name: str
    goal: str
    alignment: i64
    state: i64
    memory: AgentMemory
    tools: [AgentTool]
    audit_trail: [AuditEntry]
    action_count: i64
    total_cost: f64
    capabilities: [str]
}

fn agent_new(name: str, goal: str) -> Agent {
    return Agent { name: name, goal: goal, alignment: ALIGNMENT_STANDARD, state: STATE_CREATED, memory: agent_memory_new(), tools: [], audit_trail: [], action_count: 0, total_cost: 0.0, capabilities: [] }
}

fn agent_with_alignment(name: str, goal: str, alignment: i64) -> Agent {
    let a = agent_new(name, goal)
    return Agent { name: a.name, goal: a.goal, alignment: alignment, state: a.state, memory: a.memory, tools: a.tools, audit_trail: a.audit_trail, action_count: a.action_count, total_cost: a.total_cost, capabilities: a.capabilities }
}

impl Agent {
    fn add_tool(
        self: Agent,
        name: str,
        handler: fn(str) -> str,
        description: str
    ) -> Agent {
        let tool = AgentTool { name: name, description: description, handler: handler }
        return Agent { name: self.name, goal: self.goal, alignment: self.alignment, state: self.state, memory: self.memory, tools: push(self.tools, tool), audit_trail: self.audit_trail, action_count: self.action_count, total_cost: self.total_cost, capabilities: push(self.capabilities, name) }
    }

    fn use_tool(self: Agent, tool_name: str, input: str) -> str {
        // Alignment enforcement: a STRICT agent refuses risky (mutating/outbound)
        // tools before dispatch. Other alignments allow all registered tools.
        if self.alignment == ALIGNMENT_STRICT {
            if _tool_is_risky(tool_name) {
                throw "alignment violation: STRICT agent `" + self.name + "` refused risky tool `" + tool_name + "`"
            }
        }
        let mut i = 0
        while i < len(self.tools) {
            if self.tools[i].name == tool_name {
                return self.tools[i].handler(input)
            }
            i = i + 1
        }
        throw "agent error: tool not found: " + tool_name
    }

    fn spawn_child(self: Agent, name: str, goal: str) -> Agent {
        return Agent { name: name, goal: goal, alignment: self.alignment, state: STATE_CREATED, memory: agent_memory_new(), tools: self.tools, audit_trail: [], action_count: 0, total_cost: 0.0, capabilities: self.capabilities }
    }

    fn pause(self: Agent) -> Agent {
        return Agent { name: self.name, goal: self.goal, alignment: self.alignment, state: STATE_PAUSED, memory: self.memory, tools: self.tools, audit_trail: self.audit_trail, action_count: self.action_count, total_cost: self.total_cost, capabilities: self.capabilities }
    }

    fn resume(self: Agent) -> Agent {
        return Agent { name: self.name, goal: self.goal, alignment: self.alignment, state: STATE_RUNNING, memory: self.memory, tools: self.tools, audit_trail: self.audit_trail, action_count: self.action_count, total_cost: self.total_cost, capabilities: self.capabilities }
    }

    fn terminate(self: Agent) -> Agent {
        return Agent { name: self.name, goal: self.goal, alignment: self.alignment, state: STATE_TERMINATED, memory: self.memory, tools: self.tools, audit_trail: self.audit_trail, action_count: self.action_count, total_cost: self.total_cost, capabilities: self.capabilities }
    }

    fn get_audit_trail(self: Agent) -> [AuditEntry] {
        return self.audit_trail
    }

    fn status(self: Agent) -> str {
        let state_names = ["CREATED", "RUNNING", "PAUSED", "COMPLETED", "FAILED", "TERMINATED"]
        let alignment_names = ["STRICT", "STANDARD", "MINIMAL", "UNRESTRICTED"]
        // Cast f64 total_cost to micro-USD (i64) to avoid to_string(f64) which
        // is unsupported in the Cranelift JIT backend.
        let cost_int: i64 = (self.total_cost * 1000000.0) as i64
        return "Agent: " + self.name + "\n" + "Goal: " + self.goal + "\n" + "State: " + state_names[self.state] + "\n" + "Alignment: " + alignment_names[self.alignment] + "\n" + "Actions: " + to_string(self.action_count) + "\n" + "Total cost: $" + to_string(cost_int) + "e-6\n" + "Tools: " + to_string(len(self.tools))
    }
}

struct AgentSwarm {
    name: str
    agents: [Agent]
}

fn agent_swarm(name: str) -> AgentSwarm {
    return AgentSwarm { name: name, agents: [] }
}

impl AgentSwarm {
    fn add(self: AgentSwarm, agent: Agent) -> AgentSwarm {
        return AgentSwarm { name: self.name, agents: push(self.agents, agent) }
    }

    fn terminate_all(self: AgentSwarm) -> AgentSwarm {
        let mut terminated = []
        let mut i = 0
        while i < len(self.agents) {
            terminated = push(terminated, self.agents[i].terminate())
            i = i + 1
        }
        return AgentSwarm { name: self.name, agents: terminated }
    }
}
