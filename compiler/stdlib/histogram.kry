// ============================================================
// std.histogram -- Fixed-bucket histogram.
//
// State: a [i64] of length (edges + 1).
//   counts[0]      — underflow (< edges[0])
//   counts[1..=N]  — bucket i: [edges[i-1], edges[i])
//   counts[N+1]    — overflow (>= edges[N])
// ============================================================

/// Create an empty count array with the right shape for `edges`.
fn new_counts(edges: [i64]) -> [i64] {
    let mut out: [i64] = []
    let n = len(edges) + 1
    let mut i: i64 = 0
    while i < n {
        out = push(out, 0)
        i = i + 1
    }
    return out
}

/// Increment the bucket whose range contains `value`.
fn record(edges: [i64], counts: [i64], value: i64) {
    let n_edges = len(edges)
    if value < edges[0] {
        counts[0] = counts[0] + 1
        return
    }
    // Linear scan from the back to find the right bucket.
    let mut i: i64 = n_edges - 1
    while i >= 0 {
        if value >= edges[i] {
            if i + 1 < n_edges {
                counts[i + 1] = counts[i + 1] + 1
            } else {
                counts[n_edges] = counts[n_edges] + 1
            }
            return
        }
        i = i - 1
    }
    counts[0] = counts[0] + 1
}

/// Sum of all counts.
fn total(counts: [i64]) -> i64 {
    let n = len(counts)
    let mut s: i64 = 0
    let mut i: i64 = 0
    while i < n {
        s = s + counts[i]
        i = i + 1
    }
    return s
}

/// Percentile: returns the edge above which fraction p/100 of samples fall.
fn percentile(edges: [i64], counts: [i64], p: i64) -> i64 {
    let t = total(counts)
    if t == 0 {
        return edges[len(edges) - 1]
    }
    let target = (t * p) / 100
    let mut cum: i64 = 0
    let n_edges = len(edges)
    let mut i: i64 = 1
    while i <= n_edges {
        cum = cum + counts[i]
        if cum >= target {
            let idx = if i - 1 >= n_edges { n_edges - 1 } else { i - 1 }
            return edges[idx]
        }
        i = i + 1
    }
    return edges[n_edges - 1]
}
