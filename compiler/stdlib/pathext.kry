// ============================================================
// std.pathext -- Pure string-based path manipulation.
// No filesystem syscalls.
// ============================================================

/// Is `p` an absolute path on the current platform? POSIX `/` or
/// Windows-style `C:/`.
fn is_absolute(p: str) -> bool {
    let n = len(p)
    if n == 0 { return false }
    // A leading `/` (POSIX root) or `\` (Windows/UNC root, e.g. \\server\share).
    if substr(p, 0, 1) == "/" || substr(p, 0, 1) == "\\" { return true }
    if n >= 3 {
        let c0 = char_code(substr(p, 0, 1))
        let is_alpha = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)
        if is_alpha && substr(p, 1, 2) == ":" {
            let c2 = substr(p, 2, 3)
            if c2 == "/" || c2 == "\\" { return true }
        }
    }
    return false
}

/// Number of non-empty path components (after `\` → `/` normalization).
fn component_count(p: str) -> i64 {
    let cleaned = normalize_slashes(p)
    let n = len(cleaned)
    let mut count: i64 = 0
    let mut i: i64 = 0
    let mut in_seg = false
    while i < n {
        let c = substr(cleaned, i, i + 1)
        if c == "/" {
            in_seg = false
        } elif !in_seg {
            count = count + 1
            in_seg = true
        }
        i = i + 1
    }
    return count
}

/// Replace backslashes with forward slashes.
fn normalize_slashes(p: str) -> str {
    let n = len(p)
    let mut out: str = ""
    let mut i: i64 = 0
    while i < n {
        let c = substr(p, i, i + 1)
        if c == "\\" {
            out = out + "/"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

/// Lexically normalize: collapse "/./", resolve "/../", coalesce runs of "/".
fn normalize(p: str) -> str {
    let cleaned = normalize_slashes(p)
    let is_abs = is_absolute(cleaned)
    let parts = split_on_slash(cleaned)
    // Detect a Windows drive-letter anchor ("C:") in the first component so it
    // is the ROOT: not popped by "..", not treated as a poppable segment, and
    // not POSIX-slash-prefixed. Without this, normalize("C:/Users/foo") gave
    // "/C:/Users/foo", and "C:/a/../../x" popped past the drive to a bogus
    // relative "x" (a path-traversal footgun).
    let mut drive: str = ""
    let mut unc: str = ""
    let mut start_idx: i64 = 0
    let np = len(parts)
    // UNC anchor: \\server\share (normalized //server/share). server AND share
    // are the root; ".." must not pop past them (else it escapes to "/x").
    let is_unc = len(cleaned) >= 2 && substr(cleaned, 0, 2) == "//"
    if is_unc && np >= 2 {
        unc = "//" + parts[0] + "/" + parts[1]
        start_idx = 2
    } elif np > 0 {
        let p0 = parts[0]
        if len(p0) == 2 && substr(p0, 1, 2) == ":" {
            let c0 = char_code(substr(p0, 0, 1))
            let is_alpha = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)
            if is_alpha {
                drive = p0
                start_idx = 1
            }
        }
    }
    let mut stack: [str] = []
    let mut i: i64 = start_idx
    while i < np {
        let seg = parts[i]
        if len(seg) == 0 || seg == "." {
            // skip
        } elif seg == ".." {
            let sl = len(stack)
            if sl > 0 && stack[sl - 1] != ".." {
                stack = pop_last(stack)
            } elif !is_abs {
                stack = push(stack, "..")
            }
            // Absolute (drive or "/"): a ".." at the root is dropped -- you
            // cannot traverse above the root.
        } else {
            stack = push(stack, seg)
        }
        i = i + 1
    }
    let mut out: str = if len(unc) > 0 { unc + "/" } elif len(drive) > 0 { drive + "/" } elif is_abs { "/" } else { "" }
    let mut j: i64 = 0
    let sl = len(stack)
    while j < sl {
        if j > 0 { out = out + "/" }
        out = out + stack[j]
        j = j + 1
    }
    if len(out) == 0 { return "." }
    return out
}

fn split_on_slash(p: str) -> [str] {
    let mut out: [str] = []
    let n = len(p)
    let mut start: i64 = 0
    let mut i: i64 = 0
    while i < n {
        if substr(p, i, i + 1) == "/" {
            if i > start { out = push(out, substr(p, start, i)) }
            start = i + 1
        }
        i = i + 1
    }
    if n > start { out = push(out, substr(p, start, n)) }
    return out
}

fn pop_last(arr: [str]) -> [str] {
    let n = len(arr)
    if n == 0 { return arr }
    let mut out: [str] = []
    let mut i: i64 = 0
    while i < n - 1 {
        out = push(out, arr[i])
        i = i + 1
    }
    return out
}
