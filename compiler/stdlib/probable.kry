// ============================================================
// std.probable -- Confidence-aware values for AI predictions.
//
// Probable<T> makes uncertainty a first-class concept: values carry
// confidence scores that propagate through computation. Generic since
// v4.47 (was str-only). Operations are free generic functions -- generic
// `impl` blocks are not yet supported by the checker.
//
//   use std::probable::{Probable, probable, certain, or_else}
//   use std::probable::{CalibrationSample, CalibrationTracker, calibration_tracker, add_sample, add_probable_sample, ece, calibration_summary}
//
//   let guess: Probable<f64> = probable(0.82, 0.65)
//   let safe = or_else(guess, 0.0)
// ============================================================

use std::math::{log2}

// ----- Calibration: measure whether confidence values are accurate -----
// CalibrationSample records one (stated confidence, was-correct) outcome.
// CalibrationTracker accumulates samples; ece() computes Expected
// Calibration Error, turning a Probable<T>'s confidence into a measured
// quantity rather than a programmer assertion. ECE assumes a classification
// setting where `correct` is well-defined (a known label / ground truth);
// on open-ended generation it measures the judge, not the generator.

@copy
struct CalibrationSample {
    predicted: f64,
    correct: bool,
}

struct CalibrationTracker {
    samples: [CalibrationSample],
    bins: i64,
}

struct Probable<T> {
    value: T,
    confidence: f64,
    source: str,
}

/// Wrap a value with a confidence score in [0.0, 1.0].
fn probable<T>(value: T, confidence: f64) -> Probable<T> {
    let mut c = confidence
    if c < 0.0 { c = 0.0 }
    if c > 1.0 { c = 1.0 }
    return Probable { value: value, confidence: c, source: "" }
}

/// A 100% certain value.
fn certain<T>(value: T) -> Probable<T> {
    return Probable { value: value, confidence: 1.0, source: "" }
}

/// Tag where the value came from (model name, sensor id, ...).
fn with_source<T>(p: Probable<T>, source: str) -> Probable<T> {
    return Probable { value: p.value, confidence: p.confidence, source: source }
}

/// Transform the value; confidence is preserved (a deterministic
/// transformation adds no new uncertainty).
fn map_value<T>(p: Probable<T>, transform_fn: fn(T) -> T) -> Probable<T> {
    return Probable { value: transform_fn(p.value), confidence: p.confidence, source: p.source }
}

/// True when confidence meets the threshold.
fn is_confident<T>(p: Probable<T>, threshold: f64) -> bool {
    return p.confidence >= threshold
}

/// Unwrap the value, throwing when confidence is below the threshold.
fn require_confidence<T>(p: Probable<T>, threshold: f64) -> T {
    if p.confidence < threshold {
        throw "probable error: confidence " + to_string(p.confidence) + " below required " + to_string(threshold)
    }
    return p.value
}

/// Unwrap the value, or the fallback when confidence is below 0.5.
fn or_else<T>(p: Probable<T>, fallback: T) -> T {
    if p.confidence >= 0.5 {
        return p.value
    }
    return fallback
}

/// Combine two probable values; the result confidence is the product
/// (both must hold for the combination to hold).
fn combine<T>(a: Probable<T>, b: Probable<T>, combine_fn: fn(T, T) -> T) -> Probable<T> {
    return Probable {
        value: combine_fn(a.value, b.value),
        confidence: a.confidence * b.confidence,
        source: a.source
    }
}

/// Shannon entropy of the binary outcome (certain either way = 0 bits,
/// coin flip = 1 bit).
fn entropy<T>(p: Probable<T>) -> f64 {
    let c = p.confidence
    if c <= 0.0 or c >= 1.0 {
        return 0.0
    }
    let q = 1.0 - c
    return 0.0 - (c * log2(c) + q * log2(q))
}

/// Pick the highest-confidence prediction from an ensemble.
fn best_of<T>(predictions: [Probable<T>]) -> Probable<T> {
    if len(predictions) == 0 {
        throw "probable error: best_of on empty ensemble"
    }
    let mut best = predictions[0]
    for p in predictions {
        if p.confidence > best.confidence {
            best = p
        }
    }
    // Rebuild rather than returning the element alias: a struct literal
    // retains refcounted fields read from another struct, so the result
    // owns its own +1 (returning `best` directly shares the array
    // element's string -- double free at teardown; see
    // compiler/tests/fixtures/combined_teardown_127.kry).
    return Probable { value: best.value, confidence: best.confidence, source: best.source }
}

/// Majority vote over an ensemble: the value backed by the largest summed
/// confidence wins; the result confidence is its share of the total.
fn majority_vote<T>(predictions: [Probable<T>]) -> Probable<T> {
    if len(predictions) == 0 {
        throw "probable error: majority_vote on empty ensemble"
    }
    let n = len(predictions)
    let mut total = 0.0
    for p in predictions {
        total = total + p.confidence
    }
    let mut best_idx = 0
    let mut best_sum = 0.0
    let mut i = 0
    while i < n {
        // Copy elements to locals before field access: chained
        // indexed-field access on a generic struct array
        // (predictions[j].confidence) mistypes f64 loads in monomorphized
        // code -- compiler gap, fixture filed.
        let pi = predictions[i]
        let mut sum = 0.0
        let mut j = 0
        while j < n {
            let pj = predictions[j]
            if pj.value == pi.value {
                sum = sum + pj.confidence
            }
            j = j + 1
        }
        if sum > best_sum {
            best_sum = sum
            best_idx = i
        }
        i = i + 1
    }
    let winner = predictions[best_idx]
    let mut conf = 0.0
    if total > 0.0 {
        conf = best_sum / total
    }
    return Probable { value: winner.value, confidence: conf, source: winner.source }
}

/// Create a new CalibrationTracker with a given number of confidence bins.
/// bins = 10 gives deciles (0.0-0.1, 0.1-0.2, ..., 0.9-1.0). Clamped to >= 2.
fn calibration_tracker(bins: i64) -> CalibrationTracker {
    let mut b = bins
    if b < 2 { b = 2 }
    return CalibrationTracker { samples: [], bins: b }
}

/// Record one prediction outcome: the stated confidence (typically taken from
/// Probable<T>.confidence) and whether the prediction was actually correct.
/// Confidence is clamped to [0.0, 1.0]; NaN is treated as 0.0. Returns a new
/// tracker -- the module's operations are functional/immutable, avoiding the
/// alias caveats in gotcha 23. Note: accumulating n samples via a
/// `t = add_sample(t, ..)` loop reallocates the array each call, so building a
/// tracker of n samples costs O(n^2) total -- fine for hundreds to a few
/// thousand; batch differently for very large n.
fn add_sample(tracker: CalibrationTracker, confidence: f64, correct: bool) -> CalibrationTracker {
    let mut c = confidence
    // NaN fails every comparison, so it slips past the range clamps below and
    // would then bin to index 0 (NaN as i64 == 0), poisoning the ECE sum. Map
    // it to 0.0 -- a NaN confidence is an upstream error; treat it as none.
    if c != c { c = 0.0 }
    if c < 0.0 { c = 0.0 }
    if c > 1.0 { c = 1.0 }
    let sample = CalibrationSample { predicted: c, correct: correct }
    return CalibrationTracker {
        samples: push(tracker.samples, sample),
        bins: tracker.bins
    }
}

/// Expected Calibration Error over all recorded samples. Returns a value in
/// [0.0, 1.0]: lower is better, 0.0 is perfectly calibrated. Returns 0.0 when
/// no samples have been recorded.
///
/// ECE = sum over bins of (bin's share of samples) * |avg confidence in bin
/// - accuracy in bin|. A sample with confidence p is placed in bin
/// floor(p * bins), clamped to the last bin so p == 1.0 is included.
fn ece(tracker: CalibrationTracker) -> f64 {
    let n = len(tracker.samples)
    if n == 0 {
        return 0.0
    }
    let mut total_ece = 0.0
    let mut b = 0
    while b < tracker.bins {
        let mut bin_count = 0
        let mut bin_correct = 0
        let mut bin_conf_sum = 0.0
        let mut i = 0
        while i < n {
            let s = tracker.samples[i]
            // Bin index = floor(predicted * bins), clamped to the last bin so
            // confidence == 1.0 (which maps to `bins`) lands in [bins-1].
            // Computing the index directly avoids the float drift between a
            // separate lo = b*width and hi = lo+width pair, which left a 1-ULP
            // gap that silently dropped values such as 0.6 with 10 bins.
            // NaN never reaches here: add_sample maps NaN to 0.0.
            let mut idx = (s.predicted * (tracker.bins as f64)) as i64
            if idx < 0 { idx = 0 }
            if idx >= tracker.bins { idx = tracker.bins - 1 }
            if idx == b {
                bin_count = bin_count + 1
                bin_conf_sum = bin_conf_sum + s.predicted
                if s.correct { bin_correct = bin_correct + 1 }
            }
            i = i + 1
        }
        if bin_count > 0 {
            let avg_conf = bin_conf_sum / (bin_count as f64)
            let acc = (bin_correct as f64) / (bin_count as f64)
            let weight = (bin_count as f64) / (n as f64)
            // Inline abs (the builtin would work -- std::math abs is not
            // imported here -- but inlining avoids any future shadowing risk).
            let mut abs_diff = avg_conf - acc
            if abs_diff < 0.0 { abs_diff = 0.0 - abs_diff }
            total_ece = total_ece + weight * abs_diff
        }
        b = b + 1
    }
    return total_ece
}

/// Record a Probable<T> outcome directly: pulls the confidence from `p` and
/// pairs it with the caller-supplied `correct` flag. Convenience wrapper over
/// add_sample for the common case where the confidence comes from a Probable.
fn add_probable_sample<T>(tracker: CalibrationTracker, p: Probable<T>, correct: bool) -> CalibrationTracker {
    return add_sample(tracker, p.confidence, correct)
}

/// Human-readable calibration report: total sample count, overall ECE, and a
/// per-bin breakdown (non-empty bins only) of each bin's count, average stated
/// confidence, and empirical accuracy -- so a reader can see exactly which
/// confidence range is miscalibrated and by how much. Uses the same floor-index
/// binning as ece(); the [lo-hi] labels are the bin's nominal range.
fn calibration_summary(tracker: CalibrationTracker) -> str {
    let n = len(tracker.samples)
    let error = ece(tracker)
    let mut out = "CalibrationTracker: " + to_string(n) + " samples, ECE=" + to_string(error) + "\n"
    let bin_width = 1.0 / (tracker.bins as f64)
    let mut b = 0
    while b < tracker.bins {
        let mut bin_count = 0
        let mut bin_correct = 0
        let mut bin_conf_sum = 0.0
        let mut i = 0
        while i < n {
            let s = tracker.samples[i]
            // Same floor-index binning as ece(): bin = floor(predicted * bins),
            // clamped to the last bin so confidence == 1.0 is included.
            let mut idx = (s.predicted * (tracker.bins as f64)) as i64
            if idx < 0 { idx = 0 }
            if idx >= tracker.bins { idx = tracker.bins - 1 }
            if idx == b {
                bin_count = bin_count + 1
                bin_conf_sum = bin_conf_sum + s.predicted
                if s.correct { bin_correct = bin_correct + 1 }
            }
            i = i + 1
        }
        if bin_count > 0 {
            let lo = (b as f64) * bin_width
            let hi = lo + bin_width
            let avg_conf = bin_conf_sum / (bin_count as f64)
            let acc = (bin_correct as f64) / (bin_count as f64)
            out = out + "  [" + to_string(lo) + "-" + to_string(hi) + "] "
            out = out + "n=" + to_string(bin_count)
            out = out + " avg_conf=" + to_string(avg_conf)
            out = out + " acc=" + to_string(acc) + "\n"
        }
        b = b + 1
    }
    return out
}
