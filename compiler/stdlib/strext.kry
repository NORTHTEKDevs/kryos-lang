// ============================================================
// std.strext -- Extended string ops beyond builtins.
// ============================================================

// Delegate case conversion to the Unicode-aware runtime builtins (see
// std::string — an ASCII-only loop here silently downgraded casing for
// importers of these module fns, which shadow the global builtins).
extern {
    fn kryos_builtin_to_upper(s: str) -> str
    fn kryos_builtin_to_lower(s: str) -> str
}

/// Convert every character to lowercase (Unicode-aware, same as the global
/// `to_lower` builtin).
fn to_lower(s: str) -> str {
    return kryos_builtin_to_lower(s)
}

/// Convert every character to uppercase (Unicode-aware, same as the global
/// `to_upper` builtin).
fn to_upper(s: str) -> str {
    return kryos_builtin_to_upper(s)
}

/// Count non-overlapping occurrences of `needle` in `haystack`.
fn count_occurrences(haystack: str, needle: str) -> i64 {
    let hn = len(haystack)
    let nn = len(needle)
    if nn == 0 || nn > hn { return 0 }
    let mut count: i64 = 0
    let mut i: i64 = 0
    while i + nn <= hn {
        if substr(haystack, i, i + nn) == needle {
            count = count + 1
            i = i + nn
        } else {
            i = i + 1
        }
    }
    return count
}

/// Strip leading + trailing ASCII whitespace.
fn trim(s: str) -> str {
    let n = len(s)
    let mut start: i64 = 0
    while start < n {
        let c = char_code(substr(s, start, start + 1))
        if c == 32 || c == 9 || c == 10 || c == 13 {
            start = start + 1
        } else {
            break
        }
    }
    let mut end: i64 = n
    while end > start {
        let c = char_code(substr(s, end - 1, end))
        if c == 32 || c == 9 || c == 10 || c == 13 {
            end = end - 1
        } else {
            break
        }
    }
    return substr(s, start, end)
}
