// Validates uds_bind/uds_close LINK through LLVM --release.
// On Unix uds_bind returns a real fd; on Windows the runtime exposes
// documented -1 stubs (see kryos-stdlib-native/src/unix_socket.rs).
// This test validates symbol linkage + call/return on every host, so it
// does not assert bind success. Unique path avoids stale-socket clashes.
// expect-stdout: done
@capabilities(net, process)
fn main() {
    let mut dir = env_get("TEMP")
    if len(dir) == 0 { dir = env_get("TMPDIR") }
    if len(dir) == 0 { dir = "/tmp" }
    let path = dir + "/kryos_uds_" + to_string(time_now()) + ".sock"
    let fd = uds_bind(path)
    uds_close(fd)
    println("done")
}
