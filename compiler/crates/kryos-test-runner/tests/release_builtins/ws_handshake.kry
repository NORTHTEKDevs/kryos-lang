// Validates ws_accept_key against RFC 6455 reference vector through LLVM --release.
// expect-stdout: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=
// expect-stdout: OK
fn main() {
    let key = "dGhlIHNhbXBsZSBub25jZQ=="
    let got = ws_accept_key(key)
    let expected = "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
    println(got)
    if got == expected {
        println("OK")
    } else {
        println("FAIL")
    }
}
