// Real cooperative async executor — runtime-API interleaving proof.
// Two tasks each yield 3x; real interleaving => "A0 B0 A1 B1 A2 B2".
// expect-stdout: order: A0 B0 A1 B1 A2 B2
// expect-stdout: PASS: real cooperative interleaving
// expect-exit: 0

fn task_a() {
    let mut i = 0
    while i < 3 {
        coop_record("A" + to_string(i))
        coop_yield()
        i = i + 1
    }
}

fn task_b() {
    let mut i = 0
    while i < 3 {
        coop_record("B" + to_string(i))
        coop_yield()
        i = i + 1
    }
}

fn main() {
    coop_reset()
    coop_spawn(task_a())
    coop_spawn(task_b())
    coop_run()

    let order: str = coop_order()
    println("order: " + order)
    if order != "A0 B0 A1 B1 A2 B2" {
        println("FAIL: not interleaved: " + order)
        exit(1)
    }
    println("PASS: real cooperative interleaving")
}
