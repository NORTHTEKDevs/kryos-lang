// Shared references — verify shared values can be used after aliasing.
// The `shared` keyword wraps a value in ARC. Both a and b
// hold a reference-counted handle to the same underlying data.
// expect-stdout: 42
// expect-stdout: 42
fn main() {
    let a = shared 42
    let b = a
    println(to_string(*a))
    println(to_string(*b))
}
