// expect-stdout: ok: zeros
// expect-stdout: ok: matmul
// expect-stdout: ok: numel
extern {
    fn kryos_tensor_zeros(shape_ptr: i64, ndim: i64) -> i64
    fn kryos_tensor_ones(shape_ptr: i64, ndim: i64) -> i64
    fn kryos_tensor_matmul(a: i64, b: i64) -> i64
    fn kryos_tensor_get(handle: i64, idx: i64) -> i64
    fn kryos_tensor_numel(handle: i64) -> i64
}

fn main() {
    // Test zeros: 2x3 tensor should have 6 elements
    let shape1 = [2, 3]
    let z = kryos_tensor_zeros(shape1 as i64, 2)
    let n = kryos_tensor_numel(z)
    if n == 6 {
        println("ok: zeros")
    }

    // Test matmul: ones(2,3) @ ones(3,2) should produce a 2x2 tensor
    let shape_a = [2, 3]
    let shape_b = [3, 2]
    let a = kryos_tensor_ones(shape_a as i64, 2)
    let b = kryos_tensor_ones(shape_b as i64, 2)
    let c = kryos_tensor_matmul(a, b)
    let cn = kryos_tensor_numel(c)
    if cn == 4 {
        println("ok: matmul")
    }

    // Test ones numel
    let shape_s = [3, 4]
    let t = kryos_tensor_ones(shape_s as i64, 2)
    let tn = kryos_tensor_numel(t)
    if tn == 12 {
        println("ok: numel")
    }
}
