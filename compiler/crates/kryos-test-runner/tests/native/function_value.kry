// Verify functions can be assigned to variables and called indirectly.
// expect-stdout: 42
// expect-stdout: 20
fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x)
}

fn double(x: i64) -> i64 {
    return x * 2
}

fn main() {
    let result = apply(double, 21)
    println(to_string(result))

    let f = double
    println(to_string(f(10)))
}
