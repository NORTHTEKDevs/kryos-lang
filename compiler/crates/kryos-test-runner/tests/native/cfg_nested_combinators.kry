// expect-stdout: kept
// Tests nested @cfg(...) combinators: not(), all(), any().
//
// Host-agnostic pair that always picks exactly one definition of `kept()`
// on any supported host and build profile:
//   - @cfg(all(any(linux, windows, macos), any(debug, release))) => keep
//   - @cfg(not(any(linux, windows, macos)))                      => strip

@cfg(all(any(linux, windows, macos), any(debug, release)))
fn kept() -> str {
    return "kept"
}

@cfg(not(any(linux, windows, macos)))
fn kept() -> str {
    return "stripped"
}

fn main() {
    println(kept())
}
