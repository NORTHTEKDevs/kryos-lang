// expect-stdout: host-os
// Tests @cfg(...) conditional compilation.
//
// Exactly one `pick()` survives stripping on any supported host: the
// any(linux, windows, macos) branch is true everywhere the native test
// runner runs, and the not(...) branch is its complement. Both variants
// define `pick()` with the same name; without stripping this would be a
// duplicate-symbol error.

@cfg(any(linux, windows, macos))
fn pick() -> str {
    return "host-os"
}

@cfg(not(any(linux, windows, macos)))
fn pick() -> str {
    return "other-os"
}

fn main() {
    println(pick())
}
