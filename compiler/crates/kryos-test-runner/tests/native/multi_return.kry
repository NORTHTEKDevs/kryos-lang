// expect-stdout: negative
// expect-stdout: zero
// expect-stdout: positive
fn classify(n: i64) -> str {
    if n < 0 {
        return "negative"
    }
    if n == 0 {
        return "zero"
    }
    return "positive"
}

fn main() {
    println(classify(-5))
    println(classify(0))
    println(classify(42))
}
