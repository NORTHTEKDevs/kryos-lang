// expect-exit: 6
fn bool_to_int(b: bool) -> i32 {
    if b {
        return 1
    }
    return 0
}

fn main() -> i32 {
    let mut score = 0
    score = score + bool_to_int(5 > 3)
    score = score + bool_to_int(3 < 5)
    score = score + bool_to_int(5 >= 5)
    score = score + bool_to_int(5 <= 5)
    score = score + bool_to_int(5 == 5)
    score = score + bool_to_int(5 != 3)
    return score
}
