// expect-stdout: hello
// Tests that @cfg(...) stripping happens before type-check.
//
// The gated function body references an undefined identifier. Its cfg
// (all(windows, linux)) is false on EVERY host, so the decl is removed
// before type-check on any platform. If stripping ran after type-check,
// this would fail to compile everywhere.

@cfg(all(windows, linux))
fn never_compiled() -> i64 {
    return totally_undefined_function() + 1
}

fn main() {
    println("hello")
}
