// expect-stdout: 15
// expect-stdout: 6
fn add(a: i32, b: i32) -> i32 {
    return a + b
}

fn mul(a: i32, b: i32) -> i32 {
    return a * b
}

fn combine(f: fn(i32, i32) -> i32, x: i32, y: i32) -> i32 {
    return f(x, y)
}

fn main() {
    let sum = combine(add, 7, 8)
    println(sum)
    let product = combine(mul, 2, 3)
    println(product)
}
