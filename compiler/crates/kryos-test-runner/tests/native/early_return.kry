// expect-exit: 1
fn find_first_even(a: i32, b: i32, c: i32) -> i32 {
    if a % 2 == 0 {
        return a
    }
    if b % 2 == 0 {
        return b
    }
    if c % 2 == 0 {
        return c
    }
    return -1
}

fn main() -> i32 {
    let result = find_first_even(3, 7, 4)
    if result == 4 {
        return 1
    }
    return 0
}
