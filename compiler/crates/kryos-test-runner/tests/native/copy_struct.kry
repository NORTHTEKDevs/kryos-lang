// expect-stdout: 30
// expect-stdout: 30
@copy
struct Point {
    x: i64,
    y: i64,
}

fn sum_point(p: Point) -> i64 {
    return p.x + p.y
}

fn main() {
    let p = Point { x: 10, y: 20 }
    let q = p   // assignment: copies because @copy
    let a = sum_point(p)   // p still usable after copy
    let b = sum_point(q)   // q also usable
    println(to_string(a))
    println(to_string(b))
}
