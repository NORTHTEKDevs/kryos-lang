// Real cooperative async executor — async/await SUGAR interleaving proof.
// `await` now lowers to a cooperative yield; two spawned async tasks
// interleave => "A0 B0 A1 B1 A2 B2".
// expect-stdout: order: A0 B0 A1 B1 A2 B2
// expect-stdout: PASS: async/await interleaves
// expect-exit: 0

async fn task_a() {
    let mut i = 0
    while i < 3 {
        coop_record("A" + to_string(i))
        await 0
        i = i + 1
    }
}

async fn task_b() {
    let mut i = 0
    while i < 3 {
        coop_record("B" + to_string(i))
        await 0
        i = i + 1
    }
}

fn main() {
    coop_reset()
    coop_spawn(task_a())
    coop_spawn(task_b())
    coop_run()

    let order: str = coop_order()
    println("order: " + order)
    if order != "A0 B0 A1 B1 A2 B2" {
        println("FAIL: not interleaved: " + order)
        exit(1)
    }
    println("PASS: async/await interleaves")
}
