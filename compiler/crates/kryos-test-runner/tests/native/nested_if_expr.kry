// Verify nested if-expressions produce correct values.
// expect-stdout: 42
// expect-stdout: 99
// expect-stdout: 77
fn main() {
    let a = if true { if true { if false { 1 } else { 42 } } else { 2 } } else { 3 }
    println(to_string(a))

    let b = if false { 1 } else { if true { 99 } else { 0 } }
    println(to_string(b))

    let c = if false { 1 } elif false { 2 } else { if true { 77 } else { 0 } }
    println(to_string(c))
}
