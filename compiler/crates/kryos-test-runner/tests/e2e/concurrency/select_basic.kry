// run-expect: got value
// v2.6.9 parser hardening: a select branch starts with a binding ident
// (variable name) followed by the channel expression. The previous form
// `recv ch => ...` used `recv` as a keyword; the new syntax binds the
// received value to a user-named variable.
fn main() {
    let ch = chan()

    spawn {
        send(ch, 42)
    }

    select {
        v ch => {
            println("got value")
        }
    }
}
