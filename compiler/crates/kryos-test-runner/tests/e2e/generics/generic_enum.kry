// run-expect: some 10
// run-expect: none
enum Maybe[T] {
    Some(T),
    None,
}

fn main() {
    let val1 = Maybe::Some(10)
    match val1 {
        Maybe::Some(v) => {
            println("some " + to_string(v))
        }
        Maybe::None => {
            println("fallback")
        }
    }

    let val2 = Maybe::None
    match val2 {
        Maybe::Some(v) => {
            println("should not happen")
        }
        Maybe::None => {
            println("none")
        }
    }
}
