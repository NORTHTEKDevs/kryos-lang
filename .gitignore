# Build artifacts
target/
compiler/target/

# cargo-fuzz crash artifacts (ephemeral repro dumps; the permanent record is
# a corpus entry under compiler/fuzz/corpus/<target>/ plus a regression test)
compiler/fuzz/artifacts/

# Compiled binaries
*.exe
*.pdb
*.obj
*.o
*.so
*.dll
*.dylib
*.wasm

# Debug/test output
*_output.txt
*_output*.txt
check_output.txt

# Python
__pycache__/
.pytest_cache/
*.pyc

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Internal planning docs (keep out of public repo)
docs/plans/

# Shift-engineer state (per-clone, not shared)
.shift/*
!.shift/progress.txt
!.shift/init.sh

# Parity matrix results (per-run artifacts)
tests/parity/results/

# Editor packaging artifacts (CI uploads them to releases)
editors/vscode/out/
editors/vscode/node_modules/
editors/vscode/package-lock.json
editors/vscode/*.vsix
editors/zed/Cargo.lock

# Misc
.env
*.log
.DS_Store
Thumbs.db

# Linker map files + local agent session dirs
*.map
.claude/
test_stdlib.txt

# Internal/scratch state (not for publication)
docs/ECOSYSTEM-STATE-*.md
ecosystem/PROMPTS.md

# Internal working artifacts (never ship)
compiler/scratch/
CRYSTAL.md
OVERNIGHT-PROGRESS.md
LAUNCH.md
STABILITY-v4.0.md
summary.txt
compiler/summary.txt

# Working scratch + shift-engineer state (not part of the compiler)
scratchpad/
.shift/

# Working scratch files (probes/repros), not part of the compiler
scratchpad/

# overstory build artifacts (never commit these)
.overstory/

# Completion-loop derived state: written ONLY by verify runs, keyed to a commit.
# Deliberately NOT tracked -- a committed status file is the exact failure mode
# this system exists to prevent (a claim nobody re-ran). Re-derive with:
#   bash tools/loop/graph-run.sh status
tools/loop/STATE.json
