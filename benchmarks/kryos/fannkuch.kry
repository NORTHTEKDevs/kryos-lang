// Benchmark: fannkuch-redux (canonical Benchmarks Game shape).
// Generates all n! permutations via the counting algorithm, counts
// pancake flips per permutation, accumulates the alternating checksum.
// Reference output for n=10: 73196 / Pfannkuchen(10) = 38.

fn main() {
    let n: i64 = 10
    let mut perm1: [i64] = []
    let mut count: [i64] = []
    let mut perm: [i64] = []
    let mut i: i64 = 0
    while i < n {
        push(perm1, i)
        push(count, 0)
        push(perm, 0)
        i = i + 1
    }
    let mut max_flips: i64 = 0
    let mut checksum: i64 = 0
    let mut perm_count: i64 = 0
    let mut r: i64 = n
    let mut done: bool = false
    while not done {
        while r != 1 {
            count[r - 1] = r
            r = r - 1
        }
        let mut j: i64 = 0
        while j < n {
            perm[j] = perm1[j]
            j = j + 1
        }
        let mut flips: i64 = 0
        let mut k = perm[0]
        while k != 0 {
            let mut a: i64 = 0
            let mut b: i64 = k
            while a < b {
                let t = perm[a]
                perm[a] = perm[b]
                perm[b] = t
                a = a + 1
                b = b - 1
            }
            flips = flips + 1
            k = perm[0]
        }
        if flips > max_flips {
            max_flips = flips
        }
        if perm_count % 2 == 0 {
            checksum = checksum + flips
        } else {
            checksum = checksum - flips
        }
        let mut advanced: bool = false
        while not advanced {
            if r == n {
                done = true
                advanced = true
            } else {
                let perm0 = perm1[0]
                let mut m: i64 = 0
                while m < r {
                    perm1[m] = perm1[m + 1]
                    m = m + 1
                }
                perm1[r] = perm0
                count[r] = count[r] - 1
                if count[r] > 0 {
                    advanced = true
                } else {
                    r = r + 1
                }
            }
        }
        perm_count = perm_count + 1
    }
    println(to_string(checksum))
    println("Pfannkuchen(" + to_string(n) + ") = " + to_string(max_flips))
}
