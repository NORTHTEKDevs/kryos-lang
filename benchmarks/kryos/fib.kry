// Benchmark: recursive Fibonacci (function-call overhead + branching)
// fib(40) is the standard threshold; large enough to dwarf startup time.

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    let n: i64 = 40
    let r = fib(n)
    println("fib(40) = " + to_string(r))
}
