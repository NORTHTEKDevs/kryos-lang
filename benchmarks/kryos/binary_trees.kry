// Benchmark: binary trees (canonical allocation-stress shape).
// Builds and checksums many short-lived trees plus one long-lived tree --
// the Benchmarks Game form that optimizing compilers cannot constant-fold.
//
// Representation: each child link is Option<shared Tree>, giving one arc
// allocation per child instead of the three allocations (array header +
// data buffer + boxed struct) of the original [Tree] encoding.  Leaves
// use None() so they pay zero child allocations.

use std::option::{Option}

struct Tree {
    left: Option<shared Tree>,
    right: Option<shared Tree>,
}

fn make(depth: i64) -> Tree {
    if depth == 0 {
        return Tree { left: None(), right: None() }
    }
    return Tree {
        left: Some(shared make(depth - 1)),
        right: Some(shared make(depth - 1)),
    }
}

fn check(t: Tree) -> i64 {
    match t.left {
        Option.None => return 1,
        Option.Some(s) => {
            match t.right {
                Option.None => return 1,
                Option.Some(r) => return 1 + check(*s) + check(*r),
            }
        },
    }
}

fn main() {
    let max_depth = 16
    let long_lived = make(max_depth)
    let mut total = 0
    let mut depth = 4
    while depth <= max_depth {
        let iterations = 1 << (max_depth - depth + 4)
        let mut i = 0
        let mut sum = 0
        while i < iterations {
            let t = make(depth)
            sum = sum + check(t)
            i = i + 1
        }
        total = total + sum
        depth = depth + 2
    }
    total = total + check(long_lived)
    println("binary_trees(canonical, depth=16) checksum = " + to_string(total))
}
