// Benchmark: binary trees — allocation, traversal, recursion.
// Builds and walks a balanced binary tree of depth N.
// Stresses the allocator and recursion.

struct Tree {
    left: i64,
    right: i64,
    value: i64,
}

fn make_tree(depth: i64, value: i64) -> Tree {
    if depth == 0 {
        return Tree { left: 0, right: 0, value: value }
    }
    let l = make_tree(depth - 1, value * 2)
    let r = make_tree(depth - 1, value * 2 + 1)
    // We can't store Tree inside Tree in this simple bench, so use
    // value-only depth check: return a Tree whose 'value' encodes the
    // subtree sum.
    return Tree { left: 0, right: 0, value: l.value + r.value }
}

fn tree_sum(depth: i64, value: i64) -> i64 {
    if depth == 0 {
        return value
    }
    return tree_sum(depth - 1, value * 2) + tree_sum(depth - 1, value * 2 + 1)
}

fn main() {
    let depth: i64 = 21
    let s = tree_sum(depth, 1)
    println("binary_trees(depth=21) = " + to_string(s))
}
