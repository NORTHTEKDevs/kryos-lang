fn main() {
    let n: i64 = 1000000
    let mut m: map<i64, i64> = #{}
    let mut i: i64 = 0
    while i < n {
        m[i] = i * 2
        i = i + 1
    }
    let mut sum: i64 = 0
    let mut j: i64 = 0
    while j < n {
        sum = sum + m[j]
        j = j + 1
    }
    println(to_string(sum))
}
