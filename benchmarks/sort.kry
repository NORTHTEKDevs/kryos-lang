// Benchmark: Quicksort on 10K elements
// Tests: recursion, array manipulation, partitioning

fn quicksort(arr, low, high) {
    if low < high {
        let pivot = arr[high]
        let i = low - 1
        let j = low
        while j < high {
            if arr[j] <= pivot {
                i = i + 1
                let temp = arr[i]
                arr[i] = arr[j]
                arr[j] = temp
            }
            j = j + 1
        }
        let temp = arr[i + 1]
        arr[i + 1] = arr[high]
        arr[high] = temp
        let pi = i + 1

        quicksort(arr, low, pi - 1)
        quicksort(arr, pi + 1, high)
    }
}

// Generate pseudo-random array using LCG
let arr = []
let seed = 42
let i = 0
while i < 10000 {
    seed = (seed * 1103515245 + 12345) % 2147483648
    arr = arr + [seed % 100000]
    i = i + 1
}

let start = time_ms()
quicksort(arr, 0, len(arr) - 1)
let elapsed = time_ms() - start

// Verify sorted
let sorted = true
i = 1
while i < len(arr) {
    if arr[i] < arr[i - 1] {
        sorted = false
    }
    i = i + 1
}

println("sorted = " + to_string(sorted))
println("elements = " + to_string(len(arr)))
println("elapsed_ms: " + to_string(elapsed))
