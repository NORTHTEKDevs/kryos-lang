// Benchmark: Recursive Fibonacci
// Tests: function call overhead, recursion depth

fn fib(n) {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

let start = time_ms()
let result = fib(35)
let elapsed = time_ms() - start
println("fibonacci(35) = " + to_string(result))
println("elapsed_ms: " + to_string(elapsed))
