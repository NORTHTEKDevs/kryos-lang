// mylib.kry -- A small utility library to demonstrate the Kryos import system.

/// Double an integer value.
fn double(x: i64) -> i64 {
    return x * 2
}

/// Triple an integer value.
fn triple(x: i64) -> i64 {
    return x * 3
}

/// Greet someone by name.
fn greet(name: str) -> str {
    return "Hello, " + name + "!"
}

/// Compute the sum of integers from 1 to n.
fn sum_to(n: i64) -> i64 {
    let mut total = 0
    let mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}
