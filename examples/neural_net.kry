// ============================================================
// Kryos Neural Network Demo
//
// Demonstrates the native tensor runtime with a 2-layer
// neural network forward pass using matrix multiplication,
// ReLU activation, and softmax output.
// ============================================================

extern {
    fn kryos_tensor_zeros(shape_ptr: i64, ndim: i64) -> i64
    fn kryos_tensor_ones(shape_ptr: i64, ndim: i64) -> i64
    fn kryos_tensor_rand(shape_ptr: i64, ndim: i64) -> i64
    fn kryos_tensor_randn(shape_ptr: i64, ndim: i64) -> i64
    fn kryos_tensor_eye(n: i64) -> i64
    fn kryos_tensor_matmul(a: i64, b: i64) -> i64
    fn kryos_tensor_relu(handle: i64) -> i64
    fn kryos_tensor_softmax(handle: i64, dim: i64) -> i64
    fn kryos_tensor_numel(handle: i64) -> i64
}

fn main() {
    println("=== Kryos Neural Network Demo ===")
    println("")
    println("Network: input(4) -> hidden(8) -> output(3)")
    println("")

    // --- Build weight matrices ---
    let w1_shape = [4, 8]
    let w2_shape = [8, 3]
    let input_shape = [2, 4]

    // Create tensors for forward pass
    let x = kryos_tensor_rand(input_shape as i64, 2)
    let w1 = kryos_tensor_randn(w1_shape as i64, 2)
    let w2 = kryos_tensor_randn(w2_shape as i64, 2)

    // --- Forward pass ---
    // Layer 1: hidden = relu(X @ W1)
    let hidden_raw = kryos_tensor_matmul(x, w1)
    let hidden = kryos_tensor_relu(hidden_raw)

    // Layer 2: output = softmax(hidden @ W2)
    let logits = kryos_tensor_matmul(hidden, w2)
    let probs = kryos_tensor_softmax(logits, -1)

    // Report
    let num_probs = kryos_tensor_numel(probs)
    println("Forward pass complete!")
    println("  Input:  2 samples x 4 features")
    println("  W1:     4x8 = 32 parameters")
    println("  W2:     8x3 = 24 parameters")
    println("  Output: " + to_string(num_probs) + " probabilities (2 samples x 3 classes)")
    println("")

    // --- Additional tensor ops ---
    let eye = kryos_tensor_eye(4)
    let eye_n = kryos_tensor_numel(eye)
    println("Identity matrix (4x4): " + to_string(eye_n) + " elements")

    let z_shape = [10, 10]
    let z = kryos_tensor_zeros(z_shape as i64, 2)
    let z_n = kryos_tensor_numel(z)
    println("Zeros (10x10):         " + to_string(z_n) + " elements")

    let o_shape = [3, 3]
    let o = kryos_tensor_ones(o_shape as i64, 2)
    let o_n = kryos_tensor_numel(o)
    println("Ones (3x3):            " + to_string(o_n) + " elements")

    println("")
    println("Total parameters: 56 (W1: 32, W2: 24)")
    println("=== Demo complete ===")
}
