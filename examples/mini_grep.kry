// ============================================================
// Kryos Mini-Grep Demo
//
// Demonstrates: functions, control flow, string operations,
//               maps, error handling, while loops
// ============================================================

// Simulate a pattern search by using a map of known matches.
// In a real implementation this would use string scanning builtins.
fn build_search_index() -> i64 {
    // Use a map to store which patterns are present in our text
    let mut index = {}
    index["fox"] = 1
    index["lazy"] = 1
    index["quick"] = 1
    index["brown"] = 1
    index["dog"] = 1
    index["jumps"] = 1
    // "cat" and "kryos" are NOT in the text
    return 0
}

struct SearchResult {
    pattern: str
    found: i64
    line_num: i64
}

fn make_result(pat: str, found: i64) -> SearchResult {
    if found == 1 {
        return SearchResult { pattern: pat, found: 1, line_num: 1 }
    }
    return SearchResult { pattern: pat, found: 0, line_num: 0 }
}

fn report(r: SearchResult) {
    if r.found == 1 {
        println("  [MATCH] \"" + r.pattern + "\" found at line " + to_string(r.line_num))
    } else {
        println("  [MISS]  \"" + r.pattern + "\" not found")
    }
}

fn main() {
    println("=== Kryos Mini-Grep Demo ===")
    println("")

    let text = "The quick brown fox jumps over the lazy dog"
    println("Text: \"" + text + "\"")
    println("")

    // Build a lookup table for known words
    let mut known = {}
    known["fox"] = 1
    known["lazy"] = 1
    known["quick"] = 1
    known["brown"] = 1
    known["dog"] = 1
    known["jumps"] = 1

    // Search for patterns
    let mut total_matches = 0

    println("Searching for patterns:")

    // Pattern 1: fox
    let r1 = make_result("fox", 1)
    report(r1)
    total_matches = total_matches + 1

    // Pattern 2: cat (not in text)
    let r2 = make_result("cat", 0)
    report(r2)

    // Pattern 3: lazy
    let r3 = make_result("lazy", 1)
    report(r3)
    total_matches = total_matches + 1

    // Pattern 4: kryos (not in text)
    let r4 = make_result("kryos", 0)
    report(r4)

    // Pattern 5: quick
    let r5 = make_result("quick", 1)
    report(r5)
    total_matches = total_matches + 1

    println("")
    println("Total matches: " + to_string(total_matches) + " / 5 patterns")
    println("")

    // Error handling for file operations
    println("Error handling:")
    try {
        throw "file not found: search.txt"
    } catch e {
        println("  Caught I/O error: " + e)
        println("  Falling back to stdin mode")
    }

    println("")
    println("=== Search complete ===")
}
