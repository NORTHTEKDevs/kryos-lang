// ============================================================
// Kryos Bootstrap -- Self-Hosting Lexer Subset
//
// This file implements a basic tokenizer for Kryos, written IN
// Kryos itself.  It proves the language is expressive enough to
// build its own compiler components.
//
// All logic uses copy-type variables (i32, i64, bool) for loop
// state and passes the source string only to leaf functions that
// consume it.  This avoids use-after-move issues.
// ============================================================

// --- Token kinds ----------------------------------------------------------

let TK_INT    = 1
let TK_IDENT  = 2
let TK_PLUS   = 3
let TK_MINUS  = 4
let TK_STAR   = 5
let TK_SLASH  = 6
let TK_LPAREN = 7
let TK_RPAREN = 8
let TK_EOF    = 9
let TK_ERROR  = 10

fn token_kind_name(kind: i32) -> str {
    if kind == 1 { return "INT" }
    if kind == 2 { return "IDENT" }
    if kind == 3 { return "PLUS" }
    if kind == 4 { return "MINUS" }
    if kind == 5 { return "STAR" }
    if kind == 6 { return "SLASH" }
    if kind == 7 { return "LPAREN" }
    if kind == 8 { return "RPAREN" }
    if kind == 9 { return "EOF" }
    return "ERROR"
}

// --- Character classification (work on code points, all i64 = copy) ------

fn is_digit_code(c: i64) -> bool {
    return c >= 48 and c <= 57
}

fn is_alpha_code(c: i64) -> bool {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
}

fn is_alnum_code(c: i64) -> bool {
    return is_digit_code(c) or is_alpha_code(c)
}

fn is_ws_code(c: i64) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13
}

// --- Helper: get char code at position -----------------------------------

fn code_at(source: str, pos: i32) -> i64 {
    let ch = substr(source, pos, pos + 1)
    return char_code(ch)
}

// --- Scanning helpers (return new position) -------------------------------

fn scan_skip_ws(source: str, pos: i32) -> i32 {
    let src_len = len(source)
    let mut p = pos
    let mut scanning = true
    while scanning {
        if p >= src_len {
            scanning = false
        } else {
            let c = code_at(source, p)
            if is_ws_code(c) {
                p = p + 1
            } else {
                scanning = false
            }
        }
    }
    return p
}

fn scan_digits(source: str, pos: i32) -> i32 {
    let src_len = len(source)
    let mut p = pos
    let mut scanning = true
    while scanning {
        if p >= src_len {
            scanning = false
        } else {
            let c = code_at(source, p)
            if is_digit_code(c) {
                p = p + 1
            } else {
                scanning = false
            }
        }
    }
    return p
}

fn scan_ident(source: str, pos: i32) -> i32 {
    let src_len = len(source)
    let mut p = pos
    let mut scanning = true
    while scanning {
        if p >= src_len {
            scanning = false
        } else {
            let c = code_at(source, p)
            if is_alnum_code(c) {
                p = p + 1
            } else {
                scanning = false
            }
        }
    }
    return p
}

// --- Tokenize and print ---------------------------------------------------

fn tokenize_and_print(source: str) -> i32 {
    let src_len = len(source)
    let mut pos = 0
    let mut count = 0
    let mut done = false

    println("Tokenizing: " + source)
    println("---")

    while not done {
        // Skip whitespace
        pos = scan_skip_ws(source, pos)

        // Check for EOF
        if pos >= src_len {
            println("EOF")
            count = count + 1
            done = true
        } else {
            let c = code_at(source, pos)

            if is_digit_code(c) {
                // Read integer
                let end = scan_digits(source, pos)
                let value = substr(source, pos, end)
                let kind_name = token_kind_name(TK_INT)
                println(kind_name + "  " + value)
                count = count + 1
                pos = end
            } else {
                if is_alpha_code(c) {
                    // Read identifier
                    let end = scan_ident(source, pos)
                    let value = substr(source, pos, end)
                    let kind_name = token_kind_name(TK_IDENT)
                    println(kind_name + "  " + value)
                    count = count + 1
                    pos = end
                } else {
                    // Single-character tokens
                    let mut kind = TK_ERROR
                    if c == 43 { kind = TK_PLUS }
                    if c == 45 { kind = TK_MINUS }
                    if c == 42 { kind = TK_STAR }
                    if c == 47 { kind = TK_SLASH }
                    if c == 40 { kind = TK_LPAREN }
                    if c == 41 { kind = TK_RPAREN }

                    let ch = substr(source, pos, pos + 1)
                    let kind_name = token_kind_name(kind)
                    println(kind_name + "  " + ch)
                    count = count + 1
                    pos = pos + 1
                }
            }
        }
    }

    println("---")
    println("Total tokens: " + to_string(count))
    return count
}

// --- Main -----------------------------------------------------------------

fn main() {
    println("=== Kryos Bootstrap Lexer ===")
    println("")

    // Tokenize a simple arithmetic expression
    tokenize_and_print("2 + 3 * (4 - 1)")

    println("")

    // Tokenize something with identifiers
    tokenize_and_print("foo + bar * 42")

    println("")
    println("=== Bootstrap lexer complete ===")
}
