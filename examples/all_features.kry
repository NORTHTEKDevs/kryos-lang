/// The mathematical constant pi.
let PI: f64 = 3.14159

/// A point in 2D Euclidean space.
struct Point {
    x: f64
    y: f64
}

/// Cardinal compass directions.
enum Direction {
    North
    South
    East
    West
}

/// Types that can compute their area.
trait HasArea {
    fn area(self) -> f64
}

/// HasArea implementation for Point (bounding rectangle from origin).
impl HasArea for Point {
    fn area(self) -> f64 {
        return self.x * self.y
    }
}

/// An actor that logs messages and counts them.
actor Logger {
    count: i64

    fn log(msg: str) {
        println(msg)
    }
}

/// Alias for a 2D coordinate.
type Coord = Point

use std::math

extern "C" {
    fn printf(fmt: str) -> i64
}

/// Compute the squared distance between two points.
fn distance(a: Point, b: Point) -> f64 {
    let dx = a.x - b.x
    let dy = a.y - b.y
    return dx * dx + dy * dy
}

/// Entry point for the all-features demo.
fn main() {
    let p = Point { x: 3.0, y: 4.0 }
    println("Hello, Kryos!")
}
