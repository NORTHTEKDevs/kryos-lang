// Tiny CSV read / filter / write tool.
//
// Reads a CSV file (with header row), filters rows by a column predicate,
// and writes the result to a new CSV file. Demonstrates string parsing,
// arrays of strings, struct-typed rows, file I/O, and a small functional
// pipeline using the new |x| closure syntax.

fn split_line(line: str, sep: str) -> [str] {
    let mut out: [str] = []
    let n = len(line)
    let mut i = 0
    let mut start = 0
    while i < n {
        let c = substr(line, i, i + 1)
        if c == sep {
            out = push(out, substr(line, start, i))
            start = i + 1
        }
        i = i + 1
    }
    out = push(out, substr(line, start, n))
    return out
}

fn join_with(fields: [str], sep: str) -> str {
    let mut out = ""
    let n = len(fields)
    let mut i = 0
    while i < n {
        if i > 0 {
            out = out + sep
        }
        out = out + fields[i]
        i = i + 1
    }
    return out
}

fn split_lines(text: str) -> [str] {
    let mut out: [str] = []
    let n = len(text)
    let mut i = 0
    let mut start = 0
    while i < n {
        let c = substr(text, i, i + 1)
        if c == "\n" {
            out = push(out, substr(text, start, i))
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        out = push(out, substr(text, start, n))
    }
    return out
}

fn index_of(headers: [str], name: str) -> i64 {
    let n = len(headers)
    let mut i = 0
    while i < n {
        if headers[i] == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// Filter rows: keep only rows where predicate returns true.
fn filter_rows(rows: [[str]], pred: fn([str]) -> i64) -> [[str]] {
    let mut out: [[str]] = []
    for row in rows {
        if pred(row) == 1 {
            out = push(out, row)
        }
    }
    return out
}

fn main() {
    // Inline CSV demo to avoid filesystem dependency for the regression sweep.
    let raw = "id,name,score\n1,alice,42\n2,bob,17\n3,carol,88\n4,dave,73"

    let lines = split_lines(raw)
    if len(lines) == 0 {
        println("empty input")
        return
    }

    let headers = split_line(lines[0], ",")
    println("headers:")
    println(join_with(headers, " | "))

    let score_col = index_of(headers, "score")

    let mut rows: [[str]] = []
    let n = len(lines)
    let mut i = 1
    while i < n {
        rows = push(rows, split_line(lines[i], ","))
        i = i + 1
    }

    // Closure capturing score_col from the enclosing scope, passed to
    // a higher-order function. Exercises trait-free generics on arrays
    // of arrays plus the new fn-pointer closure path.
    let pass = filter_rows(rows, |row: [str]| {
        let s = row[score_col]
        // Compare lexicographically against "50" \u2014 simple threshold for demo.
        if len(s) > 2 { return 1 }
        if len(s) < 2 { return 0 }
        let first = substr(s, 0, 1)
        if first > "4" { return 1 }
        return 0
    })

    println("rows passing filter:")
    for row in pass {
        println(join_with(row, ","))
    }
}
