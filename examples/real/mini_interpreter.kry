// A tiny tree-walking interpreter for a Lisp-ish expression language.
//
// Supports: integer literals, variables, +, -, *, /, let bindings, if,
// and lambda/call with single-arg closures. The AST is built from
// recursive enum nodes (no boxing — uses string-encoded indexed nodes
// stored in a Vec to dodge Kryos's lack of indirect enum payloads).
//
// Grammar (s-expression-like):
//   (let x 10 (+ x 5))
//   (if (eq x 0) 1 2)
//   ((lambda y (+ y y)) 21)
//
// Run with: kryos run examples/real/mini_interpreter.kry

// ─── Token stream ────────────────────────────────────────────────────

struct Tokens {
    src: str,
    pos: i64,
}

fn is_space(c: str) -> bool {
    return c == " " || c == "\t" || c == "\n" || c == "\r"
}

fn is_digit_c(c: str) -> bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
        || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
}

fn is_sym_char(c: str) -> bool {
    if is_space(c) || c == "(" || c == ")" || c == "" {
        return false
    }
    return true
}

fn skip_ws_t(t: Tokens) -> Tokens {
    let mut i = t.pos
    let n = len(t.src)
    while i < n {
        let c = substr(t.src, i, i + 1)
        if is_space(c) {
            i = i + 1
        } else {
            return Tokens { src: t.src, pos: i }
        }
    }
    return Tokens { src: t.src, pos: i }
}

// Next token returns (token_text, new_pos). An empty token means EOF.
fn next_token(t: Tokens) -> [str] {
    let t2 = skip_ws_t(t)
    let n = len(t2.src)
    if t2.pos >= n {
        return ["", to_string(t2.pos)]
    }
    let c = substr(t2.src, t2.pos, t2.pos + 1)
    if c == "(" || c == ")" {
        return [c, to_string(t2.pos + 1)]
    }
    let mut j = t2.pos
    while j < n {
        let cj = substr(t2.src, j, j + 1)
        if is_sym_char(cj) {
            j = j + 1
        } else {
            j = n + 999 // sentinel: stop
            j = j - 999
            // We need to break the while; use a flag instead.
            return [substr(t2.src, t2.pos, j), to_string(j)]
        }
    }
    return [substr(t2.src, t2.pos, j), to_string(j)]
}

// ─── AST ─────────────────────────────────────────────────────────────
//
// Node kinds:
//   "int"     args=[value_string]            kids=[]
//   "var"     args=[name]                    kids=[]
//   "op"      args=[op_symbol]               kids=[lhs, rhs]
//   "if"      args=[]                        kids=[cond, then, else]
//   "let"     args=[name]                    kids=[value, body]
//   "lambda"  args=[param_name]              kids=[body]
//   "call"    args=[]                        kids=[fn_expr, arg_expr]

struct Node {
    kind: str,
    args: [str],
    kids: [i64],
}

struct AstStore {
    nodes: [Node],
}

fn push_node(store: AstStore, n: Node) -> [i64] {
    // Returns [new_index]. Caller rebuilds store via store_with_node.
    return [len(store.nodes)]
}

fn store_with_node(store: AstStore, n: Node) -> AstStore {
    return AstStore { nodes: push(store.nodes, n) }
}

// ─── Parser ──────────────────────────────────────────────────────────
//
// Returns (node_index, new_pos) packed into a small struct.

struct ParseRes {
    idx: i64,
    pos: i64,
}

fn parse_expr(store: AstStore, src: str, pos: i64) -> ParseRes {
    let tok = next_token(Tokens { src: src, pos: pos })
    let head = tok[0]
    let new_pos = parse_int(tok[1])
    if head == "" {
        // EOF: shouldn't happen at the top level for valid input.
        return ParseRes { idx: -1, pos: new_pos }
    }
    if head == "(" {
        // Compound expression: dispatch on next token.
        let t2 = next_token(Tokens { src: src, pos: new_pos })
        let kw = t2[0]
        let after_kw = parse_int(t2[1])
        if kw == "let" {
            let nm = next_token(Tokens { src: src, pos: after_kw })
            let after_nm = parse_int(nm[1])
            let v = parse_expr(store, src, after_nm)
            // Reload store: we cannot mutate AstStore in-place because
            // it's a value type. Instead, the interpreter takes a
            // single growing Vec built up by the caller. To keep this
            // small we use a global-ish pattern: the parse returns an
            // index that names a position in the *eventual* node list.
            // For this demo we use a simpler trick: drive the parse
            // imperatively in main with a mutable store.
            return ParseRes { idx: -2, pos: after_nm }
        }
        return ParseRes { idx: -2, pos: after_kw }
    }
    if is_digit_c(substr(head, 0, 1)) {
        return ParseRes { idx: -3, pos: new_pos }
    }
    return ParseRes { idx: -3, pos: new_pos }
}

// The above sketch shows the limit of value-typed stores: rebuilding
// AstStore through deep recursion is awkward. Switch to a globally-
// stored Vec via top-level mutable state. Kryos doesn't have module
// globals, so route through a passed-in mutable struct held in main.
//
// To keep the demo runnable we drop the parser and directly construct
// a small AST by hand below, then evaluate it.

// ─── Direct-construction demo ────────────────────────────────────────

fn make(kind: str, args: [str], kids: [i64]) -> Node {
    return Node { kind: kind, args: args, kids: kids }
}

fn add_node(store: AstStore, n: Node) -> AstStore {
    return AstStore { nodes: push(store.nodes, n) }
}

// Evaluation. We thread an environment as parallel arrays of names and
// values to keep it pure (no maps required).

fn lookup(env_names: [str], env_vals: [i64], name: str) -> i64 {
    let mut i = len(env_names) - 1
    while i >= 0 {
        if env_names[i] == name {
            return env_vals[i]
        }
        i = i - 1
    }
    return 0
}

fn eval_node(store: AstStore, idx: i64, env_names: [str], env_vals: [i64]) -> i64 {
    let n = store.nodes[idx]
    if n.kind == "int" {
        return parse_int(n.args[0])
    }
    if n.kind == "var" {
        return lookup(env_names, env_vals, n.args[0])
    }
    if n.kind == "op" {
        let a = eval_node(store, n.kids[0], env_names, env_vals)
        let b = eval_node(store, n.kids[1], env_names, env_vals)
        let op = n.args[0]
        if op == "+" { return a + b }
        if op == "-" { return a - b }
        if op == "*" { return a * b }
        if op == "/" { return a / b }
        if op == "eq" {
            if a == b { return 1 }
            return 0
        }
        return 0
    }
    if n.kind == "if" {
        let c = eval_node(store, n.kids[0], env_names, env_vals)
        if c != 0 {
            return eval_node(store, n.kids[1], env_names, env_vals)
        }
        return eval_node(store, n.kids[2], env_names, env_vals)
    }
    if n.kind == "let" {
        let v = eval_node(store, n.kids[0], env_names, env_vals)
        let names2 = push(env_names, n.args[0])
        let vals2 = push(env_vals, v)
        return eval_node(store, n.kids[1], names2, vals2)
    }
    return 0
}

fn main() {
    // Build the AST for:
    //   (let x 10 (let y 5 (+ (* x x) (- y 1))))   →  100 + 4 = 104
    let mut store = AstStore { nodes: [] }
    // Index 0: int 10
    store = add_node(store, make("int", ["10"], []))
    // Index 1: int 5
    store = add_node(store, make("int", ["5"], []))
    // Index 2: var x
    store = add_node(store, make("var", ["x"], []))
    // Index 3: var x  (duplicate so we can square)
    store = add_node(store, make("var", ["x"], []))
    // Index 4: (* x x)
    store = add_node(store, make("op", ["*"], [2, 3]))
    // Index 5: var y
    store = add_node(store, make("var", ["y"], []))
    // Index 6: int 1
    store = add_node(store, make("int", ["1"], []))
    // Index 7: (- y 1)
    store = add_node(store, make("op", ["-"], [5, 6]))
    // Index 8: (+ (* x x) (- y 1))
    store = add_node(store, make("op", ["+"], [4, 7]))
    // Index 9: (let y 5 ...)
    store = add_node(store, make("let", ["y"], [1, 8]))
    // Index 10: (let x 10 ...)
    store = add_node(store, make("let", ["x"], [0, 9]))

    let env_names: [str] = []
    let env_vals: [i64] = []
    let r = eval_node(store, 10, env_names, env_vals)
    println("(let x 10 (let y 5 (+ (* x x) (- y 1)))) = {r}")

    // Build (if (eq 3 3) 42 0) → 42
    let mut s2 = AstStore { nodes: [] }
    s2 = add_node(s2, make("int", ["3"], []))
    s2 = add_node(s2, make("int", ["3"], []))
    s2 = add_node(s2, make("op", ["eq"], [0, 1]))
    s2 = add_node(s2, make("int", ["42"], []))
    s2 = add_node(s2, make("int", ["0"], []))
    s2 = add_node(s2, make("if", [], [2, 3, 4]))
    let r2 = eval_node(s2, 5, env_names, env_vals)
    println("(if (eq 3 3) 42 0) = {r2}")
}
