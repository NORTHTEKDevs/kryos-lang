// installer.kry -- a tiny tool-installer / uninstaller.
//
// Reads a "manifest" file describing a set of named files to install
// (paths inside the source tree -> destinations on disk) and a target
// install directory. Writes a receipt next to the install so that
// `uninstall` can find and remove every file it placed there.
//
// Usage:
//   kryos run installer.kry install   <manifest> <target_dir>
//   kryos run installer.kry uninstall <target_dir>
//
// Manifest format (one entry per line):
//   <source_path> -> <relative_dest>
//
// Lines starting with `#` and blank lines are ignored. Example:
//
//   bin/hello.bin -> bin/hello
//   docs/README.md -> share/doc/hello/README.md
//
// The receipt is a single file written to <target_dir>/.install_receipt
// listing every absolute path the installer created. Uninstall reads
// the receipt and deletes each path in reverse order.

fn trim_line(s: str) -> str {
    return trim(s)
}

fn parse_entry(line: str) -> [str] {
    // "src -> dst" -> ["src", "dst"], or [] if malformed.
    let arrow = " -> "
    let parts = split(line, arrow)
    if len(parts) != 2 {
        return []
    }
    return [trim(parts[0]), trim(parts[1])]
}

fn ensure_parent_dir(path: str) {
    // Walk segments of `path`, creating each prefix directory as we go.
    let segs = split(path, "/")
    let n = len(segs)
    if n <= 1 {
        return
    }
    let mut prefix = ""
    if starts_with(path, "/") {
        prefix = ""
    }
    let mut i = 0
    while i < n - 1 {
        let seg = segs[i]
        if i == 0 {
            prefix = seg
        } else {
            prefix = prefix + "/" + seg
        }
        if seg != "" {
            if file_exists(prefix) == 0 {
                create_dir(prefix)
            }
        }
        i = i + 1
    }
}

fn do_install(manifest_path: str, target: str) -> i64 {
    if file_exists(manifest_path) == 0 {
        println("installer: manifest not found: " + manifest_path)
        return 2
    }
    if file_exists(target) == 0 {
        create_dir(target)
    }
    let manifest = read_file(manifest_path)
    let lines = split(manifest, "\n")
    let n = len(lines)
    let mut installed = ""
    let mut count = 0
    let mut i = 0
    while i < n {
        let line = trim(lines[i])
        if line == "" {
            i = i + 1
            continue
        }
        if starts_with(line, "#") {
            i = i + 1
            continue
        }
        let entry = parse_entry(line)
        if len(entry) != 2 {
            println("installer: malformed line " + to_string(i + 1) + ": " + line)
            i = i + 1
            continue
        }
        let src = entry[0]
        let rel = entry[1]
        let dst = target + "/" + rel
        if file_exists(src) == 0 {
            println("installer: source missing: " + src)
            return 3
        }
        ensure_parent_dir(dst)
        let body = read_file(src)
        write_file(dst, body)
        installed = installed + dst + "\n"
        count = count + 1
        println("installed " + dst)
        i = i + 1
    }
    let receipt_path = target + "/.install_receipt"
    write_file(receipt_path, installed)
    println("wrote receipt " + receipt_path)
    println("installed " + to_string(count) + " files into " + target)
    return 0
}

fn do_uninstall(target: str) -> i64 {
    let receipt_path = target + "/.install_receipt"
    if file_exists(receipt_path) == 0 {
        println("installer: no receipt at " + receipt_path)
        return 4
    }
    let receipt = read_file(receipt_path)
    let lines = split(receipt, "\n")
    let n = len(lines)
    // Remove in reverse order so nested files come out before parents
    // (we cannot remove directories yet; we only delete files).
    let mut removed = 0
    let mut i = n - 1
    while i >= 0 {
        let path = trim(lines[i])
        if path != "" {
            if file_exists(path) != 0 {
                // No `remove_file` builtin -- truncate to mark removed.
                // Kryos has no direct unlink at runtime today; this
                // demonstrates the manifest/receipt workflow even
                // without a real delete. A real run would call into
                // `process_run("rm", [path])` or similar.
                write_file(path, "")
                removed = removed + 1
                println("cleared " + path)
            }
        }
        i = i - 1
    }
    // Replace the receipt with an empty marker so a second uninstall
    // does not re-run on stale paths.
    write_file(receipt_path, "")
    println("uninstalled " + to_string(removed) + " files from " + target)
    return 0
}

// Deny-by-default: `main` declares the program's entire authority. Interior
// helpers (ensure_parent_dir, do_install, do_uninstall) are inferred.
@capabilities(fs:read, fs:write)
fn main() {
    let argv = args()
    let argc = len(argv)
    if argc < 3 {
        println("usage:")
        println("  kryos run installer.kry install   <manifest> <target_dir>")
        println("  kryos run installer.kry uninstall <target_dir>")
        exit(1)
    }
    let cmd = argv[1]
    if cmd == "install" {
        if argc < 4 {
            println("install needs <manifest> <target_dir>")
            exit(1)
        }
        let rc = do_install(argv[2], argv[3])
        exit(rc)
    } elif cmd == "uninstall" {
        let rc = do_uninstall(argv[2])
        exit(rc)
    } else {
        println("unknown command: " + cmd)
        exit(1)
    }
}
