// mcp_server -- a minimal MCP (Model Context Protocol) server.
//
// Speaks JSON-RPC 2.0 over stdio, one message per line.
//
// Implements three methods from the MCP wire protocol:
//
//   initialize       -> handshake; returns server info and tool capability
//   tools/list       -> returns the available tools
//   tools/call       -> runs a named tool with arguments
//
// Tools exposed:
//
//   echo(text)       -> { content: [ { type: "text", text: <text> } ] }
//   add(a, b)        -> sum of two integers
//   ping()           -> "pong"
//
// To drive it manually:
//
//   echo '{"jsonrpc":"2.0","id":1,"method":"initialize"}' | ./mcp_server
//
// Exit on EOF (empty read_line) or when stdin closes.

// exit()/args() are global builtins -- no import needed.

// --- Tiny string helpers -----------------------------------------------------

fn find_in(s: str, needle: str, from: i64) -> i64 {
    let slen = len(s)
    let nlen = len(needle)
    if nlen == 0 { return from }
    if from < 0 { return -1 }
    let mut i = from
    let limit = slen - nlen
    while i <= limit {
        let mut j = 0
        let mut matched = true
        while j < nlen {
            if s[i + j] != needle[j] {
                matched = false
                j = nlen
            } else {
                j = j + 1
            }
        }
        if matched { return i }
        i = i + 1
    }
    return -1
}

// --- JSON string-value extraction --------------------------------------------
//
// Extract  "key":"..."  -- returns the (already-unescaped) value, or "".
// Walks past an opening quote, then reads until the next unescaped quote.

fn json_get_str(json: str, key: str) -> str {
    let needle = "\"" + key + "\":"
    let p = find_in(json, needle, 0)
    if p < 0 { return "" }
    let mut i = p + len(needle)
    let jl = len(json)
    while i < jl and json[i] != "\"" { i = i + 1 }
    if i >= jl { return "" }
    i = i + 1
    let start = i
    while i < jl {
        let c = json[i]
        if c == "\\" {
            i = i + 2
        } else if c == "\"" {
            return json_unescape(substr(json, start, i))
        } else {
            i = i + 1
        }
    }
    return ""
}

// Extract  "key": <number>  -- returns parsed i64, or 0 if absent.
fn json_get_int(json: str, key: str) -> i64 {
    let needle = "\"" + key + "\":"
    let p = find_in(json, needle, 0)
    if p < 0 { return 0 }
    let mut i = p + len(needle)
    let jl = len(json)
    while i < jl and (json[i] == " " or json[i] == "\t") { i = i + 1 }
    let start = i
    while i < jl {
        let c = json[i]
        let code = char_code(c)
        let is_digit = code >= 48 and code <= 57
        if not is_digit and c != "-" {
            return parse_int(substr(json, start, i))
        }
        i = i + 1
    }
    return parse_int(substr(json, start, jl))
}

// Locate a nested object value:  "key":{ ... }  -- returns the object slice.
fn json_get_object(json: str, key: str) -> str {
    let needle = "\"" + key + "\":"
    let p = find_in(json, needle, 0)
    if p < 0 { return "" }
    let mut i = p + len(needle)
    let jl = len(json)
    while i < jl and json[i] != "\{" { i = i + 1 }
    if i >= jl { return "" }
    let start = i
    let mut depth = 0
    while i < jl {
        let c = json[i]
        if c == "\{" { depth = depth + 1 }
        else if c == "\}" {
            depth = depth - 1
            if depth == 0 { return substr(json, start, i + 1) }
        }
        i = i + 1
    }
    return ""
}

fn json_escape(s: str) -> str {
    let mut out = ""
    let slen = len(s)
    let mut i = 0
    while i < slen {
        let c = s[i]
        let code = char_code(c)
        if c == "\\" {
            out = out + "\\\\"
        } else if c == "\"" {
            out = out + "\\\""
        } else if code == 10 {
            out = out + "\\n"
        } else if code == 13 {
            out = out + "\\r"
        } else if code == 9 {
            out = out + "\\t"
        } else if code < 32 {
            // drop unprintable
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

fn json_unescape(s: str) -> str {
    let mut out = ""
    let slen = len(s)
    let mut i = 0
    while i < slen {
        let c = s[i]
        if c == "\\" and i + 1 < slen {
            let nx = s[i + 1]
            if nx == "n" { out = out + char_from(10) }
            else if nx == "t" { out = out + char_from(9) }
            else if nx == "r" { out = out + char_from(13) }
            else if nx == "\"" { out = out + "\"" }
            else if nx == "\\" { out = out + "\\" }
            else if nx == "/" { out = out + "/" }
            else { out = out + nx }
            i = i + 2
        } else {
            out = out + c
            i = i + 1
        }
    }
    return out
}

// --- Response builders -------------------------------------------------------

fn send_result(id: i64, result_json: str) {
    let line = "\{\"jsonrpc\":\"2.0\",\"id\":" + to_string(id) + ",\"result\":" + result_json + "\}"
    println(line)
}

fn send_error(id: i64, code: i64, message: str) {
    let line = "\{\"jsonrpc\":\"2.0\",\"id\":" + to_string(id) + ",\"error\":\{\"code\":" + to_string(code) + ",\"message\":\"" + json_escape(message) + "\"\}\}"
    println(line)
}

// --- Tool dispatch -----------------------------------------------------------

fn tool_echo(args_json: str) -> str {
    let text = json_get_str(args_json, "text")
    return "\{\"content\":[\{\"type\":\"text\",\"text\":\"" + json_escape(text) + "\"\}]\}"
}

fn tool_add(args_json: str) -> str {
    let a = json_get_int(args_json, "a")
    let b = json_get_int(args_json, "b")
    let sum = a + b
    return "\{\"content\":[\{\"type\":\"text\",\"text\":\"" + to_string(sum) + "\"\}]\}"
}

fn tool_ping(args_json: str) -> str {
    return "\{\"content\":[\{\"type\":\"text\",\"text\":\"pong\"\}]\}"
}

fn handle_initialize(id: i64) {
    let result = "\{\"protocolVersion\":\"2024-11-05\",\"capabilities\":\{\"tools\":\{\}\},\"serverInfo\":\{\"name\":\"kryos-mcp-demo\",\"version\":\"0.1.0\"\}\}"
    send_result(id, result)
}

fn handle_tools_list(id: i64) {
    let result = "\{\"tools\":[\{\"name\":\"echo\",\"description\":\"Echo text back\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\"text\":\{\"type\":\"string\"\}\},\"required\":[\"text\"]\}\},\{\"name\":\"add\",\"description\":\"Add two integers\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\"a\":\{\"type\":\"integer\"\},\"b\":\{\"type\":\"integer\"\}\},\"required\":[\"a\",\"b\"]\}\},\{\"name\":\"ping\",\"description\":\"Liveness check\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\}\}\}]\}"
    send_result(id, result)
}

fn handle_tools_call(id: i64, params_json: str) {
    let name = json_get_str(params_json, "name")
    let arguments = json_get_object(params_json, "arguments")
    if name == "echo" {
        send_result(id, tool_echo(arguments))
    } else if name == "add" {
        send_result(id, tool_add(arguments))
    } else if name == "ping" {
        send_result(id, tool_ping(arguments))
    } else {
        send_error(id, -32601, "unknown tool: " + name)
    }
}

@capabilities(io, process)
fn main() {
    while true {
        let line = read_line()
        if len(line) == 0 {
            // EOF -- exit cleanly.
            exit(0)
        }

        let id = json_get_int(line, "id")
        let method = json_get_str(line, "method")

        if method == "initialize" {
            handle_initialize(id)
        } else if method == "tools/list" {
            handle_tools_list(id)
        } else if method == "tools/call" {
            let params = json_get_object(line, "params")
            handle_tools_call(id, params)
        } else if len(method) == 0 {
            // No id either probably; ignore.
        } else {
            send_error(id, -32601, "method not found: " + method)
        }
    }
}
