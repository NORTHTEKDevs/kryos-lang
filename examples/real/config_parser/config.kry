// config.kry -- a small key/value config parser library.
//
// Supports lines like:
//     # comment
//     name = value
//     count = 42
//     enabled = true
//
// Values are stored as a sum-type `Value` (string / int / bool).
// This stresses Kryos in several ways at once:
//   - struct types holding arrays
//   - enum types with payloads
//   - `match` against an enum
//   - importable library (used from config_test.kry)
//   - real string processing

enum Value {
    Str(str),
    Int(i64),
    Bool(bool),
}

struct Config {
    keys:   [str]
    values: [Value]
}

fn new_config() -> Config {
    return Config { keys: [], values: [] }
}

/// Trim leading/trailing ASCII whitespace.
fn trim_ws(s: str) -> str {
    let mut start = 0
    let mut endp = len(s)
    while start < endp {
        let c = substr(s, start, start + 1)
        if c == " " or c == "\t" {
            start = start + 1
        } else {
            // break out of loop
            endp = endp
            return trim_tail(substr(s, start, endp))
        }
    }
    return ""
}

fn trim_tail(s: str) -> str {
    let mut endp = len(s)
    while endp > 0 {
        let c = substr(s, endp - 1, endp)
        if c == " " or c == "\t" or c == "\r" {
            endp = endp - 1
        } else {
            return substr(s, 0, endp)
        }
    }
    return ""
}

/// Parse a single value string into a `Value`.
fn parse_value(raw: str) -> Value {
    let v = trim_ws(raw)
    if v == "true" {
        return Value.Bool(true)
    }
    if v == "false" {
        return Value.Bool(false)
    }
    // Try int.
    if is_all_digits(v) {
        return Value.Int(parse_int(v))
    }
    return Value.Str(v)
}

fn is_all_digits(s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    let mut i = 0
    while i < len(s) {
        let c = substr(s, i, i + 1)
        if c == "0" or c == "1" or c == "2" or c == "3" or c == "4"
            or c == "5" or c == "6" or c == "7" or c == "8" or c == "9" {
            i = i + 1
        } else {
            return false
        }
    }
    return true
}

fn parse_int(s: str) -> i64 {
    let mut acc = 0
    let mut i = 0
    while i < len(s) {
        let c = substr(s, i, i + 1)
        let d = digit_of(c)
        acc = acc * 10 + d
        i = i + 1
    }
    return acc
}

fn digit_of(c: str) -> i64 {
    if c == "1" { return 1 }
    if c == "2" { return 2 }
    if c == "3" { return 3 }
    if c == "4" { return 4 }
    if c == "5" { return 5 }
    if c == "6" { return 6 }
    if c == "7" { return 7 }
    if c == "8" { return 8 }
    if c == "9" { return 9 }
    return 0
}

/// Parse a full config string. Returns a `Config` struct.
fn parse_config(text: str) -> Config {
    let cfg = new_config()
    let lines = split(text, "\n")
    let mut i = 0
    while i < len(lines) {
        let line = trim_ws(lines[i])
        if len(line) > 0 and not starts_with(line, "#") {
            let eq = index_of_eq(line)
            if eq > 0 {
                let key = trim_ws(substr(line, 0, eq))
                let val = trim_ws(substr(line, eq + 1, len(line)))
                push(cfg.keys, key)
                push(cfg.values, parse_value(val))
            }
        }
        i = i + 1
    }
    return cfg
}

/// Return the byte index of the first `=` in `s`, or -1.
fn index_of_eq(s: str) -> i64 {
    let mut i = 0
    while i < len(s) {
        let c = substr(s, i, i + 1)
        if c == "=" {
            return i
        }
        i = i + 1
    }
    return -1
}

/// Lookup a key. Returns a `Value` -- callers must `match` on it.
/// Missing keys yield `Value.Str("")`.
fn get(cfg: Config, key: str) -> Value {
    let mut i = 0
    while i < len(cfg.keys) {
        if cfg.keys[i] == key {
            return cfg.values[i]
        }
        i = i + 1
    }
    return Value.Str("")
}

/// Convenience: stringify a `Value` for printing/asserting.
fn value_to_string(v: Value) -> str {
    return match v {
        Value::Str(s) => "str:" + s,
        Value::Int(n) => "int:" + to_string(n),
        Value::Bool(b) => bool_label(b),
    }
}

fn bool_label(b: bool) -> str {
    if b {
        return "bool:true"
    }
    return "bool:false"
}

