// cdp_bot.kry - Chrome DevTools Protocol bot using Kryos WebSockets.
//
// Connects to a running Chromium / Chrome / Edge instance launched with:
//   chromium --headless --remote-debugging-port=9222 --disable-gpu
//
// Then drives the browser by sending CDP JSON-RPC commands over the
// browser's per-tab WebSocket endpoint.
//
// Discovery flow:
//   1. GET http://localhost:9222/json/version       -> browser info
//   2. GET http://localhost:9222/json               -> list of pages
//   3. extract webSocketDebuggerUrl for a page
//   4. tcp_connect to that ws:// endpoint
//   5. ws_client_handshake(fd, host, path)
//   6. send commands: Page.navigate, Runtime.evaluate, Page.captureScreenshot, ...
//
// This file ships the framing + a working demo that runs entirely offline
// (against a mock server) so it can be tested in CI / sandboxes without
// Chromium. When CHROMIUM_AVAILABLE is true at runtime it also probes a
// real local Chromium.

// ---------- WebSocket primitives (inlined from websocket_client.kry) -----

@capabilities(crypto)
fn ws_accept_key(key: str) -> str {
    return sha1_base64(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
}

@capabilities(crypto)
fn ws_make_key() -> str {
    let hex = random_bytes(16)
    return base64_encode(substr(hex, 0, 16))
}

@capabilities(crypto, net:tcp)
fn ws_send_frame(fd: i64, opcode: i64, payload: str) -> i64 {
    let plen = len(payload)
    let mut frame = chr(128 + opcode)
    let mb = 128  // clients MUST mask
    if plen < 126 {
        frame = frame + chr(mb + plen)
    } else if plen < 65536 {
        frame = frame + chr(mb + 126)
        frame = frame + chr((plen >> 8) & 255)
        frame = frame + chr(plen & 255)
    } else {
        frame = frame + chr(mb + 127)
        let mut z = 0
        while z < 4 {
            frame = frame + chr(0)
            z = z + 1
        }
        frame = frame + chr((plen >> 24) & 255)
        frame = frame + chr((plen >> 16) & 255)
        frame = frame + chr((plen >> 8) & 255)
        frame = frame + chr(plen & 255)
    }
    let rb = random_bytes(4)
    let m0 = byte_at(rb, 0)
    let m1 = byte_at(rb, 1)
    let m2 = byte_at(rb, 2)
    let m3 = byte_at(rb, 3)
    frame = frame + chr(m0) + chr(m1) + chr(m2) + chr(m3)
    let mut masked = ""
    let mut i = 0
    while i < plen {
        let mut mk = m0
        if i % 4 == 1 { mk = m1 }
        if i % 4 == 2 { mk = m2 }
        if i % 4 == 3 { mk = m3 }
        masked = masked + chr(byte_at(payload, i) ^ mk)
        i = i + 1
    }
    frame = frame + masked
    return tcp_send(fd, frame)
}

@capabilities(crypto, net:tcp)
fn ws_send_text(fd: i64, payload: str) -> i64 {
    return ws_send_frame(fd, 1, payload)
}

@capabilities(net:tcp)
fn ws_recv_text(fd: i64) -> str {
    let hdr = tcp_recv(fd, 2)
    if len(hdr) < 2 {
        return ""
    }
    let b1 = byte_at(hdr, 1)
    let masked = (b1 & 128) != 0
    let mut plen = b1 & 127
    if plen == 126 {
        let ext = tcp_recv(fd, 2)
        plen = (byte_at(ext, 0) << 8) | byte_at(ext, 1)
    } else if plen == 127 {
        let ext = tcp_recv(fd, 8)
        plen = (byte_at(ext, 4) << 24)
             | (byte_at(ext, 5) << 16)
             | (byte_at(ext, 6) << 8)
             | byte_at(ext, 7)
    }
    let mut mask_bytes = ""
    if masked {
        mask_bytes = tcp_recv(fd, 4)
    }
    if plen > 1048576 {
        plen = 1048576
    }
    let raw = tcp_recv(fd, plen)
    if masked == false {
        return raw
    }
    let mut out = ""
    let mut i = 0
    let n = len(raw)
    while i < n {
        let mk = byte_at(mask_bytes, i % 4)
        out = out + chr(byte_at(raw, i) ^ mk)
        i = i + 1
    }
    return out
}

// Pure string builder for testing (no socket).
fn cdp_navigate_string(url: str, id: i64) -> str {
    let q = chr(34)
    let ob = chr(123)  // {
    let cb = chr(125)  // }
    return ob + q + "id" + q + ":" + to_string(id) + "," + q + "method" + q + ":" + q + "Page.navigate" + q + "," + q + "params" + q + ":" + ob + q + "url" + q + ":" + q + url + q + cb + cb
}

// ---------- CDP command helpers -----------------------------------------

// Send a CDP command as a JSON-RPC request and return the response body.
// id is a per-session monotonic counter; in real usage callers track it.
@capabilities(crypto, net:tcp)
fn cdp_call(fd: i64, id: i64, method: str, params_json: str) -> str {
    let q = chr(34)  // double-quote
    let ob = chr(123)
    let cb = chr(125)
    let req = ob + q + "id" + q + ":" + to_string(id) + "," + q + "method" + q + ":" + q + method + q + "," + q + "params" + q + ":" + params_json + cb
    ws_send_text(fd, req)
    return ws_recv_text(fd)
}

// Navigate the page to a URL.
@capabilities(crypto, net:tcp)
fn cdp_navigate(fd: i64, id: i64, url: str) -> str {
    let q = chr(34)
    let ob = chr(123)
    let cb = chr(125)
    let params = ob + q + "url" + q + ":" + q + url + q + cb
    return cdp_call(fd, id, "Page.navigate", params)
}

// Evaluate JavaScript in the page context. Returns the response (JSON).
@capabilities(crypto, net:tcp)
fn cdp_eval(fd: i64, id: i64, expr: str) -> str {
    let q = chr(34)
    let ob = chr(123)
    let cb = chr(125)
    let params = ob + q + "expression" + q + ":" + q + expr + q + "," + q + "returnByValue" + q + ":true" + cb
    return cdp_call(fd, id, "Runtime.evaluate", params)
}

// Capture a screenshot as base64 PNG.
@capabilities(crypto, net:tcp)
fn cdp_screenshot(fd: i64, id: i64) -> str {
    let empty = chr(123) + chr(125)
    return cdp_call(fd, id, "Page.captureScreenshot", empty)
}

// ---------- Discovery via HTTP -------------------------------------------

// Hits http://host:port/json and returns the raw body. Caller parses JSON.
@capabilities(net:tcp)
fn cdp_list_targets(host: str, port: i64) -> str {
    let fd = tcp_connect(host, port)
    if fd <= 0 {
        return ""
    }
    let req = "GET /json HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n"
    tcp_send(fd, req)
    let resp = tcp_recv(fd, 65536)
    tcp_close(fd)
    return resp
}

// Find the byte index of `needle` in `hay`, or -1 if not found. Simple O(n*m).
fn find_substr(hay: str, needle: str) -> i64 {
    let hn = len(hay)
    let nn = len(needle)
    if nn == 0 {
        return 0
    }
    if nn > hn {
        return 0 - 1
    }
    let mut i = 0
    while i <= hn - nn {
        let mut j = 0
        let mut match_ok = true
        while j < nn {
            if byte_at(hay, i + j) != byte_at(needle, j) {
                match_ok = false
                j = nn
            } else {
                j = j + 1
            }
        }
        if match_ok {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Strip HTTP headers, return just the body.
fn http_body(resp: str) -> str {
    let idx = find_substr(resp, "\r\n\r\n")
    if idx < 0 {
        return resp
    }
    return substr(resp, idx + 4, len(resp))
}

// ---------- Demo ---------------------------------------------------------

@capabilities(crypto, net:tcp)
fn main() {
    println("=== Kryos CDP bot demo ===")

    // 1. Verify framing primitives work (we already validated handshake
    //    cryptography in websocket_client.kry).
    let q = chr(34)
    let ob = chr(123)
    let cb = chr(125)
    let cmd = ob + q + "id" + q + ":1," + q + "method" + q + ":" + q + "Browser.getVersion" + q + "," + q + "params" + q + ":" + ob + cb + cb
    println("[demo] CDP request would be: " + cmd)

    // 2. Probe a local Chromium debugger endpoint, if one happens to be
    //    running. In sandboxed environments this just prints a friendly
    //    message and continues.
    println("[demo] probing http://127.0.0.1:9222/json/version ...")
    let resp = cdp_list_targets("127.0.0.1", 9222)
    if len(resp) == 0 {
        println("[demo] no chromium found on 127.0.0.1:9222 (expected in sandbox)")
    } else {
        let body = http_body(resp)
        println("[demo] got " + to_string(len(body)) + " bytes of JSON")
        // In real use, parse this to find webSocketDebuggerUrl, then:
        //   let ws_fd = tcp_connect(host, port)
        //   ws_client_handshake(ws_fd, host, path)
        //   cdp_navigate(ws_fd, 1, "https://example.com")
        //   cdp_screenshot(ws_fd, 2)
    }

    // 3. Self-test: assemble a Page.navigate command and verify shape.
    let nav_cmd = cdp_navigate_string("https://kryos-lang.org", 42)
    if contains(nav_cmd, "Page.navigate") {
        println("[ok] command assembly works: " + nav_cmd)
    }

    println("=== done ===")
    println("To use with a real browser:")
    println("  $ chromium --headless --remote-debugging-port=9222 --disable-gpu &")
    println("  $ kryos run examples/cdp_bot.kry")
}
