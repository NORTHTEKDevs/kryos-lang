struct Point {
    x: f64
    y: f64
}

fn fibonacci(n: i64) -> i64 {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn apply_twice(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(f(x))
}

fn double(x: i64) -> i64 {
    return x * 2
}

fn main() {
    println("=== Kryos Language Demo ===")
    println("")
    println("1. Recursion")
    let fib10 = fibonacci(10)
    let fib20 = fibonacci(20)
    println("   fibonacci(10) = " + to_string(fib10))
    println("   fibonacci(20) = " + to_string(fib20))
    println("")
    println("2. Higher-Order Functions")
    let result = apply_twice(double, 3)
    println("   double(double(3)) = " + to_string(result))
    println("")
    println("3. Float Math")
    let pi = 3.14159265
    println("   pi = " + to_string(pi))
    let power = 2.0 ** 10.0
    println("   2^10 = " + to_string(power))
    println("")
    println("4. Error Handling (try/catch)")
    try {
        throw "intentional error for demo"
    } catch e {
        println("   Caught: " + e)
    }
    println("")
    println("5. Map (Hash Table)")
    let mut scores = {}
    scores["alice"] = 95
    scores["bob"] = 87
    scores["carol"] = 92
    println("   alice: " + to_string(scores["alice"]))
    println("   bob:   " + to_string(scores["bob"]))
    println("   carol: " + to_string(scores["carol"]))
    println("")
    println("6. Structs")
    let p = Point { x: 3.0, y: 4.0 }
    let dist = (p.x * p.x + p.y * p.y) ** 0.5
    println("   Point(3, 4) distance = " + to_string(dist))
    println("")
    println("7. Arrays")
    let nums = [10, 20, 30, 40, 50]
    let mut sum = 0
    for n in nums {
        sum = sum + n
    }
    println("   sum([10..50]) = " + to_string(sum))
    println("   len = " + to_string(len(nums)))
    println("")
    println("8. String Operations")
    let greeting = "Hello, " + "Kryos!"
    println("   concat: " + greeting)
    println("   length: " + to_string(len(greeting)))
    println("")
    println("=== Kryos v0.1.0 - FrostByte Digital ===")
}
