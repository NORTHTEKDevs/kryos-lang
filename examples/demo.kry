// ============================================================
// Kryos Language Demo - FrostByte Digital
// A universal systems language with AI-native capabilities
// ============================================================

extern {
    fn kryos_tensor_ones(shape_ptr: i64, ndim: i64) -> i64
    fn kryos_tensor_matmul(a: i64, b: i64) -> i64
    fn kryos_tensor_numel(handle: i64) -> i64
    fn kryos_process_argc() -> i64
}

fn fibonacci(n: i64) -> i64 {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn apply_twice(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(f(x))
}

fn double(x: i64) -> i64 {
    return x * 2
}

fn main() {
    println("=== Kryos Language Demo ===")
    println("")

    // 1. Recursion
    println("1. Recursion")
    let fib10 = fibonacci(10)
    let fib20 = fibonacci(20)
    println("   fibonacci(10) = " + to_string(fib10))
    println("   fibonacci(20) = " + to_string(fib20))
    println("")

    // 2. Higher-order functions
    println("2. Higher-Order Functions")
    let result = apply_twice(double, 3)
    println("   double(double(3)) = " + to_string(result))
    println("")

    // 3. Float math
    println("3. Float Math")
    let pi = 3.14159265
    println(pi)
    let power = 2.0 ** 10.0
    println(power)
    println("")

    // 4. Error handling
    println("4. Error Handling (try/catch)")
    try {
        throw "intentional error for demo"
    } catch e {
        println("   Caught: " + e)
    }
    println("")

    // 5. Map data structure
    println("5. Map (Hash Table)")
    let mut scores = {}
    scores["alice"] = 95
    scores["bob"] = 87
    scores["carol"] = 92
    println("   alice: " + to_string(scores["alice"]))
    println("   bob:   " + to_string(scores["bob"]))
    println("")

    // 6. Tensor runtime
    println("6. Tensor Runtime")
    let sa = [2, 3]
    let sb = [3, 4]
    let a = kryos_tensor_ones(sa as i64, 2)
    let b = kryos_tensor_ones(sb as i64, 2)
    let c = kryos_tensor_matmul(a, b)
    let cn = kryos_tensor_numel(c)
    println("   ones(2,3) @ ones(3,4) -> " + to_string(cn) + " elements")
    println("")

    // 7. Process access
    println("7. System Integration")
    let argc = kryos_process_argc()
    println("   command-line args: " + to_string(argc))
    println("")

    println("=== Kryos v0.1.0 - FrostByte Digital ===")
}
