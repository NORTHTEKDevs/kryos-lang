// Maps in the WASM backend (v0.4).
//
// `map<str, i64>` compiles to wasm via host-backed handles: the JS host
// (tools/wasm-host/run.mjs) keeps one Map per handle. insert (`m[k]=v`),
// lookup (`m[k]`), `contains(m, k)`, and `len(m)` all work.
//
//   kryos build examples/wasm_maps.kry --backend wasm -o maps.wasm
//   node tools/wasm-host/run.mjs maps.wasm
//
// expect-stdout: 3
// expect-stdout: has a
// expect-stdout: no z
// expect-stdout: len 2
fn main() {
    let mut m: map<str, i64> = {}
    m["a"] = 1
    m["b"] = 2
    println(to_string(m["a"] + m["b"]))
    if contains(m, "a") {
        println("has a")
    }
    if contains(m, "z") {
        println("has z")
    } else {
        println("no z")
    }
    println("len " + to_string(len(m)))
}
