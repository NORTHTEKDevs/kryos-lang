// async_echo.kry - Single-threaded non-blocking echo server using Kryos
// async primitives. Demonstrates tcp_set_nonblocking, tcp_try_accept,
// tcp_try_recv, and sleep_ms for cooperative event-loop pacing.

fn main() {
    let listener = tcp_listen("127.0.0.1", 9876)
    println("[server] listening on 127.0.0.1:9876")

    // Mark the listener as non-blocking so try_accept never blocks.
    tcp_set_nonblocking(listener, true)

    let mut iters = 0
    let max_iters = 50
    let mut clients_handled = 0

    while iters < max_iters {
        let client = tcp_try_accept(listener)
        if client > 0 {
            println("[server] accepted client")
            tcp_set_nonblocking(client, true)

            // Drain whatever data is currently available (one shot).
            let mut tries = 0
            while tries < 20 {
                let data = tcp_try_recv(client, 1024)
                if len(data) > 0 {
                    println("[server] got: " + data)
                    tcp_send(client, "echo: " + data)
                    tries = 21
                } else {
                    sleep_ms(10)
                    tries = tries + 1
                }
            }
            tcp_close(client)
            clients_handled = clients_handled + 1
        } else {
            // No client waiting; sleep a bit and try again.
            sleep_ms(20)
        }
        iters = iters + 1
    }

    tcp_close(listener)
    println("[server] done, clients handled: " + to_string(clients_handled))
}
