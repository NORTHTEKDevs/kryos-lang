// Nested loops (and break / continue) in the WASM backend (v0.7).
//
// The structured-CFG translator is single-level; anything it can't express
// (nested loops, `continue` that shares a loop's increment block) falls back
// to a DISPATCH RELOOPER -- one wasm `loop` over a program-counter local that
// expresses any reducible CFG. Verified wasm == native.
//
//   kryos build examples/wasm_nested_loops.kry --backend wasm -o nl.wasm
//   node tools/wasm-host/run.mjs nl.wasm
//
// expect-stdout: mult 36
// expect-stdout: triple 8
// expect-stdout: continue 9
// expect-stdout: break 10

fn main() {
    // nested for-range with a computation
    let mut mult = 0
    for i in 1..=3 {
        for j in 1..=3 {
            mult = mult + i * j
        }
    }
    println("mult " + to_string(mult))

    // triple-nested
    let mut c = 0
    for i in 0..2 {
        for j in 0..2 {
            for k in 0..2 {
                c = c + 1
            }
        }
    }
    println("triple " + to_string(c))

    // continue inside a range loop (shares the increment block)
    let mut s = 0
    for i in 0..6 {
        if i % 2 == 0 { continue }
        s = s + i
    }
    println("continue " + to_string(s))

    // early break
    let mut b = 0
    for i in 0..100 {
        if i == 5 { break }
        b = b + i
    }
    println("break " + to_string(b))
}
