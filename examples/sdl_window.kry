// SDL2 windowed graphics demo through Kryos FFI.
//
// Init video, create a window + renderer, draw a few rectangles in
// different colors, present, and quit. With SDL_VIDEODRIVER=dummy or
// =offscreen, this runs headless (good for CI / sandboxes). With a
// real display, you get an actual window.
//
// This is the proof: Kryos can write graphical applications by
// binding any C library at runtime, with no compiler changes.

// SDL_INIT_VIDEO        = 0x00000020 = 32
// SDL_WINDOWPOS_CENTERED= 0x2FFF0000 = 805240832

extern "C" {
    fn kryos_ffi_dlopen(name: str) -> i64
    fn kryos_ffi_dlsym(handle: i64, name: str) -> i64
    fn kryos_ffi_dlclose(handle: i64) -> i64

    fn kryos_ffi_dlcall0(fp: i64) -> i64
    fn kryos_ffi_dlcall1(fp: i64, a1: i64) -> i64
    fn kryos_ffi_dlcall2(fp: i64, a1: i64, a2: i64) -> i64
    fn kryos_ffi_dlcall3(fp: i64, a1: i64, a2: i64, a3: i64) -> i64
    fn kryos_ffi_dlcall5(fp: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64
    fn kryos_ffi_dlcall6(fp: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) -> i64

    fn kryos_ffi_dlcallv1(fp: i64, a1: i64)
    fn kryos_ffi_dlcallv2(fp: i64, a1: i64, a2: i64)

    fn kryos_ffi_malloc(n: i64) -> i64
    fn kryos_ffi_free(p: i64, n: i64)
    fn kryos_ffi_write_i32(p: i64, v: i64)
    fn kryos_ffi_cstr(s: str) -> i64
    fn kryos_ffi_string_from_ptr(p: i64, len: i64) -> str
}

fn main() {
    let SDL_INIT_VIDEO = 32
    let SDL_WINDOWPOS_CENTERED = 805240832
    println("--- SDL2 graphics demo ---")

    let sdl = kryos_ffi_dlopen("libSDL2-2.0.so.0")
    if sdl == 0 {
        println("SDL2 not available")
        return
    }

    let sdl_init           = kryos_ffi_dlsym(sdl, "SDL_Init")
    let sdl_quit           = kryos_ffi_dlsym(sdl, "SDL_Quit")
    let sdl_get_error      = kryos_ffi_dlsym(sdl, "SDL_GetError")
    let sdl_create_window  = kryos_ffi_dlsym(sdl, "SDL_CreateWindow")
    let sdl_destroy_window = kryos_ffi_dlsym(sdl, "SDL_DestroyWindow")
    let sdl_create_renderer  = kryos_ffi_dlsym(sdl, "SDL_CreateRenderer")
    let sdl_destroy_renderer = kryos_ffi_dlsym(sdl, "SDL_DestroyRenderer")
    let sdl_set_draw_color = kryos_ffi_dlsym(sdl, "SDL_SetRenderDrawColor")
    let sdl_render_clear   = kryos_ffi_dlsym(sdl, "SDL_RenderClear")
    let sdl_fill_rect      = kryos_ffi_dlsym(sdl, "SDL_RenderFillRect")
    let sdl_present        = kryos_ffi_dlsym(sdl, "SDL_RenderPresent")
    let sdl_delay          = kryos_ffi_dlsym(sdl, "SDL_Delay")

    // SDL_Init(SDL_INIT_VIDEO).
    let init_rc = kryos_ffi_dlcall1(sdl_init, SDL_INIT_VIDEO)
    if init_rc != 0 {
        let err_ptr = kryos_ffi_dlcall0(sdl_get_error)
        println("SDL_Init failed:")
        println(kryos_ffi_string_from_ptr(err_ptr, -1))
        return
    }
    println("SDL_Init OK")

    // SDL_CreateWindow(title, x, y, w, h, flags=0).
    let win = kryos_ffi_dlcall6(
        sdl_create_window,
        kryos_ffi_cstr("kryos + sdl2"),
        SDL_WINDOWPOS_CENTERED,
        SDL_WINDOWPOS_CENTERED,
        640,
        480,
        0,
    )
    if win == 0 {
        let err_ptr = kryos_ffi_dlcall0(sdl_get_error)
        println("CreateWindow failed:")
        println(kryos_ffi_string_from_ptr(err_ptr, -1))
        kryos_ffi_dlcall0(sdl_quit)
        return
    }
    println("window created")

    // SDL_CreateRenderer(window, index=-1, flags=0).
    let ren = kryos_ffi_dlcall3(sdl_create_renderer, win, -1, 0)
    if ren == 0 {
        let err_ptr = kryos_ffi_dlcall0(sdl_get_error)
        println("CreateRenderer failed:")
        println(kryos_ffi_string_from_ptr(err_ptr, -1))
        kryos_ffi_dlcallv1(sdl_destroy_window, win)
        kryos_ffi_dlcall0(sdl_quit)
        return
    }
    println("renderer created")

    // Clear to dark blue.
    kryos_ffi_dlcall5(sdl_set_draw_color, ren, 12, 18, 32, 255)
    kryos_ffi_dlcall1(sdl_render_clear, ren)

    // Allocate a single SDL_Rect (4 * i32 = 16 bytes) and reuse for each box.
    let rect = kryos_ffi_malloc(16)

    // Box 1: red square top-left.
    kryos_ffi_write_i32(rect,       40)   // x
    kryos_ffi_write_i32(rect +  4,  40)   // y
    kryos_ffi_write_i32(rect +  8, 120)   // w
    kryos_ffi_write_i32(rect + 12, 120)   // h
    kryos_ffi_dlcall5(sdl_set_draw_color, ren, 235, 70, 70, 255)
    kryos_ffi_dlcall2(sdl_fill_rect, ren, rect)

    // Box 2: green square center.
    kryos_ffi_write_i32(rect,      260)
    kryos_ffi_write_i32(rect +  4, 180)
    kryos_ffi_write_i32(rect +  8, 120)
    kryos_ffi_write_i32(rect + 12, 120)
    kryos_ffi_dlcall5(sdl_set_draw_color, ren, 110, 200, 110, 255)
    kryos_ffi_dlcall2(sdl_fill_rect, ren, rect)

    // Box 3: blue square bottom-right.
    kryos_ffi_write_i32(rect,      480)
    kryos_ffi_write_i32(rect +  4, 320)
    kryos_ffi_write_i32(rect +  8, 120)
    kryos_ffi_write_i32(rect + 12, 120)
    kryos_ffi_dlcall5(sdl_set_draw_color, ren, 80, 140, 240, 255)
    kryos_ffi_dlcall2(sdl_fill_rect, ren, rect)

    kryos_ffi_dlcall1(sdl_present, ren)
    println("frame drawn")

    // Show it for 250ms.
    kryos_ffi_dlcallv1(sdl_delay, 250)

    kryos_ffi_free(rect, 16)
    kryos_ffi_dlcallv1(sdl_destroy_renderer, ren)
    kryos_ffi_dlcallv1(sdl_destroy_window, win)
    kryos_ffi_dlcall0(sdl_quit)
    kryos_ffi_dlclose(sdl)

    println("clean shutdown")
}
