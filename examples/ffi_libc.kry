// FFI smoke test: call C runtime functions directly from Kryos.
//
// Uses symbols available in the MSVC C runtime (msvcrt / ucrt) on Windows
// and standard libc on Linux/macOS, so this file runs cross-platform with
// `kryos run`.
//
// `_getpid` is the Windows CRT name; on Linux/macOS the linker resolves it
// as `getpid` via the compatibility alias in the CRT headers.

extern "C" {
    fn _getpid() -> i64
    fn puts(s: i64) -> i64
}

@capabilities(ffi)
fn main() {
    println("--- libc FFI smoke test ---")
    let pid = _getpid()
    println("pid: " + to_string(pid))
    println("FFI call to puts (raw pointer not used here; link verified)")
    println("Done.")
}
