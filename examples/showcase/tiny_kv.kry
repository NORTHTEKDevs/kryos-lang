// tiny_kv.kry — an in-memory key/value store with a tiny REPL.
//
// Commands:
//   set <k> <v>  — store the value
//   get <k>      — print the value (or "<unset>")
//   del <k>      — remove the binding
//   list         — print all key/value pairs
//   quit         — exit
//
// Demonstrates: parallel-array map pattern, simple command parsing.
@capabilities(io)
fn main() {
    println("tiny_kv ready — try `set foo bar`, `get foo`, `list`, `quit`")
    let mut keys: [str] = []
    let mut vals: [str] = []
    while true {
        print("> ")
        let line = read_trimmed()
        if len(line) == 0 {
            break
        }
        let cmd = first_word(line)
        if cmd == "quit" or cmd == "exit" {
            println("bye.")
            break
        }
        if cmd == "list" {
            let n = len(keys)
            if n == 0 {
                println("(empty)")
            } else {
                let mut i: i64 = 0
                while i < n {
                    println(keys[i] + " = " + vals[i])
                    i = i + 1
                }
            }
            continue
        }
        if cmd == "set" {
            let rest = after_word(line)
            let k = first_word(rest)
            let v = after_word(rest)
            if len(k) == 0 or len(v) == 0 {
                println("usage: set <key> <value>")
                continue
            }
            let idx = find_idx(keys, k)
            if idx >= 0 {
                vals[idx] = v
            } else {
                keys = push(keys, k)
                vals = push(vals, v)
            }
            println("ok")
            continue
        }
        if cmd == "get" {
            let k = first_word(after_word(line))
            let idx = find_idx(keys, k)
            if idx >= 0 {
                println(vals[idx])
            } else {
                println("<unset>")
            }
            continue
        }
        if cmd == "del" {
            let k = first_word(after_word(line))
            let idx = find_idx(keys, k)
            if idx >= 0 {
                // Swap-remove: replace with last entry, then pop semantically by
                // shrinking via re-assignment (the dynamic-array runtime supports
                // index assignment).
                let last = len(keys) - 1
                keys[idx] = keys[last]
                vals[idx] = vals[last]
                // Then actually SHRINK. Leaving the slot in place made `list`
                // print the swapped-in entry twice after any delete.
                pop(keys)
                pop(vals)
                println("ok")
            } else {
                println("<unset>")
            }
            continue
        }
        println("unknown command: " + cmd)
    }
}

// NOT named `read_line`: a user function SHADOWS the same-named builtin, and
// the shadow applies inside its own body too -- `fn read_line() { read_line() }`
// calls ITSELF and overflows the stack on the first command. There is no way
// to reach a shadowed builtin from within the shadowing function, so the
// wrapper needs a distinct name.
fn read_trimmed() -> str {
    let line = read_line()
    return rstrip(line)
}

fn first_word(s: str) -> str {
    let n = len(s)
    let mut i: i64 = 0
    while i < n {
        if char_code(substr(s, i, i + 1)) == 32 {
            return substr(s, 0, i)
        }
        i = i + 1
    }
    return s
}

fn after_word(s: str) -> str {
    let n = len(s)
    let mut i: i64 = 0
    while i < n {
        if char_code(substr(s, i, i + 1)) == 32 {
            return substr(s, i + 1, n)
        }
        i = i + 1
    }
    return ""
}

fn rstrip(s: str) -> str {
    let mut n = len(s)
    while n > 0 {
        let c = char_code(substr(s, n - 1, n))
        if c == 10 or c == 13 or c == 32 {
            n = n - 1
        } else {
            break
        }
    }
    return substr(s, 0, n)
}

fn find_idx(names: [str], target: str) -> i64 {
    let n = len(names)
    let mut i: i64 = 0
    while i < n {
        if names[i] == target {
            return i
        }
        i = i + 1
    }
    return -1
}
