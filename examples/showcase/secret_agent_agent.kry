// secret_agent_agent.kry -- the agent module for examples/showcase/secret_agent.kry
//
// Every function below is annotated `@capabilities()` -- explicitly EMPTY.
// Nothing reachable from `agent_audit`/`agent_recommend` may touch the
// network, the filesystem, a subprocess, or FFI: under
// `--strict-capabilities` any attempt to call `http2_post`, `file_write`,
// `env_get`, or an `extern` block from this module's call graph is a
// compile error (E0505 direct / E0507 propagated), not a runtime check
// that a malicious or buggy agent could route around. See
// secret_agent_overreach.kry for that rejection captured for real.
//
// The agent also never imports `SecretEntry` or `vault_reveal` from
// secret_agent_vault.kry -- it only ever sees `[SecretMeta]`, a type with
// no `value` field. That is a second, structural guarantee independent of
// capabilities: this module cannot leak a secret it has no field to hold.
//
// Caveat, stated honestly (see the ledger): Kryos's capability checker
// tracks authority by NAME and does not yet follow a capability requirement
// through a first-class function VALUE (`tools/loop/LEDGER.md` item #1,
// "capability escape via closure/fn-value laundering", open design note).
// This module deliberately avoids the pattern that hole depends on -- no
// function here accepts or invokes a `fn(...)`-typed parameter -- so the
// zero-capability guarantee it demonstrates does not rely on the part of
// the checker that is not yet sound.

use secret_agent_vault::{SecretMeta}

struct AuditReport {
    total: i64,
    weak_count: i64,
    stale_count: i64,
    weak_names: [str],
    stale_names: [str],
}

@capabilities()
fn _is_weak(strength: i64) -> bool {
    return strength < 40
}

@capabilities()
fn _is_stale(rotated_days: i64) -> bool {
    return rotated_days > 90
}

// Walks ONLY redacted metadata. No raw secret value is reachable from here.
@capabilities()
fn agent_audit(metas: [SecretMeta]) -> AuditReport {
    let mut weak_names: [str] = []
    let mut stale_names: [str] = []
    let mut i = 0
    while i < len(metas) {
        let m = metas[i]
        if _is_weak(m.strength) {
            weak_names = push(weak_names, m.name)
        }
        if _is_stale(m.rotated_days) {
            stale_names = push(stale_names, m.name)
        }
        i = i + 1
    }
    return AuditReport {
        total: len(metas),
        weak_count: len(weak_names),
        stale_count: len(stale_names),
        weak_names: weak_names,
        stale_names: stale_names,
    }
}

@capabilities()
fn agent_recommend(report: AuditReport) -> [str] {
    let mut out: [str] = []
    let mut i = 0
    while i < len(report.weak_names) {
        out = push(out, "rotate '" + report.weak_names[i] + "': weak secret")
        i = i + 1
    }
    let mut j = 0
    while j < len(report.stale_names) {
        out = push(out, "rotate '" + report.stale_names[j] + "': not rotated in 90+ days")
        j = j + 1
    }
    if len(out) == 0 {
        out = push(out, "vault is healthy: no weak or stale secrets")
    }
    return out
}
