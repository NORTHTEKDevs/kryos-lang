// kdoc.kry — minimal documentation extractor for Kryos source.
//
// Reads a list of .kry files from argv (or stdin), scans for `pub fn` and
// `pub struct` declarations together with the contiguous `//` line comments
// that immediately precede them, and emits a Markdown reference. This is
// a real compiler-adjacent tool written entirely in Kryos.
//
// Usage:
//   kryos run kdoc.kry -- src/lib.kry src/utils.kry > API.md
//
// Limitations:
//   * Comment scanner is line-based and recognises `//` style doc lines.
//   * Signature extraction stops at the first `{` (function body) or end
//     of declaration line for struct heads.
//   * Does not parse expressions; intentionally simple and fast.

fn is_space(c: i64) -> i64 {
  if c == 32 { return 1 }
  if c == 9 { return 1 }
  return 0
}

fn ltrim(s: str) -> str {
  let n: i64 = len(s)
  let mut i: i64 = 0
  while i < n {
    let c: i64 = char_code(substr(s, i, i + 1))
    if is_space(c) == 0 {
      return substr(s, i, n)
    }
    i = i + 1
  }
  return ""
}

fn rtrim(s: str) -> str {
  let n: i64 = len(s)
  let mut j: i64 = n
  while j > 0 {
    let c: i64 = char_code(substr(s, j - 1, j))
    if is_space(c) == 0 {
      return substr(s, 0, j)
    }
    j = j - 1
  }
  return ""
}

fn trim(s: str) -> str {
  return rtrim(ltrim(s))
}

fn starts_with(s: str, prefix: str) -> i64 {
  let p: i64 = len(prefix)
  if len(s) < p { return 0 }
  if substr(s, 0, p) == prefix { return 1 }
  return 0
}

// Truncate at first occurrence of `\{` so the signature reads cleanly.
fn before_lbrace(s: str) -> str {
  let n: i64 = len(s)
  let mut i: i64 = 0
  while i < n {
    if substr(s, i, i + 1) == "\{" {
      return rtrim(substr(s, 0, i))
    }
    i = i + 1
  }
  return rtrim(s)
}

// Split the source into lines (keeping order, no trailing \n).
fn split_lines(src: str) -> [str] {
  let mut lines: [str] = []
  let n: i64 = len(src)
  let mut start: i64 = 0
  let mut i: i64 = 0
  while i < n {
    if substr(src, i, i + 1) == "\n" {
      push(lines, substr(src, start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    push(lines, substr(src, start, n))
  }
  return lines
}

fn doc_line(line: str) -> str {
  let t: str = ltrim(line)
  if starts_with(t, "///") == 1 {
    return ltrim(substr(t, 3, len(t)))
  }
  if starts_with(t, "//") == 1 {
    return ltrim(substr(t, 2, len(t)))
  }
  return ""
}

fn is_doc(line: str) -> i64 {
  let t: str = ltrim(line)
  if starts_with(t, "//") == 1 { return 1 }
  return 0
}

fn process_file(path: str) -> i64 {
  if file_exists(path) == 0 {
    println("kdoc: skipped (missing): " + path)
    return 0
  }
  let src: str = file_read(path)
  let lines: [str] = split_lines(src)
  let n: i64 = len(lines)

  println("")
  println("## " + path)
  println("")

  let mut i: i64 = 0
  let mut emitted: i64 = 0
  while i < n {
    let line: str = lines[i]
    let t: str = ltrim(line)
    let is_pub_fn: i64 = starts_with(t, "pub fn ")
    let is_pub_struct: i64 = starts_with(t, "pub struct ")
    if is_pub_fn == 1 or is_pub_struct == 1 {
      // Gather contiguous preceding doc lines.
      let mut doc_start: i64 = i
      while doc_start > 0 {
        if is_doc(lines[doc_start - 1]) == 1 {
          doc_start = doc_start - 1
        } else {
          break
        }
      }
      let sig: str = before_lbrace(t)
      println("### " + sig)
      println("")
      let mut d: i64 = doc_start
      while d < i {
        let dl: str = doc_line(lines[d])
        if len(dl) > 0 {
          println(dl)
        }
        d = d + 1
      }
      println("")
      emitted = emitted + 1
    }
    i = i + 1
  }

  if emitted == 0 {
    println("_(no public items)_")
    println("")
  }
  return emitted
}

fn main() {
  let argv: [str] = args()
  let n: i64 = len(argv)
  // argv[0] is the program path; skip it.
  if n < 2 {
    println("usage: kryos run kdoc.kry -- <file.kry> [file.kry ...]")
    return
  }

  println("# Kryos API Reference")
  println("")
  println("_Generated by kdoc (a compiler tool written in Kryos)._ ")

  let mut i: i64 = 1
  let mut total: i64 = 0
  while i < n {
    let added: i64 = process_file(argv[i])
    total = total + added
    i = i + 1
  }

  println("")
  println("---")
  println("")
  println("**Summary:** " + to_string(total) + " public items across " + to_string(n - 1) + " files.")
}
