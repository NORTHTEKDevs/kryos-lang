// secret_agent_vault.kry -- the vault module for examples/showcase/secret_agent.kry
//
// This is the ONLY module with authority to touch the secret store on disk
// (`fs:read` to load, `fs:write` to save). It owns the full-fidelity
// `SecretEntry` type (name + raw secret VALUE + metadata) and is the sole
// place `vault_reveal` -- the one function that ever hands back a raw
// secret -- lives. `secret_agent_agent.kry` (the agent module) never
// imports `vault_reveal` and never sees `SecretEntry`; it only ever
// receives `[SecretMeta]`, a projection with no `value` field at all. That
// is a second, structural line of defense on top of the capability
// boundary: even a compromised agent function cannot leak a secret value
// it was never given a way to reach.
//
// Sibling-file import (no kryos.toml needed -- `use secret_agent_vault`
// resolves to this file because it sits next to the importer, per
// resolve.rs's search order: sibling file first, project src/ second).
//
// Storage format: one secret per line, pipe-delimited --
//   name|value|kind|strength|rotated_days
// Plain-text pipe fields, not JSON: EVERY Kryos string interpolates on `{`
// (CLAUDE.md gotcha #1), so a JSON object literal needs brace-doubling for
// no benefit here -- a flat delimited format sidesteps that entirely.

use std::string::{split, split_lines, join}

// Full-fidelity record. Never crosses into the agent module.
struct SecretEntry {
    name: str,
    value: str,
    kind: str,
    strength: i64,
    rotated_days: i64,
}

// Non-secret projection -- the ONLY shape the agent module ever sees.
// There is no `value` field: the type itself cannot carry a secret.
struct SecretMeta {
    name: str,
    kind: str,
    strength: i64,
    rotated_days: i64,
}

struct Vault {
    entries: [SecretEntry],
}

@capabilities()
fn vault_new() -> Vault {
    return Vault { entries: [] }
}

@capabilities()
fn vault_add(v: Vault, name: str, value: str, kind: str, strength: i64, rotated_days: i64) -> Vault {
    let entry = SecretEntry { name: name, value: value, kind: kind, strength: strength, rotated_days: rotated_days }
    let mut entries = v.entries
    entries = push(entries, entry)
    return Vault { entries: entries }
}

@capabilities()
fn vault_count(v: Vault) -> i64 {
    return len(v.entries)
}

// The ONLY function in this module that returns a raw secret VALUE.
// `main()` uses this to prove a save/load round trip is byte-exact; the
// agent module never imports it.
@capabilities()
fn vault_reveal(v: Vault, name: str) -> str {
    let mut i = 0
    while i < len(v.entries) {
        if v.entries[i].name == name {
            return v.entries[i].value
        }
        i = i + 1
    }
    return ""
}

// The redacted projection that crosses into the agent's world: metadata
// only, no `value` field.
@capabilities()
fn vault_metadata(v: Vault) -> [SecretMeta] {
    let mut out: [SecretMeta] = []
    let mut i = 0
    while i < len(v.entries) {
        let e = v.entries[i]
        out = push(out, SecretMeta { name: e.name, kind: e.kind, strength: e.strength, rotated_days: e.rotated_days })
        i = i + 1
    }
    return out
}

fn _serialize_entry(e: SecretEntry) -> str {
    return e.name + "|" + e.value + "|" + e.kind + "|" + to_string(e.strength) + "|" + to_string(e.rotated_days)
}

fn _parse_entry(line: str) -> SecretEntry {
    let fields = split(line, "|")
    return SecretEntry {
        name: fields[0],
        value: fields[1],
        kind: fields[2],
        strength: parse_int(fields[3]),
        rotated_days: parse_int(fields[4]),
    }
}

// Vault authority: persist the store. Requires fs:write.
@capabilities(fs:write)
fn vault_save(v: Vault, path: str) {
    let mut lines: [str] = []
    let mut i = 0
    while i < len(v.entries) {
        lines = push(lines, _serialize_entry(v.entries[i]))
        i = i + 1
    }
    file_write(path, join(lines, "\n"))
}

// Vault authority: reload the store. Requires fs:read.
@capabilities(fs:read)
fn vault_load(path: str) -> Vault {
    if file_exists(path) == 0 {
        return vault_new()
    }
    let raw = file_read(path)
    let lines = split_lines(raw)
    let mut entries: [SecretEntry] = []
    let mut i = 0
    while i < len(lines) {
        if len(lines[i]) > 0 {
            entries = push(entries, _parse_entry(lines[i]))
        }
        i = i + 1
    }
    return Vault { entries: entries }
}
