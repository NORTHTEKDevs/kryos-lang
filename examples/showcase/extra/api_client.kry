// api_client.kry — outbound HTTP GET + JSON parsing.
// Fetches a public test API and pretty-prints the response.

fn main() {
  let url: str = "https://httpbin.org/json"
  println("GET " + url)

  let resp: i64 = http_request("GET", url, "", "", 5000)
  if json_is_null(resp) {
    println("(request failed)")
    return
  }

  let status_node: i64 = json_get(resp, "status")
  let status: i64 = json_to_int(status_node)
  println("status: " + to_string(status))

  let body_node: i64 = json_get(resp, "body")
  let body: str = json_to_str(body_node)
  println("body length: " + to_string(len(body)) + " bytes")

  // Parse the body as JSON and walk it.
  let parsed: i64 = json_parse(body)
  if json_is_null(parsed) {
    println("(body not JSON)")
    return
  }

  let slideshow: i64 = json_get(parsed, "slideshow")
  let title: i64 = json_get(slideshow, "title")
  let author: i64 = json_get(slideshow, "author")
  println("title:  " + json_to_str(title))
  println("author: " + json_to_str(author))
}
