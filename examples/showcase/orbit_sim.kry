// orbit_sim.kry
//
// Two independent programs in one file, both chosen to hammer f64 / integer
// arithmetic across the Cranelift JIT (`kryos run`) and LLVM AOT
// (`kryos build --release`) backends:
//
//   1. N-body gravity simulation (softened forces, velocity-Verlet
//      symplectic integrator, 4 bodies, 1000 fixed timesteps). Energy
//      drift is printed as the correctness signal.
//   2. Conway's Game of Life on a 20x20 wrapped grid, seeded with a
//      glider, 40 generations.
//
// Pure compute -- no filesystem, network, or process access, so no
// @capabilities annotation should be required on main().

use std::fmt::{float_fixed}

// ---------------------------------------------------------------------
// N-body gravity simulation
// ---------------------------------------------------------------------

let G: f64 = 1.0
let EPS2: f64 = 0.0001
let DT: f64 = 0.001
let STEPS: i64 = 1000
let N: i64 = 4
let ENERGY_DRIFT_BOUND: f64 = 0.0001

fn compute_accel(xs: [f64], ys: [f64], masses: [f64], n: i64) -> ([f64], [f64]) {
    let mut ax: [f64] = []
    let mut ay: [f64] = []
    let mut fill: i64 = 0
    while fill < n {
        ax = push(ax, 0.0)
        ay = push(ay, 0.0)
        fill = fill + 1
    }

    let mut bi: i64 = 0
    while bi < n {
        let mut axi: f64 = 0.0
        let mut ayi: f64 = 0.0
        let mut bj: i64 = 0
        while bj < n {
            if bj != bi {
                let dx: f64 = xs[bj] - xs[bi]
                let dy: f64 = ys[bj] - ys[bi]
                let dist2: f64 = dx * dx + dy * dy + EPS2
                let denom: f64 = pow(dist2, 1.5)
                let f: f64 = G * masses[bj] / denom
                axi = axi + f * dx
                ayi = ayi + f * dy
            }
            bj = bj + 1
        }
        ax[bi] = axi
        ay[bi] = ayi
        bi = bi + 1
    }

    return (ax, ay)
}

fn total_energy(xs: [f64], ys: [f64], vxs: [f64], vys: [f64], masses: [f64], n: i64) -> f64 {
    let mut ke: f64 = 0.0
    let mut i: i64 = 0
    while i < n {
        let v2: f64 = vxs[i] * vxs[i] + vys[i] * vys[i]
        ke = ke + 0.5 * masses[i] * v2
        i = i + 1
    }

    let mut pe: f64 = 0.0
    let mut a: i64 = 0
    while a < n {
        let mut b: i64 = a + 1
        while b < n {
            let dx: f64 = xs[b] - xs[a]
            let dy: f64 = ys[b] - ys[a]
            let dist: f64 = sqrt(dx * dx + dy * dy + EPS2)
            pe = pe - (G * masses[a] * masses[b] / dist)
            b = b + 1
        }
        a = a + 1
    }

    return ke + pe
}

fn print_positions(xs: [f64], ys: [f64], n: i64, step: i64) {
    println("-- step {step} --")
    let mut i: i64 = 0
    while i < n {
        let sx: str = float_fixed(xs[i], 6)
        let sy: str = float_fixed(ys[i], 6)
        println("  body {i}: x={sx} y={sy}")
        i = i + 1
    }
}

fn run_orbit_sim() {
    println("=== N-body gravity simulation ===")

    // Body 0 is a heavy central mass at rest; bodies 1-3 start on circular
    // orbits computed from the two-body approximation (v = sqrt(G*M/r)),
    // then evolve under the FULL N-body force (star recoil + planet-planet
    // interaction included), which is why the orbits are not perfectly
    // circular over the run.
    let mut xs: [f64] = [0.0, 10.0, 0.0, -8.0]
    let mut ys: [f64] = [0.0, 0.0, 15.0, -8.0]
    let masses: [f64] = [1000.0, 1.0, 1.0, 1.0]
    let mut vxs: [f64] = [0.0]
    let mut vys: [f64] = [0.0]

    let mut init_i: i64 = 1
    while init_i < N {
        let x: f64 = xs[init_i]
        let y: f64 = ys[init_i]
        let r: f64 = sqrt(x * x + y * y)
        let speed: f64 = sqrt(G * masses[0] / r)
        vxs = push(vxs, 0.0 - (y / r) * speed)
        vys = push(vys, (x / r) * speed)
        init_i = init_i + 1
    }

    let e_start: f64 = total_energy(xs, ys, vxs, vys, masses, N)
    println("initial total energy: {float_fixed(e_start, 10)}")
    print_positions(xs, ys, N, 0)

    let (ax0, ay0) = compute_accel(xs, ys, masses, N)
    let mut ax: [f64] = ax0
    let mut ay: [f64] = ay0

    let mut step: i64 = 1
    while step <= STEPS {
        let mut i: i64 = 0
        while i < N {
            xs[i] = xs[i] + vxs[i] * DT + 0.5 * ax[i] * DT * DT
            ys[i] = ys[i] + vys[i] * DT + 0.5 * ay[i] * DT * DT
            i = i + 1
        }

        let (ax_new, ay_new) = compute_accel(xs, ys, masses, N)

        let mut j: i64 = 0
        while j < N {
            vxs[j] = vxs[j] + 0.5 * (ax[j] + ax_new[j]) * DT
            vys[j] = vys[j] + 0.5 * (ay[j] + ay_new[j]) * DT
            j = j + 1
        }

        ax = ax_new
        ay = ay_new

        if step % 100 == 0 {
            print_positions(xs, ys, N, step)
        }

        step = step + 1
    }

    let e_end: f64 = total_energy(xs, ys, vxs, vys, masses, N)
    println("final total energy:   {float_fixed(e_end, 10)}")

    let drift: f64 = abs(e_end - e_start)
    let rel_drift: f64 = drift / abs(e_start)
    println("energy drift: {float_fixed(drift, 10)} (relative {float_fixed(rel_drift, 10)})")

    if rel_drift < ENERGY_DRIFT_BOUND {
        println("N-BODY CONSERVATION: PASS")
    } else {
        println("N-BODY CONSERVATION: FAIL")
    }
}

// ---------------------------------------------------------------------
// Conway's Game of Life -- 20x20 wrapped grid, flat [i64] backing store
// ---------------------------------------------------------------------

let GRID_SIZE: i64 = 20
let GENERATIONS: i64 = 40

fn wrap(i: i64, size: i64) -> i64 {
    return ((i % size) + size) % size
}

fn cell_index(size: i64, row: i64, col: i64) -> i64 {
    let r: i64 = wrap(row, size)
    let c: i64 = wrap(col, size)
    return r * size + c
}

fn make_empty_grid(size: i64) -> [i64] {
    let mut g: [i64] = []
    let total: i64 = size * size
    let mut i: i64 = 0
    while i < total {
        g = push(g, 0)
        i = i + 1
    }
    return g
}

fn count_neighbors(g: [i64], size: i64, row: i64, col: i64) -> i64 {
    let mut count: i64 = 0
    let mut dr: i64 = 0 - 1
    while dr <= 1 {
        let mut dc: i64 = 0 - 1
        while dc <= 1 {
            if dr != 0 || dc != 0 {
                count = count + g[cell_index(size, row + dr, col + dc)]
            }
            dc = dc + 1
        }
        dr = dr + 1
    }
    return count
}

fn step_life(g: [i64], size: i64) -> [i64] {
    let mut next: [i64] = make_empty_grid(size)
    let mut r: i64 = 0
    while r < size {
        let mut c: i64 = 0
        while c < size {
            let alive: i64 = g[cell_index(size, r, c)]
            let n: i64 = count_neighbors(g, size, r, c)
            let mut new_state: i64 = 0
            if alive == 1 {
                if n == 2 || n == 3 {
                    new_state = 1
                }
            } else {
                if n == 3 {
                    new_state = 1
                }
            }
            next[cell_index(size, r, c)] = new_state
            c = c + 1
        }
        r = r + 1
    }
    return next
}

fn print_grid(g: [i64], size: i64, gen: i64) {
    println("-- generation {gen} --")
    let mut r: i64 = 0
    while r < size {
        let mut line: str = ""
        let mut c: i64 = 0
        while c < size {
            let v: i64 = g[cell_index(size, r, c)]
            if v == 1 {
                line = line + "#"
            } else {
                line = line + "."
            }
            c = c + 1
        }
        println(line)
        r = r + 1
    }
}

fn run_game_of_life() {
    println("")
    println("=== Conway's Game of Life (20x20, wrapped) ===")

    let mut grid: [i64] = make_empty_grid(GRID_SIZE)
    // Glider, top-left corner.
    grid[cell_index(GRID_SIZE, 0, 1)] = 1
    grid[cell_index(GRID_SIZE, 1, 2)] = 1
    grid[cell_index(GRID_SIZE, 2, 0)] = 1
    grid[cell_index(GRID_SIZE, 2, 1)] = 1
    grid[cell_index(GRID_SIZE, 2, 2)] = 1

    print_grid(grid, GRID_SIZE, 0)

    let mut gen: i64 = 1
    while gen <= GENERATIONS {
        grid = step_life(grid, GRID_SIZE)
        if gen == 20 || gen == 40 {
            print_grid(grid, GRID_SIZE, gen)
        }
        gen = gen + 1
    }
}

fn main() {
    run_orbit_sim()
    run_game_of_life()
}
