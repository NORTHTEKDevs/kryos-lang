// ============================================================
// Kryos Showcase: LLM-Style Agent Runtime
//
// A deterministic, self-contained agent loop that mirrors the
// shape of a real LLM tool-use harness — without external API
// calls, so the showcase runs in CI.
//
// What it demonstrates:
//   * A tool registry (name → handler dispatch)
//   * A message log (user / assistant / tool) maintained as
//     parallel string arrays — flat and easy to reason about
//   * The classic plan → tool-call → observe → respond cycle
//   * Bounded budgets and a graceful stop condition
//   * The planner returns a real `Action` struct carrying str
//     fields (the original v0.4-era struct-with-strings ownership
//     bug from docs/BUGS.md is resolved and tested in
//     tests/e2e/ownership/struct_with_strings_*_run.kry)
//
// The "LLM" is a tiny rule-based planner that inspects the user
// query and emits either a tool call or a final answer. Replacing
// it with a real model is a one-function swap: rewrite
// `plan_next(...)`.
//
// run-expect: assistant: 36
// ============================================================
// ---- Tool implementations ------------------------------------
fn tool_echo(s: str, _n: i64) -> str {
    return "echo: " + s
}

fn tool_calc(s: str, n: i64) -> str {
    if s == "square" {
        return to_string(n * n)
    }
    if s == "double" {
        return to_string(n + n)
    }
    if s == "triangular" {
        return to_string(n * (n + 1) / 2)
    }
    return "calc: unknown op"
}

fn tool_sysinfo(_s: str, _n: i64) -> str {
    return "kryos-agent v0.4 / sandboxed / clock=" + to_string(time_now())
}

fn dispatch_tool(name: str, s: str, n: i64) -> str {
    if name == "echo" {
        return tool_echo(s, n)
    }
    if name == "calc" {
        return tool_calc(s, n)
    }
    if name == "sysinfo" {
        return tool_sysinfo(s, n)
    }
    return "error: unknown tool"
}

// ---- Planner (rule-based stand-in for an LLM) ---------------
//
// The planner returns an `Action` carrying both the tool-call
// arguments and the final-answer text. `kind` selects between:
//   1 = tool call (read `name`, `arg_s`, `arg_i`)
//   2 = final answer (read `arg_s`)
struct Action {
    kind: i64
    name: str
    arg_s: str
    arg_i: i64
}

fn plan_next(
    user_query: str,
    has_observation: bool,
    observation: str
) -> Action {
    if has_observation {
        return Action { kind: 2, name: "", arg_s: observation, arg_i: 0 }
    }
    if contains(user_query, "square of 6") {
        return Action { kind: 1, name: "calc", arg_s: "square", arg_i: 6 }
    }
    if contains(user_query, "21 doubled") {
        return Action { kind: 1, name: "calc", arg_s: "double", arg_i: 21 }
    }
    if contains(user_query, "triangular") {
        return Action { kind: 1, name: "calc", arg_s: "triangular", arg_i: 7 }
    }
    if contains(user_query, "system info") {
        return Action { kind: 1, name: "sysinfo", arg_s: "", arg_i: 0 }
    }
    if contains(user_query, "echo ") {
        let stripped = replace(user_query, "echo ", "")
        return Action { kind: 1, name: "echo", arg_s: stripped, arg_i: 0 }
    }
    return Action { kind: 2, name: "", arg_s: "I don't know how to handle that query.", arg_i: 0 }
}

// ---- The agent loop -----------------------------------------
//
// Runs at most `max_steps` planner iterations. Returns the final
// assistant message, or a budget-exceeded notice. The history is
// flattened into two parallel arrays of (role, content).
fn run_agent(initial_query: str, max_steps: i64) -> str {
    let mut roles: [str] = []
    let mut contents: [str] = []
    push(roles, "user")
    push(contents, initial_query)
    let mut step = 0
    while step < max_steps {
        // Find latest user query and the latest tool observation, if any.
        let n = len(roles)
        let mut last_user = ""
        let mut last_obs = ""
        let mut has_obs = false
        let mut k = 0
        while k < n {
            if roles[k] == "user" {
                last_user = contents[k]
            }
            if roles[k] == "tool" {
                has_obs = true
                last_obs = contents[k]
            }
            k = k + 1
        }
        let act = plan_next(last_user, has_obs, last_obs)
        if act.kind == 2 {
            // Final answer. Clone the str field so we can both store it in
            // history and return it (each consumer needs its own owned copy).
            let answer = act.arg_s + ""
            push(roles, "assistant")
            push(contents, answer)
            return act.arg_s
        }
        // kind == 1 → tool call.
        // Clone the planner's str fields so dispatch_tool gets owned copies
        // and the println below still has valid handles for `act.name` /
        // `act.arg_s`.
        let name = act.name + ""
        let s = act.arg_s + ""
        let i = act.arg_i
        println("  [tool] " + name + "(" + s + ", " + to_string(i) + ")")
        let observation = dispatch_tool(name, s, i)
        push(roles, "tool")
        push(contents, observation)
        step = step + 1
    }
    return "(agent exceeded its step budget)"
}

// ---- Demo driver --------------------------------------------
fn demo(query: str) {
    println("user:      " + query)
    let answer = run_agent(query, 8)
    println("assistant: " + answer)
    println("")
}

fn main() {
    println("=== Kryos Showcase: Agent Runtime ===")
    println("(deterministic rule-based 'LLM' — swap plan_next() for a real model)")
    println("")
    demo("what is the square of 6") // 36
    demo("what is 21 doubled") // 42
    demo("give me the 7th triangular number") // 28
    demo("system info please")
    demo("echo hello kryos")
    demo("tell me a story")
    println("=== Done ===")
}
