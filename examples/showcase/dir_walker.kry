// dir_walker.kry — recursive directory walker that counts .kry files.
//
// Demonstrates: std::fs::walk_dir (recursive traversal), filtering,
// simple aggregate stats. Point it at any directory:
//
//   kryos run dir_walker.kry [root]

use std::fs::{walk_dir, read_file}
use std::string::{ends_with}

@capabilities(io)
fn main() {
    let argv = args()
    let root: str = if len(argv) >= 2 { argv[1] } else { "." }
    println("scanning " + root + " ...")
    println("")
    let paths = walk_dir(root)
    let mut count: i64 = 0
    let mut total_size: i64 = 0
    for p in paths {
        if not ends_with(p, ".kry") {
            continue
        }
        let body = read_file(p)
        count = count + 1
        total_size = total_size + len(body)
        println("  " + p + "  (" + to_string(len(body)) + " bytes)")
    }
    println("")
    println("found " + to_string(count) + " .kry files, " + to_string(total_size) + " bytes total")
}
