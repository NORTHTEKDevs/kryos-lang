// dir_walker.kry — recursive directory walker that counts .kry files.
//
// Demonstrates: file_exists, custom recursion control, simple stats.
// Note: Kryos doesn't have a builtin readdir; this example uses the
// platform-specific shell-out pattern. Replace with std::fs::read_dir
// when that lands (planned post-v4.0).

use std::string::{split_lines}

@capabilities(io)
fn main() {
    let argv = args()
    let root: str = if len(argv) >= 2 { argv[1] } else { "." }

    println("scanning " + root + " ...")
    println("")

    // Naive depth-limited walk via shell. Bounded to 4 levels deep.
    let listing = file_read(".kry_walker_listing.txt")
    // For this example we assume the caller pre-generated the file:
    //   find <root> -name '*.kry' > .kry_walker_listing.txt
    let paths = split_lines(listing)
    let mut count: i64 = 0
    let mut total_size: i64 = 0
    for p in paths {
        if len(p) == 0 { continue }
        if !contains(p, ".kry") { continue }
        count = count + 1
        let body = file_read(p)
        total_size = total_size + len(body)
    }

    println("kry files:    " + to_string(count))
    println("total bytes:  " + to_string(total_size))
    let avg: i64 = if count > 0 { total_size / count } else { 0 }
    println("avg per file: " + to_string(avg))
}
