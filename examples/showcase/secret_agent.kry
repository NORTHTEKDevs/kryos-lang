// secret_agent.kry -- a small password/secret manager with an embedded
// "agent" component, structured so the CAPABILITY MODEL does the security
// work.
//
// Three pieces, two of them separate modules (sibling-file `use`, no
// kryos.toml needed):
//   secret_agent_vault.kry  -- owns the store. fs:read to load, fs:write to
//                              save. The only place a raw secret VALUE can
//                              come from (`vault_reveal`).
//   secret_agent_agent.kry  -- queries REDACTED metadata only
//                              ([SecretMeta], no `value` field) and is
//                              declared @capabilities() -- empty -- on
//                              every function. It cannot reach net, fs:write,
//                              process, or ffi no matter what it does,
//                              because the compiler will not let a
//                              zero-capability call graph touch a gated
//                              builtin. See secret_agent_overreach.kry for
//                              that rejection captured for real, with the
//                              exact error code and message.
//   secret_agent.kry (this file) -- composes them. Declares
//                              @capabilities(fs:read, fs:write, process):
//                              fs:read/fs:write because it directly calls
//                              vault_load/vault_save, process because
//                              locating a temp dir reads the environment
//                              (env_get is gated -- reading the environment
//                              can itself exfiltrate secrets).
//
// This is the target shape for the intended use case: a local agent that
// manages secrets and PROVABLY cannot exfiltrate them, because doing so
// would require a capability it was never granted -- not a runtime policy
// it could be tricked into skipping.
//
// Run both ways:
//   kryos run examples/showcase/secret_agent.kry
//   kryos build --release examples/showcase/secret_agent.kry -o secret_agent
//
// Every number below is asserted (std::test's assert_eq for i64 values), not
// just printed -- a silently wrong audit count would defeat the whole point
// of the demo. String values use a local `assert_str_eq`, NOT
// `std::test::assert_eq`: `assert_eq`'s params are typed `any`, which
// erases to a bare i64 slot (CLAUDE.md's `any`-erasure gotcha), so it
// compares two `str` arguments by raw POINTER, not content -- two
// content-identical strings from different allocations (exactly what a
// disk round trip produces) report as unequal. Confirmed with a minimal
// repro (`a: str = "hello"`, `b: str = "hel" + "lo"`: `a == b` is `true`,
// `assert_eq(a, b, ..)` throws anyway) and filed in the ledger. `assert_eq`
// is fine for i64 (the erased slot IS the value there), which is every
// other assertion below.

use secret_agent_vault::{Vault, vault_new, vault_add, vault_save, vault_load, vault_count, vault_metadata, vault_reveal}
use secret_agent_agent::{AuditReport, agent_audit, agent_recommend}
use std::test::{assert_eq}

fn assert_str_eq(actual: str, expected: str, msg: str) {
    if actual != expected {
        throw "assertion failed: " + msg + " -- expected \"" + expected + "\" but got \"" + actual + "\""
    }
}

@capabilities(process)
fn vault_path() -> str {
    let t = env_get("TEMP")
    if len(t) > 0 { return t + "/kryos_secret_agent_vault.txt" }
    let t2 = env_get("TMP")
    if len(t2) > 0 { return t2 + "/kryos_secret_agent_vault.txt" }
    let t3 = env_get("TMPDIR")
    if len(t3) > 0 { return t3 + "/kryos_secret_agent_vault.txt" }
    return "/tmp/kryos_secret_agent_vault.txt"
}

@capabilities(fs:read, fs:write, process)
fn main() {
    let path = vault_path()

    // Seed the vault. A real deployment would import these from a browser's
    // password store; that's out of scope for a compiler demo.
    let mut v = vault_new()
    v = vault_add(v, "github_pat", "ghp_9f8e7d6c5b4a3210", "api_key", 82, 12)
    v = vault_add(v, "wifi_home", "letmein123", "password", 22, 410)
    v = vault_add(v, "db_prod", "Tr0ub4dor&3-xkcd-2011", "password", 71, 45)
    v = vault_add(v, "aws_secret", "AKIA-fake-not-real-000000", "api_key", 58, 97)
    assert_eq(vault_count(v), 4, "vault should hold 4 seeded entries")

    // Exercise the vault's OWN authority for real: persist, then reload
    // from a fresh Vault value (not the in-memory one) to prove the fs
    // round trip is byte-exact, not just "didn't crash".
    vault_save(v, path)
    let reloaded = vault_load(path)
    assert_eq(vault_count(reloaded), 4, "reload should recover all 4 entries")
    assert_str_eq(vault_reveal(reloaded, "db_prod"), "Tr0ub4dor&3-xkcd-2011", "round trip must preserve the exact secret value")
    assert_str_eq(vault_reveal(reloaded, "wifi_home"), "letmein123", "round trip must preserve every entry, not just the first")
    assert_str_eq(vault_reveal(reloaded, "no_such_entry"), "", "revealing a missing name returns empty, not garbage")

    // Cross into the agent's world: metadata only, no `value` field exists
    // on this type.
    let metas = vault_metadata(reloaded)
    assert_eq(len(metas), 4, "metadata projection should mirror vault size")

    let report = agent_audit(metas)
    assert_eq(report.total, 4, "audit should see all 4 entries")
    assert_eq(report.weak_count, 1, "only wifi_home is below the strength threshold")
    assert_eq(report.stale_count, 2, "wifi_home and aws_secret are over 90 days")

    let recs = agent_recommend(report)
    assert_eq(len(recs), 3, "1 weak + 2 stale = 3 recommendation lines")

    println("[vault] loaded " + to_string(vault_count(reloaded)) + " secrets from disk (fs:read, fs:write)")
    println("[agent] audit: " + to_string(report.total) + " total, " + to_string(report.weak_count) + " weak, " + to_string(report.stale_count) + " stale")
    let mut i = 0
    while i < len(recs) {
        println("[agent]   - " + recs[i])
        i = i + 1
    }
    println("[agent] capabilities: none (net, fs:write, process, ffi all absent -- see secret_agent_overreach.kry)")
    println("ALL ASSERTIONS PASSED")
}
