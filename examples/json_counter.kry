// ============================================================
// Kryos Data Processing Demo
//
// Demonstrates: structs, channels, spawn, try/catch,
//               string building, for loops, integer match
// ============================================================
struct DataSet {
    name: str
    count: i64
    total: i64
}

fn aggregate(items: i64, name: str) -> DataSet {
    return DataSet { name: name, count: items, total: items * 10 }
}

fn compute_sum(n: i64) -> i64 {
    let mut sum = 0
    for i in 1..n {
        sum = sum + i
    }
    return sum
}

fn classify(n: i64) -> str {
    match n {
        0 => "zero"
        1 => "one"
        2 => "two"
        _ => "many"
    }
}

fn main() {
    println("=== Kryos Data Processing Demo ===")
    println("")
    // Build datasets
    println("Datasets:")
    let ds1 = aggregate(100, "users")
    println("  " + ds1.name + ": " + to_string(ds1.count) + " items, total=" + to_string(ds1.total))
    let ds2 = aggregate(50, "orders")
    println("  " + ds2.name + ": " + to_string(ds2.count) + " items, total=" + to_string(ds2.total))
    let ds3 = aggregate(200, "events")
    println("  " + ds3.name + ": " + to_string(ds3.count) + " items, total=" + to_string(ds3.total))
    println("")
    // Parallel computation with channels
    println("Parallel processing:")
    let ch1 = chan()
    let ch2 = chan()
    spawn {
        send(ch1, compute_sum(1000))
    }
    spawn {
        send(ch2, compute_sum(500))
    }
    let r1 = recv(ch1)
    println("  Worker 1 (sum 1..1000): " + to_string(r1))
    let r2 = recv(ch2)
    println("  Worker 2 (sum 1..500): " + to_string(r2))
    println("")
    // Integer match
    println("Classification:")
    println("  0 -> " + classify(0))
    println("  1 -> " + classify(1))
    println("  2 -> " + classify(2))
    println("  42 -> " + classify(42))
    println("")
    // Error handling
    println("Error handling:")
    try {
        throw "data validation failed: missing field"
    } catch e {
        println("  Caught: " + e)
    }
    try {
        let raw = "not_a_number"
        if not is_all_digits(raw) {
            throw "cannot parse '" + raw + "' as an integer"
        }
        let bad = parse_int(raw)
        println("  Should not reach: " + to_string(bad))
    } catch e {
        println("  Caught parse error: " + e)
    }
    println("")
    println("=== Data processing complete ===")
}

// Guard input BEFORE parse_int: parse_int panics (not throws) on malformed
// input by design, so validate first when the value is untrusted.
fn is_all_digits(s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    let mut i = 0
    while i < len(s) {
        let c = char_code(substr(s, i, i + 1))
        if c < 48 or c > 57 {
            return false
        }
        i = i + 1
    }
    return true
}
