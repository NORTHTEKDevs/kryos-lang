// https_server.kry -- Minimal TLS HTTPS server (Gap A demo)
//
// Serves "hello" over HTTPS on 127.0.0.1:8443.
// Expects certs/cert.pem and certs/key.pem in the same directory.
// Generate with:
//   openssl req -x509 -newkey rsa:2048 -keyout examples/certs/key.pem \
//     -out examples/certs/cert.pem -days 365 -nodes -subj "/CN=localhost"
//
// Test with:
//   curl -k https://127.0.0.1:8443/

@capabilities(net)
fn main() {
    let cert_path = "examples/certs/cert.pem"
    let key_path = "examples/certs/key.pem"

    let cfg = tls_server_config(cert_path, key_path)
    if cfg < 0 {
        println("[tls_server] ERROR: failed to load cert/key")
        return
    }
    println("[tls_server] loaded TLS config handle: " + to_string(cfg))

    let listener = tcp_listen("127.0.0.1", 8443)
    if listener < 0 {
        println("[tls_server] ERROR: failed to bind 127.0.0.1:8443")
        return
    }
    println("[tls_server] listening on 127.0.0.1:8443")

    let response = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello"

    let mut iters = 0
    while iters < 5 {
        let client_fd = tcp_accept(listener)
        if client_fd < 0 {
            println("[tls_server] accept failed")
            iters = iters + 1
        } else {
            println("[tls_server] accepted TCP client fd=" + to_string(client_fd))
            let tls_fd = tls_accept(client_fd, cfg)
            if tls_fd < 0 {
                println("[tls_server] TLS handshake failed")
            } else {
                println("[tls_server] TLS handshake ok, fd=" + to_string(tls_fd))
                let req = tls_recv(tls_fd, 4096)
                println("[tls_server] received " + to_string(len(req)) + " bytes")
                tls_send(tls_fd, response)
                tls_close(tls_fd)
                println("[tls_server] response sent, connection closed")
            }
            iters = iters + 1
        }
    }

    tcp_close(listener)
    println("[tls_server] done")
}
