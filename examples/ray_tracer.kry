// ============================================================
// Kryos Ray Tracer
//
// Demonstrates: structs, impl methods, nested field access,
//               arithmetic expressions, control flow
// ============================================================

struct Vec3 { x: i64, y: i64, z: i64 }

impl Vec3 {
    fn dot(self, other: Vec3) -> i64 {
        return self.x * other.x + self.y * other.y + self.z * other.z
    }

    fn sub(self, other: Vec3) -> Vec3 {
        return Vec3 {
            x: self.x - other.x,
            y: self.y - other.y,
            z: self.z - other.z,
        }
    }

    fn add(self, other: Vec3) -> Vec3 {
        return Vec3 {
            x: self.x + other.x,
            y: self.y + other.y,
            z: self.z + other.z,
        }
    }

    fn scale(self, t: i64) -> Vec3 {
        return Vec3 {
            x: self.x * t,
            y: self.y * t,
            z: self.z * t,
        }
    }

    fn length_sq(self) -> i64 {
        return self.dot(self)
    }
}

struct Sphere {
    cx: i64,
    cy: i64,
    cz: i64,
    radius: i64,
}

struct Ray {
    ox: i64,
    oy: i64,
    oz: i64,
    dx: i64,
    dy: i64,
    dz: i64,
}

// Ray-sphere intersection using the discriminant.
// Returns 1 if hit, 0 if miss (integer math approximation).
fn hit_sphere(sphere: Sphere, ray: Ray) -> i64 {
    let oc_x = ray.ox - sphere.cx
    let oc_y = ray.oy - sphere.cy
    let oc_z = ray.oz - sphere.cz

    let a = ray.dx * ray.dx + ray.dy * ray.dy + ray.dz * ray.dz
    let b = 2 * (oc_x * ray.dx + oc_y * ray.dy + oc_z * ray.dz)
    let c = oc_x * oc_x + oc_y * oc_y + oc_z * oc_z - sphere.radius * sphere.radius
    let discriminant = b * b - 4 * a * c

    if discriminant >= 0 {
        return 1
    }
    return 0
}

fn render_row(y: i64, sphere: Sphere) {
    let mut row = ""
    for x in 0..40 {
        let ray = Ray {
            ox: 20, oy: 10, oz: 0,
            dx: x - 20,
            dy: y - 10,
            dz: 10,
        }
        if hit_sphere(sphere, ray) == 1 {
            row = row + "#"
        } else {
            row = row + "."
        }
    }
    println(row)
}

fn main() {
    println("=== Kryos Ray Tracer ===")
    println("")
    println("Rendering sphere (radius=8, center=0,0,20):")
    println("")

    let sphere = Sphere { cx: 0, cy: 0, cz: 20, radius: 8 }

    for y in 0..20 {
        render_row(y, sphere)
    }

    println("")
    println("Legend: # = hit, . = miss")

    // Vec3 demo
    let a = Vec3 { x: 1, y: 2, z: 3 }
    let b = Vec3 { x: 4, y: 5, z: 6 }
    let d = a.dot(b)
    println("")
    println("Vec3 dot product: " + to_string(d))
    println("  (1*4 + 2*5 + 3*6 = 32)")

    println("")
    println("=== Ray tracer complete ===")
}
