// ============================================================
// demo_secret.kry -- the happy path.
//
//   kryos run demo_secret.kry
//
// Shows the three things a Secret is for:
//   1. redacted() is the only thing that ever touches a log line.
//   2. expose() runs a compute closure over the raw value (here: a masked
//      rendering and a cheap checksum) without the raw value escaping.
//   3. secret_from_env reads a secret from the environment behind the
//      `process` capability.
//
// This whole program is compute + process only -- it never sends the secret
// anywhere, so it passes `kryos check --strict-capabilities` (see the bottom
// of the file for the exact command).
// ============================================================

use secret

// A cheap additive checksum over the raw bytes -- stands in for "do some
// compute with the secret". Pure compute: it takes the raw str and returns
// an i64, touching no capability-gated builtin.
@capabilities()
fn checksum(raw: str) -> i64 {
    let mut sum = 0
    let mut i = 0
    while i < len(raw) {
        sum = sum + char_code(substr(raw, i, i + 1))
        i = i + 1
    }
    return sum
}

// Mask all but the first byte. Pure compute, str -> str.
@capabilities()
fn mask(raw: str) -> str {
    if len(raw) == 0 {
        return "(empty)"
    }
    return substr(raw, 0, 1) + "******"
}

@capabilities(process)
fn main() {
    // A literal secret (the test-friendly constructor).
    let api_key = secret_of("sk-live-7f3a9c2e", "api_key")

    // Logging a secret means logging its redaction -- never the value.
    println("loaded: " + redacted(api_key))
    println("label:  " + secret_label(api_key))
    println("length: " + to_string(secret_len(api_key)))

    // expose hands the raw value to a compute closure. The masked form and
    // the checksum are derived inside the closure; the raw key never lands
    // in a variable the rest of main can log by accident.
    let shown = expose(api_key, |raw| mask(raw))
    println("masked: " + shown)

    let sum = expose_int(api_key, |raw| checksum(raw))
    println("checksum: " + to_string(sum))

    // A second secret read from the environment (process capability). When
    // the var is unset env_get returns "", so the redaction shows 0 bytes.
    let from_env = secret_from_env("KRYOS_SECRETS_DEMO_TOKEN")
    println("env:    " + redacted(from_env))

    // Value-equality without exposing either side.
    let same = secret_of("sk-live-7f3a9c2e", "copy")
    if secrets_equal(api_key, same) {
        println("equal:  api_key matches copy")
    } else {
        println("equal:  mismatch")
    }
}

// Verify the dataflow guarantee on this file:
//   kryos check --strict-capabilities demo_secret.kry   -> 0 errors
// Nothing here sends the secret to net/io, so strict mode is satisfied by
// the `process` annotation alone.
