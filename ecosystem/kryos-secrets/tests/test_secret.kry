// ============================================================
// test_secret.kry -- runtime unit tests for the Secret handle.
//
//   kryos test --path ecosystem/kryos-secrets
//   kryos run  ecosystem/kryos-secrets/tests/test_secret.kry   (same assertions)
//
// These cover the runtime invariants:
//   1. redacted() NEVER contains the raw value (the core safety property).
//   2. expose / expose_int hand the real raw value to the closure.
//   3. secret_len / secret_label expose metadata, not the value.
//   4. secrets_equal compares values without revealing them.
//   5. secret_from_env reads the environment (process capability).
//
// The COMPILE-TIME guarantee (a compute-only function cannot reach a net
// sink) is a property of `kryos check --strict-capabilities`, exercised by
// tests/fixtures/leak_compute.kry. See the README "Compile-fail fixture"
// section for the exact command and expected E0505 output -- a type checker
// rejection can't be asserted from inside a running test, so it is verified
// at the CLI and the output is pasted in the PR evidence.
//
// As in the other ecosystem houses, a main() at the bottom drives the same
// @test bodies so `kryos run` on this file is independent proof.
// ============================================================

use secret

// The most important test: the safe rendering must not leak the secret.
@test
fn test_redacted_never_contains_value() {
    let s = secret_of("sk-live-7f3a9c2e", "api_key")
    let r = redacted(s)
    assert(!contains(r, "sk-live-7f3a9c2e"), "redacted output must not contain the raw value")
    assert(contains(r, "api_key"), "redacted output should carry the label")
    assert(contains(r, "16 bytes"), "redacted output should carry the byte length")
}

// An empty secret still redacts safely and reports zero bytes.
@test
fn test_redacted_empty_secret() {
    let s = secret_of("", "empty")
    let r = redacted(s)
    assert(contains(r, "0 bytes"), "empty secret should report 0 bytes")
    assert(contains(r, "empty"), "empty secret should carry its label")
}

// expose hands the real value to the closure (str result path).
@test
fn test_expose_sees_raw_value() {
    let s = secret_of("hunter2", "pw")
    // Echo the raw value back through expose; it must equal the original.
    let echoed = expose(s, |raw| raw)
    assert(echoed == "hunter2", "expose must hand the closure the raw value")
    // A masked rendering keeps only the first byte.
    let masked = expose(s, |raw| substr(raw, 0, 1))
    assert(masked == "h", "masked rendering should be the first byte")
}

// expose_int reduces the raw value to an i64.
@test
fn test_expose_int_reduces_value() {
    let s = secret_of("hunter2", "pw")
    let n = expose_int(s, |raw| len(raw))
    assert(n == 7, "expose_int over len should be the byte length")
}

// Metadata accessors reveal label and length but not the value.
@test
fn test_metadata_accessors() {
    let s = secret_of("topsecret", "session")
    assert(secret_label(s) == "session", "secret_label should return the label")
    assert(secret_len(s) == 9, "secret_len should return the byte length")
}

// Value equality holds for equal values and fails for different ones,
// without either value being returned to the caller.
@test
fn test_secrets_equal() {
    let a = secret_of("match", "a")
    let b = secret_of("match", "b")
    let c = secret_of("other", "c")
    assert(secrets_equal(a, b), "equal values should compare equal")
    assert(!secrets_equal(a, c), "different values should not compare equal")
}

// secret_from_env reads the environment. We set nothing portable, so we
// assert the label is the requested key and the redaction is well-formed.
// (env_get returns "" for an unset var, so this is deterministic offline.)
@test
fn test_secret_from_env_unset_is_empty() {
    let s = secret_from_env("KRYOS_SECRETS_TEST_UNSET_VAR")
    assert(secret_label(s) == "KRYOS_SECRETS_TEST_UNSET_VAR", "env secret label should be the key")
    assert(secret_len(s) == 0, "an unset env var should yield a 0-byte secret")
}

@capabilities(process)
fn main() {
    test_redacted_never_contains_value()
    println("PASS test_redacted_never_contains_value")
    test_redacted_empty_secret()
    println("PASS test_redacted_empty_secret")
    test_expose_sees_raw_value()
    println("PASS test_expose_sees_raw_value")
    test_expose_int_reduces_value()
    println("PASS test_expose_int_reduces_value")
    test_metadata_accessors()
    println("PASS test_metadata_accessors")
    test_secrets_equal()
    println("PASS test_secrets_equal")
    test_secret_from_env_unset_is_empty()
    println("PASS test_secret_from_env_unset_is_empty")
    println("7/7 secret tests passed")
}
