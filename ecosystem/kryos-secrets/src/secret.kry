// ============================================================
// secret.kry -- an opaque Secret handle for str values.
//
// A `Secret` wraps a sensitive str (an API key, a DB password, a token).
// The point of the type is NOT encryption -- the raw bytes still sit in
// memory under the ARC model. The point is a capability-gated dataflow:
//
//   * The raw value only leaves a Secret through `expose`/`expose_int`,
//     which hand it to a closure. That closure inherits the capability
//     scope of whatever function called expose.
//   * `redacted` is the safe rendering for logs -- it NEVER returns the
//     raw bytes, only the label and the byte length.
//
// Combined with `kryos check --strict-capabilities`, this turns
// "a secret reached a net/io sink from a function that never declared
// net/io" into a compile-time error (E0505 on the gated builtin, E0507
// when the gated call is hidden behind another function). A compute-only
// function literally cannot pass an exposed secret to `http2_post` /
// `file_write` without the compiler rejecting it under strict mode.
//
// Why a plain struct and not Secret<T>: generic-struct method ergonomics
// are limited today (CLAUDE.md gotcha #17 -- a method returning a bare
// type parameter reads the raw i64 slot), so the MVP specializes to a
// str payload, which is the dominant secret shape. The spec calls this
// out as the expected specialization.
//
// Capability notes:
//   * secret_of / redacted / expose / expose_int are pure compute.
//     They carry @capabilities() (empty) so they stay callable from any
//     scope and never silently smuggle in a capability.
//   * secret_from_env reads env_get, which is gated on `process`, so it
//     carries @capabilities(process). Constructing a secret from the
//     environment is therefore itself a capability-bearing act.
// ============================================================

struct Secret {
    // The raw sensitive bytes. Read it only through expose/expose_int.
    value: str,
    // A non-sensitive label used in redacted output (e.g. "db_password").
    label: str,
}

// Build a Secret from a literal value. Intended for tests and for values
// that are already in hand. Pure compute -- no capability required.
@capabilities()
fn secret_of(value: str, label: str) -> Secret {
    return Secret { value: value, label: label }
}

// Build a Secret by reading environment variable `key`. The label defaults
// to `key`. env_get is gated on the `process` capability, so this function
// declares it -- pulling a secret out of the environment is a privileged act,
// and under --strict-capabilities a caller must itself hold `process`.
@capabilities(process)
fn secret_from_env(key: str) -> Secret {
    let value = env_get(key)
    return Secret { value: value, label: key }
}

// The ONLY safe-to-log rendering of a secret. Returns the label and the byte
// length of the value, never the value itself. Pure compute.
@capabilities()
fn redacted(s: Secret) -> str {
    return "Secret(" + s.label + ", " + to_string(len(s.value)) + " bytes)"
}

// The label of a secret (non-sensitive). Pure compute.
@capabilities()
fn secret_label(s: Secret) -> str {
    return s.label
}

// The byte length of the raw value, without revealing it. Pure compute.
@capabilities()
fn secret_len(s: Secret) -> i64 {
    return len(s.value)
}

// Run `f` with the raw value and return its str result. This is the single
// str-shaped escape hatch. `f` runs in the CALLER's capability scope: if the
// caller is compute-only, `f` cannot itself call a net/io builtin under strict
// mode, which is the whole guarantee. Pure compute itself -- it only forwards.
@capabilities()
fn expose(s: Secret, f: fn(str) -> str) -> str {
    return f(s.value)
}

// Like expose, but for a closure that reduces the raw value to an i64
// (length, checksum, parse). Same capability-scoping guarantee.
@capabilities()
fn expose_int(s: Secret, f: fn(str) -> i64) -> i64 {
    return f(s.value)
}

// Compare two secrets for value equality without exposing either value to the
// caller. Useful for "does the supplied token match the stored token?" checks.
// Pure compute.
@capabilities()
fn secrets_equal(a: Secret, b: Secret) -> bool {
    return a.value == b.value
}
