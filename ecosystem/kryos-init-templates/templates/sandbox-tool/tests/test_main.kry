// ============================================================
// test_main.kry -- sandbox-tool template tests.
//
//   kryos test --path <dest>/sandbox-tool
//   kryos run  tests/test_main.kry
//
// All functions are redefined here (pure compute) so this file
// runs without importing src/main.kry (avoiding fn main() conflict).
// ============================================================

@capabilities()
fn is_prime(n: i64) -> bool {
    if n < 2 { return false }
    let mut i = 2
    while i * i <= n {
        if n % i == 0 { return false }
        i = i + 1
    }
    return true
}

@capabilities()
fn primes_up_to(limit: i64) -> [i64] {
    let mut result: [i64] = []
    let mut n = 2
    while n <= limit {
        if is_prime(n) { result = push(result, n) }
        n = n + 1
    }
    return result
}

@capabilities()
fn join_ints(nums: [i64], sep: str) -> str {
    let mut out: str = ""
    let mut i = 0
    while i < len(nums) {
        if i > 0 { out = out + sep }
        out = out + to_string(nums[i])
        i = i + 1
    }
    return out
}

// ---------------------------------------------------------------------------

@test
fn test_is_prime_small() {
    assert(!is_prime(0), "0 is not prime")
    assert(!is_prime(1), "1 is not prime")
    assert(is_prime(2),  "2 is prime")
    assert(is_prime(3),  "3 is prime")
    assert(!is_prime(4), "4 is not prime")
    assert(is_prime(5),  "5 is prime")
    assert(!is_prime(6), "6 is not prime")
    assert(is_prime(7),  "7 is prime")
}

@test
fn test_is_prime_larger() {
    assert(!is_prime(9),  "9 is not prime (3*3)")
    assert(is_prime(11),  "11 is prime")
    assert(!is_prime(49), "49 is not prime (7*7)")
    assert(is_prime(97),  "97 is prime")
}

@test
fn test_primes_up_to_50() {
    // There are exactly 15 primes up to 50.
    let p = primes_up_to(50)
    assert(len(p) == 15,
        "there are 15 primes up to 50, got " + to_string(len(p)))
    assert(p[0] == 2,  "first prime is 2")
    assert(p[1] == 3,  "second prime is 3")
    assert(p[len(p) - 1] == 47, "last prime up to 50 is 47")
}

@test
fn test_primes_empty_range() {
    assert(len(primes_up_to(1)) == 0, "no primes up to 1")
    assert(len(primes_up_to(0)) == 0, "no primes up to 0")
}

@test
fn test_join_ints() {
    let nums: [i64] = [2, 3, 5, 7]
    assert(join_ints(nums, ", ") == "2, 3, 5, 7", "comma-join")
    let empty: [i64] = []
    assert(join_ints(empty, ",") == "", "empty join")
    let single: [i64] = [42]
    assert(join_ints(single, "-") == "42", "single element join")
}

@capabilities()
fn main() {
    test_is_prime_small()
    println("PASS test_is_prime_small")
    test_is_prime_larger()
    println("PASS test_is_prime_larger")
    test_primes_up_to_50()
    println("PASS test_primes_up_to_50")
    test_primes_empty_range()
    println("PASS test_primes_empty_range")
    test_join_ints()
    println("PASS test_join_ints")
    println("5/5 sandbox-tool tests passed")
}
