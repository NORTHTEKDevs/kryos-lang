// tests/test_governed_rag.kry -- Pure-logic tests for the governed RAG port.
//
// No live LLM needed. Exercises:
//   1. retrieve() returns only matching chunks as Tracked<str> with citations.
//   2. Each returned chunk carries a tracked source (citation recorded).
//   3. tracked_merge + tracked_to_citation produce the correct citation list.
//   4. Calculator tool dispatch works for all four ops.
//   5. Governed dispatch loop handles tool call + Done in sequence.
//
// PROVING COMMAND:  kryos run tests/test_governed_rag.kry
//
// DO NOT use `kryos test` -- it vacuously passes when there are no @test
// functions, and @test panics on kryos_string_retain when touching std::tracked.
// Use `kryos run` which executes main() and exits 1 on any assertion failure.

use std::tracked::{Tracked, LineageEntry, tracked_source, inference}

// ---------------------------------------------------------------------------
// Inlined from kryos-rag/src/lineage_utils.kry (no cross-project import).
// ---------------------------------------------------------------------------

fn tracked_merge(sources: [Tracked<str>], new_value: str, operation: str, description: str) -> Tracked<str> {
    let mut combined_lineage: [LineageEntry] = []
    let mut i = 0
    while i < len(sources) {
        let s = sources[i]
        let mut j = 0
        while j < len(s.lineage) {
            combined_lineage = push(combined_lineage, s.lineage[j])
            j = j + 1
        }
        i = i + 1
    }
    let merge_entry = LineageEntry {
        operation: operation,
        description: description,
        timestamp: time_now(),
        metadata: "merged=" + to_string(len(sources)) + " sources"
    }
    combined_lineage = push(combined_lineage, merge_entry)
    let first_source = sources[0]
    return Tracked {
        value: new_value,
        lineage: combined_lineage,
        source: first_source.source,
        source_description: description
    }
}

fn tracked_to_citation(t: Tracked<str>) -> [str] {
    let mut seen: [str] = []
    let mut result: [str] = []
    let mut i = 0
    while i < len(t.lineage) {
        let entry = t.lineage[i]
        if entry.operation == "source" {
            let src = entry.metadata
            let mut found = false
            let mut j = 0
            while j < len(seen) {
                if seen[j] == src {
                    found = true
                }
                j = j + 1
            }
            if not found {
                seen = push(seen, src)
                result = push(result, src)
            }
        }
        i = i + 1
    }
    return result
}

// ---------------------------------------------------------------------------
// Mirror the types and fns from src/main.kry inline.
// (kryos run resolves imports relative to the file; for standalone test files
//  we inline the minimal surface rather than depending on src/ path resolution.)
// ---------------------------------------------------------------------------

struct RagChunk {
    id: str,
    text: str
}

struct ToolCall {
    tool_name: str,
    argument: str
}

enum ModelDecision {
    UseTool(ToolCall),
    Done(str)
}

struct SplitResult {
    found: bool,
    left: i64,
    right: i64
}

fn split_on_op(input: str, op: str) -> SplitResult {
    let op_len = len(op)
    let in_len = len(input)
    let mut pos = -1
    let mut i = 0
    while i <= in_len - op_len {
        let candidate = substr(input, i, i + op_len)
        if candidate == op {
            pos = i
            i = in_len
        }
        i = i + 1
    }
    if pos < 0 {
        return SplitResult { found: false, left: 0, right: 0 }
    }
    let left_str = substr(input, 0, pos)
    let right_str = substr(input, pos + op_len, in_len)
    let left_val = parse_int(left_str)
    let right_val = parse_int(right_str)
    return SplitResult { found: true, left: left_val, right: right_val }
}

fn tool_calculator(arg: str) -> str {
    if contains(arg, " add ") {
        let parts = split_on_op(arg, " add ")
        if parts.found {
            return to_string(parts.left + parts.right)
        }
    }
    if contains(arg, " sub ") {
        let parts = split_on_op(arg, " sub ")
        if parts.found {
            return to_string(parts.left - parts.right)
        }
    }
    if contains(arg, " mul ") {
        let parts = split_on_op(arg, " mul ")
        if parts.found {
            return to_string(parts.left * parts.right)
        }
    }
    if contains(arg, " div ") {
        let parts = split_on_op(arg, " div ")
        if parts.found {
            if parts.right == 0 {
                return "error: division by zero"
            }
            return to_string(parts.left / parts.right)
        }
    }
    return "error: unknown expression: " + arg
}

fn retrieve(query: str, chunks: [RagChunk]) -> [Tracked<str>] {
    let mut results: [Tracked<str>] = []
    let mut i = 0
    while i < len(chunks) {
        let c = chunks[i]
        if contains(c.text, query) {
            let t = tracked_source(c.text, c.id, "retrieved chunk for query: " + query)
            results = push(results, t)
        }
        i = i + 1
    }
    return results
}

fn dispatch_tool(tool_name: str, argument: str) -> str {
    if tool_name == "calculator" {
        return tool_calculator(argument)
    }
    return "error: unknown tool " + tool_name
}

fn stub_model_decision(step: i64, query: str, context: str) -> ModelDecision {
    if step == 0 {
        if contains(query, "%") or contains(query, "percent") {
            // First step: multiply to get raw value (23% of 4400 = 4400*23=101200)
            return UseTool(ToolCall {
                tool_name: "calculator",
                argument: "4400 mul 23"
            })
        }
        if len(context) > 0 {
            return Done("Based on the retrieved knowledge: " + context)
        }
        return Done("No relevant context found.")
    }
    if step == 1 {
        if contains(query, "%") or contains(query, "percent") {
            // Second step: divide by 100 to get percentage
            return UseTool(ToolCall {
                tool_name: "calculator",
                argument: "101200 div 100"
            })
        }
    }
    return Done("Based on the retrieved knowledge and calculations: " + context)
}

// ---------------------------------------------------------------------------
// Test helpers
// ---------------------------------------------------------------------------

fn expect_eq(actual: i64, expected: i64, name: str) {
    if actual != expected {
        println("FAIL: " + name + " expected " + to_string(expected) + " got " + to_string(actual))
        exit(1)
    }
}

fn expect_str_eq(actual: str, expected: str, name: str) {
    if actual != expected {
        println("FAIL: " + name + " expected '" + expected + "' got '" + actual + "'")
        exit(1)
    }
}

fn expect_true(val: bool, name: str) {
    if not val {
        println("FAIL: " + name + " expected true")
        exit(1)
    }
}

// ---------------------------------------------------------------------------
// Test 1: retriever returns exactly the 2 matching chunks
// ---------------------------------------------------------------------------
fn test_retriever_returns_matching_chunks() {
    let corpus: [RagChunk] = [
        RagChunk { id: "doc:001", text: "Kryos is a capability-safe language." },
        RagChunk { id: "doc:002", text: "Kryos uses @budget to cap token spend." },
        RagChunk { id: "doc:003", text: "Rust is a memory-safe language." }
    ]
    let results = retrieve("Kryos", corpus)
    expect_eq(len(results), 2, "retriever: should return 2 matching chunks")
    let r0 = results[0]
    let r1 = results[1]
    let s0: str = r0.source
    let s1: str = r1.source
    expect_str_eq(s0, "doc:001", "retriever: results[0].source")
    expect_str_eq(s1, "doc:002", "retriever: results[1].source")
    println("test_retriever_returns_matching_chunks: PASS")
}

// ---------------------------------------------------------------------------
// Test 2: each retrieved chunk carries a Tracked citation (source recorded)
// ---------------------------------------------------------------------------
fn test_retrieved_chunks_carry_citation() {
    let corpus: [RagChunk] = [
        RagChunk { id: "doc:001", text: "Kryos is a capability-safe language." },
        RagChunk { id: "doc:002", text: "Kryos uses @budget to cap token spend." },
        RagChunk { id: "doc:003", text: "Rust is a memory-safe language." }
    ]
    let results = retrieve("Kryos", corpus)
    expect_eq(len(results), 2, "citation test: chunk count")

    // Each Tracked<str> must have source set to the chunk id.
    let r0 = results[0]
    let r1 = results[1]
    let src0: str = r0.source
    let src1: str = r1.source
    // source is set by tracked_source(text, id, desc) -> source = id
    expect_str_eq(src0, "doc:001", "chunk[0] source ID")
    expect_str_eq(src1, "doc:002", "chunk[1] source ID")

    // lineage must be non-empty (tracked_source creates at least 1 entry)
    expect_true(len(r0.lineage) > 0, "chunk[0] lineage non-empty")
    expect_true(len(r1.lineage) > 0, "chunk[1] lineage non-empty")

    println("test_retrieved_chunks_carry_citation: PASS")
}

// ---------------------------------------------------------------------------
// Test 3: tracked_merge + tracked_to_citation produce the correct citation list
// ---------------------------------------------------------------------------
fn test_tracked_citations_chain() {
    let corpus: [RagChunk] = [
        RagChunk { id: "doc:001", text: "Kryos is a capability-safe language." },
        RagChunk { id: "doc:002", text: "Kryos uses @budget to cap token spend." },
        RagChunk { id: "doc:003", text: "Python has no compile-time capability checks." }
    ]
    // Retrieve 2 matching chunks for "Kryos"
    let retrieved = retrieve("Kryos", corpus)
    expect_eq(len(retrieved), 2, "citation chain: retrieved count")

    // Merge into a single Tracked<str> (simulates building an answer)
    let merged = tracked_merge(retrieved, "merged answer text", "inference", "stub answer")

    // tracked_to_citation returns "source=<id>" strings (see lineage_utils.kry)
    let citations = tracked_to_citation(merged)
    expect_eq(len(citations), 2, "citation chain: citation count")
    expect_str_eq(citations[0], "source=doc:001", "citation[0]")
    expect_str_eq(citations[1], "source=doc:002", "citation[1]")
    println("test_tracked_citations_chain: PASS")
}

// ---------------------------------------------------------------------------
// Test 4: calculator tool handles all four operations correctly
// ---------------------------------------------------------------------------
fn test_calculator_tool() {
    expect_str_eq(tool_calculator("10 add 5"),  "15",  "calc: add")
    expect_str_eq(tool_calculator("10 sub 3"),  "7",   "calc: sub")
    expect_str_eq(tool_calculator("4400 mul 23"), "101200", "calc: mul")
    expect_str_eq(tool_calculator("101200 div 100"), "1012", "calc: div")
    expect_str_eq(tool_calculator("5 div 0"), "error: division by zero", "calc: div zero")
    println("test_calculator_tool: PASS")
}

// ---------------------------------------------------------------------------
// Test 5: stub dispatch loop -- tool call on step 0, Done on step 1
// ---------------------------------------------------------------------------
fn test_stub_dispatch_loop() {
    // Step 0: query with "%" should trigger a tool call.
    let query = "What is 23% of 4400?"
    let context = "some context"
    let d0 = stub_model_decision(0, query, context)
    let mut got_tool = false
    let mut tool_arg = ""
    match d0 {
        UseTool(call) => {
            got_tool = true
            tool_arg = call.argument
        },
        Done(_) => {
            println("FAIL: test_stub_dispatch_loop step 0 should be UseTool not Done")
            exit(1)
        }
    }
    expect_true(got_tool, "step 0: should be UseTool")
    expect_str_eq(tool_arg, "4400 mul 23", "step 0: tool argument (first op)")

    // Execute step 0 tool call.
    let tool_result = dispatch_tool("calculator", tool_arg)
    expect_str_eq(tool_result, "101200", "step 0: calculator result (4400*23)")

    // Step 1: model calls second tool (div by 100 to get percentage).
    let updated_context = context + "\ncalculator(4400 mul 23) = " + tool_result
    let d1 = stub_model_decision(1, query, updated_context)
    let mut got_tool2 = false
    let mut tool2_arg = ""
    match d1 {
        UseTool(call) => {
            got_tool2 = true
            tool2_arg = call.argument
        },
        Done(_) => {
            println("FAIL: test_stub_dispatch_loop step 1 should be UseTool not Done")
            exit(1)
        }
    }
    expect_true(got_tool2, "step 1: should be UseTool")
    let tool2_result = dispatch_tool("calculator", tool2_arg)
    expect_str_eq(tool2_result, "1012", "step 1: calculator result (101200/100=1012)")

    // Step 2: model has all results, returns Done.
    let updated_context2 = updated_context + "\ncalculator(101200 div 100) = " + tool2_result
    let d2 = stub_model_decision(2, query, updated_context2)
    let mut got_done = false
    match d2 {
        Done(_) => {
            got_done = true
        },
        UseTool(_) => {
            println("FAIL: test_stub_dispatch_loop step 2 should be Done not UseTool")
            exit(1)
        }
    }
    expect_true(got_done, "step 2: should be Done")
    println("test_stub_dispatch_loop: PASS")
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------
fn main() {
    test_retriever_returns_matching_chunks()
    test_retrieved_chunks_carry_citation()
    test_tracked_citations_chain()
    test_calculator_tool()
    test_stub_dispatch_loop()
    println("All 5 tests passed.")
}
