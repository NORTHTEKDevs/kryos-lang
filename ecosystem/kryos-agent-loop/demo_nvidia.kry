// demo_nvidia.kry -- chat_tools_governed against NVIDIA's OpenAI-compatible API.
//
// NVIDIA's endpoint (https://integrate.api.nvidia.com/v1) is OpenAI-wire
// compatible (vLLM backend), so the library's openai path works unchanged.
//
// Build + run (LLVM AOT; the Cranelift JIT is currently regressed on
// to_string(f64) in the toolchain, so prefer --release here):
//   kryos build --release demo_nvidia.kry -o demo_nvidia.exe
//   NVIDIA_API_KEY=nvapi-... ./demo_nvidia.exe

use std::cost
use std::agent
use std::llm
use src::lib::{GovernedResult, chat_tools_governed, agent_checkpoint}

fn calc(args_json: str) -> str {
    let node = json_parse(args_json)
    // vLLM often serializes tool-call args as JSON strings ("4400") rather than
    // numbers, so read each value as text and parse_float defensively.
    let a = parse_float(json_to_str(json_get(node, "a")))
    let b = parse_float(json_to_str(json_get(node, "b")))
    let op = json_to_str(json_get(node, "op"))
    if op == "add" { return to_string(a + b) }
    if op == "sub" { return to_string(a - b) }
    if op == "mul" { return to_string(a * b) }
    if op == "div" {
        if b == 0.0 { return "error: division by zero" }
        return to_string(a / b)
    }
    return "error: unknown op " + op
}

fn dispatch(name: str, args_json: str) -> str {
    if name == "calc" { return calc(args_json) }
    return "error: unknown tool " + name
}

fn calc_schema() -> str {
    return json_stringify(json_object(
        ["type", "properties", "required"],
        [json_string("object"),
         json_object(["a", "b", "op"], [
             json_object(["type"], [json_string("number")]),
             json_object(["type"], [json_string("number")]),
             json_object(["type", "description"], [json_string("string"), json_string("add, sub, mul, or div")])
         ]),
         json_array([json_string("a"), json_string("b"), json_string("op")])]))
}

@capabilities(net, io, process)
@budget(tokens = 40000, calls = 10)
fn main() {
    let api_key = env_get("NVIDIA_API_KEY")
    let mut url_base = env_get("NVIDIA_BASE_URL")
    if len(url_base) == 0 {
        url_base = "https://integrate.api.nvidia.com/v1"
    }
    let base = openai_config(api_key, "meta/llama-3.3-70b-instruct")
    let cfg = with_temperature(with_max_tokens(with_base_url(base, url_base), 1024), 0.1)

    let tools = [tool("calc", "Exact arithmetic: add/sub/mul/div two numbers. Use for ALL math.", calc_schema())]
    let msgs = [system("You are a precise analyst. Use calc for all math. To compute P percent of N, call calc with a=N, b=P/100 (so 23% means b=0.23), op=mul."),
                user("What is 23% of 4400?")]

    let ag = agent_with_alignment("analyst", "answer numeric questions", ALIGNMENT_STANDARD)

    let result = chat_tools_governed(cfg, msgs, tools, dispatch, ag, 8)

    println("Answer: " + result.final_turn.text)
    println("Steps:  " + to_string(result.steps))
    println("Tokens: " + to_string(result.total_cost.tokens_used))
    println("API calls: " + to_string(result.total_cost.api_calls))
    println("Audit entries: " + to_string(len(result.agent.audit_trail)))
    println("")
    println("=== Audit Trail ===")
    for entry in result.agent.audit_trail {
        println(to_string(entry.id) + "\t"
              + entry.entry_type + "\t"
              + entry.description + "\t"
              + to_string(entry.success))
    }
    agent_checkpoint(result.agent, "/tmp/audit_nvidia.tsv")
    println("")
    println("Audit trail written to /tmp/audit_nvidia.tsv")
}
