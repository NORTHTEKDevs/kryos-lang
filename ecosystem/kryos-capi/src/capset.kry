// ============================================================
// capset.kry -- runtime capability-set primitives.
//
// Kryos capabilities are a COMPILE-TIME concept (the @capabilities(...)
// annotation, verified by the compiler). To make a per-host BIND decision at
// RUNTIME -- "may this host, holding allow-set A, bind an export that declares
// capability set D?" -- the consumer re-encodes the taxonomy as plain data: a
// capability is a lowercase name (str), a set is a [str].
//
// The subset / excess logic mirrors CapabilitySet::is_subset_of / excess_over
// in compiler/crates/kryos-capabilities/src/model.rs. "all" is a wildcard grant
// that subsumes every concrete capability. Everything here is pure: @capabilities().
//
// This module is intentionally std-free (split/trim are hand-rolled on the
// substr builtin). Kryos has a single flat function namespace across all loaded
// modules, so a module that pulled in std::string would clash with another
// module that pulled in std::json (both define a private `_is_whitespace`).
// Keeping capset dependency-free lets the consumer import both it and the
// std::json-backed manifest reader without a duplicate-symbol error.
// ============================================================

// Split `s` on a single-byte delimiter. Byte-indexed via substr.
@capabilities()
fn _split1(s: str, delim: str) -> [str] {
    let mut out: [str] = []
    let n: i64 = len(s)
    let mut start: i64 = 0
    let mut i: i64 = 0
    while i < n {
        if substr(s, i, i + 1) == delim {
            out = push(out, substr(s, start, i))
            start = i + 1
        }
        i = i + 1
    }
    out = push(out, substr(s, start, n))
    return out
}

// Trim ASCII spaces from both ends of `s`.
@capabilities()
fn _trim_spaces(s: str) -> str {
    let n: i64 = len(s)
    let mut a: i64 = 0
    while a < n {
        if substr(s, a, a + 1) == " " {
            a = a + 1
        } else {
            break
        }
    }
    let mut b: i64 = n
    while b > a {
        if substr(s, b - 1, b) == " " {
            b = b - 1
        } else {
            break
        }
    }
    return substr(s, a, b)
}

// Does `grant` confer `cap`? A literal "all" entry is a wildcard.
@capabilities()
fn caps_allows(grant: [str], cap: str) -> bool {
    for g in grant {
        if g == cap || g == "all" {
            return true
        }
    }
    return false
}

// The capabilities in `declared` that `grant` does NOT confer. Empty result
// means `declared` is a subset of `grant` (safe to bind).
@capabilities()
fn caps_excess(declared: [str], grant: [str]) -> [str] {
    let mut excess: [str] = []
    for cap in declared {
        if !caps_allows(grant, cap) {
            excess = push(excess, cap)
        }
    }
    return excess
}

// True iff `declared` is a subset of `grant` (no excess capabilities).
@capabilities()
fn is_subset_of(declared: [str], grant: [str]) -> bool {
    return len(caps_excess(declared, grant)) == 0
}

// Render a [str] capability set as "{a, b, c}". `{{` / `}}` escape to a single
// brace (a bare `{` opens string interpolation in Kryos).
@capabilities()
fn caps_render(caps: [str]) -> str {
    let mut out: str = "{{"
    let mut i: i64 = 0
    while i < len(caps) {
        if i > 0 {
            out = out + ", "
        }
        out = out + caps[i]
        i = i + 1
    }
    return out + "}}"
}

// Parse a comma-separated allow-set ("compute, io") into a [str], trimming
// spaces and dropping empty entries. An empty string yields [] (deny-all).
@capabilities()
fn parse_set(s: str) -> [str] {
    let mut out: [str] = []
    if len(s) == 0 {
        return out
    }
    for part in _split1(s, ",") {
        let t: str = _trim_spaces(part)
        if len(t) > 0 {
            out = push(out, t)
        }
    }
    return out
}
