// ============================================================
// budget_frame.kry -- the runtime @budget frame, parameterized at run time.
//
// The `@budget(tokens = N, calls = M)` function attribute lowers to a pair of
// runtime calls injected by the MIR lowering pass
// (compiler/crates/kryos-mir/src/lower.rs::inject_budget_frames):
//
//     entry:   depth = kryos_budget_push(N, M)
//     returns: kryos_budget_pop_to(depth)
//
// N and M must be COMPILE-TIME LITERALS in the attribute. A replay ceiling,
// however, has to be DERIVED from the transcript that is loaded at run time.
// So we push the frame ourselves with the same primitive the attribute uses --
// identical thread-local frame, identical enforcement -- just parameterized by
// the transcript's own totals. std::llm's chat() and our mock replay loop both
// charge the active frame around each model call; the (calls+1)th is refused
// BEFORE it runs, which is what halts a divergent replay.
//
// Frame semantics (compiler/crates/kryos-rt/src/budget.rs):
//   - push(tokens, calls) -> depth   (negative limit == unlimited on that axis)
//   - pop_to(depth)                  (idempotent; self-heals after an unwind)
//   - try_call() -> 1 when any active frame is out of calls (refuse), else 0
//                   and decrements every active frame
//   - charge_tokens(t) -> 1 when any active frame went negative, else 0
//   - remaining_tokens()/remaining_calls() -> tightest active frame
// ============================================================

extern {
    fn kryos_budget_push(tokens: i64, calls: i64) -> i64
    fn kryos_budget_pop_to(depth: i64) -> i64
    fn kryos_budget_active() -> i64
    fn kryos_budget_try_call() -> i64
    fn kryos_budget_charge_tokens(tokens: i64) -> i64
    fn kryos_budget_remaining_tokens() -> i64
    fn kryos_budget_remaining_calls() -> i64
}

// Push a budget frame derived from runtime values. Returns the depth to pop to.
@capabilities(ffi)
fn bf_push(tokens: i64, calls: i64) -> i64 {
    return kryos_budget_push(tokens, calls)
}

// Truncate the frame stack back to `depth` (idempotent).
@capabilities(ffi)
fn bf_pop(depth: i64) {
    let r = kryos_budget_pop_to(depth)
}

// 1 when at least one budget frame is active on this thread.
@capabilities(ffi)
fn bf_active() -> i64 {
    return kryos_budget_active()
}

// Reserve one model call. Returns 1 (refuse) when out of calls, else 0 and
// decrements every active frame. Call this BEFORE issuing the model call.
@capabilities(ffi)
fn bf_try_call() -> i64 {
    return kryos_budget_try_call()
}

// Charge actual token usage against every active frame. Returns 1 when any
// frame went negative (over budget), else 0. Call this AFTER the response.
@capabilities(ffi)
fn bf_charge(tokens: i64) -> i64 {
    return kryos_budget_charge_tokens(tokens)
}

@capabilities(ffi)
fn bf_remaining_tokens() -> i64 {
    return kryos_budget_remaining_tokens()
}

@capabilities(ffi)
fn bf_remaining_calls() -> i64 {
    return kryos_budget_remaining_calls()
}
