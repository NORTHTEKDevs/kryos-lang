// ============================================================
// test_supervisor.kry -- the spec's restart semantics, deterministically.
//
//   kryos test --path ecosystem/kryos-pipeline-supervisor
//
// These gates are spawn-free (the @test JIT harness miscompiles `spawn {}`),
// so they exercise the supervisor core over a `fn(attempt) -> i64` unit whose
// abnormal exit is the in-band FAIL sentinel. The real spawned-actor restart is
// proven separately by e2e_spawn.kry under `kryos run`.
//
// Every gate ASSERTS, so a regression fails the run -- unlike a `main()` file
// test, which `kryos test` only compiles. `supervise` RETURNS in every gate;
// a spinning supervisor would hang the run, so termination is itself asserted.
// ============================================================

use restart
use supervisor
use kryos_cost_ledger::ledger
use std::cost::{ComputeCost}

// --- supervised units (abnormal exit == FAIL sentinel) ----------------------

// Fails on attempts 1..k, then exits normally returning attempt*10.
fn fail_until(attempt: i64, k: i64) -> i64 {
    if attempt <= k {
        return fail_sentinel()
    }
    return attempt * 10
}

fn transient_2(attempt: i64) -> i64 { return fail_until(attempt, 2) }
fn transient_3(attempt: i64) -> i64 { return fail_until(attempt, 3) }
fn transient_4(attempt: i64) -> i64 { return fail_until(attempt, 4) }
fn permanent(attempt: i64) -> i64 { return fail_sentinel() }
fn always_ok(attempt: i64) -> i64 { return 7 }

// --- gate 1: a stage failing twice under a 3-restart budget recovers --------
@test
fn test_transient_recovers() {
    let r = supervise("transient", transient_2, 3)
    assert(r.succeeded, "transient stage must recover")
    assert(r.gave_up == false, "recovered stage did not give up")
    assert(r.restarts == 2, "must restart exactly twice, got " + to_string(r.restarts))
    assert(r.attempts == 3, "3 total attempts (1 initial + 2 restarts), got " + to_string(r.attempts))
    assert(r.result == 30, "final result is attempt3*10=30, got " + to_string(r.result))
    assert(len(r.ledger) == 2, "ledger records 2 restarts, got " + to_string(len(r.ledger)))
    assert(ledger_verify(r.ledger) == -1, "restart ledger must verify clean")
}

// --- gate 2: a permanently-failing stage trips the restart budget -----------
@test
fn test_permanent_trips_budget() {
    let r = supervise("permanent", permanent, 3)
    assert(r.succeeded == false, "permanent stage cannot recover")
    assert(r.gave_up, "supervisor must give up")
    assert(r.restarts == 3, "exactly 3 restarts (the budget), no overrun, got " + to_string(r.restarts))
    assert(r.attempts == 4, "4 attempts (1 initial + 3 restarts), got " + to_string(r.attempts))
    assert(is_fail(r.result), "final result is the FAIL sentinel")
    assert(len(r.ledger) == 3, "ledger records exactly 3 restarts, got " + to_string(len(r.ledger)))
    assert(ledger_verify(r.ledger) == -1, "restart ledger must verify clean")
    assert(contains(r.message, "GAVE UP"), "message reports give-up: " + r.message)
    assert(contains(r.message, "exhausted"), "message reports exhaustion: " + r.message)
}

// --- gate 3: the ceiling is EXACT at both edges -----------------------------
// fails 1..3, recovers on attempt 4 -- uses the full 3-restart budget, recovers.
@test
fn test_recovers_at_budget_edge() {
    let r = supervise("edge_ok", transient_3, 3)
    assert(r.succeeded, "recovers using the full budget")
    assert(r.restarts == 3, "all 3 restarts used, got " + to_string(r.restarts))
    assert(r.attempts == 4, "4 attempts, got " + to_string(r.attempts))
}

// fails 1..4: would need a 4th restart -> refused at the 3-restart ceiling.
@test
fn test_one_over_budget_gives_up() {
    let r = supervise("edge_fail", transient_4, 3)
    assert(r.succeeded == false, "one restart past the budget cannot recover")
    assert(r.gave_up, "supervisor gives up at the ceiling")
    assert(r.restarts == 3, "stops at exactly 3 restarts, got " + to_string(r.restarts))
    assert(r.attempts == 4, "4 attempts then refusal, got " + to_string(r.attempts))
}

// --- gate 4: a zero-restart budget is a one-shot ----------------------------
@test
fn test_zero_budget_is_one_shot() {
    let r = supervise("zero", permanent, 0)
    assert(r.succeeded == false, "no restarts allowed, cannot recover")
    assert(r.gave_up, "gives up immediately")
    assert(r.restarts == 0, "zero restarts performed, got " + to_string(r.restarts))
    assert(r.attempts == 1, "exactly one attempt, got " + to_string(r.attempts))
    assert(len(r.ledger) == 0, "no restart entries, got " + to_string(len(r.ledger)))
}

// --- gate 5: a healthy stage spends no restart budget -----------------------
@test
fn test_healthy_stage_no_restart() {
    let r = supervise("healthy", always_ok, 3)
    assert(r.succeeded, "healthy stage succeeds")
    assert(r.gave_up == false, "no give-up")
    assert(r.restarts == 0, "no restarts, got " + to_string(r.restarts))
    assert(r.attempts == 1, "one attempt, got " + to_string(r.attempts))
    assert(len(r.ledger) == 0, "empty restart ledger")
    assert(r.result == 7, "result passes through, got " + to_string(r.result))
}

// --- gate 6: ledger entries carry the per-restart audit fields --------------
@test
fn test_ledger_records_each_restart() {
    let r = supervise("audit", permanent, 3)
    assert(len(r.ledger) == 3, "3 restart entries")
    let mut i = 0
    while i < len(r.ledger) {
        let e = r.ledger[i]
        assert(e.api_calls == 1, "each restart is one api_call, got " + to_string(e.api_calls))
        assert(e.tokens_used == i + 1, "entry i carries failed attempt i+1, got " + to_string(e.tokens_used))
        assert(e.seq == i, "ledger seq is monotonic, got " + to_string(e.seq))
        i = i + 1
    }
    assert(ledger_verify(r.ledger) == -1, "audit chain verifies clean")
}

// --- gate 7: windows do not leak across supervised runs ---------------------
// Two back-to-back runs on the same thread: if the first leaked an exhausted
// budget frame, the second would refuse its first restart. It must not.
@test
fn test_windows_do_not_leak() {
    let first = supervise("first", permanent, 2)
    assert(first.restarts == 2, "first run uses its own window")
    let second = supervise("second", transient_2, 3)
    assert(second.succeeded, "second run gets a fresh window (no leak)")
    assert(second.restarts == 2, "second run restarts twice, got " + to_string(second.restarts))
    assert(restarts_remaining() == -1, "no budget window leaks after the runs")
}
