// ============================================================
// supervisor.kry -- one-for-one bounded restart supervision for a stage.
//
// `supervise(name, task, max_restarts)` runs a restartable unit under a restart
// window of `max_restarts` restarts (a language budget frame; see restart.kry).
// A unit is a `fn(attempt: i64) -> i64`: it is handed the 1-based attempt number
// and returns either a normal result or `fail_sentinel()` to signal an abnormal
// exit (the in-band observation of a crash, since kryos-rt has no monitor).
//
//   - The first invocation is the initial run; it does NOT spend restart budget.
//   - On every `FAIL` the supervisor RESERVES a restart from the budget frame.
//     If the frame still has a restart, it is consumed, the restart is recorded
//     to a hash-chained cost ledger, and the unit is re-run with the next attempt
//     number. If the frame is exhausted, the supervisor GIVES UP -- it does not
//     spin -- and reports exhaustion.
//
// This is one-for-one supervision (restart only the failed unit). All-for-one /
// rest-for-one, supervision trees, and hang detection are out of scope.
//
// The restart ledger (kryos-cost-ledger, project 28) is the tamper-evident audit
// trail: one entry per restart, each carrying ComputeCost{api_calls=1,
// tokens_used=<failed attempt>}. `report.ledger` is hash-chained; verify it with
// `ledger_verify(report.ledger)` (-1 == clean).
// ============================================================

use restart
use kryos_cost_ledger::ledger
use std::cost::{ComputeCost}

// The outcome of a supervised run.
struct SupervisorReport {
    stage: str,
    succeeded: bool,
    gave_up: bool,
    attempts: i64,        // total unit invocations (1 initial + restarts performed)
    restarts: i64,        // restarts actually performed (== ledger length)
    result: i64,          // final unit result if succeeded, else fail_sentinel()
    message: str,
    ledger: [LedgerEntry] // hash-chained restart audit trail
}

// Build the ComputeCost recorded for one restart: api_calls=1 marks the restart
// event; tokens_used carries the attempt number that failed.
@capabilities()
fn _restart_cost(failed_attempt: i64) -> ComputeCost {
    return ComputeCost {
        wall_time_ms: 0.0,
        tokens_used: failed_attempt,
        api_calls: 1,
        money_usd: 0.0,
        energy_kwh: 0.0
    }
}

// Supervise `task` under a window of `max_restarts` one-for-one restarts.
//
// The restart ceiling is the budget frame: `reserve_restart` asks the frame
// whether another restart is allowed, so the (max_restarts + 1)th restart is
// refused by the language, not by a counter this function maintains.
@capabilities()
fn supervise(name: str, task: fn(i64) -> i64, max_restarts: i64) -> SupervisorReport {
    let depth = budget_open(max_restarts)

    let mut led = ledger_new()
    let mut attempt = 1
    let mut result = task(attempt)
    let mut restarts = 0
    let mut gave_up = false

    while is_fail(result) {
        if reserve_restart() == false {
            gave_up = true
            break
        }
        // Restart permitted by the budget frame: record it, then re-run.
        led = ledger_append(led, _restart_cost(attempt))
        restarts = restarts + 1
        attempt = attempt + 1
        result = task(attempt)
    }

    budget_close(depth)

    let succeeded = is_fail(result) == false
    let mut msg = ""
    if succeeded {
        msg = "stage '" + name + "' recovered after " + to_string(restarts)
            + " restart(s); result=" + to_string(result)
    } else {
        msg = "stage '" + name + "' GAVE UP: restart budget of "
            + to_string(max_restarts) + " exhausted after "
            + to_string(restarts) + " restart(s)"
    }

    return SupervisorReport {
        stage: name,
        succeeded: succeeded,
        gave_up: gave_up,
        attempts: attempt,
        restarts: restarts,
        result: result,
        message: msg,
        ledger: led
    }
}

// True iff the supervised run ended cleanly (the stage eventually exited normally).
@capabilities()
fn report_ok(r: SupervisorReport) -> bool {
    return r.succeeded
}
