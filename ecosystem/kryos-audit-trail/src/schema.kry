// ============================================================
// schema.kry -- EU AI Act Annex IV field derivation
//
// annex_iv_fields() inspects a Tracked value's lineage + cost and derives
// the machine-checkable compliance summary an Annex IV technical-doc
// reviewer cares about: was the decision traceable, was a human in the
// loop, was a model identified, was resource use metered.
//
// The detection is a deliberate text heuristic over the lineage operation
// names (documented in SCHEMA.md). It is intentionally simple: a caller
// who annotates with non-standard operation strings will not trip the
// heuristic. Recommended operation strings are listed in SCHEMA.md.
// ============================================================

use std::cost
use std::tracked

// The Annex IV record schema tag. Bump when the field set changes.
@capabilities()
fn annex_iv_schema_version() -> str {
    return "eu-ai-act-annex-iv-v1"
}

// Derive the Annex IV compliance summary as a JSON object handle.
//
// confidence is accepted for signature stability (the build plan calls
// annex_iv_fields(lineage, cost, confidence)); the confidence value itself
// is surfaced at the top level of the record, not inside annex_iv, so it
// is not read here.
@capabilities()
fn annex_iv_fields(lineage: [LineageEntry], cost: ComputeCost, confidence: f64) -> i64 {
    let mut human_noted = false
    let mut model_noted = false
    let mut i = 0
    while i < len(lineage) {
        let op = lineage[i].operation
        if contains(op, "review") or contains(op, "oversight") or contains(op, "human") {
            human_noted = true
        }
        if contains(op, "inference") or contains(op, "model") or contains(op, "llm") {
            model_noted = true
        }
        i = i + 1
    }

    let mut traceability = "PASS"
    if len(lineage) == 0 {
        traceability = "FAIL: no lineage recorded"
    }

    // Metered if ANY opted-in consumption dimension is non-zero. wall_time_ms
    // is deliberately excluded: elapsed time is incidental latency that is
    // almost always non-zero, not evidence the caller recorded resource use.
    let cost_metered = cost.money_usd > 0.0 or cost.tokens_used > 0 or cost.api_calls > 0 or cost.energy_kwh > 0.0

    let keys = ["traceability", "human_oversight_recorded", "data_lineage_steps", "model_identified", "cost_metered"]
    let vals = [
        json_string(traceability),
        json_bool(human_noted),
        json_number(len(lineage) as f64),
        json_bool(model_noted),
        json_bool(cost_metered)
    ]
    return json_object(keys, vals)
}
