// ============================================================
// test_audit.kry -- the three required MVP unit tests.
//
//   kryos test tests/test_audit.kry
//
// Each test builds a record, parses it back with the native json_parse
// builtin (which also proves the output is valid JSON), and asserts on
// the derived annex_iv fields.
//
// NOTE on the empty-lineage case: tracked_source() always seeds a 1-entry
// "source" lineage, so a Tracked value can never have an empty lineage.
// The FAIL-traceability branch is therefore exercised through the core
// audit_record() with an explicitly empty [LineageEntry], which is the
// only way a zero-step record can actually arise.
//
// RUNNER NOTE: `kryos test` is blocked by an UPSTREAM codegen bug, not by
// anything in this library. The test runner eagerly JIT-compiles every
// function in every imported module, and the polymorphic `to_string(f64)`
// mis-compiles under that eager path (verifier: "arg 0 has type f64,
// expected i64"). It trips `std::tracked`'s `inference` (which builds
// "confidence=" + to_string(confidence)), pulled in by any `inference()`
// user. `kryos run` uses reachability-based compilation and is unaffected,
// so the 3 @test functions below are ALSO driven by the main() at the
// bottom: `kryos run tests/test_audit.kry` executes the assertions as real
// proof. The @test annotations remain so plain `kryos test` works verbatim
// once the upstream to_string(f64) bug is fixed.
// ============================================================

use std::tracked
use std::cost
use audit

@test
fn test_empty_lineage_fails_traceability() {
    let no_lineage: [LineageEntry] = []
    let no_caps: [str] = []
    let record = audit_record("denied", no_lineage, "manual", "no pipeline recorded", cost_zero(), no_caps, -1.0, "sys", "usr")
    let parsed = json_parse(record)
    let annex = json_get(parsed, "annex_iv")
    let trace = json_to_str(json_get(annex, "traceability"))
    assert(contains(trace, "FAIL"), "empty lineage must FAIL traceability")
}

@test
fn test_human_review_detected() {
    let t = annotate(tracked_source("x", "src", "desc"), "human_review", "officer signed off")
    let no_caps: [str] = []
    let record = audit_tracked(t, cost_zero(), no_caps, -1.0, "sys", "usr")
    let parsed = json_parse(record)
    let annex = json_get(parsed, "annex_iv")
    let human = json_stringify(json_get(annex, "human_oversight_recorded"))
    assert(human == "true", "human_review annotate must set human_oversight_recorded")
}

@test
fn test_model_inference_detected() {
    let t = inference(tracked_source("input", "pipeline", "raw"), "my-model-v1", "output", 0.87)
    let no_caps: [str] = []
    let record = audit_tracked(t, cost_zero(), no_caps, 0.87, "sys", "usr")
    let parsed = json_parse(record)
    let annex = json_get(parsed, "annex_iv")
    let model = json_stringify(json_get(annex, "model_identified"))
    assert(model == "true", "inference must set model_identified")
    let conf = json_to_float(json_get(parsed, "confidence"))
    assert(conf > 0.8, "confidence field should be present and > 0.8")
}

// Driver: run with `kryos run tests/test_audit.kry`. Any failed assertion
// throws and aborts with its message; reaching the end means all passed.
fn main() {
    test_empty_lineage_fails_traceability()
    println("PASS test_empty_lineage_fails_traceability")
    test_human_review_detected()
    println("PASS test_human_review_detected")
    test_model_inference_detected()
    println("PASS test_model_inference_detected")
    println("3/3 tests passed")
}
