// kryos-markdown-pkg — Markdown (CommonMark subset) to HTML, pure Kryos.
//
// Supported: ATX headings (# .. ######), fenced code blocks (```),
// unordered lists (- item), paragraphs, and the inline spans **bold**,
// *italic*, `code`, [text](url). Everything is HTML-escaped, including
// code block and code span contents.
//
// Not supported (kept honest): ordered lists, nested lists, blockquotes,
// tables, reference links, images, setext headings, HTML passthrough.

use std::string::{split_lines}

fn starts_with(s: str, prefix: str) -> bool {
    let pl = len(prefix)
    if len(s) < pl {
        return false
    }
    return substr(s, 0, pl) == prefix
}

fn trim(s: str) -> str {
    let n = len(s)
    let mut a = 0
    while a < n {
        let c = substr(s, a, a + 1)
        if c == " " {
            a = a + 1
        } elif c == "\t" {
            a = a + 1
        } elif c == "\r" {
            a = a + 1
        } else {
            break
        }
    }
    let mut b = n
    while b > a {
        let c = substr(s, b - 1, b)
        if c == " " {
            b = b - 1
        } elif c == "\t" {
            b = b - 1
        } elif c == "\r" {
            b = b - 1
        } else {
            break
        }
    }
    return substr(s, a, b)
}

fn find_from(s: str, needle: str, start: i64) -> i64 {
    let n = len(s)
    let nl = len(needle)
    if nl == 0 {
        return start
    }
    let mut i = start
    while i + nl <= n {
        if substr(s, i, i + nl) == needle {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

/// HTML-escape &, <, > and double quotes.
pub fn md_escape(s: str) -> str {
    let mut out = ""
    let mut i = 0
    let n = len(s)
    while i < n {
        let c = substr(s, i, i + 1)
        if c == "&" {
            out = out + "&amp;"
        } elif c == "<" {
            out = out + "&lt;"
        } elif c == ">" {
            out = out + "&gt;"
        } elif c == "\"" {
            out = out + "&quot;"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

/// Render inline markdown spans (**bold**, *italic*, `code`, [text](url))
/// to HTML. Plain text is escaped.
pub fn md_inline(s: str) -> str {
    let mut out = ""
    let mut i = 0
    let n = len(s)
    while i < n {
        let c = substr(s, i, i + 1)
        if c == "`" {
            let close = find_from(s, "`", i + 1)
            if close > i {
                out = out + "<code>" + md_escape(substr(s, i + 1, close)) + "</code>"
                i = close + 1
            } else {
                out = out + md_escape(c)
                i = i + 1
            }
        } elif i + 1 < n and substr(s, i, i + 2) == "**" {
            let mut close = find_from(s, "**", i + 2)
            // `**bold *and em***`: the first `**` match sits one short of the
            // trailing `***` run; shift right so the inner text keeps its
            // balanced single `*` (CommonMark's strong-wraps-em reading).
            if close > i and close + 2 < n and substr(s, close + 2, close + 3) == "*" {
                close = close + 1
            }
            if close > i {
                out = out + "<strong>" + md_inline(substr(s, i + 2, close)) + "</strong>"
                i = close + 2
            } else {
                out = out + md_escape(c)
                i = i + 1
            }
        } elif c == "*" {
            let close = find_from(s, "*", i + 1)
            if close > i {
                out = out + "<em>" + md_inline(substr(s, i + 1, close)) + "</em>"
                i = close + 1
            } else {
                out = out + md_escape(c)
                i = i + 1
            }
        } elif c == "[" {
            let mid = find_from(s, "](", i + 1)
            if mid > i {
                let close = find_from(s, ")", mid + 2)
                if close > mid {
                    let text = substr(s, i + 1, mid)
                    let url = substr(s, mid + 2, close)
                    out = out + "<a href=\"" + md_escape(url) + "\">" + md_inline(text) + "</a>"
                    i = close + 1
                } else {
                    out = out + md_escape(c)
                    i = i + 1
                }
            } else {
                out = out + md_escape(c)
                i = i + 1
            }
        } else {
            out = out + md_escape(c)
            i = i + 1
        }
    }
    return out
}

fn heading_level(line: str) -> i64 {
    let mut lvl = 0
    let n = len(line)
    while lvl < n {
        if substr(line, lvl, lvl + 1) == "#" {
            lvl = lvl + 1
        } else {
            break
        }
    }
    if lvl >= 1 and lvl <= 6 and lvl < n and substr(line, lvl, lvl + 1) == " " {
        return lvl
    }
    return 0
}

/// Render a markdown document to an HTML fragment.
pub fn md_to_html(md: str) -> str {
    let lines = split_lines(md)
    let mut out = ""
    let mut in_code = false
    let mut in_list = false
    for raw in lines {
        let line = trim(raw)
        if in_code {
            if starts_with(line, "```") {
                out = out + "</code></pre>\n"
                in_code = false
            } else {
                out = out + md_escape(raw) + "\n"
            }
        } elif starts_with(line, "```") {
            if in_list {
                out = out + "</ul>\n"
                in_list = false
            }
            out = out + "<pre><code>"
            in_code = true
        } elif heading_level(line) > 0 {
            if in_list {
                out = out + "</ul>\n"
                in_list = false
            }
            let lvl = heading_level(line)
            let text = trim(substr(line, lvl + 1, len(line)))
            out = out + "<h" + to_string(lvl) + ">" + md_inline(text) + "</h" + to_string(lvl) + ">\n"
        } elif starts_with(line, "- ") {
            if in_list == false {
                out = out + "<ul>\n"
                in_list = true
            }
            out = out + "<li>" + md_inline(substr(line, 2, len(line))) + "</li>\n"
        } elif len(line) == 0 {
            if in_list {
                out = out + "</ul>\n"
                in_list = false
            }
        } else {
            if in_list {
                out = out + "</ul>\n"
                in_list = false
            }
            out = out + "<p>" + md_inline(line) + "</p>\n"
        }
    }
    if in_list {
        out = out + "</ul>\n"
    }
    if in_code {
        out = out + "</code></pre>\n"
    }
    return out
}
