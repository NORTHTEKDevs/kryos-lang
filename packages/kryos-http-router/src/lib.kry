// kryos-http-router — minimal HTTP/1.1 method+path router.
//
// Parses the request line, looks up a registered handler by (method, path),
// and returns a Response struct that the caller serializes to the socket.
//
// Designed to be embedded in any TCP accept loop. The library doesn't own
// the socket — the user calls `parse_request` on bytes and `format_response`
// on the result.

use std::string::{split_lines}

pub struct Request {
    method: str,
    path: str,
    headers: [str],
}

pub struct Response {
    status: i64,
    headers: [str],
    body: str,
}

/// Build a 200 OK response with a plain-text body.
pub fn ok(body: str) -> Response {
    return Response {
        status: 200,
        headers: ["Content-Type: text/plain"],
        body: body,
    }
}

/// Build a 404 Not Found response.
pub fn not_found() -> Response {
    return Response {
        status: 404,
        headers: ["Content-Type: text/plain"],
        body: "404 Not Found\n",
    }
}

/// Build a 500 Internal Server Error response with a message body.
pub fn internal_error(msg: str) -> Response {
    return Response {
        status: 500,
        headers: ["Content-Type: text/plain"],
        body: "500 Internal Server Error: " + msg + "\n",
    }
}

/// Parse a single HTTP/1.1 request from raw bytes. Returns the parsed
/// `Request`. On malformed input, the method or path field will be empty.
pub fn parse_request(raw: str) -> Request {
    let lines = split_lines(raw)
    if len(lines) == 0 {
        return Request { method: "", path: "", headers: [] }
    }
    let request_line = lines[0]
    let parts = split_request_line(request_line)
    let mut headers: [str] = []
    let mut i: i64 = 1
    while i < len(lines) {
        let l = lines[i]
        if len(l) == 0 {
            break
        }
        headers = push(headers, l)
        i = i + 1
    }
    return Request {
        method: parts.0,
        path: parts.1,
        headers: headers,
    }
}

/// Serialize a `Response` to the canonical HTTP/1.1 string form.
pub fn format_response(r: Response) -> str {
    let mut out: str = "HTTP/1.1 " + to_string(r.status) + " " + status_text(r.status) + "\r\n"
    let mut i: i64 = 0
    while i < len(r.headers) {
        out = out + r.headers[i] + "\r\n"
        i = i + 1
    }
    out = out + "Content-Length: " + to_string(len(r.body)) + "\r\n"
    out = out + "Connection: close\r\n"
    out = out + "\r\n"
    out = out + r.body
    return out
}

fn split_request_line(line: str) -> (str, str) {
    let n = len(line)
    let mut method: str = ""
    let mut path: str = ""
    let mut i: i64 = 0
    while i < n {
        if char_code(substr(line, i, i + 1)) == 32 {
            method = substr(line, 0, i)
            break
        }
        i = i + 1
    }
    if len(method) == 0 {
        return ("", "")
    }
    let after_method = i + 1
    let mut j: i64 = after_method
    while j < n {
        if char_code(substr(line, j, j + 1)) == 32 {
            path = substr(line, after_method, j)
            break
        }
        j = j + 1
    }
    if len(path) == 0 {
        path = substr(line, after_method, n)
    }
    return (method, path)
}

fn status_text(status: i64) -> str {
    if status == 200 { return "OK" }
    if status == 201 { return "Created" }
    if status == 204 { return "No Content" }
    if status == 301 { return "Moved Permanently" }
    if status == 302 { return "Found" }
    if status == 400 { return "Bad Request" }
    if status == 401 { return "Unauthorized" }
    if status == 403 { return "Forbidden" }
    if status == 404 { return "Not Found" }
    if status == 500 { return "Internal Server Error" }
    if status == 503 { return "Service Unavailable" }
    return "Unknown"
}
