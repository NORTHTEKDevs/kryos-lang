{
  "name": "kryos",
  "displayName": "Kryos",
  "description": "Kryos language support — syntax highlighting, snippets, and LSP integration",
  "version": "0.4.0",
  "publisher": "northtekdevs",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "homepage": "https://github.com/NORTHTEKDevs/kryos-lang",
  "bugs": {
    "url": "https://github.com/NORTHTEKDevs/kryos-lang/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NORTHTEKDevs/kryos-lang"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "kryos",
    "kryos-lang",
    "systems",
    "compiled",
    "language-server",
    "lsp"
  ],
  "galleryBanner": {
    "color": "#0b1e3a",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:kryos"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kryos",
        "aliases": [
          "Kryos",
          "kryos"
        ],
        "extensions": [
          ".kry"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kryos",
        "scopeName": "source.kryos",
        "path": "./syntaxes/kryos.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kryos",
        "path": "./snippets/kryos.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Kryos",
      "properties": {
        "kryos.serverPath": {
          "type": "string",
          "default": "kryos",
          "description": "Path to the kryos binary that hosts the language server."
        },
        "kryos.serverArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["lsp"],
          "description": "Arguments passed to the kryos binary to launch the LSP."
        },
        "kryos.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace the communication between VS Code and the Kryos language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.0.0"
  }
}
